                  <Item class="ModuleScript" referent="867">
                    <Properties>
                      <string name="Name">breathSlice</string>
                      <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Charm = require(ReplicatedStorage.Packages.Charm)
local BreathServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.BreathServiceUtils)

type BreathServiceState = BreathServiceUtils.BreathServiceState

local breathStateAtom: Charm.Atom<BreathServiceState> = Charm.atom(BreathServiceUtils.createDefaultState())
local breathReadyAtom: Charm.Atom<boolean> = Charm.atom(false)

local breathAtom: Charm.Selector<number> = Charm.computed(function(): number
	return breathStateAtom().breath
end)

local maxBreathAtom: Charm.Selector<number> = Charm.computed(function(): number
	return breathStateAtom().maxBreath
end)

local underwaterAtom: Charm.Selector<boolean> = Charm.computed(function(): boolean
	local state = breathStateAtom()
	return state.isUnderwater or state.isBreathingBlocked or state.isDrowning
end)

local breathPercentAtom: Charm.Selector<number> = Charm.computed(function(): number
	local state = breathStateAtom()
	if state.maxBreath <= 0 then
		return 0
	end
	return math.clamp(state.breath / state.maxBreath, 0, 1)
end)

local function getBreathState(): BreathServiceState
	return breathStateAtom()
end

local function setBreathState(stateRaw: any): BreathServiceState
	local nextState = BreathServiceUtils.createState(stateRaw, breathStateAtom())
	breathStateAtom(nextState)
	return nextState
end

local function resetBreathState(): BreathServiceState
	local nextState = BreathServiceUtils.createDefaultState()
	breathStateAtom(nextState)
	return nextState
end

local function isBreathReady(): boolean
	return breathReadyAtom()
end

local function setBreathReady(isReadyRaw: any): boolean
	local nextReady = isReadyRaw == true
	breathReadyAtom(nextReady)
	return nextReady
end

return {
	breathStateAtom = breathStateAtom,
	breathReadyAtom = breathReadyAtom,
	breathAtom = breathAtom,
	maxBreathAtom = maxBreathAtom,
	underwaterAtom = underwaterAtom,
	breathPercentAtom = breathPercentAtom,
	getBreathState = getBreathState,
	setBreathState = setBreathState,
	resetBreathState = resetBreathState,
	isBreathReady = isBreathReady,
	setBreathReady = setBreathReady,
}
]]></string>
                    </Properties>
                  </Item>
                  <Item class="ModuleScript" referent="868">
                    <Properties>
                      <string name="Name">breathThunks</string>
                      <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ConnectionUtils = require(script:FindFirstAncestor("game").Client.UI.core.utils.ConnectionUtils)
local ServiceSync = require(script:FindFirstAncestor("game").Client.UI.core.utils.ServiceSync)
local breathSlice = require(script:FindFirstAncestor("game").Client.UI.features.breath.state.breathSlice)
local BreathServiceClient = require(script:FindFirstAncestor("game").Client.Services.BreathServiceClient)
local BreathServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.BreathServiceUtils)

type BreathServiceState = BreathServiceUtils.BreathServiceState

local breathThunks = {}

local runtime = {
	started = false,
	stateChangedConnection = nil :: RBXScriptConnection?,
}

local function applyState(nextStateRaw: any): BreathServiceState
	return breathSlice.setBreathState(nextStateRaw)
end

local function syncFromService(): BreathServiceState
	return ServiceSync.syncFromService(BreathServiceClient, breathSlice.getBreathState, applyState)
end

function breathThunks.Start(): () -> ()
	if runtime.started then
		return breathThunks.Stop
	end

	runtime.started = true
	local isReady = ServiceSync.readReady(BreathServiceClient, false)
	breathSlice.setBreathReady(isReady)
	if isReady then
		syncFromService()
	end

	runtime.stateChangedConnection = ServiceSync.connectStateChanged(BreathServiceClient, function(nextState: BreathServiceState)
		applyState(nextState)
		breathSlice.setBreathReady(true)
	end)
	ServiceSync.requestSync(BreathServiceClient)

	return breathThunks.Stop
end

function breathThunks.Stop()
	ConnectionUtils.disconnect(runtime.stateChangedConnection)
	runtime.stateChangedConnection = nil

	runtime.started = false
	breathSlice.setBreathReady(false)
end

function breathThunks.SyncFromService(): BreathServiceState
	return syncFromService()
end

function breathThunks.ApplyState(nextStateRaw: any): BreathServiceState
	return applyState(nextStateRaw)
end

breathThunks.start = breathThunks.Start
breathThunks.stop = breathThunks.Stop
breathThunks.syncFromService = breathThunks.SyncFromService
breathThunks.applyState = breathThunks.ApplyState

return breathThunks
]]></string>
                    </Properties>
                  </Item>
                </Item>
              </Item>
