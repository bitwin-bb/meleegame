local function resolveMaxTileId(tileIdMap: { [string]: number }): number
	local maxTileId = 0
	for _, tileId in tileIdMap do
		if tileId > maxTileId then
			maxTileId = tileId
		end
	end
	return maxTileId
end

local MAX_TILE_ID = resolveMaxTileId(TILE_ID)

