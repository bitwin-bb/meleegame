          <Item class="ModuleScript" referent="710">
            <Properties>
              <string name="Name">AquariaBackupServiceClient</string>
              <string name="Source"><![CDATA[--!strict
--[=[
	@class AquariaBackupServiceClient
]=]

local gameRoot = assert(script:FindFirstAncestor("game"), "Missing Nevermore game root.")
local packageRoot = gameRoot.Parent
local loaderUtils = assert(packageRoot:FindFirstChild("LoaderUtils", true), "Missing LoaderUtils")
local loader = require(loaderUtils.Parent).load(script)

local Configs = require(gameRoot.Shared.Modules.Core.Configs)
local CoreRuntime = require(gameRoot.Shared.Modules.Core.Runtime)
local ui = require(gameRoot.Client.UI)

local AnimationServiceClient = require(gameRoot.Client.Services.AnimationServiceClient)
local AquariaBackupTranslator = require(gameRoot.Shared.AquariaBackupTranslator)
local AudioServiceClient = require(gameRoot.Client.Services.AudioServiceClient)
local BossServiceClient = require(gameRoot.Client.Services.BossServiceClient)
local BreathServiceClient = require(gameRoot.Client.Services.BreathServiceClient)
local BuildServiceClient = require(gameRoot.Client.Services.BuildServiceClient)
local CameraServiceClient = require(gameRoot.Client.Services.CameraServiceClient)
local ClientBinderSupport = require(gameRoot.Client.Binders.ClientBinderSupport)
local CraftingServiceClient = require(gameRoot.Client.Services.CraftingServiceClient)
local GoreServiceClient = require(gameRoot.Client.Services.GoreServiceClient)
local HpServiceClient = require(gameRoot.Client.Services.HpServiceClient)
local InventoryServiceClient = require(gameRoot.Client.Services.InventoryServiceClient)
local LiquidServiceClient = require(gameRoot.Client.Services.LiquidServiceClient)
local LootServiceClient = require(gameRoot.Client.Services.LootServiceClient)
local MagicServiceClient = require(gameRoot.Client.Services.MagicServiceClient)
local ManaServiceClient = require(gameRoot.Client.Services.ManaServiceClient)
local MeleeServiceClient = require(gameRoot.Client.Services.MeleeServiceClient)
local NpcServiceClient = require(gameRoot.Client.Services.NpcServiceClient)
local PadNavBinder = require(gameRoot.Client.Binders.PadNavBinder)
local ParallaxServiceClient = require(gameRoot.Client.Services.ParallaxServiceClient)
local PlatformServiceClient = require(gameRoot.Client.Services.PlatformServiceClient)
local PlayerDataServiceClient = require(gameRoot.Client.Services.PlayerDataServiceClient)
local PlayerServiceClient = require(gameRoot.Client.Services.PlayerServiceClient)
local RagdollServiceClient = require(gameRoot.Client.Services.RagdollServiceClient)
local VFXServiceClient = require(gameRoot.Client.Services.VFXServiceClient)
local WeatherServiceClient = require(gameRoot.Client.Services.WeatherServiceClient)
local WindFoliageServiceClient = require(gameRoot.Client.Services.WindFoliageServiceClient)
local WorldAnimatorServiceClient = require(gameRoot.Client.Services.WorldAnimatorServiceClient)
local WorldGenerationServiceClient = require(gameRoot.Client.Services.WorldGenerationServiceClient)
local WorldSimulationServiceClient = require(gameRoot.Client.Services.WorldSimulationServiceClient)

local CmdrBootstrapClient = loader("CmdrBootstrapClient")
local ScreenGuiService = loader("ScreenGuiService")
local SnackbarServiceClient = loader("SnackbarServiceClient")

local AquariaBackupServiceClient = {}
AquariaBackupServiceClient.ServiceName = "AquariaBackupServiceClient"

export type AquariaBackupServiceClient = typeof(setmetatable(
	{} :: {
		_serviceBag: any,
	},
	{} :: typeof({ __index = AquariaBackupServiceClient })
))

local function isCameraServiceEnabled(): boolean
	local cameraSettings = Configs.cameraSettings
	if typeof(cameraSettings) ~= "table" then
		return true
	end

	local serviceEnabled = (cameraSettings :: any).serviceEnabled
	if typeof(serviceEnabled) == "boolean" then
		return serviceEnabled
	end

	return true
end

local function isWorldSimulationReplicationEnabled(): boolean
	local worldSimulation = Configs.worldSimulation
	if typeof(worldSimulation) ~= "table" then
		return false
	end

	local enabled = (worldSimulation :: any).enableClientReplication
	if typeof(enabled) == "boolean" then
		return enabled
	end

	return false
end

function AquariaBackupServiceClient.Init(self: AquariaBackupServiceClient, serviceBag: any): ()
	assert(not (self :: any)._serviceBag, "Already initialized")
	self._serviceBag = assert(serviceBag, "No serviceBag")

	self._serviceBag:GetService(ClientBinderSupport)
	self._serviceBag:GetService(PadNavBinder)
	self._serviceBag:GetService(AquariaBackupTranslator)
	self._serviceBag:GetService(ScreenGuiService)
	self._serviceBag:GetService(SnackbarServiceClient)
	self._serviceBag:GetService(CmdrBootstrapClient)

	CoreRuntime.getClientRuntime():init()

	PlatformServiceClient:init()
	PlayerDataServiceClient:init()
	InventoryServiceClient:init()
	CraftingServiceClient:init()
	LootServiceClient:init()
	ManaServiceClient:init()
	if isCameraServiceEnabled() then
		CameraServiceClient:init()
	end
	AudioServiceClient:init()
	VFXServiceClient:init()
	HpServiceClient:init()
	if isWorldSimulationReplicationEnabled() then
		WorldSimulationServiceClient:init()
	end
	PlayerServiceClient:init()
	WorldGenerationServiceClient:init()
	LiquidServiceClient:init()
	ParallaxServiceClient:init()
	BuildServiceClient:init()
	WeatherServiceClient:init()
	WindFoliageServiceClient:init()
	WorldAnimatorServiceClient:init()
	AnimationServiceClient:init()
	NpcServiceClient:init()
	BossServiceClient:init()
	MeleeServiceClient:init()
	MagicServiceClient:init()
	BreathServiceClient:init()
	RagdollServiceClient:init()
	GoreServiceClient:init()
end

function AquariaBackupServiceClient.Start(self: AquariaBackupServiceClient): ()
	assert((self :: any)._serviceBag, "Not initialized")
	ui()
end

function AquariaBackupServiceClient.Destroy(self: AquariaBackupServiceClient): ()
	(self :: any)._serviceBag = nil
end

return AquariaBackupServiceClient
]]></string>
            </Properties>
          </Item>
          <Item class="Folder" referent="711">
            <Properties>
              <string name="Name">Binders</string>
            </Properties>
            <Item class="ModuleScript" referent="712">
              <Properties>
                <string name="Name">AudioBinder</string>
                <string name="Source"><![CDATA[--!strict

local ModelBinder = require(script:FindFirstAncestor("game").Shared.Binders.ModelBinder)

local AudioBinder = {}
AudioBinder.__index = AudioBinder
setmetatable(AudioBinder, ModelBinder)

local audioServiceClient = nil

local function getAudioServiceClient()
	if audioServiceClient == nil then
		audioServiceClient = require(script:FindFirstAncestor("game").Client.Services.AudioServiceClient)
	end
	return audioServiceClient
end

local function resolveStringAttribute(instance: Instance, attributeNames: { string }): string?
	for _, attributeName in attributeNames do
		local value = instance:GetAttribute(attributeName)
		if typeof(value) == "string" and value ~= "" then
			return value
		end
	end
	return nil
end

local function resolveNumberAttribute(instance: Instance, attributeName: string, fallback: number): number
	local value = instance:GetAttribute(attributeName)
	if typeof(value) ~= "number" or value ~= value then
		return fallback
	end
	return value
end

function AudioBinder.new(instance: Instance, context: any)
	local self = ModelBinder.new(instance, context, AudioBinder)
	self.rootPart = ModelBinder.resolveRootPart(instance)
	self.playingSound = nil :: Sound?
	self.existingSound = instance:FindFirstChildWhichIsA("Sound", true)
	self.channel = `AudioBinder_{instance:GetDebugId(0)}`

	self:refresh()
	self:ObserveAttribute("AudioEnabled", function()
		self:refresh()
	end)
	self:ObserveAttribute("AudioSoundId", function()
		self:refresh()
	end)
	self:ObserveAttribute("AmbientSoundId", function()
		self:refresh()
	end)
	self:ObserveAttribute("AudioVolume", function()
		self:refresh()
	end)

	return self
end

function AudioBinder.refresh(self: any)
	local enabled = self.instance:GetAttribute("AudioEnabled") ~= false
	local soundId = resolveStringAttribute(self.instance, { "AudioSoundId", "AmbientSoundId", "SoundId" })
	local volume = resolveNumberAttribute(self.instance, "AudioVolume", 0.65)
	local maxDistance = resolveNumberAttribute(self.instance, "AudioMaxDistance", 55)
	local emitterSize = resolveNumberAttribute(self.instance, "AudioEmitterSize", 8)
	local looped = self.instance:GetAttribute("AudioLooped") ~= false

	self.instance:SetAttribute("AudioTagged", true)

	if self.existingSound ~= nil then
		self.existingSound.Volume = volume
		self.existingSound.RollOffMaxDistance = maxDistance
		self.existingSound.Looped = looped
		if enabled then
			if not self.existingSound.IsPlaying then
				self.existingSound:Play()
			end
		else
			self.existingSound:Stop()
		end
		return
	end

	if self.playingSound ~= nil then
		self.playingSound:Destroy()
		self.playingSound = nil
	end

	if not enabled or soundId == nil then
		return
	end

	local parent = if self.rootPart ~= nil
		then self.rootPart
		else if self.instance:IsA("BasePart") then self.instance else nil
	if parent == nil then
		return
	end

	self.playingSound = getAudioServiceClient():playSound(soundId, {
		parent = parent,
		channel = self.channel,
		looped = looped,
		autoDestroy = false,
		volume = volume,
		rollOffMaxDistance = maxDistance,
		emitterSize = emitterSize,
	})
end

function AudioBinder.Cleanup(self: any)
	if self.playingSound ~= nil then
		self.playingSound:Destroy()
		self.playingSound = nil
	end
	if self.existingSound ~= nil and self.instance:GetAttribute("AudioEnabled") == false then
		self.existingSound:Stop()
	end
end

return AudioBinder
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="713">
              <Properties>
                <string name="Name">ChunkBinder</string>
                <string name="Source"><![CDATA[--!strict

local ModelBinder = require(script:FindFirstAncestor("game").Shared.Binders.ModelBinder)

local ChunkBinder = {}
ChunkBinder.__index = ChunkBinder
setmetatable(ChunkBinder, ModelBinder)

local SKIP_WORLD_ANIMATOR_ATTRIBUTE = "SkipWorldAnimator"
local WORLD_ANIMATOR_RUNTIME_FOLDER_NAME = "WorldAnimatorRuntime"

local worldAnimatorServiceClient = nil

local function getWorldAnimatorServiceClient()
	if worldAnimatorServiceClient == nil then
		worldAnimatorServiceClient =
			require(script:FindFirstAncestor("game").Client.Services.WorldAnimatorServiceClient)
	end
	return worldAnimatorServiceClient
end

local function isInWorldAnimatorRuntime(instance: Instance): boolean
	local current = instance.Parent
	while current ~= nil do
		if current.Name == WORLD_ANIMATOR_RUNTIME_FOLDER_NAME then
			return true
		end
		current = current.Parent
	end
	return false
end

local function shouldNotifyWorldAnimator(model: Model?): boolean
	if model == nil then
		return false
	end
	if model:GetAttribute(SKIP_WORLD_ANIMATOR_ATTRIBUTE) == true then
		return false
	end
	return not isInWorldAnimatorRuntime(model)
end

function ChunkBinder.new(instance: Instance, context: any)
	local self = ModelBinder.new(instance, context, ChunkBinder)
	self.model = self:GetModel()
	self:updateMetadata()

	if shouldNotifyWorldAnimator(self.model) then
		pcall(function()
			getWorldAnimatorServiceClient():onChunkAdded(self.model)
		end)
	end

	return self
end

function ChunkBinder.updateMetadata(self: any)
	local chunkKey = self.instance:GetAttribute("ChunkKey")
	self.instance:SetAttribute("ChunkTagged", true)
	if typeof(chunkKey) == "string" and chunkKey ~= "" then
		self.instance:SetAttribute("ChunkBinderKey", chunkKey)
	end
end

function ChunkBinder.Cleanup(self: any)
	if shouldNotifyWorldAnimator(self.model) then
		pcall(function()
			getWorldAnimatorServiceClient():onChunkRemoved(self.model)
		end)
	end
end

return ChunkBinder
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="714">
              <Properties>
                <string name="Name">ClientBinderSupport</string>
                <string name="Source"><![CDATA[--!strict

local packageRoot = script:FindFirstAncestor("game").Parent
local loaderUtils = assert(packageRoot:FindFirstChild("LoaderUtils", true), "Missing LoaderUtils")
local loader = require(loaderUtils.Parent).load(script)

local Binder = loader("Binder")
local BinderProvider = loader("BinderProvider")
local AudioBinder = require(script.Parent.AudioBinder)
local ChunkBinder = require(script.Parent.ChunkBinder)
local DisturberBinder = require(script.Parent.DisturberBinder)
local FoliageBinder = require(script.Parent.FoliageBinder)
local LayerBinder = require(script.Parent.LayerBinder)
local LightBinder = require(script.Parent.LightBinder)
local LiquidBinder = require(script.Parent.LiquidBinder)
local PreviewBinder = require(script.Parent.PreviewBinder)
local TagBinder = require(script:FindFirstAncestor("game").Shared.Binders.TagBinder)
local UseBinder = require(script.Parent.UseBinder)

local function createContext(primaryTag: string, serviceBag: any): { tags: { string }, serviceBag: any }
	return table.freeze({
		serviceBag = serviceBag,
		tags = table.freeze({ primaryTag }),
	})
end

local function addBinder(self: any, primaryTag: string, binderClass: any)
	self:Add(Binder.new(primaryTag, function(instance: Instance, serviceBag: any)
		return binderClass.new(instance, createContext(primaryTag, serviceBag))
	end))
end

local ClientBinderSupport = BinderProvider.new("ClientBinderSupport", function(self)
	addBinder(self, TagBinder.Tags.Audio, AudioBinder)
	addBinder(self, TagBinder.Tags.Chunk, ChunkBinder)
	addBinder(self, TagBinder.Tags.Disturber, DisturberBinder)
	addBinder(self, TagBinder.Tags.Foliage, FoliageBinder)
	addBinder(self, TagBinder.Tags.Layer, LayerBinder)
	addBinder(self, TagBinder.Tags.Light_Torch, LightBinder)
	addBinder(self, TagBinder.Tags.Liquid, LiquidBinder)
	addBinder(self, TagBinder.Tags.Preview, PreviewBinder)
	addBinder(self, TagBinder.Tags.Use, UseBinder)
end)

return ClientBinderSupport
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="715">
              <Properties>
                <string name="Name">DisturberBinder</string>
                <string name="Source"><![CDATA[--!strict

local ModelBinder = require(script:FindFirstAncestor("game").Shared.Binders.ModelBinder)

local DisturberBinder = {}
DisturberBinder.__index = DisturberBinder
setmetatable(DisturberBinder, ModelBinder)

local windFoliageServiceClient = nil

local function getWindFoliageServiceClient()
	if windFoliageServiceClient == nil then
		windFoliageServiceClient = require(script:FindFirstAncestor("game").Client.Services.WindFoliageServiceClient)
	end
	return windFoliageServiceClient
end

local DISTURBER_ATTRIBUTE_NAMES = {
	"WindFoliageDisturbanceRadius",
	"WindFoliageDisturbanceStrength",
	"WindFoliageDisturbanceLifetime",
	"WindFoliageDisturbanceFalloff",
	"WindFoliageDisturbancePropagationDistance",
	"WindFoliageDisturbancePropagationWeight",
	"WindFoliageDisturbanceVelocityInfluence",
}

local function collectOverrideConfig(instance: Instance): { [string]: any }?
	local config = {} :: { [string]: any }

	local radius = instance:GetAttribute("WindFoliageDisturbanceRadius")
	if typeof(radius) == "number" then
		config.radius = radius
	end
	local strength = instance:GetAttribute("WindFoliageDisturbanceStrength")
	if typeof(strength) == "number" then
		config.strength = strength
	end
	local lifetime = instance:GetAttribute("WindFoliageDisturbanceLifetime")
	if typeof(lifetime) == "number" then
		config.lifetime = lifetime
	end
	local falloff = instance:GetAttribute("WindFoliageDisturbanceFalloff")
	if typeof(falloff) == "number" then
		config.falloffCurve = falloff
	end
	local propagationDistance = instance:GetAttribute("WindFoliageDisturbancePropagationDistance")
	if typeof(propagationDistance) == "number" then
		config.propagationDistance = propagationDistance
	end
	local propagationWeight = instance:GetAttribute("WindFoliageDisturbancePropagationWeight")
	if typeof(propagationWeight) == "number" then
		config.propagationWeight = propagationWeight
	end
	local velocityInfluence = instance:GetAttribute("WindFoliageDisturbanceVelocityInfluence")
	if typeof(velocityInfluence) == "number" then
		config.velocityInfluence = velocityInfluence
	end

	if next(config) == nil then
		return nil
	end

	return config
end

function DisturberBinder.new(instance: Instance, context: any)
	local self = ModelBinder.new(instance, context, DisturberBinder)
	self.isTracked = false

	self:refresh()
	for _, attributeName in DISTURBER_ATTRIBUTE_NAMES do
		self:ObserveAttribute(attributeName, function()
			self:refresh()
		end)
	end

	return self
end

function DisturberBinder.refresh(self: any)
	local enabled = self.instance:GetAttribute("WindFoliageDisturbanceEnabled") ~= false
	self.instance:SetAttribute("DisturberTagged", true)

	if enabled and not self.isTracked then
		local ok = pcall(function()
			getWindFoliageServiceClient():trackDisturber(self.instance, collectOverrideConfig(self.instance))
		end)
		self.isTracked = ok
	elseif enabled and self.isTracked then
		pcall(function()
			local nextWindFoliageServiceClient = getWindFoliageServiceClient()
			nextWindFoliageServiceClient:untrackDisturber(self.instance)
			nextWindFoliageServiceClient:trackDisturber(self.instance, collectOverrideConfig(self.instance))
		end)
	elseif not enabled and self.isTracked then
		pcall(function()
			getWindFoliageServiceClient():untrackDisturber(self.instance)
		end)
		self.isTracked = false
	end
end

function DisturberBinder.Cleanup(self: any)
	if self.isTracked then
		pcall(function()
			getWindFoliageServiceClient():untrackDisturber(self.instance)
		end)
	end
end

return DisturberBinder
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="716">
              <Properties>
                <string name="Name">FoliageBinder</string>
                <string name="Source"><![CDATA[--!strict

local ModelBinder = require(script:FindFirstAncestor("game").Shared.Binders.ModelBinder)

local FoliageBinder = {}
FoliageBinder.__index = FoliageBinder
setmetatable(FoliageBinder, ModelBinder)

local windFoliageServiceClient = nil

local function getWindFoliageServiceClient()
	if windFoliageServiceClient == nil then
		windFoliageServiceClient = require(script:FindFirstAncestor("game").Client.Services.WindFoliageServiceClient)
	end
	return windFoliageServiceClient
end

function FoliageBinder.new(instance: Instance, context: any)
	local self = ModelBinder.new(instance, context, FoliageBinder)
	self.isRegistered = false

	self:refresh()
	self:ObserveAttribute("WindFoliageEnabled", function()
		self:refresh()
	end)

	return self
end

function FoliageBinder.refresh(self: any)
	local enabled = self.instance:GetAttribute("WindFoliageEnabled") ~= false
	self.instance:SetAttribute("FoliageTagged", true)

	if enabled and not self.isRegistered then
		local ok = pcall(function()
			getWindFoliageServiceClient():registerFoliage(self.instance)
		end)
		self.isRegistered = ok
	elseif not enabled and self.isRegistered then
		pcall(function()
			getWindFoliageServiceClient():unregisterFoliage(self.instance)
		end)
		self.isRegistered = false
	end
end

function FoliageBinder.Cleanup(self: any)
	if self.isRegistered then
		pcall(function()
			getWindFoliageServiceClient():unregisterFoliage(self.instance)
		end)
	end
end

return FoliageBinder
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="717">
              <Properties>
                <string name="Name">LayerBinder</string>
                <string name="Source"><![CDATA[--!strict

local ModelBinder = require(script:FindFirstAncestor("game").Shared.Binders.ModelBinder)

local LayerBinder = {}
LayerBinder.__index = LayerBinder
setmetatable(LayerBinder, ModelBinder)

local function resolveNumberAttribute(instance: Instance, attributeName: string, fallback: number): number
	local value = instance:GetAttribute(attributeName)
	if typeof(value) ~= "number" or value ~= value then
		return fallback
	end
	return value
end

local function resolveLayerIndex(instance: Instance): number
	local attributeValue = instance:GetAttribute("LayerIndex")
	if typeof(attributeValue) == "number" then
		return math.max(1, math.floor(attributeValue))
	end

	local numericSuffix = string.match(instance.Name, "(%d+)$")
	if numericSuffix ~= nil then
		return math.max(1, tonumber(numericSuffix) or 1)
	end

	return 1
end

function LayerBinder.new(instance: Instance, context: any)
	local self = ModelBinder.new(instance, context, LayerBinder)
	self.parts = ModelBinder.collectBaseParts(instance)

	self:refresh()
	self:ObserveAttribute("LayerTransparency", function()
		self:refresh()
	end)
	self:ObserveAttribute("LayerVisible", function()
		self:refresh()
	end)

	return self
end

function LayerBinder.refresh(self: any)
	local visible = self.instance:GetAttribute("LayerVisible") ~= false
	local transparency = math.clamp(resolveNumberAttribute(self.instance, "LayerTransparency", 0), 0, 1)
	local localTransparencyModifier = if visible then transparency else 1
	local layerIndex = resolveLayerIndex(self.instance)

	self.instance:SetAttribute("LayerTagged", true)
	self.instance:SetAttribute("LayerResolvedIndex", layerIndex)

	for _, part in self.parts do
		part.LocalTransparencyModifier = localTransparencyModifier
		part.CastShadow = layerIndex <= 1
	end
end

return LayerBinder
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="718">
              <Properties>
                <string name="Name">LightBinder</string>
                <string name="Source"><![CDATA[--!strict

local RunService = game:GetService("RunService")

local ModelBinder = require(script:FindFirstAncestor("game").Shared.Binders.ModelBinder)

local LightBinder = {}
LightBinder.__index = LightBinder
setmetatable(LightBinder, ModelBinder)

local function resolveNumberAttribute(instance: Instance, attributeName: string, fallback: number): number
	local value = instance:GetAttribute(attributeName)
	if typeof(value) ~= "number" or value ~= value then
		return fallback
	end
	return value
end

local function resolveBooleanAttribute(instance: Instance, attributeName: string, fallback: boolean): boolean
	local value = instance:GetAttribute(attributeName)
	if typeof(value) == "boolean" then
		return value
	end
	return fallback
end

function LightBinder.new(instance: Instance, context: any)
	local self = ModelBinder.new(instance, context, LightBinder)
	self.rootPart = ModelBinder.resolveRootPart(instance)
	self.lights = ModelBinder.collectLights(instance)
	self.flickerSeed = Random.new():NextNumber(-1000, 1000)
	self.createdLight = nil :: PointLight?

	if #self.lights <= 0 and self.rootPart ~= nil then
		local attachment = Instance.new("Attachment")
		attachment.Name = "LightBinderAttachment"
		attachment.Parent = self.rootPart
		self:AddCleanup(attachment)

		local light = Instance.new("PointLight")
		light.Name = "LightBinderTorchLight"
		light.Parent = attachment
		self:AddCleanup(light)

		self.createdLight = light
		self.lights = { light }
	end

	self:refresh()
	self:ObserveAttribute("LightEnabled", function()
		self:refresh()
	end)
	self:ObserveAttribute("LightBrightness", function()
		self:refresh()
	end)
	self:ObserveAttribute("LightRange", function()
		self:refresh()
	end)
	self:ObserveAttribute("LightColor", function()
		self:refresh()
	end)
	self:ObserveAttribute("LightShadows", function()
		self:refresh()
	end)
	self:ObserveAttribute("LightFlickerAmount", function()
		self:refresh()
	end)
	self:Connect(RunService.RenderStepped, function()
		self:step()
	end)

	return self
end

function LightBinder.refresh(self: any)
	self.enabled = resolveBooleanAttribute(self.instance, "LightEnabled", true)
	self.baseBrightness = resolveNumberAttribute(self.instance, "LightBrightness", 2.1)
	self.range = resolveNumberAttribute(self.instance, "LightRange", 15)
	self.flickerAmount = math.clamp(resolveNumberAttribute(self.instance, "LightFlickerAmount", 0.12), 0, 0.75)
	self.shadows = resolveBooleanAttribute(self.instance, "LightShadows", true)
	self.color = if typeof(self.instance:GetAttribute("LightColor")) == "Color3"
		then self.instance:GetAttribute("LightColor") :: Color3
		else Color3.fromRGB(255, 196, 125)

	self.instance:SetAttribute("LightTagged", true)

	for _, light in self.lights do
		if light:IsA("PointLight") or light:IsA("SpotLight") or light:IsA("SurfaceLight") then
			light.Enabled = self.enabled
			light.Brightness = self.baseBrightness
			light.Range = self.range
			light.Color = self.color
			light.Shadows = self.shadows
		end
	end
end

function LightBinder.step(self: any)
	if not self.enabled or #self.lights <= 0 then
		return
	end

	local noiseTime = os.clock() * 6 + self.flickerSeed
	local alpha = 1 + math.noise(noiseTime, 0, 0) * self.flickerAmount
	local brightness = math.max(0, self.baseBrightness * alpha)

	for _, light in self.lights do
		if light:IsA("PointLight") or light:IsA("SpotLight") or light:IsA("SurfaceLight") then
			light.Brightness = brightness
		end
	end
end

return LightBinder
]]></string>
              </Properties>
            </Item>
