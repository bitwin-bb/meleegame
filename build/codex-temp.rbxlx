              <Item class="ModuleScript" referent="1193">
                <Properties>
                  <string name="Name">WorkspaceFolders</string>
                  <string name="Source"><![CDATA[--!strict
local Workspace = game:GetService("Workspace")

local WorkspaceFolders = {}

local GAME_FOLDER_NAME = "Game"

WorkspaceFolders.GAME_FOLDER_NAME = GAME_FOLDER_NAME

local function asFolder(instance: Instance?): Folder?
	if instance ~= nil and instance:IsA("Folder") then
		return instance
	end
	return nil
end

function WorkspaceFolders.GetOrCreateGameFolder(): Folder
	local existing = asFolder(Workspace:FindFirstChild(GAME_FOLDER_NAME))
	if existing ~= nil then
		return existing
	end

	local folder = Instance.new("Folder")
	folder.Name = GAME_FOLDER_NAME
	folder.Parent = Workspace
	return folder
end

function WorkspaceFolders.FindFolderInGame(folderName: string): Folder?
	local gameFolder = asFolder(Workspace:FindFirstChild(GAME_FOLDER_NAME))
	if gameFolder == nil then
		return nil
	end
	return asFolder(gameFolder:FindFirstChild(folderName))
end

function WorkspaceFolders.FindFolderInGameOrWorkspace(folderName: string): Folder?
	local inGame = WorkspaceFolders.FindFolderInGame(folderName)
	if inGame ~= nil then
		return inGame
	end
	return asFolder(Workspace:FindFirstChild(folderName))
end

function WorkspaceFolders.GetOrCreateFolderInGame(folderName: string): Folder
	local gameFolder = WorkspaceFolders.GetOrCreateGameFolder()

	local inGame = gameFolder:FindFirstChild(folderName)
	if inGame ~= nil then
		if inGame:IsA("Folder") then
			return inGame
		end
		inGame:Destroy()
	end

	local legacy = Workspace:FindFirstChild(folderName)
	if legacy ~= nil then
		if legacy:IsA("Folder") then
			legacy.Parent = gameFolder
			return legacy
		end
		legacy:Destroy()
	end

	local folder = Instance.new("Folder")
	folder.Name = folderName
	folder.Parent = gameFolder
	return folder
end

WorkspaceFolders.getOrCreateGameFolder = WorkspaceFolders.GetOrCreateGameFolder
WorkspaceFolders.findFolderInGame = WorkspaceFolders.FindFolderInGame
WorkspaceFolders.findFolderInGameOrWorkspace = WorkspaceFolders.FindFolderInGameOrWorkspace
WorkspaceFolders.getOrCreateFolderInGame = WorkspaceFolders.GetOrCreateFolderInGame

return WorkspaceFolders
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="1194">
                <Properties>
                  <string name="Name">WorldMutationQueue</string>
                  <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Sift = require(ReplicatedStorage.Packages.Sift)

local BinaryStreaming = require(script.Parent.BinaryStreaming)
local Codec = require(script.Parent.Codec)

local WorldMutationQueue = {}
WorldMutationQueue.__index = WorldMutationQueue

export type TileMutation = {
	x: number,
	y: number,
	z: number,
	tileId: any,
	previousTileId: any?,
	flags: number?,
	metadata: { [string]: any }?,
}

export type ChunkMutationBatch = {
	key: string,
	chunkX: number,
	chunkY: number,
	chunkZ: number,
	mutations: { TileMutation },
}

export type FlushBatch = {
	sequence: number,
	timestamp: number,
	totalMutations: number,
	chunks: { ChunkMutationBatch },
}

export type QueueConfig = {
	chunkSize: number?,
	flushInterval: number?,
	maxMutationsPerFlush: number?,
}

export type WorldMutationQueue = typeof(setmetatable({} :: any, WorldMutationQueue))

local function clampInteger(valueRaw: any, fallback: number, minValue: number, maxValue: number): number
	local value = if typeof(valueRaw) == "number" then math.floor(valueRaw) else fallback
	if value < minValue then
		return minValue
	end
	if value > maxValue then
		return maxValue
	end
	return value
end

local function clampPositiveNumber(valueRaw: any, fallback: number, minValue: number, maxValue: number): number
	local value = if typeof(valueRaw) == "number" then valueRaw else fallback
	if value < minValue then
		return minValue
	end
	if value > maxValue then
		return maxValue
	end
	return value
end

local function key3(x: number, y: number, z: number): string
	return string.format("%d|%d|%d", x, y, z)
end

local function sortChunkKeys(a: string, b: string): boolean
	return a < b
end

local function worldToChunk(value: number, chunkSize: number): number
	return math.floor(value / chunkSize)
end

local function sanitizeMutation(raw: any): TileMutation?
	if typeof(raw) ~= "table" then
		return nil
	end
	if typeof(raw.x) ~= "number" or typeof(raw.y) ~= "number" or typeof(raw.z) ~= "number" then
		return nil
	end
	if raw.tileId == nil then
		return nil
	end
	local metadata: { [string]: any }? = nil
	if typeof(raw.metadata) == "table" then
		metadata = Sift.Dictionary.copy(raw.metadata)
	end
	return {
		x = math.floor(raw.x),
		y = math.floor(raw.y),
		z = math.floor(raw.z),
		tileId = raw.tileId,
		previousTileId = raw.previousTileId,
		flags = if typeof(raw.flags) == "number" then math.floor(raw.flags) else nil,
		metadata = metadata,
	}
end

local function rebuildLookup(bucket: any)
	local lookup = bucket.lookup
	table.clear(lookup)
	for index = 1, #bucket.mutations do
		local mutation = bucket.mutations[index]
		lookup[key3(mutation.x, mutation.y, mutation.z)] = index
	end
end

function WorldMutationQueue.New(configRaw: QueueConfig?): WorldMutationQueue
	local config = if typeof(configRaw) == "table" then configRaw else {}
	local chunkSize = clampInteger(config.chunkSize, 32, 1, 1024)
	local flushInterval = clampPositiveNumber(config.flushInterval, 0.1, 0.005, 60)
	local maxMutationsPerFlush = clampInteger(config.maxMutationsPerFlush, 4096, 1, 1000000)

	local self = setmetatable({
		chunkSize = chunkSize,
		flushInterval = flushInterval,
		maxMutationsPerFlush = maxMutationsPerFlush,
		elapsed = 0,
		clock = 0,
		pendingCount = 0,
		sequence = 0,
		chunkBuckets = {} :: { [string]: any },
		chunkKeys = {} :: { string },
	}, WorldMutationQueue)
	return self
end

function WorldMutationQueue._getOrCreateBucket(self: WorldMutationQueue, chunkX: number, chunkY: number, chunkZ: number)
	local chunkKey = key3(chunkX, chunkY, chunkZ)
	local bucket = self.chunkBuckets[chunkKey]
	if bucket ~= nil then
		return bucket
	end
	bucket = {
		key = chunkKey,
		chunkX = chunkX,
		chunkY = chunkY,
		chunkZ = chunkZ,
		mutations = {},
		lookup = {},
	}
	self.chunkBuckets[chunkKey] = bucket
	self.chunkKeys[#self.chunkKeys + 1] = chunkKey
	return bucket
end

function WorldMutationQueue.Enqueue(self: WorldMutationQueue, mutationRaw: any): boolean
	local mutation = sanitizeMutation(mutationRaw)
	if mutation == nil then
		return false
	end

	local chunkX = worldToChunk(mutation.x, self.chunkSize)
	local chunkY = worldToChunk(mutation.y, self.chunkSize)
	local chunkZ = worldToChunk(mutation.z, self.chunkSize)
	local bucket = self:_getOrCreateBucket(chunkX, chunkY, chunkZ)
	local coordKey = key3(mutation.x, mutation.y, mutation.z)
	local existingIndex = bucket.lookup[coordKey]
	if existingIndex ~= nil then
		bucket.mutations[existingIndex] = mutation
		return true
	end

	bucket.mutations[#bucket.mutations + 1] = mutation
	bucket.lookup[coordKey] = #bucket.mutations
	self.pendingCount += 1
	return true
end

function WorldMutationQueue.EnqueueBatch(self: WorldMutationQueue, listRaw: any): number
	if typeof(listRaw) ~= "table" then
		return 0
	end
	local accepted = 0
	for _, mutation in listRaw do
		if self:enqueue(mutation) then
			accepted += 1
		end
	end
	return accepted
end

function WorldMutationQueue.SetFlushInterval(self: WorldMutationQueue, secondsRaw: any)
	self.flushInterval = clampPositiveNumber(secondsRaw, self.flushInterval, 0.005, 60)
end

function WorldMutationQueue.SetMaxMutationsPerFlush(self: WorldMutationQueue, countRaw: any)
	self.maxMutationsPerFlush = clampInteger(countRaw, self.maxMutationsPerFlush, 1, 1000000)
end

function WorldMutationQueue.GetPendingCount(self: WorldMutationQueue): number
	return self.pendingCount
end

function WorldMutationQueue._drainBucket(
	self: WorldMutationQueue,
	bucket: any,
	remainingBudget: number
): ChunkMutationBatch?
	local mutationCount = #bucket.mutations
	if mutationCount <= 0 then
		return nil
	end

	if mutationCount <= remainingBudget then
		local out = {
			key = bucket.key,
			chunkX = bucket.chunkX,
			chunkY = bucket.chunkY,
			chunkZ = bucket.chunkZ,
			mutations = bucket.mutations,
		} :: ChunkMutationBatch
		self.pendingCount -= mutationCount
		bucket.mutations = {}
		table.clear(bucket.lookup)
		return out
	end

	if remainingBudget <= 0 then
		return nil
	end

	local outMutations = Sift.Array.create(remainingBudget)
	for index = 1, remainingBudget do
		outMutations[index] = bucket.mutations[index]
	end

	for index = 1, mutationCount - remainingBudget do
		bucket.mutations[index] = bucket.mutations[index + remainingBudget]
	end
	for index = mutationCount, mutationCount - remainingBudget + 1, -1 do
		bucket.mutations[index] = nil
	end

	rebuildLookup(bucket)
	self.pendingCount -= remainingBudget

	return {
		key = bucket.key,
		chunkX = bucket.chunkX,
		chunkY = bucket.chunkY,
		chunkZ = bucket.chunkZ,
		mutations = outMutations,
	} :: ChunkMutationBatch
end

function WorldMutationQueue.Flush(
	self: WorldMutationQueue,
	maxMutationsRaw: any?,
	onFlush: ((batch: FlushBatch) -> ())?
): FlushBatch?
	if self.pendingCount <= 0 then
		return nil
	end

	local maxMutations = if maxMutationsRaw ~= nil
		then clampInteger(maxMutationsRaw, self.maxMutationsPerFlush, 1, 1000000)
		else self.maxMutationsPerFlush
	if maxMutations <= 0 then
		return nil
	end

	table.sort(self.chunkKeys, sortChunkKeys)
	local chunks = {}
	local emitted = 0

	for index = 1, #self.chunkKeys do
		if emitted >= maxMutations then
			break
		end
		local chunkKey = self.chunkKeys[index]
		local bucket = self.chunkBuckets[chunkKey]
		if bucket == nil then
			continue
		end
		local remaining = maxMutations - emitted
		local chunkBatch = self:_drainBucket(bucket, remaining)
		if chunkBatch ~= nil then
			emitted += #chunkBatch.mutations
			chunks[#chunks + 1] = chunkBatch
		end
	end

	for index = #self.chunkKeys, 1, -1 do
		local chunkKey = self.chunkKeys[index]
		local bucket = self.chunkBuckets[chunkKey]
		if bucket == nil then
			table.remove(self.chunkKeys, index)
		elseif #bucket.mutations == 0 then
			self.chunkBuckets[chunkKey] = nil
			table.remove(self.chunkKeys, index)
		end
	end

	if emitted <= 0 then
		return nil
	end

	self.sequence += 1
	local batch = {
		sequence = self.sequence,
		timestamp = self.clock,
		totalMutations = emitted,
		chunks = chunks,
	} :: FlushBatch

	if onFlush ~= nil then
		onFlush(batch)
	end
	return batch
end

function WorldMutationQueue.Update(
	self: WorldMutationQueue,
	dtRaw: any,
	onFlush: ((batch: FlushBatch) -> ())?
): { FlushBatch }
	local dt = if typeof(dtRaw) == "number" and dtRaw > 0 then dtRaw else 0
	if dt <= 0 then
		return {}
	end
	self.clock += dt
	self.elapsed += dt
	if self.pendingCount <= 0 then
		return {}
	end
	if self.elapsed < self.flushInterval then
		return {}
	end

	local flushed = {}
	while self.elapsed >= self.flushInterval and self.pendingCount > 0 do
		local batch = self:flush(nil, onFlush)
		if batch == nil then
			break
		end
		flushed[#flushed + 1] = batch
		self.elapsed -= self.flushInterval
	end
	return flushed
end

function WorldMutationQueue.EncodeBatch(self: WorldMutationQueue, batch: FlushBatch, compressRaw: any?): string
	local shouldCompress = compressRaw ~= false
	local payload = {
		sequence = batch.sequence,
		timestamp = batch.timestamp,
		totalMutations = batch.totalMutations,
		chunks = batch.chunks,
	}
	if shouldCompress then
		return Codec.serializeCompressed(payload)
	end
	return Codec.serializeDeterministic(payload)
end

function WorldMutationQueue.DecodeBatch(self: WorldMutationQueue, payloadRaw: any, compressedRaw: any?): FlushBatch?
	if typeof(payloadRaw) ~= "string" then
		return nil
	end
	local compressed = compressedRaw ~= false
	local decoded = if compressed
		then Codec.deserializeCompressed(payloadRaw)
		else Codec.deserializeDeterministic(payloadRaw)
	if typeof(decoded) ~= "table" then
		return nil
	end
	return decoded :: FlushBatch
end

function WorldMutationQueue.EncodeBatchFrame(self: WorldMutationQueue, batch: FlushBatch, options: any?): buffer
	local serialized = self:encodeBatch(batch, true)
	local payload = buffer.create(#serialized)
	buffer.writestring(payload, 0, serialized)
	return BinaryStreaming.framePacket(payload, #serialized, options)
end

function WorldMutationQueue.Destroy(self: WorldMutationQueue)
	table.clear(self.chunkBuckets)
	table.clear(self.chunkKeys)
	self.pendingCount = 0
	self.elapsed = 0
end

WorldMutationQueue.new = WorldMutationQueue.New
WorldMutationQueue.enqueue = WorldMutationQueue.Enqueue
WorldMutationQueue.enqueueBatch = WorldMutationQueue.EnqueueBatch
WorldMutationQueue.setFlushInterval = WorldMutationQueue.SetFlushInterval
WorldMutationQueue.setMaxMutationsPerFlush = WorldMutationQueue.SetMaxMutationsPerFlush
WorldMutationQueue.getPendingCount = WorldMutationQueue.GetPendingCount
WorldMutationQueue.flush = WorldMutationQueue.Flush
WorldMutationQueue.update = WorldMutationQueue.Update
WorldMutationQueue.encodeBatch = WorldMutationQueue.EncodeBatch
WorldMutationQueue.decodeBatch = WorldMutationQueue.DecodeBatch
WorldMutationQueue.encodeBatchFrame = WorldMutationQueue.EncodeBatchFrame
WorldMutationQueue.destroy = WorldMutationQueue.Destroy

return WorldMutationQueue
]]></string>
                </Properties>
              </Item>
            </Item>
            <Item class="Folder" referent="1195">
              <Properties>
                <string name="Name">Game</string>
              </Properties>
              <Item class="Folder" referent="1196">
                <Properties>
                  <string name="Name">Format</string>
                </Properties>
                <Item class="ModuleScript" referent="1197">
                  <Properties>
                    <string name="Name">ResolveItem</string>
                    <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local StringUtils = require(script:FindFirstAncestor("game").Shared.Modules.Core.StringUtils)
local InstanceUtils = require(script:FindFirstAncestor("game").Shared.Modules.Platform.InstanceUtils)
local ItemRegistry = require(script:FindFirstAncestor("game").Shared.Modules.Items.Registry)
local ResolveToolInstance = require(script:FindFirstAncestor("game").Shared.Modules.Game.Format.ResolveToolInstance)
local LootServiceData = require(script:FindFirstAncestor("game").Shared.Services.Data)
local LootServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.LootServiceUtils)

local ResolveItem = {}

export type ItemTemplateResolution = {
	primaryTemplate: Instance?,
	toolTemplate: Tool?,
}

type CachedResolution = {
	primaryTemplate: Instance | boolean,
	toolTemplate: Tool | boolean,
}

local assetSearchRootsCache = nil :: { Instance }?
local resolutionCacheByItemId = {} :: { [string]: CachedResolution }
local ITEM_VARIANT_BRANCH_NAMES = {
	model = true,
	tool = true,
}

local function sanitizeItemId(itemIdRaw: any): string?
	return StringUtils.sanitize(itemIdRaw, nil)
end

local function appendUniqueString(target: { string }, seen: { [string]: boolean }, valueRaw: any)
	local value = sanitizeItemId(valueRaw)
	if value == nil or seen[value] == true then
		return
	end

	seen[value] = true
	target[#target + 1] = value
end

local function resolveAssetSearchRoots(): { Instance }
	if assetSearchRootsCache ~= nil then
		return assetSearchRootsCache
	end

	local roots = {}
	local pathsRaw = if typeof(LootServiceData) == "table" then (LootServiceData :: { [string]: any }).assetSearchRoots else nil
	if typeof(pathsRaw) == "table" then
		for _, pathRaw in pathsRaw do
			if typeof(pathRaw) ~= "table" then
				continue
			end

			local segments = {}
			for _, segmentRaw in pathRaw do
				local segment = sanitizeItemId(segmentRaw)
				if segment ~= nil then
					segments[#segments + 1] = segment
				end
			end
			if #segments <= 0 then
				continue
			end

			local resolved = InstanceUtils.resolveChildPath(ReplicatedStorage, segments)
			if resolved ~= nil then
				roots[#roots + 1] = resolved
			end
		end
	end

	if #roots <= 0 then
		local assets = ReplicatedStorage:FindFirstChild("Assets")
		if assets ~= nil then
			roots[#roots + 1] = assets
		end
	end

	assetSearchRootsCache = roots
	return roots
end

local function resolveItemNameCandidates(itemIdRaw: any): { string }
	local itemId = sanitizeItemId(itemIdRaw)
	if itemId == nil then
		return {}
	end

	local candidates = {}
	local seen = {} :: { [string]: boolean }

	local baseCandidates = LootServiceUtils.resolveItemNameCandidates(LootServiceData, itemId)
	for _, candidate in baseCandidates do
		appendUniqueString(candidates, seen, candidate)
	end

	local definition = ItemRegistry.resolveDefinition(itemId)
	if typeof(definition) == "table" then
		local definitionTable = definition :: { [string]: any }
		appendUniqueString(candidates, seen, definitionTable.name)
		appendUniqueString(candidates, seen, definitionTable.id)
		appendUniqueString(candidates, seen, definitionTable.itemId)
	end

	return candidates
end

local function isVariantBranchName(nameRaw: any): boolean
	local name = sanitizeItemId(nameRaw)
	if name == nil then
		return false
	end
	return ITEM_VARIANT_BRANCH_NAMES[string.lower(name)] == true
end

local function promoteMatchedTemplateRoot(match: Instance): Instance
	local promoted = match
	local parent = promoted.Parent
	while parent ~= nil and parent ~= ReplicatedStorage do
		if isVariantBranchName(parent.Name) and parent.Parent ~= nil then
			promoted = parent.Parent
			parent = promoted.Parent
		else
			break
		end
	end
	return promoted
end

local function resolveTemplatesFromRoot(root: Instance): ItemTemplateResolution
	local toolTemplate = ResolveToolInstance.resolveTool(root)
	local primaryTemplate = if root:IsA("Tool") then root else ResolveToolInstance.resolveVisualTemplate(root)
	if primaryTemplate == nil then
		primaryTemplate = toolTemplate
	end

	return {
		primaryTemplate = primaryTemplate,
		toolTemplate = toolTemplate,
	}
end

local function isCachedTemplateAlive(templateRaw: Instance | boolean): boolean
	if templateRaw == false then
		return true
	end
	return (templateRaw :: Instance).Parent ~= nil
end

local function readCachedResolution(itemId: string): ItemTemplateResolution?
	local cached = resolutionCacheByItemId[itemId]
	if cached == nil then
		return nil
	end

	if not isCachedTemplateAlive(cached.primaryTemplate) or not isCachedTemplateAlive(cached.toolTemplate) then
		resolutionCacheByItemId[itemId] = nil
		return nil
	end

	return {
		primaryTemplate = if cached.primaryTemplate == false then nil else (cached.primaryTemplate :: Instance),
		toolTemplate = if cached.toolTemplate == false then nil else (cached.toolTemplate :: Tool),
	}
end

local function cacheResolution(itemId: string, resolution: ItemTemplateResolution): ItemTemplateResolution
	resolutionCacheByItemId[itemId] = {
		primaryTemplate = if resolution.primaryTemplate ~= nil then resolution.primaryTemplate else false,
		toolTemplate = if resolution.toolTemplate ~= nil then resolution.toolTemplate else false,
	}
	return resolution
end

function ResolveItem.Resolve(itemIdRaw: any): ItemTemplateResolution
	local itemId = sanitizeItemId(itemIdRaw)
	if itemId == nil then
		return {
			primaryTemplate = nil,
			toolTemplate = nil,
		}
	end

	local cached = readCachedResolution(itemId)
	if cached ~= nil then
		return cached
	end

	local roots = resolveAssetSearchRoots()
	local candidates = resolveItemNameCandidates(itemId)
	local resolvedRoots = {} :: { [Instance]: boolean }

	local function tryResolveFromMatch(match: Instance): ItemTemplateResolution?
		local promotedRoot = promoteMatchedTemplateRoot(match)
		if resolvedRoots[promotedRoot] == true then
			return nil
		end
		resolvedRoots[promotedRoot] = true

		local resolution = resolveTemplatesFromRoot(promotedRoot)
		if resolution.primaryTemplate ~= nil or resolution.toolTemplate ~= nil then
			return resolution
		end
		return nil
	end

	for _, root in roots do
		for _, candidate in candidates do
			local direct = root:FindFirstChild(candidate)
			if direct ~= nil then
				local resolution = tryResolveFromMatch(direct)
				if resolution ~= nil then
					return cacheResolution(itemId, resolution)
				end
			end
		end
	end

	for _, root in roots do
		for _, candidate in candidates do
			for _, descendant in root:GetDescendants() do
				if descendant.Name ~= candidate then
					continue
				end

				local resolution = tryResolveFromMatch(descendant)
				if resolution ~= nil then
					return cacheResolution(itemId, resolution)
				end
			end
		end
	end

	return cacheResolution(itemId, {
		primaryTemplate = nil,
		toolTemplate = nil,
	})
end

function ResolveItem.ResolvePrimaryTemplate(itemIdRaw: any): Instance?
	return ResolveItem.Resolve(itemIdRaw).primaryTemplate
end

function ResolveItem.ResolveToolTemplate(itemIdRaw: any): Tool?
	return ResolveItem.Resolve(itemIdRaw).toolTemplate
end

function ResolveItem.CloneToolTemplate(itemIdRaw: any): Tool?
	local template = ResolveItem.ResolveToolTemplate(itemIdRaw)
	if template == nil then
		return nil
	end

	local clone = template:Clone()
	if not clone:IsA("Tool") then
		clone:Destroy()
		return nil
	end
	return clone
end

function ResolveItem.ClearCache()
	assetSearchRootsCache = nil
	table.clear(resolutionCacheByItemId)
end

ResolveItem.resolve = ResolveItem.Resolve
ResolveItem.resolvePrimaryTemplate = ResolveItem.ResolvePrimaryTemplate
ResolveItem.resolveToolTemplate = ResolveItem.ResolveToolTemplate
ResolveItem.cloneToolTemplate = ResolveItem.CloneToolTemplate
ResolveItem.clearCache = ResolveItem.ClearCache

return ResolveItem
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="1198">
                  <Properties>
                    <string name="Name">ResolveToolInstance</string>
                    <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ItemRegistry = require(script:FindFirstAncestor("game").Shared.Modules.Items.Registry)

local ResolveToolInstance = {}

local ITEM_ID_ATTRIBUTE_NAMES = { "itemId", "ItemId", "ittemId", "id" }
local ITEM_TYPE_ATTRIBUTE_NAMES = { "itemType", "ItemType", "itemtype", "type", "Type" }
local PREFERRED_TOOL_BRANCH_NAMES = {
	tool = true,
}
local PREFERRED_MODEL_BRANCH_NAMES = {
	model = true,
}

local function trim(valueRaw: any): string
	if typeof(valueRaw) ~= "string" then
		return ""
	end
	return string.match(valueRaw, "^%s*(.-)%s*$") or ""
end

local function sanitizeString(valueRaw: any): string?
	local value = trim(valueRaw)
	if value == "" then
		return nil
	end
	return value
end

local function normalizeNameToken(valueRaw: any): string
	local value = sanitizeString(valueRaw)
	if value == nil then
		return ""
	end
	return string.lower(value)
end

local function isPreferredBranch(instance: Instance, lookup: { [string]: boolean }): boolean
	return lookup[normalizeNameToken(instance.Name)] == true
end

local function isVisualInstance(instance: Instance): boolean
	return instance:IsA("Model") or instance:IsA("BasePart") or instance:IsA("Accessory")
end

local function isDescendantOfInstance(instance: Instance, ancestor: Instance): boolean
	local parent = instance.Parent
	while parent ~= nil do
		if parent == ancestor then
			return true
		end
		parent = parent.Parent
	end
	return false
end

local function collectPreferredChildren(root: Instance, lookup: { [string]: boolean }): { Instance }
	local children = root:GetChildren()
	local ordered = {}

	for _, child in children do
		if isPreferredBranch(child, lookup) then
			table.insert(ordered, child)
		end
	end

	for _, child in children do
		if not isPreferredBranch(child, lookup) then
			table.insert(ordered, child)
		end
	end

	return ordered
end

local function collectMatchingChildren(root: Instance, lookup: { [string]: boolean }): { Instance }
	local matched = {}
	for _, child in root:GetChildren() do
		if isPreferredBranch(child, lookup) then
			table.insert(matched, child)
		end
	end
	return matched
end

local function collectExcludedToolRoots(root: Instance): { Instance }
	local excluded = {}
	for _, child in root:GetChildren() do
		if child:IsA("Tool") or isPreferredBranch(child, PREFERRED_TOOL_BRANCH_NAMES) then
			table.insert(excluded, child)
		end
	end
	return excluded
end

local function isInsideExcludedRoot(instance: Instance, excludedRoots: { Instance }): boolean
	for _, excludedRoot in excludedRoots do
		if instance == excludedRoot or isDescendantOfInstance(instance, excludedRoot) then
			return true
		end
	end
	return false
end

local function isInsidePreferredToolBranch(instance: Instance): boolean
	local parent = instance.Parent
	while parent ~= nil do
		if parent:IsA("Tool") or isPreferredBranch(parent, PREFERRED_TOOL_BRANCH_NAMES) then
			return true
		end
		parent = parent.Parent
	end
	return false
end

local function collectToolAttributeSources(tool: Tool): { Instance }
	local sources = { tool :: Instance }

	for _, child in tool:GetChildren() do
		table.insert(sources, child)
	end

	for _, descendant in tool:GetDescendants() do
		if descendant.Parent ~= tool then
			table.insert(sources, descendant)
		end
	end

	return sources
end

local function resolveAttributeText(instances: { Instance }, attributeNames: { string }): string?
	for _, instance in instances do
		for _, attributeName in attributeNames do
			local attributeValue = sanitizeString(instance:GetAttribute(attributeName))
			if attributeValue ~= nil then
				return attributeValue
			end
		end
	end
	return nil
end

local function resolveCanonicalOrFallbackItemId(valueRaw: any): string?
	local value = sanitizeString(valueRaw)
	if value == nil then
		return nil
	end

	local canonicalItemId = ItemRegistry.resolveCanonicalItemId(value)
	if canonicalItemId ~= nil then
		return canonicalItemId
	end

	return value
end

function ResolveToolInstance.ResolveTool(instanceRaw: any): Tool?
	if typeof(instanceRaw) ~= "Instance" then
		return nil
	end

	local instance = instanceRaw :: Instance
	if instance:IsA("Tool") then
		return instance
	end
	local ancestorTool = instance:FindFirstAncestorWhichIsA("Tool")
	if ancestorTool ~= nil then
		return ancestorTool
	end

	for _, child in collectPreferredChildren(instance, PREFERRED_TOOL_BRANCH_NAMES) do
		if child:IsA("Tool") then
			return child
		end

		local descendant = child:FindFirstChildWhichIsA("Tool", true)
		if descendant ~= nil then
			return descendant
		end
	end

	return nil
end

local function resolveVisualFromContainer(container: Instance, excludedToolRoots: { Instance }): Instance?
	if
		container:IsA("Tool")
		or isPreferredBranch(container, PREFERRED_TOOL_BRANCH_NAMES)
		or isInsideExcludedRoot(container, excludedToolRoots)
	then
		return nil
	end

	if isVisualInstance(container) then
		return container
	end

	for _, child in container:GetChildren() do
		if
			child:IsA("Tool")
			or isPreferredBranch(child, PREFERRED_TOOL_BRANCH_NAMES)
			or isInsideExcludedRoot(child, excludedToolRoots)
		then
			continue
		end
		if isVisualInstance(child) then
			return child
		end
	end

	for _, descendant in container:GetDescendants() do
		if
			descendant:IsA("Tool")
			or isInsideExcludedRoot(descendant, excludedToolRoots)
			or isInsidePreferredToolBranch(descendant)
		then
			continue
		end
		if isVisualInstance(descendant) then
			return descendant
		end
	end

	return nil
end

function ResolveToolInstance.ResolveVisualTemplate(instanceRaw: any): Instance?
	if typeof(instanceRaw) ~= "Instance" then
		return nil
	end

	local instance = instanceRaw :: Instance
	if instance:IsA("Tool") then
		return nil
	end

	local excludedToolRoots = collectExcludedToolRoots(instance)
	for _, child in collectMatchingChildren(instance, PREFERRED_MODEL_BRANCH_NAMES) do
		local visual = resolveVisualFromContainer(child, {})
		if visual ~= nil then
			return visual
		end
	end

	local directVisual = resolveVisualFromContainer(instance, excludedToolRoots)
	if directVisual ~= nil then
		return directVisual
	end

	for _, child in collectPreferredChildren(instance, PREFERRED_MODEL_BRANCH_NAMES) do
		if isInsideExcludedRoot(child, excludedToolRoots) then
			continue
		end
		local visual = resolveVisualFromContainer(child, excludedToolRoots)
		if visual ~= nil then
			return visual
		end
	end

	return nil
end

function ResolveToolInstance.ResolveToolItemId(toolRaw: any): string?
	local tool = ResolveToolInstance.ResolveTool(toolRaw)
	if tool == nil then
		return nil
	end

	local attributeSources = collectToolAttributeSources(tool)
	local directItemId = resolveAttributeText(attributeSources, ITEM_ID_ATTRIBUTE_NAMES)
	if directItemId ~= nil then
		return resolveCanonicalOrFallbackItemId(directItemId)
	end

	local fromName = sanitizeString(tool.Name)
	if fromName ~= nil then
		return resolveCanonicalOrFallbackItemId(fromName)
	end

	return nil
end

function ResolveToolInstance.ResolveToolItemType(toolRaw: any): string?
	local tool = ResolveToolInstance.ResolveTool(toolRaw)
	if tool == nil then
		return nil
	end

	local attributeSources = collectToolAttributeSources(tool)
	local directItemType = resolveAttributeText(attributeSources, ITEM_TYPE_ATTRIBUTE_NAMES)
	if directItemType ~= nil then
		return directItemType
	end

	local itemId = ResolveToolInstance.ResolveToolItemId(tool)
	if itemId == nil then
		return nil
	end

	local definition = ItemRegistry.resolveDefinition(itemId)
	if typeof(definition) ~= "table" then
		return nil
	end

	local definitionTable = definition :: { [string]: any }
	return sanitizeString(definitionTable.itemType) or sanitizeString(definitionTable.type)
end

ResolveToolInstance.resolveTool = ResolveToolInstance.ResolveTool
ResolveToolInstance.resolveVisualTemplate = ResolveToolInstance.ResolveVisualTemplate
ResolveToolInstance.resolveToolItemId = ResolveToolInstance.ResolveToolItemId
ResolveToolInstance.resolveToolItemType = ResolveToolInstance.ResolveToolItemType

return ResolveToolInstance
]]></string>
                  </Properties>
                </Item>
              </Item>
