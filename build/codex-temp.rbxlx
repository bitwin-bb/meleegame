			ZIndex = props.zIndex + 3,
		},
		icon = props.itemIcon,
		iconProps = {
			Size = UDim2.fromOffset(32, 32),
			Position = UDim2.fromScale(0.5, 0.5),
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ImageColor3 = Color3.fromRGB(255, 255, 255),
			ImageTransparency = 0,
			ZIndex = props.zIndex + 2,
		},
	})
end
