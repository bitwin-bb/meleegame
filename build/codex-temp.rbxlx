local function IsFiniteNumber(value: any): boolean
	return typeof(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

local function ClampNumber(valueRaw: any, minimum: number, maximum: number, fallback: number): number
	if not IsFiniteNumber(valueRaw) then
		return fallback
	end
	return math.clamp(valueRaw :: number, minimum, maximum)
end

local function ClampInteger(valueRaw: any, minimum: number, maximum: number, fallback: number): number
	return math.floor(ClampNumber(valueRaw, minimum, maximum, fallback))
end

local function SanitizeNumberRange(valueRaw: any, fallback: NumberRange, minimum: number, maximum: number): NumberRange
	local minValue = fallback.Min
	local maxValue = fallback.Max

	if typeof(valueRaw) == "NumberRange" then
		minValue = valueRaw.Min
		maxValue = valueRaw.Max
	elseif typeof(valueRaw) == "Vector2" then
		minValue = valueRaw.X
		maxValue = valueRaw.Y
	elseif typeof(valueRaw) == "table" then
		local source = valueRaw :: { [string]: any }
		minValue = ClampNumber(source.Min or source.min, minimum, maximum, minValue)
		maxValue = ClampNumber(source.Max or source.max, minimum, maximum, maxValue)
	end

	minValue = math.clamp(minValue, minimum, maximum)
	maxValue = math.clamp(maxValue, minimum, maximum)
	if maxValue < minValue then
		maxValue = minValue
	end
	return NumberRange.new(minValue, maxValue)
end

local function SanitizeMaterial(valueRaw: any, fallback: Enum.Material): Enum.Material
	if typeof(valueRaw) == "EnumItem" and valueRaw.EnumType == Enum.Material then
		return valueRaw :: Enum.Material
	end
	return fallback
end

local function SanitizeColor(valueRaw: any, fallback: Color3): Color3
	if typeof(valueRaw) == "Color3" then
		return valueRaw
	end
	return fallback
end

local function SanitizeString(valueRaw: any, fallback: string): string
	if typeof(valueRaw) ~= "string" then
		return fallback
	end
	local trimmed = string.match(valueRaw, "^%s*(.-)%s*$")
	if trimmed == nil or trimmed == "" then
		return fallback
	end
	return trimmed
end

local function ResolveArchetype(valueRaw: any, fallback: CactusArchetype): CactusArchetype
	if valueRaw == "Saguaro" or valueRaw == "Barrel" or valueRaw == "PricklyPear" then
		return valueRaw
	end
	return fallback
end

local function RandomInRange(randomObject: Random, range: NumberRange): number
	if range.Max <= range.Min then
		return range.Min
	end
	return randomObject:NextNumber(range.Min, range.Max)
end

local function ResolveVisibleMaterial(material: Enum.Material): Enum.Material
	if material == Enum.Material.SmoothPlastic then
		return Enum.Material.Plastic
	end
	return material
end

local function RotateWithinPlane(directionRaw: Vector3, angleRadians: number): Vector3
	local direction = if directionRaw.Magnitude > 0.0001 then directionRaw.Unit else Vector3.yAxis
	local y = direction.Y
	local z = direction.Z
	local cosine = math.cos(angleRadians)
	local sine = math.sin(angleRadians)
	local rotated = Vector3.new(0, y * cosine - z * sine, y * sine + z * cosine)
	if rotated.Magnitude <= 0.0001 then
		return Vector3.yAxis
	end
	return rotated.Unit
end

local function BlendDirection(currentRaw: Vector3, targetRaw: Vector3, alphaRaw: number): Vector3
	local current = if currentRaw.Magnitude > 0.0001 then currentRaw.Unit else Vector3.yAxis
	local target = if targetRaw.Magnitude > 0.0001 then targetRaw.Unit else Vector3.yAxis
	local alpha = math.clamp(alphaRaw, 0, 1)
	local blended = current:Lerp(target, alpha)
	if blended.Magnitude <= 0.0001 then
		return target
	end
	return blended.Unit
end

local function MakeCFrameFromSegment(startPosition: Vector3, endPosition: Vector3): (CFrame, number)
	local direction = endPosition - startPosition
	local length = direction.Magnitude
	if length <= 1e-4 then
		direction = Vector3.yAxis
		length = 1e-4
	end

	local axisX = direction.Unit
	local axisY = if math.abs(axisX:Dot(Vector3.yAxis)) > 0.985 then Vector3.zAxis else Vector3.yAxis
	local axisZ = axisX:Cross(axisY).Unit
	axisY = axisZ:Cross(axisX).Unit
	local midpoint = startPosition + direction * 0.5
	return CFrame.fromMatrix(midpoint, axisX, axisY, axisZ), length
end

local function CreateWeld(part0: BasePart, part1: BasePart)
	local weld = Instance.new("WeldConstraint")
	weld.Name = "CactusWeld"
	weld.Part0 = part0
	weld.Part1 = part1
	weld.Parent = part0
end

local function ResolveConfig(configRaw: CactusConfig?): ResolvedCactusConfig
	local source = if typeof(configRaw) == "table" then configRaw :: { [string]: any } else {}
	local archetype = ResolveArchetype(source.Archetype, DEFAULT_CONFIG.Archetype)
	local profile = ARCHETYPE_PROFILES[archetype]
	local resolvedMinHeight = ClampNumber(source.MinHeight, 0, 160, profile.MinHeight)
	local resolvedMaxHeight = ClampNumber(source.MaxHeight, resolvedMinHeight, 220, profile.MaxHeight)

	return {
		Archetype = archetype,
		Seed = ClampInteger(source.Seed, -2147483648, 2147483647, DEFAULT_CONFIG.Seed),
		Iterations = ClampInteger(source.Iterations, 2, 16, DEFAULT_CONFIG.Iterations),
		StepLength = ClampNumber(source.StepLength, 0.4, 18, DEFAULT_CONFIG.StepLength),
		BaseThickness = ClampNumber(source.BaseThickness, 0.3, 12, DEFAULT_CONFIG.BaseThickness),
		AngleDegrees = ClampNumber(source.AngleDegrees, 0, 65, DEFAULT_CONFIG.AngleDegrees),
		MinBranchHeight = ClampNumber(source.MinBranchHeight, 0, 160, DEFAULT_CONFIG.MinBranchHeight),
		MaxBranches = ClampInteger(source.MaxBranches, 0, 8, DEFAULT_CONFIG.MaxBranches),
		Curvature = ClampNumber(source.Curvature, 0, 35, DEFAULT_CONFIG.Curvature),
		SegmentMaterial = SanitizeMaterial(source.SegmentMaterial, DEFAULT_CONFIG.SegmentMaterial),
		SegmentColor = SanitizeColor(source.SegmentColor, DEFAULT_CONFIG.SegmentColor),
		UseWelds = if source.UseWelds == nil then DEFAULT_CONFIG.UseWelds else source.UseWelds == true,
		Parent = if typeof(source.Parent) == "Instance" then source.Parent else DEFAULT_CONFIG.Parent,
		ModelName = SanitizeString(source.ModelName, DEFAULT_CONFIG.ModelName),
		MaxSegments = ClampInteger(source.MaxSegments, 4, 512, DEFAULT_CONFIG.MaxSegments),
		BranchChance = ClampNumber(source.BranchChance, 0, 1, DEFAULT_CONFIG.BranchChance),
		BranchStartIteration = ClampInteger(source.BranchStartIteration, 1, 16, DEFAULT_CONFIG.BranchStartIteration),
		LengthJitter = SanitizeNumberRange(source.LengthJitter, DEFAULT_CONFIG.LengthJitter, 0.5, 1.5),
		AngleJitter = SanitizeNumberRange(source.AngleJitter, DEFAULT_CONFIG.AngleJitter, -25, 25),
		CurvatureJitter = SanitizeNumberRange(source.CurvatureJitter, DEFAULT_CONFIG.CurvatureJitter, -18, 18),
		ThicknessFalloff = ClampNumber(source.ThicknessFalloff, 0, 1, DEFAULT_CONFIG.ThicknessFalloff),
		ArmThicknessScale = ClampNumber(source.ArmThicknessScale, 0.2, 1, DEFAULT_CONFIG.ArmThicknessScale),
		TrunkWobbleDegrees = ClampNumber(source.TrunkWobbleDegrees, 0, 16, DEFAULT_CONFIG.TrunkWobbleDegrees),
		MinimumThickness = ClampNumber(source.MinimumThickness, 0.08, 6, DEFAULT_CONFIG.MinimumThickness),
		SegmentCanCollide = if source.SegmentCanCollide == nil
			then DEFAULT_CONFIG.SegmentCanCollide
			else source.SegmentCanCollide == true,
		MinHeight = resolvedMinHeight,
		MaxHeight = resolvedMaxHeight,
		NodeSpacing = ClampNumber(source.NodeSpacing, 0, 12, DEFAULT_CONFIG.NodeSpacing),
		DetailDensity = ClampNumber(source.DetailDensity, 0.2, 2.5, DEFAULT_CONFIG.DetailDensity),
	}
end

function CactusGenerator.New(configRaw: CactusConfig?): CactusGenerator
	local config = ResolveConfig(configRaw)
	local self = setmetatable({
		Config = config,
		Seed = config.Seed,
		Model = nil :: Model?,
		LastSegments = {} :: { Segment },
		LastSkeleton = nil :: Skeleton?,
		LastExpandedGrammar = "",
	}, CactusGenerator)
	return self
end

function CactusGenerator.Destroy(self: CactusGenerator)
	if self.Model ~= nil then
		self.Model:Destroy()
		self.Model = nil
	end
	self.LastSegments = {}
	self.LastSkeleton = nil
	self.LastExpandedGrammar = ""
end

function CactusGenerator.SetSeed(self: CactusGenerator, seedRaw: any)
	self.Seed = ClampInteger(seedRaw, -2147483648, 2147483647, self.Seed)
	self.Config.Seed = self.Seed
end

function CactusGenerator.GetSeed(self: CactusGenerator): number
	return self.Seed
end

function CactusGenerator.GetArchetypeProfile(self: CactusGenerator): ArchetypeProfile
	return ARCHETYPE_PROFILES[self.Config.Archetype]
end

function CactusGenerator.ComputeTargetHeight(
	self: CactusGenerator,
	profile: ArchetypeProfile,
	randomObject: Random
): number
	local configuredMin = if self.Config.MinHeight > 0 then self.Config.MinHeight else profile.MinHeight
	local configuredMax = if self.Config.MaxHeight > 0 then self.Config.MaxHeight else profile.MaxHeight
	local seededHeight = randomObject:NextNumber(configuredMin, configuredMax)
	local iterationBias = self.Config.StepLength * self.Config.Iterations
	return math.clamp((seededHeight + iterationBias) * 0.5, configuredMin, configuredMax)
end

function CactusGenerator.ComputeNodeSpacing(self: CactusGenerator, profile: ArchetypeProfile): number
	if self.Config.NodeSpacing > 0 then
		return self.Config.NodeSpacing
	end
	return math.max(0.45, self.Config.StepLength * profile.NodeSpacingScale)
end

function CactusGenerator.ComputeThicknessAtProgress(
	self: CactusGenerator,
	profile: ArchetypeProfile,
	progress: number,
	randomObject: Random,
	isArm: boolean
): number
	local clampedProgress = math.clamp(progress, 0, 1)
	local baseThickness = self.Config.BaseThickness
	if isArm then
		baseThickness *= self.Config.ArmThicknessScale
	end

	local bulgeAlpha = math.sin(clampedProgress * math.pi)
	local bulgeScale = 1 + bulgeAlpha * profile.BaseBulge
	local taperAlpha = clampedProgress ^ profile.TaperPower
	local taperScale = 1 - taperAlpha * self.Config.ThicknessFalloff
	local noiseScale = 1 + randomObject:NextNumber(-0.045, 0.045)
	local thickness = baseThickness * bulgeScale * taperScale * noiseScale
	return math.max(self.Config.MinimumThickness, thickness)
end

function CactusGenerator.CreateNode(
	self: CactusGenerator,
	nodes: { GrowthNode },
	parentIndex: number,
	position: Vector3,
	direction: Vector3,
	thickness: number,
	depth: number,
	height: number,
	chainId: number,
	kind: SegmentKind,
	sideSign: number
): GrowthNode
	local node: GrowthNode = {
		Index = #nodes + 1,
		ParentIndex = parentIndex,
		Position = position,
		Direction = direction,
		Thickness = thickness,
		Depth = depth,
		Height = height,
		ChainId = chainId,
		Kind = kind,
		SideSign = sideSign,
	}
	nodes[node.Index] = node
	return node
end

function CactusGenerator.CreateSegment(
	self: CactusGenerator,
	segments: { Segment },
	parentIndex: number,
	startPosition: Vector3,
	endPosition: Vector3,
	thicknessStart: number,
	thicknessEnd: number,
	depth: number,
	age: number,
	kind: SegmentKind,
	chainId: number,
	sideSign: number
): Segment
	local segment: Segment = {
		Index = #segments + 1,
		ParentIndex = parentIndex,
		Start = startPosition,
		End = endPosition,
		Thickness = (thicknessStart + thicknessEnd) * 0.5,
		ThicknessStart = thicknessStart,
		ThicknessEnd = thicknessEnd,
		Depth = depth,
		Age = age,
		Kind = kind,
		ChainId = chainId,
		SideSign = sideSign,
	}
	segments[segment.Index] = segment
	return segment
end

function CactusGenerator.ValidateBranchSpawn(
	self: CactusGenerator,
	profile: ArchetypeProfile,
	currentNode: GrowthNode,
	stepIndex: number,
	stepCount: number,
	armCount: number,
	lastBranchStep: number,
	randomObject: Random
): boolean
	if not profile.AllowsArms then
		return false
	end
	if armCount >= math.min(self.Config.MaxBranches, 8) then
		return false
	end
	if stepIndex < math.max(self.Config.BranchStartIteration, 2) then
		return false
	end
	if stepIndex - lastBranchStep < profile.BranchSpacingNodes then
		return false
	end
	if currentNode.Height < self.Config.MinBranchHeight then
		return false
	end

	local alpha = if stepCount > 0 then stepIndex / stepCount else 1
	if alpha < profile.BranchSpawnMinAlpha or alpha > profile.BranchSpawnMaxAlpha then
		return false
	end

	local uprightAlpha = math.clamp(currentNode.Direction.Y, 0, 1)
	local branchChance = self.Config.BranchChance
	branchChance *= 0.3 + alpha * 0.85
	branchChance *= 0.45 + uprightAlpha * 0.7

	if self.Config.Archetype == "PricklyPear" then
		branchChance *= 1.18
	elseif self.Config.Archetype == "Barrel" then
		branchChance *= 0
	end

	return randomObject:NextNumber() <= math.clamp(branchChance, 0, 0.95)
end

function CactusGenerator.GrowArm(
	self: CactusGenerator,
	skeleton: Skeleton,
	parentNode: GrowthNode,
	attachSegmentIndex: number,
	armOrdinal: number,
	sideSign: number,
	profile: ArchetypeProfile,
	randomObject: Random,
	targetHeight: number
)
	if #skeleton.Segments >= self.Config.MaxSegments then
		return
	end

	local heightAlpha = math.clamp(parentNode.Height / math.max(targetHeight, 0.001), 0, 1)
	local maxRemainingHeight = math.max(targetHeight - parentNode.Height, self.Config.StepLength)
	local desiredArmHeight = maxRemainingHeight
		* randomObject:NextNumber(profile.ArmLengthAlphaMin, profile.ArmLengthAlphaMax)
	local nodeSpacing = math.max(0.35, self.Config.StepLength * profile.ArmNodeSpacingScale)
	local armSteps = math.max(1, math.min(8, math.floor(desiredArmHeight / math.max(nodeSpacing, 0.001) + 0.5)))

	local direction = BlendDirection(
		parentNode.Direction,
		Vector3.new(0, profile.ArmUpwardBias, sideSign * profile.ArmOutwardBias),
		0.62
	)
	local position = parentNode.Position
	local parentSegmentIndex = attachSegmentIndex
	local lastNode = parentNode
	local chainId = armOrdinal + 1
	local kind: SegmentKind = if profile.PadMode then "Pad" else "Arm"

	for armStep = 1, armSteps do
		if #skeleton.Segments >= self.Config.MaxSegments then
			break
		end

		local progress0 = (armStep - 1) / math.max(1, armSteps)
		local progress1 = armStep / math.max(1, armSteps)
		local curvatureDegrees = self.Config.Curvature * (0.9 + profile.ArmCurvature)
		curvatureDegrees += RandomInRange(randomObject, self.Config.CurvatureJitter) * 0.5
		local outwardAngle = math.rad(sideSign * (self.Config.AngleDegrees * (1 - progress0) * 0.18))
		local wobbleAngle = math.rad(RandomInRange(randomObject, self.Config.AngleJitter) * 0.32)

		direction = RotateWithinPlane(direction, outwardAngle + wobbleAngle)
		direction = BlendDirection(
			direction,
			Vector3.new(0, 1, sideSign * 0.08),
			math.clamp(profile.ArmCurvature + progress1 * 0.44 + curvatureDegrees * 0.0025, 0, 0.92)
		)

		local stepLength = nodeSpacing * RandomInRange(randomObject, self.Config.LengthJitter)
		if kind == "Pad" then
			stepLength *= 0.72
		end

		local endPosition = position + direction * stepLength
		local thicknessStart = if armStep == 1
			then math.max(self.Config.MinimumThickness, parentNode.Thickness * self.Config.ArmThicknessScale)
			else lastNode.Thickness
		local thicknessEnd =
			self:ComputeThicknessAtProgress(profile, math.max(heightAlpha, progress1), randomObject, true)
		if kind == "Pad" then
			thicknessEnd *= 1.12
		end
		thicknessEnd = math.max(self.Config.MinimumThickness, thicknessEnd)

		local segment = self:CreateSegment(
			skeleton.Segments,
			parentSegmentIndex,
			position,
			endPosition,
			thicknessStart,
			thicknessEnd,
			1,
			armStep,
			kind,
			chainId,
			sideSign
		)
		parentSegmentIndex = segment.Index

		local nextNode = self:CreateNode(
			skeleton.Nodes,
			lastNode.Index,
			endPosition,
			direction,
			thicknessEnd,
			1,
			endPosition.Y - skeleton.Nodes[1].Position.Y,
			chainId,
			kind,
			sideSign
		)

		lastNode = nextNode
		position = endPosition
		skeleton.Height = math.max(skeleton.Height, nextNode.Height)
	end

	skeleton.ArmCount += 1
end

function CactusGenerator.GrowTrunk(
	self: CactusGenerator,
	skeleton: Skeleton,
	origin: Vector3,
	profile: ArchetypeProfile,
	randomObject: Random
)
	local targetHeight = self:ComputeTargetHeight(profile, randomObject)
	local nodeSpacing = self:ComputeNodeSpacing(profile)
	local stepCount =
		math.max(3, math.min(self.Config.MaxSegments, math.floor(targetHeight / math.max(nodeSpacing, 0.001) + 0.5)))

	local rootNode =
		self:CreateNode(skeleton.Nodes, 0, origin, Vector3.yAxis, self.Config.BaseThickness, 0, 0, 1, "Trunk", 0)
	local currentNode = rootNode
	local direction = Vector3.yAxis
	local previousSideSign = if randomObject:NextNumber() < 0.5 then -1 else 1
	local lastBranchStep = -999
	local parentSegmentIndex = 0

	for stepIndex = 1, stepCount do
		if #skeleton.Segments >= self.Config.MaxSegments then
			break
		end

		local progress0 = (stepIndex - 1) / math.max(1, stepCount)
		local progress1 = stepIndex / math.max(1, stepCount)
		local driftSign = if progress1 > 0.5 then previousSideSign else -previousSideSign
		local leanAngle = math.rad(profile.TrunkLeanDegrees * 0.08 * driftSign)
		local wobbleAngle = math.rad(RandomInRange(randomObject, self.Config.AngleJitter) * 0.18)
		local trunkBendAngle = math.rad(
			RandomInRange(
				randomObject,
				NumberRange.new(-self.Config.TrunkWobbleDegrees, self.Config.TrunkWobbleDegrees)
			)
		)

		direction = RotateWithinPlane(direction, leanAngle + wobbleAngle + trunkBendAngle)
		direction = BlendDirection(
			direction,
			Vector3.yAxis,
			math.clamp(profile.UpwardBias + profile.BendStrength * (1 - progress0), 0, 0.98)
		)

		local stepLength = nodeSpacing * RandomInRange(randomObject, self.Config.LengthJitter)
		local startPosition = currentNode.Position
		local endPosition = startPosition + direction * stepLength
		local thicknessStart = currentNode.Thickness
		local thicknessEnd = self:ComputeThicknessAtProgress(profile, progress1, randomObject, false)

		local segment = self:CreateSegment(
			skeleton.Segments,
			parentSegmentIndex,
			startPosition,
			endPosition,
			thicknessStart,
			thicknessEnd,
			0,
			stepIndex,
			"Trunk",
			1,
			0
		)
		parentSegmentIndex = segment.Index

		currentNode = self:CreateNode(
			skeleton.Nodes,
			currentNode.Index,
			endPosition,
			direction,
			thicknessEnd,
			0,
			endPosition.Y - origin.Y,
			1,
			"Trunk",
			0
		)
		skeleton.Height = math.max(skeleton.Height, currentNode.Height)
		skeleton.TrunkTipNodeIndex = currentNode.Index

		if
			self:ValidateBranchSpawn(
				profile,
				currentNode,
				stepIndex,
				stepCount,
				skeleton.ArmCount,
				lastBranchStep,
				randomObject
			)
		then
			previousSideSign *= -1
			lastBranchStep = stepIndex
			self:GrowArm(
				skeleton,
				currentNode,
				parentSegmentIndex,
				skeleton.ArmCount + 1,
				previousSideSign,
				profile,
				randomObject,
				targetHeight
			)
		end
	end
end

function CactusGenerator.GenerateSkeleton(self: CactusGenerator, origin: Vector3): Skeleton
	local profile = self:GetArchetypeProfile()
	local randomObject = Random.new(self.Seed)
	local skeleton: Skeleton = {
		Nodes = {},
		Segments = {},
		Archetype = self.Config.Archetype,
		Height = 0,
		ArmCount = 0,
		TrunkTipNodeIndex = 0,
	}

	self:GrowTrunk(skeleton, origin, profile, randomObject)

	self.LastSkeleton = skeleton
	self.LastSegments = skeleton.Segments
	self.LastExpandedGrammar = ""
	return skeleton
end

function CactusGenerator.BuildSegmentPart(self: CactusGenerator, segment: Segment): Part
	local segmentCFrame, segmentLength = MakeCFrameFromSegment(segment.Start, segment.End)
	local thickness = math.max(self.Config.MinimumThickness, segment.Thickness)
	local part = Instance.new("Part")

	part.Name = if segment.Kind == "Trunk"
		then `Trunk_{segment.Index}`
		else if segment.Kind == "Pad"
			then `Pad_{segment.ChainId}_{segment.Index}`
			else `Arm_{segment.ChainId}_{segment.Index}`
	part.Shape = Enum.PartType.Cylinder
	part.Size = if segment.Kind == "Pad"
		then Vector3.new(math.max(segmentLength * 0.82, thickness * 0.95), thickness * 1.22, thickness * 1.22)
		else Vector3.new(segmentLength, thickness, thickness)
	part.CFrame = segmentCFrame
	part.Material = ResolveVisibleMaterial(self.Config.SegmentMaterial)
	part.Color = self.Config.SegmentColor
	part.CastShadow = false
	part.CanCollide = self.Config.SegmentCanCollide
	part.CanTouch = self.Config.SegmentCanCollide
	part.CanQuery = self.Config.SegmentCanCollide
	ApplyStudSurfaces(part)
	part:SetAttribute("Depth", segment.Depth)
	part:SetAttribute("Age", segment.Age)
	part:SetAttribute("SegmentKind", segment.Kind)
	part:SetAttribute("ChainId", segment.ChainId)
	part:SetAttribute("SideSign", segment.SideSign)
	part:SetAttribute("ThicknessStart", segment.ThicknessStart)
	part:SetAttribute("ThicknessEnd", segment.ThicknessEnd)
	part:SetAttribute("RibCount", self:GetArchetypeProfile().RibCount)
	return part
end

function CactusGenerator.CreateDetailPart(
	self: CactusGenerator,
	name: string,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material,
	canCollide: boolean
): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = ResolveVisibleMaterial(material)
	part.Anchored = not self.Config.UseWelds
	part.Massless = self.Config.UseWelds
	part.CastShadow = false
	part.CanCollide = canCollide
	part.CanTouch = canCollide
	part.CanQuery = canCollide
	ApplyStudSurfaces(part)
	return part
end

function CactusGenerator.ApplyDetails(
	self: CactusGenerator,
	model: Model,
	skeleton: Skeleton,
	partsByIndex: { [number]: BasePart }
)
	local detailFolder = Instance.new("Folder")
	detailFolder.Name = "Details"
	detailFolder.Parent = model

	local profile = self:GetArchetypeProfile()
	local randomObject = Random.new(self.Seed + 4096)
	local trunkSegments = {} :: { Segment }
	for _, segment in skeleton.Segments do
		if segment.Kind == "Trunk" then
			trunkSegments[#trunkSegments + 1] = segment
		end
	end

	local areoleStep = math.max(1, math.floor(3 / math.max(self.Config.DetailDensity, 0.2)))
	local detailBudget =
		math.max(8, math.floor((#skeleton.Segments + skeleton.ArmCount * 2) * 0.45 * self.Config.DetailDensity))
	local detailCount = 0

	for segmentIndex, segment in skeleton.Segments do
		if detailCount >= detailBudget then
			break
		end

		local segmentPart = partsByIndex[segment.Index]
		if segmentPart == nil then
			continue
		end

		if segmentIndex % areoleStep == 0 then
			local alpha = randomObject:NextNumber(0.28, 0.78)
			local anchor = segment.Start:Lerp(segment.End, alpha)
			local forward = if segmentPart.CFrame.LookVector.Magnitude > 0.001
				then segmentPart.CFrame.LookVector.Unit
				else Vector3.xAxis
			local normal = if randomObject:NextNumber() < 0.5 then forward else -forward
			local areoleSize = math.max(0.08, segment.Thickness * 0.12)
			local areole = self:CreateDetailPart(
				"Areole",
				Vector3.new(areoleSize, areoleSize, areoleSize),
				CFrame.new(anchor + normal * (segment.Thickness * 0.28)),
				self.Config.SegmentColor:Lerp(Color3.new(1, 1, 1), 0.2),
				Enum.Material.Plastic,
				false
			)
			areole.Shape = Enum.PartType.Ball
			areole.Parent = detailFolder
			if self.Config.UseWelds then
				CreateWeld(segmentPart, areole)
			end

			local spineDirection = BlendDirection(normal, Vector3.yAxis, 0.25 + randomObject:NextNumber() * 0.25)
			local spineLength = math.max(0.16, segment.Thickness * 0.24)
			local spine = self:CreateDetailPart(
				"Spine",
				Vector3.new(spineLength, 0.05, 0.05),
				CFrame.lookAt(
					anchor + normal * (segment.Thickness * 0.36),
					anchor + normal * (segment.Thickness * 0.36) + spineDirection
				),
				self.Config.SegmentColor:Lerp(Color3.new(0.95, 0.9, 0.7), 0.7),
				Enum.Material.Plastic,
				false
			)
			spine.Shape = Enum.PartType.Cylinder
			spine.Parent = detailFolder
			if self.Config.UseWelds then
				CreateWeld(segmentPart, spine)
			end

			detailCount += 2
		end
	end

	local ribEvery = if self.Config.Archetype == "Barrel" then 1 else 2
	for trunkIndex, segment in trunkSegments do
		if detailCount >= detailBudget then
			break
		end
		if trunkIndex % ribEvery ~= 0 then
			continue
		end

		local segmentPart = partsByIndex[segment.Index]
		if segmentPart == nil then
			continue
		end

		local cframe, length = MakeCFrameFromSegment(segment.Start, segment.End)
		local ribOffset = math.max(0.06, segment.Thickness * 0.18)
		for _, side in ipairs({ -1, 1 }) do
			if detailCount >= detailBudget then
				break
			end
			local rib = self:CreateDetailPart(
				"Rib",
				Vector3.new(
					length * 0.96,
					math.max(0.06, segment.Thickness * 0.11),
					math.max(0.06, segment.Thickness * 0.11)
				),
				cframe + cframe.UpVector * ribOffset * side,
				self.Config.SegmentColor:Lerp(Color3.new(0, 0, 0), 0.08),
				Enum.Material.Plastic,
				false
			)
			rib.Shape = Enum.PartType.Cylinder
			rib.Parent = detailFolder
			if self.Config.UseWelds then
				CreateWeld(segmentPart, rib)
			end
			detailCount += 1
		end
	end

	if #trunkSegments > 1 then
		local scarCount = math.min(3, math.max(1, math.floor(self.Config.DetailDensity * 2)))
		for _ = 1, scarCount do
			if detailCount >= detailBudget then
				break
			end
			local segment = trunkSegments[randomObject:NextInteger(1, #trunkSegments)]
			local segmentPart = partsByIndex[segment.Index]
			if segmentPart == nil then
				continue
			end

			local anchor = segment.Start:Lerp(segment.End, randomObject:NextNumber(0.22, 0.78))
			local scar = self:CreateDetailPart(
				"Scar",
				Vector3.new(
					math.max(0.14, segment.Thickness * 0.34),
					math.max(0.06, segment.Thickness * 0.1),
					math.max(0.03, segment.Thickness * 0.05)
				),
				CFrame.lookAt(
					anchor + segmentPart.CFrame.LookVector * (segment.Thickness * 0.24),
					anchor + segmentPart.CFrame.LookVector * (segment.Thickness * 0.24) + segmentPart.CFrame.LookVector
				),
				self.Config.SegmentColor:Lerp(Color3.fromRGB(92, 64, 43), 0.34),
				Enum.Material.Plastic,
				false
			)
			scar.Parent = detailFolder
			if self.Config.UseWelds then
				CreateWeld(segmentPart, scar)
			end
			detailCount += 1
		end
	end

	local topSegment = skeleton.Segments[#skeleton.Segments]
	if topSegment ~= nil and randomObject:NextNumber() <= profile.FlowerChance * self.Config.DetailDensity then
		local topPart = partsByIndex[topSegment.Index]
		if topPart ~= nil then
			local tipPosition = topSegment.End
			local petalCount = if self.Config.Archetype == "Barrel" then 4 else 3
			for petalIndex = 1, petalCount do
				local angle = math.rad((360 / petalCount) * (petalIndex - 1))
				local offset = Vector3.new(math.cos(angle) * 0.14, 0.08 + petalIndex * 0.005, math.sin(angle) * 0.14)
				local flower = self:CreateDetailPart(
					"Flower",
					Vector3.new(0.16, 0.16, 0.16),
					CFrame.new(tipPosition + offset),
					Color3.fromRGB(245, 196, 83),
					Enum.Material.Plastic,
					false
				)
				flower.Shape = Enum.PartType.Ball
				flower.Parent = detailFolder
				if self.Config.UseWelds then
					CreateWeld(topPart, flower)
				end
			end
		end
	end
end

function CactusGenerator.BuildGeometry(self: CactusGenerator, skeleton: Skeleton, origin: Vector3): Model
	if self.Model ~= nil then
		self.Model:Destroy()
		self.Model = nil
	end

	local model = Instance.new("Model")
	model.Name = self.Config.ModelName
	model:SetAttribute("Seed", self.Seed)
	model:SetAttribute("Archetype", skeleton.Archetype)
	model:SetAttribute("SegmentCount", #skeleton.Segments)
	model:SetAttribute("ArmCount", skeleton.ArmCount)
	model:SetAttribute("Height", skeleton.Height)

	local segmentsFolder = Instance.new("Folder")
	segmentsFolder.Name = "Segments"
	segmentsFolder.Parent = model

	local partsByIndex: { [number]: BasePart } = {}
	local primaryPart: BasePart? = nil

	for _, segment in skeleton.Segments do
		local segmentPart = self:BuildSegmentPart(segment)
		if primaryPart == nil then
			primaryPart = segmentPart
			segmentPart.Anchored = true
			segmentPart.Massless = false
		elseif self.Config.UseWelds then
			segmentPart.Anchored = false
			segmentPart.Massless = true
		else
			segmentPart.Anchored = true
			segmentPart.Massless = false
		end

		segmentPart.Parent = segmentsFolder
		partsByIndex[segment.Index] = segmentPart

		if self.Config.UseWelds and primaryPart ~= nil and segment.Index ~= 1 then
			local parentPart = partsByIndex[segment.ParentIndex] or primaryPart
			CreateWeld(parentPart, segmentPart)
		end
	end

	if primaryPart == nil then
		local anchor = Instance.new("Part")
		anchor.Name = "Anchor"
		anchor.Size = Vector3.new(0.2, 0.2, 0.2)
		anchor.CFrame = CFrame.new(origin)
		anchor.Transparency = 1
		anchor.CastShadow = false
		anchor.Anchored = true
		anchor.CanCollide = false
		anchor.CanTouch = false
		anchor.CanQuery = false
		anchor.Parent = segmentsFolder
		primaryPart = anchor
	end

	model.PrimaryPart = primaryPart
	self:ApplyDetails(model, skeleton, partsByIndex)

	local boundsCFrame, boundsSize = model:GetBoundingBox()
	local boundsBottomY = boundsCFrame.Position.Y - boundsSize.Y * 0.5
	local bottomAlignmentOffset = origin.Y - boundsBottomY
	if math.abs(bottomAlignmentOffset) > 0.0001 then
		model:PivotTo(model:GetPivot() + Vector3.new(0, bottomAlignmentOffset, 0))
	end

	-- Keep generated cactus placement anchored at the terrain contact point, not the first trunk segment center.
	model.PrimaryPart = nil
	model.WorldPivot = CFrame.new(origin)

	model.Parent = if self.Config.Parent ~= nil then self.Config.Parent else Workspace
	self.Model = model
	return model
end

function CactusGenerator.BuildModel(self: CactusGenerator, skeletonOrSegments: any, origin: Vector3): Model
	if typeof(skeletonOrSegments) == "table" and skeletonOrSegments.Segments ~= nil then
		return self:BuildGeometry(skeletonOrSegments :: Skeleton, origin)
	end

	local segments = if typeof(skeletonOrSegments) == "table" then skeletonOrSegments :: { Segment } else {}
	local skeleton: Skeleton = {
		Nodes = {},
		Segments = segments,
		Archetype = self.Config.Archetype,
		Height = 0,
		ArmCount = 0,
		TrunkTipNodeIndex = 0,
	}
	return self:BuildGeometry(skeleton, origin)
end

function CactusGenerator.Interpret(self: CactusGenerator, origin: Vector3): { Segment }
	local skeleton = self:GenerateSkeleton(origin)
	return skeleton.Segments
end

function CactusGenerator.ExpandGrammar(self: CactusGenerator): string
	self.LastExpandedGrammar = ""
	return self.LastExpandedGrammar
end

function CactusGenerator.Generate(self: CactusGenerator, origin: Vector3): Model
	local skeleton = self:GenerateSkeleton(origin)
	return self:BuildGeometry(skeleton, origin)
end

CactusGenerator.new = CactusGenerator.New

return CactusGenerator
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="1144">
                <Properties>
                  <string name="Name">Cave</string>
                  <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Noise = require(script:FindFirstAncestor("game").Shared.Modules.Math.Noise)

local Cave = {}
Cave.__index = Cave

export type TileIdMap = {
	AIR: number,
}

export type WallIdMap = {
	NONE: number,
	DIRT: number,
	STONE: number,
	SANDSTONE: number,
	SNOW: number,
	MUD: number,
}

export type BiomeIdMap = {
	FOREST: number,
	DESERT: number,
	SNOW: number,
	JUNGLE: number,
}

export type DepthLayer = "Sky" | "Surface" | "Underground" | "Cavern" | "Deep"

export type CaveConfig = {
	seed: number,
	tileId: TileIdMap,
	wallId: WallIdMap,
	biomeId: BiomeIdMap,
	snowConfig: any?,
	surfaceDepth: number,
	undergroundDepth: number,
	cavernDepth: number,
	caveFrequency: number,
	caveOctaves: number,
	caveLacunarity: number,
	cavePersistence: number,
	tunnelFrequency: number,
	pocketFrequency: number,
	crackFrequency: number,
}

local DEFAULT_SURFACE_DEPTH = 8
local DEFAULT_UNDERGROUND_DEPTH = 52
local DEFAULT_CAVERN_DEPTH = 140
local DEFAULT_CAVE_FREQUENCY = 0.021
local DEFAULT_CAVE_OCTAVES = 3
local DEFAULT_CAVE_LACUNARITY = 2
local DEFAULT_CAVE_PERSISTENCE = 0.5
local DEFAULT_TUNNEL_FREQUENCY = 0.047
local DEFAULT_POCKET_FREQUENCY = 0.016
local DEFAULT_CRACK_FREQUENCY = 0.085
local DEFAULT_SNOW_UNDERGROUND_THRESHOLD_DELTA = -0.025
local DEFAULT_SNOW_CAVERN_THRESHOLD_DELTA = -0.045
local DEFAULT_SNOW_POCKET_THRESHOLD_DELTA = -0.06

local SEED_X_MULTIPLIER = 0.000187
local SEED_Y_MULTIPLIER = 0.000413
local CAVE_OFFSET_X = 517.71
local CAVE_OFFSET_Y = 127.43
local TUNNEL_OFFSET_X = 613.09
local TUNNEL_OFFSET_Y = 233.84
local POCKET_OFFSET_X = 733.45
local POCKET_OFFSET_Y = 311.52
local CRACK_OFFSET_X = 877.02
local CRACK_OFFSET_Y = 421.77

local function isFiniteNumber(value: any): boolean
	return typeof(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

local function clampNumber(valueRaw: any, minimum: number, maximum: number, fallback: number): number
	if not isFiniteNumber(valueRaw) then
		return fallback
	end
	return math.clamp(valueRaw :: number, minimum, maximum)
end

local function sanitizeOctaveCount(valueRaw: any, fallback: number): number
	if not isFiniteNumber(valueRaw) then
		return fallback
	end
	return math.clamp(math.floor(valueRaw :: number), 1, 8)
end

local function sampleOctaveNoise(
	seed: number,
	x: number,
	y: number,
	baseFrequency: number,
	octaves: number,
	lacunarity: number,
	persistence: number,
	offsetX: number,
	offsetY: number
): number
	return Noise.fbmOctaves(octaves, persistence, lacunarity, function(octave, frequency)
		local sampleFrequency = baseFrequency * frequency
		return math.noise(
			(x + offsetX + octave * 1.13) * sampleFrequency,
			(y + offsetY + octave * 0.87) * sampleFrequency,
			seed * SEED_X_MULTIPLIER + octave * SEED_Y_MULTIPLIER
		)
	end)
end

local function resolveWallByBiome(self, biomeId: number, layer: DepthLayer): number
	if biomeId == self.biomeId.DESERT then
		return self.wallId.SANDSTONE
	end

	if biomeId == self.biomeId.SNOW then
		return self.wallId.SNOW
	end

	if biomeId == self.biomeId.JUNGLE then
		return self.wallId.MUD
	end

	if layer == "Cavern" or layer == "Deep" then
		return self.wallId.STONE
	end

	return self.wallId.DIRT
end

function Cave.New(configRaw: any)
	local config = if typeof(configRaw) == "table" then configRaw else {}
	local tileId = (config :: any).tileId :: TileIdMap
	local wallId = (config :: any).wallId :: WallIdMap
	local biomeId = (config :: any).biomeId :: BiomeIdMap

	local self = setmetatable({
		seed = clampNumber((config :: any).seed, -2147483648, 2147483647, 13371337),
		tileId = tileId,
		wallId = wallId,
		biomeId = biomeId,
		surfaceDepth = math.floor(clampNumber((config :: any).surfaceDepth, 1, 64, DEFAULT_SURFACE_DEPTH)),
		undergroundDepth = math.floor(
			clampNumber((config :: any).undergroundDepth, 16, 256, DEFAULT_UNDERGROUND_DEPTH)
		),
		cavernDepth = math.floor(clampNumber((config :: any).cavernDepth, 64, 512, DEFAULT_CAVERN_DEPTH)),
		caveFrequency = clampNumber((config :: any).caveFrequency, 0.0001, 1, DEFAULT_CAVE_FREQUENCY),
		caveOctaves = sanitizeOctaveCount((config :: any).caveOctaves, DEFAULT_CAVE_OCTAVES),
		caveLacunarity = clampNumber((config :: any).caveLacunarity, 1, 4, DEFAULT_CAVE_LACUNARITY),
		cavePersistence = clampNumber((config :: any).cavePersistence, 0.1, 0.95, DEFAULT_CAVE_PERSISTENCE),
		tunnelFrequency = clampNumber((config :: any).tunnelFrequency, 0.0001, 1, DEFAULT_TUNNEL_FREQUENCY),
		pocketFrequency = clampNumber((config :: any).pocketFrequency, 0.0001, 1, DEFAULT_POCKET_FREQUENCY),
		crackFrequency = clampNumber((config :: any).crackFrequency, 0.0001, 1, DEFAULT_CRACK_FREQUENCY),
		snowUndergroundThresholdDelta = DEFAULT_SNOW_UNDERGROUND_THRESHOLD_DELTA,
		snowCavernThresholdDelta = DEFAULT_SNOW_CAVERN_THRESHOLD_DELTA,
		snowPocketThresholdDelta = DEFAULT_SNOW_POCKET_THRESHOLD_DELTA,
	}, Cave)

	local snowConfig = if typeof((config :: any).snowConfig) == "table" then (config :: any).snowConfig else {}
	local snowCavesConfig = if typeof((snowConfig :: any).Caves) == "table" then (snowConfig :: any).Caves else {}
	self.snowUndergroundThresholdDelta =
		clampNumber(snowCavesConfig.UndergroundThresholdDelta, -0.25, 0.25, DEFAULT_SNOW_UNDERGROUND_THRESHOLD_DELTA)
	self.snowCavernThresholdDelta =
		clampNumber(snowCavesConfig.CavernThresholdDelta, -0.25, 0.25, DEFAULT_SNOW_CAVERN_THRESHOLD_DELTA)
	self.snowPocketThresholdDelta =
		clampNumber(snowCavesConfig.PocketThresholdDelta, -0.25, 0.25, DEFAULT_SNOW_POCKET_THRESHOLD_DELTA)

	self.undergroundDepth = math.max(self.undergroundDepth, self.surfaceDepth + 8)
	self.cavernDepth = math.max(self.cavernDepth, self.undergroundDepth + 24)

	return self
end

function Cave.ResolveDepthLayer(self, surfaceY: number, tileY: number): (DepthLayer, number)
	local depth = surfaceY - tileY
	if depth < 0 then
		return "Sky", depth
	end

	if depth <= self.surfaceDepth then
		return "Surface", depth
	end

	if depth <= self.undergroundDepth then
		return "Underground", depth
	end

	if depth <= self.cavernDepth then
		return "Cavern", depth
	end

	return "Deep", depth
end

function Cave.SampleDensity(self, tileX: number, tileY: number): number
	return sampleOctaveNoise(
		self.seed,
		tileX,
		tileY,
		self.caveFrequency,
		self.caveOctaves,
		self.caveLacunarity,
		self.cavePersistence,
		CAVE_OFFSET_X,
		CAVE_OFFSET_Y
	)
end

function Cave.ShouldCarve(
	self,
	tileX: number,
	tileY: number,
	biomeId: number,
	depthLayer: DepthLayer,
	depthBelowSurface: number
): boolean
	if depthLayer == "Sky" then
		return false
	end

	if depthBelowSurface < math.max(3, self.surfaceDepth + 2) then
		return false
	end
	if depthLayer == "Surface" then
		return false
	end

	local density = self:sampleDensity(tileX, tileY)
	local tunnel = math.abs(
		math.noise(
			(tileX + TUNNEL_OFFSET_X) * self.tunnelFrequency,
			(tileY + TUNNEL_OFFSET_Y) * self.tunnelFrequency,
			self.seed * SEED_X_MULTIPLIER
		)
	)
	local pocket =
		sampleOctaveNoise(self.seed, tileX, tileY, self.pocketFrequency, 2, 2, 0.55, POCKET_OFFSET_X, POCKET_OFFSET_Y)
	local crack = math.abs(
		math.noise(
			(tileX + CRACK_OFFSET_X) * self.crackFrequency,
			(tileY + CRACK_OFFSET_Y) * self.crackFrequency,
			self.seed * SEED_Y_MULTIPLIER
		)
	)

	local threshold = 0.72
	local tunnelThreshold = 0.055
	local pocketThreshold = 0.88
	local crackThreshold = 0.05

	if depthLayer == "Cavern" then
		threshold = 0.5
		tunnelThreshold = 0.1
		pocketThreshold = 0.76
		crackThreshold = 0.056
	elseif depthLayer == "Deep" then
		threshold = 0.42
		tunnelThreshold = 0.09
		pocketThreshold = 0.74
		crackThreshold = 0.045
	else
		local undergroundSpan = math.max(1, self.undergroundDepth - self.surfaceDepth)
		local undergroundDepthAlpha = math.clamp((depthBelowSurface - self.surfaceDepth) / undergroundSpan, 0, 1)
		threshold -= undergroundDepthAlpha * 0.08
		tunnelThreshold -= (1 - undergroundDepthAlpha) * 0.02
		pocketThreshold += (1 - undergroundDepthAlpha) * 0.04
	end

	if biomeId == self.biomeId.DESERT and depthLayer == "Underground" then
		threshold += 0.04
		tunnelThreshold -= 0.01
	elseif biomeId == self.biomeId.SNOW then
		if depthLayer == "Underground" then
			threshold += self.snowUndergroundThresholdDelta
			pocketThreshold += self.snowPocketThresholdDelta * 0.66
		elseif depthLayer == "Cavern" or depthLayer == "Deep" then
			threshold += self.snowCavernThresholdDelta
			pocketThreshold += self.snowPocketThresholdDelta
			tunnelThreshold += 0.01
		end
	elseif biomeId == self.biomeId.JUNGLE and depthLayer ~= "Surface" then
		threshold -= 0.04
	end

	local carveByDensity = density > threshold
	local carveByTunnel = tunnel < tunnelThreshold
	local carveByPocket = pocket > pocketThreshold
	local carveByCrack = depthLayer == "Deep" and crack < crackThreshold

	if carveByDensity then
		return true
	end

	if carveByTunnel then
		return true
	end

	if carveByPocket then
		return true
	end

	if carveByCrack then
		return true
	end

	return false
end

function Cave.ResolveWall(
	self,
	tileId: number,
	biomeId: number,
	depthLayer: DepthLayer,
	depthBelowSurface: number
): number
	if depthLayer == "Sky" then
		return self.wallId.NONE
	end

	if depthLayer == "Surface" and depthBelowSurface <= 1 then
		return self.wallId.NONE
	end

	if tileId ~= self.tileId.AIR then
		if depthLayer == "Surface" and depthBelowSurface <= 3 then
			return self.wallId.NONE
		end
		return resolveWallByBiome(self, biomeId, depthLayer)
	end

	if depthLayer == "Surface" then
		return self.wallId.NONE
	end

	return resolveWallByBiome(self, biomeId, depthLayer)
end

export type Cave = typeof(setmetatable(
	{} :: {
		seed: number,
		tileId: TileIdMap,
		wallId: WallIdMap,
		biomeId: BiomeIdMap,
		surfaceDepth: number,
		undergroundDepth: number,
		cavernDepth: number,
		caveFrequency: number,
		caveOctaves: number,
		caveLacunarity: number,
		cavePersistence: number,
		tunnelFrequency: number,
		pocketFrequency: number,
		crackFrequency: number,
	},
	Cave
))

Cave.new = Cave.New
Cave.resolveDepthLayer = Cave.ResolveDepthLayer
Cave.sampleDensity = Cave.SampleDensity
Cave.shouldCarve = Cave.ShouldCarve
Cave.resolveWall = Cave.ResolveWall

return Cave
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="1145">
                <Properties>
                  <string name="Name">Height</string>
                  <string name="Source"><![CDATA[--!strict

local DeterministicRNG = require(script:FindFirstAncestor("game").Shared.Modules.Core.DeterministicRNG)

local TreeHeightVariation = {}

local HEIGHT_SCALE_MIN = 0.84
local HEIGHT_SCALE_MAX = 1.22
local HEIGHT_SCALE_SALT_X = 8231
local HEIGHT_SCALE_SALT_Y = 46027
local HEIGHT_SCALE_SEED_SALT = "ProceduralTreeHeight"

local function isFiniteNumber(value: any): boolean
	return typeof(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

local function normalizeAlpha(scale: number): number
	return math.clamp((scale - HEIGHT_SCALE_MIN) / (HEIGHT_SCALE_MAX - HEIGHT_SCALE_MIN), 0, 1)
end

function TreeHeightVariation.ResolveHeightScale(seedRaw: any): number
	local seed = DeterministicRNG.SeedFrom(seedRaw)
	local rngSeed =
		DeterministicRNG.HashCoordinates(seed, HEIGHT_SCALE_SALT_X, HEIGHT_SCALE_SALT_Y, HEIGHT_SCALE_SEED_SALT)
	local rng = DeterministicRNG.New(rngSeed)
	return rng:nextRange(HEIGHT_SCALE_MIN, HEIGHT_SCALE_MAX)
end

function TreeHeightVariation.ResolveHeightTiles(seedRaw: any, minimumRaw: any, maximumRaw: any): number
	local minimum = if isFiniteNumber(minimumRaw) then math.floor(minimumRaw :: number) else 1
	local maximum = if isFiniteNumber(maximumRaw) then math.floor(maximumRaw :: number) else minimum
	if maximum < minimum then
		local temporary = maximum
		maximum = minimum
		minimum = temporary
	end

	local alpha = normalizeAlpha(TreeHeightVariation.ResolveHeightScale(seedRaw))
	return math.clamp(minimum + math.floor(alpha * (maximum - minimum) + 0.5), minimum, maximum)
end

TreeHeightVariation.resolveHeightScale = TreeHeightVariation.ResolveHeightScale
TreeHeightVariation.resolveHeightTiles = TreeHeightVariation.ResolveHeightTiles

return TreeHeightVariation
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="1146">
                <Properties>
                  <string name="Name">Liquid</string>
                  <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Sift = require(ReplicatedStorage.Packages.Sift)

local LiquidServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.LiquidServiceUtils)

type LiquidServiceConfig = LiquidServiceUtils.LiquidServiceConfig

export type ColumnProfile = {
	surfaceY: number,
	biomeId: number,
	biomeType: number,
}

export type ChunkLiquidGenerationContext = {
	seed: number,
	chunkX: number,
	chunkY: number,
	tileMinX: number,
	tileMinY: number,
	width: number,
	height: number,
	tiles: { number },
	depthBelowSurface: { number },
	biomeIds: { number },
	biomeTypes: { number },
	dominantBiomeId: number,
	dominantBiomeType: number,
	columnProfiles: { ColumnProfile },
	scanColumnProfiles: { ColumnProfile },
	scanColumnMinX: number,
}

local LiquidGeneration = {}
LiquidGeneration.__index = LiquidGeneration

export type LiquidGeneration = typeof(setmetatable({} :: any, LiquidGeneration))

local LIQUID_TYPE = LiquidServiceUtils.LIQUID_TYPE
local LiquidCell = LiquidServiceUtils.LiquidCell
local LiquidSolver = LiquidServiceUtils.LiquidSolver

local SURFACE_POOL_SALT = 173
local CAVE_POCKET_SALT = 317
local RESERVOIR_SALT = 419
local LAVA_POCKET_SALT = 563
local LAVA_RESERVOIR_SALT = 719

local function sampleUnit(seed: number, x: number, y: number, salt: number): number
	local noise = math.noise(
		(seed + salt * 1.17) * 0.017 + x * 0.157,
		(seed - salt * 0.73) * 0.013 + y * 0.131,
		(seed + salt * 2.03) * 0.009
	)
	return math.clamp((noise + 1) * 0.5, 0, 1)
end

local function computeTileIndex(localX: number, localY: number, width: number): number
	return localY * width + localX + 1
end

local function getBiomePoolChanceMultiplier(biomeId: number, biomeType: number): number
	if biomeType == 2 then
		return 0.82
	end
	if biomeId == 2 then
		return 0.5
	end
	if biomeId == 3 then
		return 0.74
	end
	if biomeId == 4 then
		return 1.12
	end
	return 1
end

function LiquidGeneration.New(configRaw: any?): LiquidGeneration
	local self = setmetatable({}, LiquidGeneration)
	self.config = LiquidServiceUtils.sanitizeConfig(configRaw, nil)
	self.maxFill = self.config.maxFill
	return self
end

function LiquidGeneration.IsSolidTile(
	_self: LiquidGeneration,
	context: ChunkLiquidGenerationContext,
	localX: number,
	localY: number
): boolean
	if localX < 0 or localX >= context.width or localY < 0 or localY >= context.height then
		return true
	end
	local tileId = context.tiles[computeTileIndex(localX, localY, context.width)] or 0
	return tileId ~= 0
end

function LiquidGeneration.TrySetCell(
	self: LiquidGeneration,
	context: ChunkLiquidGenerationContext,
	cells: { number },
	localX: number,
	localY: number,
	liquidType: number,
	fill: number
): boolean
	if localX < 0 or localX >= context.width or localY < 0 or localY >= context.height then
		return false
	end
	if self:isSolidTile(context, localX, localY) then
		return false
	end
	local index = computeTileIndex(localX, localY, context.width)
	local existingType, existingFill = LiquidCell.unpack(cells[index] or 0)
	if existingType ~= LIQUID_TYPE.NONE and existingType ~= liquidType then
		return false
	end
	local nextFill = math.clamp(math.max(existingFill, fill), 0, self.maxFill)
	if nextFill <= 0 then
		return false
	end
	if existingType == liquidType and existingFill == nextFill then
		return false
	end
	cells[index] = LiquidCell.make(liquidType, nextFill, LiquidServiceUtils.FLOW_STATE.SETTLING)
	return true
end

function LiquidGeneration.GetSurfaceColumn(
	_self: LiquidGeneration,
	context: ChunkLiquidGenerationContext,
	worldTileX: number
): ColumnProfile?
	local index = worldTileX - context.scanColumnMinX + 1
	local column = context.scanColumnProfiles[index]
	if column == nil then
		return nil
	end
	return column
end

function LiquidGeneration.SeedSurfacePoolSpan(
	self: LiquidGeneration,
	context: ChunkLiquidGenerationContext,
	cells: { number },
	centerLocalX: number,
	waterLine: number,
	radius: number
): boolean
	local didSeed = false
	local config = self.config.generation

	for offsetX = -radius, radius do
		local localX = centerLocalX + offsetX
		if localX < 0 or localX >= context.width then
			continue
		end

		local column = context.columnProfiles[localX + 1]
		if column == nil then
			continue
		end

		local columnWaterLine = math.min(waterLine, column.surfaceY + config.surfacePoolMaxDepth)
		local basinDepth = columnWaterLine - column.surfaceY
		if basinDepth < config.surfacePoolMinDepth then
			continue
		end

		for fillTileY = column.surfaceY + 1, columnWaterLine do
			local localY = fillTileY - context.tileMinY
			if localY < 0 or localY >= context.height then
				continue
			end
			local fillAlpha = if fillTileY >= columnWaterLine then config.surfacePoolFillChance else 1
			local fillAmount = math.max(1, math.floor(self.maxFill * fillAlpha))
			if self:trySetCell(context, cells, localX, localY, LIQUID_TYPE.WATER, fillAmount) then
				didSeed = true
			end
		end
	end

	return didSeed
end

function LiquidGeneration.SeedSurfacePools(
	self: LiquidGeneration,
	context: ChunkLiquidGenerationContext,
	cells: { number }
): boolean
	local config = self.config.generation
	local radius = math.max(2, config.depressionScanRadius)
	local didSeed = false
	local bestCandidate = nil :: { localX: number, waterLine: number, score: number }?

	for localX = 0, context.width - 1 do
		local column = context.columnProfiles[localX + 1]
		if column == nil then
			continue
		end

		local worldTileX = context.tileMinX + localX
		local surfaceY = column.surfaceY
		local leftRim = -math.huge
		local rightRim = -math.huge

		for scanOffset = 1, radius do
			local leftColumn = self:getSurfaceColumn(context, worldTileX - scanOffset)
			if leftColumn ~= nil then
				leftRim = math.max(leftRim, leftColumn.surfaceY)
			end
			local rightColumn = self:getSurfaceColumn(context, worldTileX + scanOffset)
			if rightColumn ~= nil then
				rightRim = math.max(rightRim, rightColumn.surfaceY)
			end
		end

		if leftRim == -math.huge or rightRim == -math.huge then
			continue
		end
		local waterLine = math.min(leftRim, rightRim)
		local basinDepth = waterLine - surfaceY
		if basinDepth < config.surfacePoolMinDepth then
			continue
		end
		if basinDepth > config.surfacePoolMaxDepth then
			waterLine = surfaceY + config.surfacePoolMaxDepth
			basinDepth = waterLine - surfaceY
		end
		if basinDepth < config.surfacePoolMinDepth then
			continue
		end

		local chanceMultiplier = getBiomePoolChanceMultiplier(column.biomeId, column.biomeType)
		local score = basinDepth * chanceMultiplier
		if bestCandidate == nil or score > bestCandidate.score then
			bestCandidate = {
				localX = localX,
				waterLine = waterLine,
				score = score,
			}
		end

		local roll = sampleUnit(context.seed, worldTileX, surfaceY, SURFACE_POOL_SALT)
		if roll > config.surfacePoolChance * chanceMultiplier then
			continue
		end

		if self:seedSurfacePoolSpan(context, cells, localX, waterLine, radius) then
			didSeed = true
		end
	end

	if not didSeed and bestCandidate ~= nil then
		local fallbackRoll = sampleUnit(context.seed, context.chunkX, context.chunkY, SURFACE_POOL_SALT + 977)
		if fallbackRoll < 0.6 then
			didSeed = self:seedSurfacePoolSpan(context, cells, bestCandidate.localX, bestCandidate.waterLine, radius)
				or didSeed
		end
	end

	return didSeed
end

function LiquidGeneration.FillFloodPocket(
	self: LiquidGeneration,
	context: ChunkLiquidGenerationContext,
	cells: { number },
	centerX: number,
	centerY: number,
	liquidType: number,
	radius: number,
	waterLevelY: number
): boolean
	local queue = {
		{ x = centerX, y = centerY },
	}
	local queueHead = 1
	local visited: { [string]: boolean } = {}
	local radiusSquared = math.max(1, radius * radius)
	local didSeed = false

	while queueHead <= #queue do
		local current = queue[queueHead]
		queueHead += 1

		local x = current.x
		local y = current.y
		local key = `{x}:{y}`
		if visited[key] then
			continue
		end
		visited[key] = true

		if x < 0 or x >= context.width or y < 0 or y >= context.height then
			continue
		end
		if y > waterLevelY then
			continue
		end
		if self:isSolidTile(context, x, y) then
			continue
		end

		local dx = x - centerX
		local dy = y - centerY
		if dx * dx + (dy * dy) * 0.45 > radiusSquared * 1.2 then
			continue
		end

		local fillAmount = if y >= waterLevelY then math.floor(self.maxFill * 0.78) else self.maxFill
		if self:trySetCell(context, cells, x, y, liquidType, fillAmount) then
			didSeed = true
		end

		for _, offset in
			{
				{ 1, 0 },
				{ -1, 0 },
				{ 0, 1 },
				{ 0, -1 },
			}
		do
			local nextX = x + offset[1]
			local nextY = y + offset[2]
			if
				nextX >= centerX - radius - 1
				and nextX <= centerX + radius + 1
				and nextY >= centerY - 1
				and nextY <= waterLevelY + 1
			then
				queue[#queue + 1] = {
					x = nextX,
					y = nextY,
				}
			end
		end
	end

	return didSeed
end

function LiquidGeneration.SeedUndergroundPockets(
	self: LiquidGeneration,
	context: ChunkLiquidGenerationContext,
	cells: { number }
): boolean
	local config = self.config.generation
	local didSeed = false
	local bestCandidate = nil :: { localX: number, localY: number, radius: number, waterLevelY: number, score: number }?

	for localY = 0, context.height - 1 do
		for localX = 0, context.width - 1 do
			if self:isSolidTile(context, localX, localY) then
				continue
			end

			local index = computeTileIndex(localX, localY, context.width)
			local depth = context.depthBelowSurface[index] or -1
			if depth < 0 then
				continue
			end

			local hasSolidFloor = self:isSolidTile(context, localX, localY - 1)
			local sideWalls = 0
			if self:isSolidTile(context, localX - 1, localY) then
				sideWalls += 1
			end
			if self:isSolidTile(context, localX + 1, localY) then
				sideWalls += 1
			end
			if not hasSolidFloor or sideWalls <= 0 then
				continue
			end

			local worldTileX = context.tileMinX + localX
			local worldTileY = context.tileMinY + localY
			local biomeId = context.biomeIds[index] or context.dominantBiomeId
			local biomeType = context.biomeTypes[index] or context.dominantBiomeType

			if depth >= config.cavePocketMinDepth and depth <= config.cavePocketMaxDepth then
				local radiusAlpha = sampleUnit(context.seed, worldTileX, worldTileY, RESERVOIR_SALT)
				local radius = math.max(
					config.cavePocketMinRadius,
					math.floor(
						config.cavePocketMinRadius
							+ (config.cavePocketMaxRadius - config.cavePocketMinRadius) * radiusAlpha
					)
				)
				local waterLevelY = localY + math.max(1, math.floor(radius * 0.55))
				local score = depth + sideWalls * 8 + radius * 6
				if bestCandidate == nil or score > bestCandidate.score then
					bestCandidate = {
						localX = localX,
						localY = localY,
						radius = radius,
						waterLevelY = waterLevelY,
						score = score,
					}
				end

				local caveChance = config.cavePocketChance * getBiomePoolChanceMultiplier(biomeId, biomeType)
				local caveRoll = sampleUnit(context.seed, worldTileX, worldTileY, CAVE_POCKET_SALT)
				if caveRoll < caveChance then
					if self:fillFloodPocket(context, cells, localX, localY, LIQUID_TYPE.WATER, radius, waterLevelY) then
						didSeed = true
					end
				end
			end

			if depth >= config.reservoirMinDepth and depth <= config.reservoirMaxDepth and sideWalls >= 2 then
				local radiusAlpha = sampleUnit(context.seed, worldTileX, worldTileY, SURFACE_POOL_SALT)
				local radius = math.max(
					config.reservoirMinRadius,
					math.floor(
						config.reservoirMinRadius
							+ (config.reservoirMaxRadius - config.reservoirMinRadius) * radiusAlpha
					)
				)
				local waterLevelY = localY + math.max(2, math.floor(radius * 0.7))
				local score = depth + sideWalls * 14 + radius * 10
				if bestCandidate == nil or score > bestCandidate.score then
					bestCandidate = {
						localX = localX,
						localY = localY,
						radius = radius,
						waterLevelY = waterLevelY,
						score = score,
					}
				end

				local reservoirRoll = sampleUnit(context.seed, worldTileX, worldTileY, RESERVOIR_SALT)
				if reservoirRoll < config.reservoirChance then
					if self:fillFloodPocket(context, cells, localX, localY, LIQUID_TYPE.WATER, radius, waterLevelY) then
						didSeed = true
					end
				end
			end
		end
	end

	if not didSeed and bestCandidate ~= nil then
		local fallbackRoll = sampleUnit(context.seed, context.chunkX, context.chunkY, RESERVOIR_SALT + 991)
		if fallbackRoll < 0.7 then
			didSeed = self:fillFloodPocket(
				context,
				cells,
				bestCandidate.localX,
				bestCandidate.localY,
				LIQUID_TYPE.WATER,
				bestCandidate.radius,
				bestCandidate.waterLevelY
			) or didSeed
		end
	end

	return didSeed
end

function LiquidGeneration.SeedLavaPockets(
	self: LiquidGeneration,
	context: ChunkLiquidGenerationContext,
	cells: { number }
)
	local config = self.config.generation

	for localY = 0, context.height - 1 do
		for localX = 0, context.width - 1 do
			if self:isSolidTile(context, localX, localY) then
				continue
			end

			local index = computeTileIndex(localX, localY, context.width)
			local depth = context.depthBelowSurface[index] or -1
			if depth < config.lavaStartDepth then
				continue
			end

			local hasSolidFloor = self:isSolidTile(context, localX, localY - 1)
			local sideWalls = 0
			if self:isSolidTile(context, localX - 1, localY) then
				sideWalls += 1
			end
			if self:isSolidTile(context, localX + 1, localY) then
				sideWalls += 1
			end
			if not hasSolidFloor or sideWalls <= 0 then
				continue
			end

			local worldTileX = context.tileMinX + localX
			local worldTileY = context.tileMinY + localY
			local depthAlpha = math.clamp(
				(depth - config.lavaStartDepth) / math.max(1, config.lavaCommonDepth - config.lavaStartDepth),
				0,
				1
			)
			local pocketChance = config.lavaPocketChance * (0.45 + depthAlpha * 1.35)
			local reservoirChance = config.lavaReservoirChance * (0.35 + depthAlpha * 1.5)

			local pocketRoll = sampleUnit(context.seed, worldTileX, worldTileY, LAVA_POCKET_SALT)
			if pocketRoll < pocketChance then
				local radiusAlpha = sampleUnit(context.seed, worldTileX, worldTileY, LAVA_RESERVOIR_SALT)
				local radius = math.max(
					config.lavaPocketMinRadius,
					math.floor(
						config.lavaPocketMinRadius
							+ (config.lavaPocketMaxRadius - config.lavaPocketMinRadius) * radiusAlpha
					)
				)
				self:fillFloodPocket(
					context,
					cells,
					localX,
					localY,
					LIQUID_TYPE.LAVA,
					radius,
					localY + math.max(1, math.floor(radius * 0.5))
				)
				continue
			end

			if sideWalls >= 2 then
				local reservoirRoll = sampleUnit(context.seed, worldTileX, worldTileY, LAVA_RESERVOIR_SALT)
				if reservoirRoll < reservoirChance then
					local radiusAlpha = sampleUnit(context.seed, worldTileX, worldTileY, CAVE_POCKET_SALT)
					local radius = math.max(
						config.lavaPocketMinRadius + 1,
						math.floor(
							config.lavaPocketMinRadius
								+ 1
								+ (config.lavaPocketMaxRadius - config.lavaPocketMinRadius) * radiusAlpha
						)
					)
					self:fillFloodPocket(
						context,
						cells,
						localX,
						localY,
						LIQUID_TYPE.LAVA,
						radius,
						localY + math.max(2, math.floor(radius * 0.65))
					)
				end
			end
		end
	end
end

function LiquidGeneration.GenerateChunkLiquids(
	self: LiquidGeneration,
	contextRaw: ChunkLiquidGenerationContext
): { number }
	local context = contextRaw
	local cells = Sift.Array.create(context.width * context.height, 0)

	self:seedSurfacePools(context, cells)
	self:seedUndergroundPockets(context, cells)
	self:seedLavaPockets(context, cells)

	local settled = LiquidSolver.settleGrid(
		self.config,
		cells,
		context.width,
		context.height,
		function(localX: number, localY: number): boolean
			return self:isSolidTile(context, localX, localY)
		end,
		self.config.simulation.generationSettlePasses
	)

	return settled
end

LiquidGeneration.new = LiquidGeneration.New
LiquidGeneration.isSolidTile = LiquidGeneration.IsSolidTile
LiquidGeneration.trySetCell = LiquidGeneration.TrySetCell
LiquidGeneration.getSurfaceColumn = LiquidGeneration.GetSurfaceColumn
LiquidGeneration.seedSurfacePoolSpan = LiquidGeneration.SeedSurfacePoolSpan
LiquidGeneration.seedSurfacePools = LiquidGeneration.SeedSurfacePools
LiquidGeneration.fillFloodPocket = LiquidGeneration.FillFloodPocket
LiquidGeneration.seedUndergroundPockets = LiquidGeneration.SeedUndergroundPockets
LiquidGeneration.seedLavaPockets = LiquidGeneration.SeedLavaPockets
LiquidGeneration.generateChunkLiquids = LiquidGeneration.GenerateChunkLiquids

return LiquidGeneration
]]></string>
                </Properties>
