            <Item class="ModuleScript" referent="1293">
              <Properties>
                <string name="Name">BreathServiceUtils</string>
                <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Sift = require(ReplicatedStorage.Packages.Sift)

local BreathServiceUtils = {}

BreathServiceUtils.NETWORK_METHOD_REQUEST_SYNC = "requestSync"

BreathServiceUtils.CLIENT_METHOD_APPLY_STATE = "applyState"
BreathServiceUtils.CLIENT_METHOD_ON_EVENT = "onEvent"

BreathServiceUtils.EVENT_BREATH_DEPLETED = "breathDepleted"

export type BreathServiceConfig = {
	maxBreathSeconds: number,
	graceDuration: number,
	recoveryDelay: number,
	recoveryDuration: number,
	drowningTickRate: number,
	drowningDamage: number,
	updateRate: number,
	statePushInterval: number,
}

export type BreathServiceState = {
	ready: boolean,
	maxBreath: number,
	breath: number,
	graceRemaining: number,
	isUnderwater: boolean,
	isBreathingBlocked: boolean,
	isDrowning: boolean,
	submersionRatio: number,
	breathingLiquidType: number,
	updatedAt: number,
}

local function isFiniteNumber(value: any): boolean
	return typeof(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

local function sanitizeNumber(valueRaw: any, minimum: number, maximum: number, fallback: number): number
	if not isFiniteNumber(valueRaw) then
		return fallback
	end
	return math.clamp(valueRaw, minimum, maximum)
end

local function sanitizeBoolean(valueRaw: any, fallback: boolean): boolean
	if typeof(valueRaw) == "boolean" then
		return valueRaw
	end
	return fallback
end

function BreathServiceUtils.CreateDefaultConfig(): BreathServiceConfig
	return {
		maxBreathSeconds = 8,
		graceDuration = 0.8,
		recoveryDelay = 0.45,
		recoveryDuration = 1.8,
		drowningTickRate = 0.2,
		drowningDamage = 2,
		updateRate = 8,
		statePushInterval = 0.12,
	}
end

function BreathServiceUtils.SanitizeConfig(configRaw: any, fallbackRaw: BreathServiceConfig?): BreathServiceConfig
	local fallback = if fallbackRaw ~= nil then fallbackRaw else BreathServiceUtils.CreateDefaultConfig()
	local source = if typeof(configRaw) == "table" then configRaw else {}
	return {
		maxBreathSeconds = sanitizeNumber(source.maxBreathSeconds, 1, 120, fallback.maxBreathSeconds),
		graceDuration = sanitizeNumber(source.graceDuration, 0, 10, fallback.graceDuration),
		recoveryDelay = sanitizeNumber(source.recoveryDelay, 0, 10, fallback.recoveryDelay),
		recoveryDuration = sanitizeNumber(source.recoveryDuration, 0.1, 30, fallback.recoveryDuration),
		drowningTickRate = sanitizeNumber(source.drowningTickRate, 0.05, 5, fallback.drowningTickRate),
		drowningDamage = sanitizeNumber(source.drowningDamage, 0, 100, fallback.drowningDamage),
		updateRate = sanitizeNumber(source.updateRate, 1, 60, fallback.updateRate),
		statePushInterval = sanitizeNumber(source.statePushInterval, 0.03, 2, fallback.statePushInterval),
	}
end

function BreathServiceUtils.CreateDefaultState(): BreathServiceState
	return {
		ready = false,
		maxBreath = 8,
		breath = 8,
		graceRemaining = 0,
		isUnderwater = false,
		isBreathingBlocked = false,
		isDrowning = false,
		submersionRatio = 0,
		breathingLiquidType = 0,
		updatedAt = os.clock(),
	}
end

function BreathServiceUtils.CreateState(stateRaw: any, fallbackRaw: BreathServiceState?): BreathServiceState
	local fallback = if fallbackRaw ~= nil then fallbackRaw else BreathServiceUtils.CreateDefaultState()
	local source = if typeof(stateRaw) == "table" then stateRaw else {}
	local maxBreath = sanitizeNumber(source.maxBreath, 1, 120, fallback.maxBreath)
	return {
		ready = sanitizeBoolean(source.ready, fallback.ready),
		maxBreath = maxBreath,
		breath = sanitizeNumber(source.breath, 0, maxBreath, fallback.breath),
		graceRemaining = sanitizeNumber(source.graceRemaining, 0, 30, fallback.graceRemaining),
		isUnderwater = sanitizeBoolean(source.isUnderwater, fallback.isUnderwater),
		isBreathingBlocked = sanitizeBoolean(source.isBreathingBlocked, fallback.isBreathingBlocked),
		isDrowning = sanitizeBoolean(source.isDrowning, fallback.isDrowning),
		submersionRatio = sanitizeNumber(source.submersionRatio, 0, 1, fallback.submersionRatio),
		breathingLiquidType = if isFiniteNumber(source.breathingLiquidType)
			then math.max(0, math.floor(source.breathingLiquidType))
			else fallback.breathingLiquidType,
		updatedAt = os.clock(),
	}
end

function BreathServiceUtils.CloneState(state: BreathServiceState): BreathServiceState
	return Sift.Dictionary.copy(state) :: BreathServiceState
end

BreathServiceUtils.createDefaultConfig = BreathServiceUtils.CreateDefaultConfig
BreathServiceUtils.sanitizeConfig = BreathServiceUtils.SanitizeConfig
BreathServiceUtils.createDefaultState = BreathServiceUtils.CreateDefaultState
BreathServiceUtils.createState = BreathServiceUtils.CreateState
BreathServiceUtils.cloneState = BreathServiceUtils.CloneState

return BreathServiceUtils
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="1294">
              <Properties>
                <string name="Name">BuildServiceUtils</string>
                <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Height = require(script:FindFirstAncestor("game").Shared.Classes.WorldGeneration.Height)
local ItemRegistry = require(script:FindFirstAncestor("game").Shared.Modules.Items.Registry)
local MiningPower = require(script:FindFirstAncestor("game").Shared.Modules.Math.MiningPower)
local Noise = require(script:FindFirstAncestor("game").Shared.Modules.Math.Noise)
local Plane = require(script:FindFirstAncestor("game").Shared.Modules.Math.Plane)
local Vec = require(script:FindFirstAncestor("game").Shared.Modules.Math.Vec)

local BuildServiceUtils = {}

BuildServiceUtils.NETWORK_METHOD_REQUEST_SYNC = "requestSync"
BuildServiceUtils.NETWORK_METHOD_REQUEST_PLACE_TILE = "requestPlaceTile"
BuildServiceUtils.NETWORK_METHOD_REQUEST_BREAK_TILE = "requestBreakTile"
BuildServiceUtils.NETWORK_METHOD_GET_TILE_AT = "getTileAt"
BuildServiceUtils.NETWORK_METHOD_CAN_PLACE_AT = "canPlaceAt"

BuildServiceUtils.CLIENT_METHOD_APPLY_STATE = "applyState"
BuildServiceUtils.CLIENT_METHOD_ON_TILE_DELTAS = "onTileDeltas"
BuildServiceUtils.CLIENT_METHOD_ON_ACTION_RESULT = "onActionResult"
BuildServiceUtils.CLIENT_METHOD_ON_BREAK_PROGRESS = "onBreakProgress"
BuildServiceUtils.CLIENT_METHOD_ON_TREE_FELLED = "onTreeFelled"

BuildServiceUtils.ACTION_TYPE_PLACE = "place"
BuildServiceUtils.ACTION_TYPE_BREAK = "break"
BuildServiceUtils.TREE_STATE_ALIVE = "Alive"
BuildServiceUtils.TREE_STATE_FELLED = "Felled"

export type SupportMode = "None" | "Below" | "Cardinal" | "Any"

export type TileRule = {
	id: number,
	name: string,
	assetName: string,
	isSolid: boolean,
	replaceable: boolean,
	requiresSupport: boolean,
	supportMode: SupportMode,
	fallWhenUnsupported: boolean,
	hardness: number,
	breakTime: number,
	requiredToolPower: number,
	unbreakableWithoutTool: boolean,
	multiTileSizeX: number,
	multiTileSizeY: number,
	anchorOffsetX: number,
	anchorOffsetY: number,
}

export type BuildServiceConfig = {
	maxInteractionDistanceTiles: number,
	breakInputTimeout: number,
	breakProgressPushInterval: number,
	breakSupportFloodLimit: number,
	deltaBatchMax: number,
	defaultToolPower: number,
	clientBreakInputRate: number,
	clientPlaceInputRate: number,
	enableDefaultInputBinding: boolean,
}

export type BuildServiceState = {
	ready: boolean,
	tileSize: number,
	chunkSize: number,
	worldOrigin: Vector3,
	basePlaneX: number,
	maxInteractionDistanceTiles: number,
	clientBreakInputRate: number,
	clientPlaceInputRate: number,
	tileRules: { [number]: TileRule },
	updatedAt: number,
}

export type TileCoordinate = {
	tileX: number,
	tileY: number,
}

export type TileDelta = {
	tileX: number,
	tileY: number,
	tileId: number,
	reason: string?,
}

export type TilePlacementResult = {
	canPlace: boolean,
	reason: string,
	footprint: { TileCoordinate },
}

export type PlaceableItemConfig = {
	itemId: string,
	tileId: number,
	consumesOnPlace: boolean,
	animationProfile: string?,
}

export type TreeTileType = "trunk" | "leaf"
export type TreeState = "Alive" | "Felled"

export type TreeSnapshot = {
	treeId: string,
	chunkX: number,
	chunkY: number,
	chunkKey: string,
	rootTileX: number,
	rootTileY: number,
	variantIndex: number,
	seed: number,
	biomeType: number?,
	biomeId: number?,
	state: TreeState,
}

export type TreeFootprint = {
	rootTileX: number,
	rootTileY: number,
	heightTiles: number,
	trunkTiles: { TileCoordinate },
	leafTiles: { TileCoordinate },
	allTiles: { TileCoordinate },
	trunkLookup: { [string]: boolean },
	leafLookup: { [string]: boolean },
	maxTileY: number,
}

export type TreeHitResult = {
	tree: TreeSnapshot,
	footprint: TreeFootprint,
	tileType: TreeTileType,
}

export type TreeBreakProfile = {
	maxHealth: number,
	requiredToolType: string,
	requiredToolPower: number,
	breakHits: number,
	breakDuration: number,
	fallDuration: number,
	dropTableId: string,
}

export type TileBreakProfile = {
	requiredToolType: string,
	requiredToolPower: number,
	breakHits: number,
	tileTier: string,
}

export type TreeDropEntry = {
	itemId: string,
	amount: number,
}

export type TreeFelledPayload = {
	treeId: string,
	pivotCFrame: CFrame,
	fallDirection: number,
	height: number,
	seed: number,
	fallDuration: number,
}

