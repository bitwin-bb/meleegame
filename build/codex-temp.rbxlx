                <Item class="ModuleScript" referent="821">
                  <Properties>
                    <string name="Name">TextLabel</string>
                    <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local React = require(ReplicatedStorage.Packages.React)

export type GradientEffect = {
	enabled: boolean?,
	color: ColorSequence?,
	transparency: NumberSequence?,
	rotation: number?,
	offset: Vector2?,
	animated: boolean?,
	scrollSpeed: number?,
	direction: Vector2?,
}

export type RainbowEffect = {
	enabled: boolean?,
	speed: number?,
	saturation: number?,
	value: number?,
	gradient: boolean?,
	spread: number?,
}

export type ShadowEffect = {
	enabled: boolean?,
	color: Color3?,
	transparency: number?,
	offset: Vector2?,
	layers: number?,
}

export type OutlineEffect = {
	enabled: boolean?,
	color: Color3?,
	transparency: number?,
	thickness: number?,
}

export type PulseEffect = {
	enabled: boolean?,
	speed: number?,
	minScale: number?,
	maxScale: number?,
}

export type TextEffects = {
	gradient: GradientEffect?,
	rainbow: RainbowEffect?,
	shadow: ShadowEffect?,
	outline: OutlineEffect?,
	pulse: PulseEffect?,
}

export type TextLabelProps = {
	text: string?,
	size: UDim2?,
	position: UDim2?,
	anchorPoint: Vector2?,
	automaticSize: Enum.AutomaticSize?,
	layoutOrder: number?,
	visible: boolean?,
	zIndex: number?,
	backgroundColor3: Color3?,
	backgroundTransparency: number?,
	borderSizePixel: number?,
	clipsDescendants: boolean?,
	richText: boolean?,
	textScaled: boolean?,
	textWrapped: boolean?,
	textTruncate: Enum.TextTruncate?,
	maxVisibleGraphemes: number?,
	textXAlignment: Enum.TextXAlignment?,
	textYAlignment: Enum.TextYAlignment?,
	font: Enum.Font?,
	textSize: number?,
	lineHeight: number?,
	textColor3: Color3?,
	textTransparency: number?,
	textStrokeColor3: Color3?,
	textStrokeTransparency: number?,
	effects: TextEffects?,
	native: { [string]: any }?,
	children: { React.ReactNode }?,
}

local e: typeof(React.createElement) = React.createElement

local DEFAULT_TEXT_COLOR = Color3.fromRGB(255, 255, 255)
local DEFAULT_TEXT_TRANSPARENCY = 0
local DEFAULT_BACKGROUND_TRANSPARENCY = 1
local DEFAULT_SIZE = UDim2.fromOffset(180, 24)
local DEFAULT_POSITION = UDim2.fromScale(0, 0)
local DEFAULT_ANCHOR_POINT = Vector2.new(0, 0)
local DEFAULT_Z_INDEX = 1
local DEFAULT_SHADOW_COLOR = Color3.fromRGB(0, 0, 0)

local DEFAULT_RAINBOW_SPEED = 0.2
local DEFAULT_RAINBOW_SATURATION = 0.95
local DEFAULT_RAINBOW_VALUE = 1
local DEFAULT_RAINBOW_SPREAD = 0.18

local DEFAULT_GRADIENT_SCROLL_SPEED = 0.4
local DEFAULT_GRADIENT_DIRECTION = Vector2.new(1, 0)
local DEFAULT_GRADIENT_COLOR = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(180, 220, 255)),
})

local DEFAULT_SHADOW_OFFSET = Vector2.new(2, 2)
local DEFAULT_SHADOW_LAYERS = 2
local DEFAULT_SHADOW_TRANSPARENCY = 0.55

local DEFAULT_OUTLINE_COLOR = Color3.fromRGB(0, 0, 0)
local DEFAULT_OUTLINE_TRANSPARENCY = 0.15
local DEFAULT_OUTLINE_THICKNESS = 1

local DEFAULT_PULSE_SPEED = 1.25
local DEFAULT_PULSE_MIN_SCALE = 0.95
local DEFAULT_PULSE_MAX_SCALE = 1.05

local function sanitizeNumber(value: any, fallback: number, minimum: number?, maximum: number?): number
	if typeof(value) ~= "number" or value ~= value then
		return fallback
	end

	local nextValue = value
	if minimum ~= nil and nextValue < minimum then
		nextValue = minimum
	end
	if maximum ~= nil and nextValue > maximum then
		nextValue = maximum
	end
	return nextValue
end

local function sanitizeVector2(value: any, fallback: Vector2): Vector2
	if typeof(value) ~= "Vector2" then
		return fallback
	end
	if value.X ~= value.X or value.Y ~= value.Y then
		return fallback
	end
	return value
end

local function sanitizeColor(value: any, fallback: Color3): Color3
	if typeof(value) ~= "Color3" then
		return fallback
	end
	return value
end

local function normalizeDirection(direction: Vector2): Vector2
	local magnitude = direction.Magnitude
	if magnitude <= 1e-4 then
		return DEFAULT_GRADIENT_DIRECTION
	end
	return direction / magnitude
end

local function buildRainbowSequence(baseHue: number, saturation: number, value: number, spread: number): ColorSequence
	local colorA = Color3.fromHSV(baseHue % 1, saturation, value)
	local colorB = Color3.fromHSV((baseHue + spread) % 1, saturation, value)
	local colorC = Color3.fromHSV((baseHue + spread * 2) % 1, saturation, value)
	local colorD = Color3.fromHSV((baseHue + spread * 3) % 1, saturation, value)

	return ColorSequence.new({
		ColorSequenceKeypoint.new(0, colorA),
		ColorSequenceKeypoint.new(0.33, colorB),
		ColorSequenceKeypoint.new(0.66, colorC),
		ColorSequenceKeypoint.new(1, colorD),
	})
end

local function TextLabel(props: TextLabelProps)
	local effects = props.effects
	local gradient = if effects then effects.gradient else nil
	local rainbow = if effects then effects.rainbow else nil
	local shadow = if effects then effects.shadow else nil
	local outline = if effects then effects.outline else nil
	local pulse = if effects then effects.pulse else nil

	local rainbowEnabled = rainbow ~= nil and rainbow.enabled ~= false
	local rainbowGradientEnabled = rainbowEnabled and rainbow.gradient == true
	local rainbowSpeed = sanitizeNumber(if rainbow then rainbow.speed else nil, DEFAULT_RAINBOW_SPEED, 0, 8)
	local rainbowSaturation =
		sanitizeNumber(if rainbow then rainbow.saturation else nil, DEFAULT_RAINBOW_SATURATION, 0, 1)
	local rainbowValue = sanitizeNumber(if rainbow then rainbow.value else nil, DEFAULT_RAINBOW_VALUE, 0, 1)
	local rainbowSpread = sanitizeNumber(if rainbow then rainbow.spread else nil, DEFAULT_RAINBOW_SPREAD, 0.01, 1)

	local gradientEnabled = gradient ~= nil and gradient.enabled ~= false
	local gradientAnimated = gradientEnabled and gradient ~= nil and gradient.animated == true
	local gradientScrollSpeed =
		sanitizeNumber(if gradient then gradient.scrollSpeed else nil, DEFAULT_GRADIENT_SCROLL_SPEED, 0, 8)
	local gradientDirection =
		normalizeDirection(sanitizeVector2(if gradient then gradient.direction else nil, DEFAULT_GRADIENT_DIRECTION))
	local gradientRotation = sanitizeNumber(if gradient then gradient.rotation else nil, 0, -360, 360)
	local gradientTransparency = if gradient and gradient.transparency then gradient.transparency else nil
	local baseGradientOffset = sanitizeVector2(if gradient then gradient.offset else nil, Vector2.new(0, 0))
	local baseGradientColor = if gradient and gradient.color then gradient.color else DEFAULT_GRADIENT_COLOR

	local shadowEnabled = shadow ~= nil and shadow.enabled ~= false
	local shadowColor = sanitizeColor(if shadow then shadow.color else nil, DEFAULT_SHADOW_COLOR)
	local shadowOffset = sanitizeVector2(if shadow then shadow.offset else nil, DEFAULT_SHADOW_OFFSET)
	local shadowLayers = math.floor(sanitizeNumber(if shadow then shadow.layers else nil, DEFAULT_SHADOW_LAYERS, 1, 8))
	local shadowTransparency =
		sanitizeNumber(if shadow then shadow.transparency else nil, DEFAULT_SHADOW_TRANSPARENCY, 0, 1)

	local outlineEnabled = outline ~= nil and outline.enabled ~= false
	local outlineColor = sanitizeColor(if outline then outline.color else nil, DEFAULT_OUTLINE_COLOR)
	local outlineTransparency =
		sanitizeNumber(if outline then outline.transparency else nil, DEFAULT_OUTLINE_TRANSPARENCY, 0, 1)
	local outlineThickness = sanitizeNumber(if outline then outline.thickness else nil, DEFAULT_OUTLINE_THICKNESS, 1, 4)

	local pulseEnabled = pulse ~= nil and pulse.enabled == true
	local pulseSpeed = sanitizeNumber(if pulse then pulse.speed else nil, DEFAULT_PULSE_SPEED, 0, 12)
	local pulseMinScale = sanitizeNumber(if pulse then pulse.minScale else nil, DEFAULT_PULSE_MIN_SCALE, 0.01, 100)
	local pulseMaxScale = sanitizeNumber(if pulse then pulse.maxScale else nil, DEFAULT_PULSE_MAX_SCALE, 0.01, 100)

	local baseTextColor = sanitizeColor(props.textColor3, DEFAULT_TEXT_COLOR)
	local baseTextTransparency = sanitizeNumber(props.textTransparency, DEFAULT_TEXT_TRANSPARENCY, 0, 1)

	local animatedTextColor, setAnimatedTextColor = React.useBinding(baseTextColor)
	local animatedGradientOffset, setAnimatedGradientOffset = React.useBinding(baseGradientOffset)
	local animatedGradientColor, setAnimatedGradientColor = React.useBinding(baseGradientColor)
	local pulseScale, setPulseScale = React.useBinding(1)

	React.useEffect(function()
		setAnimatedTextColor(baseTextColor)
		setAnimatedGradientOffset(baseGradientOffset)
		setAnimatedGradientColor(baseGradientColor)
		setPulseScale(1)

		local isAnimating = rainbowEnabled or gradientAnimated or pulseEnabled
		if not isAnimating then
			return
		end

		local elapsed = 0
		local connection = RunService.RenderStepped:Connect(function(deltaTime: number)
			elapsed += deltaTime

			if rainbowEnabled then
				local hue = (elapsed * rainbowSpeed) % 1
				if rainbowGradientEnabled then
					setAnimatedGradientColor(buildRainbowSequence(hue, rainbowSaturation, rainbowValue, rainbowSpread))
				else
					setAnimatedTextColor(Color3.fromHSV(hue, rainbowSaturation, rainbowValue))
				end
			end

			if gradientAnimated then
				local shift = math.sin(elapsed * gradientScrollSpeed * math.pi * 2)
				local displacement = gradientDirection * shift
				setAnimatedGradientOffset(baseGradientOffset + displacement)
			end

			if pulseEnabled then
				local alpha = (math.sin(elapsed * pulseSpeed * math.pi * 2) + 1) * 0.5
				local scaleValue = pulseMinScale + (pulseMaxScale - pulseMinScale) * alpha
				setPulseScale(scaleValue)
			end
		end)

		return function()
			connection:Disconnect()
		end
	end, {
		baseTextColor,
		baseGradientColor,
		baseGradientOffset,
		rainbowEnabled,
		rainbowGradientEnabled,
		rainbowSpeed,
		rainbowSaturation,
		rainbowValue,
		rainbowSpread,
		gradientAnimated,
		gradientScrollSpeed,
		gradientDirection,
		pulseEnabled,
		pulseSpeed,
		pulseMinScale,
		pulseMaxScale,
	})

	local resolvedTextColor = if rainbowEnabled and not rainbowGradientEnabled then animatedTextColor else baseTextColor
	local resolvedGradientColor = if rainbowEnabled and rainbowGradientEnabled
		then animatedGradientColor
		else baseGradientColor
	local resolvedGradientOffset = if gradientAnimated then animatedGradientOffset else baseGradientOffset

	local textCommonProps = {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		Position = UDim2.fromOffset(0, 0),
		AnchorPoint = Vector2.new(0, 0),
		AutomaticSize = Enum.AutomaticSize.None,
		ClipsDescendants = false,
		Text = props.text or "",
		RichText = props.richText == true,
		Font = props.font or Enum.Font.GothamBold,
		TextSize = props.textSize or 16,
		TextScaled = props.textScaled == true,
		TextWrapped = props.textWrapped == true,
		TextTruncate = props.textTruncate,
		MaxVisibleGraphemes = props.maxVisibleGraphemes,
		TextXAlignment = props.textXAlignment or Enum.TextXAlignment.Left,
		TextYAlignment = props.textYAlignment or Enum.TextYAlignment.Center,
		LineHeight = props.lineHeight,
	}

	local children: { React.ReactNode } = {}

	if pulseEnabled then
		children[#children + 1] = e("UIScale", {
			Scale = pulseScale,
		})
	end

	local rootZIndex = props.zIndex or DEFAULT_Z_INDEX
	local shadowZIndex = math.max(0, rootZIndex - 2)
	local outlineZIndex = math.max(0, rootZIndex - 1)

	if shadowEnabled then
		for layer = 1, shadowLayers do
			local alpha = layer / shadowLayers
			local layerOffset = shadowOffset * alpha
			local layerTransparency = math.clamp(shadowTransparency + (1 - alpha) * 0.2, 0, 1)

			children[#children + 1] = e("TextLabel", {
				ZIndex = shadowZIndex,
				TextColor3 = shadowColor,
				TextTransparency = layerTransparency,
				TextStrokeTransparency = 1,
				Position = UDim2.fromOffset(layerOffset.X, layerOffset.Y),
				Font = textCommonProps.Font,
				Text = textCommonProps.Text,
				TextSize = textCommonProps.TextSize,
				TextScaled = textCommonProps.TextScaled,
				TextWrapped = textCommonProps.TextWrapped,
				TextXAlignment = textCommonProps.TextXAlignment,
				TextYAlignment = textCommonProps.TextYAlignment,
				TextTruncate = textCommonProps.TextTruncate,
				MaxVisibleGraphemes = textCommonProps.MaxVisibleGraphemes,
				RichText = textCommonProps.RichText,
				LineHeight = textCommonProps.LineHeight,
				Size = textCommonProps.Size,
				BackgroundTransparency = textCommonProps.BackgroundTransparency,
				BorderSizePixel = textCommonProps.BorderSizePixel,
			})
		end
	end

	if outlineEnabled then
		local offset = math.max(1, math.floor(outlineThickness))
		local outlineOffsets = {
			Vector2.new(-offset, 0),
			Vector2.new(offset, 0),
			Vector2.new(0, -offset),
			Vector2.new(0, offset),
			Vector2.new(-offset, -offset),
			Vector2.new(-offset, offset),
			Vector2.new(offset, -offset),
			Vector2.new(offset, offset),
		}

		for index, outlineOffset in outlineOffsets do
			children[#children + 1] = e("TextLabel", {
				ZIndex = outlineZIndex,
				TextColor3 = outlineColor,
				TextTransparency = outlineTransparency,
				TextStrokeTransparency = 1,
				Position = UDim2.fromOffset(outlineOffset.X, outlineOffset.Y),
				Font = textCommonProps.Font,
				Text = textCommonProps.Text,
				TextSize = textCommonProps.TextSize,
				TextScaled = textCommonProps.TextScaled,
				TextWrapped = textCommonProps.TextWrapped,
				TextXAlignment = textCommonProps.TextXAlignment,
				TextYAlignment = textCommonProps.TextYAlignment,
				TextTruncate = textCommonProps.TextTruncate,
				MaxVisibleGraphemes = textCommonProps.MaxVisibleGraphemes,
				RichText = textCommonProps.RichText,
				LineHeight = textCommonProps.LineHeight,
				Size = textCommonProps.Size,
				BackgroundTransparency = textCommonProps.BackgroundTransparency,
				BorderSizePixel = textCommonProps.BorderSizePixel,
			})
		end
	end

	local rootProps = {
		Size = props.size or DEFAULT_SIZE,
		Position = props.position or DEFAULT_POSITION,
		AnchorPoint = props.anchorPoint or DEFAULT_ANCHOR_POINT,
		AutomaticSize = props.automaticSize,
		LayoutOrder = props.layoutOrder,
		Visible = props.visible ~= false,
		ZIndex = rootZIndex,
		BackgroundColor3 = props.backgroundColor3,
		BackgroundTransparency = sanitizeNumber(props.backgroundTransparency, DEFAULT_BACKGROUND_TRANSPARENCY, 0, 1),
		BorderSizePixel = if props.borderSizePixel ~= nil then props.borderSizePixel else 0,
		ClipsDescendants = if props.clipsDescendants ~= nil then props.clipsDescendants else false,
		Text = textCommonProps.Text,
		RichText = textCommonProps.RichText,
		Font = textCommonProps.Font,
		TextSize = textCommonProps.TextSize,
		TextScaled = textCommonProps.TextScaled,
		TextWrapped = textCommonProps.TextWrapped,
		TextTruncate = textCommonProps.TextTruncate,
		MaxVisibleGraphemes = textCommonProps.MaxVisibleGraphemes,
		TextXAlignment = textCommonProps.TextXAlignment,
		TextYAlignment = textCommonProps.TextYAlignment,
		LineHeight = textCommonProps.LineHeight,
		TextColor3 = resolvedTextColor,
		TextTransparency = baseTextTransparency,
		TextStrokeColor3 = props.textStrokeColor3,
		TextStrokeTransparency = props.textStrokeTransparency,
	}

	if props.native then
		for index, value in props.native do
			(rootProps :: any)[index] = value
		end
	end

	if gradientEnabled or rainbowGradientEnabled then
		children[#children + 1] = e("UIGradient", {
			Color = resolvedGradientColor,
			Offset = resolvedGradientOffset,
			Rotation = gradientRotation,
			Transparency = gradientTransparency,
		})
	end

	if props.children then
		for _, child in props.children do
			children[#children + 1] = child
		end
	end

	return e("TextLabel", rootProps, children)
end

return TextLabel
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="822">
                  <Properties>
                    <string name="Name">TransparentFrame</string>
                    <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local React = require(ReplicatedStorage.Packages.React)

export type TransparentFrameProps = {
	size: UDim2?,
	position: UDim2?,
	anchorPoint: Vector2?,
	layoutOrder: number?,
	visible: boolean?,
	zIndex: number?,
	active: boolean?,
	selectable: boolean?,
	automaticSize: Enum.AutomaticSize?,
	clipsDescendants: boolean?,
	children: { React.ReactNode }?,
	native: { [any]: any }?,
}

local e: typeof(React.createElement) = React.createElement

return function(props: TransparentFrameProps): React.ReactNode
	local frameProps: { [any]: any } = {
		Size = props.size,
		Position = props.position,
		AnchorPoint = props.anchorPoint,
		LayoutOrder = props.layoutOrder,
		Visible = props.visible,
		ZIndex = props.zIndex,
		Active = props.active,
		Selectable = props.selectable,
		AutomaticSize = props.automaticSize,
		ClipsDescendants = props.clipsDescendants,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
	}

	if props.native ~= nil then
		for key, value in props.native do
			frameProps[key] = value
		end
	end

	return e("Frame", frameProps, props.children)
end
]]></string>
                  </Properties>
                </Item>
              </Item>
              <Item class="Folder" referent="823">
                <Properties>
                  <string name="Name">utils</string>
                </Properties>
                <Item class="ModuleScript" referent="824">
                  <Properties>
                    <string name="Name">CoinSprites</string>
                    <string name="Source"><![CDATA[--!strict
local ImageIds = require(script:FindFirstAncestor("game").Client.UI.core.ImageIds)

local CoinSprites = {} :: any

CoinSprites.sheetSize = Vector2.new(1290, 774)
CoinSprites.rows = 3
CoinSprites.columns = 5
CoinSprites.frameSize = Vector2.new(
	math.floor(CoinSprites.sheetSize.X / CoinSprites.columns),
	math.floor(CoinSprites.sheetSize.Y / CoinSprites.rows)
)
CoinSprites.frameCount = CoinSprites.rows * CoinSprites.columns
CoinSprites.fps = 12

CoinSprites.spriteSheetKeyByItemId = {
	CopperCoin = "copperCoin",
	SilverCoin = "silverCoin",
	GoldCoin = "goldCoin",
	PlatinumCoin = "platinumCoin",
}

function CoinSprites.resolveSpriteSheet(itemIdRaw: any): string?
	local itemId = if typeof(itemIdRaw) == "string" then itemIdRaw else nil
	if itemId == nil then
		return nil
	end

	local spriteSheetKey = CoinSprites.spriteSheetKeyByItemId[itemId]
	if spriteSheetKey == nil then
		return nil
	end

	local spriteSheets = if typeof(ImageIds.spriteSheets) == "table"
		then ImageIds.spriteSheets :: { [string]: any }
		else nil
	if spriteSheets == nil then
		return nil
	end

	local spriteSheet = spriteSheets[spriteSheetKey]
	if typeof(spriteSheet) ~= "string" or spriteSheet == "" then
		return nil
	end

	return spriteSheet
end

return CoinSprites
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="825">
                  <Properties>
                    <string name="Name">ConnectionUtils</string>
                    <string name="Source"><![CDATA[--!strict
local ConnectionUtils = {}

function ConnectionUtils.Disconnect(connection: RBXScriptConnection?)
	if connection ~= nil then
		connection:Disconnect()
	end
end

function ConnectionUtils.DisconnectMany(connections: { RBXScriptConnection? })
	for _, connection in connections do
		ConnectionUtils.Disconnect(connection)
	end
end

function ConnectionUtils.Call(disconnectRaw: any)
	if typeof(disconnectRaw) == "function" then
		(disconnectRaw :: () -> ())()
	end
end

ConnectionUtils.disconnect = ConnectionUtils.Disconnect
ConnectionUtils.disconnectMany = ConnectionUtils.DisconnectMany
ConnectionUtils.call = ConnectionUtils.Call

return ConnectionUtils
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="826">
                  <Properties>
                    <string name="Name">PortalTargets</string>
                    <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")

local PortalTargets = {}

local UI_ROOT_NAME = "App"

function PortalTargets.ResolveUiScreenGui(): ScreenGui?
	local localPlayer = Players.LocalPlayer
	if localPlayer == nil then
		return nil
	end

	local playerGui = localPlayer:FindFirstChildOfClass("PlayerGui")
	if playerGui == nil then
		return nil
	end

	local screenGui = playerGui:FindFirstChild(UI_ROOT_NAME)
	if screenGui ~= nil and screenGui:IsA("ScreenGui") then
		return screenGui
	end

	return nil
end

PortalTargets.resolveUiScreenGui = PortalTargets.ResolveUiScreenGui

return PortalTargets
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="827">
                  <Properties>
                    <string name="Name">ServiceSync</string>
                    <string name="Source"><![CDATA[--!strict
local packageRoot = script:FindFirstAncestor("game").Parent
local loaderUtils = assert(packageRoot:FindFirstChild("LoaderUtils", true), "Missing LoaderUtils")
local loader = require(loaderUtils.Parent).load(script)

local Promise = loader("Promise")

type StateGetter<T> = () -> T
type StateApplier<T> = (nextStateRaw: any) -> T
type StateChangedHandler = (nextStateRaw: any) -> ()

local ServiceSync = {}

local function requestSyncPromise(serviceClientRaw: any): any
	if typeof(serviceClientRaw) ~= "table" then
		return Promise.resolved(false)
	end
	if typeof((serviceClientRaw :: any).requestSync) ~= "function" then
		return Promise.resolved(false)
	end

	return Promise.spawn(function(resolve, _reject)
		local success = pcall(function()
			(serviceClientRaw :: any):requestSync()
		end)
		resolve(success)
	end)
end

function ServiceSync.syncFromService<T>(
	serviceClientRaw: any,
	getFallbackState: StateGetter<T>,
	applyState: StateApplier<T>
): T
	if typeof(serviceClientRaw) ~= "table" or (serviceClientRaw :: any).state == nil then
		return getFallbackState()
	end

	local success, nextState = pcall(function()
		return (serviceClientRaw :: any):getState()
	end)
	if success then
		return applyState(nextState)
	end

	return getFallbackState()
end

function ServiceSync.ConnectStateChanged(
	serviceClientRaw: any,
	onStateChanged: StateChangedHandler
): RBXScriptConnection?
	if typeof(serviceClientRaw) ~= "table" then
		return nil
	end
	local stateChangedSignal = (serviceClientRaw :: any).stateChanged
	if stateChangedSignal == nil then
		return nil
	end

	return stateChangedSignal:Connect(onStateChanged)
end

function ServiceSync.ReadReady(serviceClientRaw: any, fallbackReadyRaw: any?): boolean
	local fallbackReady = fallbackReadyRaw == true
	if typeof(serviceClientRaw) ~= "table" then
		return fallbackReady
	end
	if typeof((serviceClientRaw :: any).isReady) ~= "function" then
		return fallbackReady
	end

	local success, isReady = pcall(function()
		return (serviceClientRaw :: any):isReady()
	end)
	if not success then
		return fallbackReady
	end
	return isReady == true
end

function ServiceSync.RequestSync(serviceClientRaw: any)
	requestSyncPromise(serviceClientRaw)
end

function ServiceSync.RequestSyncMany(serviceClientsRaw: { any })
	for _, serviceClient in serviceClientsRaw do
		requestSyncPromise(serviceClient)
	end
end

ServiceSync.connectStateChanged = ServiceSync.ConnectStateChanged
ServiceSync.readReady = ServiceSync.ReadReady
ServiceSync.requestSync = ServiceSync.RequestSync
ServiceSync.requestSyncMany = ServiceSync.RequestSyncMany

return ServiceSync
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="828">
                  <Properties>
                    <string name="Name">UiScaleUtils</string>
                    <string name="Source"><![CDATA[--!strict

export type Breakpoint = "small" | "medium" | "large"
export type DeviceClass = "mobile" | "tablet" | "desktop"

export type SafeArea = {
	top: number,
	right: number,
	bottom: number,
	left: number,
}

export type HudTokens = {
	edgePadding: number,
	railThickness: number,
	topBarHeight: number,
	bottomBarHeight: number,
	sideBarWidth: number,
	sideBarVerticalPadding: number,
	navButtonWidth: number,
	sideButtonWidth: number,
	navButtonHeight: number,
	navButtonGap: number,
	navButtonTextSize: number,
}

export type MeterTokens = {
	segmentSize: number,
	segmentGap: number,
	frameWidth: number,
	frameHeight: number,
	labelTextSize: number,
}

export type InventoryTokens = {
	slotSize: number,
	slotGap: number,
	leftPadding: number,
	keyHintTextSize: number,
}

export type CraftingTokens = {
	panelWidth: number,
	panelHeight: number,
	panelScale: number,
	panelPadding: number,
	headerHeight: number,
	searchY: number,
	categoryY: number,
	recipeGridY: number,
	recipeDetailsY: number,
	craftButtonY: number,
	craftButtonHeight: number,
	recipeSlotSize: number,
	requirementSlotSize: number,
	iconSize: number,
	textSize: number,
}

export type TextTokens = {
	tiny: number,
	small: number,
	body: number,
	button: number,
	title: number,
}

export type ResponsiveTokens = {
	hud: HudTokens,
	meter: MeterTokens,
	inventory: InventoryTokens,
	crafting: CraftingTokens,
	text: TextTokens,
}

export type ResponsiveMetrics = {
	viewport: Vector2,
	scale: number,
	breakpoint: Breakpoint,
	deviceClass: DeviceClass,
	isSmall: boolean,
	isCompactHud: boolean,
	safeArea: SafeArea,
	tokens: ResponsiveTokens,
}

local UiScaleUtils = {}

UiScaleUtils.REFERENCE_VIEWPORT = Vector2.new(1920, 1080)
UiScaleUtils.MIN_SCALE = 0.58
UiScaleUtils.MAX_SCALE = 1.12

local function snap(value: number): number
	return math.floor(value + 0.5)
end

local function scaleNumber(value: number, scale: number, minValue: number?): number
	return math.max(minValue or 0, snap(value * scale))
end

local function resolveTrailingInset(viewportAxis: number, trailingValue: number): number
	if trailingValue > viewportAxis * 0.5 then
		return math.max(0, viewportAxis - trailingValue)
	end
	return math.max(0, trailingValue)
end

function UiScaleUtils.snap(value: number): number
	return snap(value)
end

function UiScaleUtils.scaleNumber(value: number, scale: number, minValue: number?): number
	return scaleNumber(value, scale, minValue)
end

function UiScaleUtils.resolveScale(viewport: Vector2): number
	local safeViewport = Vector2.new(math.max(1, viewport.X), math.max(1, viewport.Y))
	local rawScale =
		math.min(safeViewport.X / UiScaleUtils.REFERENCE_VIEWPORT.X, safeViewport.Y / UiScaleUtils.REFERENCE_VIEWPORT.Y)
	return math.clamp(rawScale, UiScaleUtils.MIN_SCALE, UiScaleUtils.MAX_SCALE)
end

function UiScaleUtils.resolveBreakpoint(viewport: Vector2): Breakpoint
	if viewport.X < 900 or viewport.Y < 560 then
		return "small"
	end
	if viewport.X < 1280 or viewport.Y < 760 then
		return "medium"
	end
	return "large"
end

function UiScaleUtils.resolveDeviceClass(viewport: Vector2): DeviceClass
	if viewport.X < 760 then
		return "mobile"
	end
	if viewport.X < 1180 then
		return "tablet"
	end
	return "desktop"
end

function UiScaleUtils.resolveSafeArea(
	viewport: Vector2,
	safeInsetTopLeft: Vector2?,
	safeInsetBottomRight: Vector2?,
	scale: number
): SafeArea
	local topLeft = safeInsetTopLeft or Vector2.zero
	local bottomRight = safeInsetBottomRight or Vector2.zero
	local basePadding = scaleNumber(12, scale, 8)

	return {
		top = math.max(basePadding, snap(topLeft.Y)),
		left = math.max(basePadding, snap(topLeft.X)),
		right = math.max(basePadding, snap(resolveTrailingInset(viewport.X, bottomRight.X))),
		bottom = math.max(basePadding, snap(resolveTrailingInset(viewport.Y, bottomRight.Y))),
	}
end

local function resolveInventorySlotSize(viewport: Vector2, safeArea: SafeArea, scale: number, compact: boolean): number
	local desiredSlot = scaleNumber(if compact then 50 else 58, scale, if compact then 38 else 46)
	local desiredGap = scaleNumber(if compact then 5 else 6, scale, 4)
	local availableWidth = math.max(220, viewport.X - safeArea.left - safeArea.right - scaleNumber(24, scale, 12))
	local maxSlotByWidth = math.floor((availableWidth - desiredGap * 8) / 9)

	return math.clamp(math.min(desiredSlot, maxSlotByWidth), 34, 64)
end

function UiScaleUtils.resolveTokens(metrics: {
	viewport: Vector2,
	scale: number,
	breakpoint: Breakpoint,
	deviceClass: DeviceClass,
	isCompactHud: boolean,
	safeArea: SafeArea,
}): ResponsiveTokens
	local viewport = metrics.viewport
	local scale = metrics.scale
	local compact = metrics.isCompactHud
	local safeArea = metrics.safeArea
	local edgePadding = scaleNumber(if compact then 8 else 12, scale, 6)
	local railThickness = scaleNumber(if compact then 48 else 56, scale, 44)
	local navButtonWidth = scaleNumber(if compact then 132 else 170, scale, 112)
	local sideButtonWidth = scaleNumber(if compact then 132 else 190, scale, 112)
	local navButtonHeight = scaleNumber(if compact then 34 else 40, scale, 30)
	local segmentSize = scaleNumber(if compact then 24 else 30, scale, 20)
	local slotSize = resolveInventorySlotSize(viewport, safeArea, scale, compact)
	local slotGap = scaleNumber(if compact then 5 else 6, scale, 4)
	local craftingAvailableWidth = math.max(220, viewport.X - safeArea.left - safeArea.right - edgePadding * 2)
	local craftingAvailableHeight = math.max(260, viewport.Y - safeArea.top - safeArea.bottom - edgePadding * 2)
	local craftingFitScale = math.min(craftingAvailableWidth / 336, craftingAvailableHeight / 458)
	local craftingScale = math.clamp(math.min(scale, craftingFitScale), 0.68, 1)

	return {
		hud = {
			edgePadding = edgePadding,
			railThickness = railThickness,
			topBarHeight = railThickness,
			bottomBarHeight = railThickness,
			sideBarWidth = railThickness,
			sideBarVerticalPadding = scaleNumber(if compact then 48 else 72, scale, 42),
			navButtonWidth = navButtonWidth,
			sideButtonWidth = sideButtonWidth,
			navButtonHeight = navButtonHeight,
			navButtonGap = scaleNumber(if compact then 6 else 8, scale, 4),
			navButtonTextSize = scaleNumber(if compact then 13 else 14, scale, 11),
		},
		meter = {
			segmentSize = segmentSize,
			segmentGap = scaleNumber(if compact then 2 else 4, scale, 2),
			frameWidth = scaleNumber(if compact then 260 else 360, scale, 220),
			frameHeight = scaleNumber(if compact then 44 else 56, scale, 40),
			labelTextSize = scaleNumber(if compact then 12 else 14, scale, 10),
		},
		inventory = {
			slotSize = slotSize,
			slotGap = slotGap,
			leftPadding = scaleNumber(if compact then 10 else 16, scale, 8),
			keyHintTextSize = scaleNumber(if compact then 9 else 11, scale, 8),
		},
		crafting = {
			panelWidth = 336,
			panelHeight = 458,
			panelScale = craftingScale,
			panelPadding = 10,
			headerHeight = 24,
			searchY = 38,
			categoryY = 72,
			recipeGridY = 104,
			recipeDetailsY = 348,
			craftButtonY = 416,
			craftButtonHeight = 32,
			recipeSlotSize = 80,
			requirementSlotSize = 60,
			iconSize = 30,
			textSize = 12,
		},
		text = {
			tiny = scaleNumber(10, scale, 9),
			small = scaleNumber(12, scale, 10),
			body = scaleNumber(14, scale, 11),
			button = scaleNumber(14, scale, 11),
			title = scaleNumber(18, scale, 14),
		},
	}
end

function UiScaleUtils.resolveMetrics(
	viewportRaw: Vector2?,
	safeInsetTopLeft: Vector2?,
	safeInsetBottomRight: Vector2?
): ResponsiveMetrics
	local viewport = viewportRaw or UiScaleUtils.REFERENCE_VIEWPORT
	viewport = Vector2.new(math.max(1, viewport.X), math.max(1, viewport.Y))
	local scale = UiScaleUtils.resolveScale(viewport)
	local breakpoint: Breakpoint = UiScaleUtils.resolveBreakpoint(viewport)
	local deviceClass: DeviceClass = UiScaleUtils.resolveDeviceClass(viewport)
	local compactHud = breakpoint == "small" or viewport.X < 980 or viewport.Y < 620
	local safeArea = UiScaleUtils.resolveSafeArea(viewport, safeInsetTopLeft, safeInsetBottomRight, scale)

	local metricInput: {
		viewport: Vector2,
		scale: number,
		breakpoint: Breakpoint,
		deviceClass: DeviceClass,
		isCompactHud: boolean,
		safeArea: SafeArea,
	} =
		{
			viewport = viewport,
			scale = scale,
			breakpoint = breakpoint,
			deviceClass = deviceClass,
			isCompactHud = compactHud,
			safeArea = safeArea,
		}

	return {
		viewport = viewport,
		scale = scale,
		breakpoint = breakpoint,
		deviceClass = deviceClass,
		isSmall = breakpoint == "small",
		isCompactHud = compactHud,
		safeArea = safeArea,
		tokens = UiScaleUtils.resolveTokens(metricInput),
	}
end

function UiScaleUtils.clampCenteredPanelOffset(
	offset: Vector2,
	panelSize: Vector2,
	panelScale: number,
	metrics: ResponsiveMetrics
): Vector2
	local visibleSize = panelSize * panelScale
	local safeArea = metrics.safeArea
	local minCenterX = safeArea.left + visibleSize.X * 0.5
	local maxCenterX = metrics.viewport.X - safeArea.right - visibleSize.X * 0.5
	local minCenterY = safeArea.top + visibleSize.Y * 0.5
	local maxCenterY = metrics.viewport.Y - safeArea.bottom - visibleSize.Y * 0.5
	local viewportCenter = metrics.viewport * 0.5

	if minCenterX > maxCenterX then
		minCenterX = viewportCenter.X
		maxCenterX = viewportCenter.X
	end
	if minCenterY > maxCenterY then
		minCenterY = viewportCenter.Y
		maxCenterY = viewportCenter.Y
	end

	local unclampedCenter = viewportCenter + offset
	local clampedCenter = Vector2.new(
		math.clamp(unclampedCenter.X, minCenterX, maxCenterX),
		math.clamp(unclampedCenter.Y, minCenterY, maxCenterY)
	)

	return clampedCenter - viewportCenter
end

return UiScaleUtils
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="829">
                  <Properties>
                    <string name="Name">UiSound</string>
                    <string name="Source"><![CDATA[--!strict
local AudioRegistry = require(script:FindFirstAncestor("game").Shared.Modules.Items.Audio)
local AudioServiceClient = require(script:FindFirstAncestor("game").Client.Services.AudioServiceClient)
local AudioServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.AudioServiceUtils)

local UI_AUDIO = (AudioRegistry :: any).UI or {}

local UiSound = {} :: any

UiSound.hover = AudioServiceUtils.normalizeSoundAssetId(UI_AUDIO.Hover)
UiSound.press = AudioServiceUtils.normalizeSoundAssetId(UI_AUDIO.Press or UI_AUDIO.Click)
UiSound.click = AudioServiceUtils.normalizeSoundAssetId(UI_AUDIO.Click or UI_AUDIO.Press)
UiSound.trash = AudioServiceUtils.normalizeSoundAssetId(UI_AUDIO.Trash or UI_AUDIO.Drop)
UiSound.trashCanOpen = AudioServiceUtils.normalizeSoundAssetId(UI_AUDIO.TrashCanOpen)
UiSound.trashCanClose = AudioServiceUtils.normalizeSoundAssetId(UI_AUDIO.TrashCanClose)
UiSound.itemPutDown = AudioServiceUtils.normalizeSoundAssetId(UI_AUDIO.ItemPutDown)
UiSound.craft = AudioServiceUtils.normalizeSoundAssetId(UI_AUDIO.Craft)
UiSound.drag = AudioServiceUtils.normalizeSoundAssetId(UI_AUDIO.Drag)

function UiSound.play(soundAssetId: string?)
	if AudioServiceClient.categoryGroups == nil then
		return
	end

	if soundAssetId == nil then
		return
	end

	AudioServiceClient:playUi(soundAssetId, {
		replaceChannel = false,
	})
end

function UiSound.playHover()
	UiSound.play(UiSound.hover)
end

function UiSound.playPress()
	UiSound.play(UiSound.press)
end

function UiSound.playTrash()
	UiSound.play(UiSound.trash)
end

function UiSound.playCraft()
	UiSound.play(UiSound.craft)
end

function UiSound.playDrag()
	UiSound.play(UiSound.drag)
end

return UiSound
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="830">
                  <Properties>
                    <string name="Name">formatNumber</string>
                    <string name="Source"><![CDATA[--!strict

local function formatNumber(valueRaw: any): string
	local value = if typeof(valueRaw) == "number" and valueRaw == valueRaw then valueRaw else 0
	local absolute = math.abs(math.floor(value))
	local raw = tostring(absolute)
	local remainder = #raw % 3
	local groups = {}

	if remainder > 0 then
		table.insert(groups, string.sub(raw, 1, remainder))
	end

	local index = remainder + 1
	while index <= #raw do
		table.insert(groups, string.sub(raw, index, index + 2))
		index += 3
	end

	local formatted = table.concat(groups, ",")
	if value < 0 then
		return "-" .. formatted
	end
	return formatted
end

return formatNumber
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="831">
                  <Properties>
                    <string name="Name">resolveImageId</string>
                    <string name="Source"><![CDATA[--!strict

local function normalizeImageId(valueRaw: any): string?
	if typeof(valueRaw) == "number" then
		if valueRaw ~= valueRaw or valueRaw <= 0 then
			return nil
		end
		return "rbxassetid://" .. tostring(math.floor(valueRaw))
	end

	if typeof(valueRaw) ~= "string" then
		return nil
	end

	local value = string.gsub(valueRaw, "%s", "")
	if value == "" then
		return nil
	end

	if string.find(value, "rbxassetid://", 1, true) == 1 then
		local digits = string.match(value, "%d+")
		if digits == nil then
			return nil
		end
		return "rbxassetid://" .. digits
	end

	if string.match(value, "^%d+$") ~= nil then
		return "rbxassetid://" .. value
	end

	return value
end

local function resolveImageId(valueRaw: any, fallbackRaw: any?): string
	return normalizeImageId(valueRaw) or normalizeImageId(fallbackRaw) or ""
end

return resolveImageId
]]></string>
                  </Properties>
                </Item>
              </Item>
            </Item>
            <Item class="Folder" referent="832">
              <Properties>
                <string name="Name">features</string>
              </Properties>
              <Item class="Folder" referent="833">
                <Properties>
                  <string name="Name">binding</string>
                </Properties>
                <Item class="Folder" referent="834">
                  <Properties>
                    <string name="Name">hud</string>
                  </Properties>
                  <Item class="ModuleScript" referent="835">
                    <Properties>
                      <string name="Name">BindingHintBottomBar</string>
                      <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local React = require(ReplicatedStorage.Packages.React)
local TextLabel = require(script:FindFirstAncestor("game").Client.UI.core.primitives.TextLabel)
local bindingSlice = require(script:FindFirstAncestor("game").Client.UI.features.binding.state.bindingSlice)

type BindingHintEntry = bindingSlice.BindingHintEntry

type BindingHintBottomBarProps = {
	layoutOrder: number?,
	visible: boolean?,
	zIndex: number?,
	position: UDim2?,
	anchorPoint: Vector2?,
	hints: { BindingHintEntry }?,
	deviceClass: string?,
}

type Metrics = {
	promptHeight: number,
	promptMinWidth: number,
	promptTextSize: number,
	labelTextSize: number,
	detailTextSize: number,
	promptGap: number,
	itemGap: number,
	labelGap: number,
	leftInset: number,
	bottomInset: number,
}

local e: typeof(React.createElement) = React.createElement
local HINT_CONTENT_TRANSPARENCY = 0
local PROMPT_TEXT_COLOR = Color3.fromRGB(244, 248, 255)
local LABEL_TEXT_COLOR = Color3.fromRGB(246, 249, 255)
local DETAIL_TEXT_COLOR = Color3.fromRGB(160, 198, 235)

local function resolveMetrics(deviceClassRaw: any): Metrics
	if deviceClassRaw == "Console" then
		return {
			promptHeight = 42,
			promptMinWidth = 42,
			promptTextSize = 24,
			labelTextSize = 20,
			detailTextSize = 15,
			promptGap = 8,
			itemGap = 14,
			labelGap = 2,
			leftInset = 20,
			bottomInset = 12,
		}
	end
	if deviceClassRaw == "Phone" then
		return {
			promptHeight = 30,
			promptMinWidth = 30,
			promptTextSize = 16,
			labelTextSize = 14,
			detailTextSize = 11,
			promptGap = 6,
			itemGap = 10,
			labelGap = 1,
			leftInset = 10,
			bottomInset = 8,
		}
	end
	if deviceClassRaw == "Tablet" then
		return {
			promptHeight = 34,
			promptMinWidth = 34,
			promptTextSize = 19,
			labelTextSize = 15,
			detailTextSize = 12,
			promptGap = 6,
			itemGap = 11,
			labelGap = 1,
			leftInset = 12,
			bottomInset = 9,
		}
	end
	return {
		promptHeight = 38,
		promptMinWidth = 38,
		promptTextSize = 20,
		labelTextSize = 15,
		detailTextSize = 11,
		promptGap = 6,
		itemGap = 12,
		labelGap = 1,
		leftInset = 12,
		bottomInset = 9,
	}
end

local function resolvePromptIconWidth(hint: BindingHintEntry, metrics: Metrics): number
	local promptText = hint.promptText or ""
	local widthFactor = 1

	if promptText == "Space" then
		widthFactor = 2.35
	elseif promptText == "Enter" or promptText == "Shift" or promptText == "Ctrl" or promptText == "Alt" then
		widthFactor = 1.65
	elseif string.find(promptText, "D-Pad", 1, true) ~= nil or string.find(promptText, "Stick", 1, true) ~= nil then
		widthFactor = 1.5
	elseif #promptText >= 4 then
		widthFactor = 1.3
	elseif #promptText >= 2 then
		widthFactor = 1.1
	end

	return math.max(metrics.promptMinWidth, math.floor(metrics.promptHeight * widthFactor + 0.5))
end

local function resolvePromptGap(hint: BindingHintEntry, metrics: Metrics): number
	local promptText = hint.promptText or ""
	if promptText == "Space" then
		return math.max(2, metrics.promptGap - 2)
	end
	if
		#promptText >= 4
		or string.find(promptText, "D-Pad", 1, true) ~= nil
		or string.find(promptText, "Stick", 1, true) ~= nil
	then
		return math.max(3, metrics.promptGap - 1)
	end
	return metrics.promptGap
end

local function HintPrompt(props: {
	hint: BindingHintEntry,
	metrics: Metrics,
	zIndex: number,
}): React.ReactNode
	local hasPromptIcon = props.hint.promptIcon ~= nil and props.hint.promptIcon ~= ""
	local hasPromptText = props.hint.promptText ~= nil and props.hint.promptText ~= ""

	if hasPromptIcon then
		return e("ImageLabel", {
			Size = UDim2.fromOffset(resolvePromptIconWidth(props.hint, props.metrics), props.metrics.promptHeight),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Image = props.hint.promptIcon,
			ScaleType = Enum.ScaleType.Fit,
			ImageTransparency = HINT_CONTENT_TRANSPARENCY,
			LayoutOrder = 1,
			ZIndex = props.zIndex + 1,
		})
	end

	if hasPromptText then
		return e(TextLabel, {
			text = props.hint.promptText,
			size = UDim2.fromOffset(0, 0),
			automaticSize = Enum.AutomaticSize.XY,
			backgroundTransparency = 1,
			font = Enum.Font.GothamBold,
			textSize = props.metrics.promptTextSize,
			textColor3 = PROMPT_TEXT_COLOR,
			textTransparency = HINT_CONTENT_TRANSPARENCY,
			textXAlignment = Enum.TextXAlignment.Left,
			textYAlignment = Enum.TextYAlignment.Center,
			layoutOrder = 1,
			zIndex = props.zIndex + 1,
			effects = {
				shadow = {
					enabled = true,
					color = Color3.fromRGB(0, 0, 0),
					transparency = 0.7,
					offset = Vector2.new(1, 1),
					layers = 1,
				},
			},
		})
	end

	return nil
end

local function HintBody(props: {
	hint: BindingHintEntry,
	metrics: Metrics,
	zIndex: number,
}): React.ReactNode
	local children: { React.ReactNode } = {
		e("UIListLayout", {
			FillDirection = Enum.FillDirection.Vertical,
			HorizontalAlignment = Enum.HorizontalAlignment.Left,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			Padding = UDim.new(0, props.metrics.labelGap),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
		e(TextLabel, {
			text = props.hint.label,
			size = UDim2.fromOffset(0, 0),
			automaticSize = Enum.AutomaticSize.XY,
			backgroundTransparency = 1,
			font = Enum.Font.GothamBold,
			textSize = props.metrics.labelTextSize,
			textColor3 = LABEL_TEXT_COLOR,
			textTransparency = HINT_CONTENT_TRANSPARENCY,
			textXAlignment = Enum.TextXAlignment.Left,
			textYAlignment = Enum.TextYAlignment.Center,
			layoutOrder = 1,
			zIndex = props.zIndex + 1,
			effects = {
				shadow = {
					enabled = true,
					color = Color3.fromRGB(0, 0, 0),
					transparency = 0.72,
					offset = Vector2.new(1, 1),
					layers = 1,
				},
			},
		}),
	}

	if props.hint.detail ~= nil and props.hint.detail ~= "" then
		children[#children + 1] = e(TextLabel, {
			text = props.hint.detail,
			size = UDim2.fromOffset(0, 0),
			automaticSize = Enum.AutomaticSize.XY,
			backgroundTransparency = 1,
			font = Enum.Font.Gotham,
			textSize = props.metrics.detailTextSize,
			textColor3 = DETAIL_TEXT_COLOR,
			textTransparency = HINT_CONTENT_TRANSPARENCY,
			textXAlignment = Enum.TextXAlignment.Left,
			textYAlignment = Enum.TextYAlignment.Center,
			layoutOrder = 2,
			zIndex = props.zIndex + 1,
		})
	end

	return e("Frame", {
		Size = UDim2.fromOffset(0, props.metrics.promptHeight),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		LayoutOrder = 2,
		Active = false,
		Selectable = false,
		ZIndex = props.zIndex,
	}, children)
end

local function HintItem(props: {
	hint: BindingHintEntry,
	metrics: Metrics,
	zIndex: number,
	layoutOrder: number,
}): React.ReactNode
	local children: { React.ReactNode } = {
		e("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Left,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			Padding = UDim.new(0, resolvePromptGap(props.hint, props.metrics)),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
		e(HintBody, {
			hint = props.hint,
			metrics = props.metrics,
			zIndex = props.zIndex + 1,
		}),
	}

	local prompt = HintPrompt({
		hint = props.hint,
		metrics = props.metrics,
		zIndex = props.zIndex + 1,
	})
	if prompt ~= nil then
		children[#children + 1] = prompt
	end

	return e("Frame", {
		Size = UDim2.fromOffset(0, 0),
		AutomaticSize = Enum.AutomaticSize.XY,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		LayoutOrder = props.layoutOrder,
		Active = false,
		Selectable = false,
		ZIndex = props.zIndex,
	}, children)
end

return function(props: BindingHintBottomBarProps): React.ReactNode
	local hints = props.hints or {}
	if props.visible == false or #hints <= 0 then
		return nil
	end

	local zIndex = props.zIndex or 180
	local metrics = resolveMetrics(props.deviceClass)
	local children: { React.ReactNode } = {
		e("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Left,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			Padding = UDim.new(0, metrics.itemGap),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	}

	for index, hint in hints do
		children[#children + 1] = e(HintItem, {
			hint = hint,
			metrics = metrics,
			zIndex = zIndex + 1,
			layoutOrder = index,
		})
	end

	return e("Frame", {
		Size = UDim2.fromOffset(0, 0),
		AutomaticSize = Enum.AutomaticSize.XY,
		Position = props.position or UDim2.new(0, metrics.leftInset, 1, -metrics.bottomInset),
		AnchorPoint = props.anchorPoint or Vector2.new(0, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		LayoutOrder = props.layoutOrder or 1,
		Active = false,
		Selectable = false,
		ZIndex = zIndex,
		Visible = true,
	}, children)
end
]]></string>
                    </Properties>
                  </Item>
                </Item>
                <Item class="Folder" referent="836">
                  <Properties>
                    <string name="Name">screens</string>
                  </Properties>
                  <Item class="ModuleScript" referent="837">
                    <Properties>
                      <string name="Name">bindingHintScreen</string>
                      <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local BindingHintBottomBar =
	require(script:FindFirstAncestor("game").Client.UI.features.binding.hud.BindingHintBottomBar)
local React = require(ReplicatedStorage.Packages.React)
local bindingSlice = require(script:FindFirstAncestor("game").Client.UI.features.binding.state.bindingSlice)
local bindingThunks = require(script:FindFirstAncestor("game").Client.UI.features.binding.state.bindingThunks)
local useStore = require(script:FindFirstAncestor("game").Client.UI.core.hooks.useStore)

type BindingHintState = bindingSlice.BindingHintState

type BindingHintScreenProps = {
	layoutOrder: number?,
	zIndex: number?,
	visible: boolean?,
}

local e: typeof(React.createElement) = React.createElement

return function(props: BindingHintScreenProps?): React.ReactNode
	local resolvedProps: BindingHintScreenProps = if props ~= nil then props else {}
	local bindingState = (useStore(bindingSlice.bindingStateAtom) :: BindingHintState?)
		or bindingSlice.getBindingState()

	React.useEffect(function()
		local stop = bindingThunks.start()

		return function()
			stop()
		end
	end, {})

	if resolvedProps.visible == false or bindingState.visible ~= true or #bindingState.hints <= 0 then
		return nil
	end

	local zIndex = resolvedProps.zIndex or 180
	return e(BindingHintBottomBar, {
		layoutOrder = resolvedProps.layoutOrder or 1,
		zIndex = zIndex + 1,
		visible = true,
		hints = bindingState.hints,
		deviceClass = bindingState.deviceClass,
	})
end
]]></string>
                    </Properties>
                  </Item>
                </Item>
                <Item class="Folder" referent="838">
                  <Properties>
                    <string name="Name">state</string>
                  </Properties>
                  <Item class="ModuleScript" referent="839">
                    <Properties>
                      <string name="Name">bindingSlice</string>
                      <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Charm = require(ReplicatedStorage.Packages.Charm)

export type BindingHintEntry = {
	id: string,
	actionName: string?,
	label: string,
	detail: string?,
	promptText: string?,
	promptIcon: string?,
	enabled: boolean,
	priority: number,
}

export type BindingHintState = {
	started: boolean,
	visible: boolean,
	platform: string,
	deviceClass: string,
	hints: { BindingHintEntry },
	updatedAt: number,
}

local DEFAULT_STATE: BindingHintState = {
	started = false,
	visible = false,
	platform = "KeyboardMouse",
	deviceClass = "Desktop",
	hints = {},
	updatedAt = os.clock(),
}

local bindingStateAtom: Charm.Atom<BindingHintState> = Charm.atom(DEFAULT_STATE)

local function trim(textRaw: any): string
	if typeof(textRaw) ~= "string" then
		return ""
	end
	return string.match(textRaw, "^%s*(.-)%s*$") or ""
end

local function sanitizeBoolean(valueRaw: any, fallback: boolean): boolean
	if typeof(valueRaw) == "boolean" then
		return valueRaw
	end
	return fallback
end

local function sanitizeInteger(valueRaw: any, fallback: number): number
	if typeof(valueRaw) ~= "number" or valueRaw ~= valueRaw then
		return fallback
	end
	return math.floor(valueRaw)
end

local function sanitizeHintEntry(entryRaw: any, index: number): BindingHintEntry?
	if typeof(entryRaw) ~= "table" then
		return nil
	end

	local entry = entryRaw :: { [string]: any }
	local id = trim(entry.id)
	if id == "" then
		id = ("binding_hint_%d"):format(index)
	end

	local label = trim(entry.label)
	if label == "" then
		return nil
	end

	local actionName = trim(entry.actionName)
	local detail = trim(entry.detail)
	local promptText = trim(entry.promptText)
	local promptIcon = trim(entry.promptIcon)

	return {
		id = id,
		actionName = if actionName ~= "" then actionName else nil,
		label = label,
		detail = if detail ~= "" then detail else nil,
		promptText = if promptText ~= "" then promptText else nil,
		promptIcon = if promptIcon ~= "" then promptIcon else nil,
		enabled = sanitizeBoolean(entry.enabled, true),
		priority = sanitizeInteger(entry.priority, index),
	}
end

local function cloneHintEntry(entry: BindingHintEntry): BindingHintEntry
	return {
		id = entry.id,
		actionName = entry.actionName,
		label = entry.label,
		detail = entry.detail,
		promptText = entry.promptText,
		promptIcon = entry.promptIcon,
		enabled = entry.enabled,
		priority = entry.priority,
	}
end

local function cloneHints(hintsRaw: any): { BindingHintEntry }
	local output: { BindingHintEntry } = {}
	local seenIds: { [string]: boolean } = {}
	if typeof(hintsRaw) ~= "table" then
		return output
	end

	for index, hintRaw in hintsRaw do
		local hint = sanitizeHintEntry(hintRaw, index)
		if hint == nil or seenIds[hint.id] == true then
			continue
		end
		seenIds[hint.id] = true
		output[#output + 1] = hint
	end

	table.sort(output, function(lhs: BindingHintEntry, rhs: BindingHintEntry): boolean
		if lhs.priority == rhs.priority then
			if lhs.enabled ~= rhs.enabled then
				return lhs.enabled
			end
			if lhs.label ~= rhs.label then
				return lhs.label < rhs.label
			end
			return lhs.id < rhs.id
		end
		return lhs.priority < rhs.priority
	end)

	return output
end

local function cloneState(state: BindingHintState): BindingHintState
	local hints: { BindingHintEntry } = {}
	for index, hint in state.hints do
		hints[index] = cloneHintEntry(hint)
	end

	return {
		started = state.started,
		visible = state.visible,
		platform = state.platform,
		deviceClass = state.deviceClass,
		hints = hints,
		updatedAt = state.updatedAt,
	}
end

local function hintsEqual(lhs: { BindingHintEntry }, rhs: { BindingHintEntry }): boolean
	if #lhs ~= #rhs then
		return false
	end

	for index = 1, #lhs do
		local a = lhs[index]
		local b = rhs[index]
		if a == nil or b == nil then
			return false
		end
		if
			a.id ~= b.id
			or a.actionName ~= b.actionName
			or a.label ~= b.label
			or a.detail ~= b.detail
			or a.promptText ~= b.promptText
			or a.promptIcon ~= b.promptIcon
			or a.enabled ~= b.enabled
			or a.priority ~= b.priority
		then
			return false
		end
	end

	return true
end

local function statesEqual(lhs: BindingHintState, rhs: BindingHintState): boolean
	return lhs.started == rhs.started
		and lhs.visible == rhs.visible
		and lhs.platform == rhs.platform
		and lhs.deviceClass == rhs.deviceClass
		and hintsEqual(lhs.hints, rhs.hints)
end

local function getBindingState(): BindingHintState
	return bindingStateAtom()
end

local function setBindingState(stateRaw: any): BindingHintState
	local current = bindingStateAtom()
	local source = if typeof(stateRaw) == "table" then stateRaw :: { [string]: any } else {}
	local nextHints = if source.hints ~= nil then cloneHints(source.hints) else cloneHints(current.hints)

	local nextState: BindingHintState = {
		started = sanitizeBoolean(source.started, current.started),
		visible = if source.visible == nil then (#nextHints > 0) else sanitizeBoolean(source.visible, current.visible),
		platform = if trim(source.platform) ~= "" then trim(source.platform) else current.platform,
		deviceClass = if trim(source.deviceClass) ~= "" then trim(source.deviceClass) else current.deviceClass,
		hints = nextHints,
		updatedAt = os.clock(),
	}

	if statesEqual(current, nextState) then
		return current
	end

	bindingStateAtom(nextState)
	return nextState
end

local function resetBindingState(): BindingHintState
	local nextState = cloneState(DEFAULT_STATE)
	nextState.updatedAt = os.clock()
	bindingStateAtom(nextState)
	return nextState
end

return {
	bindingStateAtom = bindingStateAtom,
	getBindingState = getBindingState,
	setBindingState = setBindingState,
	resetBindingState = resetBindingState,
}
]]></string>
                    </Properties>
                  </Item>
                  <Item class="ModuleScript" referent="840">
                    <Properties>
                      <string name="Name">bindingThunks</string>
                      <string name="Source"><![CDATA[--!strict
local RunService = game:GetService("RunService")

local BuildServiceClient = require(script:FindFirstAncestor("game").Client.Services.BuildServiceClient)
local BuildServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.BuildServiceUtils)
local ConnectionUtils = require(script:FindFirstAncestor("game").Client.UI.core.utils.ConnectionUtils)
local InventoryServiceClient = require(script:FindFirstAncestor("game").Client.Services.InventoryServiceClient)
local InventoryServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.InventoryServiceUtils)
local ItemRegistry = require(script:FindFirstAncestor("game").Shared.Modules.Items.Registry)
local MagicServiceClient = require(script:FindFirstAncestor("game").Client.Services.MagicServiceClient)
local MagicServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.MagicServiceUtils)
local MeleeServiceClient = require(script:FindFirstAncestor("game").Client.Services.MeleeServiceClient)
local MiningPower = require(script:FindFirstAncestor("game").Shared.Modules.Math.MiningPower)
local PlatformServiceClient = require(script:FindFirstAncestor("game").Client.Services.PlatformServiceClient)
local PlayerServiceClient = require(script:FindFirstAncestor("game").Client.Services.PlayerServiceClient)
local ServiceSync = require(script:FindFirstAncestor("game").Client.UI.core.utils.ServiceSync)
local bindingSlice = require(script:FindFirstAncestor("game").Client.UI.features.binding.state.bindingSlice)
local itemThunks = require(script:FindFirstAncestor("game").Client.UI.features.item.state.itemThunks)

type BindingHintEntry = bindingSlice.BindingHintEntry
type BindingHintState = bindingSlice.BindingHintState
type InventoryState = InventoryServiceUtils.InventoryState

type HintDescriptor = {
	id: string,
	actionName: string,
	label: string,
	detail: string?,
	enabled: boolean,
	priority: number,
}

type PromptData = {
	text: string?,
	icon: string?,
	keyCode: Enum.KeyCode?,
	inputType: Enum.UserInputType?,
}

type PlatformSnapshot = {
	platform: string,
	deviceClass: string,
}

local bindingThunks = {}

local REFRESH_INTERVAL_SECONDS = 0.05

local runtime = {
	started = false,
	lastRefreshAt = -math.huge,
	renderConnection = nil :: RBXScriptConnection?,
	inventoryStateChangedConnection = nil :: RBXScriptConnection?,
	buildStateChangedConnection = nil :: RBXScriptConnection?,
	buildBreakProgressConnection = nil :: RBXScriptConnection?,
	magicStateChangedConnection = nil :: RBXScriptConnection?,
	platformDisconnect = nil :: (() -> ())?,
}

local function trim(textRaw: any): string
	if typeof(textRaw) ~= "string" then
		return ""
	end
	return string.match(textRaw, "^%s*(.-)%s*$") or ""
end

local function readPlatformSnapshot(): PlatformSnapshot
	local fallback: PlatformSnapshot = {
		platform = "KeyboardMouse",
		deviceClass = "Desktop",
	}

	if not PlatformServiceClient:isReady() then
		return fallback
	end

	local ok, stateOrError = pcall(function()
		return PlatformServiceClient:getState()
	end)
	if not ok or typeof(stateOrError) ~= "table" then
		return fallback
	end

	local state = stateOrError :: { [string]: any }
	local platform = trim(state.platform)
	local deviceClass = trim(state.deviceClass)
	return {
		platform = if platform ~= "" then platform else fallback.platform,
		deviceClass = if deviceClass ~= "" then deviceClass else fallback.deviceClass,
	}
end

local function readInventoryState(): InventoryState
	local fallback = InventoryServiceUtils.createDefaultState(InventoryServiceUtils.LOAD_STATE_UNLOADED)
	local ok, stateOrError = pcall(function()
		return InventoryServiceClient:getState()
	end)
	if ok then
		return InventoryServiceUtils.sanitizeState(stateOrError, fallback)
	end
	return InventoryServiceUtils.sanitizeState(InventoryServiceClient.state, fallback)
end

local function readMagicState(): MagicServiceUtils.ReplicatedState
	local fallback = MagicServiceUtils.sanitizeReplicatedState(nil, {
		mana = MagicServiceUtils.DEFAULT_MAX_MANA,
		maxMana = MagicServiceUtils.DEFAULT_MAX_MANA,
		regenPerSecond = MagicServiceUtils.DEFAULT_MANA_REGEN,
		equippedWeaponId = nil,
		equippedSlot = nil,
		cooldowns = {},
		updatedAt = os.clock(),
	})
	local ok, stateOrError = pcall(function()
		return MagicServiceClient:getState()
	end)
	if ok then
		return MagicServiceUtils.sanitizeReplicatedState(stateOrError, fallback)
	end
	return MagicServiceUtils.sanitizeReplicatedState(MagicServiceClient.state, fallback)
end

local function getMeleeServiceClient(): any
	if typeof(MeleeServiceClient) ~= "table" then
		return nil
	end

	return MeleeServiceClient
end

local function readSelectedStack(inventoryState: InventoryState): InventoryServiceUtils.InventoryItemStack?
	local selectedSlot = inventoryState.selectedSlot
	if selectedSlot == nil then
		return nil
	end
	return InventoryServiceUtils.getStack(inventoryState, selectedSlot)
end

local function resolveDisplayNameFromStack(stackRaw: any, fallbackRaw: any?): string
	local fallback = trim(fallbackRaw)
	if typeof(stackRaw) == "table" then
		local ok, displayNameOrError = pcall(function()
			return itemThunks.resolveDisplayNameForStack(stackRaw)
		end)
		if ok and typeof(displayNameOrError) == "string" and trim(displayNameOrError) ~= "" then
			return trim(displayNameOrError)
		end
	end
	if fallback ~= "" then
		return fallback
	end
	return "Action"
end

local function resolveDeployableItemId(stackRaw: any): string?
	if typeof(stackRaw) ~= "table" then
		return nil
	end
	local itemId = ItemRegistry.resolveCanonicalItemId((stackRaw :: { [string]: any }).itemId)
	if itemId == nil then
		return nil
	end
	local definition = ItemRegistry.resolveDefinition(itemId)
	if typeof(definition) ~= "table" then
		return nil
	end
	local deployable = (definition :: { [string]: any }).deployable
	if typeof(deployable) ~= "table" then
		return nil
	end
	local stationTag = trim((deployable :: { [string]: any }).stationTag)
	if stationTag == "" then
		return nil
	end
	return itemId
end

local function resolvePromptData(actionName: string): PromptData
	local ok, promptOrError = pcall(function()
		return PlatformServiceClient:getPromptForAction(actionName)
	end)
	if not ok or typeof(promptOrError) ~= "table" then
		return {
			text = nil,
			icon = nil,
			keyCode = nil,
			inputType = nil,
		}
	end

	local prompt = promptOrError :: { [string]: any }
	local promptText = trim(prompt.text)
	local promptIcon = trim(prompt.icon)
	return {
		text = if promptText ~= "" then promptText else nil,
		icon = if promptIcon ~= "" then promptIcon else nil,
		keyCode = if typeof(prompt.keyCode) == "EnumItem" then prompt.keyCode else nil,
		inputType = if typeof(prompt.inputType) == "EnumItem" then prompt.inputType else nil,
	}
end

local function isMousePrompt(promptData: PromptData): boolean
	if
		promptData.keyCode == Enum.KeyCode.MouseLeftButton
		or promptData.keyCode == Enum.KeyCode.MouseRightButton
		or promptData.keyCode == Enum.KeyCode.MouseMiddleButton
	then
		return true
	end

	return promptData.inputType == Enum.UserInputType.MouseButton1
		or promptData.inputType == Enum.UserInputType.MouseButton2
		or promptData.inputType == Enum.UserInputType.MouseButton3
end

local function shouldKeepMousePromptDetail(descriptor: HintDescriptor): boolean
	return descriptor.id == "build_break_tree" or descriptor.id == "build_break_tile"
end

local function findExistingHintIndexForPrompt(hints: { BindingHintEntry }, promptData: PromptData): number?
	for index, hint in hints do
		if hint.promptText == promptData.text and hint.promptIcon == promptData.icon then
			return index
		end
	end

	return nil
end

local function pushHint(hints: { BindingHintEntry }, descriptor: HintDescriptor): boolean
	local promptData = resolvePromptData(descriptor.actionName)
	if promptData.text == nil and promptData.icon == nil then
		return false
	end

	local label = descriptor.label
	local detail = descriptor.detail
	if isMousePrompt(promptData) then
		label = "Use"
		if not shouldKeepMousePromptDetail(descriptor) then
			detail = nil
		end
	end

	local existingHintIndex = findExistingHintIndexForPrompt(hints, promptData)
	if existingHintIndex ~= nil then
		local existingHint = hints[existingHintIndex]
		if existingHint ~= nil and existingHint.priority <= descriptor.priority then
			return false
		end

		table.remove(hints, existingHintIndex)
	end

	hints[#hints + 1] = {
		id = descriptor.id,
		actionName = descriptor.actionName,
		label = label,
		detail = detail,
		promptText = promptData.text,
		promptIcon = promptData.icon,
		enabled = descriptor.enabled,
		priority = descriptor.priority,
	}
	return true
end

local function formatPlaceFailureReason(reasonRaw: any): string
	local reason = trim(reasonRaw)
	if reason == "missing_support" then
		return "Need Support"
	end
	if reason == "occupied" then
		return "Blocked"
	end
	if reason == "tile_out_of_bounds" then
		return "Out of Bounds"
	end
	if reason == "invalid_tile_coordinate_or_id" then
		return "No Target"
	end
	return "Cannot Place"
end

local function formatTileBreakFailureReason(reasonRaw: any): string?
	local reason = trim(reasonRaw)
	if reason == "tile_requires_pickaxe" then
		return nil
	end
	if reason == "insufficient_pickaxe_power" then
		return nil
	end
	if reason == "air" then
		return "no target"
	end
	return "cannot mine"
end

local function formatTreeBreakFailureReason(reasonRaw: any): string?
	local reason = trim(reasonRaw)
	if reason == "tree_requires_axe" then
		return nil
	end
	if reason == "insufficient_axe_power" then
		return nil
	end
	return "cannot chop"
end

local function resolveMiningToolContext(inventoryState: InventoryState)
	local ok, toolContextOrError = pcall(function()
		return MiningPower.resolveSelectedToolContextFromInventoryState(inventoryState)
	end)
	if ok and typeof(toolContextOrError) == "table" then
		return toolContextOrError :: { [string]: any }
	end
	return nil
end

local function tryBuildPlaceHint(hints: { BindingHintEntry }, selectedStack: any): boolean
	local ok, activePlaceSourceOrError = pcall(function()
		return BuildServiceClient:resolveActivePlaceSource()
	end)
	if not ok or typeof(activePlaceSourceOrError) ~= "table" then
		return false
	end

	local activePlaceSource = activePlaceSourceOrError :: { [string]: any }
	local config = activePlaceSource.config
	if typeof(config) ~= "table" then
		return false
	end

	local itemName = resolveDisplayNameFromStack(selectedStack, config.itemId)
	local cursorTileX = BuildServiceClient.cursorTileX
	local cursorTileY = BuildServiceClient.cursorTileY
	local canPlace = false
	local detail = "No Target"
	if typeof(cursorTileX) == "number" and typeof(cursorTileY) == "number" then
		local placeOk, canPlaceOrError, reasonOrError = pcall(function()
			return BuildServiceClient:canPlaceAt(cursorTileX, cursorTileY, config.tileId)
		end)
		if placeOk then
			canPlace = canPlaceOrError == true
			detail = if canPlace then "" else formatPlaceFailureReason(reasonOrError)
		else
			detail = "Cannot Place"
		end
	end

	return pushHint(hints, {
		id = "build_place",
		actionName = PlatformServiceClient.ACTIONS.BUILD_PRIMARY,
		label = ("Place %s"):format(itemName),
		detail = if canPlace then nil else detail,
		enabled = canPlace,
		priority = 100,
	})
end

local function tryBuildDeployableHint(hints: { BindingHintEntry }, selectedStack: any): boolean
	local deployableItemId = resolveDeployableItemId(selectedStack)
	if deployableItemId == nil then
		return false
	end

	local cursorTileX = BuildServiceClient.cursorTileX
	local cursorTileY = BuildServiceClient.cursorTileY
	local canPlace = typeof(cursorTileX) == "number" and typeof(cursorTileY) == "number"
	return pushHint(hints, {
		id = "inventory_place_deployable",
		actionName = PlatformServiceClient.ACTIONS.PLACE_DEPLOYABLE,
		label = ("Place %s"):format(resolveDisplayNameFromStack(selectedStack, deployableItemId)),
		detail = if canPlace then nil else "No Target",
		enabled = canPlace,
		priority = 110,
	})
end

local function tryBuildBreakHint(hints: { BindingHintEntry }, inventoryState: InventoryState): boolean
	local cursorTileX = BuildServiceClient.cursorTileX
	local cursorTileY = BuildServiceClient.cursorTileY
	if typeof(cursorTileX) ~= "number" or typeof(cursorTileY) ~= "number" then
		return false
	end

	local isBreakable = false
	local breakableOk, breakableOrError = pcall(function()
		return BuildServiceClient:isBreakableTarget(cursorTileX, cursorTileY)
	end)
	if breakableOk then
		isBreakable = breakableOrError == true
	end
	if not isBreakable then
		return false
	end

	local toolContext = resolveMiningToolContext(inventoryState)
	local toolType = if toolContext ~= nil then toolContext.toolType else nil
	local toolPower = if toolContext ~= nil then toolContext.toolPower else 0

	local treeOk, treeOrError = pcall(function()
		return BuildServiceClient:resolveTreeHitAtTile(cursorTileX, cursorTileY)
	end)
	local treeHit = if treeOk and typeof(treeOrError) == "table" then treeOrError else nil
	if treeHit ~= nil then
		local canBreak, reason = BuildServiceUtils.canBreakTree(treeHit, toolType, toolPower)
		return pushHint(hints, {
			id = "build_break_tree",
			actionName = PlatformServiceClient.ACTIONS.BUILD_PRIMARY,
			label = "Chop Tree",
			detail = if canBreak then nil else formatTreeBreakFailureReason(reason),
			enabled = canBreak,
			priority = 120,
		})
	end

	local tileId = BuildServiceUtils.AIR_TILE_ID
	local tileOk, tileOrError = pcall(function()
		return BuildServiceClient:getTileAt(cursorTileX, cursorTileY, false)
	end)
	if tileOk and typeof(tileOrError) == "number" then
		tileId = tileOrError
	end
	if tileId == BuildServiceUtils.AIR_TILE_ID then
		return false
	end

	local tileRule = BuildServiceUtils.getTileRule(tileId)
	local canBreak, reason = BuildServiceUtils.canBreakTile(tileId, toolType, toolPower)
	return pushHint(hints, {
		id = "build_break_tile",
		actionName = PlatformServiceClient.ACTIONS.BUILD_PRIMARY,
		label = ("Mine %s"):format(trim(tileRule.name) ~= "" and tileRule.name or "Block"),
		detail = if canBreak then nil else formatTileBreakFailureReason(reason),
		enabled = canBreak,
		priority = 120,
	})
end

local function appendBuildHints(
	hints: { BindingHintEntry },
	inventoryState: InventoryState,
	selectedStack: any
): string?
	if tryBuildPlaceHint(hints, selectedStack) then
		return "Place"
	end
	if tryBuildDeployableHint(hints, selectedStack) then
		return "Deployable"
	end
	if tryBuildBreakHint(hints, inventoryState) then
		return "Break"
	end
	return nil
end

local function appendMeleeHint(hints: { BindingHintEntry }, contextualBuildKind: string?)
	local meleeServiceClient = getMeleeServiceClient()
	if meleeServiceClient == nil then
		return
	end

	local weaponConfig = meleeServiceClient.equippedWeaponConfig
	if typeof(weaponConfig) ~= "table" then
		return
	end

	local usingHarvestTool = false
	local axeOk, isAxe = pcall(function()
		return meleeServiceClient:isEquippedAxe()
	end)
	local pickaxeOk, isPickaxe = pcall(function()
		return meleeServiceClient:isEquippedPickaxe()
	end)
	if axeOk and isAxe == true then
		usingHarvestTool = true
	end
	if pickaxeOk and isPickaxe == true then
		usingHarvestTool = true
	end

	if contextualBuildKind ~= nil and usingHarvestTool then
		return
	end

	local blocked = true
	local blockedOk, blockedOrError = pcall(function()
		return meleeServiceClient:isAttackBlocked()
	end)
	if blockedOk then
		blocked = blockedOrError == true
	end

	pushHint(hints, {
		id = "melee_attack",
		actionName = PlatformServiceClient.ACTIONS.MELEE_ATTACK,
		label = "Attack",
		detail = if blocked then "Unavailable" else nil,
		enabled = not blocked,
		priority = 200,
	})
end

local function resolveMagicWeaponConfig(): MagicServiceUtils.WeaponRuntimeConfig?
	local equippedTool = MagicServiceClient.equippedTool
	if typeof(equippedTool) ~= "Instance" then
		return nil
	end

	local ok, configOrError = pcall(function()
		return MagicServiceUtils.buildWeaponRuntimeConfig(equippedTool)
	end)
	if ok and typeof(configOrError) == "table" then
		return configOrError :: MagicServiceUtils.WeaponRuntimeConfig
	end
	return nil
end

local function appendMagicHint(hints: { BindingHintEntry })
	local config = resolveMagicWeaponConfig()
	if config == nil then
		return
	end

	local magicState = readMagicState()
	local equippedWeaponId = trim(config.itemId)
	local cooldowns = magicState.cooldowns
	local cooldownRemaining = 0
	if equippedWeaponId ~= "" then
		cooldownRemaining = math.max(cooldowns[equippedWeaponId] or 0, cooldowns[string.lower(equippedWeaponId)] or 0)
	end

	local enabled = true
	local detail = nil :: string?
	if cooldownRemaining > 0.05 then
		enabled = false
		detail = string.format("%.1fs Cooldown", cooldownRemaining)
	elseif magicState.mana < config.manaCost then
		enabled = false
		detail = ("Need %d Mana"):format(math.ceil(config.manaCost))
	end

	pushHint(hints, {
		id = "magic_cast",
		actionName = PlatformServiceClient.ACTIONS.MAGIC_CAST,
		label = "Cast",
		detail = detail,
		enabled = enabled,
		priority = 210,
	})
end

local function appendJumpHint(hints: { BindingHintEntry })
	if PlayerServiceClient.movementLocked == true then
		return
	end

	if PlayerServiceClient.flyEnabled == true then
		return
	end

	pushHint(hints, {
		id = "jump",
		actionName = PlatformServiceClient.ACTIONS.JUMP,
		label = "Jump",
		detail = nil,
		enabled = true,
		priority = 305,
	})
end

local function appendInventoryHint(hints: { BindingHintEntry })
	pushHint(hints, {
		id = "open_inventory",
		actionName = PlatformServiceClient.ACTIONS.OPEN_INVENTORY,
		label = "Inventory",
		detail = nil,
		enabled = true,
		priority = 300,
	})
end

local function computeBindingState(): BindingHintState
	local platformSnapshot = readPlatformSnapshot()
	local inventoryState = readInventoryState()
	local selectedStack = readSelectedStack(inventoryState)
	local hints: { BindingHintEntry } = {}

	local contextualBuildKind = appendBuildHints(hints, inventoryState, selectedStack)
	appendMeleeHint(hints, contextualBuildKind)
	appendMagicHint(hints)
	appendInventoryHint(hints)
	appendJumpHint(hints)

	return bindingSlice.setBindingState({
		started = true,
		visible = #hints > 0,
		platform = platformSnapshot.platform,
		deviceClass = platformSnapshot.deviceClass,
		hints = hints,
	})
end

local function refreshBindingHints(forceRaw: any?)
	local force = forceRaw == true
	local now = os.clock()
	if not force and now - runtime.lastRefreshAt < REFRESH_INTERVAL_SECONDS then
		return
	end
	runtime.lastRefreshAt = now
	computeBindingState()
end

function bindingThunks.Start(): () -> ()
	if runtime.started then
		return bindingThunks.Stop
	end

	runtime.started = true
	runtime.lastRefreshAt = -math.huge

	if not PlatformServiceClient:isReady() then
		PlatformServiceClient:init()
	end

	runtime.inventoryStateChangedConnection = ServiceSync.connectStateChanged(InventoryServiceClient, function()
		refreshBindingHints(true)
	end)
	runtime.buildStateChangedConnection = ServiceSync.connectStateChanged(BuildServiceClient, function()
		refreshBindingHints(true)
	end)
	runtime.magicStateChangedConnection = ServiceSync.connectStateChanged(MagicServiceClient, function()
		refreshBindingHints(true)
	end)

	local breakProgressSignal = (BuildServiceClient :: any).breakProgressChanged
	if breakProgressSignal ~= nil then
		runtime.buildBreakProgressConnection = breakProgressSignal:Connect(function()
			refreshBindingHints(true)
		end)
	end

	runtime.platformDisconnect = PlatformServiceClient:onPlatformChanged(function()
		refreshBindingHints(true)
	end)

	runtime.renderConnection = RunService.RenderStepped:Connect(function()
		refreshBindingHints(false)
	end)

	ServiceSync.requestSyncMany({
		PlatformServiceClient,
		InventoryServiceClient,
		BuildServiceClient,
		MagicServiceClient,
	})
	refreshBindingHints(true)

	return bindingThunks.Stop
end

function bindingThunks.Stop()
	ConnectionUtils.disconnectMany({
		runtime.renderConnection,
		runtime.inventoryStateChangedConnection,
		runtime.buildStateChangedConnection,
		runtime.buildBreakProgressConnection,
		runtime.magicStateChangedConnection,
	})
	ConnectionUtils.call(runtime.platformDisconnect)

	runtime.started = false
	runtime.lastRefreshAt = -math.huge
	runtime.renderConnection = nil
	runtime.inventoryStateChangedConnection = nil
	runtime.buildStateChangedConnection = nil
	runtime.buildBreakProgressConnection = nil
	runtime.magicStateChangedConnection = nil
	runtime.platformDisconnect = nil
	bindingSlice.resetBindingState()
end

function bindingThunks.Refresh(): BindingHintState
	return computeBindingState()
end

function bindingThunks.GetState(): BindingHintState
	return bindingSlice.getBindingState()
end

bindingThunks.start = bindingThunks.Start
bindingThunks.stop = bindingThunks.Stop
bindingThunks.refresh = bindingThunks.Refresh
bindingThunks.getState = bindingThunks.GetState

return bindingThunks
]]></string>
