                <Properties>
                  <string name="Name">ObjectPool</string>
                  <string name="Source"><![CDATA[--!strict

local ObjectPool = {}
ObjectPool.__index = ObjectPool

export type Factory<T> = () -> T
export type Resetter<T> = (value: T) -> ()
export type Destroyer<T> = (value: T) -> ()

export type PoolConfig<T> = {
	prewarm: number?,
	expandBy: number?,
	maxAvailable: number?,
	minAvailable: number?,
	reset: Resetter<T>?,
	destroy: Destroyer<T>?,
}

export type ObjectPool<T> = typeof(setmetatable({} :: any, ObjectPool))

local function clampInteger(valueRaw: any, fallback: number, minValue: number, maxValue: number): number
	local value = if typeof(valueRaw) == "number" then math.floor(valueRaw) else fallback
	if value < minValue then
		return minValue
	end
	if value > maxValue then
		return maxValue
	end
	return value
end

local function clearDenseArray(array: { any })
	for index = #array, 1, -1 do
		array[index] = nil
	end
end

function ObjectPool.new<T>(factory: Factory<T>, configRaw: PoolConfig<T>?): ObjectPool<T>
	if typeof(factory) ~= "function" then
		error("ObjectPool.new expects a factory callback")
	end
	local config = if typeof(configRaw) == "table" then configRaw else {}
	local prewarmCount = clampInteger(config.prewarm, 0, 0, 1000000)
	local expandBy = clampInteger(config.expandBy, 8, 1, 100000)
	local maxAvailable = clampInteger(config.maxAvailable, 2048, 1, 10000000)
	local minAvailable = clampInteger(config.minAvailable, 0, 0, maxAvailable)

	local self = setmetatable({
		factory = factory,
		reset = config.reset,
		destroyer = config.destroy,
		expandBy = expandBy,
		maxAvailable = maxAvailable,
		minAvailable = minAvailable,
		available = {} :: { T },
		inUse = {} :: { [T]: true },
		inUseCount = 0,
		totalCreated = 0,
		totalAcquired = 0,
		totalReleased = 0,
		totalDestroyed = 0,
	}, ObjectPool)

	self:prewarm(prewarmCount)
	return self
end

function ObjectPool._create(self: ObjectPool<any>): any
	local value = self.factory()
	self.totalCreated += 1
	return value
end

function ObjectPool.Prewarm(self: ObjectPool<any>, countRaw: any)
	local count = clampInteger(countRaw, 0, 0, self.maxAvailable - #self.available)
	for _ = 1, count do
		self.available[#self.available + 1] = self:_create()
	end
end

function ObjectPool.Acquire(self: ObjectPool<any>): any
	self.totalAcquired += 1
	if #self.available == 0 then
		local createCount = math.max(1, self.expandBy)
		for index = 1, createCount do
			local created = self:_create()
			if index == 1 then
				self.inUse[created] = true
				self.inUseCount += 1
				return created
			end
			if #self.available < self.maxAvailable then
				self.available[#self.available + 1] = created
			else
				if self.destroyer ~= nil then
					self.destroyer(created)
				end
				self.totalDestroyed += 1
			end
		end
	end

	local index = #self.available
	local value = self.available[index]
	self.available[index] = nil
	self.inUse[value] = true
	self.inUseCount += 1
	return value
end

function ObjectPool.Release(self: ObjectPool<any>, value: any)
	if value == nil then
		return
	end
	if self.inUse[value] == nil then
		return
	end

	self.inUse[value] = nil
	if self.inUseCount > 0 then
		self.inUseCount -= 1
	end
	self.totalReleased += 1

	if self.reset ~= nil then
		self.reset(value)
	end

	if #self.available >= self.maxAvailable then
		if self.destroyer ~= nil then
			self.destroyer(value)
		end
		self.totalDestroyed += 1
		return
	end

	self.available[#self.available + 1] = value
end

function ObjectPool.SoftShrink(self: ObjectPool<any>, maxRemovalsRaw: any): number
	local targetAvailable = self.minAvailable
	if #self.available <= targetAvailable then
		return 0
	end

	local maxRemovals = clampInteger(maxRemovalsRaw, #self.available - targetAvailable, 0, #self.available)
	local removed = 0
	while removed < maxRemovals and #self.available > targetAvailable do
		local index = #self.available
		local value = self.available[index]
		self.available[index] = nil
		if self.destroyer ~= nil then
			self.destroyer(value)
		end
		self.totalDestroyed += 1
		removed += 1
	end
	return removed
end

function ObjectPool.Clear(self: ObjectPool<any>, destroyInUseRaw: any?)
	local destroyInUse = destroyInUseRaw == true
	for index = #self.available, 1, -1 do
		local value = self.available[index]
		if self.destroyer ~= nil then
			self.destroyer(value)
		end
		self.totalDestroyed += 1
		self.available[index] = nil
	end

	if destroyInUse then
		for value in self.inUse do
			if self.destroyer ~= nil then
				self.destroyer(value)
			end
			self.totalDestroyed += 1
		end
		table.clear(self.inUse)
		self.inUseCount = 0
	end
end

function ObjectPool.Destroy(self: ObjectPool<any>)
	self:clear(true)
	clearDenseArray(self.available)
	table.clear(self.inUse)
end

function ObjectPool.GetStats(self: ObjectPool<any>): { [string]: number }
	return {
		available = #self.available,
		inUse = self.inUseCount,
		totalCreated = self.totalCreated,
		totalAcquired = self.totalAcquired,
		totalReleased = self.totalReleased,
		totalDestroyed = self.totalDestroyed,
	}
end

ObjectPool.prewarm = ObjectPool.Prewarm
ObjectPool.acquire = ObjectPool.Acquire
ObjectPool.release = ObjectPool.Release
ObjectPool.softShrink = ObjectPool.SoftShrink
ObjectPool.clear = ObjectPool.Clear
ObjectPool.destroy = ObjectPool.Destroy
ObjectPool.getStats = ObjectPool.GetStats

return ObjectPool
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="1185">
                <Properties>
                  <string name="Name">Runtime</string>
                  <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Sift = require(ReplicatedStorage.Packages.Sift)


local RunService = game:GetService("RunService")

local EventBus = require(script.Parent.EventBus)
local TickScheduler = require(script.Parent.TickScheduler)

local Runtime = {}
Runtime.__index = Runtime

export type RuntimeContext = typeof(setmetatable({} :: any, Runtime))

type RuntimeConfig = {
	eventBus: any?,
	tickScheduler: any?,
	fixedStep: number?,
	platform: any?,
	input: any?,
	gestures: any?,
	haptics: any?,
	cursor: any?,
	perfTier: any?,
	gamepadNav: any?,
	hudScaler: any?,
}

local function clampNumber(valueRaw: any, fallback: number, minValue: number, maxValue: number): number
	local value = if typeof(valueRaw) == "number" then valueRaw else fallback
	if value < minValue then
		return minValue
	end
	if value > maxValue then
		return maxValue
	end
	return value
end

local function safeInit(value: any?)
	if value == nil then
		return
	end
	if typeof(value.init) == "function" then
		pcall(function()
			value:init()
		end)
	end
end

local function safeDestroy(value: any?)
	if value == nil then
		return
	end
	if typeof(value.destroy) == "function" then
		pcall(function()
			value:destroy()
		end)
	end
end

local singletonClient: RuntimeContext? = nil
local singletonServer: RuntimeContext? = nil

local function buildClientModules(self: RuntimeContext, config: RuntimeConfig)
	local platformFolder = script.Parent.Parent.Platform
	local Platform = require(platformFolder.Platform)
	local Input = require(platformFolder.Input)
	local Gestures = require(platformFolder.Gestures)
	local Haptics = require(platformFolder.Haptics)
	local Cursor = require(platformFolder.Cursor)
	local PerfTier = require(platformFolder.PerfTier)

	self.platform = if config.platform ~= nil
		then config.platform
		else Platform.new({
			eventBus = self.eventBus,
			eventChannel = "platform",
			changeEvent = "changed",
		})
	self.input = if config.input ~= nil
		then config.input
		else Input.new({
			eventBus = self.eventBus,
			eventChannel = "input",
			actionEvent = "action",
			tickScheduler = self.tickScheduler,
		})
	self.gestures = if config.gestures ~= nil
		then config.gestures
		else Gestures.new({
			eventBus = self.eventBus,
			eventChannel = "gestures",
			tickScheduler = self.tickScheduler,
		})
	self.haptics = if config.haptics ~= nil
		then config.haptics
		else Haptics.new({
			eventBus = self.eventBus,
			eventChannel = "haptics",
			tickScheduler = self.tickScheduler,
			enabled = true,
		})
	self.cursor = if config.cursor ~= nil
		then config.cursor
		else Cursor.new({
			input = self.input,
			eventBus = self.eventBus,
			eventChannel = "cursor",
			changeEvent = "changed",
			tickScheduler = self.tickScheduler,
			useCustomIcon = true,
		})
	self.perfTier = if config.perfTier ~= nil
		then config.perfTier
		else PerfTier.new({
			eventBus = self.eventBus,
			eventChannel = "perf",
			changeEvent = "tierChanged",
			tickScheduler = self.tickScheduler,
		})

	self.gamepadNav = config.gamepadNav
	self.hudScaler = config.hudScaler
end

function Runtime.New(configRaw: RuntimeConfig?): RuntimeContext
	local config = if typeof(configRaw) == "table" then configRaw else {}
	local self = setmetatable({
		isClient = RunService:IsClient(),
		eventBus = if config.eventBus ~= nil then config.eventBus else EventBus.new(),
		tickScheduler = if config.tickScheduler ~= nil
			then config.tickScheduler
			else TickScheduler.new({
				fixedStep = clampNumber(config.fixedStep, 1 / 60, 1 / 240, 1),
			}),
		platform = nil,
		input = nil,
		gestures = nil,
		haptics = nil,
		cursor = nil,
		perfTier = nil,
		gamepadNav = config.gamepadNav,
		hudScaler = config.hudScaler,
		heartbeatConnection = nil :: RBXScriptConnection?,
		isInitialized = false,
	}, Runtime)

	if self.isClient then
		buildClientModules(self, config)
	end

	return self
end

function Runtime._ensureHeartbeat(self: RuntimeContext)
	if self.heartbeatConnection ~= nil then
		return
	end
	self.heartbeatConnection = RunService.Heartbeat:Connect(function(dt: number)
		local scheduler = self.tickScheduler
		if scheduler ~= nil and typeof((scheduler :: any).update) == "function" then
			local schedulerAny = scheduler :: any
			schedulerAny:update(dt)
		end
	end)
end

function Runtime.Init(self: RuntimeContext): RuntimeContext
	if self.isInitialized then
		return self
	end
	self.isInitialized = true
	self:_ensureHeartbeat()
	safeInit(self.platform)
	safeInit(self.input)
	safeInit(self.gestures)
	safeInit(self.haptics)
	safeInit(self.cursor)
	safeInit(self.perfTier)
	safeInit(self.gamepadNav)
	safeInit(self.hudScaler)
	return self
end

function Runtime.GetGamepadNav(self: RuntimeContext, configRaw: any?): any
	if self.gamepadNav ~= nil then
		return self.gamepadNav
	end
	if not self.isClient then
		return nil
	end
	local GamepadNav = require(script.Parent.Parent.Platform.GamepadNav)
	self.gamepadNav = GamepadNav.new(if typeof(configRaw) == "table"
		then configRaw
		else {
			eventBus = self.eventBus,
			eventChannel = "gamepad.nav",
			focusEvent = "focusChanged",
		})
	if self.isInitialized then
		safeInit(self.gamepadNav)
	end
	return self.gamepadNav
end

function Runtime.GetHUDScaler(self: RuntimeContext, configRaw: any?): any
	if self.hudScaler ~= nil then
		return self.hudScaler
	end
	if not self.isClient then
		return nil
	end
	local HUDScaler = require(script.Parent.Parent.Platform.HUDScaler)
	local config = if typeof(configRaw) == "table" then Sift.Dictionary.copy(configRaw) else {}
	if config.platform == nil then
		config.platform = self.platform
	end
	if config.eventBus == nil then
		config.eventBus = self.eventBus
	end
	self.hudScaler = HUDScaler.new(config)
	if self.isInitialized then
		safeInit(self.hudScaler)
	end
	return self.hudScaler
end

function Runtime.GetEventBus(self: RuntimeContext): any
	return self.eventBus
end

function Runtime.GetTickScheduler(self: RuntimeContext): any
	return self.tickScheduler
end

function Runtime.Destroy(self: RuntimeContext)
	if self.heartbeatConnection ~= nil then
		self.heartbeatConnection:Disconnect()
		self.heartbeatConnection = nil
	end
	safeDestroy(self.hudScaler)
	safeDestroy(self.gamepadNav)
	safeDestroy(self.perfTier)
	safeDestroy(self.cursor)
	safeDestroy(self.haptics)
	safeDestroy(self.gestures)
	safeDestroy(self.input)
	safeDestroy(self.platform)
	safeDestroy(self.tickScheduler)
	safeDestroy(self.eventBus)
	self.hudScaler = nil
	self.gamepadNav = nil
	self.perfTier = nil
	self.cursor = nil
	self.haptics = nil
	self.gestures = nil
	self.input = nil
	self.platform = nil
	self.isInitialized = false
end

function Runtime.GetClientRuntime(configRaw: RuntimeConfig?): RuntimeContext
	if singletonClient == nil then
		singletonClient = Runtime.New(configRaw)
	end
	return singletonClient :: RuntimeContext
end

function Runtime.GetServerRuntime(configRaw: RuntimeConfig?): RuntimeContext
	if singletonServer == nil then
		singletonServer = Runtime.New(configRaw)
	end
	return singletonServer :: RuntimeContext
end

function Runtime.GetSharedRuntime(configRaw: RuntimeConfig?): RuntimeContext
	if RunService:IsClient() then
		return Runtime.GetClientRuntime(configRaw)
	end
	return Runtime.GetServerRuntime(configRaw)
end

function Runtime.DestroyClientRuntime()
	if singletonClient == nil then
		return
	end
	singletonClient:destroy()
	singletonClient = nil
end

function Runtime.DestroyServerRuntime()
	if singletonServer == nil then
		return
	end
	singletonServer:destroy()
	singletonServer = nil
end

Runtime.Init = Runtime.Init
Runtime.Destroy = Runtime.Destroy
Runtime.GetGamepadNav = Runtime.GetGamepadNav
Runtime.GetHUDScaler = Runtime.GetHUDScaler
Runtime.GetEventBus = Runtime.GetEventBus
Runtime.GetTickScheduler = Runtime.GetTickScheduler

Runtime.new = Runtime.New
Runtime.init = Runtime.Init
Runtime.getGamepadNav = Runtime.GetGamepadNav
Runtime.getHUDScaler = Runtime.GetHUDScaler
Runtime.getEventBus = Runtime.GetEventBus
Runtime.getTickScheduler = Runtime.GetTickScheduler
Runtime.destroy = Runtime.Destroy
Runtime.getClientRuntime = Runtime.GetClientRuntime
Runtime.getServerRuntime = Runtime.GetServerRuntime
Runtime.getSharedRuntime = Runtime.GetSharedRuntime
Runtime.destroyClientRuntime = Runtime.DestroyClientRuntime
Runtime.destroyServerRuntime = Runtime.DestroyServerRuntime

return Runtime
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="1186">
                <Properties>
                  <string name="Name">SpatialHashGrid</string>
                  <string name="Source"><![CDATA[--!strict

local SpatialHashGrid = {}
SpatialHashGrid.__index = SpatialHashGrid

export type EntryId = string | number

export type EntryRecord<T> = {
	id: EntryId,
	x: number,
	y: number,
	z: number,
	payload: T,
	cellX: number,
	cellY: number,
	cellZ: number,
	chunkX: number,
	chunkY: number,
	chunkZ: number,
	cellKey: string,
	chunkKey: string,
}

export type SpatialHashGrid<T> = typeof(setmetatable({} :: any, SpatialHashGrid))

export type GridConfig = {
	cellSize: number,
	cellsPerChunk: number?,
	deterministicQueries: boolean?,
}

local function clampNumber(valueRaw: any, fallback: number, minValue: number, maxValue: number): number
	local value = if typeof(valueRaw) == "number" then valueRaw else fallback
	if value < minValue then
		return minValue
	end
	if value > maxValue then
		return maxValue
	end
	return value
end

local function key3(x: number, y: number, z: number): string
	return string.format("%d|%d|%d", x, y, z)
end

local function floorDiv(value: number, divisor: number): number
	return math.floor(value / divisor)
end

local function clearArray(array: { any })
	for index = #array, 1, -1 do
		array[index] = nil
	end
end

local function defaultSortById(a: EntryRecord<any>, b: EntryRecord<any>): boolean
	local idA = a.id
	local idB = b.id
	if typeof(idA) == typeof(idB) then
		if typeof(idA) == "number" then
			return (idA :: number) < (idB :: number)
		end
		return tostring(idA) < tostring(idB)
	end
	return tostring(typeof(idA)) < tostring(typeof(idB))
end

function SpatialHashGrid.new<T>(configRaw: GridConfig): SpatialHashGrid<T>
	local config = if typeof(configRaw) == "table" then configRaw else ({ cellSize = 8 } :: GridConfig)
	local cellSize = clampNumber(config.cellSize, 8, 0.001, 100000)
	local cellsPerChunk = math.max(1, math.floor(clampNumber(config.cellsPerChunk, 4, 1, 512)))
	local deterministic = if config.deterministicQueries == nil then true else config.deterministicQueries == true

	local self = setmetatable({
		cellSize = cellSize,
		invCellSize = 1 / cellSize,
		cellsPerChunk = cellsPerChunk,
		deterministicQueries = deterministic,
		entries = {} :: { [EntryId]: EntryRecord<T> },
		cells = {} :: { [string]: { [EntryId]: EntryRecord<T> } },
		chunks = {} :: { [string]: { [EntryId]: true } },
		entryCount = 0,
	}, SpatialHashGrid)
	return self
end

function SpatialHashGrid._worldToCell(self: SpatialHashGrid<any>, x: number, y: number, z: number): (number, number, number)
	local cellX = floorDiv(x, self.cellSize)
	local cellY = floorDiv(y, self.cellSize)
	local cellZ = floorDiv(z, self.cellSize)
	return cellX, cellY, cellZ
end

function SpatialHashGrid._cellToChunk(self: SpatialHashGrid<any>, cellX: number, cellY: number, cellZ: number): (number, number, number)
	local chunkX = floorDiv(cellX, self.cellsPerChunk)
	local chunkY = floorDiv(cellY, self.cellsPerChunk)
	local chunkZ = floorDiv(cellZ, self.cellsPerChunk)
	return chunkX, chunkY, chunkZ
end

function SpatialHashGrid._attach(self: SpatialHashGrid<any>, record: EntryRecord<any>)
	local cellBucket = self.cells[record.cellKey]
	if cellBucket == nil then
		cellBucket = {}
		self.cells[record.cellKey] = cellBucket
	end
	cellBucket[record.id] = record

	local chunkBucket = self.chunks[record.chunkKey]
	if chunkBucket == nil then
		chunkBucket = {}
		self.chunks[record.chunkKey] = chunkBucket
	end
	chunkBucket[record.id] = true
end

function SpatialHashGrid._detach(self: SpatialHashGrid<any>, record: EntryRecord<any>)
	local cellBucket = self.cells[record.cellKey]
	if cellBucket ~= nil then
		cellBucket[record.id] = nil
		if next(cellBucket) == nil then
			self.cells[record.cellKey] = nil
		end
	end

	local chunkBucket = self.chunks[record.chunkKey]
	if chunkBucket ~= nil then
		chunkBucket[record.id] = nil
		if next(chunkBucket) == nil then
			self.chunks[record.chunkKey] = nil
		end
	end
end

function SpatialHashGrid.insert<T>(self: SpatialHashGrid<T>, idRaw: any, xRaw: any, yRaw: any, zRaw: any, payload: T): boolean
	local idKind = typeof(idRaw)
	if idKind ~= "string" and idKind ~= "number" then
		return false
	end
	local id = idRaw :: EntryId
	if self.entries[id] ~= nil then
		return false
	end

	local x = if typeof(xRaw) == "number" then xRaw else 0
	local y = if typeof(yRaw) == "number" then yRaw else 0
	local z = if typeof(zRaw) == "number" then zRaw else 0
	local cellX, cellY, cellZ = self:_worldToCell(x, y, z)
	local chunkX, chunkY, chunkZ = self:_cellToChunk(cellX, cellY, cellZ)

	local record = {
		id = id,
		x = x,
		y = y,
		z = z,
		payload = payload,
		cellX = cellX,
		cellY = cellY,
		cellZ = cellZ,
		chunkX = chunkX,
		chunkY = chunkY,
		chunkZ = chunkZ,
		cellKey = key3(cellX, cellY, cellZ),
		chunkKey = key3(chunkX, chunkY, chunkZ),
	} :: EntryRecord<T>

	self.entries[id] = record
	self.entryCount += 1
	self:_attach(record)
	return true
end

function SpatialHashGrid.Remove(self: SpatialHashGrid<any>, idRaw: any): boolean
	local record = self.entries[idRaw]
	if record == nil then
		return false
	end
	self:_detach(record)
	self.entries[idRaw] = nil
	self.entryCount -= 1
	return true
end

function SpatialHashGrid.update<T>(self: SpatialHashGrid<T>, idRaw: any, xRaw: any, yRaw: any, zRaw: any, payload: T?): boolean
	local record = self.entries[idRaw]
	if record == nil then
		return false
	end

	local x = if typeof(xRaw) == "number" then xRaw else record.x
	local y = if typeof(yRaw) == "number" then yRaw else record.y
	local z = if typeof(zRaw) == "number" then zRaw else record.z
	local cellX, cellY, cellZ = self:_worldToCell(x, y, z)
	local chunkX, chunkY, chunkZ = self:_cellToChunk(cellX, cellY, cellZ)

	if payload ~= nil then
		record.payload = payload
	end

	if cellX == record.cellX and cellY == record.cellY and cellZ == record.cellZ and chunkX == record.chunkX and chunkY == record.chunkY and chunkZ == record.chunkZ then
		record.x = x
		record.y = y
		record.z = z
		return true
	end

	self:_detach(record)
	record.x = x
	record.y = y
	record.z = z
	record.cellX = cellX
	record.cellY = cellY
	record.cellZ = cellZ
	record.chunkX = chunkX
	record.chunkY = chunkY
	record.chunkZ = chunkZ
	record.cellKey = key3(cellX, cellY, cellZ)
	record.chunkKey = key3(chunkX, chunkY, chunkZ)
	self:_attach(record)
	return true
end

function SpatialHashGrid.Get(self: SpatialHashGrid<any>, idRaw: any): EntryRecord<any>?
	return self.entries[idRaw]
end

function SpatialHashGrid.Count(self: SpatialHashGrid<any>): number
	return self.entryCount
end

function SpatialHashGrid.queryCell<T>(self: SpatialHashGrid<T>, cellXRaw: any, cellYRaw: any, cellZRaw: any, outRaw: { EntryRecord<T> }?): { EntryRecord<T> }
	local cellX = if typeof(cellXRaw) == "number" then math.floor(cellXRaw) else 0
	local cellY = if typeof(cellYRaw) == "number" then math.floor(cellYRaw) else 0
	local cellZ = if typeof(cellZRaw) == "number" then math.floor(cellZRaw) else 0
	local out = if outRaw ~= nil then outRaw else {}
	clearArray(out)

	local bucket = self.cells[key3(cellX, cellY, cellZ)]
	if bucket ~= nil then
		for _, record in bucket do
			out[#out + 1] = record
		end
	end
	if self.deterministicQueries and #out > 1 then
		table.sort(out :: any, defaultSortById)
	end
	return out
end

function SpatialHashGrid.queryChunk<T>(self: SpatialHashGrid<T>, chunkXRaw: any, chunkYRaw: any, chunkZRaw: any, outRaw: { EntryRecord<T> }?): { EntryRecord<T> }
	local chunkX = if typeof(chunkXRaw) == "number" then math.floor(chunkXRaw) else 0
	local chunkY = if typeof(chunkYRaw) == "number" then math.floor(chunkYRaw) else 0
	local chunkZ = if typeof(chunkZRaw) == "number" then math.floor(chunkZRaw) else 0
	local out = if outRaw ~= nil then outRaw else {}
	clearArray(out)

	local bucket = self.chunks[key3(chunkX, chunkY, chunkZ)]
	if bucket ~= nil then
		for id in bucket do
			local record = self.entries[id]
			if record ~= nil then
				out[#out + 1] = record
			end
		end
	end
	if self.deterministicQueries and #out > 1 then
		table.sort(out :: any, defaultSortById)
	end
	return out
end

function SpatialHashGrid.queryRadius<T>(self: SpatialHashGrid<T>, xRaw: any, yRaw: any, zRaw: any, radiusRaw: any, outRaw: { EntryRecord<T> }?): { EntryRecord<T> }
	local x = if typeof(xRaw) == "number" then xRaw else 0
	local y = if typeof(yRaw) == "number" then yRaw else 0
	local z = if typeof(zRaw) == "number" then zRaw else 0
	local radius = clampNumber(radiusRaw, 0, 0, 1000000)
	local out = if outRaw ~= nil then outRaw else {}
	clearArray(out)

	local minCellX = floorDiv(x - radius, self.cellSize)
	local minCellY = floorDiv(y - radius, self.cellSize)
	local minCellZ = floorDiv(z - radius, self.cellSize)
	local maxCellX = floorDiv(x + radius, self.cellSize)
	local maxCellY = floorDiv(y + radius, self.cellSize)
	local maxCellZ = floorDiv(z + radius, self.cellSize)

	local radiusSq = radius * radius
	for cellY = minCellY, maxCellY do
		for cellX = minCellX, maxCellX do
			for cellZ = minCellZ, maxCellZ do
				local bucket = self.cells[key3(cellX, cellY, cellZ)]
				if bucket ~= nil then
					for _, record in bucket do
						local dx = record.x - x
						local dy = record.y - y
						local dz = record.z - z
						if dx * dx + dy * dy + dz * dz <= radiusSq then
							out[#out + 1] = record
						end
					end
				end
			end
		end
	end

	if self.deterministicQueries and #out > 1 then
		table.sort(out :: any, defaultSortById)
	end
	return out
end

function SpatialHashGrid.WorldToChunk(self: SpatialHashGrid<any>, xRaw: any, yRaw: any, zRaw: any): (number, number, number)
	local x = if typeof(xRaw) == "number" then xRaw else 0
	local y = if typeof(yRaw) == "number" then yRaw else 0
	local z = if typeof(zRaw) == "number" then zRaw else 0
	local cellX, cellY, cellZ = self:_worldToCell(x, y, z)
	return self:_cellToChunk(cellX, cellY, cellZ)
end

function SpatialHashGrid.Clear(self: SpatialHashGrid<any>)
	table.clear(self.entries)
	table.clear(self.cells)
	table.clear(self.chunks)
	self.entryCount = 0
end

SpatialHashGrid.remove = SpatialHashGrid.Remove
SpatialHashGrid.get = SpatialHashGrid.Get
SpatialHashGrid.count = SpatialHashGrid.Count
SpatialHashGrid.worldToChunk = SpatialHashGrid.WorldToChunk
SpatialHashGrid.clear = SpatialHashGrid.Clear

return SpatialHashGrid
]]></string>
