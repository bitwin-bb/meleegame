                <Properties>
                  <string name="Name">Configs</string>
                  <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local WorldGenerationColor = require(script:FindFirstAncestor("game").Shared.Modules.Items.WorldGenerationColor)

local liquidDefinitions = WorldGenerationColor.LIQUID_DEFINITIONS
local liquidBiomeTints = WorldGenerationColor.LIQUID_BIOME_TINTS

local Configs = {
	gameVersion = "0.0.1",
	gameName = "Aquaria",
	maxPlayers = 4,

	playerData = {},

	cameraSettings = {
		sideViewEnabled = true,
		serviceEnabled = true,
	},

	cameraData = {
		distance = 60,
		height = 8,
		lookHeight = 8,
		sideSign = 1,
		fieldOfView = 50,
		movementBackAmount = 30,
		movementSpeedForMaxBack = 25,
		movementBackSign = 1,
		mouseInfluenceX = 2,
		mouseInfluenceY = 2,
		cameraSpring = {
			frequency = 5,
			damping = 1,
		},
		fovSpring = {
			frequency = 5,
			damping = 1,
		},
		room = {
			enabled = true,
			sampleIntervalSeconds = 0.12,
			horizontalScanRadiusTiles = 28,
			verticalScanRadiusTiles = 18,
			minimumEnclosedWidthTiles = 4,
			maximumEnclosedWidthTiles = 28,
			minimumEnclosedHeightTiles = 4,
			maximumEnclosedHeightTiles = 18,
			minimumDistanceScale = 0.56,
			minimumHeightScale = 0.76,
			minimumLookHeightScale = 0.9,
			minimumFieldOfViewScale = 0.86,
			widthWeight = 0.62,
			heightWeight = 0.38,
		},
		catchUpPlayer = {
			enabled = true,
			startDistance = 24,
			maxDistance = 140,
			accelerationSeconds = 0.9,
			minFrequencyDivisor = 2.2,
			maxFrequencyDivisor = 6,
		},
		predict = {
			enabled = false,
			leadTime = 0.08,
			maxLeadTime = 0.18,
			minimumSpeed = 2,
			maximumDistance = 18,
			derivedVelocityWeight = 0.35,
