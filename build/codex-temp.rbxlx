                <Properties>
                  <string name="Name">ReforgeRarity</string>
                  <string name="Source"><![CDATA[--!strict

local DropChance = require(script.Parent.DropChance)

local ReforgeRarity = {}

export type Rarity = "Common" | "Uncommon" | "Rare" | "Epic" | "Legendary" | "Mythic"

export type RarityWeight = {
	value: Rarity,
	weight: number,
}

local DEFAULT_WEIGHTS: { RarityWeight } = {
	{ value = "Common", weight = 44 },
	{ value = "Uncommon", weight = 28 },
	{ value = "Rare", weight = 16 },
	{ value = "Epic", weight = 8 },
	{ value = "Legendary", weight = 3 },
	{ value = "Mythic", weight = 1 },
}

local RARITY_RANK: { [Rarity]: number } = {
	Common = 1,
	Uncommon = 2,
	Rare = 3,
	Epic = 4,
	Legendary = 5,
	Mythic = 6,
}

function ReforgeRarity.GetRank(rarityRaw: any): number
	if typeof(rarityRaw) ~= "string" then
		return 0
	end
	return (RARITY_RANK :: { [string]: number })[rarityRaw] or 0
end

function ReforgeRarity.Compare(leftRaw: any, rightRaw: any): number
	return ReforgeRarity.GetRank(leftRaw) - ReforgeRarity.GetRank(rightRaw)
end

function ReforgeRarity.Roll(randomOrSeedRaw: any?, weightsRaw: { RarityWeight }?): (Rarity, number?)
	local value, nextSeed = DropChance.pickWeighted(weightsRaw or DEFAULT_WEIGHTS, randomOrSeedRaw)
	return (value or "Common") :: Rarity, nextSeed
end

function ReforgeRarity.GetDefaultWeights(): { RarityWeight }
	return table.clone(DEFAULT_WEIGHTS)
end

ReforgeRarity.getRank = ReforgeRarity.GetRank
ReforgeRarity.compare = ReforgeRarity.Compare
ReforgeRarity.roll = ReforgeRarity.Roll
ReforgeRarity.getDefaultWeights = ReforgeRarity.GetDefaultWeights

return ReforgeRarity
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="1251">
                <Properties>
                  <string name="Name">RoomScaleFactor</string>
                  <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Sift = require(ReplicatedStorage.Packages.Sift)


local RoomScaleFactor = {}

export type RoomScaleFactorConfig = {
	enabled: boolean?,
	sampleIntervalSeconds: number?,
	horizontalScanRadiusTiles: number?,
	verticalScanRadiusTiles: number?,
	minimumEnclosedWidthTiles: number?,
	maximumEnclosedWidthTiles: number?,
	minimumEnclosedHeightTiles: number?,
	maximumEnclosedHeightTiles: number?,
	minimumDistanceScale: number?,
	minimumHeightScale: number?,
	minimumLookHeightScale: number?,
	minimumFieldOfViewScale: number?,
	widthWeight: number?,
	heightWeight: number?,
}

export type RoomScaleSource = {
	isEnclosed: boolean,
	widthTiles: number,
	heightTiles: number,
	leftDistance: number?,
	rightDistance: number?,
	upDistance: number?,
	downDistance: number?,
}

export type RoomScaleResult = {
	active: boolean,
	isEnclosed: boolean,
	widthTiles: number,
	heightTiles: number,
	scaleAlpha: number,
	distanceScale: number,
	heightScale: number,
	lookHeightScale: number,
	fieldOfViewScale: number,
}

local DEFAULT_CONFIG: RoomScaleFactorConfig = {
	enabled = true,
	sampleIntervalSeconds = 0.12,
	horizontalScanRadiusTiles = 28,
	verticalScanRadiusTiles = 18,
	minimumEnclosedWidthTiles = 4,
	maximumEnclosedWidthTiles = 28,
	minimumEnclosedHeightTiles = 4,
	maximumEnclosedHeightTiles = 18,
	minimumDistanceScale = 0.56,
	minimumHeightScale = 0.76,
	minimumLookHeightScale = 0.9,
	minimumFieldOfViewScale = 0.86,
	widthWeight = 0.62,
	heightWeight = 0.38,
}

local function clampNumber(valueRaw: any, minimum: number, maximum: number, fallback: number): number
	if typeof(valueRaw) ~= "number" or valueRaw ~= valueRaw then
		return fallback
	end
	return math.clamp(valueRaw, minimum, maximum)
end

local function lerp(from: number, to: number, alpha: number): number
	return from + ((to - from) * alpha)
end

function RoomScaleFactor.CreateDefaultConfig(): RoomScaleFactorConfig
	return Sift.Dictionary.copy(DEFAULT_CONFIG)
end

function RoomScaleFactor.CreateDefaultResult(): RoomScaleResult
	return {
		active = false,
		isEnclosed = false,
		widthTiles = 0,
		heightTiles = 0,
		scaleAlpha = 1,
		distanceScale = 1,
		heightScale = 1,
		lookHeightScale = 1,
		fieldOfViewScale = 1,
	}
end

function RoomScaleFactor.SanitizeConfig(
	configRaw: any,
	fallbackConfigRaw: RoomScaleFactorConfig?
): RoomScaleFactorConfig
	local source = if typeof(configRaw) == "table" then (configRaw :: RoomScaleFactorConfig) else {}
	local fallback = if typeof(fallbackConfigRaw) == "table" then fallbackConfigRaw else DEFAULT_CONFIG

	local minimumEnclosedWidthTiles = clampNumber(
		source.minimumEnclosedWidthTiles,
		2,
		256,
		clampNumber(fallback.minimumEnclosedWidthTiles, 2, 256, DEFAULT_CONFIG.minimumEnclosedWidthTiles :: number)
	)
	local maximumEnclosedWidthTiles = clampNumber(
		source.maximumEnclosedWidthTiles,
		minimumEnclosedWidthTiles,
		512,
		clampNumber(
			fallback.maximumEnclosedWidthTiles,
			minimumEnclosedWidthTiles,
			512,
			DEFAULT_CONFIG.maximumEnclosedWidthTiles :: number
		)
	)
	local minimumEnclosedHeightTiles = clampNumber(
		source.minimumEnclosedHeightTiles,
		2,
		256,
		clampNumber(
			fallback.minimumEnclosedHeightTiles,
			2,
			256,
			DEFAULT_CONFIG.minimumEnclosedHeightTiles :: number
		)
	)
	local maximumEnclosedHeightTiles = clampNumber(
		source.maximumEnclosedHeightTiles,
		minimumEnclosedHeightTiles,
		512,
		clampNumber(
			fallback.maximumEnclosedHeightTiles,
			minimumEnclosedHeightTiles,
			512,
			DEFAULT_CONFIG.maximumEnclosedHeightTiles :: number
		)
	)
	local widthWeight = clampNumber(
		source.widthWeight,
		0,
		1,
		clampNumber(fallback.widthWeight, 0, 1, DEFAULT_CONFIG.widthWeight :: number)
	)
	local heightWeight = clampNumber(
		source.heightWeight,
		0,
		1,
		clampNumber(fallback.heightWeight, 0, 1, DEFAULT_CONFIG.heightWeight :: number)
	)

	return {
		enabled = if typeof(source.enabled) == "boolean"
			then source.enabled
			else if typeof(fallback.enabled) == "boolean" then fallback.enabled else true,
		sampleIntervalSeconds = clampNumber(
			source.sampleIntervalSeconds,
			0.01,
			2,
			clampNumber(fallback.sampleIntervalSeconds, 0.01, 2, DEFAULT_CONFIG.sampleIntervalSeconds :: number)
		),
		horizontalScanRadiusTiles = clampNumber(
			source.horizontalScanRadiusTiles,
			2,
			256,
			clampNumber(
				fallback.horizontalScanRadiusTiles,
				2,
				256,
				DEFAULT_CONFIG.horizontalScanRadiusTiles :: number
			)
		),
		verticalScanRadiusTiles = clampNumber(
			source.verticalScanRadiusTiles,
			2,
			256,
			clampNumber(
				fallback.verticalScanRadiusTiles,
				2,
				256,
				DEFAULT_CONFIG.verticalScanRadiusTiles :: number
			)
		),
		minimumEnclosedWidthTiles = minimumEnclosedWidthTiles,
		maximumEnclosedWidthTiles = maximumEnclosedWidthTiles,
		minimumEnclosedHeightTiles = minimumEnclosedHeightTiles,
		maximumEnclosedHeightTiles = maximumEnclosedHeightTiles,
		minimumDistanceScale = clampNumber(
			source.minimumDistanceScale,
			0.2,
			1,
			clampNumber(
				fallback.minimumDistanceScale,
				0.2,
				1,
				DEFAULT_CONFIG.minimumDistanceScale :: number
			)
		),
		minimumHeightScale = clampNumber(
			source.minimumHeightScale,
			0.2,
			1,
			clampNumber(fallback.minimumHeightScale, 0.2, 1, DEFAULT_CONFIG.minimumHeightScale :: number)
		),
		minimumLookHeightScale = clampNumber(
			source.minimumLookHeightScale,
			0.2,
			1,
			clampNumber(
				fallback.minimumLookHeightScale,
				0.2,
				1,
				DEFAULT_CONFIG.minimumLookHeightScale :: number
			)
		),
		minimumFieldOfViewScale = clampNumber(
			source.minimumFieldOfViewScale,
			0.2,
			1,
			clampNumber(
				fallback.minimumFieldOfViewScale,
				0.2,
				1,
				DEFAULT_CONFIG.minimumFieldOfViewScale :: number
			)
		),
		widthWeight = widthWeight,
		heightWeight = heightWeight,
	}
end

function RoomScaleFactor.Resolve(configRaw: any, sourceRaw: any): RoomScaleResult
	local config = RoomScaleFactor.SanitizeConfig(configRaw)
	local source = if typeof(sourceRaw) == "table" then (sourceRaw :: RoomScaleSource) else nil
	if config.enabled ~= true or source == nil or source.isEnclosed ~= true then
		return RoomScaleFactor.CreateDefaultResult()
	end

	local widthTiles = math.max(0, clampNumber(source.widthTiles, 0, 512, 0))
	local heightTiles = math.max(0, clampNumber(source.heightTiles, 0, 512, 0))
	local widthAlpha = math.clamp(
		(widthTiles - (config.minimumEnclosedWidthTiles :: number))
			/ math.max((config.maximumEnclosedWidthTiles :: number) - (config.minimumEnclosedWidthTiles :: number), 0.001),
		0,
		1
	)
	local heightAlpha = math.clamp(
		(heightTiles - (config.minimumEnclosedHeightTiles :: number))
			/ math.max((config.maximumEnclosedHeightTiles :: number) - (config.minimumEnclosedHeightTiles :: number), 0.001),
		0,
		1
	)
	local totalWeight = math.max((config.widthWeight :: number) + (config.heightWeight :: number), 0.001)
	local weightedAlpha =
		((widthAlpha * (config.widthWeight :: number)) + (heightAlpha * (config.heightWeight :: number))) / totalWeight
	local geometricAlpha = math.sqrt(widthAlpha * heightAlpha)
	local scaleAlpha = math.clamp((weightedAlpha * 0.65) + (geometricAlpha * 0.35), 0, 1)

	local result: RoomScaleResult = {
		active = false,
		isEnclosed = true,
		widthTiles = widthTiles,
		heightTiles = heightTiles,
		scaleAlpha = scaleAlpha,
		distanceScale = lerp(config.minimumDistanceScale :: number, 1, scaleAlpha),
		heightScale = lerp(config.minimumHeightScale :: number, 1, scaleAlpha),
		lookHeightScale = lerp(config.minimumLookHeightScale :: number, 1, scaleAlpha),
		fieldOfViewScale = lerp(config.minimumFieldOfViewScale :: number, 1, scaleAlpha),
	}
	result.active = result.distanceScale < 0.999
		or result.heightScale < 0.999
		or result.lookHeightScale < 0.999
		or result.fieldOfViewScale < 0.999
	return result
end

RoomScaleFactor.createDefaultConfig = RoomScaleFactor.CreateDefaultConfig
RoomScaleFactor.createDefaultResult = RoomScaleFactor.CreateDefaultResult
RoomScaleFactor.sanitizeConfig = RoomScaleFactor.SanitizeConfig
RoomScaleFactor.resolve = RoomScaleFactor.Resolve

return RoomScaleFactor
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="1252">
                <Properties>
                  <string name="Name">Solve</string>
                  <string name="Source"><![CDATA[--!strict
-- Focused analytic solvers and simple ray intersection helpers.

local Solve = {}

export type QuadraticRoots = {
	count: number,
	discriminant: number,
	min: number?,
	max: number?,
}

export type RayHit = {
	t: number,
	point: Vector3,
}

local EPSILON = 1e-8

function Solve.Linear(a: number, b: number): number?
	if math.abs(a) <= EPSILON then
		return nil
	end
	return -b / a
end

function Solve.Quadratic(a: number, b: number, c: number): QuadraticRoots
	if math.abs(a) <= EPSILON then
		local root = Solve.Linear(b, c)
		if root == nil then
			return {
				count = 0,
				discriminant = 0,
			}
		end
		return {
			count = 1,
			discriminant = 0,
			min = root,
			max = root,
		}
	end

	local discriminant = b * b - 4 * a * c
	if discriminant < -EPSILON then
		return {
			count = 0,
			discriminant = discriminant,
		}
	end

	if math.abs(discriminant) <= EPSILON then
		local root = -b / (2 * a)
		return {
			count = 1,
			discriminant = 0,
			min = root,
			max = root,
		}
	end

	local sqrtDiscriminant = math.sqrt(discriminant)
	local rootA = (-b - sqrtDiscriminant) / (2 * a)
	local rootB = (-b + sqrtDiscriminant) / (2 * a)
	local minRoot = math.min(rootA, rootB)
	local maxRoot = math.max(rootA, rootB)
	return {
		count = 2,
		discriminant = discriminant,
		min = minRoot,
		max = maxRoot,
	}
end

function Solve.SmallestPositiveQuadratic(a: number, b: number, c: number, minimum: number?): number?
	local threshold = minimum or 0
	local roots = Solve.Quadratic(a, b, c)
	if roots.count == 0 then
		return nil
	end

	if roots.min ~= nil and roots.min >= threshold then
		return roots.min
	end
	if roots.max ~= nil and roots.max >= threshold then
		return roots.max
	end
	return nil
end

function Solve.RayPlane(origin: Vector3, direction: Vector3, planePoint: Vector3, planeNormal: Vector3): RayHit?
	local denominator = planeNormal:Dot(direction)
	if math.abs(denominator) <= EPSILON then
		return nil
	end

	local t = planeNormal:Dot(planePoint - origin) / denominator
	if t < 0 then
		return nil
	end

	return {
		t = t,
		point = origin + direction * t,
	}
end

function Solve.RaySphere(origin: Vector3, direction: Vector3, center: Vector3, radius: number): RayHit?
	local offset = origin - center
	local a = direction:Dot(direction)
	if a <= EPSILON then
		return nil
	end

	local b = 2 * direction:Dot(offset)
	local c = offset:Dot(offset) - radius * radius
	local t = Solve.SmallestPositiveQuadratic(a, b, c, 0)
	if t == nil then
		return nil
	end

	return {
		t = t,
		point = origin + direction * t,
	}
end

Solve.linear = Solve.Linear
Solve.quadratic = Solve.Quadratic
Solve.smallestPositiveQuadratic = Solve.SmallestPositiveQuadratic
Solve.rayPlane = Solve.RayPlane
Solve.raySphere = Solve.RaySphere

return Solve
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="1253">
                <Properties>
                  <string name="Name">SpawnChance</string>
                  <string name="Source"><![CDATA[--!strict

local Rand = require(script.Parent.Rand)

local SpawnChance = {}

export type SpawnRoll = {
	spawned: boolean,
	roll: number,
	probability: number,
	seed: number?,
}

local function sanitizeProbability(valueRaw: any, fallback: number): number
	if typeof(valueRaw) ~= "number" or valueRaw ~= valueRaw then
		return math.clamp(fallback, 0, 1)
	end
	return math.clamp(valueRaw, 0, 1)
end

function SpawnChance.ResolveProbability(chanceRaw: any, multiplierRaw: any?): number
	local chance = sanitizeProbability(chanceRaw, 0)
	local multiplier = if typeof(multiplierRaw) == "number" and multiplierRaw == multiplierRaw then multiplierRaw else 1
	return math.clamp(chance * math.max(0, multiplier), 0, 1)
end

function SpawnChance.Roll(chanceRaw: any, randomOrSeedRaw: any?, multiplierRaw: any?): SpawnRoll
	local probability = SpawnChance.ResolveProbability(chanceRaw, multiplierRaw)
	if typeof(randomOrSeedRaw) == "number" then
		local nextSeed, didSpawn = Rand.chance(randomOrSeedRaw, probability)
		local _, roll = Rand.number(randomOrSeedRaw)
		return {
			spawned = didSpawn,
			roll = roll,
			probability = probability,
			seed = nextSeed,
		}
	end

	local randomObject = if typeof(randomOrSeedRaw) == "Random" then randomOrSeedRaw :: Random else Random.new()
	local roll = randomObject:NextNumber()
	return {
		spawned = roll <= probability,
		roll = roll,
		probability = probability,
		seed = nil,
	}
end

SpawnChance.resolveProbability = SpawnChance.ResolveProbability
SpawnChance.roll = SpawnChance.Roll

return SpawnChance
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="1254">
                <Properties>
                  <string name="Name">Spring</string>
                  <string name="Source"><![CDATA[--!strict
-- Stateless spring stepping helpers.

local Angle = require(script.Parent.Angle)

local Spring = {}

export type SpringValue = number | Vector2 | Vector3

export type State<T> = {
	value: T,
	velocity: T,
}

local function zeroLike<T>(value: T): T
	local kind = typeof(value)
	if kind == "number" then
		return (0 :: any) :: T
	end
	if kind == "Vector2" then
		return (Vector2.zero :: any) :: T
	end
	return (Vector3.zero :: any) :: T
end

local function add<T>(a: T, b: T): T
	return (((a :: any) + (b :: any)) :: any) :: T
end

local function sub<T>(a: T, b: T): T
	return (((a :: any) - (b :: any)) :: any) :: T
end

local function mul<T>(value: T, scalar: number): T
	return (((value :: any) * scalar) :: any) :: T
end

local function magnitudeSq(value: SpringValue): number
	if typeof(value) == "number" then
		return value * value
	end
	return value:Dot(value)
end

function Spring.state<T>(value: T, velocity: T?): State<T>
	return {
		value = value,
		velocity = if velocity ~= nil then velocity else zeroLike(value),
	}
end

function Spring.step<T>(state: State<T>, target: T, frequency: number, damping: number, dt: number, mass: number?): State<T>
	local step = math.max(dt, 0)
	if step == 0 then
		return {
			value = state.value,
			velocity = state.velocity,
		}
	end

	local hz = math.max(frequency, 0)
	if hz == 0 then
		return {
			value = target,
			velocity = zeroLike(target),
		}
	end

	local omega = 2 * math.pi * hz
	local massScale = math.max(mass or 1, 1e-6)
	local scaledOmega = omega / math.sqrt(massScale)
	local zeta = math.max(damping, 0)
	local f = 1 + 2 * step * zeta * scaledOmega
	local omegaSquared = scaledOmega * scaledOmega
	local hoo = step * omegaSquared
	local hhoo = step * hoo
	local detInv = 1 / (f + hhoo)

	local current = state.value
	local velocity = state.velocity
	local delta = sub(target, current)
	local valueTerm = add(add(mul(current, f), mul(velocity, step)), mul(target, hhoo))
	local velocityTerm = add(velocity, mul(delta, hoo))

	return {
		value = mul(valueTerm, detInv),
		velocity = mul(velocityTerm, detInv),
	}
end

function Spring.StepAngleRadians(
	state: State<number>,
	target: number,
	frequency: number,
	damping: number,
	dt: number,
	mass: number?
): State<number>
	local wrappedTarget = state.value + Angle.deltaRadians(state.value, target)
	return Spring.step(state, wrappedTarget, frequency, damping, dt, mass)
end

function Spring.StepAngleDegrees(
	state: State<number>,
	target: number,
	frequency: number,
	damping: number,
	dt: number,
	mass: number?
): State<number>
	local wrappedTarget = state.value + Angle.deltaDegrees(state.value, target)
	return Spring.step(state, wrappedTarget, frequency, damping, dt, mass)
end

function Spring.isSettled<T>(state: State<T>, target: T, valueEpsilon: number?, velocityEpsilon: number?): boolean
	local valueTolerance = math.max(valueEpsilon or 1e-3, 0)
	local velocityTolerance = math.max(velocityEpsilon or 1e-3, 0)
	local valueDelta = sub(target, state.value) :: any
	local velocity = state.velocity :: any

	return magnitudeSq(valueDelta) <= valueTolerance * valueTolerance
		and magnitudeSq(velocity) <= velocityTolerance * velocityTolerance
end

Spring.stepAngleRadians = Spring.StepAngleRadians
Spring.stepAngleDegrees = Spring.StepAngleDegrees

return Spring
]]></string>
