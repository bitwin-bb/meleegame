            <string name="Name">solarhorizon_react-rodux@0.2.2</string>
          </Properties>
          <Item class="ModuleScript" referent="679">
            <Properties>
              <string name="Name">LuauPolyfill</string>
              <string name="Source"><![CDATA[return require(script.Parent.Parent["jsdotlua_luau-polyfill@1.2.7"]["luau-polyfill"])
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="680">
            <Properties>
              <string name="Name">React</string>
              <string name="Source"><![CDATA[return require(script.Parent.Parent["jsdotlua_react@17.2.1"]["react"])
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="681">
            <Properties>
              <string name="Name">Rodux</string>
