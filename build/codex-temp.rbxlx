                  <string name="Name">Layer</string>
                  <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local React = require(ReplicatedStorage.Packages.React)
local ScreenLayer = require(script.Parent.Parent.core.primitives.ScreenLayer)

export type LayerProps = {
	layoutOrder: number?,
	visible: boolean?,
	zIndex: number?,
	active: boolean?,
	name: string?,
	children: { React.ReactNode }?,
	native: { [any]: any }?,
}

local DEFAULT_Z_INDEX = 1

return function(props: LayerProps): React.ReactNode
	local native = if props.native ~= nil then table.clone(props.native) else {}
	if props.name ~= nil then
		native.Name = props.name
	end

	return React.createElement(ScreenLayer, {
		layoutOrder = props.layoutOrder,
		visible = props.visible,
		zIndex = props.zIndex or DEFAULT_Z_INDEX,
		active = props.active,
		native = native,
		children = props.children,
	})
end
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="998">
                <Properties>
                  <string name="Name">Scale</string>
                  <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local React = require(ReplicatedStorage.Packages.React)
local Responsive = require(script:FindFirstAncestor("game").Client.UI.core.hooks.useViewportScale)

export type ScaleProps = {
	scale: number?,
	multiplier: number?,
	minScale: number?,
	maxScale: number?,
	useViewportScale: boolean?,
}

local e: typeof(React.createElement) = React.createElement

return function(props: ScaleProps): React.ReactNode
	local shouldUseViewportScale = props.useViewportScale == true
	local viewportScale = Responsive.useResponsiveMetrics().scale

	local resolvedScale = if props.scale ~= nil then props.scale else 1
	resolvedScale *= props.multiplier or 1
	if shouldUseViewportScale then
		resolvedScale *= viewportScale
	end
	if props.minScale ~= nil or props.maxScale ~= nil then
		resolvedScale = math.clamp(resolvedScale, props.minScale or -math.huge, props.maxScale or math.huge)
	end

	return e("UIScale", {
		Scale = resolvedScale,
	})
end
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="999">
                <Properties>
                  <string name="Name">useDebounceValue</string>
                  <string name="Source"><![CDATA[--!strict

local useDebounce = require(script.Parent.Parent.core.hooks.useDebounce)

export type DebounceValueOptions<T> = {
	leading: boolean?,
	equalityFn: ((T, T) -> boolean)?,
}

local function useDebounceValue<T>(value: T, delaySeconds: any, options: DebounceValueOptions<T>?): T
	return useDebounce(value, delaySeconds, options).value
end

return useDebounceValue
]]></string>
