            <Item class="ModuleScript" referent="1017">
              <Properties>
                <string name="Name">NpcBinder</string>
                <string name="Source"><![CDATA[--!strict

local ModelBinder = require(script:FindFirstAncestor("game").Shared.Binders.ModelBinder)
local NpcServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.NpcServiceUtils)
local TagBinder = require(script:FindFirstAncestor("game").Shared.Binders.TagBinder)

local NpcBinder = {}
NpcBinder.__index = NpcBinder
setmetatable(NpcBinder, ModelBinder)

local function resolveNpcType(self: any, model: Model): string
	local runtimeType = model:GetAttribute(NpcServiceUtils.RUNTIME_NPC_TYPE_ATTRIBUTE)
	if typeof(runtimeType) == "string" and runtimeType ~= "" then
		return runtimeType
	end
	if self:HasTag(TagBinder.Tags.Npc_Slime) then
		return "Slime"
	end
	if self:HasTag(TagBinder.Tags.Npc_Flying) then
		return "Flying"
	end
	if self:HasTag(TagBinder.Tags.Npc_Ground) then
		return "Ground"
	end
	return "Npc"
end

function NpcBinder.new(instance: Instance, context: any)
	local self = ModelBinder.new(instance, context, NpcBinder)
	self.model = self:GetModel()
	if self.model ~= nil then
		self:updateMetadata()
	end
	return self
end

function NpcBinder.updateMetadata(self: any)
	local model = self.model
	if model == nil then
		return
	end

	model:SetAttribute("NpcBinderTagged", true)
	model:SetAttribute("NpcBinderType", resolveNpcType(self, model))

	local runtimeId = NpcServiceUtils.resolveRuntimeIdFromInstance(model)
	if runtimeId ~= nil then
		model:SetAttribute("NpcBinderRuntimeId", runtimeId)
	end
end

return NpcBinder
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="1018">
              <Properties>
                <string name="Name">PickupBinder</string>
                <string name="Source"><![CDATA[--!strict

local ModelBinder = require(script:FindFirstAncestor("game").Shared.Binders.ModelBinder)

local PickupBinder = {}
PickupBinder.__index = PickupBinder
setmetatable(PickupBinder, ModelBinder)

local inventoryServiceServer = nil

local function getInventoryServiceServer()
	if inventoryServiceServer == nil then
		inventoryServiceServer = require(script:FindFirstAncestor("game").Server.Services.InventoryServiceServer)
	end
	return inventoryServiceServer
end

local ITEM_ATTRIBUTE_NAMES = {
	"PickupItemId",
	"LootItemId",
	"ItemId",
	"PlacedItemId",
}

local function resolveStringAttribute(instance: Instance, attributeNames: { string }): string?
	for _, attributeName in attributeNames do
		local value = instance:GetAttribute(attributeName)
		if typeof(value) == "string" and value ~= "" then
			return value
		end
	end
	return nil
end

function PickupBinder.new(instance: Instance, context: any)
	local self = ModelBinder.new(instance, context, PickupBinder)
	self.cooldowns = {} :: { [Player]: number }
	self:refresh()
	ModelBinder.bindTouchedParts(instance, self.janitor, function(_part: BasePart, other: BasePart)
		self:onTouched(other)
	end)
	return self
end

function PickupBinder.refresh(self: any)
	self.itemId = resolveStringAttribute(self.instance, ITEM_ATTRIBUTE_NAMES)
	self.amount = math.max(1, math.floor(tonumber(self.instance:GetAttribute("PickupAmount")) or 1))
	self.destroyOnCollect = self.instance:GetAttribute("PickupDestroyOnCollect") ~= false
	self.instance:SetAttribute("PickupTagged", true)
end

function PickupBinder.onTouched(self: any, other: BasePart)
	if self.itemId == nil then
		return
	end

	local player = ModelBinder.resolvePlayer(other)
	if player == nil then
		return
	end

	local now = os.clock()
	if now < (self.cooldowns[player] or 0) then
		return
	end
	self.cooldowns[player] = now + 0.15

	local addResult = getInventoryServiceServer():addItem(player, self.itemId, self.amount, {})
	if addResult.added <= 0 then
		return
	end

	if addResult.leftover > 0 then
		self.amount = addResult.leftover
		self.instance:SetAttribute("PickupAmount", self.amount)
	else
		self.amount = 0
		if self.destroyOnCollect and self.instance.Parent ~= nil then
			self.instance:Destroy()
		end
	end
end

return PickupBinder
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="1019">
              <Properties>
                <string name="Name">PlaceableBinder</string>
                <string name="Source"><![CDATA[--!strict

local ItemRegistry = require(script:FindFirstAncestor("game").Shared.Modules.Items.Registry)
local ModelBinder = require(script:FindFirstAncestor("game").Shared.Binders.ModelBinder)
local TagBinder = require(script:FindFirstAncestor("game").Shared.Binders.TagBinder)

local PlaceableBinder = {}
PlaceableBinder.__index = PlaceableBinder
setmetatable(PlaceableBinder, ModelBinder)

local function resolveItemId(instance: Instance): string?
	local placedItemId = instance:GetAttribute("PlacedItemId")
	if typeof(placedItemId) == "string" and placedItemId ~= "" then
		return placedItemId
	end

	local itemId = instance:GetAttribute("ItemId")
	if typeof(itemId) == "string" and itemId ~= "" then
		return itemId
	end

	return nil
end

function PlaceableBinder.new(instance: Instance, context: any)
	local self = ModelBinder.new(instance, context, PlaceableBinder)
	self:updateMetadata()
	return self
end

function PlaceableBinder.updateMetadata(self: any)
	local itemId = resolveItemId(self.instance)
	self.instance:SetAttribute("PlaceableTagged", true)

	if itemId == nil then
		return
	end

	self.instance:SetAttribute("PlaceableItemId", itemId)
	local definition = ItemRegistry.resolveDefinition(itemId)
	if typeof(definition) ~= "table" then
		return
	end

	if self:HasTag(TagBinder.Tags.Placeable_Torch) or itemId == "Torch" then
		self.instance:SetAttribute("PlaceableKind", "Torch")
		if self.instance:GetAttribute("LightEnabled") == nil then
			self.instance:SetAttribute("LightEnabled", true)
		end
		return
	end

	if self:HasTag(TagBinder.Tags.Placeable_Workbench) or itemId == "Workbench" then
		self.instance:SetAttribute("PlaceableKind", "Workbench")
		if self.instance:GetAttribute("UseObjectText") == nil then
			self.instance:SetAttribute("UseObjectText", "Workbench")
		end
	end
end

return PlaceableBinder
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="1020">
              <Properties>
                <string name="Name">RagdollBinder</string>
                <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")

local ModelBinder = require(script:FindFirstAncestor("game").Shared.Binders.ModelBinder)
local RagdollServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.RagdollServiceUtils)

local RagdollBinder = {}
RagdollBinder.__index = RagdollBinder
setmetatable(RagdollBinder, ModelBinder)

function RagdollBinder.new(instance: Instance, context: any)
	local self = ModelBinder.new(instance, context, RagdollBinder)
	self.model = self:GetModel()
	if self.model == nil then
		return self
	end

	self.context = nil
	self.recoveryToken = 0
	self.ragdollOnDeath = self.instance:GetAttribute("RagdollOnDeath") ~= false
	self.humanoid = self:GetHumanoid()
	self:applyRequestedState()

	if self.humanoid ~= nil then
		self:Connect(self.humanoid.Died, function()
			if self.ragdollOnDeath then
				self:setRagdolled(true, "Death", nil)
			end
		end)
	end

	self:ObserveAttribute("RagdollEnabled", function()
		self:applyRequestedState()
	end)

	return self
end

function RagdollBinder.isPlayerCharacter(self: any): boolean
	return self.model ~= nil and Players:GetPlayerFromCharacter(self.model) ~= nil
end

function RagdollBinder.setRagdolled(self: any, enabled: boolean, reason: string, impulse: Vector3?)
	if self.model == nil then
		return
	end
	if self:isPlayerCharacter() then
		return
	end

	if enabled then
		if self.context == nil then
			local rig = RagdollServiceUtils.resolveCharacterRig(self.model)
			if rig ~= nil then
				self.context = RagdollServiceUtils.beginRagdoll(rig, {
					reason = reason,
					impulse = impulse,
				})
			end
		end

		if self.context ~= nil then
			local planeX = self.instance:GetAttribute("RagdollPlaneX")
			if typeof(planeX) == "number" then
				RagdollServiceUtils.enforceRagdoll2DPlane(self.context, planeX)
			end
		end

		local duration = self.instance:GetAttribute("RagdollDuration")
		if typeof(duration) == "number" and duration > 0 then
			self.recoveryToken += 1
			local token = self.recoveryToken
			task.delay(duration, function()
				if self.destroyed or self.recoveryToken ~= token then
					return
				end
				self:setRagdolled(false, "Recovery", nil)
			end)
		end
	else
		self.recoveryToken += 1
		if self.context ~= nil then
			RagdollServiceUtils.endRagdoll(self.context, {
				restoreHumanoid = true,
			})
			self.context = nil
		end
	end

	self.instance:SetAttribute("RagdollActive", self.context ~= nil)
end

function RagdollBinder.applyRequestedState(self: any)
	local requested = self.instance:GetAttribute("RagdollEnabled") == true
	if requested then
		self:setRagdolled(true, tostring(self.instance:GetAttribute("RagdollReason") or "Binder"), nil)
	elseif not self.ragdollOnDeath then
		self:setRagdolled(false, "Disabled", nil)
	end
end

function RagdollBinder.Cleanup(self: any)
	self:setRagdolled(false, "Cleanup", nil)
end

return RagdollBinder
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="1021">
              <Properties>
                <string name="Name">ServerBinderSupport</string>
                <string name="Source"><![CDATA[--!strict

local packageRoot = script:FindFirstAncestor("game").Parent
local loaderUtils = assert(packageRoot:FindFirstChild("LoaderUtils", true), "Missing LoaderUtils")
local loader = require(loaderUtils.Parent).load(script)

local Binder = loader("Binder")
local BinderProvider = loader("BinderProvider")
local BossBinder = require(script.Parent.BossBinder)
local BreakableBinder = require(script.Parent.BreakableBinder)
local BreathBinder = require(script.Parent.BreathBinder)
local CharacterBinder = require(script.Parent.CharacterBinder)
local DropBinder = require(script.Parent.DropBinder)
local GoreBinder = require(script.Parent.GoreBinder)
local HazardBinder = require(script.Parent.HazardBinder)
local HitboxBinder = require(script.Parent.HitboxBinder)
local LootBinder = require(script.Parent.LootBinder)
local MagicBinder = require(script.Parent.MagicBinder)
local MeleeBinder = require(script.Parent.MeleeBinder)
local NpcBinder = require(script.Parent.NpcBinder)
local PickupBinder = require(script.Parent.PickupBinder)
local PlaceableBinder = require(script.Parent.PlaceableBinder)
local RagdollBinder = require(script.Parent.RagdollBinder)
local ServerChunkBinder = require(script.Parent.ServerChunkBinder)
local StationBinder = require(script.Parent.StationBinder)
local TagBinder = require(script:FindFirstAncestor("game").Shared.Binders.TagBinder)
local UnitBinder = require(script.Parent.UnitBinder)

local function createContext(primaryTag: string, serviceBag: any): { tags: { string }, serviceBag: any }
	return table.freeze({
		serviceBag = serviceBag,
		tags = table.freeze({ primaryTag }),
	})
end

local function addBinder(self: any, primaryTag: string, binderClass: any)
	self:Add(Binder.new(primaryTag, function(instance: Instance, serviceBag: any)
		return binderClass.new(instance, createContext(primaryTag, serviceBag))
	end))
end

local ServerBinderSupport = BinderProvider.new("ServerBinderSupport", function(self)
	addBinder(self, TagBinder.Tags.Boss, BossBinder)
	addBinder(self, TagBinder.Tags.Breakable, BreakableBinder)
	addBinder(self, TagBinder.Tags.Breath, BreathBinder)
	addBinder(self, TagBinder.Tags.Character, CharacterBinder)
	addBinder(self, TagBinder.Tags.Chunk, ServerChunkBinder)
	addBinder(self, TagBinder.Tags.Drop, DropBinder)
	addBinder(self, TagBinder.Tags.Gore, GoreBinder)
	addBinder(self, TagBinder.Tags.Hazard, HazardBinder)
	addBinder(self, TagBinder.Tags.Hitbox, HitboxBinder)
	addBinder(self, TagBinder.Tags.Loot, LootBinder)
	addBinder(self, TagBinder.Tags.Magic, MagicBinder)
	addBinder(self, TagBinder.Tags.Melee, MeleeBinder)
	addBinder(self, TagBinder.Tags.Npc, NpcBinder)
	addBinder(self, TagBinder.Tags.Pickup, PickupBinder)
	addBinder(self, TagBinder.Tags.Placeable, PlaceableBinder)
	addBinder(self, TagBinder.Tags.Ragdoll, RagdollBinder)
	addBinder(self, TagBinder.Tags.Station, StationBinder)
	addBinder(self, TagBinder.Tags.Unit, UnitBinder)
end)

return ServerBinderSupport
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="1022">
              <Properties>
                <string name="Name">ServerChunkBinder</string>
                <string name="Source"><![CDATA[--!strict

local ModelBinder = require(script:FindFirstAncestor("game").Shared.Binders.ModelBinder)

local ServerChunkBinder = {}
ServerChunkBinder.__index = ServerChunkBinder
setmetatable(ServerChunkBinder, ModelBinder)

local function parseChunkKey(chunkKeyRaw: any): (number?, number?)
	if typeof(chunkKeyRaw) ~= "string" then
		return nil, nil
	end

	local xRaw, yRaw = string.match(chunkKeyRaw, "^(-?%d+):(-?%d+)$")
	if xRaw == nil or yRaw == nil then
		return nil, nil
	end

	return tonumber(xRaw), tonumber(yRaw)
end

function ServerChunkBinder.new(instance: any, context: any)
	local self = ModelBinder.new(instance, context, ServerChunkBinder) :: any
	self.model = self:GetModel()
	self.chunkKey = ""
	self.chunkX = nil :: number?
	self.chunkY = nil :: number?

	self:updateMetadata()
	self:ObserveAttribute("ChunkKey", function()
		self:updateMetadata()
	end)

	return self
end

function ServerChunkBinder.updateMetadata(self: any)
	local chunkKey = self.instance:GetAttribute("ChunkKey")
	if typeof(chunkKey) ~= "string" then
		chunkKey = ""
	end

	self.chunkKey = chunkKey
	self.chunkX, self.chunkY = parseChunkKey(chunkKey)
	self.instance:SetAttribute("ServerChunkTagged", true)
	self.instance:SetAttribute("ServerChunkBinderKey", chunkKey)
	self.instance:SetAttribute("ServerChunkBinderReady", true)
end

function ServerChunkBinder.GetChunkKey(self: any): string
	return self.chunkKey
end

function ServerChunkBinder.GetChunkCoordinates(self: any): (number?, number?)
	return self.chunkX, self.chunkY
end

return ServerChunkBinder
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="1023">
              <Properties>
                <string name="Name">StationBinder</string>
                <string name="Source"><![CDATA[--!strict

local ModelBinder = require(script:FindFirstAncestor("game").Shared.Binders.ModelBinder)
local TagBinder = require(script:FindFirstAncestor("game").Shared.Binders.TagBinder)

local StationBinder = {}
StationBinder.__index = StationBinder
setmetatable(StationBinder, ModelBinder)

local STATION_ID_BY_TAG = {
	[TagBinder.Tags.Station_Workbench] = "Workbench",
	[TagBinder.Tags.Station_Furnace] = "Furnace",
	[TagBinder.Tags.Station_Anvil] = "Anvil",
	[TagBinder.Tags.Station_AlchemyTable] = "AlchemyTable",
}

function StationBinder.new(instance: Instance, context: any)
	local self = ModelBinder.new(instance, context, StationBinder)
	self:updateMetadata()
	return self
end

function StationBinder.resolveStationId(self: any): string
	for tag, stationId in STATION_ID_BY_TAG do
		if self:HasTag(tag) then
			return stationId
		end
	end

	local attributeId = self.instance:GetAttribute("StationId")
	if typeof(attributeId) == "string" and attributeId ~= "" then
		return attributeId
	end

	return "Station"
end

function StationBinder.updateMetadata(self: any)
	local stationId = self:resolveStationId()
	self.instance:SetAttribute("StationTagged", true)
	self.instance:SetAttribute("StationId", stationId)
	if self.instance:GetAttribute("UseActionText") == nil then
		self.instance:SetAttribute("UseActionText", "Use")
	end
	if self.instance:GetAttribute("UseObjectText") == nil then
		self.instance:SetAttribute("UseObjectText", stationId)
	end
end

return StationBinder
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="1024">
              <Properties>
                <string name="Name">UnitBinder</string>
                <string name="Source"><![CDATA[--!strict

local BossServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.BossServiceUtils)
local ModelBinder = require(script:FindFirstAncestor("game").Shared.Binders.ModelBinder)
local NpcServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.NpcServiceUtils)
local TagBinder = require(script:FindFirstAncestor("game").Shared.Binders.TagBinder)

local UnitBinder = {}
UnitBinder.__index = UnitBinder
setmetatable(UnitBinder, ModelBinder)

local function resolveUnitKind(self: any): string
	if self:HasTag(TagBinder.Tags.Character) then
		return "Character"
	end
	if self:HasTag(TagBinder.Tags.Boss) then
		return "Boss"
	end
	if self:HasTag(TagBinder.Tags.Npc) then
		return "Npc"
	end
	return "Unit"
end

function UnitBinder.new(instance: Instance, context: any)
	local self = ModelBinder.new(instance, context, UnitBinder)
	self.model = self:GetModel()
	self.humanoid = self:GetHumanoid()

	if self.model ~= nil then
		self:updateState()
	end
	if self.humanoid ~= nil then
		self:Connect(self.humanoid.HealthChanged, function()
			self:updateState()
		end)
		self:Connect(self.humanoid:GetPropertyChangedSignal("MaxHealth"), function()
			self:updateState()
		end)
		self:Connect(self.humanoid.Died, function()
			self:updateState()
		end)
	end

	return self
end

function UnitBinder.updateState(self: any)
	local model = self.model
	if model == nil then
		return
	end

	local humanoid = model:FindFirstChildOfClass("Humanoid")
	self.humanoid = humanoid

	model:SetAttribute("UnitTagged", true)
	model:SetAttribute("UnitKind", resolveUnitKind(self))
	model:SetAttribute("UnitAlive", humanoid ~= nil and humanoid.Health > 0)

	if humanoid ~= nil then
		model:SetAttribute("UnitHealth", humanoid.Health)
		model:SetAttribute("UnitMaxHealth", humanoid.MaxHealth)
	end

	local bossRuntimeId = BossServiceUtils.resolveRuntimeIdFromInstance(model)
	if bossRuntimeId ~= nil then
		model:SetAttribute("UnitRuntimeId", bossRuntimeId)
		return
	end

	local npcRuntimeId = NpcServiceUtils.resolveRuntimeIdFromInstance(model)
	if npcRuntimeId ~= nil then
		model:SetAttribute("UnitRuntimeId", npcRuntimeId)
	end
end

return UnitBinder
]]></string>
