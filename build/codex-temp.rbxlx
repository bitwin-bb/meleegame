          <Item class="ModuleScript" referent="1090">
            <Properties>
              <string name="Name">AquariaBackupTranslator</string>
              <string name="Source"><![CDATA[--!strict
--[[
	@class AquariaBackupTranslator
]]

local packageRoot = script:FindFirstAncestor("game").Parent
local loaderUtils = assert(packageRoot:FindFirstChild("LoaderUtils", true), "Missing LoaderUtils")
local loader = require(loaderUtils.Parent).load(script)

return loader("JSONTranslator").new("AquariaBackupTranslator", "en", {
	gameName = "AquariaBackup",
	notifications = {
		build = {
			place = {
				generic = "Can't place that there.",
				invalid_tile_coordinate_or_id = "That placement target is invalid.",
				selected_item_not_placeable = "That item can't be placed.",
				selected_item_tile_mismatch = "That item does not match this tile.",
				tile_out_of_bounds = "You can't build there.",
				out_of_range = "You're too far away to build there.",
				occupied = "That space is already occupied.",
				missing_support = "That tile needs support first.",
				cannot_place_air = "Air can't be placed.",
				empty_footprint = "That item has nothing to place.",
			},
			["break"] = {
				generic = "Can't break that right now.",
				invalid_tile_coordinate = "That break target is invalid.",
				tile_out_of_bounds = "You can't break that there.",
				out_of_range = "You're too far away to break that.",
				input_timeout = "Breaking timed out.",
				invalid_target = "There's nothing valid to break there.",
				air = "There's nothing there.",
				tree_already_felled = "That tree is already down.",
				tile_requires_pickaxe = "You need a pickaxe for that.",
				insufficient_pickaxe_power = "Your pickaxe isn't strong enough.",
				invalid_tile_id = "That tile can't be broken.",
			},
		},
		crafting = {
			success = "Crafted {quantity}x {itemName}",
			failure = {
				generic = "Crafting failed.",
				not_ready = "Crafting isn't ready yet.",
				rate_limited = "You're crafting too quickly.",
				invalid_request = "That craft request is invalid.",
				invalid_recipe = "That recipe doesn't exist.",
				recipe_locked = "You haven't unlocked that recipe yet.",
				busy = "Crafting is busy right now.",
				missing_station = "You need the right crafting station.",
				wrong_biome = "You need to be in the right biome.",
				transaction_error = "Crafting hit an internal error.",
				missing_items = "You don't have the required materials.",
				inventory_full = "Your inventory is full.",
			},
		},
	},
})
]]></string>
            </Properties>
          </Item>
          <Item class="Folder" referent="1091">
            <Properties>
              <string name="Name">Binders</string>
            </Properties>
            <Item class="ModuleScript" referent="1092">
              <Properties>
                <string name="Name">ModelBinder</string>
                <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")

local packageRoot = script:FindFirstAncestor("game").Parent
local loaderUtils = assert(packageRoot:FindFirstChild("LoaderUtils", true), "Missing LoaderUtils")
local loader = require(loaderUtils.Parent).load(script)
local Maid = loader("Maid")
local InstanceUtils = require(script:FindFirstAncestor("game").Shared.Modules.Platform.InstanceUtils)
local TagBinder = require(script.Parent.TagBinder)

type MaidClass = {
	GiveTask: (self: MaidClass, task: any) -> any,
	DoCleaning: (self: MaidClass) -> (),
	Destroy: (self: MaidClass) -> (),
}

export type BinderContext = {
	tags: { string }?,
	serviceBag: any?,
}

local ModelBinder = {}
ModelBinder.__index = ModelBinder

export type ModelBinder = typeof(setmetatable(
	{} :: {
		instance: Instance,
		janitor: MaidClass,
		context: BinderContext?,
		destroyed: boolean,
	},
	ModelBinder
))

local function createJanitor(): MaidClass
	return Maid.new() :: MaidClass
end

function ModelBinder.CollectBaseParts(instanceRaw: any): { BasePart }
	if typeof(instanceRaw) ~= "Instance" then
		return {}
	end

	local instance = instanceRaw :: Instance
	if instance:IsA("BasePart") then
		return { instance }
	end

	local parts = {}
	for _, descendant in instance:GetDescendants() do
		if descendant:IsA("BasePart") then
			parts[#parts + 1] = descendant
		end
	end
	return parts
end

function ModelBinder.CollectLights(instanceRaw: any): { Instance }
	if typeof(instanceRaw) ~= "Instance" then
		return {}
	end

	local instance = instanceRaw :: Instance
	local lights = {}
	for _, descendant in instance:GetDescendants() do
		if descendant:IsA("PointLight") or descendant:IsA("SpotLight") or descendant:IsA("SurfaceLight") then
			lights[#lights + 1] = descendant
		end
	end
	return lights
end

function ModelBinder.BindTouchedParts(instanceRaw: any, janitor: any, callback: (part: BasePart, other: BasePart) -> ())
	if typeof(instanceRaw) ~= "Instance" then
		return
	end

	local bound = {} :: { [BasePart]: boolean }
	local instance = instanceRaw :: Instance

	local function bindPart(part: BasePart)
		if bound[part] == true then
			return
		end

		bound[part] = true
		janitor:GiveTask(part.Touched:Connect(function(other: BasePart)
			callback(part, other)
		end))
	end

	for _, part in ModelBinder.CollectBaseParts(instance) do
		bindPart(part)
	end

	janitor:GiveTask(instance.DescendantAdded:Connect(function(descendant: Instance)
		if descendant:IsA("BasePart") then
			bindPart(descendant)
		end
	end))
end

function ModelBinder.ResolveModel(instanceRaw: any): Model?
	if typeof(instanceRaw) ~= "Instance" then
		return nil
	end

	local instance = instanceRaw :: Instance
	if instance:IsA("Model") then
		return instance
	end

	return instance:FindFirstAncestorOfClass("Model")
end

function ModelBinder.ResolveHumanoid(instanceRaw: any): Humanoid?
	local model = ModelBinder.ResolveModel(instanceRaw)
	if model == nil then
		return nil
	end
	return model:FindFirstChildOfClass("Humanoid")
end

function ModelBinder.ResolvePlayer(instanceRaw: any): Player?
	local model = ModelBinder.ResolveModel(instanceRaw)
	if model == nil then
		return nil
	end
	return Players:GetPlayerFromCharacter(model)
end

function ModelBinder.ResolveRootPart(instanceRaw: any): BasePart?
	if typeof(instanceRaw) ~= "Instance" then
		return nil
	end

	local instance = instanceRaw :: Instance
	if instance:IsA("BasePart") then
		return instance
	end

	return InstanceUtils.resolveInstanceRootPart(instance, false)
end

function ModelBinder.ResolveAdornee(instanceRaw: any): Instance?
	if typeof(instanceRaw) ~= "Instance" then
		return nil
	end

	local instance = instanceRaw :: Instance
	if instance:IsA("Model") then
		return instance
	end

	local model = instance:FindFirstAncestorOfClass("Model")
	if model ~= nil then
		return model
	end

	return ModelBinder.ResolveRootPart(instance)
end

function ModelBinder.ResolveWorldPosition(instanceRaw: any): Vector3?
	if typeof(instanceRaw) ~= "Instance" then
		return nil
	end

	local instance = instanceRaw :: Instance
	if instance:IsA("Attachment") then
		return instance.WorldPosition
	end

	local rootPart = ModelBinder.ResolveRootPart(instance)
	if rootPart ~= nil then
		return rootPart.Position
	end

	return nil
end

function ModelBinder.new(instanceRaw: any, contextRaw: any, classRaw: any?): ModelBinder
	if typeof(instanceRaw) ~= "Instance" then
		error("ModelBinder.new expects an Instance")
	end

	local class = if typeof(classRaw) == "table" then classRaw else ModelBinder
	local self = setmetatable({
		instance = instanceRaw,
		janitor = createJanitor(),
		context = if typeof(contextRaw) == "table" then contextRaw else nil,
		destroyed = false,
	}, class)

	self.janitor:GiveTask(self.instance.Destroying:Connect(function()
		self:Destroy()
	end))

	return self
end

function ModelBinder.GetModel(self: ModelBinder): Model?
	local instance = self.instance
	if instance:IsA("Model") then
		return instance
	end
	return instance:FindFirstAncestorOfClass("Model")
end

function ModelBinder.GetHumanoid(self: ModelBinder): Humanoid?
	local model = self:GetModel()
	if model == nil then
		return nil
	end
	return model:FindFirstChildOfClass("Humanoid")
end

function ModelBinder.GetRootPart(self: ModelBinder): BasePart?
	local instance = self.instance
	if instance:IsA("BasePart") then
		return instance
	end

	local model = self:GetModel()
	if model ~= nil then
		return InstanceUtils.resolveModelRootPart(model, false)
	end

	return InstanceUtils.resolveInstanceRootPart(instance, false)
end

function ModelBinder.HasTag(self: ModelBinder, tagRaw: any): boolean
	return TagBinder.hasTag(self.instance, tagRaw)
end

function ModelBinder.GetMatchedTags(self: ModelBinder): { string }
	local context = self.context
	if context == nil then
		return {}
	end

	return TagBinder.getMatchedTags(self.instance, context.tags)
end

function ModelBinder.Connect(self: ModelBinder, signal: RBXScriptSignal, callback: (...any) -> ()): RBXScriptConnection
	local connection = signal:Connect(callback)
	self.janitor:GiveTask(connection)
	return connection
end

function ModelBinder.ObserveAttribute(
	self: ModelBinder,
	attributeName: string,
	callback: (nextValue: any, instance: Instance) -> ()
): RBXScriptConnection
	callback(self.instance:GetAttribute(attributeName), self.instance)
	return self:Connect(self.instance:GetAttributeChangedSignal(attributeName), function()
		callback(self.instance:GetAttribute(attributeName), self.instance)
	end)
end

function ModelBinder.AddCleanup(self: ModelBinder, cleanup: any, ...: any)
	return self.janitor:GiveTask(cleanup)
end

function ModelBinder.Destroy(self: ModelBinder)
	if self.destroyed then
		return
	end

	self.destroyed = true
	local cleanupMethod = (getmetatable(self) :: any).Cleanup
	if typeof(cleanupMethod) == "function" then
		pcall(cleanupMethod, self)
	end

	self.janitor:Destroy()
end

ModelBinder.getModel = ModelBinder.GetModel
ModelBinder.getHumanoid = ModelBinder.GetHumanoid
ModelBinder.getRootPart = ModelBinder.GetRootPart
ModelBinder.collectBaseParts = ModelBinder.CollectBaseParts
ModelBinder.collectLights = ModelBinder.CollectLights
ModelBinder.bindTouchedParts = ModelBinder.BindTouchedParts
ModelBinder.resolveModel = ModelBinder.ResolveModel
ModelBinder.resolveHumanoid = ModelBinder.ResolveHumanoid
ModelBinder.resolvePlayer = ModelBinder.ResolvePlayer
ModelBinder.resolveRootPart = ModelBinder.ResolveRootPart
ModelBinder.resolveAdornee = ModelBinder.ResolveAdornee
ModelBinder.resolveWorldPosition = ModelBinder.ResolveWorldPosition
ModelBinder.hasTag = ModelBinder.HasTag
ModelBinder.getMatchedTags = ModelBinder.GetMatchedTags
ModelBinder.connect = ModelBinder.Connect
ModelBinder.observeAttribute = ModelBinder.ObserveAttribute
ModelBinder.addCleanup = ModelBinder.AddCleanup
ModelBinder.destroy = ModelBinder.Destroy

return ModelBinder
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="1093">
              <Properties>
                <string name="Name">TagBinder</string>
                <string name="Source"><![CDATA[--!strict

local CollectionService = game:GetService("CollectionService")

local TagBinder = {}

local function trimTag(valueRaw: any): string?
	if typeof(valueRaw) ~= "string" then
		return nil
	end

	local value = string.match(valueRaw, "^%s*(.-)%s*$")
	if value == nil or value == "" then
		return nil
	end

	return value
end

local function copyStringList(source: { string }): { string }
	local list = table.create(#source)
	for index, value in source do
		list[index] = value
	end
	return list
end

local function freezeDictionary<T>(source: T): T
	return table.freeze(source)
end

local Tags = freezeDictionary({
	Npc = "Npc",
	Npc_Slime = "Npc_Slime",
	Npc_Flying = "Npc_Flying",
	Npc_Ground = "Npc_Ground",
	Boss = "Boss",
	Boss_EyeOfCthulhu = "Boss_EyeOfCthulhu",
	Unit = "Unit",
	Hitbox = "Hitbox",
	Loot = "Loot",
	Drop = "Drop",
	Pickup = "Pickup",
	Station = "Station",
	Station_Workbench = "Station_Workbench",
	Station_Furnace = "Station_Furnace",
	Station_Anvil = "Station_Anvil",
	Station_AlchemyTable = "Station_AlchemyTable",
	Placeable = "Placeable",
	Placeable_Torch = "Placeable_Torch",
	Placeable_Workbench = "Placeable_Workbench",
	Light_Torch = "Light_Torch",
	Foliage = "Foliage",
	Disturber = "Disturber",
	Ragdoll = "Ragdoll",
	Gore = "Gore",
	Gore_Slime = "Gore_Slime",
	Gore_Humanoid = "Gore_Humanoid",
	Gore_Boss = "Gore_Boss",
	Melee = "Melee",
	Melee_Shortsword = "Melee_Shortsword",
	Melee_Broadsword = "Melee_Broadsword",
	Melee_Katana = "Melee_Katana",
	Magic = "Magic",
	Use = "Use",
	Chunk = "Chunk",
	Character = "Character",
	Hazard = "Hazard",
	Hazard_Lava = "Hazard_Lava",
	Hazard_Spikes = "Hazard_Spikes",
	Hazard_Poison = "Hazard_Poison",
	Liquid = "Liquid",
	Breath = "Breath",
	Breath_Water = "Breath_Water",
	Breath_Air = "Breath_Air",
	Audio = "Audio",
	Layer = "Layer",
	Preview = "Preview",
	Breakable = "Breakable",
})

local LegacyAliases = freezeDictionary({
	[Tags.Station_Workbench] = table.freeze({ "CraftingStation_Workbench" }),
	[Tags.Station_Furnace] = table.freeze({ "CraftingStation_Furnace" }),
	[Tags.Station_Anvil] = table.freeze({ "CraftingStation_Anvil" }),
	[Tags.Station_AlchemyTable] = table.freeze({ "CraftingStation_AlchemyTable" }),
	[Tags.Light_Torch] = table.freeze({ "LightSource_Torch" }),
	[Tags.Foliage] = table.freeze({ "WindFoliage" }),
	[Tags.Disturber] = table.freeze({ "WindFoliageDisturber" }),
})

local ImpliedTags = freezeDictionary({
	[Tags.Npc] = table.freeze({ Tags.Unit }),
	[Tags.Npc_Slime] = table.freeze({ Tags.Npc }),
	[Tags.Npc_Flying] = table.freeze({ Tags.Npc }),
	[Tags.Npc_Ground] = table.freeze({ Tags.Npc }),
	[Tags.Boss] = table.freeze({ Tags.Unit }),
	[Tags.Boss_EyeOfCthulhu] = table.freeze({ Tags.Boss }),
	[Tags.Character] = table.freeze({ Tags.Unit }),
	[Tags.Station_Workbench] = table.freeze({ Tags.Station, Tags.Use }),
	[Tags.Station_Furnace] = table.freeze({ Tags.Station, Tags.Use }),
	[Tags.Station_Anvil] = table.freeze({ Tags.Station, Tags.Use }),
	[Tags.Station_AlchemyTable] = table.freeze({ Tags.Station, Tags.Use }),
	[Tags.Placeable_Torch] = table.freeze({ Tags.Placeable, Tags.Light_Torch }),
	[Tags.Placeable_Workbench] = table.freeze({ Tags.Placeable, Tags.Station_Workbench }),
	[Tags.Gore_Slime] = table.freeze({ Tags.Gore }),
	[Tags.Gore_Humanoid] = table.freeze({ Tags.Gore }),
	[Tags.Gore_Boss] = table.freeze({ Tags.Gore }),
	[Tags.Melee_Shortsword] = table.freeze({ Tags.Melee }),
	[Tags.Melee_Broadsword] = table.freeze({ Tags.Melee }),
	[Tags.Melee_Katana] = table.freeze({ Tags.Melee }),
	[Tags.Hazard_Lava] = table.freeze({ Tags.Hazard }),
	[Tags.Hazard_Spikes] = table.freeze({ Tags.Hazard }),
	[Tags.Hazard_Poison] = table.freeze({ Tags.Hazard }),
	[Tags.Breath_Water] = table.freeze({ Tags.Breath }),
	[Tags.Breath_Air] = table.freeze({ Tags.Breath }),
})

local CanonicalTags = {}
local CanonicalTagLookup = {} :: { [string]: boolean }
local CanonicalByAlias = {} :: { [string]: string }
local DirectImplyingTags = {} :: { [string]: { string } }

for _, canonicalTag in Tags do
	CanonicalTags[#CanonicalTags + 1] = canonicalTag
	CanonicalTagLookup[canonicalTag] = true
	CanonicalByAlias[canonicalTag] = canonicalTag
end

for canonicalTag, aliases in LegacyAliases do
	for _, alias in aliases do
		CanonicalByAlias[alias] = canonicalTag
	end
end

for sourceTag, impliedList in ImpliedTags do
	for _, impliedTag in impliedList do
		local implyingList = DirectImplyingTags[impliedTag]
		if implyingList == nil then
			implyingList = {}
			DirectImplyingTags[impliedTag] = implyingList
		end
		implyingList[#implyingList + 1] = sourceTag
	end
end

local function normalizeTagList(tagsRaw: any): { string }
	local normalized = {}
	local seen = {} :: { [string]: boolean }

	local function appendTag(tagRaw: any)
		local tag = TagBinder.getCanonicalTag(tagRaw)
		if tag == nil or seen[tag] == true then
			return
		end

		seen[tag] = true
		normalized[#normalized + 1] = tag
	end

	if typeof(tagsRaw) == "table" then
		for _, tagRaw in tagsRaw do
			appendTag(tagRaw)
		end
	else
		appendTag(tagsRaw)
	end

	return normalized
end

local function collectImpliedTags(canonicalTag: string, output: { string }, seen: { [string]: boolean })
	local implied = ImpliedTags[canonicalTag]
	if implied == nil then
		return
	end

	for _, impliedTag in implied do
		if seen[impliedTag] == true then
			continue
		end

		seen[impliedTag] = true
		output[#output + 1] = impliedTag
		collectImpliedTags(impliedTag, output, seen)
	end
end

local function collectObservedTags(canonicalTag: string, output: { string }, seen: { [string]: boolean })
	if seen[canonicalTag] ~= true then
		seen[canonicalTag] = true
		output[#output + 1] = canonicalTag
	end

	local aliases = LegacyAliases[canonicalTag]
	if aliases ~= nil then
		for _, alias in aliases do
			if seen[alias] == true then
				continue
			end

			seen[alias] = true
			output[#output + 1] = alias
		end
	end

	local implyingTags = DirectImplyingTags[canonicalTag]
	if implyingTags == nil then
		return
	end

	for _, implyingTag in implyingTags do
		collectObservedTags(implyingTag, output, seen)
	end
end

local function getTagService(collectionServiceRaw: any?): any
	if collectionServiceRaw ~= nil then
		return collectionServiceRaw
	end

	return CollectionService
end

local function addCanonicalTag(instance: Instance, canonicalTag: string, tagService: any, seen: { [string]: boolean })
	if seen[canonicalTag] == true then
		return
	end

	seen[canonicalTag] = true
	if not tagService:HasTag(instance, canonicalTag) then
		tagService:AddTag(instance, canonicalTag)
	end

	local implied = ImpliedTags[canonicalTag]
	if implied == nil then
		return
	end

	for _, impliedTag in implied do
		addCanonicalTag(instance, impliedTag, tagService, seen)
	end
end

function TagBinder.getCanonicalTag(tagRaw: any): string?
	local tag = trimTag(tagRaw)
	if tag == nil then
		return nil
	end

	return CanonicalByAlias[tag]
end

function TagBinder.getCanonicalTags(): { string }
	return copyStringList(CanonicalTags)
end

function TagBinder.normalizeTags(tagsRaw: any): { string }
	return normalizeTagList(tagsRaw)
end

function TagBinder.getLegacyAliases(tagRaw: any): { string }
	local canonicalTag = TagBinder.getCanonicalTag(tagRaw)
	if canonicalTag == nil then
		return {}
	end

	local aliases = LegacyAliases[canonicalTag]
	if aliases == nil then
		return {}
	end

	return copyStringList(aliases)
end

function TagBinder.getImpliedTags(tagRaw: any): { string }
	local canonicalTag = TagBinder.getCanonicalTag(tagRaw)
	if canonicalTag == nil then
		return {}
	end

	local output = {}
	local seen = {} :: { [string]: boolean }
	collectImpliedTags(canonicalTag, output, seen)
	return output
end

function TagBinder.getObservedTags(tagRaw: any): { string }
	local canonicalTag = TagBinder.getCanonicalTag(tagRaw)
	if canonicalTag == nil then
		return {}
	end

	local output = {}
	local seen = {} :: { [string]: boolean }
	collectObservedTags(canonicalTag, output, seen)
	return output
end

function TagBinder.hasTag(instanceRaw: any, tagRaw: any, collectionServiceRaw: any?): boolean
	if typeof(instanceRaw) ~= "Instance" then
		return false
	end

	local observedTags = TagBinder.getObservedTags(tagRaw)
	if #observedTags <= 0 then
		return false
	end

	local tagService = getTagService(collectionServiceRaw)
	for _, observedTag in observedTags do
		if tagService:HasTag(instanceRaw, observedTag) then
			return true
		end
	end

	return false
end

function TagBinder.hasAnyTag(instanceRaw: any, tagsRaw: any, collectionServiceRaw: any?): boolean
	for _, tag in normalizeTagList(tagsRaw) do
		if TagBinder.hasTag(instanceRaw, tag, collectionServiceRaw) then
			return true
		end
	end

	return false
end

function TagBinder.getMatchedTags(instanceRaw: any, tagsRaw: any, collectionServiceRaw: any?): { string }
	local matched = {}
	for _, tag in normalizeTagList(tagsRaw) do
		if TagBinder.hasTag(instanceRaw, tag, collectionServiceRaw) then
			matched[#matched + 1] = tag
		end
	end
	return matched
end

function TagBinder.applyTag(instanceRaw: any, tagRaw: any, collectionServiceRaw: any?): boolean
	if typeof(instanceRaw) ~= "Instance" then
		return false
	end

	local canonicalTag = TagBinder.getCanonicalTag(tagRaw)
	if canonicalTag == nil then
		return false
	end

	local instance = instanceRaw :: Instance
	local tagService = getTagService(collectionServiceRaw)
	local rawTag = trimTag(tagRaw)
	if rawTag ~= nil and rawTag ~= canonicalTag and not tagService:HasTag(instance, rawTag) then
		tagService:AddTag(instance, rawTag)
	end

	addCanonicalTag(instance, canonicalTag, tagService, {})
	return true
end

function TagBinder.applyTags(instanceRaw: any, tagsRaw: any, collectionServiceRaw: any?): number
	if typeof(instanceRaw) ~= "Instance" then
		return 0
	end

	local appliedCount = 0
	for _, tag in normalizeTagList(tagsRaw) do
		if TagBinder.applyTag(instanceRaw, tag, collectionServiceRaw) then
			appliedCount += 1
		end
	end

	return appliedCount
end

function TagBinder.getTagged(tagRaw: any, collectionServiceRaw: any?): { Instance }
	local observedTags = TagBinder.getObservedTags(tagRaw)
	if #observedTags <= 0 then
		return {}
	end

	local tagService = getTagService(collectionServiceRaw)
	local seen = {} :: { [Instance]: boolean }
	local results = {}

	for _, observedTag in observedTags do
		for _, instance in tagService:GetTagged(observedTag) do
			if seen[instance] == true then
				continue
			end

			seen[instance] = true
			results[#results + 1] = instance
		end
	end

	return results
end

TagBinder.Tags = Tags
TagBinder.LegacyAliases = LegacyAliases
TagBinder.ImpliedTags = ImpliedTags
TagBinder.CanonicalTagLookup = CanonicalTagLookup

TagBinder.getCanonicalTag = TagBinder.getCanonicalTag
TagBinder.getCanonicalTags = TagBinder.getCanonicalTags
TagBinder.normalizeTags = TagBinder.normalizeTags
TagBinder.getLegacyAliases = TagBinder.getLegacyAliases
TagBinder.getImpliedTags = TagBinder.getImpliedTags
TagBinder.getObservedTags = TagBinder.getObservedTags
TagBinder.hasTag = TagBinder.hasTag
TagBinder.hasAnyTag = TagBinder.hasAnyTag
TagBinder.getMatchedTags = TagBinder.getMatchedTags
TagBinder.applyTag = TagBinder.applyTag
TagBinder.applyTags = TagBinder.applyTags
TagBinder.getTagged = TagBinder.getTagged

return TagBinder
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="1094">
              <Properties>
                <string name="Name">ToolBinder</string>
                <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")

local ItemRegistry = require(script:FindFirstAncestor("game").Shared.Modules.Items.Registry)
local MagicServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.MagicServiceUtils)
local MeleeServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.MeleeServiceUtils)
local ResolveItem = require(script:FindFirstAncestor("game").Shared.Modules.Game.Format.ResolveItem)
local ResolveToolInstance = require(script:FindFirstAncestor("game").Shared.Modules.Game.Format.ResolveToolInstance)
local TagBinder = require(script.Parent.TagBinder)

local ToolBinder = {}

export type ToolResolution = {
	tool: Tool?,
	itemId: string?,
	itemType: string?,
	definition: { [string]: any }?,
	primaryTemplate: Instance?,
	toolTemplate: Tool?,
	ownerPlayer: Player?,
	ownerCharacter: Model?,
	deployable: { [string]: any }?,
	isMelee: boolean,
	isMagic: boolean,
	meleeVariantTag: string?,
}

local function normalizeToken(valueRaw: any): string
	if typeof(valueRaw) ~= "string" then
		return ""
	end

	local compact = string.gsub(string.lower(valueRaw), "[%s_%-]+", "")
	return compact
end

local function resolveOwnerPlayer(tool: Tool?): (Player?, Model?)
	if tool == nil then
		return nil, nil
	end

	local parent = tool.Parent
	while parent ~= nil do
		if parent:IsA("Backpack") then
			local player = parent.Parent
			if player ~= nil and player:IsA("Player") then
				return player, player.Character
			end
		elseif parent:IsA("Model") then
			local player = Players:GetPlayerFromCharacter(parent)
			if player ~= nil then
				return player, parent
			end
		end

		parent = parent.Parent
	end

	return nil, nil
end

local function resolveMeleeVariantTag(itemIdRaw: any, definitionRaw: any): string?
	local itemId = normalizeToken(itemIdRaw)
	local displayName = if typeof(definitionRaw) == "table"
		then normalizeToken((definitionRaw :: { [string]: any }).name)
		else ""
	local combined = itemId .. displayName

	if string.find(combined, "katana", 1, true) ~= nil then
		return TagBinder.Tags.Melee_Katana
	end
	if string.find(combined, "broadsword", 1, true) ~= nil then
		return TagBinder.Tags.Melee_Broadsword
	end
	if string.find(combined, "shortsword", 1, true) ~= nil then
		return TagBinder.Tags.Melee_Shortsword
	end

	return nil
end

local function isMagicDefinition(definitionRaw: any, itemTypeRaw: any, toolRaw: any): boolean
	local typeToken = normalizeToken(itemTypeRaw)
	if typeToken == "magicweapon" or typeToken == "magic" or typeToken == "staff" or typeToken == "spell" then
		return true
	end

	if toolRaw ~= nil and MagicServiceUtils.isMagicTool(toolRaw) then
		return true
	end

	if typeof(definitionRaw) ~= "table" then
		return false
	end

	local definition = definitionRaw :: { [string]: any }
	return definition.manaCost ~= nil
		or definition.castTime ~= nil
		or definition.cooldown ~= nil
		or definition.projectile ~= nil
		or definition.effects ~= nil
end

function ToolBinder.Resolve(toolOrInstanceRaw: any): ToolResolution
	local tool = ResolveToolInstance.resolveTool(toolOrInstanceRaw)
	local itemId = ResolveToolInstance.resolveToolItemId(tool)
	local itemType = ResolveToolInstance.resolveToolItemType(tool)
	local definition = if itemId ~= nil then ItemRegistry.resolveDefinition(itemId) else nil
	local templates = if itemId ~= nil
		then ResolveItem.resolve(itemId)
		else { primaryTemplate = nil, toolTemplate = nil }
	local ownerPlayer, ownerCharacter = resolveOwnerPlayer(tool)
	local deployable = if typeof(definition) == "table"
			and typeof((definition :: { [string]: any }).deployable) == "table"
		then (definition :: { [string]: any }).deployable :: { [string]: any }
		else nil
	local isMelee = if itemId ~= nil
		then MeleeServiceUtils.resolveWeaponConfig(itemId) ~= nil or MeleeServiceUtils.isMeleeTool(tool)
		else false
	local isMagic = isMagicDefinition(definition, itemType, tool)

	return {
		tool = tool,
		itemId = itemId,
		itemType = itemType,
		definition = definition,
		primaryTemplate = templates.primaryTemplate,
		toolTemplate = templates.toolTemplate,
		ownerPlayer = ownerPlayer,
		ownerCharacter = ownerCharacter,
		deployable = deployable,
		isMelee = isMelee,
		isMagic = isMagic,
		meleeVariantTag = resolveMeleeVariantTag(itemId, definition),
	}
end

function ToolBinder.ResolveTool(toolOrInstanceRaw: any): Tool?
	return ToolBinder.Resolve(toolOrInstanceRaw).tool
end

function ToolBinder.ResolveItemId(toolOrInstanceRaw: any): string?
	return ToolBinder.Resolve(toolOrInstanceRaw).itemId
end

function ToolBinder.ResolveDefinition(toolOrInstanceRaw: any): { [string]: any }?
	return ToolBinder.Resolve(toolOrInstanceRaw).definition
end

function ToolBinder.ResolveDeployable(toolOrInstanceRaw: any): { [string]: any }?
	return ToolBinder.Resolve(toolOrInstanceRaw).deployable
end

function ToolBinder.ResolveStationTag(toolOrInstanceRaw: any): string?
	local resolution = ToolBinder.Resolve(toolOrInstanceRaw)
	if resolution.deployable == nil then
		return nil
	end

	return TagBinder.getCanonicalTag(resolution.deployable.stationTag)
end

function ToolBinder.IsMelee(toolOrInstanceRaw: any): boolean
	return ToolBinder.Resolve(toolOrInstanceRaw).isMelee
end

function ToolBinder.IsMagic(toolOrInstanceRaw: any): boolean
	return ToolBinder.Resolve(toolOrInstanceRaw).isMagic
end

function ToolBinder.ResolveMeleeVariantTag(toolOrInstanceRaw: any): string?
	return ToolBinder.Resolve(toolOrInstanceRaw).meleeVariantTag
end

function ToolBinder.ApplyTags(toolOrInstanceRaw: any): number
	local resolution = ToolBinder.Resolve(toolOrInstanceRaw)
	if resolution.tool == nil then
		return 0
	end

	local tags = {}
	if resolution.isMelee then
		tags[#tags + 1] = TagBinder.Tags.Melee
		if resolution.meleeVariantTag ~= nil then
			tags[#tags + 1] = resolution.meleeVariantTag
		end
	end
	if resolution.isMagic then
		tags[#tags + 1] = TagBinder.Tags.Magic
	end

	if #tags <= 0 then
		return 0
	end

	return TagBinder.applyTags(resolution.tool, tags)
end

ToolBinder.resolve = ToolBinder.Resolve
ToolBinder.resolveTool = ToolBinder.ResolveTool
ToolBinder.resolveItemId = ToolBinder.ResolveItemId
ToolBinder.resolveDefinition = ToolBinder.ResolveDefinition
ToolBinder.resolveDeployable = ToolBinder.ResolveDeployable
ToolBinder.resolveStationTag = ToolBinder.ResolveStationTag
ToolBinder.isMelee = ToolBinder.IsMelee
ToolBinder.isMagic = ToolBinder.IsMagic
ToolBinder.resolveMeleeVariantTag = ToolBinder.ResolveMeleeVariantTag
ToolBinder.applyTags = ToolBinder.ApplyTags

return ToolBinder
]]></string>
              </Properties>
            </Item>
