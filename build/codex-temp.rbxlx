}

local LIQUID_BIOME_TINTS: LiquidBiomeTints = {
	byBiomeId = {
		[1] = Color3.fromRGB(52, 60, 133),
		[2] = Color3.fromRGB(141, 116, 68),
		[3] = Color3.fromRGB(39, 90, 114),
