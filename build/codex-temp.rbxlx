		-- return if typeof(snapshotResolverPath) == "string"
		-- 	then createCustomSnapshotResolver(snapshotResolverPath, localRequire):expect()
		-- 	else createDefaultSnapshotResolver()
		return createDefaultSnapshotResolver()
