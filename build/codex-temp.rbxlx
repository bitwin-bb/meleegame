                </Item>
                <Item class="ModuleScript" referent="1085">
                  <Properties>
                    <string name="Name">PlatformServiceUtils.spec</string>
                    <string name="Source"><![CDATA[--!strict
-- selene: allow(undefined_variable)
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local PlatformServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.PlatformServiceUtils)

local DEFAULT_CAPABILITIES: PlatformServiceUtils.CapabilitySnapshot = {
	touchEnabled = false,
	keyboardEnabled = true,
	mouseEnabled = true,
	gamepadEnabled = false,
	basePrimaryInputType = "KeyboardMouse",
}

return function()
	describe("PlatformServiceUtils", function()
		it("prefers PreferredInput when resolving the current platform", function()
			local state =
				PlatformServiceUtils.createPlatformState(Enum.PreferredInput.Gamepad, Enum.UserInputType.MouseButton1, {
					touchEnabled = true,
					keyboardEnabled = true,
					mouseEnabled = true,
					gamepadEnabled = true,
					basePrimaryInputType = "KeyboardMouse",
				}, Vector2.new(1920, 1080), false)

			expect(state.platform).to.equal("Gamepad")
			expect(state.deviceClass).to.equal("Console")
		end)

		it("classifies touch viewports into phone and tablet buckets", function()
			expect(PlatformServiceUtils.resolveDeviceClass("Touch", Vector2.new(390, 844), DEFAULT_CAPABILITIES, false)).to.equal(
				"Phone"
			)
			expect(
				PlatformServiceUtils.resolveDeviceClass("Touch", Vector2.new(1280, 800), DEFAULT_CAPABILITIES, false)
			).to.equal("Tablet")
		end)

		it("applies thumbstick deadzones without losing normalized direction", function()
			local inactive = PlatformServiceUtils.applyThumbstickDeadzone(Vector2.new(0.12, 0), 0.2)
			local active = PlatformServiceUtils.applyThumbstickDeadzone(Vector2.new(0.8, 0), 0.2)

			expect(inactive.Magnitude).to.equal(0)
			expect(active.X ~= 0).to.equal(true)
			expect(math.abs(active.X - 0.75) <= 0.001).to.equal(true)
		end)

		it("returns normalized prompts for each supported gameplay platform", function()
			local definition =
				PlatformServiceUtils.getDefaultActionDefinition(PlatformServiceUtils.ACTIONS.MELEE_ATTACK)
			expect(definition ~= nil).to.equal(true)

			local keyboardPrompt =
				PlatformServiceUtils.resolvePromptForAction(definition, "KeyboardMouse", "Desktop", "xbox")
			local gamepadPrompt = PlatformServiceUtils.resolvePromptForAction(definition, "Gamepad", "Console", "xbox")
			local touchPrompt = PlatformServiceUtils.resolvePromptForAction(definition, "Touch", "Phone", "xbox")

			expect(keyboardPrompt.text).to.equal("LMB")
			expect(gamepadPrompt.text).to.equal("RT")
			expect(typeof(gamepadPrompt.icon)).to.equal("string")
			expect(touchPrompt.text).to.equal("Tap to Attack")
		end)

		it("keeps jump separate from fly-up controls", function()
			local jumpDefinition = PlatformServiceUtils.getDefaultActionDefinition(PlatformServiceUtils.ACTIONS.JUMP)
			local moveUpDefinition =
				PlatformServiceUtils.getDefaultActionDefinition(PlatformServiceUtils.ACTIONS.MOVE_UP)

			expect(jumpDefinition ~= nil).to.equal(true)
			expect(moveUpDefinition ~= nil).to.equal(true)

			local jumpBindings = PlatformServiceUtils.resolveBindingsForPlatform(jumpDefinition, "KeyboardMouse")
			local moveUpBindings = PlatformServiceUtils.resolveBindingsForPlatform(moveUpDefinition, "KeyboardMouse")
			local jumpPrompt =
				PlatformServiceUtils.resolvePromptForAction(jumpDefinition, "KeyboardMouse", "Desktop", "xbox")
			local gamepadJumpPrompt =
				PlatformServiceUtils.resolvePromptForAction(jumpDefinition, "Gamepad", "Console", "xbox")

			expect(#jumpBindings).to.equal(1)
			expect(jumpBindings[1].playerAction).to.equal(Enum.PlayerActions.CharacterJump)
			expect(#moveUpBindings).to.equal(1)
			expect(moveUpBindings[1].playerAction).to.equal(Enum.PlayerActions.CharacterForward)
			expect(jumpPrompt.text).to.equal("Space")
			expect(gamepadJumpPrompt.text).to.equal("A")
		end)

		it("exposes the Xbox inventory prompt on Y", function()
			local definition =
				PlatformServiceUtils.getDefaultActionDefinition(PlatformServiceUtils.ACTIONS.OPEN_INVENTORY)

			expect(definition ~= nil).to.equal(true)

			local gamepadPrompt = PlatformServiceUtils.resolvePromptForAction(definition, "Gamepad", "Console", "xbox")

			expect(gamepadPrompt.text).to.equal("Y")
			expect(gamepadPrompt.keyCode).to.equal(Enum.KeyCode.ButtonY)
			expect(typeof(gamepadPrompt.icon)).to.equal("string")
		end)
	end)
end
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="1086">
                  <Properties>
                    <string name="Name">WindFoliageServiceClient.spec</string>
                    <string name="Source"><![CDATA[--!strict
-- selene: allow(undefined_variable)

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local WindFoliageServiceClient = require(script:FindFirstAncestor("game").Client.Services.WindFoliageServiceClient)

local function createWeatherWindStub()
	local baseline = {
		windField = {
			strengthMultiplier = 1,
			baseStrength = 0.62,
			gustStrength = 0.92,
			detailStrength = 0.2,
			gustSpatialScale = 140,
			gustTimeScale = 0.16,
			detailSpatialScale = 22,
			detailTimeScale = 1.55,
			directionJitterRadians = math.rad(18),
		},
		tiers = {
			near = {
				updateInterval = 1 / 60,
				windScale = 1,
				detailScale = 1,
			},
			mid = {
				updateInterval = 0.12,
				windScale = 0.82,
				detailScale = 0.42,
			},
			far = {
				updateInterval = 0.32,
				windScale = 0.56,
				detailScale = 0.1,
			},
			frozen = {
				updateInterval = 0.75,
			},
		},
		updateBudget = {
			maxActiveTrees = 128,
			maxTransformWritesPerStep = 24000,
		},
		springs = {
			primary = {
				frequency = 0.45,
				damping = 0.97,
			},
			secondary = {
				frequency = 0.55,
				damping = 0.94,
			},
			flutter = {
				frequency = 0.6,
				damping = 1,
			},
		},
	}
	local windField = table.clone(baseline.windField)
	local lodController = {
		tierNear = {
			updateInterval = baseline.tiers.near.updateInterval,
			lodState = {
				windScale = baseline.tiers.near.windScale,
				detailScale = baseline.tiers.near.detailScale,
			},
		},
		tierMid = {
			updateInterval = baseline.tiers.mid.updateInterval,
			lodState = {
				windScale = baseline.tiers.mid.windScale,
				detailScale = baseline.tiers.mid.detailScale,
			},
		},
		tierFar = {
			updateInterval = baseline.tiers.far.updateInterval,
			lodState = {
				windScale = baseline.tiers.far.windScale,
				detailScale = baseline.tiers.far.detailScale,
			},
		},
		tierFrozen = {
			updateInterval = baseline.tiers.frozen.updateInterval,
			lodState = {
				windScale = 0,
				detailScale = 0,
			},
		},
	}
	local updateManager = {
		maxActiveTrees = baseline.updateBudget.maxActiveTrees,
		maxTransformWritesPerStep = baseline.updateBudget.maxTransformWritesPerStep,
		primarySpring = table.clone(baseline.springs.primary),
		secondarySpring = table.clone(baseline.springs.secondary),
		flutterSpring = table.clone(baseline.springs.flutter),
	}
	local service = {
		simulation = {
			windField = windField,
			lodController = lodController,
			updateManager = updateManager,
		},
		weatherWindState = {
			strengthMultiplier = baseline.windField.strengthMultiplier,
			baseStrength = baseline.windField.baseStrength,
			gustStrength = baseline.windField.gustStrength,
			detailStrength = baseline.windField.detailStrength,
			gustSpatialScale = baseline.windField.gustSpatialScale,
			gustTimeScale = baseline.windField.gustTimeScale,
			detailSpatialScale = baseline.windField.detailSpatialScale,
			detailTimeScale = baseline.windField.detailTimeScale,
			directionJitterRadians = baseline.windField.directionJitterRadians,
			tiers = {
				near = table.clone(baseline.tiers.near),
				mid = table.clone(baseline.tiers.mid),
				far = table.clone(baseline.tiers.far),
				frozen = table.clone(baseline.tiers.frozen),
			},
			updateBudget = table.clone(baseline.updateBudget),
			springs = {
				primary = table.clone(baseline.springs.primary),
				secondary = table.clone(baseline.springs.secondary),
				flutter = table.clone(baseline.springs.flutter),
			},
		},
	}

	return baseline, windField, lodController, updateManager, service
end

return function()
	describe("WindFoliageServiceClient", function()
		it("makes storm wind stronger while lowering foliage workload, then restores the calm baseline", function()
			local baseline, windField, lodController, updateManager, service = createWeatherWindStub()

			WindFoliageServiceClient.SetWeatherWind(service, 1, false)

			local rainyGustStrength = windField.gustStrength
			local rainyDetailStrength = windField.detailStrength
			local rainyDirectionJitter = windField.directionJitterRadians
			local rainyGustSpatialScale = windField.gustSpatialScale
			local rainyDetailTimeScale = windField.detailTimeScale
			local rainyNearInterval = lodController.tierNear.updateInterval
			local rainyFarWindScale = lodController.tierFar.lodState.windScale
			local rainyFarDetailScale = lodController.tierFar.lodState.detailScale
			local rainyMaxActiveTrees = updateManager.maxActiveTrees
			local rainyTransformWrites = updateManager.maxTransformWritesPerStep
			local rainyFlutterFrequency = updateManager.flutterSpring.frequency

			expect(windField.strengthMultiplier > baseline.windField.strengthMultiplier).to.equal(true)
			expect(rainyGustStrength > baseline.windField.gustStrength).to.equal(true)
			expect(rainyDetailStrength > baseline.windField.detailStrength).to.equal(true)
			expect(rainyDirectionJitter > baseline.windField.directionJitterRadians).to.equal(true)
			expect(rainyGustSpatialScale < baseline.windField.gustSpatialScale).to.equal(true)
			expect(rainyDetailTimeScale > baseline.windField.detailTimeScale).to.equal(true)
			expect(rainyNearInterval > baseline.tiers.near.updateInterval).to.equal(true)
			expect(rainyFarWindScale > baseline.tiers.far.windScale).to.equal(true)
			expect(rainyFarDetailScale > baseline.tiers.far.detailScale).to.equal(true)
			expect(rainyMaxActiveTrees < baseline.updateBudget.maxActiveTrees).to.equal(true)
			expect(rainyTransformWrites < baseline.updateBudget.maxTransformWritesPerStep).to.equal(true)
			expect(rainyFlutterFrequency > baseline.springs.flutter.frequency).to.equal(true)

			WindFoliageServiceClient.SetWeatherWind(service, 1, true)

			expect(windField.gustStrength > rainyGustStrength).to.equal(true)
			expect(windField.detailStrength > rainyDetailStrength).to.equal(true)
			expect(windField.directionJitterRadians > rainyDirectionJitter).to.equal(true)
			expect(windField.gustSpatialScale < rainyGustSpatialScale).to.equal(true)
			expect(windField.detailTimeScale > rainyDetailTimeScale).to.equal(true)
			expect(lodController.tierNear.updateInterval > rainyNearInterval).to.equal(true)
			expect(lodController.tierFar.lodState.windScale > rainyFarWindScale).to.equal(true)
			expect(lodController.tierFar.lodState.detailScale > rainyFarDetailScale).to.equal(true)
			expect(updateManager.maxActiveTrees < rainyMaxActiveTrees).to.equal(true)
			expect(updateManager.maxTransformWritesPerStep < rainyTransformWrites).to.equal(true)
			expect(updateManager.flutterSpring.frequency > rainyFlutterFrequency).to.equal(true)

			WindFoliageServiceClient.SetWeatherWind(service, 0, false)

			expect(windField.strengthMultiplier).to.equal(baseline.windField.strengthMultiplier)
			expect(windField.baseStrength).to.equal(baseline.windField.baseStrength)
			expect(windField.gustStrength).to.equal(baseline.windField.gustStrength)
			expect(windField.detailStrength).to.equal(baseline.windField.detailStrength)
			expect(windField.gustSpatialScale).to.equal(baseline.windField.gustSpatialScale)
			expect(windField.gustTimeScale).to.equal(baseline.windField.gustTimeScale)
			expect(windField.detailSpatialScale).to.equal(baseline.windField.detailSpatialScale)
			expect(windField.detailTimeScale).to.equal(baseline.windField.detailTimeScale)
			expect(windField.directionJitterRadians).to.equal(baseline.windField.directionJitterRadians)
			expect(lodController.tierNear.updateInterval).to.equal(baseline.tiers.near.updateInterval)
			expect(lodController.tierMid.updateInterval).to.equal(baseline.tiers.mid.updateInterval)
			expect(lodController.tierFar.updateInterval).to.equal(baseline.tiers.far.updateInterval)
			expect(lodController.tierFrozen.updateInterval).to.equal(baseline.tiers.frozen.updateInterval)
			expect(lodController.tierNear.lodState.windScale).to.equal(baseline.tiers.near.windScale)
			expect(lodController.tierFar.lodState.detailScale).to.equal(baseline.tiers.far.detailScale)
			expect(updateManager.maxActiveTrees).to.equal(baseline.updateBudget.maxActiveTrees)
			expect(updateManager.maxTransformWritesPerStep).to.equal(baseline.updateBudget.maxTransformWritesPerStep)
			expect(updateManager.primarySpring.frequency).to.equal(baseline.springs.primary.frequency)
			expect(updateManager.secondarySpring.frequency).to.equal(baseline.springs.secondary.frequency)
			expect(updateManager.flutterSpring.frequency).to.equal(baseline.springs.flutter.frequency)
		end)
	end)
end
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="1087">
                  <Properties>
                    <string name="Name">WorldGenerationNevermore.spec</string>
                    <string name="Source"><![CDATA[--!strict

local Workspace = game:GetService("Workspace")

local WorldGeneration = require(script:FindFirstAncestor("game").Shared.Classes.WorldGeneration)

local packageRoot = script:FindFirstAncestor("game").Parent
local loaderUtils = assert(packageRoot:FindFirstChild("LoaderUtils", true), "Missing LoaderUtils")
local loader = require(loaderUtils.Parent).load(script)

local Maid = loader("Maid")

return function()
	describe("WorldGeneration Nevermore integrations", function()
		it("publishes chunk demand, lifecycle, and stats changes reactively", function()
			local parent = Instance.new("Folder")
			parent.Name = "WorldGenerationNevermoreSpec"
			parent.Parent = Workspace

			local maid = Maid.new()
			local world = WorldGeneration.new({
				parent = parent,
				maxCachedChunkVisuals = 0,
				maxConcurrentChunkLoads = 1,
				maxChunkUnloadsPerHeartbeat = 1,
			})
			local demandEvents = {}
			local readyEvents = {}
			local unloadedEvents = {}
			local statsSnapshots = {}

			maid:GiveTask(world:observeChunkDemand():Subscribe(function(event)
				demandEvents[#demandEvents + 1] = event
			end))
			maid:GiveTask(world:observeChunkCollisionReady():Subscribe(function(event)
				readyEvents[#readyEvents + 1] = event
			end))
			maid:GiveTask(world:observeChunkCollisionUnloaded():Subscribe(function(event)
				unloadedEvents[#unloadedEvents + 1] = event
			end))
			maid:GiveTask(world:observeStats():Subscribe(function(stats)
				statsSnapshots[#statsSnapshots + 1] = stats
			end))

			world:init()
			world:adjustChunkDemand("0:0", 1)
			world:loadChunkByKey("0:0", {
				reason = "spec",
			})
			world:adjustChunkDemand("0:0", -1)
			world:unloadChunkByKey("0:0")
			task.wait()

			expect(#demandEvents).to.equal(2)
			expect(demandEvents[1].chunkKey).to.equal("0:0")
			expect(demandEvents[1].nextDemand).to.equal(1)
			expect(demandEvents[2].nextDemand).to.equal(0)
			expect(#readyEvents).to.equal(1)
			expect(readyEvents[1].chunkKey).to.equal("0:0")
			expect(#unloadedEvents).to.equal(1)
			expect(unloadedEvents[1].chunkKey).to.equal("0:0")
			expect(#statsSnapshots >= 1).to.equal(true)
			expect(statsSnapshots[#statsSnapshots].demandedChunks).to.equal(0)

			world:destroy()
			maid:Destroy()
			parent:Destroy()
		end)
	end)
end
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="1088">
                  <Properties>
                    <string name="Name">WorldSimulationDiagnostics.spec</string>
                    <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Diagnostics = require(script:FindFirstAncestor("game").Shared.Services.Diagnostics)

local function createDebugStub()
	return {
		counters = {} :: { [string]: any },
		setCounter = function(self: any, name: string, valueRaw: any)
			self.counters[name] = valueRaw
		end,
	}
end

return function()
	describe("WorldSimulationService.Diagnostics", function()
		it("records runtime samples and rolling averages", function()
			local debug = createDebugStub()
			local diagnostics = Diagnostics.New(debug)

			diagnostics:Record({
				worldTick = 10,
				deltaTime = 1 / 60,
				elapsedSeconds = 0.001,
				activeChunkCount = 6,
				selectedChunkCount = 3,
				chunkBudget = 4,
				processedChunks = 3,
				processedCorruptionClusters = 12,
				processedBiomeClusters = 8,
				processedAiEntities = 6,
				processedPhysicsEntities = 4,
			})

			diagnostics:Record({
				worldTick = 11,
				deltaTime = 1 / 60,
				elapsedSeconds = 0.002,
				activeChunkCount = 8,
				selectedChunkCount = 5,
				chunkBudget = 6,
				processedChunks = 5,
				processedCorruptionClusters = 18,
				processedBiomeClusters = 10,
				processedAiEntities = 8,
				processedPhysicsEntities = 6,
			})

			local snapshot = diagnostics:GetSnapshot()
			expect(snapshot.sample.worldTick).to.equal(11)
			expect(snapshot.sample.selectedChunkCount).to.equal(5)
			expect(snapshot.rolling.sampleCount).to.equal(2)
			expect(snapshot.rolling.averageProcessedChunks).to.equal(4)
			expect(snapshot.rolling.averageSelectedChunks).to.equal(4)
			expect(debug.counters.runtime_active_chunks).to.equal(8)
			expect(debug.counters.runtime_chunks_processed_avg).to.equal(4)

			diagnostics:Destroy()
		end)
	end)
end
]]></string>
