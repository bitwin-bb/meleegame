                    <BinaryString name="AttributesSerialize">BgAAAAsAAABBbHdheXNPblRvcAMABQAAAENvbG9yD0bkID3AWXM/7Ne3PggAAABEcmF3VHlwZQIDAAAAQm94BQAAAEdyb3VwAgQAAABIaWRlBAAAAEljb24CCQAAAGVtb2ppOmV5ZQcAAABWaXNpYmxlAwE=</BinaryString>
