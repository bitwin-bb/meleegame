            <Item class="ModuleScript" referent="758">
              <Properties>
                <string name="Name">WindFoliageServiceClient</string>
                <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Sift = require(ReplicatedStorage.Packages.Sift)

local ClientBinderSupport = require(script:FindFirstAncestor("game").Client.Binders.ClientBinderSupport)
local Configs = require(script:FindFirstAncestor("game").Shared.Modules.Core.Configs)
local CoreRuntime = require(script:FindFirstAncestor("game").Shared.Modules.Core.Runtime)
local Janitor = require(ReplicatedStorage.Packages.Janitor)
local NevermoreSupport = require(script:FindFirstAncestor("game").Shared.Modules.Core.NevermoreSupport)
local WindFoliage = require(script:FindFirstAncestor("game").Shared.Classes.WindFoliage)

type JanitorClass = {
	GiveChore: (self: JanitorClass, chore: any, ...any) -> any,
	Clean: (self: JanitorClass) -> (),
	Destroy: (self: JanitorClass) -> (),
}

local WindFoliageServiceClient = {}

local MIN_WEATHER_UPDATE_INTERVAL = 1 / 240

local RAIN_WIND_PROFILE = {
	strengthMultiplier = 1.45,
	baseStrength = 0.7,
	gustStrength = 2.2,
	detailStrength = 1.6,
	gustTimeScale = 1.1,
	detailTimeScale = 0.9,
	gustSpatialScale = 0.22,
	detailSpatialScale = 0.2,
	directionJitterRadians = 1.45,
	nearUpdateIntervalIncrease = 0.45,
	midUpdateIntervalIncrease = 0.35,
	farUpdateIntervalIncrease = 0.18,
	frozenUpdateIntervalIncrease = 0,
	nearWindScale = 0.18,
	midWindScale = 0.26,
	farWindScale = 0.42,
	nearDetailScale = 0.25,
	midDetailScale = 0.48,
	farDetailScale = 0.9,
	maxActiveTreesReduction = 0.42,
	maxTransformWritesPerStepReduction = 0.58,
	primarySpringFrequency = 0.45,
	secondarySpringFrequency = 0.65,
	flutterSpringFrequency = 0.8,
}

local THUNDERSTORM_WIND_PROFILE = {
	strengthMultiplier = 2.2,
	baseStrength = 1.1,
	gustStrength = 3.35,
	detailStrength = 2.45,
	gustTimeScale = 1.85,
	detailTimeScale = 1.45,
	gustSpatialScale = 0.38,
	detailSpatialScale = 0.34,
	directionJitterRadians = 2.8,
	nearUpdateIntervalIncrease = 0.9,
	midUpdateIntervalIncrease = 0.65,
	farUpdateIntervalIncrease = 0.32,
	frozenUpdateIntervalIncrease = 0.08,
	nearWindScale = 0.34,
	midWindScale = 0.52,
	farWindScale = 0.82,
	nearDetailScale = 0.38,
	midDetailScale = 0.72,
	farDetailScale = 1.4,
	maxActiveTreesReduction = 0.58,
	maxTransformWritesPerStepReduction = 0.68,
	primarySpringFrequency = 0.9,
	secondarySpringFrequency = 1.15,
	flutterSpringFrequency = 1.35,
}

local function snapshotTier(tierRaw: any): { [string]: number }?
	if typeof(tierRaw) ~= "table" then
		return nil
	end

	local tier = tierRaw :: any
	local lodState = tier.lodState
	return {
		updateInterval = if typeof(tier.updateInterval) == "number"
				and tier.updateInterval == tier.updateInterval
			then tier.updateInterval
			else nil,
		windScale = if typeof(lodState) == "table"
				and typeof(lodState.windScale) == "number"
				and lodState.windScale == lodState.windScale
			then lodState.windScale
			else nil,
		detailScale = if typeof(lodState) == "table"
				and typeof(lodState.detailScale) == "number"
				and lodState.detailScale == lodState.detailScale
			then lodState.detailScale
			else nil,
	}
end

local function snapshotSpring(springRaw: any): { [string]: number }?
	if typeof(springRaw) ~= "table" then
		return nil
	end

	local spring = springRaw :: any
	return {
		frequency = if typeof(spring.frequency) == "number" and spring.frequency == spring.frequency
			then spring.frequency
			else nil,
		damping = if typeof(spring.damping) == "number" and spring.damping == spring.damping
			then spring.damping
			else nil,
	}
end

local function applyTierState(
	tierRaw: any,
	baselineRaw: any,
	stormAlpha: number,
	updateIntervalIncrease: number,
	windBoost: number,
	detailBoost: number
)
	if typeof(tierRaw) ~= "table" or typeof(baselineRaw) ~= "table" then
		return
	end

	local tier = tierRaw :: any
	local baseline = baselineRaw :: any
	if typeof(baseline.updateInterval) == "number" then
		tier.updateInterval =
			math.max(MIN_WEATHER_UPDATE_INTERVAL, baseline.updateInterval * (1 + stormAlpha * updateIntervalIncrease))
	end

	local lodState = tier.lodState
	if typeof(lodState) ~= "table" then
		return
	end
	if typeof(baseline.windScale) == "number" then
		lodState.windScale = baseline.windScale * (1 + stormAlpha * windBoost)
	end
	if typeof(baseline.detailScale) == "number" then
		lodState.detailScale = baseline.detailScale * (1 + stormAlpha * detailBoost)
	end
end

local function applySpringState(springRaw: any, baselineRaw: any, stormAlpha: number, frequencyBoost: number)
	if typeof(springRaw) ~= "table" or typeof(baselineRaw) ~= "table" then
		return
	end

	local spring = springRaw :: any
	local baseline = baselineRaw :: any
	if typeof(baseline.frequency) == "number" then
		spring.frequency = math.max(0.01, baseline.frequency * (1 + stormAlpha * frequencyBoost))
	end
	if typeof(baseline.damping) == "number" then
		spring.damping = baseline.damping
	end
end

local function resolveConfig(): { [string]: any }
	local configSource = if typeof(Configs) == "table" then (Configs :: any).windFoliage else nil
	return if typeof(configSource) == "table" then Sift.Dictionary.copy(configSource) else {}
end

function WindFoliageServiceClient.Init(self: any)
	if self.janitor ~= nil then
		return
	end

	local config = resolveConfig()
	if config.enabled == false then
		return
	end

	local runtime = CoreRuntime.getClientRuntime()
	local tickScheduler = runtime:getTickScheduler()
	config.tickScheduler = tickScheduler
	config.observeTaggedInstances = false

	self.simulation = WindFoliage.new(config)
	self.simulation:init()
	self.binders = NevermoreSupport.getService(ClientBinderSupport)
	self.janitor = Janitor.new()
	local windField = self.simulation.windField
	local lodController = self.simulation.lodController
	local updateManager = self.simulation.updateManager
	self.weatherWindState = {
		strengthMultiplier = if windField ~= nil then windField.strengthMultiplier else nil,
		baseStrength = if windField ~= nil then windField.baseStrength else nil,
		gustStrength = if windField ~= nil then windField.gustStrength else nil,
		detailStrength = if windField ~= nil then windField.detailStrength else nil,
		gustSpatialScale = if windField ~= nil then windField.gustSpatialScale else nil,
		gustTimeScale = if windField ~= nil then windField.gustTimeScale else nil,
		detailSpatialScale = if windField ~= nil then windField.detailSpatialScale else nil,
		detailTimeScale = if windField ~= nil then windField.detailTimeScale else nil,
		directionJitterRadians = if windField ~= nil then windField.directionJitterRadians else nil,
		tiers = {
			near = if lodController ~= nil then snapshotTier(lodController.tierNear) else nil,
			mid = if lodController ~= nil then snapshotTier(lodController.tierMid) else nil,
			far = if lodController ~= nil then snapshotTier(lodController.tierFar) else nil,
			frozen = if lodController ~= nil then snapshotTier(lodController.tierFrozen) else nil,
		},
		updateBudget = {
			maxActiveTrees = if updateManager ~= nil then updateManager.maxActiveTrees else nil,
			maxTransformWritesPerStep = if updateManager ~= nil then updateManager.maxTransformWritesPerStep else nil,
		},
		springs = {
			primary = if updateManager ~= nil then snapshotSpring(updateManager.primarySpring) else nil,
			secondary = if updateManager ~= nil then snapshotSpring(updateManager.secondarySpring) else nil,
			flutter = if updateManager ~= nil then snapshotSpring(updateManager.flutterSpring) else nil,
		},
	}

	local janitor = self.janitor :: JanitorClass
	janitor:GiveChore(function()
		self.binders = nil
		self.weatherWindState = nil
		if self.simulation ~= nil then
			self.simulation:destroy()
			self.simulation = nil
		end
	end)
end

function WindFoliageServiceClient.SetWeatherWind(self: any, stormAlphaRaw: any, thunderstormRaw: any?)
	if self.simulation == nil or self.weatherWindState == nil then
		return
	end

	local windField = self.simulation.windField
	if windField == nil then
		return
	end
	local lodController = self.simulation.lodController
	local updateManager = self.simulation.updateManager

	local stormAlpha = if typeof(stormAlphaRaw) == "number" and stormAlphaRaw == stormAlphaRaw
		then math.clamp(stormAlphaRaw, 0, 1)
		else 0
	local isThunderstorm = thunderstormRaw == true
	local state = self.weatherWindState
	local profile = if isThunderstorm then THUNDERSTORM_WIND_PROFILE else RAIN_WIND_PROFILE

	if state.strengthMultiplier ~= nil then
		windField.strengthMultiplier = state.strengthMultiplier * (1 + stormAlpha * profile.strengthMultiplier)
	end
	if state.baseStrength ~= nil then
		windField.baseStrength = state.baseStrength * (1 + stormAlpha * profile.baseStrength)
	end
	if state.gustStrength ~= nil then
		windField.gustStrength = state.gustStrength * (1 + stormAlpha * profile.gustStrength)
	end
	if state.detailStrength ~= nil then
		windField.detailStrength = state.detailStrength * (1 + stormAlpha * profile.detailStrength)
	end
	if state.gustSpatialScale ~= nil then
		windField.gustSpatialScale = math.max(1, state.gustSpatialScale * (1 - stormAlpha * profile.gustSpatialScale))
	end
	if state.gustTimeScale ~= nil then
		windField.gustTimeScale = state.gustTimeScale * (1 + stormAlpha * profile.gustTimeScale)
	end
	if state.detailSpatialScale ~= nil then
		windField.detailSpatialScale =
			math.max(1, state.detailSpatialScale * (1 - stormAlpha * profile.detailSpatialScale))
	end
	if state.detailTimeScale ~= nil then
		windField.detailTimeScale = state.detailTimeScale * (1 + stormAlpha * profile.detailTimeScale)
	end
	if state.directionJitterRadians ~= nil then
		windField.directionJitterRadians =
			math.clamp(state.directionJitterRadians * (1 + stormAlpha * profile.directionJitterRadians), 0, math.pi)
	end

	local tiers = state.tiers
	if lodController ~= nil and typeof(tiers) == "table" then
		applyTierState(
			lodController.tierNear,
			tiers.near,
			stormAlpha,
			profile.nearUpdateIntervalIncrease,
			profile.nearWindScale,
			profile.nearDetailScale
		)
		applyTierState(
			lodController.tierMid,
			tiers.mid,
			stormAlpha,
			profile.midUpdateIntervalIncrease,
			profile.midWindScale,
			profile.midDetailScale
		)
		applyTierState(
			lodController.tierFar,
			tiers.far,
			stormAlpha,
			profile.farUpdateIntervalIncrease,
			profile.farWindScale,
			profile.farDetailScale
		)
		applyTierState(lodController.tierFrozen, tiers.frozen, stormAlpha, profile.frozenUpdateIntervalIncrease, 0, 0)
	end

	local updateBudget = state.updateBudget
	if updateManager ~= nil and typeof(updateBudget) == "table" then
		if typeof(updateBudget.maxActiveTrees) == "number" then
			updateManager.maxActiveTrees = math.max(
				1,
				math.floor(updateBudget.maxActiveTrees * (1 - stormAlpha * profile.maxActiveTreesReduction))
			)
		end
		if typeof(updateBudget.maxTransformWritesPerStep) == "number" then
			updateManager.maxTransformWritesPerStep = math.max(
				1,
				math.floor(
					updateBudget.maxTransformWritesPerStep
						* (1 - stormAlpha * profile.maxTransformWritesPerStepReduction)
				)
			)
		end
	end

	local springs = state.springs
	if updateManager ~= nil and typeof(springs) == "table" then
		applySpringState(updateManager.primarySpring, springs.primary, stormAlpha, profile.primarySpringFrequency)
		applySpringState(updateManager.secondarySpring, springs.secondary, stormAlpha, profile.secondarySpringFrequency)
		applySpringState(updateManager.flutterSpring, springs.flutter, stormAlpha, profile.flutterSpringFrequency)
	end
end

function WindFoliageServiceClient.AddDisturbance(self: any, paramsRaw: any): number?
	if self.simulation == nil then
		return nil
	end
	return self.simulation:addDisturbance(paramsRaw)
end

function WindFoliageServiceClient.RegisterFoliage(self: any, instanceRaw: any)
	if self.simulation == nil then
		return nil
	end
	return self.simulation:registerFoliage(instanceRaw)
end

function WindFoliageServiceClient.UnregisterFoliage(self: any, instanceRaw: any)
	if self.simulation == nil then
		return
	end
	self.simulation:unregisterFoliage(instanceRaw)
end

function WindFoliageServiceClient.TrackDisturber(self: any, instanceRaw: any, overrideConfigRaw: any?)
	if self.simulation == nil then
		return nil
	end
	return self.simulation:trackDisturber(instanceRaw, overrideConfigRaw)
end

function WindFoliageServiceClient.UntrackDisturber(self: any, instanceRaw: any)
	if self.simulation == nil then
		return
	end
	self.simulation:untrackDisturber(instanceRaw)
end

function WindFoliageServiceClient.GetStats(self: any): { [string]: number }
	if self.simulation == nil then
		return {}
	end
	return self.simulation:getStats()
end

function WindFoliageServiceClient.Destroy(self: any)
	if self.janitor ~= nil then
		local janitor = self.janitor :: JanitorClass
		janitor:Destroy()
		self.janitor = nil
	end
	self.simulation = nil
end

WindFoliageServiceClient.init = WindFoliageServiceClient.Init
WindFoliageServiceClient.setWeatherWind = WindFoliageServiceClient.SetWeatherWind
WindFoliageServiceClient.addDisturbance = WindFoliageServiceClient.AddDisturbance
WindFoliageServiceClient.registerFoliage = WindFoliageServiceClient.RegisterFoliage
WindFoliageServiceClient.unregisterFoliage = WindFoliageServiceClient.UnregisterFoliage
WindFoliageServiceClient.trackDisturber = WindFoliageServiceClient.TrackDisturber
WindFoliageServiceClient.untrackDisturber = WindFoliageServiceClient.UntrackDisturber
WindFoliageServiceClient.getStats = WindFoliageServiceClient.GetStats
WindFoliageServiceClient.destroy = WindFoliageServiceClient.Destroy

return WindFoliageServiceClient
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="759">
              <Properties>
                <string name="Name">WorldAnimatorServiceClient</string>
                <string name="Source"><![CDATA[--!strict
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Sift = require(ReplicatedStorage.Packages.Sift)
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local ClientBinderSupport = require(script:FindFirstAncestor("game").Client.Binders.ClientBinderSupport)
local Configs = require(script:FindFirstAncestor("game").Shared.Modules.Core.Configs)
local Janitor = require(ReplicatedStorage.Packages.Janitor)
local NevermoreSupport = require(script:FindFirstAncestor("game").Shared.Modules.Core.NevermoreSupport)
local WorkspaceFolders = require(script:FindFirstAncestor("game").Shared.Modules.Core.WorkspaceFolders)
local WorldAnimatorServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.WorldAnimatorServiceUtils)

type ChunkAnimatorSettings = WorldAnimatorServiceUtils.ChunkAnimatorSettings
type ChunkAnimationType = WorldAnimatorServiceUtils.ChunkAnimationType
type ChunkAnimationEasing = WorldAnimatorServiceUtils.ChunkAnimationEasing

type JanitorClass = {
	GiveChore: (self: JanitorClass, chore: any, ...any) -> any,
	Clean: (self: JanitorClass) -> (),
	Destroy: (self: JanitorClass) -> (),
}

type ChunkAnimationState = {
	chunkModel: Model,
	visualModel: Model,
	originalParts: { BasePart },
	originalLocalTransparencyModifiers: { number },
	cloneParts: { BasePart },
	cloneBaseTransparency: { number },
	startPivot: CFrame,
	targetPivot: CFrame,
	startedAt: number,
	duration: number,
	animationType: ChunkAnimationType,
	easing: ChunkAnimationEasing,
	destroyConnection: RBXScriptConnection?,
	isStopping: boolean?,
}

type StartAnimationResult = "started" | "retry" | "skip"

local WorldAnimatorServiceClient = {}

local RUNTIME_FOLDER_NAME = "WorldAnimatorRuntime"
local SKIP_WORLD_ANIMATOR_ATTRIBUTE = "SkipWorldAnimator"
local SKIP_CHUNK_APPEAR_ANIMATION_ATTRIBUTE = "SkipChunkAppearAnimation"
local ANIMATING_WORLD_ANIMATOR_ATTRIBUTE = "WorldAnimatorAnimating"

local function safeGetModelPivot(model: Model): (boolean, CFrame)
	local ok, result = pcall(function()
		return model:GetPivot()
	end)
	if not ok then
		return false, CFrame.new()
	end
	return true, result :: CFrame
end

local function collectModelParts(model: Model, maxCount: number): { BasePart }
	local parts = {}
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") then
			table.insert(parts, descendant)
			if #parts >= maxCount then
				break
			end
		end
	end
	return parts
end

local function clearCollectionTags(instance: Instance)
	for _, tag in CollectionService:GetTags(instance) do
		CollectionService:RemoveTag(instance, tag)
	end
end

local function resolveChunkIdentityKey(chunkModel: Model): string?
	local chunkKeyRaw = chunkModel:GetAttribute("ChunkKey")
	if typeof(chunkKeyRaw) == "string" and chunkKeyRaw ~= "" then
		return chunkKeyRaw
	end

	local chunkX = chunkModel:GetAttribute("ChunkX")
	local chunkY = chunkModel:GetAttribute("ChunkY")
	if typeof(chunkX) == "number" and typeof(chunkY) == "number" then
		return `{math.floor(chunkX)}:{math.floor(chunkY)}`
	end

	local nameChunkX, nameChunkY = string.match(chunkModel.Name, "^Chunk_(-?%d+)_(-?%d+)$")
	if nameChunkX ~= nil and nameChunkY ~= nil then
		return `{nameChunkX}:{nameChunkY}`
	end

	return nil
end

local function hasSiblingChunkWithSameIdentity(chunkModel: Model): boolean
	local identityKey = resolveChunkIdentityKey(chunkModel)
	if identityKey == nil then
		return false
	end

	local parent = chunkModel.Parent
	if parent == nil then
		return false
	end

	for _, sibling in parent:GetChildren() do
		if sibling == chunkModel then
			continue
		end
		if not WorldAnimatorServiceUtils.isChunkModel(sibling) then
			continue
		end

		local siblingModel = sibling :: Model
		local siblingIdentityKey = resolveChunkIdentityKey(siblingModel)
		if siblingIdentityKey ~= nil and siblingIdentityKey == identityKey then
			return true
		end
	end

	return false
end

local function computePositionRelativeFadeAlpha(startPivot: CFrame, currentPivot: CFrame, targetPivot: CFrame): number
	local startPosition = startPivot.Position
	local targetPosition = targetPivot.Position
	local totalDistance = (targetPosition - startPosition).Magnitude
	if totalDistance <= 0.0001 then
		return 1
	end

	local currentDistance = (currentPivot.Position - startPosition).Magnitude
	return math.clamp(currentDistance / totalDistance, 0, 1)
end

function WorldAnimatorServiceClient.EnsureRuntimeFolder(_self: WorldAnimatorServiceClient): Folder
	return WorkspaceFolders.getOrCreateFolderInGame(RUNTIME_FOLDER_NAME)
end

function WorldAnimatorServiceClient.StopRenderLoop(self: WorldAnimatorServiceClient)
	if self.renderConnection ~= nil then
		self.renderConnection:Disconnect()
		self.renderConnection = nil
	end
end

function WorldAnimatorServiceClient.EnsureRenderLoop(self: WorldAnimatorServiceClient)
	if self.renderConnection ~= nil then
		return
	end

	self.renderConnection = RunService.RenderStepped:Connect(function()
		self:processPendingChunks()
		self:stepAnimations()

		if #self.pendingChunks <= 0 and #self.activeAnimations <= 0 then
			self:stopRenderLoop()
		end
	end)
end

function WorldAnimatorServiceClient.RestoreOriginalChunkVisibility(
	_self: WorldAnimatorServiceClient,
	animation: ChunkAnimationState
)
	for index, part in animation.originalParts do
		pcall(function()
			part.LocalTransparencyModifier = animation.originalLocalTransparencyModifiers[index] or 0
		end)
	end
end

function WorldAnimatorServiceClient.StopAnimation(
	self: WorldAnimatorServiceClient,
	animation: ChunkAnimationState,
	revealOriginal: boolean
)
	if animation.isStopping then
		return
	end
	animation.isStopping = true

	self.animationsByChunk[animation.chunkModel] = nil
	for index = #self.activeAnimations, 1, -1 do
		if self.activeAnimations[index] == animation then
			table.remove(self.activeAnimations, index)
			break
		end
	end

	if animation.destroyConnection ~= nil then
		animation.destroyConnection:Disconnect()
		animation.destroyConnection = nil
	end

	pcall(function()
		animation.chunkModel:SetAttribute(ANIMATING_WORLD_ANIMATOR_ATTRIBUTE, false)
	end)

	if revealOriginal then
		self:restoreOriginalChunkVisibility(animation)
	end

	if animation.visualModel.Parent ~= nil then
		animation.visualModel:Destroy()
	end
end

function WorldAnimatorServiceClient.StepAnimations(self: WorldAnimatorServiceClient)
	if #self.activeAnimations <= 0 then
		return
	end

	local now = os.clock()
	for index = #self.activeAnimations, 1, -1 do
		local animation = self.activeAnimations[index]
		if animation.chunkModel.Parent == nil then
			self:stopAnimation(animation, true)
			continue
		end

		local elapsed = now - animation.startedAt
		local alpha = math.clamp(elapsed / animation.duration, 0, 1)
		local easedAlpha = WorldAnimatorServiceUtils.applyEasing(animation.easing, alpha)
		local nextPivot = animation.startPivot:Lerp(animation.targetPivot, easedAlpha)
		animation.visualModel:PivotTo(nextPivot)

		if WorldAnimatorServiceUtils.doesAnimationUseFade(animation.animationType) then
			local fadeAlpha = easedAlpha
			if self.settings.transparencyRelativeToChunkPosition then
				fadeAlpha = computePositionRelativeFadeAlpha(animation.startPivot, nextPivot, animation.targetPivot)
			end
			for partIndex, part in animation.cloneParts do
				local baseTransparency = animation.cloneBaseTransparency[partIndex] or 0
				part.Transparency = baseTransparency + (1 - baseTransparency) * (1 - fadeAlpha)
			end
		end

		if alpha >= 1 then
			self:stopAnimation(animation, true)
		end
	end
end

function WorldAnimatorServiceClient.EnqueueChunkForAnimation(self: WorldAnimatorServiceClient, chunkModel: Model)
	if not self.settings.enabled then
		return
	end
	if self.animationsByChunk[chunkModel] ~= nil then
		return
	end
	if self.pendingChunkLookup[chunkModel] ~= nil then
		return
	end

	self.pendingChunkLookup[chunkModel] = true
	table.insert(self.pendingChunks, chunkModel)
	self:ensureRenderLoop()
end

function WorldAnimatorServiceClient.RemovePendingChunk(self: WorldAnimatorServiceClient, chunkModel: Model)
	if self.pendingChunkLookup[chunkModel] == nil then
		return
	end

	self.pendingChunkLookup[chunkModel] = nil
	for index = #self.pendingChunks, 1, -1 do
		if self.pendingChunks[index] == chunkModel then
			table.remove(self.pendingChunks, index)
		end
	end
end

function WorldAnimatorServiceClient.EvaluateChunkAnimation(
	self: WorldAnimatorServiceClient,
	chunkModel: Model
): (StartAnimationResult, CFrame?)
	if not self.settings.enabled then
		return "skip", nil
	end
	if self.animationsByChunk[chunkModel] ~= nil then
		return "skip", nil
	end
	if #self.activeAnimations >= self.settings.maxConcurrentAnimations then
		return "retry", nil
	end

	local ok, targetPivot = safeGetModelPivot(chunkModel)
	if not ok then
		return "retry", nil
	end

	local distanceFromPlayer = WorldAnimatorServiceUtils.getLocalPlayerDistanceFromPosition(targetPivot.Position)
	if distanceFromPlayer == nil then
		return "retry", nil
	end
	if distanceFromPlayer < self.settings.minPlayerDistanceToAnimate then
		return "skip", nil
	end

	return "started", targetPivot
end

function WorldAnimatorServiceClient.StartChunkAnimation(
	self: WorldAnimatorServiceClient,
	chunkModel: Model
): StartAnimationResult
	if chunkModel.Parent == nil then
		return "skip"
	end
	if
		chunkModel:GetAttribute(SKIP_WORLD_ANIMATOR_ATTRIBUTE) == true
		or chunkModel:GetAttribute(SKIP_CHUNK_APPEAR_ANIMATION_ATTRIBUTE) == true
	then
		return "skip"
	end

	local eligibility, targetPivot = self:evaluateChunkAnimation(chunkModel)
	if eligibility ~= "started" or targetPivot == nil then
		return eligibility
	end

	local originalParts = collectModelParts(chunkModel, self.settings.maxAnimatedPartsPerChunk + 1)
	if #originalParts <= 0 then
		return "retry"
	end
	if #originalParts > self.settings.maxAnimatedPartsPerChunk then
		return "skip"
	end

	local visualClone = chunkModel:Clone()
	visualClone.Name = `{chunkModel.Name}_ChunkAnim`
	-- Visual clones must not keep gameplay tags, or binders/tag observers will recurse on them.
	visualClone:SetAttribute(SKIP_WORLD_ANIMATOR_ATTRIBUTE, true)
	clearCollectionTags(visualClone)

	local cloneParts = {}
	local cloneBaseTransparency = {}
	for _, descendant in visualClone:GetDescendants() do
		clearCollectionTags(descendant)
		if descendant:IsA("Script") or descendant:IsA("LocalScript") or descendant:IsA("ModuleScript") then
			descendant:Destroy()
		elseif descendant:IsA("BasePart") then
			descendant.Anchored = true
			descendant.CanCollide = false
			descendant.CanQuery = false
			descendant.CanTouch = false
			descendant.Massless = true
			table.insert(cloneParts, descendant)
			table.insert(cloneBaseTransparency, descendant.Transparency)
		end
	end

	if #cloneParts <= 0 then
		visualClone:Destroy()
		return "skip"
	end

	local originalLocalTransparencyModifiers = Sift.Array.create(#originalParts)
	for index, part in originalParts do
		originalLocalTransparencyModifiers[index] = part.LocalTransparencyModifier
		part.LocalTransparencyModifier = 1
	end

	local animationOffset =
		WorldAnimatorServiceUtils.computeAnimationOffset(self.settings.animationType, self.settings.verticalOffset)
	local startPivot = targetPivot + animationOffset
	visualClone:PivotTo(startPivot)
	if WorldAnimatorServiceUtils.doesAnimationUseFade(self.settings.animationType) then
		for _, part in cloneParts do
			part.Transparency = 1
		end
	end

	visualClone.Parent = self.runtimeFolder

	local animation: ChunkAnimationState = {
		chunkModel = chunkModel,
		visualModel = visualClone,
		originalParts = originalParts,
		originalLocalTransparencyModifiers = originalLocalTransparencyModifiers,
		cloneParts = cloneParts,
		cloneBaseTransparency = cloneBaseTransparency,
		startPivot = startPivot,
		targetPivot = targetPivot,
		startedAt = os.clock(),
		duration = self.settings.duration,
		animationType = self.settings.animationType,
		easing = self.settings.easing,
		destroyConnection = nil,
		isStopping = false,
	}

	animation.destroyConnection = chunkModel.Destroying:Connect(function()
		self:stopAnimation(animation, true)
	end)

	pcall(function()
		chunkModel:SetAttribute(ANIMATING_WORLD_ANIMATOR_ATTRIBUTE, true)
	end)

	self.animationsByChunk[chunkModel] = animation
	table.insert(self.activeAnimations, animation)
	self:ensureRenderLoop()
	return "started"
end

function WorldAnimatorServiceClient.ProcessPendingChunks(self: WorldAnimatorServiceClient)
	if #self.pendingChunks <= 0 then
		return
	end

	local processBudget = math.max(1, self.settings.maxConcurrentAnimations * 2)
	local processed = 0
	while processed < processBudget and #self.pendingChunks > 0 do
		processed += 1
		local chunkModel = table.remove(self.pendingChunks, 1)
		if chunkModel == nil then
			break
		end

		self.pendingChunkLookup[chunkModel] = nil
		if chunkModel.Parent == nil then
			continue
		end

		local result = self:startChunkAnimation(chunkModel)
		if result == "retry" then
			self:enqueueChunkForAnimation(chunkModel)
		end
	end
end

function WorldAnimatorServiceClient.OnChunkAdded(self: WorldAnimatorServiceClient, chunkRaw: Instance)
	if not WorldAnimatorServiceUtils.isChunkModel(chunkRaw) then
		return
	end

	local chunkModel = chunkRaw :: Model
	if chunkModel:GetAttribute(SKIP_WORLD_ANIMATOR_ATTRIBUTE) == true then
		return
	end
	if hasSiblingChunkWithSameIdentity(chunkModel) then
		return
	end

	local result = self:startChunkAnimation(chunkModel)
	if result == "retry" then
		self:enqueueChunkForAnimation(chunkModel)
	end
end

function WorldAnimatorServiceClient.OnChunkRemoved(self: WorldAnimatorServiceClient, chunkRaw: Instance)
	if not chunkRaw:IsA("Model") then
		return
	end

	self:removePendingChunk(chunkRaw)

	local animation = self.animationsByChunk[chunkRaw]
	if animation == nil then
		return
	end
	self:stopAnimation(animation, true)
end

function WorldAnimatorServiceClient.BindChunksFolder(self: WorldAnimatorServiceClient, chunksFolder: Folder)
	self.chunksFolderJanitor:Clean()
	table.clear(self.pendingChunks)
	table.clear(self.pendingChunkLookup)
	self.chunksFolder = chunksFolder
end

function WorldAnimatorServiceClient.BindWorldFolder(self: WorldAnimatorServiceClient, worldFolder: Folder)
	self.worldFolderJanitor:Clean()
	self.chunksFolderJanitor:Clean()
	self.worldFolder = worldFolder
	self.chunksFolder = nil

	local existingChunksFolder = WorldAnimatorServiceUtils.findChunksFolder(worldFolder)
	if existingChunksFolder ~= nil then
		self:bindChunksFolder(existingChunksFolder)
	end

	self.worldFolderJanitor:GiveChore(worldFolder.ChildAdded:Connect(function(child: Instance)
		if child.Name ~= WorldAnimatorServiceUtils.CHUNKS_FOLDER_NAME then
			return
		end
		if child:IsA("Folder") then
			self:bindChunksFolder(child)
		end
	end))

	self.worldFolderJanitor:GiveChore(worldFolder.ChildRemoved:Connect(function(child: Instance)
		if child == self.chunksFolder then
			self.chunksFolderJanitor:Clean()
			table.clear(self.pendingChunks)
			table.clear(self.pendingChunkLookup)
			self.chunksFolder = nil
		end
	end))
end

function WorldAnimatorServiceClient.TryBindExistingWorldFolder(self: WorldAnimatorServiceClient)
	local worldFolder = WorldAnimatorServiceUtils.findWorldGenerationFolder()
	if worldFolder ~= nil then
		self:bindWorldFolder(worldFolder)
	end
end

function WorldAnimatorServiceClient.Init(self: WorldAnimatorServiceClient)
	self.settings = WorldAnimatorServiceUtils.createSettingsFromConfigs(Configs)
	self.janitor = Janitor.new()
	self.worldFolderJanitor = Janitor.new()
	self.chunksFolderJanitor = Janitor.new()
	self.janitor:GiveChore(self.worldFolderJanitor)
	self.janitor:GiveChore(self.chunksFolderJanitor)
	self.runtimeFolder = self:ensureRuntimeFolder()
	self.worldFolder = nil :: Folder?
	self.chunksFolder = nil :: Folder?
	self.activeAnimations = {}
	self.animationsByChunk = {}
	self.pendingChunks = {}
	self.pendingChunkLookup = {}
	self.renderConnection = nil :: RBXScriptConnection?
	self.binders = NevermoreSupport.getService(ClientBinderSupport)

	local function onWorldFolderAdded(child: Instance)
		if child.Name ~= WorldAnimatorServiceUtils.WORLD_FOLDER_NAME then
			return
		end
		if child:IsA("Folder") then
			self:bindWorldFolder(child)
		end
	end

	local function onWorldFolderRemoved(child: Instance)
		if child ~= self.worldFolder then
			return
		end

		self.worldFolderJanitor:Clean()
		self.chunksFolderJanitor:Clean()
		table.clear(self.pendingChunks)
		table.clear(self.pendingChunkLookup)
		self.worldFolder = nil
		self.chunksFolder = nil
	end

	local gameFolder = WorkspaceFolders.getOrCreateGameFolder()
	self.janitor:GiveChore(gameFolder.ChildAdded:Connect(onWorldFolderAdded))
	self.janitor:GiveChore(gameFolder.ChildRemoved:Connect(onWorldFolderRemoved))

	self.janitor:GiveChore(Workspace.ChildAdded:Connect(onWorldFolderAdded))
	self.janitor:GiveChore(Workspace.ChildRemoved:Connect(onWorldFolderRemoved))

	self:tryBindExistingWorldFolder()
end

function WorldAnimatorServiceClient.Destroy(self: WorldAnimatorServiceClient)
	for index = #self.activeAnimations, 1, -1 do
		local animation = self.activeAnimations[index]
		self:stopAnimation(animation, true)
	end

	self:stopRenderLoop()
	if self.janitor ~= nil then
		self.janitor:Destroy()
	end

	table.clear(self.pendingChunks)
	table.clear(self.pendingChunkLookup)
end

WorldAnimatorServiceClient.ensureRuntimeFolder = WorldAnimatorServiceClient.EnsureRuntimeFolder
WorldAnimatorServiceClient.stopRenderLoop = WorldAnimatorServiceClient.StopRenderLoop
WorldAnimatorServiceClient.ensureRenderLoop = WorldAnimatorServiceClient.EnsureRenderLoop
WorldAnimatorServiceClient.restoreOriginalChunkVisibility = WorldAnimatorServiceClient.RestoreOriginalChunkVisibility
WorldAnimatorServiceClient.stopAnimation = WorldAnimatorServiceClient.StopAnimation
WorldAnimatorServiceClient.stepAnimations = WorldAnimatorServiceClient.StepAnimations
WorldAnimatorServiceClient.enqueueChunkForAnimation = WorldAnimatorServiceClient.EnqueueChunkForAnimation
WorldAnimatorServiceClient.removePendingChunk = WorldAnimatorServiceClient.RemovePendingChunk
WorldAnimatorServiceClient.evaluateChunkAnimation = WorldAnimatorServiceClient.EvaluateChunkAnimation
WorldAnimatorServiceClient.startChunkAnimation = WorldAnimatorServiceClient.StartChunkAnimation
WorldAnimatorServiceClient.processPendingChunks = WorldAnimatorServiceClient.ProcessPendingChunks
WorldAnimatorServiceClient.onChunkAdded = WorldAnimatorServiceClient.OnChunkAdded
WorldAnimatorServiceClient.onChunkRemoved = WorldAnimatorServiceClient.OnChunkRemoved
WorldAnimatorServiceClient.bindChunksFolder = WorldAnimatorServiceClient.BindChunksFolder
WorldAnimatorServiceClient.bindWorldFolder = WorldAnimatorServiceClient.BindWorldFolder
WorldAnimatorServiceClient.tryBindExistingWorldFolder = WorldAnimatorServiceClient.TryBindExistingWorldFolder
WorldAnimatorServiceClient.init = WorldAnimatorServiceClient.Init
WorldAnimatorServiceClient.destroy = WorldAnimatorServiceClient.Destroy

type WorldAnimatorServiceClient = typeof(WorldAnimatorServiceClient) & {
	settings: ChunkAnimatorSettings,
	janitor: JanitorClass,
	worldFolderJanitor: JanitorClass,
	chunksFolderJanitor: JanitorClass,
	worldFolder: Folder?,
	chunksFolder: Folder?,
	runtimeFolder: Folder,
	activeAnimations: { ChunkAnimationState },
	animationsByChunk: { [Model]: ChunkAnimationState },
	pendingChunks: { Model },
	pendingChunkLookup: { [Model]: boolean },
	renderConnection: RBXScriptConnection?,
}

return WorldAnimatorServiceClient :: WorldAnimatorServiceClient
]]></string>
