                <Properties>
                  <string name="Name">StatStringBuilder</string>
                  <string name="Source"><![CDATA[--!strict
local AbbreviationFormatter = require(script.Parent.AbbreviationFormatter)
local RichTextFormatter = require(script.Parent.RichTextFormatter)

local StatStringBuilder = {}
StatStringBuilder.__index = StatStringBuilder

export type StatDefinition = {
	id: string,
	label: string?,
	format: string?,
	precision: number?,
	hidden: boolean?,
	inverseDelta: boolean?,
	showSign: boolean?,
	showBreakdown: boolean?,
}

export type ModifierBreakdown = {
	base: number?,
	additive: number?,
	multiplicative: number?,
}

export type StatToken = {
	kind: "label" | "value" | "delta" | "separator" | "breakdown" | "newline",
	statId: string,
	text: string,
	color: string?,
}

export type BuilderConfig = {
	attributeCache: any?,
	positiveColor: string?,
	negativeColor: string?,
	neutralColor: string?,
}

export type BuildOptions = {
	includeHidden: boolean?,
	showUnchanged: boolean?,
	deltaThreshold: number?,
	returnRichText: boolean?,
}

export type StatStringBuilder = typeof(setmetatable({} :: any, StatStringBuilder))

local function clampNumber(valueRaw: any, fallback: number, minValue: number, maxValue: number): number
	local value = if typeof(valueRaw) == "number" then valueRaw else fallback
	if value < minValue then
		return minValue
	end
	if value > maxValue then
		return maxValue
	end
	return value
end

local function toNumber(valueRaw: any, fallback: number): number
	if typeof(valueRaw) ~= "number" then
		return fallback
	end
	return valueRaw
end

local function resolveDefinition(defRaw: any, statId: string): StatDefinition
	if typeof(defRaw) ~= "table" then
		return {
			id = statId,
			label = statId,
		}
	end
	return {
		id = statId,
		label = if typeof(defRaw.label) == "string" then defRaw.label else statId,
		format = if typeof(defRaw.format) == "string" then defRaw.format else nil,
		precision = if typeof(defRaw.precision) == "number" then math.floor(defRaw.precision) else nil,
		hidden = defRaw.hidden == true,
		inverseDelta = defRaw.inverseDelta == true,
		showSign = defRaw.showSign == true,
		showBreakdown = defRaw.showBreakdown == true,
	}
end

local function autoDetectFormat(statId: string, value: number): string
	local lowered = string.lower(statId)
	if string.find(lowered, "percent", 1, true) ~= nil or string.find(lowered, "chance", 1, true) ~= nil or string.find(lowered, "crit", 1, true) ~= nil then
		return "percent"
	end
	if string.find(lowered, "dps", 1, true) ~= nil then
		return "dps"
	end
	if string.find(lowered, "time", 1, true) ~= nil or string.find(lowered, "cooldown", 1, true) ~= nil then
		return "time"
	end
	if math.abs(value) <= 1 then
		return "percent"
	end
	return "number"
end

local function sortDefinitions(definitions: { StatDefinition })
	table.sort(definitions, function(a, b)
		return a.id < b.id
	end)
end

function StatStringBuilder.New(configRaw: BuilderConfig?): StatStringBuilder
	local config = if typeof(configRaw) == "table" then configRaw else {}
	local self = setmetatable({
		attributeCache = config.attributeCache,
		positiveColor = if typeof(config.positiveColor) == "string" then config.positiveColor else "green",
		negativeColor = if typeof(config.negativeColor) == "string" then config.negativeColor else "red",
		neutralColor = if typeof(config.neutralColor) == "string" then config.neutralColor else "gray",
	}, StatStringBuilder)
	return self
end

function StatStringBuilder._read(self: StatStringBuilder, source: any, statId: string): any
	if source == nil then
		return nil
	end
	if typeof(source) == "table" then
		return source[statId]
	end
	if typeof(source) == "Instance" then
		if self.attributeCache ~= nil and typeof(self.attributeCache.get) == "function" then
			return self.attributeCache:get(source, statId, source:GetAttribute(statId))
		end
		return source:GetAttribute(statId)
	end
	return nil
end

function StatStringBuilder._formatValue(self: StatStringBuilder, statId: string, valueRaw: any, formatRaw: any, precisionRaw: any): string
	local value = toNumber(valueRaw, 0)
	local formatKind = if typeof(formatRaw) == "string" then formatRaw else autoDetectFormat(statId, value)
	return AbbreviationFormatter.formatValue(value, formatKind, precisionRaw)
end

function StatStringBuilder._normalizeDefinitions(self: StatStringBuilder, definitionsRaw: any, currentSource: any): { StatDefinition }
	local definitions = {}
	if typeof(definitionsRaw) == "table" and #definitionsRaw > 0 then
		for _, defRaw in definitionsRaw do
			if typeof(defRaw) == "table" and typeof(defRaw.id) == "string" then
				definitions[#definitions + 1] = resolveDefinition(defRaw, defRaw.id)
			end
		end
	else
		if typeof(currentSource) == "table" then
			for key in currentSource do
				if typeof(key) == "string" then
					definitions[#definitions + 1] = resolveDefinition(nil, key)
				end
			end
		elseif typeof(currentSource) == "Instance" then
			local attributes = currentSource:GetAttributes()
			for key in attributes do
				if typeof(key) == "string" then
					definitions[#definitions + 1] = resolveDefinition(nil, key)
				end
			end
		end
	end
	sortDefinitions(definitions)
	return definitions
end

function StatStringBuilder.BuildTokens(
	self: StatStringBuilder,
	currentSource: any,
	compareSource: any?,
	definitionsRaw: any?,
	modifierBreakdownRaw: any?,
	optionsRaw: BuildOptions?
): { StatToken }
	local options = if typeof(optionsRaw) == "table" then optionsRaw else {}
	local includeHidden = options.includeHidden == true
	local showUnchanged = if options.showUnchanged == nil then true else options.showUnchanged == true
	local deltaThreshold = clampNumber(options.deltaThreshold, 0, 0, 1e9)
	local modifierBreakdown = if typeof(modifierBreakdownRaw) == "table" then modifierBreakdownRaw else {}

	local definitions = self:_normalizeDefinitions(definitionsRaw, currentSource)
	local tokens = {}
	for index = 1, #definitions do
		local definition = definitions[index]
		if definition.hidden and not includeHidden then
			continue
		end
		local statId = definition.id
		local currentValue = toNumber(self:_read(currentSource, statId), 0)
		local compareValue = self:_read(compareSource, statId)
		local hasCompare = compareValue ~= nil and typeof(compareValue) == "number"
		local delta = if hasCompare then currentValue - (compareValue :: number) else 0

		if hasCompare and not showUnchanged and math.abs(delta) <= deltaThreshold then
			continue
		end

		tokens[#tokens + 1] = {
			kind = "label",
			statId = statId,
			text = (definition.label or statId) .. ": ",
			color = nil,
		}
		tokens[#tokens + 1] = {
			kind = "value",
			statId = statId,
			text = self:_formatValue(statId, currentValue, definition.format, definition.precision),
			color = nil,
		}

		if hasCompare then
			local deltaColor = self.neutralColor
			if math.abs(delta) > deltaThreshold then
				local positive = delta > 0
				if definition.inverseDelta then
					positive = not positive
				end
				deltaColor = if positive then self.positiveColor else self.negativeColor
			end
			local deltaText = self:_formatValue(statId, math.abs(delta), definition.format, definition.precision)
			local sign = if delta > 0 then "+" else if delta < 0 then "-" else ""
			tokens[#tokens + 1] = {
				kind = "separator",
				statId = statId,
				text = " ",
				color = nil,
			}
			tokens[#tokens + 1] = {
				kind = "delta",
				statId = statId,
				text = "(" .. sign .. deltaText .. ")",
				color = deltaColor,
			}
		end

		if definition.showBreakdown then
			local breakdown = modifierBreakdown[statId]
			if typeof(breakdown) == "table" then
				local base = toNumber(breakdown.base, 0)
				local add = toNumber(breakdown.additive, 0)
				local mul = toNumber(breakdown.multiplicative, 1)
				local breakdownText = string.format(" [base %s, +%s, x%s]", AbbreviationFormatter.formatNumber(base), AbbreviationFormatter.formatNumber(add), AbbreviationFormatter.formatNumber(mul))
				tokens[#tokens + 1] = {
					kind = "breakdown",
					statId = statId,
					text = breakdownText,
					color = self.neutralColor,
				}
			end
		end

		if index < #definitions then
			tokens[#tokens + 1] = {
				kind = "newline",
				statId = statId,
				text = "\n",
				color = nil,
			}
		end
	end
	return tokens
end

function StatStringBuilder.TokensToRichText(self: StatStringBuilder, tokensRaw: any): string
	if typeof(tokensRaw) ~= "table" then
		return ""
	end
	local builder = RichTextFormatter.new()
	for index = 1, #tokensRaw do
		local token = tokensRaw[index]
		if typeof(token) ~= "table" then
			continue
		end
		if token.kind == "newline" then
			builder:line()
			continue
		end
		if typeof(token.color) == "string" and token.color ~= "" then
			builder:preset(token.color, token.text)
		else
			builder:append(token.text)
		end
	end
	return builder:toString()
end

function StatStringBuilder.BuildRichText(
	self: StatStringBuilder,
	currentSource: any,
	compareSource: any?,
	definitionsRaw: any?,
	modifierBreakdownRaw: any?,
	optionsRaw: BuildOptions?
): string
	local tokens = self:buildTokens(currentSource, compareSource, definitionsRaw, modifierBreakdownRaw, optionsRaw)
	return self:tokensToRichText(tokens)
end

StatStringBuilder.new = StatStringBuilder.New
StatStringBuilder.buildTokens = StatStringBuilder.BuildTokens
StatStringBuilder.tokensToRichText = StatStringBuilder.TokensToRichText
StatStringBuilder.buildRichText = StatStringBuilder.BuildRichText

return StatStringBuilder
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="1283">
                <Properties>
                  <string name="Name">TextMeasurementCache</string>
                  <string name="Source"><![CDATA[--!strict
local TextService = game:GetService("TextService")

local TextMeasurementCache = {}
TextMeasurementCache.__index = TextMeasurementCache

export type MeasureRequest = {
	text: string,
	fontSize: number,
	font: Enum.Font?,
	bounds: Vector2?,
}

export type TextMeasurementCacheConfig = {
	maxEntries: number?,
	evictBatchSize: number?,
}

export type TextMeasurementCache = typeof(setmetatable({} :: any, TextMeasurementCache))

local function clampInteger(valueRaw: any, fallback: number, minValue: number, maxValue: number): number
	local value = if typeof(valueRaw) == "number" then math.floor(valueRaw) else fallback
	if value < minValue then
		return minValue
	end
	if value > maxValue then
		return maxValue
	end
	return value
end

local function normalizeBounds(boundsRaw: any): Vector2
	if typeof(boundsRaw) == "Vector2" then
		return Vector2.new(math.max(0, boundsRaw.X), math.max(0, boundsRaw.Y))
	end
	return Vector2.new(10000, 10000)
end

local function normalizeFont(fontRaw: any): Enum.Font
	if typeof(fontRaw) == "EnumItem" then
		return fontRaw :: Enum.Font
	end
	if typeof(fontRaw) == "string" then
		for _, enumValue in Enum.Font:GetEnumItems() do
			if enumValue.Name == fontRaw then
				return enumValue
			end
		end
	end
	return Enum.Font.SourceSans
end

local function buildKey(text: string, fontSize: number, font: Enum.Font, bounds: Vector2): string
	return string.format("%s|%d|%s|%d|%d", text, fontSize, font.Name, math.floor(bounds.X), math.floor(bounds.Y))
end

local function clearArray(array: { any })
	for index = #array, 1, -1 do
		array[index] = nil
	end
end

function TextMeasurementCache.New(configRaw: TextMeasurementCacheConfig?): TextMeasurementCache
	local config = if typeof(configRaw) == "table" then configRaw else {}
	local self = setmetatable({
		entries = {} :: { [string]: { size: Vector2, lastAccess: number } },
		maxEntries = clampInteger(config.maxEntries, 4096, 32, 200000),
		evictBatchSize = clampInteger(config.evictBatchSize, 128, 1, 50000),
		clock = 0,
		hits = 0,
		misses = 0,
	}, TextMeasurementCache)
	return self
end

function TextMeasurementCache._evictIfNeeded(self: TextMeasurementCache)
	local entryCount = 0
	for _ in self.entries do
		entryCount += 1
	end
	if entryCount <= self.maxEntries then
		return
	end

	local snapshots = {}
	for key, entry in self.entries do
		snapshots[#snapshots + 1] = {
			key = key,
			lastAccess = entry.lastAccess,
		}
	end
	table.sort(snapshots, function(a, b)
		return a.lastAccess < b.lastAccess
	end)

	local removeCount = math.min(#snapshots, math.max(entryCount - self.maxEntries, self.evictBatchSize))
	for index = 1, removeCount do
		self.entries[snapshots[index].key] = nil
	end
end

function TextMeasurementCache.Measure(
	self: TextMeasurementCache,
	textRaw: any,
	fontSizeRaw: any,
	fontRaw: any,
	boundsRaw: any
): Vector2
	local text = if typeof(textRaw) == "string" then textRaw else tostring(textRaw)
	local fontSize = clampInteger(fontSizeRaw, 14, 1, 512)
	local font = normalizeFont(fontRaw)
	local bounds = normalizeBounds(boundsRaw)
	local key = buildKey(text, fontSize, font, bounds)

	self.clock += 1
	local cached = self.entries[key]
	if cached ~= nil then
		self.hits += 1
		cached.lastAccess = self.clock
		return cached.size
	end

	self.misses += 1
	local size = TextService:GetTextSize(text, fontSize, font, bounds)
	self.entries[key] = {
		size = size,
		lastAccess = self.clock,
	}
	self:_evictIfNeeded()
	return size
end

function TextMeasurementCache.MeasureBatch(self: TextMeasurementCache, requestsRaw: any, outRaw: { Vector2 }?): { Vector2 }
	local out = if outRaw ~= nil then outRaw else {}
	if typeof(requestsRaw) ~= "table" then
		clearArray(out)
		return out
	end

	local count = #requestsRaw
	for index = 1, count do
		local request = requestsRaw[index]
		if typeof(request) ~= "table" then
			out[index] = Vector2.zero
			continue
		end
		out[index] = self:measure(request.text, request.fontSize, request.font, request.bounds)
	end
	for index = #out, count + 1, -1 do
		out[index] = nil
	end
	return out
end

function TextMeasurementCache.SetMaxEntries(self: TextMeasurementCache, maxEntriesRaw: any)
	self.maxEntries = clampInteger(maxEntriesRaw, self.maxEntries, 32, 200000)
	self:_evictIfNeeded()
end

function TextMeasurementCache.Clear(self: TextMeasurementCache)
	table.clear(self.entries)
	self.clock = 0
	self.hits = 0
	self.misses = 0
end

function TextMeasurementCache.GetStats(self: TextMeasurementCache): { [string]: number }
	local entryCount = 0
	for _ in self.entries do
		entryCount += 1
	end
	return {
		entries = entryCount,
		hits = self.hits,
		misses = self.misses,
		maxEntries = self.maxEntries,
	}
end

TextMeasurementCache.new = TextMeasurementCache.New
TextMeasurementCache.measure = TextMeasurementCache.Measure
TextMeasurementCache.measureBatch = TextMeasurementCache.MeasureBatch
TextMeasurementCache.setMaxEntries = TextMeasurementCache.SetMaxEntries
TextMeasurementCache.clear = TextMeasurementCache.Clear
TextMeasurementCache.getStats = TextMeasurementCache.GetStats

return TextMeasurementCache
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="1284">
                <Properties>
                  <string name="Name">TooltipManager</string>
                  <string name="Source"><![CDATA[--!strict
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local DynamicTextResolver = require(script.Parent.DynamicTextResolver)
local RichTextFormatter = require(script.Parent.RichTextFormatter)
local StatStringBuilder = require(script.Parent.StatStringBuilder)
local TextMeasurementCache = require(script.Parent.TextMeasurementCache)

local TooltipManager = {}
TooltipManager.__index = TooltipManager

export type TooltipManagerConfig = {
	container: GuiObject,
	springAnimator: any?,
	tickScheduler: any?,
	textResolver: any?,
	richTextFormatter: any?,
	statStringBuilder: any?,
	textMeasurementCache: any?,
	createTooltipFrame: (() -> Frame)?,
	maxPoolSize: number?,
	offset: Vector2?,
	maxWidth: number?,
}

export type TooltipMetadata = {
	title: string?,
	description: string?,
	rarity: string?,
	stats: any?,
	compareStats: any?,
	statDefinitions: any?,
	statBreakdown: any?,
	extraLines: { string }?,
	context: { [string]: any }?,
	maxWidth: number?,
}

local RARITY_PRESET = {
	common = "rarityCommon",
	uncommon = "rarityUncommon",
	rare = "rarityRare",
	epic = "rarityEpic",
	legendary = "rarityLegendary",
}

local function clampInteger(valueRaw: any, fallback: number, minValue: number, maxValue: number): number
	local value = if typeof(valueRaw) == "number" then math.floor(valueRaw) else fallback
	if value < minValue then
		return minValue
	end
	if value > maxValue then
		return maxValue
	end
	return value
end

local function clearArray(array: { any })
	for index = #array, 1, -1 do
		array[index] = nil
	end
end

local function safeDisconnect(connection: any?)
	if connection == nil then
		return
	end
	pcall(function()
		connection:Disconnect()
	end)
end

local function defaultCreateTooltipFrame(): Frame
	local frame = Instance.new("Frame")
	frame.Name = "Tooltip"
	frame.BackgroundColor3 = Color3.fromRGB(15, 15, 18)
	frame.BackgroundTransparency = 0.15
	frame.BorderColor3 = Color3.fromRGB(50, 50, 60)
	frame.BorderSizePixel = 1
	frame.Size = UDim2.fromOffset(280, 120)
	frame.Visible = false
	frame.ZIndex = 900

	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, 8)
	padding.PaddingBottom = UDim.new(0, 8)
	padding.PaddingLeft = UDim.new(0, 10)
	padding.PaddingRight = UDim.new(0, 10)
	padding.Parent = frame

	local label = Instance.new("TextLabel")
	label.Name = "Body"
	label.BackgroundTransparency = 1
	label.Size = UDim2.new(1, 0, 1, 0)
	label.Position = UDim2.fromOffset(0, 0)
	label.Font = Enum.Font.Gotham
	label.TextColor3 = Color3.fromRGB(240, 240, 240)
	label.TextSize = 14
	label.TextWrapped = true
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextYAlignment = Enum.TextYAlignment.Top
	label.RichText = true
	label.ZIndex = 901
	label.Parent = frame

	local uiScale = Instance.new("UIScale")
	uiScale.Name = "Scale"
	uiScale.Scale = 1
	uiScale.Parent = frame

	return frame
end

function TooltipManager.New(configRaw: TooltipManagerConfig): any
	if typeof(configRaw) ~= "table" or typeof(configRaw.container) ~= "Instance" then
		error("TooltipManager.New expects config.container")
	end
	local self = setmetatable({
		container = configRaw.container,
		springAnimator = configRaw.springAnimator,
		resolver = if configRaw.textResolver ~= nil then configRaw.textResolver else DynamicTextResolver.new(),
		rich = if configRaw.richTextFormatter ~= nil then configRaw.richTextFormatter else RichTextFormatter,
		stats = if configRaw.statStringBuilder ~= nil then configRaw.statStringBuilder else StatStringBuilder.new(),
		measure = if configRaw.textMeasurementCache ~= nil then configRaw.textMeasurementCache else TextMeasurementCache.new(),
		createTooltipFrame = if typeof(configRaw.createTooltipFrame) == "function" then configRaw.createTooltipFrame else defaultCreateTooltipFrame,
		maxPoolSize = clampInteger(configRaw.maxPoolSize, 12, 1, 100),
		offset = if typeof(configRaw.offset) == "Vector2" then configRaw.offset else Vector2.new(18, 18),
		defaultMaxWidth = clampInteger(configRaw.maxWidth, 320, 80, 1200),
		pool = {} :: { Frame },
		activePrimary = nil :: Frame?,
		activeCompare = nil :: Frame?,
		tickScheduler = configRaw.tickScheduler,
		positionToken = nil,
		positionConnection = nil,
		hoverConnections = {} :: { any },
		isVisible = false,
	}, TooltipManager)
	return self
end

function TooltipManager._acquire(self: any): Frame
	local frame = table.remove(self.pool)
	if frame ~= nil then
		return frame
	end
	return self.createTooltipFrame()
end

function TooltipManager._release(self: any, frame: Frame?)
	if frame == nil then
		return
	end
	frame.Visible = false
	frame.Parent = nil
	if #self.pool < self.maxPoolSize then
		self.pool[#self.pool + 1] = frame
		return
	end
	frame:Destroy()
end

function TooltipManager._animateShow(self: any, frame: Frame)
	local label = frame:FindFirstChild("Body")
	local scale = frame:FindFirstChild("Scale")
	frame.Visible = true
	frame.BackgroundTransparency = 1
	if label ~= nil and label:IsA("TextLabel") then
		label.TextTransparency = 1
	end
	if scale ~= nil and scale:IsA("UIScale") then
		scale.Scale = 0.96
	end
	if self.springAnimator ~= nil and typeof((self.springAnimator :: any).animate) == "function" then
		local springAnimatorAny = self.springAnimator :: any
		springAnimatorAny:animate(frame, "BackgroundTransparency", 0.15, { frequency = 9, dampingRatio = 1 })
		if label ~= nil and label:IsA("TextLabel") then
			springAnimatorAny:animate(label, "TextTransparency", 0, { frequency = 9, dampingRatio = 1 })
		end
		if scale ~= nil and scale:IsA("UIScale") then
			springAnimatorAny:animate(scale, "Scale", 1, { frequency = 8, dampingRatio = 1 })
		end
	else
		frame.BackgroundTransparency = 0.15
		if label ~= nil and label:IsA("TextLabel") then
			label.TextTransparency = 0
		end
		if scale ~= nil and scale:IsA("UIScale") then
			scale.Scale = 1
		end
	end
end

function TooltipManager._animateHide(self: any, frame: Frame)
	local label = frame:FindFirstChild("Body")
	local scale = frame:FindFirstChild("Scale")
	if self.springAnimator ~= nil and typeof((self.springAnimator :: any).animate) == "function" then
		local springAnimatorAny = self.springAnimator :: any
		springAnimatorAny:animate(frame, "BackgroundTransparency", 1, { frequency = 10, dampingRatio = 1 })
		if label ~= nil and label:IsA("TextLabel") then
			springAnimatorAny:animate(label, "TextTransparency", 1, { frequency = 10, dampingRatio = 1 })
		end
		if scale ~= nil and scale:IsA("UIScale") then
			springAnimatorAny:animate(scale, "Scale", 0.96, { frequency = 10, dampingRatio = 1 })
		end
		task.delay(0.22, function()
			self:_release(frame)
		end)
	else
		self:_release(frame)
	end
end

function TooltipManager._composeText(self: any, metadataRaw: TooltipMetadata, compareMetadataRaw: TooltipMetadata?): string
	local metadata = if typeof(metadataRaw) == "table" then metadataRaw else {}
	local context = if typeof(metadata.context) == "table" then metadata.context else {}
	local builder = self.rich.new()

	if typeof(metadata.title) == "string" and metadata.title ~= "" then
		local title = self.resolver:resolve(metadata.title, context)
		local rarity = string.lower(if typeof(metadata.rarity) == "string" then metadata.rarity else "")
		local preset = RARITY_PRESET[rarity]
		if preset ~= nil then
			builder:preset(preset, title)
		else
			builder:bold(title)
		end
		builder:line()
	end

	if typeof(metadata.description) == "string" and metadata.description ~= "" then
		builder:append(self.resolver:resolve(metadata.description, context))
		builder:line()
	end

	if metadata.stats ~= nil then
		local statsText = self.stats:buildRichText(
			metadata.stats,
			if compareMetadataRaw ~= nil then compareMetadataRaw.stats else metadata.compareStats,
			metadata.statDefinitions,
			metadata.statBreakdown,
			{ showUnchanged = false }
		)
		if statsText ~= "" then
			builder:raw(statsText)
			builder:line()
		end
	end

	if typeof(metadata.extraLines) == "table" then
		for _, line in metadata.extraLines do
			if typeof(line) == "string" and line ~= "" then
				builder:append(self.resolver:resolve(line, context))
				builder:line()
			end
		end
	end

	return builder:toString()
end

function TooltipManager._applyContent(self: any, frame: Frame, text: string, maxWidthRaw: any)
	local label = frame:FindFirstChild("Body")
	if label == nil or not label:IsA("TextLabel") then
		return
	end
	local maxWidth = clampInteger(maxWidthRaw, self.defaultMaxWidth, 80, 1200)
	label.Text = text
	local measureText = string.gsub(text, "<.->", "")
	local measured = self.measure:measure(measureText, label.TextSize, label.Font, Vector2.new(maxWidth, 2000))
	local width = math.min(maxWidth, math.max(120, math.floor(measured.X + 24)))
	local height = math.max(36, math.floor(measured.Y + 18))
	frame.Size = UDim2.fromOffset(width, height)
end

function TooltipManager._clampPosition(self: any, frame: Frame, preferred: Vector2): Vector2
	local parentSize = self.container.AbsoluteSize
	local size = frame.AbsoluteSize
	local x = preferred.X
	local y = preferred.Y
	if x + size.X > parentSize.X then
		x = parentSize.X - size.X - 4
	end
	if y + size.Y > parentSize.Y then
		y = parentSize.Y - size.Y - 4
	end
	x = math.max(0, x)
	y = math.max(0, y)
	return Vector2.new(x, y)
end

function TooltipManager._updatePosition(self: any)
	if not self.isVisible then
		return
	end
	local mouse = UserInputService:GetMouseLocation()
	if self.activePrimary ~= nil then
		local target = self:_clampPosition(self.activePrimary, mouse + self.offset)
		self.activePrimary.Position = UDim2.fromOffset(target.X, target.Y)
		if self.activeCompare ~= nil then
			local compareOffset = Vector2.new(self.activePrimary.AbsoluteSize.X + 12, 0)
			local compareTarget = self:_clampPosition(self.activeCompare, target + compareOffset)
			self.activeCompare.Position = UDim2.fromOffset(compareTarget.X, compareTarget.Y)
		end
	end
end

function TooltipManager.Show(self: any, metadataRaw: TooltipMetadata, compareMetadataRaw: TooltipMetadata?)
	self:hide()
	local metadata = if typeof(metadataRaw) == "table" then metadataRaw else {}
	local compareMetadata = if typeof(compareMetadataRaw) == "table" then compareMetadataRaw else nil
	local primary = self:_acquire()
	local primaryText = self:_composeText(metadata, compareMetadata)
	self:_applyContent(primary, primaryText, metadata.maxWidth)
	primary.Parent = self.container
	self.activePrimary = primary
	self:_animateShow(primary)

	if compareMetadata ~= nil then
		local compare = self:_acquire()
		local compareText = self:_composeText(compareMetadata, metadata)
		self:_applyContent(compare, compareText, compareMetadata.maxWidth)
		compare.Parent = self.container
		self.activeCompare = compare
		self:_animateShow(compare)
	end

	self.isVisible = true
	self:_updatePosition()
	if self.positionToken == nil and self.tickScheduler ~= nil and typeof((self.tickScheduler :: any).scheduleEvery) == "function" then
		self.positionToken = (self.tickScheduler :: any):scheduleEvery(function()
			self:_updatePosition()
		end, 1 / 60, {
			group = "ui.tooltips",
			priority = 250,
			catchUp = false,
		})
	elseif self.positionConnection == nil then
		self.positionConnection = RunService.RenderStepped:Connect(function()
			self:_updatePosition()
		end)
	end
end

function TooltipManager.Hide(self: any)
	if self.activePrimary ~= nil then
		self:_animateHide(self.activePrimary)
		self.activePrimary = nil
	end
	if self.activeCompare ~= nil then
		self:_animateHide(self.activeCompare)
		self.activeCompare = nil
	end
	self.isVisible = false
	if self.positionToken ~= nil then
		if typeof(self.positionToken.cancel) == "function" then
			self.positionToken:cancel()
		elseif self.tickScheduler ~= nil and typeof((self.tickScheduler :: any).cancel) == "function" then
			local schedulerAny = self.tickScheduler :: any
			schedulerAny:cancel(self.positionToken)
		end
		self.positionToken = nil
	end
	if self.positionConnection ~= nil then
		safeDisconnect(self.positionConnection)
		self.positionConnection = nil
	end
end

function TooltipManager.BindHover(self: any, targetRaw: any, metadataProviderRaw: any): () -> ()
	if typeof(targetRaw) ~= "Instance" or not targetRaw:IsA("GuiObject") then
		return function() end
	end
	if typeof(metadataProviderRaw) ~= "function" then
		return function() end
	end
	local target = targetRaw :: GuiObject
	local enterConnection = target.MouseEnter:Connect(function()
		local metadata, compare = metadataProviderRaw(target)
		if metadata ~= nil then
			self:show(metadata, compare)
		end
	end)
	local leaveConnection = target.MouseLeave:Connect(function()
		self:hide()
	end)
	local destroyConnection = nil
	if typeof((target :: any).Destroying) == "RBXScriptSignal" then
		destroyConnection = (target :: any).Destroying:Connect(function()
			self:hide()
			safeDisconnect(enterConnection)
			safeDisconnect(leaveConnection)
		end)
	end
	local slot = {
		enter = enterConnection,
		leave = leaveConnection,
		destroy = destroyConnection,
	}
	self.hoverConnections[#self.hoverConnections + 1] = slot
	return function()
		safeDisconnect(slot.enter)
		safeDisconnect(slot.leave)
		safeDisconnect(slot.destroy)
	end
end

function TooltipManager.Destroy(self: any)
	self:hide()
	for index = #self.hoverConnections, 1, -1 do
		local slot = self.hoverConnections[index]
		safeDisconnect(slot.enter)
		safeDisconnect(slot.leave)
		safeDisconnect(slot.destroy)
		self.hoverConnections[index] = nil
	end
	for index = #self.pool, 1, -1 do
		self.pool[index]:Destroy()
		self.pool[index] = nil
	end
end

TooltipManager.Show = TooltipManager.Show
TooltipManager.Hide = TooltipManager.Hide
TooltipManager.BindHover = TooltipManager.BindHover

TooltipManager.new = TooltipManager.New
TooltipManager.show = TooltipManager.Show
TooltipManager.hide = TooltipManager.Hide
TooltipManager.bindHover = TooltipManager.BindHover
TooltipManager.destroy = TooltipManager.Destroy

return TooltipManager
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="1285">
                <Properties>
                  <string name="Name">UIController</string>
                  <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Sift = require(ReplicatedStorage.Packages.Sift)

local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")
local Platform = require(script.Parent.Parent.Platform.Platform)

local UIController = {}
UIController.__index = UIController

export type ScreenHooks = {
	OnOpen: ((payload: any, controller: any) -> ())?,
	OnClose: ((payload: any, controller: any) -> ())?,
	OnPause: ((payload: any, controller: any) -> ())?,
	OnResume: ((payload: any, controller: any) -> ())?,
}

export type TransitionConfig = {
	enabled: boolean?,
	property: string?,
	openedValue: any?,
	closedValue: any?,
	spring: { [string]: any }?,
}

export type ScreenDefinition = {
	key: string,
	frame: GuiObject?,
	isModal: boolean?,
	zIndex: number?,
	closable: boolean?,
	initialFocus: GuiObject?,
	hooks: ScreenHooks?,
	transition: TransitionConfig?,
}

export type UIControllerConfig = {
	springAnimator: any?,
	platform: any?,
	escEnabled: boolean?,
	screenBaseZ: number?,
	modalBaseZ: number?,
	modalStepZ: number?,
}

export type UIController = typeof(setmetatable({} :: any, UIController))

local function clampInteger(valueRaw: any, fallback: number, minValue: number, maxValue: number): number
	local value = if typeof(valueRaw) == "number" then math.floor(valueRaw) else fallback
	if value < minValue then
		return minValue
	end
	if value > maxValue then
		return maxValue
	end
	return value
end

local function safeDisconnect(connection: any?)
	if connection == nil then
		return
	end
	pcall(function()
		connection:Disconnect()
	end)
end

local function clearArray(array: { any })
	for index = #array, 1, -1 do
		array[index] = nil
	end
end

local function isGamepadInput(inputType: Enum.UserInputType): boolean
	return string.sub(inputType.Name, 1, 7) == "Gamepad"
end

local function setVisible(frame: GuiObject?, visible: boolean)
	if frame == nil then
		return
	end
	pcall(function()
		(frame :: any).Visible = visible
	end)
end

local function applyZShift(root: GuiObject?, targetBase: number)
	if root == nil then
		return
	end
	local currentBase = root.ZIndex
	local delta = targetBase - currentBase
	if delta == 0 then
		return
	end
	root.ZIndex = targetBase
	for _, descendant in root:GetDescendants() do
		if descendant:IsA("GuiObject") then
			descendant.ZIndex = math.max(1, descendant.ZIndex + delta)
		end
	end
end

local function navigationModeFromPrimaryInput(primaryInputTypeRaw: any): string
	if primaryInputTypeRaw == "Gamepad" then
		return "Gamepad"
	end
	return "KeyboardMouse"
end

function UIController.New(configRaw: UIControllerConfig?): UIController
	local config = if typeof(configRaw) == "table" then configRaw else {}
	local self = setmetatable({
		registry = {} :: { [string]: any },
		activeScreenKey = nil :: string?,
		modalStack = {} :: { string },
		modalFocusStack = {} :: { GuiObject? },
		inputLocked = false,
		navigationMode = "KeyboardMouse",
		escEnabled = if config.escEnabled == nil then true else config.escEnabled == true,
		springAnimator = config.springAnimator,
		platform = if config.platform ~= nil then config.platform else Platform.new(),
		ownsPlatform = config.platform == nil,
		platformDisconnect = nil :: (() -> ())?,
		screenBaseZ = clampInteger(config.screenBaseZ, 10, 1, 10000),
		modalBaseZ = clampInteger(config.modalBaseZ, 300, 1, 10000),
		modalStepZ = clampInteger(config.modalStepZ, 40, 1, 10000),
		isInitialized = false,
		connections = {} :: { any },
	}, UIController)
	return self
end

function UIController._setNavigationModeFromPlatformSnapshot(self: UIController, snapshotRaw: any)
	if typeof(snapshotRaw) ~= "table" then
		return
	end
	self.navigationMode = navigationModeFromPrimaryInput(snapshotRaw.primaryInputType)
end

function UIController._syncNavigationModeFromPlatform(self: UIController): boolean
	local platform = self.platform
	if platform == nil then
		return false
	end

	if typeof((platform :: any).getSnapshot) == "function" then
		local ok, snapshot = pcall(function()
			return (platform :: any):getSnapshot()
		end)
		if ok then
			self:_setNavigationModeFromPlatformSnapshot(snapshot)
			return true
		end
	end

	if typeof((platform :: any).getPrimaryInputType) == "function" then
		local ok, primaryInputType = pcall(function()
			return (platform :: any):getPrimaryInputType()
		end)
		if ok then
			self.navigationMode = navigationModeFromPrimaryInput(primaryInputType)
			return true
		end
	end

	return false
end

function UIController.Init(self: UIController)
	if self.isInitialized then
		return
	end
	self.isInitialized = true
	self.connections[#self.connections + 1] = UserInputService.InputBegan:Connect(function(input: InputObject, gameProcessed: boolean)
		if gameProcessed then
			return
		end
		if self.inputLocked then
			return
		end
		if input.KeyCode == Enum.KeyCode.Escape and self.escEnabled then
			if #self.modalStack > 0 then
				self:popModal()
				return
			end
			if self.activeScreenKey ~= nil then
				local screen = self.registry[self.activeScreenKey]
				if screen ~= nil and screen.closable ~= false then
					self:closeScreen(self.activeScreenKey)
				end
			end
		end
	end)

	if self.platform ~= nil then
		if typeof((self.platform :: any).init) == "function" then
			pcall(function()
				local platformAny = self.platform :: any
				platformAny:init()
			end)
		end

		self:_syncNavigationModeFromPlatform()
		if typeof((self.platform :: any).onChanged) == "function" then
			self.platformDisconnect = (self.platform :: any):onChanged(function(nextState: any)
				self:_setNavigationModeFromPlatformSnapshot(nextState)
			end)
		end
	end

	if self.platformDisconnect == nil then
		self.connections[#self.connections + 1] = UserInputService.LastInputTypeChanged:Connect(function(inputType: Enum.UserInputType)
			if isGamepadInput(inputType) then
				self.navigationMode = "Gamepad"
			else
				self.navigationMode = "KeyboardMouse"
			end
		end)
	end
end

function UIController.RegisterScreen(self: UIController, definitionRaw: any): boolean
	if typeof(definitionRaw) ~= "table" then
		return false
	end
	if typeof(definitionRaw.key) ~= "string" or definitionRaw.key == "" then
		return false
	end
	local key = definitionRaw.key
	if self.registry[key] ~= nil then
		return false
	end

	self.registry[key] = {
		key = key,
		frame = if typeof(definitionRaw.frame) == "Instance" then definitionRaw.frame else nil,
		isModal = definitionRaw.isModal == true,
		zIndex = clampInteger(definitionRaw.zIndex, self.screenBaseZ, 1, 10000),
		closable = if definitionRaw.closable == nil then true else definitionRaw.closable == true,
		initialFocus = if typeof(definitionRaw.initialFocus) == "Instance" then definitionRaw.initialFocus else nil,
		hooks = if typeof(definitionRaw.hooks) == "table" then definitionRaw.hooks else {},
		transition = if typeof(definitionRaw.transition) == "table" then definitionRaw.transition else {},
	}
	setVisible(self.registry[key].frame, false)
	return true
end

function UIController.UnregisterScreen(self: UIController, keyRaw: any)
	if typeof(keyRaw) ~= "string" then
		return
	end
	if self.activeScreenKey == keyRaw then
		self:closeScreen(keyRaw)
	end
	for index = #self.modalStack, 1, -1 do
		if self.modalStack[index] == keyRaw then
			table.remove(self.modalStack, index)
			table.remove(self.modalFocusStack, index)
		end
	end
	self.registry[keyRaw] = nil
end

function UIController._playTransition(self: UIController, screen: any, opening: boolean)
	local frame = screen.frame
	if frame == nil then
		return
	end
	local transition = screen.transition
	if transition == nil or transition.enabled == false then
		return
	end
	local property = if typeof(transition.property) == "string" then transition.property else "BackgroundTransparency"
	local target = if opening then transition.openedValue else transition.closedValue
	if target == nil then
		if property == "BackgroundTransparency" then
			target = if opening then 0 else 1
		elseif property == "GroupTransparency" then
			target = if opening then 0 else 1
		end
	end
	if target == nil then
		return
	end

	if self.springAnimator ~= nil and typeof((self.springAnimator :: any).animate) == "function" then
		local springAnimatorAny = self.springAnimator :: any
		springAnimatorAny:animate(frame, property, target, transition.spring)
		return
	end
	pcall(function()
		(frame :: any)[property] = target
	end)
end

function UIController._fireHook(self: UIController, screen: any, hookName: string, payload: any)
	local hooks = screen.hooks
	if hooks == nil then
		return
	end
	local callback = hooks[hookName]
	if typeof(callback) ~= "function" then
		return
	end
	callback(payload, self)
end

function UIController._setScreenVisible(self: UIController, screen: any, visible: boolean, zIndex: number)
	if screen.frame ~= nil then
		applyZShift(screen.frame, zIndex)
	end
	setVisible(screen.frame, visible)
	if visible then
		self:_playTransition(screen, true)
	else
		self:_playTransition(screen, false)
	end
end

function UIController.OpenScreen(self: UIController, keyRaw: any, payload: any?): boolean
	if typeof(keyRaw) ~= "string" then
		return false
	end
	local screen = self.registry[keyRaw]
	if screen == nil or screen.isModal then
		return false
	end
	if self.activeScreenKey == keyRaw then
		return true
	end
	if self.activeScreenKey ~= nil then
		self:closeScreen(self.activeScreenKey)
	end

	self.activeScreenKey = keyRaw
	self:_setScreenVisible(screen, true, screen.zIndex)
	self:_fireHook(screen, "OnOpen", payload)
	return true
end

function UIController.CloseScreen(self: UIController, keyRaw: any?, payload: any?): boolean
	local key = if typeof(keyRaw) == "string" then keyRaw else self.activeScreenKey
	if key == nil then
		return false
	end
	local screen = self.registry[key]
	if screen == nil then
		return false
	end
	if self.activeScreenKey ~= key then
		return false
	end

	self:_fireHook(screen, "OnClose", payload)
	self:_setScreenVisible(screen, false, screen.zIndex)
	self.activeScreenKey = nil
	return true
end

function UIController.PushModal(self: UIController, keyRaw: any, payload: any?): boolean
	if typeof(keyRaw) ~= "string" then
		return false
	end
	local screen = self.registry[keyRaw]
	if screen == nil or not screen.isModal then
		return false
	end

	local currentTopKey = self.modalStack[#self.modalStack]
	if currentTopKey ~= nil then
		local currentTop = self.registry[currentTopKey]
		if currentTop ~= nil then
			self:_fireHook(currentTop, "OnPause", payload)
		end
	end

	self.modalStack[#self.modalStack + 1] = keyRaw
	self.modalFocusStack[#self.modalFocusStack + 1] = GuiService.SelectedObject

	for index = 1, #self.modalStack do
		local modalKey = self.modalStack[index]
		local modal = self.registry[modalKey]
		if modal ~= nil then
			self:_setScreenVisible(modal, true, self.modalBaseZ + (index - 1) * self.modalStepZ)
		end
	end

	self:_fireHook(screen, "OnOpen", payload)
	if self.navigationMode == "Gamepad" and screen.initialFocus ~= nil then
		GuiService.SelectedObject = screen.initialFocus
	end
	return true
end

function UIController.PopModal(self: UIController, payload: any?): boolean
	local topIndex = #self.modalStack
	if topIndex <= 0 then
		return false
	end
	local key = self.modalStack[topIndex]
	local screen = self.registry[key]
	table.remove(self.modalStack, topIndex)
	local previousFocus = table.remove(self.modalFocusStack, topIndex)

	if screen ~= nil then
		self:_fireHook(screen, "OnClose", payload)
		self:_setScreenVisible(screen, false, self.modalBaseZ)
	end

	local newTopKey = self.modalStack[#self.modalStack]
	if newTopKey ~= nil then
		local newTop = self.registry[newTopKey]
		if newTop ~= nil then
			self:_fireHook(newTop, "OnResume", payload)
		end
	end

	for index = 1, #self.modalStack do
		local modal = self.registry[self.modalStack[index]]
		if modal ~= nil then
			applyZShift(modal.frame, self.modalBaseZ + (index - 1) * self.modalStepZ)
		end
	end

	if self.navigationMode == "Gamepad" then
		GuiService.SelectedObject = previousFocus
	end
	return true
end

function UIController.CloseTopModal(self: UIController, payload: any?): boolean
	return self:popModal(payload)
end

function UIController.SetInputLocked(self: UIController, lockedRaw: any)
	self.inputLocked = lockedRaw == true
end

function UIController.IsInputLocked(self: UIController): boolean
	return self.inputLocked
end

function UIController.SetNavigationMode(self: UIController, modeRaw: any)
	if modeRaw == "Gamepad" or modeRaw == "KeyboardMouse" then
		self.navigationMode = modeRaw
	end
end

function UIController.GetNavigationMode(self: UIController): string
	return self.navigationMode
end

function UIController.GetActiveScreen(self: UIController): string?
	return self.activeScreenKey
end

function UIController.GetTopModal(self: UIController): string?
	return self.modalStack[#self.modalStack]
end

function UIController.GetModalStack(self: UIController): { string }
	return Sift.Dictionary.copy(self.modalStack)
end

function UIController.Destroy(self: UIController)
	for key, screen in self.registry do
		if screen.isModal then
			setVisible(screen.frame, false)
		else
			if self.activeScreenKey == key then
				setVisible(screen.frame, false)
			end
		end
	end
	table.clear(self.registry)
	self.activeScreenKey = nil
	clearArray(self.modalStack)
	clearArray(self.modalFocusStack)
	for index = #self.connections, 1, -1 do
		safeDisconnect(self.connections[index])
		self.connections[index] = nil
	end
	if self.platformDisconnect ~= nil then
		self.platformDisconnect()
		self.platformDisconnect = nil
	end
	if self.ownsPlatform and self.platform ~= nil and typeof((self.platform :: any).destroy) == "function" then
		pcall(function()
			local platformAny = self.platform :: any
			platformAny:destroy()
		end)
	end
	self.platform = nil
	self.ownsPlatform = false
	self.isInitialized = false
end

UIController.RegisterScreen = UIController.RegisterScreen
UIController.UnregisterScreen = UIController.UnregisterScreen
UIController.OpenScreen = UIController.OpenScreen
UIController.CloseScreen = UIController.CloseScreen
UIController.PushModal = UIController.PushModal
UIController.PopModal = UIController.PopModal
UIController.CloseTopModal = UIController.CloseTopModal
UIController.SetInputLocked = UIController.SetInputLocked
UIController.GetActiveScreen = UIController.GetActiveScreen
UIController.Init = UIController.Init
UIController.Destroy = UIController.Destroy

UIController.new = UIController.New
UIController.init = UIController.Init
UIController.registerScreen = UIController.RegisterScreen
UIController.unregisterScreen = UIController.UnregisterScreen
UIController.openScreen = UIController.OpenScreen
UIController.closeScreen = UIController.CloseScreen
UIController.pushModal = UIController.PushModal
UIController.popModal = UIController.PopModal
UIController.closeTopModal = UIController.CloseTopModal
UIController.setInputLocked = UIController.SetInputLocked
UIController.isInputLocked = UIController.IsInputLocked
UIController.setNavigationMode = UIController.SetNavigationMode
UIController.getNavigationMode = UIController.GetNavigationMode
UIController.getActiveScreen = UIController.GetActiveScreen
UIController.getTopModal = UIController.GetTopModal
UIController.getModalStack = UIController.GetModalStack
UIController.destroy = UIController.Destroy

return UIController
]]></string>
