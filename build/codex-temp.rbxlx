local ReactInternalTypes = require(script.Parent:WaitForChild('ReactInternalTypes'))
type Fiber = ReactInternalTypes.Fiber
local ReactFiberHostConfig = require(script.Parent:WaitForChild('ReactFiberHostConfig'))
