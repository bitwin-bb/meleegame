	-- 	error(error_)
	-- end
	local modulePath = moduleName
	-- ROBLOX deviation END
	-- ROBLOX deviation START: add type annotation
	-- local moduleRegistry
	local moduleRegistry: ModuleRegistry
	-- ROBLOX deviation END
	if isInternal then
		moduleRegistry = self._internalModuleRegistry
