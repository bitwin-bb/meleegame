            </Properties>
            <Item class="ModuleScript" referent="1006">
              <Properties>
                <string name="Name">BossBinder</string>
                <string name="Source"><![CDATA[--!strict

local BossServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.BossServiceUtils)
local ModelBinder = require(script:FindFirstAncestor("game").Shared.Binders.ModelBinder)
local TagBinder = require(script:FindFirstAncestor("game").Shared.Binders.TagBinder)

local BossBinder = {}
BossBinder.__index = BossBinder
setmetatable(BossBinder, ModelBinder)

local function resolveBossId(self: any, model: Model): string
	local runtimeBossId = BossServiceUtils.resolveBossIdFromInstance(model)
	if runtimeBossId ~= nil then
		return runtimeBossId
	end
	if self:HasTag(TagBinder.Tags.Boss_EyeOfCthulhu) then
		return "EyeOfCthulhu"
	end
	return "Boss"
end

function BossBinder.new(instance: Instance, context: any)
	local self = ModelBinder.new(instance, context, BossBinder)
	self.model = self:GetModel()
	if self.model ~= nil then
		self:updateMetadata()
	end
	return self
end

function BossBinder.updateMetadata(self: any)
	local model = self.model
	if model == nil then
		return
	end

	model:SetAttribute("BossBinderTagged", true)
	model:SetAttribute("BossBinderBossId", resolveBossId(self, model))

	local runtimeId = BossServiceUtils.resolveRuntimeIdFromInstance(model)
	if runtimeId ~= nil then
		model:SetAttribute("BossBinderRuntimeId", runtimeId)
	end
end

return BossBinder
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="1007">
              <Properties>
                <string name="Name">BreakableBinder</string>
                <string name="Source"><![CDATA[--!strict

local ModelBinder = require(script:FindFirstAncestor("game").Shared.Binders.ModelBinder)

local BreakableBinder = {}
BreakableBinder.__index = BreakableBinder
setmetatable(BreakableBinder, ModelBinder)

local function resolveNumber(valueRaw: any, fallback: number): number
	if typeof(valueRaw) ~= "number" or valueRaw ~= valueRaw then
		return fallback
	end
	return valueRaw
end

function BreakableBinder.new(instance: Instance, context: any)
	local self = ModelBinder.new(instance, context, BreakableBinder)
	self.broken = false
	self:refresh()

	self:ObserveAttribute("BreakableHealth", function()
		self:refresh()
	end)

	local humanoid = self:GetHumanoid()
	if humanoid ~= nil then
		self:Connect(humanoid.Died, function()
			self:triggerBreak("HumanoidDied")
		end)
	end

	return self
end

function BreakableBinder.refresh(self: any)
	local maxHealth = resolveNumber(self.instance:GetAttribute("BreakableMaxHealth"), 1)
	local health = resolveNumber(self.instance:GetAttribute("BreakableHealth"), maxHealth)
	self.instance:SetAttribute("BreakableTagged", true)
	self.instance:SetAttribute("BreakableMaxHealth", maxHealth)
	self.instance:SetAttribute("BreakableHealth", health)
	if health <= 0 then
		self:triggerBreak("HealthDepleted")
	end
end

function BreakableBinder.triggerBreak(self: any, reason: string)
	if self.broken then
		return
	end
	self.broken = true

	self.instance:SetAttribute("BreakableBroken", true)
	self.instance:SetAttribute("BreakableReason", reason)

	local destroyDelay = self.instance:GetAttribute("BreakableDestroyDelay")
	if typeof(destroyDelay) == "number" and destroyDelay > 0 then
		task.delay(destroyDelay, function()
			if self.destroyed or self.instance.Parent == nil then
				return
			end
			self.instance:Destroy()
		end)
	else
		if self.instance.Parent ~= nil then
			self.instance:Destroy()
		end
	end
end

return BreakableBinder
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="1008">
              <Properties>
                <string name="Name">BreathBinder</string>
                <string name="Source"><![CDATA[--!strict

local LiquidServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.LiquidServiceUtils)
local ModelBinder = require(script:FindFirstAncestor("game").Shared.Binders.ModelBinder)
local TagBinder = require(script:FindFirstAncestor("game").Shared.Binders.TagBinder)

local BreathBinder = {}
BreathBinder.__index = BreathBinder
setmetatable(BreathBinder, ModelBinder)

local ACTIVE_BINDERS = {} :: { [BreathBinder]: boolean }

local function containsPointInPart(part: BasePart, worldPosition: Vector3): boolean
	local localPosition = part.CFrame:PointToObjectSpace(worldPosition)
	local halfSize = part.Size * 0.5
	return math.abs(localPosition.X) <= halfSize.X
		and math.abs(localPosition.Y) <= halfSize.Y
		and math.abs(localPosition.Z) <= halfSize.Z
end

function BreathBinder.new(instance: Instance, context: any)
	local self = ModelBinder.new(instance, context, BreathBinder)
	self.rootPart = self:GetRootPart()
	self.model = self:GetModel()
	self.breathType = if self:HasTag(TagBinder.Tags.Breath_Air) then "Air" else "Water"
	ACTIVE_BINDERS[self] = true
	self.instance:SetAttribute("BreathTagged", true)
	self.instance:SetAttribute("BreathKind", self.breathType)
	return self
end

function BreathBinder.containsCharacter(self: any, character: Model): boolean
	local head = character:FindFirstChild("Head")
	if head ~= nil and head:IsA("BasePart") then
		if self.rootPart ~= nil and containsPointInPart(self.rootPart, head.Position) then
			return true
		end
	end

	local rootPart = character:FindFirstChild("HumanoidRootPart")
	if rootPart ~= nil and rootPart:IsA("BasePart") and self.rootPart ~= nil then
		return containsPointInPart(self.rootPart, rootPart.Position)
	end

	if self.model ~= nil then
		local ok, boundingCFrame, boundingSize = pcall(function()
			return self.model:GetBoundingBox()
		end)
		if ok and rootPart ~= nil and rootPart:IsA("BasePart") then
			local localPosition = boundingCFrame:PointToObjectSpace(rootPart.Position)
			local halfSize = boundingSize * 0.5
			return math.abs(localPosition.X) <= halfSize.X
				and math.abs(localPosition.Y) <= halfSize.Y
				and math.abs(localPosition.Z) <= halfSize.Z
		end
	end

	return false
end

function BreathBinder.Cleanup(self: any)
	ACTIVE_BINDERS[self] = nil
end

function BreathBinder.QueryCharacterOverride(character: Model?): { [string]: any }?
	if character == nil then
		return nil
	end

	local inAir = false
	local inWater = false
	for binder in ACTIVE_BINDERS do
		if binder:containsCharacter(character) then
			if binder.breathType == "Air" then
				inAir = true
			else
				inWater = true
			end
		end
	end

	if inAir then
		return {
			inLiquid = false,
			dominantType = LiquidServiceUtils.LIQUID_TYPE.NONE,
			breathingLiquidType = LiquidServiceUtils.LIQUID_TYPE.NONE,
			submersionRatio = 0,
			breathingSubmerged = false,
			meaningfulSubmersion = false,
			typeWeights = {},
		}
	end
	if not inWater then
		return nil
	end

	return {
		inLiquid = true,
		dominantType = LiquidServiceUtils.LIQUID_TYPE.WATER,
		breathingLiquidType = LiquidServiceUtils.LIQUID_TYPE.WATER,
		submersionRatio = 1,
		breathingSubmerged = true,
		meaningfulSubmersion = true,
		typeWeights = {
			[LiquidServiceUtils.LIQUID_TYPE.WATER] = 1,
		},
	}
end

BreathBinder.queryCharacterOverride = BreathBinder.QueryCharacterOverride

return BreathBinder
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="1009">
              <Properties>
                <string name="Name">CharacterBinder</string>
                <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")

local ModelBinder = require(script:FindFirstAncestor("game").Shared.Binders.ModelBinder)

local CharacterBinder = {}
CharacterBinder.__index = CharacterBinder
setmetatable(CharacterBinder, ModelBinder)

function CharacterBinder.new(instance: Instance, context: any)
	local self = ModelBinder.new(instance, context, CharacterBinder)
	self.model = self:GetModel()
	if self.model == nil then
		return self
	end

	self.ownerPlayer = Players:GetPlayerFromCharacter(self.model)
	self.humanoid = self:GetHumanoid()
	self:updateState()

	if self.humanoid ~= nil then
		self:Connect(self.humanoid.HealthChanged, function()
			self:updateState()
		end)
		self:Connect(self.humanoid:GetPropertyChangedSignal("MaxHealth"), function()
			self:updateState()
		end)
		self:Connect(self.humanoid.Died, function()
			self:updateState()
		end)
	end

	return self
end

function CharacterBinder.updateState(self: any)
	local model = self.model
	if model == nil then
		return
	end

	local humanoid = model:FindFirstChildOfClass("Humanoid")
	self.humanoid = humanoid

	model:SetAttribute("CharacterTagged", true)
	model:SetAttribute("CharacterAlive", humanoid ~= nil and humanoid.Health > 0)
	model:SetAttribute("CharacterIsPlayer", self.ownerPlayer ~= nil)

	if self.ownerPlayer ~= nil then
		model:SetAttribute("CharacterUserId", self.ownerPlayer.UserId)
	end
	if humanoid ~= nil then
		model:SetAttribute("CharacterHealth", humanoid.Health)
		model:SetAttribute("CharacterMaxHealth", humanoid.MaxHealth)
	end
end

return CharacterBinder
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="1010">
              <Properties>
                <string name="Name">DropBinder</string>
                <string name="Source"><![CDATA[--!strict

local ModelBinder = require(script:FindFirstAncestor("game").Shared.Binders.ModelBinder)

local DropBinder = {}
DropBinder.__index = DropBinder
setmetatable(DropBinder, ModelBinder)

local lootServiceServer = nil

local function getLootServiceServer()
	if lootServiceServer == nil then
		lootServiceServer = require(script:FindFirstAncestor("game").Server.Services.LootServiceServer)
	end
	return lootServiceServer
end

local function resolveStringAttribute(instance: Instance, attributeName: string): string?
	local value = instance:GetAttribute(attributeName)
	if typeof(value) == "string" and value ~= "" then
		return value
	end
	return nil
end

function DropBinder.new(instance: Instance, context: any)
	local self = ModelBinder.new(instance, context, DropBinder)
	self.didDrop = false
	self:refresh()
	self:Connect(self.instance.Destroying, function()
		if self.dropOnDestroy then
			self:dropOnce("Destroying")
		end
	end)

	local humanoid = self:GetHumanoid()
	if humanoid ~= nil then
		self:Connect(humanoid.Died, function()
			if self.dropOnDeath then
				self:dropOnce("Death")
			end
		end)
	end

	return self
end

function DropBinder.refresh(self: any)
	self.dropItemId = resolveStringAttribute(self.instance, "DropItemId")
	self.dropTableId = resolveStringAttribute(self.instance, "DropTableId")
	self.dropSourceType = resolveStringAttribute(self.instance, "DropSourceType")
	self.dropAmount = math.max(1, math.floor(tonumber(self.instance:GetAttribute("DropAmount")) or 1))
	self.dropOnDestroy = self.instance:GetAttribute("DropOnDestroy") == true
	self.dropOnDeath = self.instance:GetAttribute("DropOnDeath") == true
	self.instance:SetAttribute("DropTagged", true)
end

function DropBinder.dropOnce(self: any, reason: string)
	if self.didDrop then
		return
	end
	self.didDrop = true

	local origin = ModelBinder.resolveWorldPosition(self.instance)
	if origin == nil then
		return
	end

	local sourceType = if self.dropSourceType ~= nil then self.dropSourceType else reason
	local lootServiceServer = getLootServiceServer()
	if self.dropItemId ~= nil then
		lootServiceServer:spawnLootRuntime(self.dropItemId, self.dropAmount, origin, {
			sourceType = sourceType,
		})
	end
	if self.dropTableId ~= nil then
		lootServiceServer:spawnDropsFromTable(self.dropTableId, origin, {
			sourceType = sourceType,
		})
	end
end

return DropBinder
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="1011">
              <Properties>
                <string name="Name">GoreBinder</string>
                <string name="Source"><![CDATA[--!strict

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")

local BossServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.BossServiceUtils)
local GoreServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.GoreServiceUtils)
local ModelBinder = require(script:FindFirstAncestor("game").Shared.Binders.ModelBinder)
local NpcServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.NpcServiceUtils)
local TagBinder = require(script:FindFirstAncestor("game").Shared.Binders.TagBinder)

local GoreBinder = {}
GoreBinder.__index = GoreBinder
setmetatable(GoreBinder, ModelBinder)

local BOSS_BLOOD_COLOR = Color3.fromRGB(132, 10, 18)
local goreServiceServer = nil

local function getGoreServiceServer()
	if goreServiceServer == nil then
		goreServiceServer = require(script:FindFirstAncestor("game").Server.Services.GoreServiceServer)
	end
	return goreServiceServer
end

local function resolveEntityId(model: Model): string?
	local player = Players:GetPlayerFromCharacter(model)
	if player ~= nil then
		return nil
	end

	local bossRuntimeId = BossServiceUtils.resolveRuntimeIdFromInstance(model)
	if bossRuntimeId ~= nil then
		return ("boss:%s"):format(bossRuntimeId)
	end

	local npcRuntimeId = NpcServiceUtils.resolveRuntimeIdFromInstance(model)
	if npcRuntimeId ~= nil then
		return GoreServiceUtils.makeNpcEntityId(npcRuntimeId)
	end

	local existing = model:GetAttribute("GoreEntityId")
	if typeof(existing) == "string" and existing ~= "" then
		return existing
	end

	local generated = HttpService:GenerateGUID(false)
	model:SetAttribute("GoreEntityId", generated)
	return generated
end

function GoreBinder.new(instance: Instance, context: any)
	local self = ModelBinder.new(instance, context, GoreBinder)
	self.model = self:GetModel()
	if self.model == nil then
		return self
	end

	self.entityId = resolveEntityId(self.model)
	self.humanoid = self:GetHumanoid()
	self.lastHealth = if self.humanoid ~= nil then self.humanoid.Health else nil
	self.registeredByBinder = false

	if self.entityId ~= nil then
		self:register()
	end
	if self.humanoid ~= nil and self.registeredByBinder then
		self:Connect(self.humanoid.HealthChanged, function(nextHealth: number)
			self:onHealthChanged(nextHealth)
		end)
		self:Connect(self.humanoid.Died, function()
			self:onDied()
		end)
	end

	return self
end

function GoreBinder.resolveConfig(self: any): { [string]: any }
	local config = {}
	if self:HasTag(TagBinder.Tags.Gore_Slime) then
		config.bloodColor = GoreServiceUtils.DEFAULT_NPC_BLOOD_COLOR
	elseif self:HasTag(TagBinder.Tags.Gore_Boss) then
		config.bloodColor = BOSS_BLOOD_COLOR
	else
		config.bloodColor = GoreServiceUtils.DEFAULT_PLAYER_BLOOD_COLOR
	end

	config.damageBloodAmount = self.instance:GetAttribute("GoreDamageBloodAmount")
	config.deathBloodAmount = self.instance:GetAttribute("GoreDeathBloodAmount")
	config.deathGibCount = self.instance:GetAttribute("GoreDeathGibCount")
	config.emitDeathGibs = self.instance:GetAttribute("GoreEmitDeathGibs")
	return config
end

function GoreBinder.register(self: any)
	if self.entityId == nil or self.model == nil then
		return
	end

	local goreServiceServer = getGoreServiceServer()
	local existing = goreServiceServer:getEntityRuntime(self.entityId)
	if existing ~= nil and existing.model == self.model then
		return
	end

	self.registeredByBinder = goreServiceServer:registerEntity(self.entityId, self.model, self:resolveConfig())
	if self.registeredByBinder then
		self.model:SetAttribute("GoreBinderEntityId", self.entityId)
	end
end

function GoreBinder.onHealthChanged(self: any, nextHealth: number)
	if self.entityId == nil then
		return
	end

	local previousHealth = self.lastHealth
	self.lastHealth = nextHealth
	if typeof(previousHealth) ~= "number" or nextHealth >= previousHealth then
		return
	end

	getGoreServiceServer():emitEntityDamage(self.entityId, self:GetRootPart(), previousHealth - nextHealth)
end

function GoreBinder.onDied(self: any)
	if self.entityId == nil then
		return
	end
	getGoreServiceServer():emitEntityDeath(self.entityId, self:GetRootPart())
end

function GoreBinder.Cleanup(self: any)
	if self.registeredByBinder and self.entityId ~= nil then
		getGoreServiceServer():unregisterEntity(self.entityId)
	end
end

return GoreBinder
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="1012">
              <Properties>
                <string name="Name">HazardBinder</string>
                <string name="Source"><![CDATA[--!strict

local LiquidServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.LiquidServiceUtils)
local ModelBinder = require(script:FindFirstAncestor("game").Shared.Binders.ModelBinder)
local TagBinder = require(script:FindFirstAncestor("game").Shared.Binders.TagBinder)

local HazardBinder = {}
HazardBinder.__index = HazardBinder
setmetatable(HazardBinder, ModelBinder)

local bossServiceServer = nil
local hpServiceServer = nil
local liquidServiceServer = nil
local npcServiceServer = nil

local function getBossServiceServer()
	if bossServiceServer == nil then
		bossServiceServer = require(script:FindFirstAncestor("game").Server.Services.BossServiceServer)
	end
	return bossServiceServer
end

local function getHpServiceServer()
	if hpServiceServer == nil then
		hpServiceServer = require(script:FindFirstAncestor("game").Server.Services.HpServiceServer)
	end
	return hpServiceServer
end

local function getLiquidServiceServer()
	if liquidServiceServer == nil then
		liquidServiceServer = require(script:FindFirstAncestor("game").Server.Services.LiquidServiceServer)
	end
	return liquidServiceServer
end

local function getNpcServiceServer()
	if npcServiceServer == nil then
		npcServiceServer = require(script:FindFirstAncestor("game").Server.Services.NpcServiceServer)
	end
	return npcServiceServer
end

local function resolveNumberAttribute(instance: Instance, attributeName: string, fallback: number): number
	local value = instance:GetAttribute(attributeName)
	if typeof(value) ~= "number" or value ~= value then
		return fallback
	end
	return value
end

local function resolveHazardDefaults(self: any): (string, number, number)
	if self:HasTag(TagBinder.Tags.Hazard_Lava) then
		local lavaDefinition = LiquidServiceUtils.LiquidDamage.getLavaDefinition(getLiquidServiceServer().config)
		if lavaDefinition ~= nil then
			return "Lava", lavaDefinition.lavaTouchDamage, lavaDefinition.lavaTouchInterval
		end
		return "Lava", 58, 0.35
	end
	if self:HasTag(TagBinder.Tags.Hazard_Spikes) then
		return "Spikes", 18, 0.6
	end
	if self:HasTag(TagBinder.Tags.Hazard_Poison) then
		return "Poison", 4, 1
	end
	return "Hazard", 8, 0.5
end

function HazardBinder.new(instance: Instance, context: any)
	local self = ModelBinder.new(instance, context, HazardBinder)
	self.lastDamageAt = {} :: { [Instance]: number }
	self:refresh()
	ModelBinder.bindTouchedParts(instance, self.janitor, function(_part: BasePart, other: BasePart)
		self:onTouched(other)
	end)
	return self
end

function HazardBinder.refresh(self: any)
	local kind, defaultDamage, defaultInterval = resolveHazardDefaults(self)
	self.kind = kind
	self.damage = math.max(0, resolveNumberAttribute(self.instance, "HazardDamage", defaultDamage))
	self.interval = math.max(0.05, resolveNumberAttribute(self.instance, "HazardInterval", defaultInterval))
	self.instance:SetAttribute("HazardTagged", true)
	self.instance:SetAttribute("HazardKind", kind)
end

function HazardBinder.onTouched(self: any, other: BasePart)
	if self.damage <= 0 then
		return
	end

	local player = ModelBinder.resolvePlayer(other)
	local humanoid = ModelBinder.resolveHumanoid(other)
	local cooldownKey = if player ~= nil
		then player :: Instance
		else if humanoid ~= nil then humanoid :: Instance else other
	local now = os.clock()
	if now < (self.lastDamageAt[cooldownKey] or 0) then
		return
	end
	self.lastDamageAt[cooldownKey] = now + self.interval

	if player ~= nil then
		getHpServiceServer():damagePlayer(player, self.damage)
		return
	end

	if getNpcServiceServer():damageNpcFromHitPart(other, self.damage, self.instance) > 0 then
		return
	end
	if getBossServiceServer():damageBossFromHitPart(other, self.damage, self.instance, self.kind) > 0 then
		return
	end
	if humanoid ~= nil then
		humanoid:TakeDamage(self.damage)
	end
end

return HazardBinder
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="1013">
              <Properties>
                <string name="Name">HitboxBinder</string>
                <string name="Source"><![CDATA[--!strict

local ModelBinder = require(script:FindFirstAncestor("game").Shared.Binders.ModelBinder)

local HitboxBinder = {}
HitboxBinder.__index = HitboxBinder
setmetatable(HitboxBinder, ModelBinder)

local bossServiceServer = nil
local hpServiceServer = nil
local npcServiceServer = nil

local function getBossServiceServer()
	if bossServiceServer == nil then
		bossServiceServer = require(script:FindFirstAncestor("game").Server.Services.BossServiceServer)
	end
	return bossServiceServer
end

local function getHpServiceServer()
	if hpServiceServer == nil then
		hpServiceServer = require(script:FindFirstAncestor("game").Server.Services.HpServiceServer)
	end
	return hpServiceServer
end

local function getNpcServiceServer()
	if npcServiceServer == nil then
		npcServiceServer = require(script:FindFirstAncestor("game").Server.Services.NpcServiceServer)
	end
	return npcServiceServer
end

local function resolveNumberAttribute(instance: Instance, attributeName: string, fallback: number): number
	local value = instance:GetAttribute(attributeName)
	if typeof(value) ~= "number" or value ~= value then
		return fallback
	end
	return value
end

local function resolveBooleanAttribute(instance: Instance, attributeName: string, fallback: boolean): boolean
	local value = instance:GetAttribute(attributeName)
	if typeof(value) == "boolean" then
		return value
	end
	return fallback
end

function HitboxBinder.new(instance: Instance, context: any)
	local self = ModelBinder.new(instance, context, HitboxBinder)
	self.lastHitAt = {} :: { [Instance]: number }
	self:refresh()
	ModelBinder.bindTouchedParts(instance, self.janitor, function(_part: BasePart, other: BasePart)
		self:onTouched(other)
	end)
	return self
end

function HitboxBinder.refresh(self: any)
	self.damage = math.max(
		0,
		resolveNumberAttribute(self.instance, "HitboxDamage", resolveNumberAttribute(self.instance, "Damage", 0))
	)
	self.interval = math.max(0.05, resolveNumberAttribute(self.instance, "HitboxInterval", 0.2))
	self.affectsPlayers = resolveBooleanAttribute(self.instance, "HitboxAffectsPlayers", true)
	self.affectsHumanoids = resolveBooleanAttribute(self.instance, "HitboxAffectsHumanoids", true)
	self.affectsNpcs = resolveBooleanAttribute(self.instance, "HitboxAffectsNpcs", true)
	self.affectsBosses = resolveBooleanAttribute(self.instance, "HitboxAffectsBosses", true)
	self.instance:SetAttribute("HitboxTagged", true)
end

function HitboxBinder.onTouched(self: any, other: BasePart)
	if self.damage <= 0 then
		return
	end

	local player = ModelBinder.resolvePlayer(other)
	local humanoid = ModelBinder.resolveHumanoid(other)
	local cooldownKey = if player ~= nil
		then player :: Instance
		else if humanoid ~= nil then humanoid :: Instance else other
	local now = os.clock()
	if now < (self.lastHitAt[cooldownKey] or 0) then
		return
	end
	self.lastHitAt[cooldownKey] = now + self.interval

	if player ~= nil and self.affectsPlayers then
		getHpServiceServer():damagePlayer(player, self.damage)
		return
	end

	if self.affectsNpcs and getNpcServiceServer():damageNpcFromHitPart(other, self.damage, self.instance) > 0 then
		return
	end
	if
		self.affectsBosses
		and getBossServiceServer():damageBossFromHitPart(other, self.damage, self.instance, "Hitbox") > 0
	then
		return
	end
	if self.affectsHumanoids and humanoid ~= nil then
		humanoid:TakeDamage(self.damage)
	end
end

return HitboxBinder
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="1014">
              <Properties>
                <string name="Name">LootBinder</string>
                <string name="Source"><![CDATA[--!strict

local ItemRegistry = require(script:FindFirstAncestor("game").Shared.Modules.Items.Registry)
local ModelBinder = require(script:FindFirstAncestor("game").Shared.Binders.ModelBinder)

local LootBinder = {}
LootBinder.__index = LootBinder
setmetatable(LootBinder, ModelBinder)

local function resolveStringAttribute(instance: Instance, attributeName: string): string?
	local value = instance:GetAttribute(attributeName)
	if typeof(value) == "string" and value ~= "" then
		return value
	end
	return nil
end

function LootBinder.new(instance: Instance, context: any)
	local self = ModelBinder.new(instance, context, LootBinder)
	self:updateMetadata()
	return self
end

function LootBinder.updateMetadata(self: any)
	local itemId = resolveStringAttribute(self.instance, "LootItemId")
		or resolveStringAttribute(self.instance, "ItemId")
	local amount = self.instance:GetAttribute("LootAmount")
	self.instance:SetAttribute("LootTagged", true)
	if itemId == nil then
		return
	end

	self.instance:SetAttribute("LootItemId", itemId)
	local definition = ItemRegistry.resolveDefinition(itemId)
	if typeof(definition) == "table" then
		self.instance:SetAttribute("LootDisplayName", (definition :: { [string]: any }).name or itemId)
	end
	if typeof(amount) == "number" then
		self.instance:SetAttribute("LootAmount", math.max(1, math.floor(amount)))
	end
end

return LootBinder
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="1015">
              <Properties>
                <string name="Name">MagicBinder</string>
                <string name="Source"><![CDATA[--!strict

local ModelBinder = require(script:FindFirstAncestor("game").Shared.Binders.ModelBinder)
local ToolBinder = require(script:FindFirstAncestor("game").Shared.Binders.ToolBinder)

local MagicBinder = {}
MagicBinder.__index = MagicBinder
setmetatable(MagicBinder, ModelBinder)

local magicServiceServer = nil

local function getMagicServiceServer()
	if magicServiceServer == nil then
		magicServiceServer = require(script:FindFirstAncestor("game").Server.Services.MagicServiceServer)
	end
	return magicServiceServer
end

local TOOL_ATTRIBUTE_NAMES = {
	"itemId",
	"ItemId",
	"id",
	"itemType",
	"ItemType",
	"type",
	"Type",
}

function MagicBinder.new(instance: Instance, context: any)
	local self = ModelBinder.new(instance, context, MagicBinder)
	self.tool = ToolBinder.resolveTool(instance)
	if self.tool == nil then
		return self
	end

	self:refresh()
	self:Connect(self.tool.AncestryChanged, function()
		self:refresh()
	end)
	for _, attributeName in TOOL_ATTRIBUTE_NAMES do
		self:Connect(self.tool:GetAttributeChangedSignal(attributeName), function()
			self:refresh()
		end)
	end

	return self
end

function MagicBinder.refresh(self: any)
	if self.tool == nil then
		return
	end

	local resolution = ToolBinder.resolve(self.tool)
	self.tool:SetAttribute("ToolBinderItemId", resolution.itemId)
	self.tool:SetAttribute("ToolBinderItemType", resolution.itemType)
	self.tool:SetAttribute("ToolBinderMagic", resolution.isMagic)

	if resolution.ownerPlayer ~= nil then
		getMagicServiceServer():requestRefreshEquipped(resolution.ownerPlayer)
	end
end

return MagicBinder
]]></string>
              </Properties>
            </Item>
