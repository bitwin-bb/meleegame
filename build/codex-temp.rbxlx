            <Item class="ModuleScript" referent="1141">
              <Properties>
                <string name="Name">WorldGeneration</string>
                <string name="Source"><![CDATA[--!strict

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Sift = require(ReplicatedStorage.Packages.Sift)
local Workspace = game:GetService("Workspace")
local packageRoot = script:FindFirstAncestor("game").Parent
local loaderUtils = assert(packageRoot:FindFirstChild("LoaderUtils", true), "Missing LoaderUtils")
local loader = require(loaderUtils.Parent).load(script)

local Brio = loader("Brio")
local Maid = loader("Maid")
local Octree = loader("Octree")
local Rx = loader("Rx")
local RxBrioUtils = loader("RxBrioUtils")
local RxSignal = loader("RxSignal")
local Signal = loader("Signal")

local Biome = require(script.Biome)
local Cache = require(script.Utils.GenerationCache)
local Cave = require(script.Cave)
local Configs = require(script:FindFirstAncestor("game").Shared.Modules.Core.Configs)
local Liquid = require(script.Liquid)
local ProceduralTree = require(script.Tree)
local Structures = require(script.Structures)
local TagBinder = require(script:FindFirstAncestor("game").Shared.Binders.TagBinder)
local TileVisibilityResolver = require(script:FindFirstAncestor("game").Shared.Modules.Core.TileVisibilityResolver)
local WorkspaceFolders = require(script:FindFirstAncestor("game").Shared.Modules.Core.WorkspaceFolders)
local WorldGenerationColor = require(script:FindFirstAncestor("game").Shared.Modules.Items.WorldGenerationColor)
local WorldGenerationDesert = require(script:FindFirstAncestor("game").Shared.Modules.Items.WorldGenerationDesert)
local WorldGenerationSnow = require(script:FindFirstAncestor("game").Shared.Modules.Items.WorldGenerationSnow)

type BiomeClass = Biome.Biome
type CaveClass = Cave.Cave
type LiquidGenerationClass = Liquid.LiquidGeneration
type StructuresClass = Structures.Structures
type StructureGenerationResult = Structures.StructureGenerationResult
type CacheClass = Cache.Cache
type ColumnProfile = Biome.ColumnProfile
type ProceduralTreeConfig = ProceduralTree.ProceduralTreeConfig
type MaidClass = {
	Add: <T>(self: MaidClass, task: T) -> T,
	GiveTask: (self: MaidClass, task: any) -> number,
	Destroy: (self: MaidClass) -> (),
	DoCleaning: (self: MaidClass) -> (),
}
type SignalObject = {
	Connect: (self: SignalObject, callback: (...any) -> ()) -> RBXScriptConnection,
	Fire: (self: SignalObject, ...any) -> (),
	Destroy: (self: SignalObject) -> (),
}
type ObservableObject = {
	Subscribe: (
		self: ObservableObject,
		fireCallback: ((...any) -> ())?,
		failCallback: ((...any) -> ())?,
		completeCallback: ((...any) -> ())?
	) -> any,
	Pipe: (self: ObservableObject, transformers: { any }) -> ObservableObject,
}
type RxSignalObject = {
	Connect: (self: RxSignalObject, callback: (...any) -> ()) -> any,
	Once: (self: RxSignalObject, callback: (...any) -> ()) -> any,
	Wait: (self: RxSignalObject) -> ...any,
}
type BrioObject = {
	IsDead: (self: BrioObject) -> boolean,
	GetValue: (self: BrioObject) -> ...any,
	GetDiedSignal: (self: BrioObject) -> SignalObject,
	ToMaid: (self: BrioObject) -> MaidClass,
	Kill: (self: BrioObject) -> (),
}
type OctreeNodeObject = {
	SetPosition: (self: OctreeNodeObject, position: Vector3) -> (),
	Destroy: (self: OctreeNodeObject) -> (),
}

type TreeVariantConfig = {
	config: ProceduralTreeConfig,
	biomeType: number?,
	biomeId: number?,
}

type TileVisual = {
	name: string,
	color: Color3,
	material: Enum.Material,
	transparency: number,
}

type BackgroundLayerData = {
	layerIndex: number,
	tileMinX: number,
	tileMinY: number,
	width: number,
	height: number,
	tiles: { number },
}

type TreeSpawnData = {
	tileX: number,
	tileY: number,
	variantIndex: number,
	seed: number,
	biomeType: number,
	biomeId: number,
	templateIndex: number?,
}

type PropSpawnData = {
	tileX: number,
	tileY: number,
	propId: number,
	variantIndex: number,
	seed: number,
	biomeType: number,
	biomeId: number,
}

type ChunkData = {
	key: string,
	chunkX: number,
	chunkY: number,
	tileMinX: number,
	tileMinY: number,
	width: number,
	height: number,
	tiles: { number },
	liquids: { number },
	depthLayers: { number },
	depthBelowSurface: { number },
	biomeIds: { number },
	biomeTypes: { number },
	dominantBiomeId: number,
	dominantBiomeType: number,
	backgroundLayers: { BackgroundLayerData },
	trees: { TreeSpawnData },
	props: { PropSpawnData },
	generatedAt: number,
	lastAccessedAt: number,
}

type ChunkVisual = {
	key: string,
	chunkX: number,
	chunkY: number,
	model: Model,
	terrainFolder: Folder,
	backgroundFolder: Folder?,
	treesFolder: Folder?,
	parts: { BasePart },
	visibleTileMask: { boolean },
	loadedAt: number,
	lastAccessedAt: number,
}

type ChunkDirtyBounds = {
	minTileX: number,
	minTileY: number,
	maxTileX: number,
	maxTileY: number,
}

type ChunkLifecycleObserver = {
	OnChunkCollisionReady: ((self: any, chunkX: number, chunkY: number, context: any?) -> ())?,
	OnChunkCollisionUnloaded: ((self: any, chunkX: number, chunkY: number, context: any?) -> ())?,
	OnChunkTerrainChanged: ((
		self: any,
		chunkX: number,
		chunkY: number,
		dirtyBounds: ChunkDirtyBounds,
		context: any?
	) -> ())?,
}

type ChunkLifecycleConnection = {
	Disconnect: (self: ChunkLifecycleConnection) -> (),
}

type ChunkLifecycleEvent = {
	chunkKey: string,
	chunkX: number,
	chunkY: number,
	reason: string,
	context: { [string]: any },
}

type ChunkTerrainChangedEvent = ChunkLifecycleEvent & {
	dirtyBounds: ChunkDirtyBounds,
}

type ChunkDemandChangedEvent = {
	chunkKey: string,
	previousDemand: number,
	nextDemand: number,
}

type PlayerInterestChangedEvent = {
	player: Player,
	focusPosition: Vector3?,
	centerChunkX: number?,
	centerChunkY: number?,
	renderDistance: number,
	verticalRenderDistance: number,
	interestKeys: { [string]: boolean },
}

type PlayerRuntime = {
	maid: MaidClass,
	brio: BrioObject,
	renderDistance: number,
	verticalRenderDistance: number,
	interestKeys: { [string]: boolean },
	refreshAccumulator: number,
	forceRefresh: boolean,
	lastChunkX: number?,
	lastChunkY: number?,
	focusPosition: Vector3?,
	focusNode: OctreeNodeObject?,
}

type GreedyRect = {
	x: number,
	y: number,
	width: number,
	height: number,
	value: number,
}

type DepthLayer = Cave.DepthLayer

type ChasmSeedColumn = {
