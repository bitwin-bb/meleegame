                    <string name="Name">useSignal</string>
                    <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Cleanup = require(script.Parent.internal.cleanup)
local React = require(ReplicatedStorage.Packages.React)
local useLatest = require(script.Parent.internal.useLatest)

export type SignalOptions<TValue> = {
	initialValue: TValue?,
	getCurrent: (() -> TValue?)?,
	equalityFn: ((TValue?, TValue?) -> boolean)?,
}

local function defaultSelector(...)
	return ...
end

local function defaultEquality<TValue>(a: TValue?, b: TValue?): boolean
	return a == b
end

local function connectSignal(signalRaw: any, callbackRaw: (...any) -> ()): any
	if typeof(signalRaw) == "RBXScriptSignal" then
		return (signalRaw :: RBXScriptSignal):Connect(callbackRaw)
	end

	if typeof(signalRaw) ~= "table" then
		return nil
	end

	local connect = (signalRaw :: any).Connect
	if typeof(connect) ~= "function" then
		connect = (signalRaw :: any).connect
	end
	if typeof(connect) ~= "function" then
		return nil
	end

	local ok, result = pcall(function()
		return connect(signalRaw, callbackRaw)
	end)
	if ok then
		return result
	end

	local okWithoutSelf, resultWithoutSelf = pcall(function()
		return connect(callbackRaw)
	end)
	if okWithoutSelf then
		return resultWithoutSelf
	end

	return nil
end

local function useSignal<TValue>(signalRaw: any, selectorRaw: any, options: SignalOptions<TValue>?): TValue?
	local selector = if typeof(selectorRaw) == "function" then selectorRaw else defaultSelector
	local equalityFn = if options ~= nil and options.equalityFn ~= nil then options.equalityFn else defaultEquality
	local selectorRef = useLatest(selector)
	local equalityRef = useLatest(equalityFn)
	local getCurrent = if options ~= nil then options.getCurrent else nil
	local initialValue = if typeof(getCurrent) == "function"
		then getCurrent()
		else if options ~= nil then options.initialValue else nil
	local valueRef = React.useRef(initialValue)
	local value, setValue = React.useState(initialValue)

	local applyValue = React.useCallback(function(nextValue: TValue?)
		if equalityRef.current(valueRef.current, nextValue) then
			return
		end

		valueRef.current = nextValue
		setValue(nextValue)
	end, { equalityRef })

	React.useEffect(function()
		if typeof(getCurrent) == "function" then
			applyValue(getCurrent())
		end

		local connection = connectSignal(signalRaw, function(...)
			local nextValue = selectorRef.current(...)
			applyValue(nextValue)
		end)

		return function()
			Cleanup.Call(connection)
		end
	end, { signalRaw, getCurrent, applyValue, selectorRef })

	return value
end

return useSignal
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="805">
                  <Properties>
                    <string name="Name">useSmoothedProgress</string>
                    <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Damp = require(script:FindFirstAncestor("game").Shared.Modules.Math.Damp)
local React = require(ReplicatedStorage.Packages.React)

export type SmoothedProgressOptions = {
	progress: number?,
	visible: boolean?,
	gainRate: number?,
	depletionRate: number?,
}

local DEFAULT_GAIN_RATE = 22
local DEFAULT_DEPLETION_RATE = 10
local EPSILON = 0.0005

local function sanitizeProgress(valueRaw: any): number
	if typeof(valueRaw) ~= "number" or valueRaw ~= valueRaw then
		return 0
	end
	return math.clamp(valueRaw, 0, 1)
end

local function sanitizePositiveRate(valueRaw: any, fallback: number): number
	if typeof(valueRaw) ~= "number" or valueRaw ~= valueRaw or valueRaw <= 0 then
		return fallback
	end
	return valueRaw
end

local function useSmoothedProgress(options: SmoothedProgressOptions?): number
	local visible = if options and options.visible ~= nil then options.visible else true
	local gainRate = sanitizePositiveRate(if options then options.gainRate else nil, DEFAULT_GAIN_RATE)
	local depletionRate = sanitizePositiveRate(if options then options.depletionRate else nil, DEFAULT_DEPLETION_RATE)
	local target = if visible then sanitizeProgress(if options then options.progress else nil) else 0

	local currentRef = React.useRef(target)
	local targetRef = React.useRef(target)
	local smoothProgress, setSmoothProgress = React.useState(target)

	React.useEffect(function()
		targetRef.current = target
	end, { target })

	React.useEffect(function()
		local connection = RunService.RenderStepped:Connect(function(deltaTime: number)
			local current = currentRef.current
			local nextTarget = targetRef.current
			local rate = if nextTarget >= current then gainRate else depletionRate
			local alpha = Damp.factor(rate, deltaTime)
			local nextValue = current + ((nextTarget - current) * alpha)

			if math.abs(nextValue - nextTarget) <= EPSILON then
				nextValue = nextTarget
			end

			if math.abs(nextValue - currentRef.current) > EPSILON then
				currentRef.current = nextValue
				setSmoothProgress(nextValue)
			end
		end)

		return function()
			connection:Disconnect()
		end
	end, { gainRate, depletionRate })

	return smoothProgress
end

return useSmoothedProgress
]]></string>
                  </Properties>
                </Item>
