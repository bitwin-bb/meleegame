local LuauPolyfill = require(script.Parent.Parent:WaitForChild('luau-polyfill'))
local Boolean = LuauPolyfill.Boolean
local RegExp = require(script.Parent.Parent:WaitForChild('luau-regexp'))

local exports = {}

local function validatePattern(pattern: string?): boolean
	if pattern ~= nil and Boolean.toJSBoolean(pattern) then
		local ok = pcall(function()
			-- eslint-disable-next-line no-new
			RegExp(pattern, "i")
		end)
		if not ok then
			return false
		end
	end
	return true
end
exports.default = validatePattern
return exports
