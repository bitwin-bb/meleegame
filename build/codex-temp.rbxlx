                  <Item class="ModuleScript" referent="893">
                    <Properties>
                      <string name="Name">useDeathScreen</string>
                      <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local React = require(ReplicatedStorage.Packages.React)
local Ripple = require(ReplicatedStorage.Packages.Ripple)

type NumberMotion = Ripple.Motion<number>
type SpringOptions = Ripple.SpringOptions

export type DeathScreenOptions = {
	enabled: boolean?,
	minScale: number?,
	maxScale: number?,
	spring: SpringOptions?,
}

export type DeathScreenAppearance = {
	progress: number,
	scale: number,
	transparency: number,
	strokeTransparency: number,
}

local DEFAULT_SPRING: SpringOptions = {
	frequency = 2.3,
	damping = 0.82,
}

local DEFAULT_MIN_SCALE = 0.72
local DEFAULT_MAX_SCALE = 1

local function smoothstep(alphaRaw: number): number
	local alpha = math.clamp(alphaRaw, 0, 1)
	return alpha * alpha * (3 - 2 * alpha)
end

local function sanitizeScale(valueRaw: any, fallback: number): number
	if typeof(valueRaw) ~= "number" or valueRaw ~= valueRaw then
		return fallback
	end
	return math.max(0.01, valueRaw)
end

local function useDeathScreen(options: DeathScreenOptions?): DeathScreenAppearance
	local enabled = if options and options.enabled ~= nil then options.enabled else false
	local minScale = sanitizeScale(if options then options.minScale else nil, DEFAULT_MIN_SCALE)
	local maxScale = math.max(minScale, sanitizeScale(if options then options.maxScale else nil, DEFAULT_MAX_SCALE))
	local spring = if options and options.spring ~= nil then options.spring else DEFAULT_SPRING

	local targetRef = React.useRef(if enabled then 1 else 0)
	local progress, setProgress = React.useState(targetRef.current)

	React.useEffect(function()
		targetRef.current = if enabled then 1 else 0
	end, { enabled })

	React.useEffect(function()
		local motion: NumberMotion = Ripple.createMotion(progress)
		local connection = RunService.RenderStepped:Connect(function(deltaTime: number)
			motion:spring(targetRef.current, spring)
			local nextProgress = math.clamp(motion:step(deltaTime), 0, 1)
			setProgress(nextProgress)
		end)

		return function()
			connection:Disconnect()
			motion:destroy()
		end
	end, { spring })

	local fluidProgress = smoothstep(progress)
	local scale = minScale + (maxScale - minScale) * fluidProgress
	local scaleAlpha = if maxScale - minScale <= 0.0001
		then fluidProgress
		else math.clamp((scale - minScale) / (maxScale - minScale), 0, 1)
	local transparency = math.clamp(1 - scaleAlpha, 0, 1)
	local strokeTransparency = math.clamp(0.16 + transparency * 0.84, 0, 1)

	return {
		progress = progress,
		scale = scale,
		transparency = transparency,
		strokeTransparency = strokeTransparency,
	}
end

return useDeathScreen
]]></string>
                    </Properties>
                  </Item>
                </Item>
                <Item class="Folder" referent="894">
                  <Properties>
                    <string name="Name">screens</string>
                  </Properties>
                  <Item class="ModuleScript" referent="895">
                    <Properties>
                      <string name="Name">deathScreen</string>
                      <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local React = require(ReplicatedStorage.Packages.React)
local Layer = require(script:FindFirstAncestor("game").Client.UI.shared.Layer)
local Scale = require(script:FindFirstAncestor("game").Client.UI.shared.Scale)
local deathSlice = require(script:FindFirstAncestor("game").Client.UI.features.death.state.deathSlice)
local deathThunks = require(script:FindFirstAncestor("game").Client.UI.features.death.state.deathThunks)
local useCountDown = require(script:FindFirstAncestor("game").Client.UI.features.death.hooks.useCountDown)
local useDeathScreen = require(script:FindFirstAncestor("game").Client.UI.features.death.hooks.useDeathScreen)
local useStore = require(script:FindFirstAncestor("game").Client.UI.core.hooks.useStore)

type DeathState = deathSlice.DeathState

type DeathScreenProps = {
	layoutOrder: number?,
	zIndex: number?,
	visible: boolean?,
}

local e: typeof(React.createElement) = React.createElement

local TEXT_PROGRESS_EPSILON = 0.001
local MAIN_TEXT_POSITION = UDim2.fromScale(0.5, 0.42)
local COUNTDOWN_BASE_POSITION = UDim2.fromScale(0.5, 0.42)
local MAIN_TEXT_SIZE = Vector2.new(880, 92)
local COUNTDOWN_TEXT_SIZE = Vector2.new(520, 44)
local DEFAULT_MAIN_TEXT = "You were slain..."
local COUNTDOWN_APPEAR_DELAY_SECONDS = 2

return function(props: DeathScreenProps?): React.ReactNode
	local resolvedProps: DeathScreenProps = if props ~= nil then props else {}
	local deathState = (useStore(deathSlice.deathStateAtom) :: DeathState?) or deathSlice.deathStateAtom()

	React.useEffect(function()
		local stop = deathThunks.start()

		return function()
			stop()
		end
	end, {})

	local canRender = resolvedProps.visible ~= false
	local deathAppearance = useDeathScreen({
		enabled = canRender and deathState.visible,
		minScale = 0.72,
		maxScale = 1,
	})
	local countDownAppearance = useCountDown({
		enabled = canRender and deathState.visible,
		respawnAt = deathState.respawnAt,
		diedAt = deathState.diedAt,
		appearDelay = COUNTDOWN_APPEAR_DELAY_SECONDS,
		fromOffset = Vector2.new(0, 4),
		toOffset = Vector2.new(0, 62),
		minScale = 0.72,
		maxScale = 1,
	})

	React.useEffect(function()
		if deathState.visible and countDownAppearance.canRespawn then
			deathSlice.hideDeath()
		end
	end, { deathState.visible, countDownAppearance.canRespawn })

	local showMainText = canRender and (deathState.visible or deathAppearance.progress > TEXT_PROGRESS_EPSILON)
	local showCountDown = canRender
		and (countDownAppearance.revealed or countDownAppearance.progress > TEXT_PROGRESS_EPSILON)
	if not showMainText and not showCountDown then
		return nil
	end

	local zIndex = resolvedProps.zIndex or 230
	local deathText = if deathState.message ~= "" then deathState.message else DEFAULT_MAIN_TEXT
	local countDownText = if countDownAppearance.canRespawn
		then "Respawn ready..."
		else string.format("Respawning in %d...", countDownAppearance.secondsLeft)
	local countdownXOffset = math.floor(countDownAppearance.offset.X + 0.5)
	local countdownYOffset = math.floor(countDownAppearance.offset.Y + 0.5)

	return e(Layer, {
		layoutOrder = resolvedProps.layoutOrder or 990,
		zIndex = zIndex,
		active = false,
		children = {
			e("TextLabel", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = MAIN_TEXT_POSITION,
				Size = UDim2.fromOffset(MAIN_TEXT_SIZE.X, MAIN_TEXT_SIZE.Y),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Text = deathText,
				Font = Enum.Font.GothamBlack,
				TextSize = 62,
				TextColor3 = Color3.fromRGB(255, 236, 236),
				TextStrokeColor3 = Color3.fromRGB(48, 9, 9),
				TextStrokeTransparency = deathAppearance.strokeTransparency,
				TextTransparency = deathAppearance.transparency,
				TextXAlignment = Enum.TextXAlignment.Center,
				TextYAlignment = Enum.TextYAlignment.Center,
				ZIndex = zIndex + 2,
			}, {
				e(Scale, {
					scale = deathAppearance.scale,
				}),
				e("UIGradient", {
					Color = ColorSequence.new({
						ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
						ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 197, 197)),
					}),
					Rotation = 90,
				}),
			}),
			if showCountDown
				then e("TextLabel", {
					AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.new(
						COUNTDOWN_BASE_POSITION.X.Scale,
						COUNTDOWN_BASE_POSITION.X.Offset + countdownXOffset,
						COUNTDOWN_BASE_POSITION.Y.Scale,
						COUNTDOWN_BASE_POSITION.Y.Offset + countdownYOffset
					),
					Size = UDim2.fromOffset(COUNTDOWN_TEXT_SIZE.X, COUNTDOWN_TEXT_SIZE.Y),
					BackgroundTransparency = 1,
					BorderSizePixel = 0,
					Text = countDownText,
					Font = Enum.Font.GothamBold,
					TextSize = 34,
					TextColor3 = Color3.fromRGB(255, 223, 223),
					TextStrokeColor3 = Color3.fromRGB(33, 6, 6),
					TextStrokeTransparency = countDownAppearance.strokeTransparency,
					TextTransparency = countDownAppearance.transparency,
					TextXAlignment = Enum.TextXAlignment.Center,
					TextYAlignment = Enum.TextYAlignment.Center,
					ZIndex = zIndex + 3,
				}, {
					e(Scale, {
						scale = countDownAppearance.scale,
					}),
				})
				else nil,
		},
	})
end
]]></string>
                    </Properties>
                  </Item>
                </Item>
                <Item class="Folder" referent="896">
                  <Properties>
                    <string name="Name">state</string>
                  </Properties>
                  <Item class="ModuleScript" referent="897">
                    <Properties>
                      <string name="Name">deathSlice</string>
                      <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Charm = require(ReplicatedStorage.Packages.Charm)

export type DeathState = {
	visible: boolean,
	message: string,
	diedAt: number?,
	respawnAt: number?,
	respawnDelay: number,
	sequence: number,
	updatedAt: number,
}

export type ShowDeathPayload = {
	message: string?,
	diedAt: number?,
	respawnAt: number?,
	respawnDelay: number?,
}

local DEFAULT_MESSAGE = "You were slain..."
local DEFAULT_RESPAWN_DELAY = 5
local MIN_RESPAWN_DELAY = 0.1
local MAX_RESPAWN_DELAY = 120

local DEFAULT_STATE: DeathState = {
	visible = false,
	message = DEFAULT_MESSAGE,
	diedAt = nil,
	respawnAt = nil,
	respawnDelay = DEFAULT_RESPAWN_DELAY,
	sequence = 0,
	updatedAt = os.clock(),
}

local deathStateAtom: Charm.Atom<DeathState> = Charm.atom(DEFAULT_STATE)

local function sanitizeFiniteNumber(valueRaw: any, fallback: number): number
	if typeof(valueRaw) ~= "number" or valueRaw ~= valueRaw then
		return fallback
	end
	return valueRaw
end

local function sanitizeOptionalTimestamp(valueRaw: any): number?
	if typeof(valueRaw) ~= "number" or valueRaw ~= valueRaw then
		return nil
	end
	return valueRaw
end

local function sanitizeMessage(valueRaw: any, fallback: string): string
	if typeof(valueRaw) ~= "string" then
		return fallback
	end
	local message = string.gsub(valueRaw, "^%s*(.-)%s*$", "%1")
	if message == "" then
		return fallback
	end
	return message
end

local function sanitizeRespawnDelay(valueRaw: any, fallback: number): number
	local delay = sanitizeFiniteNumber(valueRaw, fallback)
	return math.clamp(delay, MIN_RESPAWN_DELAY, MAX_RESPAWN_DELAY)
end

local function getDeathState(): DeathState
	return deathStateAtom()
end

local function setDeathState(stateRaw: any): DeathState
	local current = deathStateAtom()
	local source = if typeof(stateRaw) == "table" then stateRaw else {}
	local visible = (source :: any).visible == true
	local message = sanitizeMessage((source :: any).message, current.message)
	local sequenceRaw = sanitizeFiniteNumber((source :: any).sequence, current.sequence)
	local sequence = math.max(0, math.floor(sequenceRaw))
	local now = os.clock()
	local diedAt = sanitizeOptionalTimestamp((source :: any).diedAt)
	local respawnDelay = sanitizeRespawnDelay((source :: any).respawnDelay, current.respawnDelay)
	local respawnAt = sanitizeOptionalTimestamp((source :: any).respawnAt)

	if visible then
		if diedAt == nil then
			diedAt = now
		end
		if respawnAt == nil then
			respawnAt = diedAt + respawnDelay
		end
	else
		diedAt = nil
		respawnAt = nil
	end

	local nextState: DeathState = {
		visible = visible,
		message = message,
		diedAt = diedAt,
		respawnAt = respawnAt,
		respawnDelay = respawnDelay,
		sequence = sequence,
		updatedAt = now,
	}
	deathStateAtom(nextState)
	return nextState
end

local function showDeath(payloadRaw: any): DeathState
	local current = deathStateAtom()
	local payload = if typeof(payloadRaw) == "table" then payloadRaw else {}
	local now = os.clock()

	local message = sanitizeMessage((payload :: any).message, DEFAULT_MESSAGE)
	local diedAt = sanitizeOptionalTimestamp((payload :: any).diedAt)
	if diedAt == nil then
		diedAt = now
	end

	local respawnDelay = sanitizeRespawnDelay((payload :: any).respawnDelay, current.respawnDelay)
	local respawnAt = sanitizeOptionalTimestamp((payload :: any).respawnAt)
	if respawnAt == nil then
		respawnAt = diedAt + respawnDelay
	end

	local nextState: DeathState = {
		visible = true,
		message = message,
		diedAt = diedAt,
		respawnAt = respawnAt,
		respawnDelay = respawnDelay,
		sequence = current.sequence + 1,
		updatedAt = now,
	}
	deathStateAtom(nextState)
	return nextState
end

local function hideDeath(): DeathState
	local current = deathStateAtom()
	if not current.visible then
		return current
	end

	local nextState: DeathState = {
		visible = false,
		message = current.message,
		diedAt = nil,
		respawnAt = nil,
		respawnDelay = current.respawnDelay,
		sequence = current.sequence,
		updatedAt = os.clock(),
	}
	deathStateAtom(nextState)
	return nextState
end

local function resetDeathState(): DeathState
	local nextState: DeathState = {
		visible = false,
		message = DEFAULT_MESSAGE,
		diedAt = nil,
		respawnAt = nil,
		respawnDelay = DEFAULT_RESPAWN_DELAY,
		sequence = 0,
		updatedAt = os.clock(),
	}
	deathStateAtom(nextState)
	return nextState
end

return {
	deathStateAtom = deathStateAtom,
	getDeathState = getDeathState,
	setDeathState = setDeathState,
	showDeath = showDeath,
	hideDeath = hideDeath,
	resetDeathState = resetDeathState,
}
]]></string>
                    </Properties>
                  </Item>
                  <Item class="ModuleScript" referent="898">
                    <Properties>
                      <string name="Name">deathThunks</string>
                      <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ConnectionUtils = require(script:FindFirstAncestor("game").Client.UI.core.utils.ConnectionUtils)
local deathSlice = require(script:FindFirstAncestor("game").Client.UI.features.death.state.deathSlice)
local PlayerSpawnCooldown = require(script:FindFirstAncestor("game").Shared.Modules.Game.Player.PlayerSpawnCooldown)

type DeathState = deathSlice.DeathState

local deathThunks = {}

local runtime = {
	started = false,
	localPlayer = nil :: Player?,
	boundCharacter = nil :: Model?,
	boundHumanoid = nil :: Humanoid?,
	deathShownForHumanoid = nil :: Humanoid?,
	characterAddedConnection = nil :: RBXScriptConnection?,
	characterChildAddedConnection = nil :: RBXScriptConnection?,
	characterChildRemovedConnection = nil :: RBXScriptConnection?,
	humanoidDiedConnection = nil :: RBXScriptConnection?,
}

local function resolveRespawnDelay(): number
	return PlayerSpawnCooldown.getCurrentRespawnDelay()
end

local function isHumanoidDead(humanoidRaw: any): boolean
	if typeof(humanoidRaw) ~= "Instance" or not humanoidRaw:IsA("Humanoid") then
		return false
	end
	local humanoid = humanoidRaw :: Humanoid
	return humanoid.Health <= 0 or humanoid:GetState() == Enum.HumanoidStateType.Dead
end

local function unbindHumanoid()
	ConnectionUtils.disconnect(runtime.humanoidDiedConnection)
	runtime.humanoidDiedConnection = nil
	runtime.boundHumanoid = nil
end

local function onHumanoidDied(humanoid: Humanoid)
	if runtime.boundHumanoid ~= humanoid then
		return
	end
	if runtime.deathShownForHumanoid == humanoid then
		return
	end

	runtime.deathShownForHumanoid = humanoid
	deathSlice.showDeath({
		message = "You were slain...",
		respawnDelay = resolveRespawnDelay(),
	})
end

local function bindHumanoid(humanoid: Humanoid)
	if runtime.boundHumanoid == humanoid then
		return
	end

	unbindHumanoid()
	runtime.boundHumanoid = humanoid
	runtime.humanoidDiedConnection = humanoid.Died:Connect(function()
		onHumanoidDied(humanoid)
	end)

	if isHumanoidDead(humanoid) then
		onHumanoidDied(humanoid)
	end
end

local function bindCharacter(characterRaw: any)
	if typeof(characterRaw) ~= "Instance" or not characterRaw:IsA("Model") then
		return
	end
	local character = characterRaw :: Model
	runtime.boundCharacter = character
	runtime.deathShownForHumanoid = nil
	local deathState = deathSlice.getDeathState()
	if deathState.visible then
		deathSlice.setDeathState({
			visible = true,
			message = deathState.message,
			diedAt = deathState.diedAt,
			respawnDelay = deathState.respawnDelay,
			respawnAt = os.clock(),
			sequence = deathState.sequence,
		})
	end

	ConnectionUtils.disconnect(runtime.characterChildAddedConnection)
	ConnectionUtils.disconnect(runtime.characterChildRemovedConnection)
	runtime.characterChildAddedConnection = character.ChildAdded:Connect(function(child: Instance)
		if runtime.boundCharacter ~= character then
			return
		end
		if child:IsA("Humanoid") then
			bindHumanoid(child)
		end
	end)
	runtime.characterChildRemovedConnection = character.ChildRemoved:Connect(function(child: Instance)
		if runtime.boundCharacter ~= character then
			return
		end
		if child == runtime.boundHumanoid then
			unbindHumanoid()
		end
	end)

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid ~= nil then
		bindHumanoid(humanoid)
	else
		unbindHumanoid()
	end
end

function deathThunks.Start(): () -> ()
	if runtime.started then
		return deathThunks.Stop
	end

	runtime.started = true
	runtime.localPlayer = Players.LocalPlayer
	local localPlayer = runtime.localPlayer
	if localPlayer == nil then
		return deathThunks.Stop
	end

	runtime.characterAddedConnection = localPlayer.CharacterAdded:Connect(function(character: Model)
		if not runtime.started then
			return
		end
		bindCharacter(character)
	end)

	if localPlayer.Character ~= nil then
		bindCharacter(localPlayer.Character)
	end

	return deathThunks.Stop
end

function deathThunks.Stop()
	ConnectionUtils.disconnectMany({
		runtime.characterAddedConnection,
		runtime.characterChildAddedConnection,
		runtime.characterChildRemovedConnection,
		runtime.humanoidDiedConnection,
	})
	runtime.characterAddedConnection = nil
	runtime.characterChildAddedConnection = nil
	runtime.characterChildRemovedConnection = nil
	runtime.humanoidDiedConnection = nil

	runtime.started = false
	runtime.localPlayer = nil
	runtime.boundCharacter = nil
	runtime.boundHumanoid = nil
	runtime.deathShownForHumanoid = nil
	deathSlice.resetDeathState()
end

function deathThunks.GetDeathState(): DeathState
	return deathSlice.getDeathState()
end

deathThunks.start = deathThunks.Start
deathThunks.stop = deathThunks.Stop
deathThunks.getDeathState = deathThunks.GetDeathState

return deathThunks
]]></string>
                    </Properties>
                  </Item>
                </Item>
              </Item>
              <Item class="Folder" referent="899">
