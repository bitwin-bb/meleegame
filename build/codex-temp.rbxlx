			-- List is now: a, c, d, f, e
			expect(list:GetList()).toEqual({ "a", "c", "d", "f", "e" })

			-- Index 3 changed from "c" to "d" — must fire
			expect(#fires3).toEqual(2)
			expect(fires3[2]).toEqual("d")

			sub3:Destroy()
			maid:Destroy()
		end)

