                <string name="Name">ReactRootTags</string>
                <string name="Source"><![CDATA[-- ROBLOX upstream: https://github.com/facebook/react/blob/c5d2fc7127654e43de59fff865b74765a103c4a5/packages/react-reconciler/src/ReactRootTags.js
