                  <Item class="ModuleScript" referent="846">
                    <Properties>
                      <string name="Name">biomeNameScreen</string>
                      <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ImageIds = require(script:FindFirstAncestor("game").Client.UI.core.ImageIds)
local Layer = require(script:FindFirstAncestor("game").Client.UI.shared.Layer)
local React = require(ReplicatedStorage.Packages.React)
local Scale = require(script:FindFirstAncestor("game").Client.UI.shared.Scale)
local biomeSlice = require(script:FindFirstAncestor("game").Client.UI.features.biome.state.biomeSlice)
local biomeThunks = require(script:FindFirstAncestor("game").Client.UI.features.biome.state.biomeThunks)
local useBiomeNameAppearance =
	require(script:FindFirstAncestor("game").Client.UI.features.biome.hooks.useBiomeNameAppearance)
local useStore = require(script:FindFirstAncestor("game").Client.UI.core.hooks.useStore)
local useTextUnderline = require(script:FindFirstAncestor("game").Client.UI.features.biome.hooks.useTextUnderline)

type BiomeState = biomeSlice.BiomeState

type BiomeNameScreenProps = {
	layoutOrder: number?,
	zIndex: number?,
	visible: boolean?,
}

local e: typeof(React.createElement) = React.createElement

local UNDERLINE_IMAGE = if typeof(ImageIds.glareUnderline) == "string" then ImageIds.glareUnderline else ""
local BANNER_PROGRESS_EPSILON = 0.001
local BANNER_POSITION = UDim2.fromScale(0.5, 0.16)
local TEXT_SIZE = Vector2.new(520, 60)
local UNDERLINE_BASE_SIZE = Vector2.new(236, 14)

return function(props: BiomeNameScreenProps?): React.ReactNode
	local resolvedProps: BiomeNameScreenProps = if props ~= nil then props else {}
	local biomeState = (useStore(biomeSlice.biomeStateAtom) :: BiomeState?) or biomeSlice.biomeStateAtom()

	React.useEffect(function()
		local stop = biomeThunks.start()

		return function()
			stop()
		end
	end, {})

	local canRender = resolvedProps.visible ~= false
	local appearance = useBiomeNameAppearance({
		enabled = canRender and biomeState.visible,
		fromOffset = Vector2.new(0, -26),
		toOffset = Vector2.zero,
		minScale = 0.82,
		maxScale = 1,
	})
	local underline = useTextUnderline({
		enabled = canRender and biomeState.visible,
		fromOffset = Vector2.new(0, 8),
		toOffset = Vector2.zero,
		minWidthScale = 0.04,
		maxWidthScale = 1,
	})

	local showBanner = canRender
		and (
			biomeState.visible
			or appearance.progress > BANNER_PROGRESS_EPSILON
			or underline.progress > BANNER_PROGRESS_EPSILON
		)
	if not showBanner or biomeState.biomeName == "" then
		return nil
	end

	local zIndex = resolvedProps.zIndex or 150
	local bannerXOffset = math.floor(appearance.offset.X + 0.5)
	local bannerYOffset = math.floor(appearance.offset.Y + 0.5)
	local underlineXOffset = math.floor(underline.offset.X + 0.5)
	local underlineYOffset = math.floor(underline.offset.Y + 0.5)
	local underlineWidth = math.max(1, math.floor(UNDERLINE_BASE_SIZE.X * underline.widthScale + 0.5))
	local underlineHeight = math.max(1, math.floor(UNDERLINE_BASE_SIZE.Y + 0.5))

	return e(Layer, {
		layoutOrder = resolvedProps.layoutOrder or 997,
		zIndex = zIndex,
		active = false,
		children = {
			e("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.new(
					BANNER_POSITION.X.Scale,
					BANNER_POSITION.X.Offset + bannerXOffset,
					BANNER_POSITION.Y.Scale,
					BANNER_POSITION.Y.Offset + bannerYOffset
				),
				Size = UDim2.fromOffset(TEXT_SIZE.X, TEXT_SIZE.Y + 24),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				ZIndex = zIndex + 1,
			}, {
				e(Scale, {
					scale = appearance.scale,
				}),
				e("TextLabel", {
					Size = UDim2.fromOffset(TEXT_SIZE.X, TEXT_SIZE.Y),
					Position = UDim2.fromOffset(0, 0),
					BackgroundTransparency = 1,
					BorderSizePixel = 0,
					Text = biomeState.biomeName,
					Font = Enum.Font.GothamBlack,
					TextSize = 46,
					TextColor3 = Color3.fromRGB(247, 246, 234),
					TextStrokeColor3 = Color3.fromRGB(18, 15, 10),
					TextStrokeTransparency = appearance.strokeTransparency,
					TextTransparency = appearance.transparency,
					TextXAlignment = Enum.TextXAlignment.Center,
					TextYAlignment = Enum.TextYAlignment.Center,
					ZIndex = zIndex + 3,
				}, {
					e("UIGradient", {
						Color = ColorSequence.new({
							ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
							ColorSequenceKeypoint.new(1, Color3.fromRGB(236, 214, 151)),
						}),
						Rotation = 90,
					}),
				}),
				if UNDERLINE_IMAGE ~= ""
					then e("ImageLabel", {
						AnchorPoint = Vector2.new(0.5, 0),
						Position = UDim2.new(0.5, underlineXOffset, 1, -8 + underlineYOffset),
						Size = UDim2.fromOffset(underlineWidth, underlineHeight),
						BackgroundTransparency = 1,
						BorderSizePixel = 0,
						Image = UNDERLINE_IMAGE,
						ImageColor3 = Color3.fromRGB(255, 234, 154),
						ImageTransparency = underline.transparency,
						ScaleType = Enum.ScaleType.Stretch,
						ZIndex = zIndex + 2,
					})
					else e("Frame", {
						AnchorPoint = Vector2.new(0.5, 0),
						Position = UDim2.new(0.5, underlineXOffset, 1, -8 + underlineYOffset),
						Size = UDim2.fromOffset(underlineWidth, 4),
						BackgroundColor3 = Color3.fromRGB(255, 234, 154),
						BackgroundTransparency = underline.transparency,
						BorderSizePixel = 0,
						ZIndex = zIndex + 2,
					}, {
						e("UICorner", {
							CornerRadius = UDim.new(1, 0),
						}),
					}),
			}),
		},
	})
end
]]></string>
                    </Properties>
                  </Item>
                </Item>
                <Item class="Folder" referent="847">
                  <Properties>
                    <string name="Name">state</string>
                  </Properties>
                  <Item class="ModuleScript" referent="848">
                    <Properties>
                      <string name="Name">biomeSlice</string>
                      <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Charm = require(ReplicatedStorage.Packages.Charm)

export type BiomeState = {
	visible: boolean,
	biomeKey: string?,
	biomeName: string,
	enteredAt: number?,
	updatedAt: number,
}

export type ShowBiomePayload = {
	biomeKey: string?,
	biomeName: string?,
}

local DEFAULT_STATE: BiomeState = {
	visible = false,
	biomeKey = nil,
	biomeName = "",
	enteredAt = nil,
	updatedAt = os.clock(),
}

local biomeStateAtom: Charm.Atom<BiomeState> = Charm.atom(DEFAULT_STATE)

local function sanitizeBiomeKey(valueRaw: any): string?
	if typeof(valueRaw) == "string" and valueRaw ~= "" then
		return valueRaw
	end
	return nil
end

local function sanitizeBiomeName(valueRaw: any, fallback: string): string
	if typeof(valueRaw) == "string" and valueRaw ~= "" then
		return valueRaw
	end
	return fallback
end

local function getBiomeState(): BiomeState
	return biomeStateAtom()
end

local function setBiomeState(stateRaw: any): BiomeState
	local current = biomeStateAtom()
	local source = if typeof(stateRaw) == "table" then stateRaw else {}
	local visible = (source :: any).visible == true
	local biomeKey = sanitizeBiomeKey((source :: any).biomeKey)
	local biomeName = sanitizeBiomeName((source :: any).biomeName, current.biomeName)
	local enteredAtRaw = (source :: any).enteredAt
	local enteredAt = if typeof(enteredAtRaw) == "number" and enteredAtRaw == enteredAtRaw
		then enteredAtRaw
		else current.enteredAt

	local nextState: BiomeState = {
		visible = visible,
		biomeKey = biomeKey,
		biomeName = biomeName,
		enteredAt = enteredAt,
		updatedAt = os.clock(),
	}

	if not visible then
		nextState.enteredAt = nil
	end
	if nextState.biomeName == "" then
		nextState.visible = false
		nextState.enteredAt = nil
	end
	if nextState.biomeKey == nil then
		nextState.visible = false
		nextState.enteredAt = nil
	end

	biomeStateAtom(nextState)
	return nextState
end

local function showBiomeName(payloadRaw: any): BiomeState
	local current = biomeStateAtom()
	local payload = if typeof(payloadRaw) == "table" then payloadRaw else {}
	local biomeKey = sanitizeBiomeKey((payload :: any).biomeKey)
	local biomeName = sanitizeBiomeName((payload :: any).biomeName, current.biomeName)

	local nextState: BiomeState = {
		visible = biomeKey ~= nil and biomeName ~= "",
		biomeKey = biomeKey,
		biomeName = biomeName,
		enteredAt = os.clock(),
		updatedAt = os.clock(),
	}

	if not nextState.visible then
		nextState.enteredAt = nil
	end

	biomeStateAtom(nextState)
	return nextState
end

local function hideBiomeName(): BiomeState
	local current = biomeStateAtom()
	if not current.visible then
		return current
	end

	local nextState: BiomeState = {
		visible = false,
		biomeKey = current.biomeKey,
		biomeName = current.biomeName,
		enteredAt = nil,
		updatedAt = os.clock(),
	}
	biomeStateAtom(nextState)
	return nextState
end

local function resetBiomeState(): BiomeState
	local nextState: BiomeState = {
		visible = false,
		biomeKey = nil,
		biomeName = "",
		enteredAt = nil,
		updatedAt = os.clock(),
	}
	biomeStateAtom(nextState)
	return nextState
end

return {
	biomeStateAtom = biomeStateAtom,
	getBiomeState = getBiomeState,
	setBiomeState = setBiomeState,
	showBiomeName = showBiomeName,
	hideBiomeName = hideBiomeName,
	resetBiomeState = resetBiomeState,
}
]]></string>
                    </Properties>
                  </Item>
                  <Item class="ModuleScript" referent="849">
                    <Properties>
                      <string name="Name">biomeThunks</string>
                      <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local ConnectionUtils = require(script:FindFirstAncestor("game").Client.UI.core.utils.ConnectionUtils)
local WorldGenerationServiceClient =
	require(script:FindFirstAncestor("game").Client.Services.WorldGenerationServiceClient)
local biomeSlice = require(script:FindFirstAncestor("game").Client.UI.features.biome.state.biomeSlice)

type BiomeState = biomeSlice.BiomeState

local biomeThunks = {}

local BIOME_SAMPLE_INTERVAL = 0.2
local BIOME_BANNER_DURATION = 2.6
local BIOME_TYPE_CORRUPTION = 2
local DEPTH_LAYER_UNDERGROUND = 2
local DEPTH_LAYER_CAVERN = 3
local DEPTH_LAYER_DEEP = 4
local BIOME_ID_TO_NAME: { [number]: string } = {
	[1] = "The Overworld",
	[2] = "Desert",
	[3] = "Snow",
	[4] = "The Jungle",
	[5] = "The Corruption",
}

local runtime = {
	started = false,
	sampleAccumulator = 0,
	hideAt = nil :: number?,
	lastBiomeKey = nil :: string?,
	localPlayer = nil :: Player?,
	heartbeatConnection = nil :: RBXScriptConnection?,
	characterAddedConnection = nil :: RBXScriptConnection?,
}

local function resolveCharacterRootPart(characterRaw: any): BasePart?
	if typeof(characterRaw) ~= "Instance" or not characterRaw:IsA("Model") then
		return nil
	end

	local primaryPart = characterRaw.PrimaryPart
	if primaryPart ~= nil and primaryPart:IsA("BasePart") then
		return primaryPart
	end

	local humanoidRootPart = characterRaw:FindFirstChild("HumanoidRootPart")
	if humanoidRootPart ~= nil and humanoidRootPart:IsA("BasePart") then
		return humanoidRootPart
	end

	local upperTorso = characterRaw:FindFirstChild("UpperTorso")
	if upperTorso ~= nil and upperTorso:IsA("BasePart") then
		return upperTorso
	end

	local torso = characterRaw:FindFirstChild("Torso")
	if torso ~= nil and torso:IsA("BasePart") then
		return torso
	end

	return nil
end

local function resolveLocalPlayerRootPart(): BasePart?
	local localPlayer = runtime.localPlayer
	if localPlayer == nil then
		return nil
	end

	local character = localPlayer.Character
	if character == nil then
		return nil
	end

	return resolveCharacterRootPart(character)
end

local function isWorldReady(): boolean
	if typeof((WorldGenerationServiceClient :: any).state) ~= "table" then
		return false
	end

	local ok, worldState = pcall(function()
		return WorldGenerationServiceClient:getState()
	end)
	if not ok or typeof(worldState) ~= "table" then
		return false
	end

	return (worldState :: any).ready == true
end

local function resolveBiomeAtPosition(worldPosition: Vector3): (string?, string?)
	if not isWorldReady() then
		return nil, nil
	end

	local depthLayer: number?
	local depthLayerOk, depthLayerResult = pcall(function()
		return (WorldGenerationServiceClient :: any):getDepthLayerAtWorldPosition(worldPosition)
	end)
	if depthLayerOk and typeof(depthLayerResult) == "number" then
		depthLayer = math.floor(depthLayerResult)
	end

	if depthLayer == DEPTH_LAYER_CAVERN or depthLayer == DEPTH_LAYER_DEEP then
		return "caverns", "Caverns"
	end
	if depthLayer == DEPTH_LAYER_UNDERGROUND then
		return "the underground", "The Underground"
	end

	local biomeType: number?
	local biomeTypeOk, biomeTypeResult = pcall(function()
		return WorldGenerationServiceClient:getBiomeTypeAtWorldPosition(worldPosition)
	end)
	if biomeTypeOk and typeof(biomeTypeResult) == "number" then
		biomeType = math.floor(biomeTypeResult)
	end

	if biomeType == BIOME_TYPE_CORRUPTION then
		return "corruption", "The Corruption"
	end

	local biomeId: number?
	local biomeIdOk, biomeIdResult = pcall(function()
		return WorldGenerationServiceClient:getBiomeIdAtWorldPosition(worldPosition)
	end)
	if not biomeIdOk or typeof(biomeIdResult) ~= "number" then
		return nil, nil
	end

	biomeId = math.floor(biomeIdResult)
	local biomeName = BIOME_ID_TO_NAME[biomeId]
	if biomeName == nil then
		return nil, nil
	end

	return string.lower(biomeName), biomeName
end

local function showBiome(biomeKey: string, biomeName: string)
	runtime.lastBiomeKey = biomeKey
	runtime.hideAt = os.clock() + BIOME_BANNER_DURATION
	biomeSlice.showBiomeName({
		biomeKey = biomeKey,
		biomeName = biomeName,
	})
end

local function step(deltaTimeRaw: any)
	local deltaTime = if typeof(deltaTimeRaw) == "number" and deltaTimeRaw == deltaTimeRaw then deltaTimeRaw else 0
	local now = os.clock()

	local hideAt = runtime.hideAt
	if hideAt ~= nil and now >= hideAt then
		runtime.hideAt = nil
		biomeSlice.hideBiomeName()
	end

	runtime.sampleAccumulator += math.max(0, deltaTime)
	if runtime.sampleAccumulator < BIOME_SAMPLE_INTERVAL then
		return
	end
	runtime.sampleAccumulator = 0

	local rootPart = resolveLocalPlayerRootPart()
	if rootPart == nil then
		return
	end

	local biomeKey, biomeName = resolveBiomeAtPosition(rootPart.Position)
	if biomeKey == nil or biomeName == nil then
		return
	end

	if runtime.lastBiomeKey == biomeKey then
		return
	end

	showBiome(biomeKey, biomeName)
end

function biomeThunks.Start(): () -> ()
	if runtime.started then
		return biomeThunks.Stop
	end

	runtime.started = true
	runtime.sampleAccumulator = BIOME_SAMPLE_INTERVAL
	runtime.hideAt = nil
	runtime.lastBiomeKey = nil
	runtime.localPlayer = Players.LocalPlayer

	local localPlayer = runtime.localPlayer
	if localPlayer ~= nil then
		runtime.characterAddedConnection = localPlayer.CharacterAdded:Connect(function()
			runtime.lastBiomeKey = nil
			runtime.hideAt = nil
			biomeSlice.hideBiomeName()
		end)
	end

	runtime.heartbeatConnection = RunService.Heartbeat:Connect(function(deltaTime: number)
		if not runtime.started then
			return
		end
		step(deltaTime)
	end)

	step(BIOME_SAMPLE_INTERVAL)

	return biomeThunks.Stop
end

function biomeThunks.Stop()
	ConnectionUtils.disconnectMany({
		runtime.heartbeatConnection,
		runtime.characterAddedConnection,
	})
	runtime.heartbeatConnection = nil
	runtime.characterAddedConnection = nil

	runtime.started = false
	runtime.sampleAccumulator = 0
	runtime.hideAt = nil
	runtime.lastBiomeKey = nil
	runtime.localPlayer = nil
	biomeSlice.resetBiomeState()
end

function biomeThunks.GetBiomeState(): BiomeState
	return biomeSlice.getBiomeState()
end

biomeThunks.start = biomeThunks.Start
biomeThunks.stop = biomeThunks.Stop
biomeThunks.getBiomeState = biomeThunks.GetBiomeState

return biomeThunks
]]></string>
                    </Properties>
                  </Item>
                </Item>
              </Item>
              <Item class="Folder" referent="850">
                <Properties>
                  <string name="Name">boss</string>
                </Properties>
                <Item class="Folder" referent="851">
                  <Properties>
                    <string name="Name">components</string>
                  </Properties>
                  <Item class="ModuleScript" referent="852">
                    <Properties>
                      <string name="Name">marker</string>
                      <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ImageIds = require(script:FindFirstAncestor("game").Client.UI.core.ImageIds)
local React = require(ReplicatedStorage.Packages.React)

export type MarkerProps = {
	icon: string,
	position: Vector2,
	rotation: number,
	size: UDim2?,
	zIndex: number?,
	visible: boolean?,
}

local e: typeof(React.createElement) = React.createElement

local DEFAULT_SIZE = UDim2.fromOffset(72, 72)
local MARKER_COLOR = Color3.fromRGB(255, 247, 250)
local ICON_GAP = 4

return function(props: MarkerProps): React.ReactNode
	if props.visible == false then
		return nil
	end

	local zIndex = props.zIndex or 200
	local markerSize = props.size or DEFAULT_SIZE
	local markerWidth = if markerSize.X.Offset > 0 then markerSize.X.Offset else DEFAULT_SIZE.X.Offset
	local markerHeight = if markerSize.Y.Offset > 0 then markerSize.Y.Offset else DEFAULT_SIZE.Y.Offset
	local markerRadius = math.min(markerWidth, markerHeight) * 0.5
	local rotationRadians = math.rad(props.rotation)
	local baseDirection = Vector2.new(-math.sin(rotationRadians), math.cos(rotationRadians))
	local iconSize = math.max(16, math.floor(markerRadius * 0.58 + 0.5))
	local baseOffset = math.floor(markerRadius + ICON_GAP + iconSize * 0.5 + 0.5)
	local iconPosition = Vector2.new(markerWidth * 0.5, markerHeight * 0.5) + baseDirection * baseOffset

	return e("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(math.floor(props.position.X + 0.5), math.floor(props.position.Y + 0.5)),
		Size = markerSize,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ClipsDescendants = false,
		ZIndex = zIndex,
	}, {
		e("ImageLabel", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Image = ImageIds.marker,
			ImageColor3 = MARKER_COLOR,
			Rotation = props.rotation,
			ZIndex = zIndex + 1,
		}),
		e("ImageLabel", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(math.floor(iconPosition.X + 0.5), math.floor(iconPosition.Y + 0.5)),
			Size = UDim2.fromOffset(iconSize, iconSize),
			BackgroundTransparency = 1,
			Image = props.icon,
			ZIndex = zIndex + 2,
		}),
	})
end
]]></string>
                    </Properties>
                  </Item>
                </Item>
                <Item class="Folder" referent="853">
                  <Properties>
                    <string name="Name">screens</string>
                  </Properties>
                  <Item class="ModuleScript" referent="854">
                    <Properties>
                      <string name="Name">markerScreen</string>
                      <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Sift = require(ReplicatedStorage.Packages.Sift)
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local BossServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.BossServiceUtils)
local ImageIds = require(script:FindFirstAncestor("game").Client.UI.core.ImageIds)
local Layer = require(script:FindFirstAncestor("game").Client.UI.shared.Layer)
local Marker = require(script:FindFirstAncestor("game").Client.UI.features.boss.components.marker)
local React = require(ReplicatedStorage.Packages.React)
local markerSlice = require(script:FindFirstAncestor("game").Client.UI.features.boss.state.markerSlice)
local markerThunks = require(script:FindFirstAncestor("game").Client.UI.features.boss.state.markerThunks)
local useStore = require(script:FindFirstAncestor("game").Client.UI.core.hooks.useStore)

type MarkerState = markerSlice.MarkerState
type BossSnapshot = BossServiceUtils.BossSnapshot
type BossId = BossServiceUtils.BossId

type MarkerScreenProps = {
	layoutOrder: number?,
	zIndex: number?,
	visible: boolean?,
}

type RenderedMarker = {
	runtimeId: string,
	icon: string,
	position: Vector2,
	rotation: number,
}

local e: typeof(React.createElement) = React.createElement

local EDGE_PADDING = 72
local MARKER_SIZE = UDim2.fromOffset(70, 70)
local ROTATION_OFFSET_DEGREES = 90
local DEFAULT_DIRECTION = Vector2.new(0, -1)
local UNKNOWN_BOSS_ICON = ImageIds.questionMark

local BOSS_ICON_BY_ID: { [BossId]: string } = {
	EyeOfCthulhu = ImageIds.eocIcon,
}

local function resolveBossIcon(bossId: BossId): string
	return BOSS_ICON_BY_ID[bossId] or UNKNOWN_BOSS_ICON
end

local function resolveBossPosition(snapshot: BossSnapshot): Vector3?
	if snapshot.position ~= nil then
		return snapshot.position
	end
	return snapshot.motion.position
end

local function isBossSafelyOnScreen(viewportPoint: Vector3, viewportSize: Vector2): boolean
	if viewportPoint.Z <= 0 then
		return false
	end

	return viewportPoint.X >= EDGE_PADDING
		and viewportPoint.X <= viewportSize.X - EDGE_PADDING
		and viewportPoint.Y >= EDGE_PADDING
		and viewportPoint.Y <= viewportSize.Y - EDGE_PADDING
end

local function resolveDirection(viewportPoint: Vector3, viewportSize: Vector2): Vector2
	local center = viewportSize * 0.5
	local direction = Vector2.new(viewportPoint.X, viewportPoint.Y) - center
	if viewportPoint.Z <= 0 then
		direction = -direction
	end

	if direction.Magnitude <= 1e-4 then
		return DEFAULT_DIRECTION
	end

	return direction.Unit
end

local function clampToViewportEdge(direction: Vector2, viewportSize: Vector2): Vector2
	local center = viewportSize * 0.5
	local safeHalfExtents = Vector2.new(math.max(24, center.X - EDGE_PADDING), math.max(24, center.Y - EDGE_PADDING))
	local safeDirection = if direction.Magnitude > 1e-4 then direction else DEFAULT_DIRECTION
	local scaleX = if math.abs(safeDirection.X) > 1e-4 then safeHalfExtents.X / math.abs(safeDirection.X) else math.huge
	local scaleY = if math.abs(safeDirection.Y) > 1e-4 then safeHalfExtents.Y / math.abs(safeDirection.Y) else math.huge
	local scale = math.min(scaleX, scaleY)

	return center + safeDirection * scale
end

local function areRenderedMarkersEqual(left: { RenderedMarker }, right: { RenderedMarker }): boolean
	if #left ~= #right then
		return false
	end

	for index = 1, #left do
		local leftMarker = left[index]
		local rightMarker = right[index]
		if leftMarker.runtimeId ~= rightMarker.runtimeId or leftMarker.icon ~= rightMarker.icon then
			return false
		end
		if
			math.abs(leftMarker.position.X - rightMarker.position.X) > 0.5
			or math.abs(leftMarker.position.Y - rightMarker.position.Y) > 0.5
			or math.abs(leftMarker.rotation - rightMarker.rotation) > 0.5
		then
			return false
		end
	end

	return true
end

local function buildRenderedMarkers(camera: Camera?, markerState: MarkerState): { RenderedMarker }
	if camera == nil then
		return {}
	end

	local viewportSize = camera.ViewportSize
	if viewportSize.X <= 0 or viewportSize.Y <= 0 then
		return {}
	end

	local renderedMarkers = Sift.Array.create(#markerState.orderedIds)
	for _, runtimeId in markerState.orderedIds do
		local snapshot = markerState.byId[runtimeId]
		if snapshot == nil or snapshot.isAlive ~= true then
			continue
		end

		local bossPosition = resolveBossPosition(snapshot)
		if bossPosition == nil then
			continue
		end

		local viewportPoint, isOnScreen = camera:WorldToViewportPoint(bossPosition)
		if isOnScreen and isBossSafelyOnScreen(viewportPoint, viewportSize) then
			continue
		end

		local direction = resolveDirection(viewportPoint, viewportSize)
		local markerPosition = clampToViewportEdge(direction, viewportSize)
		local rotation = math.deg(math.atan2(direction.Y, direction.X)) + ROTATION_OFFSET_DEGREES

		renderedMarkers = Sift.Array.append(renderedMarkers, {
			runtimeId = runtimeId,
			icon = resolveBossIcon(snapshot.bossId),
			position = markerPosition,
			rotation = rotation,
		})
	end

	return renderedMarkers
end

return function(props: MarkerScreenProps): React.ReactNode
	local markerState = (useStore(markerSlice.markerStateAtom) :: MarkerState?) or markerSlice.getMarkerState()
	local isMarkerReady = (useStore(markerSlice.markerReadyAtom) :: boolean?) or markerSlice.isMarkerReady()
	local renderedMarkers, setRenderedMarkers = React.useState({} :: { RenderedMarker })
	local markerStateRef = React.useRef(markerState)
	local markerReadyRef = React.useRef(isMarkerReady)

	markerStateRef.current = markerState
	markerReadyRef.current = isMarkerReady

	React.useEffect(function()
		local stop = markerThunks.start()

		return function()
			stop()
		end
	end, {})

	React.useEffect(function()
		local connection = RunService.RenderStepped:Connect(function()
			if markerReadyRef.current ~= true then
				setRenderedMarkers(function(current: { RenderedMarker }): { RenderedMarker }
					if #current == 0 then
						return current
					end
					return {}
				end)
				return
			end

			local nextMarkers = buildRenderedMarkers(Workspace.CurrentCamera, markerStateRef.current)
			setRenderedMarkers(function(current: { RenderedMarker }): { RenderedMarker }
				if areRenderedMarkersEqual(current, nextMarkers) then
					return current
				end
				return nextMarkers
			end)
		end)

		return function()
			connection:Disconnect()
		end
	end, {})

	if props.visible == false or isMarkerReady ~= true or #renderedMarkers <= 0 then
		return nil
	end

	local zIndex = props.zIndex or 165
	local children: { React.ReactNode } = {}
	for _, renderedMarker in renderedMarkers do
		children[#children + 1] = e(Marker, {
			icon = renderedMarker.icon,
			position = renderedMarker.position,
			rotation = renderedMarker.rotation,
			size = MARKER_SIZE,
			zIndex = zIndex + 1,
		})
	end

	return e(Layer, {
		layoutOrder = props.layoutOrder or 165,
		zIndex = zIndex,
		active = false,
		native = {
			Selectable = false,
		},
		children = children,
	})
end
]]></string>
