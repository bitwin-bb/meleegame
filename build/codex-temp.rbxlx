                <Item class="Folder" referent="955">
                  <Properties>
                    <string name="Name">state</string>
                  </Properties>
                  <Item class="ModuleScript" referent="956">
                    <Properties>
                      <string name="Name">mouseSlice</string>
                      <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Charm = require(ReplicatedStorage.Packages.Charm)
local ImageIds = require(script:FindFirstAncestor("game").Client.UI.core.ImageIds)

export type MouseCursorState = "default" | "hover" | "click"
export type MouseState = {
	visible: boolean,
	position: Vector2,
	isHoveringGui: boolean,
	hoveredGuiPath: string?,
	isMouseDown: boolean,
	cursorState: MouseCursorState,
	imageId: string,
}

type MouseStateSource = {
	visible: boolean,
	position: Vector2,
	isHoveringGui: boolean,
	hoveredGuiPath: string?,
	isMouseDown: boolean,
}

local DEFAULT_MOUSE_IMAGE_ID = if typeof(ImageIds.mouse) == "string" then ImageIds.mouse else ""
local HOVER_MOUSE_IMAGE_ID = if typeof(ImageIds.mouseHover) == "string" then ImageIds.mouseHover else DEFAULT_MOUSE_IMAGE_ID
local CLICK_MOUSE_IMAGE_ID = if typeof(ImageIds.mouseClick) == "string" then ImageIds.mouseClick else HOVER_MOUSE_IMAGE_ID
local DEFAULT_MOUSE_POSITION = Vector2.new(0, 0)

local function resolveCursorState(source: MouseStateSource): MouseCursorState
	if source.isMouseDown then
		return "click"
	end
	if source.isHoveringGui then
		return "hover"
	end
	return "default"
end

local function resolveCursorImageId(cursorState: MouseCursorState): string
	if cursorState == "click" then
		return CLICK_MOUSE_IMAGE_ID
	end
	if cursorState == "hover" then
		return HOVER_MOUSE_IMAGE_ID
	end
	return DEFAULT_MOUSE_IMAGE_ID
end

local function createMouseState(source: MouseStateSource): MouseState
	local cursorState = resolveCursorState(source)
	return {
		visible = source.visible,
		position = source.position,
		isHoveringGui = source.isHoveringGui,
		hoveredGuiPath = if source.isHoveringGui then source.hoveredGuiPath else nil,
		isMouseDown = source.isMouseDown,
		cursorState = cursorState,
		imageId = resolveCursorImageId(cursorState),
	}
end

local DEFAULT_STATE: MouseState = createMouseState({
	visible = true,
	position = DEFAULT_MOUSE_POSITION,
	isHoveringGui = false,
	hoveredGuiPath = nil,
	isMouseDown = false,
})

local mouseStateAtom: Charm.Atom<MouseState> = Charm.atom(DEFAULT_STATE)

local mousePositionAtom: Charm.Selector<Vector2> = Charm.computed(function(): Vector2
	return mouseStateAtom().position
end)

local mouseVisibleAtom: Charm.Selector<boolean> = Charm.computed(function(): boolean
	return mouseStateAtom().visible
end)

local mouseCursorStateAtom: Charm.Selector<MouseCursorState> = Charm.computed(function(): MouseCursorState
	return mouseStateAtom().cursorState
end)

local mouseImageIdAtom: Charm.Selector<string> = Charm.computed(function(): string
	return mouseStateAtom().imageId
end)

local function sanitizePosition(value: any): Vector2
	if typeof(value) == "Vector2" then
		return value
	end

	return mouseStateAtom().position
end

local function sanitizeBool(value: any, fallback: boolean): boolean
	if type(value) == "boolean" then
		return value
	end
	return fallback
end

local function sanitizeHoveredGuiPath(value: any): string?
	if typeof(value) == "string" and value ~= "" then
		return value
	end
	return nil
end

local function getMouseState(): MouseState
	return mouseStateAtom()
end

local function setMouseState(stateRaw: any): MouseState
	local current = mouseStateAtom()
	local source = if typeof(stateRaw) == "table" then stateRaw else {}
	local nextState = createMouseState({
		visible = sanitizeBool((source :: any).visible, current.visible),
		position = sanitizePosition((source :: any).position),
		isHoveringGui = sanitizeBool((source :: any).isHoveringGui, current.isHoveringGui),
		hoveredGuiPath = sanitizeHoveredGuiPath((source :: any).hoveredGuiPath),
		isMouseDown = sanitizeBool((source :: any).isMouseDown, current.isMouseDown),
	})

	mouseStateAtom(nextState)
	return nextState
end

local function updatePointer(positionRaw: any, isHoveringRaw: any, hoveredGuiPathRaw: any): MouseState
	local current = mouseStateAtom()
	local nextState = createMouseState({
		visible = current.visible,
		position = sanitizePosition(positionRaw),
		isHoveringGui = sanitizeBool(isHoveringRaw, current.isHoveringGui),
		hoveredGuiPath = sanitizeHoveredGuiPath(hoveredGuiPathRaw),
		isMouseDown = current.isMouseDown,
	})
	mouseStateAtom(nextState)
	return nextState
end

local function setMousePosition(positionRaw: any): MouseState
	local current = mouseStateAtom()
	local nextState = createMouseState({
		visible = current.visible,
		position = sanitizePosition(positionRaw),
		isHoveringGui = current.isHoveringGui,
		hoveredGuiPath = current.hoveredGuiPath,
		isMouseDown = current.isMouseDown,
	})
	mouseStateAtom(nextState)
	return nextState
end

local function setHovering(isHoveringRaw: any, hoveredGuiPathRaw: any): MouseState
	local current = mouseStateAtom()
	local nextState = createMouseState({
		visible = current.visible,
		position = current.position,
		isHoveringGui = sanitizeBool(isHoveringRaw, current.isHoveringGui),
		hoveredGuiPath = sanitizeHoveredGuiPath(hoveredGuiPathRaw),
		isMouseDown = current.isMouseDown,
	})
	mouseStateAtom(nextState)
	return nextState
end

local function setMouseDown(isMouseDownRaw: any): MouseState
	local current = mouseStateAtom()
	local nextState = createMouseState({
		visible = current.visible,
		position = current.position,
		isHoveringGui = current.isHoveringGui,
		hoveredGuiPath = current.hoveredGuiPath,
		isMouseDown = sanitizeBool(isMouseDownRaw, current.isMouseDown),
	})
	mouseStateAtom(nextState)
	return nextState
end

local function setMouseVisible(visibleRaw: any): MouseState
	local current = mouseStateAtom()
	local nextState = createMouseState({
		visible = sanitizeBool(visibleRaw, current.visible),
		position = current.position,
		isHoveringGui = current.isHoveringGui,
		hoveredGuiPath = current.hoveredGuiPath,
		isMouseDown = current.isMouseDown,
	})
	mouseStateAtom(nextState)
	return nextState
end

local function resetMouseState(): MouseState
	local current = mouseStateAtom()
	local nextState = createMouseState({
		visible = current.visible,
		position = current.position,
		isHoveringGui = false,
		hoveredGuiPath = nil,
		isMouseDown = false,
	})
	mouseStateAtom(nextState)
	return nextState
end

return {
	mouseStateAtom = mouseStateAtom,
	mousePositionAtom = mousePositionAtom,
	mouseVisibleAtom = mouseVisibleAtom,
	mouseCursorStateAtom = mouseCursorStateAtom,
	mouseImageIdAtom = mouseImageIdAtom,
	getMouseState = getMouseState,
	setMouseState = setMouseState,
	updatePointer = updatePointer,
	setMousePosition = setMousePosition,
	setHovering = setHovering,
	setMouseDown = setMouseDown,
	setMouseVisible = setMouseVisible,
	resetMouseState = resetMouseState,
}
]]></string>
                    </Properties>
                  </Item>
                  <Item class="ModuleScript" referent="957">
                    <Properties>
                      <string name="Name">mouseThunks</string>
                      <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ConnectionUtils = require(script:FindFirstAncestor("game").Client.UI.core.utils.ConnectionUtils)
local PlatformServiceClient = require(script:FindFirstAncestor("game").Client.Services.PlatformServiceClient)
local mouseSlice = require(script:FindFirstAncestor("game").Client.UI.features.mouse.state.mouseSlice)
local CoreRuntime = require(script:FindFirstAncestor("game").Shared.Modules.Core.Runtime)

type MouseState = mouseSlice.MouseState

local mouseThunks = {}

local runtime = {
	started = false,
	defaultMouseIconEnabled = nil :: boolean?,
	inputChangedConnection = nil :: RBXScriptConnection?,
	inputBeganConnection = nil :: RBXScriptConnection?,
	inputEndedConnection = nil :: RBXScriptConnection?,
	lastInputTypeChangedConnection = nil :: RBXScriptConnection?,
	renderSteppedConnection = nil :: RBXScriptConnection?,
	platformDisconnect = nil :: (() -> ())?,
	usingSharedCursor = false,
	customCursorAllowed = false,
	cursor = nil :: any?,
	cursorDisconnect = nil :: (() -> ())?,
}

local function toGuiPosition(screenPosition: Vector2): Vector2
	return screenPosition
end

local function getPlayerGui(): PlayerGui?
	local localPlayer = Players.LocalPlayer
	if localPlayer == nil then
		return nil
	end

	local playerGui = localPlayer:FindFirstChildOfClass("PlayerGui")
	if playerGui and playerGui:IsA("PlayerGui") then
		return playerGui
	end

	return nil
end

local function isMouseButtonInput(inputType: Enum.UserInputType): boolean
	return inputType == Enum.UserInputType.MouseButton1
		or inputType == Enum.UserInputType.MouseButton2
		or inputType == Enum.UserInputType.MouseButton3
end

local function isMouseMovementInput(inputType: Enum.UserInputType): boolean
	return inputType == Enum.UserInputType.MouseMovement or inputType == Enum.UserInputType.Touch
end

local function isCustomCursorGui(guiObject: GuiObject): boolean
	local current: Instance? = guiObject
	while current do
		if current:GetAttribute("IsCustomMouseCursor") == true then
			return true
		end
		if CollectionService:HasTag(current, "IsCustomMouseCursor") then
			return true
		end
		current = current.Parent
	end

	return false
end

local function isHoverTarget(guiObject: GuiObject): boolean
	if not guiObject.Visible then
		return false
	end
	if isCustomCursorGui(guiObject) then
		return false
	end
	if guiObject:IsA("GuiButton") then
		return true
	end
	if guiObject:IsA("TextBox") then
		return true
	end
	if guiObject.Active then
		return true
	end
	if guiObject.Selectable then
		return true
	end
	return false
end

local function resolveHoveredGuiObject(guiPosition: Vector2): GuiObject?
	local playerGui = getPlayerGui()
	if playerGui == nil then
		return nil
	end

	local success, guiObjects = pcall(function()
		return playerGui:GetGuiObjectsAtPosition(math.floor(guiPosition.X), math.floor(guiPosition.Y))
	end)
	if not success or type(guiObjects) ~= "table" then
		return nil
	end

	for _, guiObject in guiObjects do
		if guiObject:IsA("GuiObject") and isHoverTarget(guiObject) then
			return guiObject
		end
	end

	return nil
end

local function applyPointerStateFromCursorState(cursorStateRaw: any)
	if not runtime.customCursorAllowed then
		return
	end
	if typeof(cursorStateRaw) ~= "table" then
		return
	end
	local pointerPosition = if typeof(cursorStateRaw.screenPosition) == "Vector2"
		then cursorStateRaw.screenPosition
		else if typeof(cursorStateRaw.guiPosition) == "Vector2" then cursorStateRaw.guiPosition else Vector2.zero
	local isHoveringGui = cursorStateRaw.isHoveringGui == true
	local hoveredGuiPath = if typeof(cursorStateRaw.hoveredGuiPath) == "string" then cursorStateRaw.hoveredGuiPath else nil
	mouseSlice.setMouseVisible(cursorStateRaw.visible == true)
	mouseSlice.setMouseDown(cursorStateRaw.mouseDown == true)
	mouseSlice.updatePointer(pointerPosition, isHoveringGui, hoveredGuiPath)
end

local function applyPointerStateFromScreenPosition(screenPosition: Vector2)
	local guiPosition = toGuiPosition(screenPosition)
	local hoveredGui = resolveHoveredGuiObject(guiPosition)
	mouseSlice.updatePointer(guiPosition, hoveredGui ~= nil, if hoveredGui ~= nil then hoveredGui:GetFullName() else nil)
end

local function syncPointerFromMouseLocation()
	if not runtime.customCursorAllowed then
		return
	end
	local success, mouseLocation = pcall(function()
		return UserInputService:GetMouseLocation()
	end)
	if success and typeof(mouseLocation) == "Vector2" then
		applyPointerStateFromScreenPosition(mouseLocation)
	end
end

local function applyVisibilityFromInputMode()
	if not runtime.customCursorAllowed then
		mouseSlice.setMouseVisible(false)
		mouseSlice.setMouseDown(false)
		return
	end
	local shouldShowMouse = UserInputService.MouseEnabled
	mouseSlice.setMouseVisible(shouldShowMouse)
	mouseSlice.setMouseDown(false)
end

local function bindSharedCursor(): boolean
	local runtimeContext = CoreRuntime.getClientRuntime()
	local cursor = if runtimeContext ~= nil then (runtimeContext :: any).cursor else nil
	if cursor == nil or typeof((cursor :: any).onChanged) ~= "function" then
		return false
	end

	runtime.cursor = cursor
	runtime.usingSharedCursor = true
	if typeof((cursor :: any).init) == "function" then
		local cursorAny = cursor :: any
		cursorAny:init()
	end
	runtime.cursorDisconnect = (cursor :: any):onChanged(function(nextState: any)
		applyPointerStateFromCursorState(nextState)
	end)
	if typeof((cursor :: any).setEnabled) == "function" then
		local cursorAny = cursor :: any
		cursorAny:setEnabled(runtime.customCursorAllowed)
	end
	if typeof((cursor :: any).sync) == "function" then
		local cursorAny = cursor :: any
		cursorAny:sync()
	end
	if typeof((cursor :: any).getState) == "function" then
		applyPointerStateFromCursorState((cursor :: any):getState())
	end
	return true
end

local function applyCursorPolicy()
	runtime.customCursorAllowed = PlatformServiceClient:shouldUseCustomCursor()
	local machineFamily = PlatformServiceClient:getMachineFamily()

	if runtime.usingSharedCursor and runtime.cursor ~= nil and typeof((runtime.cursor :: any).setEnabled) == "function" then
		local cursorAny = runtime.cursor :: any
		cursorAny:setEnabled(runtime.customCursorAllowed)
		if runtime.customCursorAllowed then
			if typeof((runtime.cursor :: any).sync) == "function" then
				cursorAny:sync()
			end
			if typeof((runtime.cursor :: any).getState) == "function" then
				applyPointerStateFromCursorState(cursorAny:getState())
			end
			return
		end
	end

	if runtime.customCursorAllowed then
		if not runtime.usingSharedCursor then
			UserInputService.MouseIconEnabled = false
		end
		applyVisibilityFromInputMode()
		syncPointerFromMouseLocation()
		return
	end

	if runtime.defaultMouseIconEnabled ~= nil then
		UserInputService.MouseIconEnabled = if machineFamily == "desktop" then runtime.defaultMouseIconEnabled else false
	else
		UserInputService.MouseIconEnabled = machineFamily == "desktop"
	end
	mouseSlice.setMouseVisible(false)
	mouseSlice.setMouseDown(false)
end

function mouseThunks.Start(): () -> ()
	if runtime.started then
		return mouseThunks.Stop
	end

	runtime.started = true
	if not PlatformServiceClient:isReady() then
		PlatformServiceClient:init()
	end
	runtime.defaultMouseIconEnabled = UserInputService.MouseIconEnabled

	if not bindSharedCursor() then
		runtime.inputChangedConnection = UserInputService.InputChanged:Connect(function(inputObject: InputObject)
			if not runtime.started or not runtime.customCursorAllowed then
				return
			end
			if isMouseMovementInput(inputObject.UserInputType) then
				applyPointerStateFromScreenPosition(inputObject.Position)
			end
		end)

		runtime.inputBeganConnection = UserInputService.InputBegan:Connect(function(inputObject: InputObject)
			if not runtime.started or not runtime.customCursorAllowed then
				return
			end
			if isMouseButtonInput(inputObject.UserInputType) then
				local currentMouseState = mouseSlice.getMouseState()
				if currentMouseState.isHoveringGui then
					mouseSlice.setMouseDown(true)
				else
					mouseSlice.setMouseDown(false)
				end
				syncPointerFromMouseLocation()
			end
		end)

		runtime.inputEndedConnection = UserInputService.InputEnded:Connect(function(inputObject: InputObject)
			if not runtime.started or not runtime.customCursorAllowed then
				return
			end
			if isMouseButtonInput(inputObject.UserInputType) then
				mouseSlice.setMouseDown(false)
				syncPointerFromMouseLocation()
			end
		end)

		runtime.lastInputTypeChangedConnection = UserInputService.LastInputTypeChanged:Connect(function()
			if not runtime.started then
				return
			end
			applyVisibilityFromInputMode()
			syncPointerFromMouseLocation()
		end)

		runtime.renderSteppedConnection = RunService.RenderStepped:Connect(function()
			if not runtime.started or not runtime.customCursorAllowed then
				return
			end
			if not UserInputService.MouseEnabled then
				return
			end
			syncPointerFromMouseLocation()
		end)
	end

	runtime.platformDisconnect = PlatformServiceClient:onPlatformChanged(function()
		applyCursorPolicy()
	end)
	applyCursorPolicy()

	return mouseThunks.Stop
end

function mouseThunks.Stop()
	ConnectionUtils.call(runtime.platformDisconnect)
	runtime.platformDisconnect = nil

	if runtime.cursor ~= nil and typeof((runtime.cursor :: any).setEnabled) == "function" then
		local cursorAny = runtime.cursor :: any
		cursorAny:setEnabled(false)
	end
	ConnectionUtils.call(runtime.cursorDisconnect)
	runtime.cursorDisconnect = nil
	runtime.cursor = nil
	runtime.usingSharedCursor = false
	runtime.customCursorAllowed = false

	ConnectionUtils.disconnectMany({
		runtime.inputChangedConnection,
		runtime.inputBeganConnection,
		runtime.inputEndedConnection,
		runtime.lastInputTypeChangedConnection,
		runtime.renderSteppedConnection,
	})
	runtime.inputChangedConnection = nil
	runtime.inputBeganConnection = nil
	runtime.inputEndedConnection = nil
	runtime.lastInputTypeChangedConnection = nil
	runtime.renderSteppedConnection = nil

	if runtime.defaultMouseIconEnabled ~= nil then
		UserInputService.MouseIconEnabled = runtime.defaultMouseIconEnabled
	end
	runtime.defaultMouseIconEnabled = nil

	runtime.started = false
	mouseSlice.setMouseVisible(false)
	mouseSlice.resetMouseState()
end

function mouseThunks.SyncPointer()
	if runtime.usingSharedCursor and runtime.cursor ~= nil then
		if typeof((runtime.cursor :: any).sync) == "function" then
			local cursorAny = runtime.cursor :: any
			cursorAny:sync()
		end
		if typeof((runtime.cursor :: any).getState) == "function" then
			applyPointerStateFromCursorState((runtime.cursor :: any):getState())
		end
		return
	end
	syncPointerFromMouseLocation()
end

function mouseThunks.SetMouseDown(isMouseDown: boolean)
	if runtime.usingSharedCursor and runtime.cursor ~= nil and typeof((runtime.cursor :: any).setMouseDown) == "function" then
		local cursorAny = runtime.cursor :: any
		cursorAny:setMouseDown(isMouseDown)
	end
	mouseSlice.setMouseDown(isMouseDown)
end

function mouseThunks.GetMouseState(): MouseState
	return mouseSlice.getMouseState()
end

mouseThunks.start = mouseThunks.Start
mouseThunks.stop = mouseThunks.Stop
mouseThunks.syncPointer = mouseThunks.SyncPointer
mouseThunks.setMouseDown = mouseThunks.SetMouseDown
mouseThunks.getMouseState = mouseThunks.GetMouseState

return mouseThunks
]]></string>
                    </Properties>
                  </Item>
                </Item>
              </Item>
              <Item class="Folder" referent="958">
                <Properties>
                  <string name="Name">pad</string>
                </Properties>
                <Item class="Folder" referent="959">
                  <Properties>
                    <string name="Name">hooks</string>
                  </Properties>
                  <Item class="ModuleScript" referent="960">
                    <Properties>
                      <string name="Name">usePad</string>
                      <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local React = require(ReplicatedStorage.Packages.React)

export type PadOptions = {
	enabled: boolean?,
	collapsedSize: Vector2?,
	expandedSize: Vector2?,
	phaseDuration: number?,
}

export type PadState = {
	size: Vector2,
	progress: number,
	expanding: boolean,
}

local DEFAULT_COLLAPSED_SIZE = Vector2.new(44, 44)
local DEFAULT_EXPANDED_SIZE = Vector2.new(52, 52)
local DEFAULT_PHASE_DURATION = 0.7

local function sanitizeVector2(valueRaw: any, fallback: Vector2): Vector2
	if typeof(valueRaw) ~= "Vector2" then
		return fallback
	end
	if valueRaw.X ~= valueRaw.X or valueRaw.Y ~= valueRaw.Y then
		return fallback
	end
	return valueRaw
end

local function sanitizeDuration(valueRaw: any, fallback: number): number
	if typeof(valueRaw) ~= "number" or valueRaw ~= valueRaw then
		return fallback
	end
	return math.max(0.05, valueRaw)
end

local function createPadState(size: Vector2, progress: number, expanding: boolean): PadState
	return {
		size = size,
		progress = math.clamp(progress, 0, 1),
		expanding = expanding,
	}
end

local function usePad(options: PadOptions?): PadState
	local enabled = if options ~= nil and options.enabled ~= nil then options.enabled == true else true
	local collapsedSize = sanitizeVector2(
		if options ~= nil then options.collapsedSize else nil,
		DEFAULT_COLLAPSED_SIZE
	)
	local requestedExpandedSize = sanitizeVector2(
		if options ~= nil then options.expandedSize else nil,
		DEFAULT_EXPANDED_SIZE
	)
	local expandedSize = Vector2.new(
		math.max(collapsedSize.X, requestedExpandedSize.X),
		math.max(collapsedSize.Y, requestedExpandedSize.Y)
	)
	local phaseDuration = sanitizeDuration(if options ~= nil then options.phaseDuration else nil, DEFAULT_PHASE_DURATION)

	local phaseElapsedRef = React.useRef(0)
	local expandingRef = React.useRef(true)
	local padState, setPadState = React.useState(createPadState(collapsedSize, 0, true))

	React.useEffect(function()
		phaseElapsedRef.current = 0
		expandingRef.current = true
		setPadState(createPadState(collapsedSize, 0, true))
	end, { enabled, collapsedSize, expandedSize, phaseDuration })

	React.useEffect(function()
		if not enabled then
			setPadState(createPadState(collapsedSize, 0, true))
			return nil
		end

		local connection = RunService.RenderStepped:Connect(function(deltaTime: number)
			phaseElapsedRef.current += math.max(0, deltaTime)

			local expanding = expandingRef.current
			local phaseProgress = math.clamp(phaseElapsedRef.current / phaseDuration, 0, 1)
			local fromSize = if expanding then collapsedSize else expandedSize
			local toSize = if expanding then expandedSize else collapsedSize
			local size = fromSize:Lerp(toSize, phaseProgress)
			local displayProgress = if expanding then phaseProgress else 1 - phaseProgress

			setPadState(createPadState(size, displayProgress, expanding))

			if phaseProgress >= 1 then
				phaseElapsedRef.current = 0
				expandingRef.current = not expanding
			end
		end)

		return function()
			connection:Disconnect()
		end
	end, { enabled, collapsedSize, expandedSize, phaseDuration })

	return padState
end

return usePad
]]></string>
                    </Properties>
                  </Item>
                </Item>
                <Item class="Folder" referent="961">
                  <Properties>
                    <string name="Name">screens</string>
                  </Properties>
                  <Item class="ModuleScript" referent="962">
                    <Properties>
                      <string name="Name">pad</string>
                      <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local BillboardCard = require(script:FindFirstAncestor("game").Client.UI.core.components.BillboardCard)
local GamepadNav = require(script:FindFirstAncestor("game").Shared.Modules.Platform.GamepadNav)
local GamepadPointer = require(script:FindFirstAncestor("game").Shared.Modules.Platform.GamepadPointer)
local React = require(ReplicatedStorage.Packages.React)
local WorkspaceFolders = require(script:FindFirstAncestor("game").Shared.Modules.Core.WorkspaceFolders)
local padSlice = require(script:FindFirstAncestor("game").Client.UI.features.pad.state.padSlice)
local usePad = require(script:FindFirstAncestor("game").Client.UI.features.pad.hooks.usePad)
local useStore = require(script:FindFirstAncestor("game").Client.UI.core.hooks.useStore)

type PadState = padSlice.PadState

type PadScreenProps = {
	layoutOrder: number?,
	zIndex: number?,
	visible: boolean?,
}

type ActiveIndicatorState = {
	position: Vector2,
	hideOnCenter: boolean,
}

local e: typeof(React.createElement) = React.createElement

local WORLD_FOLDER_NAME = "WorldGeneration"
local BILLBOARD_SIZE = Vector2.new(640, 640)
local INDICATOR_SIZE = 44
local IDLE_EXPANDED_SIZE = Vector2.new(52, 52)
local IDLE_PHASE_DURATION = 0.7
local FALLBACK_PRESENTATION_RADIUS_PIXELS = 48
local RETURN_SPEED = 10
local DEBUG_GAMEPAD_NAV_PRESENTATION = true
local DEBUG_PRESENTATION_PRINT_INTERVAL = 0.2
local THUMBSTICK_ACTIVE_EPSILON = GamepadNav.THUMBSTICK_ACTIVE_EPSILON

local lastPresentationDebugAt = 0

local function resolveCharacterRootPart(localPlayer: Player): BasePart?
	local character = localPlayer.Character
	if character == nil then
		return nil
	end

	local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
	if humanoidRootPart ~= nil and humanoidRootPart:IsA("BasePart") then
		return humanoidRootPart
	end

	if character.PrimaryPart ~= nil then
		return character.PrimaryPart
	end

	return character:FindFirstChildWhichIsA("BasePart")
end

local function formatVector2(valueRaw: any): string
	if typeof(valueRaw) ~= "Vector2" then
		return tostring(valueRaw)
	end

	local value = valueRaw :: Vector2
	return string.format("(%.3f, %.3f)", value.X, value.Y)
end

local function formatVector3(valueRaw: any): string
	if typeof(valueRaw) ~= "Vector3" then
		return tostring(valueRaw)
	end

	local value = valueRaw :: Vector3
	return string.format("(%.3f, %.3f, %.3f)", value.X, value.Y, value.Z)
end

local function formatStickState(stick: padSlice.PadStickState): string
	return string.format(
		"pos=%s active=%s mag=%.3f",
		formatVector2(stick.position),
		tostring(stick.active),
		stick.magnitude
	)
end

local function debugPrintActiveChoice(source: string, state: PadState, selectedVector: Vector2?)
	if not DEBUG_GAMEPAD_NAV_PRESENTATION then
		return
	end

	print(
		string.format(
			"[gamepadNav-debug][pad.choice] source=%s selectedVector=%s | pad.left{%s} | pad.right{%s}",
			source,
			formatVector2(selectedVector),
			formatStickState(state.leftStick),
			formatStickState(state.rightStick)
		)
	)
end

local function resolveWorldTileSizeStuds(): number
	local worldFolder = WorkspaceFolders.findFolderInGameOrWorkspace(WORLD_FOLDER_NAME)
	if worldFolder ~= nil then
		local tileSize = worldFolder:GetAttribute("TileSize")
		if typeof(tileSize) == "number" and tileSize == tileSize and tileSize > 0 then
			return tileSize
		end
	end

	return GamepadPointer.DEFAULT_TILE_SIZE_STUDS
end

local function resolvePresentationDeadzoneMagnitude(state: PadState): number
	return GamepadNav.resolveRemappedDeadzoneMagnitude(state.stickDeadzone, state.navigationDeadzone)
end

local function resolvePresentationVector(state: PadState, position: Vector2): Vector2
	local deadzoneMagnitude = resolvePresentationDeadzoneMagnitude(state)
	local magnitude = position.Magnitude
	if magnitude <= deadzoneMagnitude or magnitude <= THUMBSTICK_ACTIVE_EPSILON then
		return Vector2.zero
	end

	local scaledMagnitude = (magnitude - deadzoneMagnitude) / math.max(THUMBSTICK_ACTIVE_EPSILON, 1 - deadzoneMagnitude)
	return position.Unit * math.clamp(scaledMagnitude, 0, 1)
end

local function resolveBackendReachPixelOffset(rootPart: BasePart, vector: Vector2, tileSizeStuds: number): Vector2?
	local camera = Workspace.CurrentCamera
	if camera == nil then
		return nil
	end

	local worldOffset = GamepadPointer.resolveWorldOffsetForScreenVector(vector, tileSizeStuds, rootPart)
	if worldOffset == nil then
		return Vector2.zero
	end

	local rootViewportPosition = camera:WorldToViewportPoint(rootPart.Position)
	local targetViewportPosition = camera:WorldToViewportPoint(rootPart.Position + worldOffset)
	return Vector2.new(
		targetViewportPosition.X - rootViewportPosition.X,
		targetViewportPosition.Y - rootViewportPosition.Y
	)
end

local function getPresentationPixelOffset(state: PadState, position: Vector2, rootPart: BasePart): Vector2
	local presentationVector = resolvePresentationVector(state, position)
	if presentationVector.Magnitude <= THUMBSTICK_ACTIVE_EPSILON then
		return Vector2.zero
	end

	local tileSizeStuds = resolveWorldTileSizeStuds()
	local backendPixelOffset = resolveBackendReachPixelOffset(rootPart, presentationVector, tileSizeStuds)
	if backendPixelOffset ~= nil then
		return backendPixelOffset
	end

	return presentationVector * FALLBACK_PRESENTATION_RADIUS_PIXELS
end

local function isStickPresentationActive(state: PadState, stick: padSlice.PadStickState): boolean
	return stick.active and stick.magnitude > resolvePresentationDeadzoneMagnitude(state)
end

local function debugPrintPresentation(state: PadState, activeIndicator: ActiveIndicatorState, rootPart: BasePart)
	if not DEBUG_GAMEPAD_NAV_PRESENTATION then
		return
	end

	local now = os.clock()
	if now - lastPresentationDebugAt < DEBUG_PRESENTATION_PRINT_INTERVAL then
		return
	end
	lastPresentationDebugAt = now

	local presentationDeadzoneMagnitude = resolvePresentationDeadzoneMagnitude(state)
	local presentationVector = resolvePresentationVector(state, activeIndicator.position)
	local tileSizeStuds = resolveWorldTileSizeStuds()
	local backendReachStuds = GamepadPointer.resolveReachStuds(tileSizeStuds)
	local guiPixelOffset = getPresentationPixelOffset(state, activeIndicator.position, rootPart)
	local imageCenterPixels = Vector2.new(BILLBOARD_SIZE.X * 0.5, BILLBOARD_SIZE.Y * 0.5) + guiPixelOffset

	print(
		string.format(
			"[gamepadNav-debug][pad.presentation] indicatorVector=%s presentationVector=%s hideOnCenter=%s stickDeadzone=%.3f navigationDeadzone=%.3f presentationDeadzoneMag=%.3f tileSizeStuds=%.3f backendReachStuds=%.3f | guiPixelOffset=%s imageCenterPx=%s | BillboardGui.StudsOffsetWorldSpace=%s | rootPosition=%s | pad.left{%s} | pad.right{%s}",
			formatVector2(activeIndicator.position),
			formatVector2(presentationVector),
			tostring(activeIndicator.hideOnCenter),
			state.stickDeadzone,
			state.navigationDeadzone,
			presentationDeadzoneMagnitude,
			tileSizeStuds,
			backendReachStuds,
			formatVector2(guiPixelOffset),
			formatVector2(imageCenterPixels),
			formatVector3(Vector3.zero),
			formatVector3(rootPart.Position),
			formatStickState(state.leftStick),
			formatStickState(state.rightStick)
		)
	)
end

local function getPresentationPosition(state: PadState, position: Vector2, rootPart: BasePart): UDim2
	local pixelOffset = getPresentationPixelOffset(state, position, rootPart)
	return UDim2.fromOffset(BILLBOARD_SIZE.X * 0.5 + pixelOffset.X, BILLBOARD_SIZE.Y * 0.5 + pixelOffset.Y)
end

local function renderStickIndicator(
	state: PadState,
	imageId: string,
	position: Vector2,
	rootPart: BasePart,
	size: Vector2,
	zIndex: number
)
	return e("ImageLabel", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Image = imageId,
		ImageTransparency = 0.08,
		Position = getPresentationPosition(state, position, rootPart),
		Size = UDim2.fromOffset(math.floor(size.X + 0.5), math.floor(size.Y + 0.5)),
		ZIndex = zIndex,
	})
end

return function(props: PadScreenProps?): React.ReactNode
	local resolvedProps: PadScreenProps = if props ~= nil then props else {}
	local localPlayer = Players.LocalPlayer
	local state = (useStore(padSlice.padStateAtom) :: PadState?) or padSlice.getPadState()
	local rootPart, setRootPart = React.useState(resolveCharacterRootPart(localPlayer) :: BasePart?)
	local activeIndicator, setActiveIndicator = React.useState(nil :: ActiveIndicatorState?)
	local idlePad = usePad({
		enabled = activeIndicator ~= nil,
		collapsedSize = Vector2.new(INDICATOR_SIZE, INDICATOR_SIZE),
		expandedSize = IDLE_EXPANDED_SIZE,
		phaseDuration = IDLE_PHASE_DURATION,
	})

	React.useEffect(function()
		local characterConnections: { RBXScriptConnection } = {}

		local function disconnectCharacterConnections()
			for _, connection in characterConnections do
				connection:Disconnect()
			end
			table.clear(characterConnections)
		end

		local function refreshRootPart()
			setRootPart(resolveCharacterRootPart(localPlayer))
		end

		local function bindCharacter(character: Model?)
			disconnectCharacterConnections()
			if character == nil then
				setRootPart(nil)
				return
			end

			refreshRootPart()
			table.insert(characterConnections, character.ChildAdded:Connect(refreshRootPart))
			table.insert(characterConnections, character.ChildRemoved:Connect(refreshRootPart))
			table.insert(
				characterConnections,
				character:GetPropertyChangedSignal("PrimaryPart"):Connect(refreshRootPart)
			)
		end

		bindCharacter(localPlayer.Character)

		local characterAddedConnection = localPlayer.CharacterAdded:Connect(function(character: Model)
			bindCharacter(character)
		end)
		local characterRemovingConnection = localPlayer.CharacterRemoving:Connect(function()
			disconnectCharacterConnections()
			setRootPart(nil)
		end)

		return function()
			characterAddedConnection:Disconnect()
			characterRemovingConnection:Disconnect()
			disconnectCharacterConnections()
		end
	end, { localPlayer })

	React.useEffect(function()
		if isStickPresentationActive(state, state.rightStick) then
			debugPrintActiveChoice("Right", state, state.rightStick.position)
			setActiveIndicator({
				position = state.rightStick.position,
				hideOnCenter = false,
			})
			return nil
		end

		if isStickPresentationActive(state, state.leftStick) then
			debugPrintActiveChoice("Left", state, state.leftStick.position)
			setActiveIndicator({
				position = state.leftStick.position,
				hideOnCenter = false,
			})
			return nil
		end

		setActiveIndicator(function(current: ActiveIndicatorState?): ActiveIndicatorState?
			if current == nil then
				debugPrintActiveChoice("None", state, nil)
				return nil
			end
			debugPrintActiveChoice("ReturnToCenter", state, current.position)
			return {
				position = current.position,
				hideOnCenter = true,
			}
		end)

		return nil
	end, {
		state.leftStick.active,
		state.leftStick.position,
		state.rightStick.active,
		state.rightStick.position,
		state.stickDeadzone,
		state.navigationDeadzone,
	})

	React.useEffect(function()
		local current = activeIndicator
		if current == nil then
			return nil
		end
		if current.hideOnCenter ~= true then
			return nil
		end
		if current.position.Magnitude <= THUMBSTICK_ACTIVE_EPSILON then
			setActiveIndicator(nil)
			return nil
		end

		local connection = RunService.RenderStepped:Connect(function(deltaTime: number)
			setActiveIndicator(function(active: ActiveIndicatorState?): ActiveIndicatorState?
				if active == nil then
					return nil
				end
				if active.hideOnCenter ~= true then
					return active
				end

				local distance = active.position.Magnitude
				if distance <= THUMBSTICK_ACTIVE_EPSILON then
					return nil
				end

				local stepDistance = RETURN_SPEED * deltaTime
				local nextPosition = if stepDistance >= distance
					then Vector2.zero
					else active.position.Unit * (distance - stepDistance)

				return {
					position = nextPosition,
					hideOnCenter = true,
				}
			end)
		end)

		return function()
			connection:Disconnect()
		end
	end, { activeIndicator })

	if resolvedProps.visible == false or state.visible ~= true or rootPart == nil then
		return nil
	end

	local zIndex = resolvedProps.zIndex or 980
	local imageId = state.imageId
	if imageId == "" then
		return nil
	end

	if activeIndicator == nil then
		return nil
	end

	debugPrintPresentation(state, activeIndicator, rootPart)

	return e(BillboardCard, {
		adornee = rootPart,
		alwaysOnTop = true,
		enabled = true,
		lightInfluence = 0,
		maxDistance = 80,
		size = UDim2.fromOffset(BILLBOARD_SIZE.X, BILLBOARD_SIZE.Y),
		studsOffset = Vector3.zero,
		studsOffsetWorldSpace = Vector3.zero,
		zIndexBehavior = Enum.ZIndexBehavior.Sibling,
		cardVisible = false,
		nativeBillboard = {
			ResetOnSpawn = false,
		},
	}, {
		ActiveIndicator = renderStickIndicator(
			state,
			imageId,
			activeIndicator.position,
			rootPart,
			idlePad.size,
			zIndex + 1
		),
	})
end
]]></string>
                    </Properties>
                  </Item>
                </Item>
                <Item class="Folder" referent="963">
                  <Properties>
                    <string name="Name">state</string>
                  </Properties>
                  <Item class="ModuleScript" referent="964">
                    <Properties>
                      <string name="Name">padSlice</string>
                      <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Charm = require(ReplicatedStorage.Packages.Charm)
local GamepadNav = require(script:FindFirstAncestor("game").Shared.Modules.Platform.GamepadNav)
local ImageIds = require(script:FindFirstAncestor("game").Client.UI.core.ImageIds)

export type PadStickState = {
	position: Vector2,
	magnitude: number,
	active: boolean,
}

export type PadState = {
	visible: boolean,
	platform: string,
	imageId: string,
	dominantStick: "Left" | "Right"?,
	leftStick: PadStickState,
	rightStick: PadStickState,
	lastInputAt: number,
	stickDeadzone: number,
	navigationDeadzone: number,
}

local DEFAULT_IMAGE_ID = if typeof((ImageIds :: any).platform) == "table"
		and typeof(((ImageIds :: any).platform :: any).gamepadNav) == "string"
	then ((ImageIds :: any).platform :: any).gamepadNav :: string
	else ""

local DEBUG_GAMEPAD_NAV_PRESENTATION = true
local THUMBSTICK_ACTIVE_EPSILON = GamepadNav.THUMBSTICK_ACTIVE_EPSILON

local function sanitizeDeadzone(valueRaw: any, fallback: number): number
	local value = if typeof(valueRaw) == "number" and valueRaw == valueRaw then valueRaw else fallback
	return math.clamp(value, 0, 1)
end

local function formatVector2(valueRaw: any): string
	if typeof(valueRaw) ~= "Vector2" then
		return tostring(valueRaw)
	end

	local value = valueRaw :: Vector2
	return string.format("(%.3f, %.3f)", value.X, value.Y)
end

local function formatStickSnapshot(stickRaw: any): string
	if typeof(stickRaw) ~= "table" then
		return "nil"
	end

	local stick = stickRaw :: any
	return string.format(
		"raw=%s screen=%s active=%s mag=%s",
		formatVector2(stick.raw),
		formatVector2(stick.screen),
		tostring(stick.active == true),
		if typeof(stick.magnitude) == "number"
			then string.format("%.3f", stick.magnitude)
			else tostring(stick.magnitude)
	)
end

local function debugPrintThumbstickState(snapshotRaw: any, nextState: PadState)
	if not DEBUG_GAMEPAD_NAV_PRESENTATION then
		return
	end

	local snapshot = if typeof(snapshotRaw) == "table" then snapshotRaw :: any else {}
	print(
		string.format(
			"[gamepadNav-debug][padSlice.updateThumbsticks] dominant=%s lastUpdatedAt=%s stickDeadzone=%.3f navigationDeadzone=%.3f | gamepad.left{%s} -> pad.left{pos=%s active=%s mag=%.3f} | gamepad.right{%s} -> pad.right{pos=%s active=%s mag=%.3f}",
			tostring(snapshot.dominant),
			if typeof(snapshot.lastUpdatedAt) == "number"
				then string.format("%.3f", snapshot.lastUpdatedAt)
				else tostring(snapshot.lastUpdatedAt),
			sanitizeDeadzone(snapshot.stickDeadzone, nextState.stickDeadzone),
			sanitizeDeadzone(snapshot.navigationDeadzone, nextState.navigationDeadzone),
			formatStickSnapshot(snapshot.left),
			formatVector2(nextState.leftStick.position),
			tostring(nextState.leftStick.active),
			nextState.leftStick.magnitude,
			formatStickSnapshot(snapshot.right),
			formatVector2(nextState.rightStick.position),
			tostring(nextState.rightStick.active),
			nextState.rightStick.magnitude
		)
	)
end

local function createStickState(positionRaw: any, activeRaw: any): PadStickState
	local position = if typeof(positionRaw) == "Vector2" then positionRaw else Vector2.zero
	local clampedPosition = Vector2.new(math.clamp(position.X, -1, 1), math.clamp(position.Y, -1, 1))
	return {
		position = clampedPosition,
		magnitude = math.clamp(clampedPosition.Magnitude, 0, 1),
		active = activeRaw == true and clampedPosition.Magnitude > THUMBSTICK_ACTIVE_EPSILON,
	}
end

local function createDefaultState(): PadState
	return {
		visible = false,
		platform = "KeyboardMouse",
		imageId = DEFAULT_IMAGE_ID,
		dominantStick = nil,
		leftStick = createStickState(Vector2.zero, false),
		rightStick = createStickState(Vector2.zero, false),
		lastInputAt = 0,
		stickDeadzone = GamepadNav.DEFAULT_STICK_DEADZONE,
		navigationDeadzone = GamepadNav.DEFAULT_NAVIGATION_DEADZONE,
	}
end

local padStateAtom: Charm.Atom<PadState> = Charm.atom(createDefaultState())

local function getPadState(): PadState
	return padStateAtom()
end

local function setPlatform(platformRaw: any): PadState
	local current = padStateAtom()
	local platform = if typeof(platformRaw) == "string" and platformRaw ~= "" then platformRaw else current.platform
	local nextState: PadState = {
		visible = platform == "Gamepad",
		platform = platform,
		imageId = current.imageId,
		dominantStick = current.dominantStick,
		leftStick = current.leftStick,
		rightStick = current.rightStick,
		lastInputAt = current.lastInputAt,
		stickDeadzone = current.stickDeadzone,
		navigationDeadzone = current.navigationDeadzone,
	}
	padStateAtom(nextState)
	return nextState
end

local function updateThumbsticks(snapshotRaw: any): PadState
	local current = padStateAtom()
	local snapshot = if typeof(snapshotRaw) == "table" then snapshotRaw else {}
	local left = if typeof((snapshot :: any).left) == "table" then (snapshot :: any).left else nil
	local right = if typeof((snapshot :: any).right) == "table" then (snapshot :: any).right else nil
	local nextState: PadState = {
		visible = current.platform == "Gamepad",
		platform = current.platform,
		imageId = current.imageId,
		dominantStick = if (snapshot :: any).dominant == "Left" or (snapshot :: any).dominant == "Right"
			then (snapshot :: any).dominant
			else nil,
		leftStick = createStickState(
			if left ~= nil then (left :: any).screen else current.leftStick.position,
			if left ~= nil then (left :: any).active else current.leftStick.active
		),
		rightStick = createStickState(
			if right ~= nil then (right :: any).screen else current.rightStick.position,
			if right ~= nil then (right :: any).active else current.rightStick.active
		),
		lastInputAt = if typeof((snapshot :: any).lastUpdatedAt) == "number"
			then (snapshot :: any).lastUpdatedAt
			else current.lastInputAt,
		stickDeadzone = sanitizeDeadzone((snapshot :: any).stickDeadzone, current.stickDeadzone),
		navigationDeadzone = sanitizeDeadzone((snapshot :: any).navigationDeadzone, current.navigationDeadzone),
	}
	debugPrintThumbstickState(snapshotRaw, nextState)
	padStateAtom(nextState)
	return nextState
end

local function resetPadState(): PadState
	local nextState = createDefaultState()
	padStateAtom(nextState)
	return nextState
end

return {
	padStateAtom = padStateAtom,
	getPadState = getPadState,
	setPlatform = setPlatform,
	updateThumbsticks = updateThumbsticks,
	resetPadState = resetPadState,
}
]]></string>
                    </Properties>
                  </Item>
                  <Item class="ModuleScript" referent="965">
                    <Properties>
                      <string name="Name">padThunks</string>
                      <string name="Source"><![CDATA[--!strict
local padSlice = require(script:FindFirstAncestor("game").Client.UI.features.pad.state.padSlice)

local padThunks = {}

function padThunks.Start(): () -> ()
	return function() end
end

function padThunks.Stop() end

function padThunks.GetPadState()
	return padSlice.getPadState()
end

padThunks.start = padThunks.Start
padThunks.stop = padThunks.Stop
padThunks.getPadState = padThunks.GetPadState

return padThunks
]]></string>
