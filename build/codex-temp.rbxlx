                    <string name="Name">SegmentIcon</string>
                    <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local React = require(ReplicatedStorage.Packages.React)

export type SegmentIconProps = {
	icon: string,
	size: UDim2?,
	position: UDim2?,
	anchorPoint: Vector2?,
	layoutOrder: number?,
	zIndex: number?,
	fillAlpha: number?,
	emptyColor: Color3?,
	fullColor: Color3?,
	tintColor: Color3?,
	emptyTransparency: number?,
	fullTransparency: number?,
	rotation: number?,
	scale: number?,
	clipFill: boolean?,
	resampleMode: Enum.ResamplerMode?,
	nativeFrame: { [any]: any }?,
	nativeEmpty: { [any]: any }?,
	nativeFull: { [any]: any }?,
	children: { React.ReactNode }?,
}

local e: typeof(React.createElement) = React.createElement

local function sanitizeNumber(valueRaw: any, fallback: number, minimum: number?, maximum: number?): number
	local value = if typeof(valueRaw) == "number" and valueRaw == valueRaw then valueRaw else fallback
	if minimum ~= nil and value < minimum then
		value = minimum
	end
	if maximum ~= nil and value > maximum then
		value = maximum
	end
	return value
end

local function applyNativeProps(target: { [any]: any }, nativeProps: { [any]: any }?)
	if nativeProps == nil then
		return
	end

	for key, value in nativeProps do
		target[key] = value
	end
end

return function(props: SegmentIconProps): React.ReactNode
	local zIndex = props.zIndex or 1
	local fillAlpha = sanitizeNumber(props.fillAlpha, 1, 0, 1)
	local emptyColor = props.emptyColor or props.tintColor or Color3.fromRGB(255, 255, 255)
	local fullColor = props.fullColor or props.tintColor or Color3.fromRGB(255, 255, 255)
	local rotation = props.rotation or 0

	local frameProps: { [any]: any } = {
		Size = props.size or UDim2.fromOffset(30, 30),
		Position = props.position,
		AnchorPoint = props.anchorPoint,
		LayoutOrder = props.layoutOrder,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = zIndex,
	}
	applyNativeProps(frameProps, props.nativeFrame)

	local emptyProps: { [any]: any } = {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Image = props.icon,
		ImageColor3 = emptyColor,
		ImageTransparency = sanitizeNumber(props.emptyTransparency, 0, 0, 1),
		Rotation = rotation,
		ScaleType = Enum.ScaleType.Fit,
		ResampleMode = props.resampleMode,
		ZIndex = zIndex + 1,
	}
	applyNativeProps(emptyProps, props.nativeEmpty)

	local children: { React.ReactNode } = {
		Empty = e("ImageLabel", emptyProps),
	}

	if props.scale ~= nil then
		children.Scale = e("UIScale", {
			Scale = sanitizeNumber(props.scale, 1, 0.05, 10),
		})
	end

	local fullProps: { [any]: any } = {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Image = props.icon,
		ImageColor3 = fullColor,
		ImageTransparency = sanitizeNumber(props.fullTransparency, 1 - fillAlpha, 0, 1),
		Rotation = rotation,
		ScaleType = Enum.ScaleType.Fit,
		ResampleMode = props.resampleMode,
		ZIndex = zIndex + 2,
	}
	applyNativeProps(fullProps, props.nativeFull)

	if props.clipFill == true and fillAlpha < 1 then
		if fillAlpha > 0 then
			children.FillClip = e("Frame", {
				Size = UDim2.fromScale(fillAlpha, 1),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				ClipsDescendants = true,
				ZIndex = zIndex + 2,
			}, {
				Full = e("ImageLabel", {
					Size = UDim2.fromScale(1 / fillAlpha, 1),
					BackgroundTransparency = fullProps.BackgroundTransparency,
					BorderSizePixel = fullProps.BorderSizePixel,
					Image = fullProps.Image,
					ImageColor3 = fullProps.ImageColor3,
					ImageTransparency = sanitizeNumber(props.fullTransparency, 0, 0, 1),
					Rotation = fullProps.Rotation,
					ScaleType = fullProps.ScaleType,
					ResampleMode = fullProps.ResampleMode,
					ZIndex = fullProps.ZIndex,
				}),
			})
		end
	else
		children.Full = e("ImageLabel", fullProps)
	end

	if props.children ~= nil then
		for key, child in props.children do
			children[key] = child
		end
	end

	return e("Frame", frameProps, children)
end
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="781">
                  <Properties>
                    <string name="Name">SegmentMeter</string>
                    <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local React = require(ReplicatedStorage.Packages.React)

export type SegmentState = {
	index: number,
	fillAlpha: number,
	isEmpty: boolean?,
	isFull: boolean?,
	[string]: any,
}

export type SegmentMeterProps = {
	segments: { SegmentState },
	renderSegment: (SegmentState) -> React.ReactNode,
	size: UDim2?,
	position: UDim2?,
	anchorPoint: Vector2?,
	layoutOrder: number?,
	visible: boolean?,
	zIndex: number?,
	segmentHeight: number?,
	padding: UDim?,
	horizontalAlignment: Enum.HorizontalAlignment?,
	active: boolean?,
	onMouseEnter: (() -> ())?,
	onMouseLeave: (() -> ())?,
	children: { React.ReactNode }?,
}

local e: typeof(React.createElement) = React.createElement

return function(props: SegmentMeterProps): React.ReactNode
	local children: { React.ReactNode } = {
		e("UIPadding", {
			PaddingTop = UDim.new(0, 0),
			PaddingBottom = UDim.new(0, 0),
			PaddingLeft = UDim.new(0, 8),
			PaddingRight = UDim.new(0, 8),
		}),
		e("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = props.horizontalAlignment or Enum.HorizontalAlignment.Right,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = props.padding or UDim.new(0, 4),
		}),
	}

	for _, segment in ipairs(props.segments) do
		children[#children + 1] = props.renderSegment(segment)
	end

	if props.children ~= nil then
		for _, child in props.children do
			children[#children + 1] = child
		end
	end

	return e("Frame", {
		Size = props.size or UDim2.fromOffset(0, props.segmentHeight or 30),
		AutomaticSize = Enum.AutomaticSize.X,
		AnchorPoint = props.anchorPoint,
		Position = props.position,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Active = props.active,
		LayoutOrder = props.layoutOrder,
		ZIndex = props.zIndex,
		[React.Event.MouseEnter] = props.onMouseEnter,
		[React.Event.MouseLeave] = props.onMouseLeave,
	}, children)
end
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="782">
                  <Properties>
                    <string name="Name">StackAmountLabel</string>
                    <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local React = require(ReplicatedStorage.Packages.React)

export type StackAmountLabelProps = {
	amount: number?,
	text: string?,
	size: UDim2?,
	position: UDim2?,
	anchorPoint: Vector2?,
	layoutOrder: number?,
	visible: boolean?,
	zIndex: number?,
	font: Enum.Font?,
	textSize: number?,
	textColor3: Color3?,
	textStrokeColor3: Color3?,
	textTransparency: number?,
	textStrokeTransparency: number?,
	textXAlignment: Enum.TextXAlignment?,
	textYAlignment: Enum.TextYAlignment?,
	automaticSize: Enum.AutomaticSize?,
	native: { [any]: any }?,
}

local e: typeof(React.createElement) = React.createElement

return function(props: StackAmountLabelProps): React.ReactNode
	local labelText = props.text
	if labelText == nil and props.amount ~= nil then
		labelText = tostring(props.amount)
	end

	local labelProps: { [any]: any } = {
		Size = props.size or UDim2.fromOffset(0, 0),
		AutomaticSize = props.automaticSize or Enum.AutomaticSize.XY,
		Position = props.position or UDim2.new(1, -6, 1, -5),
		AnchorPoint = props.anchorPoint or Vector2.new(1, 1),
		LayoutOrder = props.layoutOrder,
		Visible = props.visible,
		BackgroundTransparency = 1,
		Text = labelText or "",
		Font = props.font or Enum.Font.GothamBold,
		TextSize = props.textSize or 13,
		TextColor3 = props.textColor3 or Color3.fromRGB(248, 253, 255),
		TextStrokeColor3 = props.textStrokeColor3 or Color3.fromRGB(0, 0, 0),
		TextTransparency = props.textTransparency,
		TextStrokeTransparency = if props.textStrokeTransparency ~= nil then props.textStrokeTransparency else 0.3,
		TextXAlignment = props.textXAlignment or Enum.TextXAlignment.Right,
		TextYAlignment = props.textYAlignment or Enum.TextYAlignment.Bottom,
		ZIndex = props.zIndex,
	}

	if props.native ~= nil then
		for key, value in props.native do
			labelProps[key] = value
		end
	end

	return e("TextLabel", labelProps)
end
]]></string>
