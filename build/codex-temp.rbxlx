              <Item class="Folder" referent="966">
                <Properties>
                  <string name="Name">player</string>
                </Properties>
                <Item class="Folder" referent="967">
                  <Properties>
                    <string name="Name">hooks</string>
                  </Properties>
                  <Item class="ModuleScript" referent="968">
                    <Properties>
                      <string name="Name">useInfoPopUp</string>
                      <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local React = require(ReplicatedStorage.Packages.React)

export type InfoPopUpOptions = {
	enabled: boolean?,
	eventToken: any?,
	riseDuration: number?,
	holdDuration: number?,
	shrinkDuration: number?,
	fromYOffsetStuds: number?,
	toYOffsetStuds: number?,
	minScale: number?,
}

export type InfoPopUpState = {
	progress: number,
	offsetYStuds: number,
	transparency: number,
	scale: number,
	totalDuration: number,
	finished: boolean,
}

local DEFAULT_RISE_DURATION = 0.34
local DEFAULT_HOLD_DURATION = 2.5
local DEFAULT_SHRINK_DURATION = 0.28
local DEFAULT_FROM_Y_OFFSET_STUDS = 0
local DEFAULT_TO_Y_OFFSET_STUDS = 2.7
local DEFAULT_MIN_SCALE = 0.2

local function sanitizeNumber(valueRaw: any, fallback: number, minimum: number?, maximum: number?): number
	if typeof(valueRaw) ~= "number" or valueRaw ~= valueRaw then
		return fallback
	end

	local value = valueRaw
	if minimum ~= nil and value < minimum then
		value = minimum
	end
	if maximum ~= nil and value > maximum then
		value = maximum
	end
	return value
end

local function useInfoPopUp(options: InfoPopUpOptions?): InfoPopUpState
	local enabled = if options ~= nil and options.enabled ~= nil then options.enabled == true else true
	local riseDuration = sanitizeNumber(if options ~= nil then options.riseDuration else nil, DEFAULT_RISE_DURATION, 0.05, 20)
	local holdDuration = sanitizeNumber(if options ~= nil then options.holdDuration else nil, DEFAULT_HOLD_DURATION, 0, 30)
	local shrinkDuration =
		sanitizeNumber(if options ~= nil then options.shrinkDuration else nil, DEFAULT_SHRINK_DURATION, 0.05, 20)
	local fromYOffsetStuds =
		sanitizeNumber(if options ~= nil then options.fromYOffsetStuds else nil, DEFAULT_FROM_Y_OFFSET_STUDS, -100, 100)
	local toYOffsetStuds =
		sanitizeNumber(if options ~= nil then options.toYOffsetStuds else nil, DEFAULT_TO_Y_OFFSET_STUDS, -100, 100)
	local minScale = sanitizeNumber(if options ~= nil then options.minScale else nil, DEFAULT_MIN_SCALE, 0.01, 1)
	local eventToken = if options ~= nil then options.eventToken else nil
	local totalDuration = riseDuration + holdDuration + shrinkDuration

	local elapsedRef = React.useRef(0)
	local progress, setProgress = React.useState(0)

	React.useEffect(function()
		elapsedRef.current = 0
		setProgress(0)
	end, { eventToken, enabled, riseDuration, holdDuration, shrinkDuration, fromYOffsetStuds, toYOffsetStuds, minScale })

	React.useEffect(function()
		if not enabled then
			return nil
		end

		local connection = RunService.RenderStepped:Connect(function(deltaTime: number)
			elapsedRef.current += math.max(0, deltaTime)
			local nextProgress = math.clamp(elapsedRef.current / math.max(0.05, totalDuration), 0, 1)
			setProgress(function(previousProgress: number): number
				if math.abs(previousProgress - nextProgress) <= 1e-4 then
					return previousProgress
				end
				return nextProgress
			end)
		end)

		return function()
			connection:Disconnect()
		end
	end, { enabled, riseDuration, holdDuration, shrinkDuration, eventToken, totalDuration })

	local clampedProgress = math.clamp(progress, 0, 1)
	local elapsed = clampedProgress * totalDuration
	local riseEnd = riseDuration
	local holdEnd = riseDuration + holdDuration

	local offsetYStuds = toYOffsetStuds
	local transparency = 0
	local scale = 1

	if elapsed <= riseEnd then
		local riseAlpha = math.clamp(elapsed / math.max(0.05, riseDuration), 0, 1)
		offsetYStuds = fromYOffsetStuds + (toYOffsetStuds - fromYOffsetStuds) * riseAlpha

		local totalTravel = math.abs(toYOffsetStuds - fromYOffsetStuds)
		local remainingTravel = math.abs(toYOffsetStuds - offsetYStuds)
		transparency = if totalTravel <= 1e-4 then 0 else math.clamp(remainingTravel / totalTravel, 0, 1)
	elseif elapsed <= holdEnd then
		offsetYStuds = toYOffsetStuds
		transparency = 0
		scale = 1
	else
		local shrinkElapsed = elapsed - holdEnd
		local shrinkAlpha = math.clamp(shrinkElapsed / math.max(0.05, shrinkDuration), 0, 1)
		offsetYStuds = toYOffsetStuds
		scale = 1 - (1 - minScale) * shrinkAlpha
		local scaleAlpha = if 1 - minScale <= 1e-4
			then 1
			else math.clamp((scale - minScale) / (1 - minScale), 0, 1)
		transparency = math.clamp(1 - scaleAlpha, 0, 1)
	end

	return {
		progress = clampedProgress,
		offsetYStuds = offsetYStuds,
		transparency = transparency,
		scale = scale,
		totalDuration = totalDuration,
		finished = elapsed >= totalDuration - 1e-4,
	}
end

return useInfoPopUp
]]></string>
                    </Properties>
                  </Item>
                </Item>
                <Item class="Folder" referent="969">
                  <Properties>
                    <string name="Name">screens</string>
                  </Properties>
                  <Item class="ModuleScript" referent="970">
                    <Properties>
                      <string name="Name">infoPlayerScreen</string>
                      <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local DropsInfo = require(script:FindFirstAncestor("game").Client.UI.core.components.DropsInfo)
local PlayerServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.PlayerServiceUtils)
local React = require(ReplicatedStorage.Packages.React)
local infoPlayerSlice = require(script:FindFirstAncestor("game").Client.UI.features.player.state.infoPlayerSlice)
local infoPlayerThunks = require(script:FindFirstAncestor("game").Client.UI.features.player.state.infoPlayerThunks)
local useInfoPopUp = require(script:FindFirstAncestor("game").Client.UI.features.player.hooks.useInfoPopUp)
local useStore = require(script:FindFirstAncestor("game").Client.UI.core.hooks.useStore)

type InfoPlayerState = infoPlayerSlice.InfoPlayerState
type InfoPlayerPopup = infoPlayerSlice.InfoPlayerPopup

type InfoPlayerScreenProps = {
	layoutOrder: number?,
	zIndex: number?,
	visible: boolean?,
}

type PopupEntryProps = {
	localPlayer: Player,
	popup: InfoPlayerPopup,
	index: number,
	zIndex: number,
}

local e: typeof(React.createElement) = React.createElement

local function resolveCharacterRootPart(localPlayer: Player): BasePart?
	local character = localPlayer.Character
	if character == nil then
		return nil
	end

	local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
	if humanoidRootPart ~= nil and humanoidRootPart:IsA("BasePart") then
		return humanoidRootPart
	end

	if character.PrimaryPart ~= nil then
		return character.PrimaryPart
	end

	return character:FindFirstChildWhichIsA("BasePart")
end

local function resolveThemeByPopupKind(kind: infoPlayerSlice.InfoPlayerPopupKind): { [string]: any }
	if kind == "damage_taken" then
		return {
			backgroundColor = Color3.fromRGB(36, 13, 17),
			strokeColor = Color3.fromRGB(255, 91, 108),
			accentColor = Color3.fromRGB(255, 123, 138),
			titleColor = Color3.fromRGB(255, 232, 236),
			subtitleColor = Color3.fromRGB(255, 183, 194),
			descriptionColor = Color3.fromRGB(243, 161, 175),
			amountColor = Color3.fromRGB(255, 246, 247),
		}
	end
	if kind == "damage_dealt" then
		return {
			backgroundColor = Color3.fromRGB(30, 19, 8),
			strokeColor = Color3.fromRGB(255, 172, 72),
			accentColor = Color3.fromRGB(255, 201, 102),
			titleColor = Color3.fromRGB(255, 243, 220),
			subtitleColor = Color3.fromRGB(248, 215, 159),
			descriptionColor = Color3.fromRGB(236, 198, 133),
			amountColor = Color3.fromRGB(255, 250, 240),
		}
	end

	return {
		backgroundColor = Color3.fromRGB(11, 28, 23),
		strokeColor = Color3.fromRGB(93, 224, 186),
		accentColor = Color3.fromRGB(129, 240, 207),
		titleColor = Color3.fromRGB(237, 255, 248),
		subtitleColor = Color3.fromRGB(182, 235, 215),
		descriptionColor = Color3.fromRGB(148, 212, 187),
		amountColor = Color3.fromRGB(244, 255, 250),
	}
end

local function PopupEntry(props: PopupEntryProps): React.ReactNode
	local rootPart = resolveCharacterRootPart(props.localPlayer)

	local popup = props.popup
	local stackOffset = (props.index - 1) * 1.55
	local popupZIndex = props.zIndex + props.index
	local textValue = ""
	local textSize = 28
	if popup.kind == "pickup" then
		textValue = string.format("%s x%d", popup.title, popup.amount)
		textSize = 22
	else
		textValue = tostring(math.max(0, math.floor(popup.amount + 0.5)))
		textSize = 36
	end

	local popUpAnimation = useInfoPopUp({
		enabled = true,
		eventToken = popup.eventToken,
		riseDuration = 0.34,
		holdDuration = 2.5,
		shrinkDuration = 0.3,
		fromYOffsetStuds = 0,
		toYOffsetStuds = 2.8,
		minScale = 0.18,
	})

	local theme = resolveThemeByPopupKind(popup.kind)
	theme.titleTransparency = popUpAnimation.transparency
	local renderedTextSize = math.max(6, math.floor(textSize * popUpAnimation.scale + 0.5))

	local anchorPart, setAnchorPart = React.useState(nil :: BasePart?)
	React.useEffect(function()
		if rootPart == nil then
			setAnchorPart(nil)
			return nil
		end

		local createdAnchor = Instance.new("Part")
		createdAnchor.Name = ("InfoPlayerPopupAnchor_%s"):format(popup.id)
		createdAnchor.Anchored = true
		createdAnchor.CanCollide = false
		createdAnchor.CanTouch = false
		createdAnchor.CanQuery = false
		createdAnchor.CastShadow = false
		createdAnchor.Transparency = 1
		createdAnchor.Size = Vector3.new(0.1, 0.1, 0.1)
		createdAnchor.CFrame = CFrame.new(rootPart.Position)
		createdAnchor.Parent = PlayerServiceUtils.getOrCreateWorkspaceGameFolder()
		setAnchorPart(createdAnchor)

		return function()
			if createdAnchor.Parent ~= nil then
				createdAnchor:Destroy()
			end
			setAnchorPart(function(currentAnchorPart: BasePart?): BasePart?
				if currentAnchorPart == createdAnchor then
					return nil
				end
				return currentAnchorPart
			end)
		end
	end, { rootPart, popup.id })

	local adornee = anchorPart
	if adornee == nil then
		return nil
	end

	return e(DropsInfo, {
		adornee = adornee,
		eventToken = popup.eventToken,
		visible = true,
		enabled = true,
		alwaysOnTop = true,
		zIndex = popupZIndex,
		showIcon = false,
		showAmount = false,
		showRarityPill = false,
		gradientEnabled = false,
		textOnly = true,
		animationEnabled = false,
		title = textValue,
		subtitle = "",
		description = "",
		studsOffset = Vector3.new(0, 3.1 + stackOffset + popUpAnimation.offsetYStuds, 0),
		maxDistance = 150,
		lifetime = popUpAnimation.totalDuration,
		fadeInTime = 0,
		fadeOutTime = 0,
		titleTextSize = renderedTextSize,
		theme = theme,
		onExpire = function()
			infoPlayerSlice.removePopup(popup.id)
		end,
	})
end

local function createPopupElement(
	localPlayer: Player,
	popup: InfoPlayerPopup,
	index: number,
	zIndex: number
): React.ReactNode
	return e(PopupEntry, {
		localPlayer = localPlayer,
		popup = popup,
		index = index,
		zIndex = zIndex,
	})
end

return function(props: InfoPlayerScreenProps?): React.ReactNode
	local resolvedProps: InfoPlayerScreenProps = if props ~= nil then props else {}
	local localPlayer = Players.LocalPlayer
	local infoPlayerState = (useStore(infoPlayerSlice.infoPlayerStateAtom) :: InfoPlayerState?)
		or infoPlayerSlice.infoPlayerStateAtom()

	React.useEffect(function()
		local stop = infoPlayerThunks.start()

		return function()
			stop()
		end
	end, {})

	if resolvedProps.visible == false then
		return nil
	end
	if infoPlayerState.enabled ~= true then
		return nil
	end
	if #infoPlayerState.popups <= 0 then
		return nil
	end

	local zIndex = resolvedProps.zIndex or 180
	local children: { React.ReactNode } = {}
	for index, popup in infoPlayerState.popups do
		children[#children + 1] = createPopupElement(localPlayer, popup, index, zIndex)
	end

	return e(React.Fragment, nil, children)
end
]]></string>
                    </Properties>
                  </Item>
                </Item>
                <Item class="Folder" referent="971">
                  <Properties>
                    <string name="Name">state</string>
                  </Properties>
                  <Item class="ModuleScript" referent="972">
                    <Properties>
                      <string name="Name">infoPlayerSlice</string>
                      <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Charm = require(ReplicatedStorage.Packages.Charm)
local Sift = require(ReplicatedStorage.Packages.Sift)

export type InfoPlayerPopupKind = "pickup" | "damage_dealt" | "damage_taken"

export type InfoPlayerPopup = {
	id: string,
	eventToken: string,
	kind: InfoPlayerPopupKind,
	title: string,
	subtitle: string,
	description: string,
	amount: number,
	amountPrefix: string,
	createdAt: number,
}

export type InfoPlayerState = {
	enabled: boolean,
	popups: { InfoPlayerPopup },
	sequence: number,
	updatedAt: number,
}

export type PushPopupPayload = {
	id: string?,
	kind: InfoPlayerPopupKind?,
	title: string?,
	subtitle: string?,
	description: string?,
	amount: number?,
	amountPrefix: string?,
}

local MAX_POPUP_COUNT = 8

local DEFAULT_STATE: InfoPlayerState = {
	enabled = true,
	popups = {},
	sequence = 0,
	updatedAt = os.clock(),
}

local infoPlayerStateAtom: Charm.Atom<InfoPlayerState> = Charm.atom(DEFAULT_STATE)

local function sanitizePopupKind(valueRaw: any): InfoPlayerPopupKind
	if valueRaw == "pickup" then
		return "pickup"
	end
	if valueRaw == "damage_dealt" then
		return "damage_dealt"
	end
	if valueRaw == "damage_taken" then
		return "damage_taken"
	end
	return "pickup"
end

local function sanitizeString(valueRaw: any, fallback: string): string
	if typeof(valueRaw) ~= "string" then
		return fallback
	end
	local value = string.match(valueRaw, "^%s*(.-)%s*$") or ""
	if value == "" then
		return fallback
	end
	return value
end

local function sanitizeAmount(valueRaw: any): number
	if typeof(valueRaw) ~= "number" or valueRaw ~= valueRaw then
		return 0
	end
	return math.max(0, math.floor(valueRaw + 0.5))
end

local function clonePopups(popupsRaw: { InfoPlayerPopup }): { InfoPlayerPopup }
	return Sift.Array.map(popupsRaw, function(popup: InfoPlayerPopup): InfoPlayerPopup
		return {
			id = popup.id,
			eventToken = popup.eventToken,
			kind = popup.kind,
			title = popup.title,
			subtitle = popup.subtitle,
			description = popup.description,
			amount = popup.amount,
			amountPrefix = popup.amountPrefix,
			createdAt = popup.createdAt,
		}
	end)
end

local function limitPopups(popups: { InfoPlayerPopup }): { InfoPlayerPopup }
	if #popups <= MAX_POPUP_COUNT then
		return popups
	end
	return Sift.Array.slice(popups, 1, MAX_POPUP_COUNT)
end

local function formatWordsFromToken(tokenRaw: string): string
	local compact = string.gsub(tokenRaw, "[%s_%-]+", " ")
	compact = string.gsub(compact, "(%l)(%u)", "%1 %2")
	compact = string.gsub(compact, "^%s*(.-)%s*$", "%1")
	if compact == "" then
		return "Item"
	end
	return (string.gsub(compact, "(%a)([%w_']*)", function(first: string, tail: string): string
		return string.upper(first) .. string.lower(tail)
	end))
end

local function getInfoPlayerState(): InfoPlayerState
	return infoPlayerStateAtom()
end

local function setInfoPlayerState(stateRaw: any): InfoPlayerState
	local current = infoPlayerStateAtom()
	local source = if typeof(stateRaw) == "table" then (stateRaw :: { [string]: any }) else {}
	local enabled = if typeof(source.enabled) == "boolean" then source.enabled else current.enabled
	local sequenceRaw = if typeof(source.sequence) == "number" and source.sequence == source.sequence
		then source.sequence
		else current.sequence
	local nextSequence = math.max(0, math.floor(sequenceRaw))

	local nextPopups = clonePopups(current.popups)
	if typeof(source.popups) == "table" then
		nextPopups = {}
		for _, popupRaw in source.popups do
			if typeof(popupRaw) ~= "table" then
				continue
			end
			local popupSource = popupRaw :: { [string]: any }
			local id = sanitizeString(popupSource.id, ("event_%d"):format(nextSequence + #nextPopups + 1))
			local popupAmount = sanitizeAmount(popupSource.amount)
			nextPopups = Sift.Array.append(nextPopups, {
				id = id,
				eventToken = sanitizeString(popupSource.eventToken, id),
				kind = sanitizePopupKind(popupSource.kind),
				title = sanitizeString(popupSource.title, "Update"),
				subtitle = sanitizeString(popupSource.subtitle, ""),
				description = sanitizeString(popupSource.description, ""),
				amount = popupAmount,
				amountPrefix = sanitizeString(popupSource.amountPrefix, "+"),
				createdAt = if typeof(popupSource.createdAt) == "number" and popupSource.createdAt == popupSource.createdAt
					then popupSource.createdAt
					else os.clock(),
			})
		end
	end

	nextPopups = limitPopups(nextPopups)

	local nextState: InfoPlayerState = {
		enabled = enabled,
		popups = nextPopups,
		sequence = nextSequence,
		updatedAt = os.clock(),
	}
	infoPlayerStateAtom(nextState)
	return nextState
end

local function pushPopup(payloadRaw: any): InfoPlayerPopup?
	local payload = if typeof(payloadRaw) == "table" then (payloadRaw :: { [string]: any }) else {}
	local current = infoPlayerStateAtom()
	if current.enabled ~= true then
		return nil
	end

	local amount = sanitizeAmount(payload.amount)
	if amount <= 0 then
		return nil
	end

	local nextSequence = current.sequence + 1
	local eventId = sanitizeString(payload.id, ("event_%d"):format(nextSequence))
	local popup: InfoPlayerPopup = {
		id = eventId,
		eventToken = ("%s::%d"):format(eventId, nextSequence),
		kind = sanitizePopupKind(payload.kind),
		title = sanitizeString(payload.title, "Update"),
		subtitle = sanitizeString(payload.subtitle, ""),
		description = sanitizeString(payload.description, ""),
		amount = amount,
		amountPrefix = sanitizeString(payload.amountPrefix, "+"),
		createdAt = os.clock(),
	}

	local nextPopups = limitPopups(Sift.Array.prepend(clonePopups(current.popups), popup))

	infoPlayerStateAtom({
		enabled = true,
		popups = nextPopups,
		sequence = nextSequence,
		updatedAt = os.clock(),
	})
	return popup
end

local function pushPickup(itemIdRaw: any, amountRaw: any): InfoPlayerPopup?
	local itemId = sanitizeString(itemIdRaw, "")
	local amount = sanitizeAmount(amountRaw)
	if itemId == "" or amount <= 0 then
		return nil
	end

	local displayName = formatWordsFromToken(itemId)
	return pushPopup({
		kind = "pickup",
		title = displayName,
		subtitle = "Item Picked Up",
		description = itemId,
		amount = amount,
		amountPrefix = "+",
	})
end

local function pushDamageDealt(amountRaw: any): InfoPlayerPopup?
	local amount = sanitizeAmount(amountRaw)
	if amount <= 0 then
		return nil
	end

	return pushPopup({
		kind = "damage_dealt",
		title = "Damage Dealt",
		subtitle = "Target Hit",
		description = "You dealt damage",
		amount = amount,
		amountPrefix = "-",
	})
end

local function pushDamageTaken(amountRaw: any): InfoPlayerPopup?
	local amount = sanitizeAmount(amountRaw)
	if amount <= 0 then
		return nil
	end

	return pushPopup({
		kind = "damage_taken",
		title = "Damage Taken",
		subtitle = "You were hit",
		description = "Incoming damage",
		amount = amount,
		amountPrefix = "-",
	})
end

local function removePopup(popupIdRaw: any): InfoPlayerState
	local popupId = sanitizeString(popupIdRaw, "")
	if popupId == "" then
		return infoPlayerStateAtom()
	end

	local current = infoPlayerStateAtom()
	local nextPopups = Sift.Array.filter(current.popups, function(popup: InfoPlayerPopup): boolean
		return popup.id ~= popupId
	end)

	if #nextPopups == #current.popups then
		return current
	end

	local nextState: InfoPlayerState = {
		enabled = current.enabled,
		popups = nextPopups,
		sequence = current.sequence,
		updatedAt = os.clock(),
	}
	infoPlayerStateAtom(nextState)
	return nextState
end

local function clearPopups(): InfoPlayerState
	local current = infoPlayerStateAtom()
	if #current.popups <= 0 then
		return current
	end

	local nextState: InfoPlayerState = {
		enabled = current.enabled,
		popups = {},
		sequence = current.sequence,
		updatedAt = os.clock(),
	}
	infoPlayerStateAtom(nextState)
	return nextState
end

local function setEnabled(enabledRaw: any): InfoPlayerState
	local enabled = enabledRaw == true
	local current = infoPlayerStateAtom()
	if current.enabled == enabled then
		return current
	end

	local nextState: InfoPlayerState = {
		enabled = enabled,
		popups = if enabled then current.popups else {},
		sequence = current.sequence,
		updatedAt = os.clock(),
	}
	infoPlayerStateAtom(nextState)
	return nextState
end

local function resetInfoPlayerState(): InfoPlayerState
	local nextState: InfoPlayerState = {
		enabled = true,
		popups = {},
		sequence = 0,
		updatedAt = os.clock(),
	}
	infoPlayerStateAtom(nextState)
	return nextState
end

return {
	infoPlayerStateAtom = infoPlayerStateAtom,
	getInfoPlayerState = getInfoPlayerState,
	setInfoPlayerState = setInfoPlayerState,
	pushPopup = pushPopup,
	pushPickup = pushPickup,
	pushDamageDealt = pushDamageDealt,
	pushDamageTaken = pushDamageTaken,
	removePopup = removePopup,
	clearPopups = clearPopups,
	setEnabled = setEnabled,
	resetInfoPlayerState = resetInfoPlayerState,
}
]]></string>
                    </Properties>
                  </Item>
                  <Item class="ModuleScript" referent="973">
                    <Properties>
                      <string name="Name">infoPlayerThunks</string>
                      <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local ConnectionUtils = require(script:FindFirstAncestor("game").Client.UI.core.utils.ConnectionUtils)
local ServiceSync = require(script:FindFirstAncestor("game").Client.UI.core.utils.ServiceSync)
local infoPlayerSlice = require(script:FindFirstAncestor("game").Client.UI.features.player.state.infoPlayerSlice)
local BossServiceClient = require(script:FindFirstAncestor("game").Client.Services.BossServiceClient)
local InventoryServiceClient = require(script:FindFirstAncestor("game").Client.Services.InventoryServiceClient)
local InventoryServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.InventoryServiceUtils)
local HpServiceClient = require(script:FindFirstAncestor("game").Client.Services.HpServiceClient)
local HpServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.HpServiceUtils)
local NpcServiceClient = require(script:FindFirstAncestor("game").Client.Services.NpcServiceClient)

type InfoPlayerState = infoPlayerSlice.InfoPlayerState
type InventoryState = InventoryServiceUtils.InventoryState
type HpServiceState = HpServiceUtils.HpServiceState
type NpcServiceClientState = {
	byId: { [string]: { hp: number } },
	orderedIds: { string },
	updatedAt: number,
}

type BossServiceClientState = {
	byId: { [string]: { hp: number } },
	orderedIds: { string },
	updatedAt: number,
}

local infoPlayerThunks = {}

local DAMAGE_DEALT_INPUT_WINDOW_SECONDS = 1.35

local runtime = {
	started = false,
	localPlayer = nil :: Player?,
	inventoryStateChangedConnection = nil :: RBXScriptConnection?,
	hpStateChangedConnection = nil :: RBXScriptConnection?,
	npcStateChangedConnection = nil :: RBXScriptConnection?,
	bossStateChangedConnection = nil :: RBXScriptConnection?,
	inputBeganConnection = nil :: RBXScriptConnection?,
	previousInventoryCounts = {} :: { [string]: number },
	previousHp = nil :: number?,
	previousHpUpdatedAt = nil :: number?,
	previousNpcHpById = {} :: { [string]: number },
	previousBossHpById = {} :: { [string]: number },
	hasPrimedInventory = false,
	hasPrimedHp = false,
	hasPrimedNpc = false,
	hasPrimedBoss = false,
	lastCombatIntentAt = -math.huge,
}

local function sanitizeCount(valueRaw: any): number
	if typeof(valueRaw) ~= "number" or valueRaw ~= valueRaw then
		return 0
	end
	return math.max(0, math.floor(valueRaw + 0.5))
end

local function buildInventoryCounts(stateRaw: any): { [string]: number }
	local counts: { [string]: number } = {}
	if typeof(stateRaw) ~= "table" then
		return counts
	end
	local slotsRaw = (stateRaw :: any).slots
	if typeof(slotsRaw) ~= "table" then
		return counts
	end

	for _, slotRaw in slotsRaw do
		if typeof(slotRaw) ~= "table" then
			continue
		end
		local stackRaw = (slotRaw :: any).stack
		if typeof(stackRaw) ~= "table" then
			continue
		end
		local itemIdRaw = (stackRaw :: any).itemId
		local amountRaw = (stackRaw :: any).amount
		if typeof(itemIdRaw) ~= "string" or itemIdRaw == "" then
			continue
		end
		local amount = sanitizeCount(amountRaw)
		if amount <= 0 then
			continue
		end
		counts[itemIdRaw] = (counts[itemIdRaw] or 0) + amount
	end

	return counts
end

local function buildNpcHpMap(stateRaw: any): { [string]: number }
	local output: { [string]: number } = {}
	if typeof(stateRaw) ~= "table" then
		return output
	end
	local byIdRaw = (stateRaw :: any).byId
	if typeof(byIdRaw) ~= "table" then
		return output
	end

	for runtimeIdRaw, snapshotRaw in byIdRaw do
		if typeof(runtimeIdRaw) ~= "string" or runtimeIdRaw == "" then
			continue
		end
		if typeof(snapshotRaw) ~= "table" then
			continue
		end
		local hp = sanitizeCount((snapshotRaw :: any).hp)
		output[runtimeIdRaw] = hp
	end

	return output
end

local function buildBossHpMap(stateRaw: any): { [string]: number }
	local output: { [string]: number } = {}
	if typeof(stateRaw) ~= "table" then
		return output
	end
	local byIdRaw = (stateRaw :: any).byId
	if typeof(byIdRaw) ~= "table" then
		return output
	end

	for runtimeIdRaw, snapshotRaw in byIdRaw do
		if typeof(runtimeIdRaw) ~= "string" or runtimeIdRaw == "" then
			continue
		end
		if typeof(snapshotRaw) ~= "table" then
			continue
		end
		local hp = sanitizeCount((snapshotRaw :: any).hp)
		output[runtimeIdRaw] = hp
	end

	return output
end

local function isCombatIntentInput(inputObject: InputObject): boolean
	if inputObject.UserInputType == Enum.UserInputType.MouseButton1 then
		return true
	end
	if inputObject.UserInputType == Enum.UserInputType.Touch then
		return true
	end
	if inputObject.KeyCode == Enum.KeyCode.ButtonR2 then
		return true
	end
	return false
end

local function onInventoryStateChanged(nextStateRaw: any)
	local fallback = InventoryServiceUtils.createDefaultState(InventoryServiceUtils.LOAD_STATE_UNLOADED)
	local nextState = InventoryServiceUtils.sanitizeState(nextStateRaw, fallback)
	if not InventoryServiceUtils.isLoadedState(nextState.loadState) then
		runtime.previousInventoryCounts = {}
		runtime.hasPrimedInventory = false
		return
	end

	local nextCounts = buildInventoryCounts(nextState)
	if not runtime.hasPrimedInventory then
		runtime.hasPrimedInventory = true
		runtime.previousInventoryCounts = nextCounts
		return
	end

	for itemId, nextAmount in nextCounts do
		local previousAmount = runtime.previousInventoryCounts[itemId] or 0
		local delta = nextAmount - previousAmount
		if delta > 0 then
			infoPlayerSlice.pushPickup(itemId, delta)
		end
	end

	runtime.previousInventoryCounts = nextCounts
end

local function onHpStateChanged(nextStateRaw: any)
	local fallback = HpServiceUtils.createDefaultState()
	local nextState = HpServiceUtils.sanitizeState(nextStateRaw, fallback)

	if not runtime.hasPrimedHp then
		runtime.hasPrimedHp = true
		runtime.previousHp = nextState.health
		runtime.previousHpUpdatedAt = nextState.updatedAt
		return
	end

	local previousHp = if runtime.previousHp ~= nil then runtime.previousHp else nextState.health
	if nextState.isAlive == false or nextState.health <= 0 then
		runtime.previousHp = nextState.health
		runtime.previousHpUpdatedAt = nextState.updatedAt
		return
	end

	local deltaDamage = math.max(0, previousHp - nextState.health)
	local previousUpdatedAt = if runtime.previousHpUpdatedAt ~= nil then runtime.previousHpUpdatedAt else -math.huge
	local explicitDamage = if nextState.updatedAt > previousUpdatedAt then math.max(0, nextState.lastDamage) else 0
	local damageTaken = math.max(deltaDamage, explicitDamage)
	if damageTaken > 0 then
		infoPlayerSlice.pushDamageTaken(damageTaken)
	end

	runtime.previousHp = nextState.health
	runtime.previousHpUpdatedAt = nextState.updatedAt
end

local function onNpcStateChanged(nextStateRaw: any)
	local nextState = if typeof(nextStateRaw) == "table" then (nextStateRaw :: NpcServiceClientState) else nil
	if nextState == nil then
		return
	end

	local nextHpById = buildNpcHpMap(nextState)
	if not runtime.hasPrimedNpc then
		runtime.hasPrimedNpc = true
		runtime.previousNpcHpById = nextHpById
		return
	end

	local totalDealt = 0
	for runtimeId, nextHp in nextHpById do
		local previousHp = runtime.previousNpcHpById[runtimeId]
		if previousHp ~= nil and previousHp > nextHp then
			totalDealt += math.max(0, previousHp - nextHp)
		end
	end

	if totalDealt > 0 then
		local now = os.clock()
		if now - runtime.lastCombatIntentAt <= DAMAGE_DEALT_INPUT_WINDOW_SECONDS then
			infoPlayerSlice.pushDamageDealt(totalDealt)
		end
	end

	runtime.previousNpcHpById = nextHpById
end

local function onBossStateChanged(nextStateRaw: any)
	local nextState = if typeof(nextStateRaw) == "table" then (nextStateRaw :: BossServiceClientState) else nil
	if nextState == nil then
		return
	end

	local nextHpById = buildBossHpMap(nextState)
	if not runtime.hasPrimedBoss then
		runtime.hasPrimedBoss = true
		runtime.previousBossHpById = nextHpById
		return
	end

	local totalDealt = 0
	for runtimeId, nextHp in nextHpById do
		local previousHp = runtime.previousBossHpById[runtimeId]
		if previousHp ~= nil and previousHp > nextHp then
			totalDealt += math.max(0, previousHp - nextHp)
		end
	end

	if totalDealt > 0 then
		local now = os.clock()
		if now - runtime.lastCombatIntentAt <= DAMAGE_DEALT_INPUT_WINDOW_SECONDS then
			infoPlayerSlice.pushDamageDealt(totalDealt)
		end
	end

	runtime.previousBossHpById = nextHpById
end

local function syncFromServices()
	if InventoryServiceClient.getState ~= nil then
		local inventoryOk, inventoryStateOrError = pcall(function()
			return InventoryServiceClient:getState()
		end)
		if inventoryOk then
			onInventoryStateChanged(inventoryStateOrError)
		end
	end

	if HpServiceClient.getState ~= nil then
		local shouldReadHp = true
		if HpServiceClient.isReady ~= nil then
			local readyOk, isReady = pcall(function()
				return HpServiceClient:isReady()
			end)
			if not readyOk or not isReady then
				shouldReadHp = false
			end
		end

		if shouldReadHp then
			local hpOk, hpStateOrError = pcall(function()
				return HpServiceClient:getState()
			end)
			if hpOk then
				onHpStateChanged(hpStateOrError)
			end
		end
	end

	if NpcServiceClient.getState ~= nil then
		local npcOk, npcStateOrError = pcall(function()
			return NpcServiceClient:getState()
		end)
		if npcOk then
			onNpcStateChanged(npcStateOrError)
		end
	end

	if BossServiceClient.getState ~= nil then
		local bossOk, bossStateOrError = pcall(function()
			return BossServiceClient:getState()
		end)
		if bossOk then
			onBossStateChanged(bossStateOrError)
		end
	end
end

function infoPlayerThunks.Start(): () -> ()
	if runtime.started then
		return infoPlayerThunks.Stop
	end

	runtime.started = true
	runtime.localPlayer = Players.LocalPlayer
	runtime.previousInventoryCounts = {}
	runtime.previousNpcHpById = {}
	runtime.previousBossHpById = {}
	runtime.previousHp = nil
	runtime.previousHpUpdatedAt = nil
	runtime.hasPrimedInventory = false
	runtime.hasPrimedHp = false
	runtime.hasPrimedNpc = false
	runtime.hasPrimedBoss = false
	runtime.lastCombatIntentAt = -math.huge

	runtime.inventoryStateChangedConnection =
		ServiceSync.connectStateChanged(InventoryServiceClient, function(nextState: InventoryState)
			onInventoryStateChanged(nextState)
		end)

	runtime.hpStateChangedConnection = ServiceSync.connectStateChanged(HpServiceClient, function(nextState: HpServiceState)
		onHpStateChanged(nextState)
	end)

	runtime.npcStateChangedConnection = ServiceSync.connectStateChanged(NpcServiceClient, function(nextState: NpcServiceClientState)
		onNpcStateChanged(nextState)
	end)

	runtime.bossStateChangedConnection =
		ServiceSync.connectStateChanged(BossServiceClient, function(nextState: BossServiceClientState)
			onBossStateChanged(nextState)
		end)

	runtime.inputBeganConnection = UserInputService.InputBegan:Connect(function(inputObject: InputObject, gameProcessed: boolean)
		if gameProcessed then
			return
		end
		if UserInputService:GetFocusedTextBox() ~= nil then
			return
		end
		if isCombatIntentInput(inputObject) then
			runtime.lastCombatIntentAt = os.clock()
		end
	end)

	syncFromServices()

	ServiceSync.requestSyncMany({
		InventoryServiceClient,
		HpServiceClient,
		NpcServiceClient,
		BossServiceClient,
	})

	return infoPlayerThunks.Stop
end

function infoPlayerThunks.Stop()
	ConnectionUtils.disconnectMany({
		runtime.inventoryStateChangedConnection,
		runtime.hpStateChangedConnection,
		runtime.npcStateChangedConnection,
		runtime.bossStateChangedConnection,
		runtime.inputBeganConnection,
	})
	runtime.inventoryStateChangedConnection = nil
	runtime.hpStateChangedConnection = nil
	runtime.npcStateChangedConnection = nil
	runtime.bossStateChangedConnection = nil
	runtime.inputBeganConnection = nil

	runtime.started = false
	runtime.localPlayer = nil
	runtime.previousInventoryCounts = {}
	runtime.previousNpcHpById = {}
	runtime.previousBossHpById = {}
	runtime.previousHp = nil
	runtime.previousHpUpdatedAt = nil
	runtime.hasPrimedInventory = false
	runtime.hasPrimedHp = false
	runtime.hasPrimedNpc = false
	runtime.hasPrimedBoss = false
	runtime.lastCombatIntentAt = -math.huge
	infoPlayerSlice.resetInfoPlayerState()
end

function infoPlayerThunks.GetInfoPlayerState(): InfoPlayerState
	return infoPlayerSlice.getInfoPlayerState()
end

infoPlayerThunks.start = infoPlayerThunks.Start
infoPlayerThunks.stop = infoPlayerThunks.Stop
infoPlayerThunks.getInfoPlayerState = infoPlayerThunks.GetInfoPlayerState

return infoPlayerThunks
]]></string>
                    </Properties>
                  </Item>
                </Item>
              </Item>
            </Item>
            <Item class="ModuleScript" referent="974">
              <Properties>
                <string name="Name">hud</string>
                <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local BottomBar = require(script:FindFirstAncestor("game").Client.UI.hud.BottomBar)
local LeftSideBar = require(script:FindFirstAncestor("game").Client.UI.hud.LeftSideBar)
local React = require(ReplicatedStorage.Packages.React)
local RightSideBar = require(script:FindFirstAncestor("game").Client.UI.hud.RightSideBar)
local TopBar = require(script:FindFirstAncestor("game").Client.UI.hud.TopBar)

local e: typeof(React.createElement) = React.createElement

type HudBarOrders = {
	top: number?,
	left: number?,
	right: number?,
	bottom: number?,
}

type HudProps = {
	layoutOrder: number?,
	zIndex: number?,
	visible: boolean?,
	barOrders: HudBarOrders?,
	navigateEvent: BindableEvent?,
	topButtons: { any }?,
	bottomButtons: { any }?,
	leftButtons: { any }?,
	rightButtons: { any }?,
	hpBarProps: { [string]: any }?,
	manaBarProps: { [string]: any }?,
	breathBarProps: { [string]: any }?,
	inventoryHotbarProps: { [string]: any }?,
	onNavigate: ((barName: string, payload: any, inputObject: InputObject?, button: any) -> ())?,
}

local DEFAULT_BAR_ORDERS: HudBarOrders = {
	top = 1,
	left = 2,
	right = 3,
	bottom = 4,
}

return function(props: HudProps)
	local barOrders = props.barOrders or DEFAULT_BAR_ORDERS
	local baseZIndex = props.zIndex or 10

	return e("Frame", {
		Size = UDim2.fromScale(1, 1),
		Position = UDim2.fromScale(0, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Active = false,
		Selectable = false,
		LayoutOrder = props.layoutOrder or 1,
		ZIndex = baseZIndex,
		Visible = props.visible ~= false,
	}, {
		e(TopBar, {
			layoutOrder = barOrders.top or DEFAULT_BAR_ORDERS.top,
			zIndex = baseZIndex + 1,
			buttons = props.topButtons,
			hpBarProps = props.hpBarProps,
			navigateEvent = props.navigateEvent,
			onButtonActivated = function(payload: any, inputObject: InputObject?, button: any)
				if props.onNavigate then
					props.onNavigate("TopBar", payload, inputObject, button)
				end
			end,
		}),
		e(LeftSideBar, {
			layoutOrder = barOrders.left or DEFAULT_BAR_ORDERS.left,
			zIndex = baseZIndex + 1,
			buttons = props.leftButtons,
			navigateEvent = props.navigateEvent,
			inventoryHotbarProps = props.inventoryHotbarProps,
			onButtonActivated = function(payload: any, inputObject: InputObject?, button: any)
				if props.onNavigate then
					props.onNavigate("LeftSideBar", payload, inputObject, button)
				end
			end,
		}),
		e(RightSideBar, {
			layoutOrder = barOrders.right or DEFAULT_BAR_ORDERS.right,
			zIndex = baseZIndex + 1,
			buttons = props.rightButtons,
			navigateEvent = props.navigateEvent,
			manaBarProps = props.manaBarProps,
			breathBarProps = props.breathBarProps,
			onButtonActivated = function(payload: any, inputObject: InputObject?, button: any)
				if props.onNavigate then
					props.onNavigate("RightSideBar", payload, inputObject, button)
				end
			end,
		}),
		e(BottomBar, {
			layoutOrder = barOrders.bottom or DEFAULT_BAR_ORDERS.bottom,
			zIndex = baseZIndex + 1,
			buttons = props.bottomButtons,
			navigateEvent = props.navigateEvent,
			onButtonActivated = function(payload: any, inputObject: InputObject?, button: any)
				if props.onNavigate then
					props.onNavigate("BottomBar", payload, inputObject, button)
				end
			end,
		}),
	})
end
]]></string>
              </Properties>
              <Item class="ModuleScript" referent="975">
                <Properties>
                  <string name="Name">BottomBar</string>
                  <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local NavButton = require(script:FindFirstAncestor("game").Client.UI.core.components.NavButton)
local React = require(ReplicatedStorage.Packages.React)
local Responsive = require(script:FindFirstAncestor("game").Client.UI.core.hooks.useViewportScale)

local e: typeof(React.createElement) = React.createElement

type BottomBarButton = {
	key: string?,
	id: string?,
	route: string?,
	label: string?,
	icon: string?,
	layoutOrder: number?,
	visible: boolean?,
	selected: boolean?,
	disabled: boolean?,
	size: UDim2?,
	textSize: number?,
	font: Enum.Font?,
	onActivated: ((payload: any, inputObject: InputObject?) -> ())?,
	navigateEvent: BindableEvent?,
}

type BottomBarProps = {
	layoutOrder: number?,
	visible: boolean?,
	zIndex: number?,
	size: UDim2?,
	position: UDim2?,
	anchorPoint: Vector2?,
	padding: UDim?,
	buttons: { BottomBarButton }?,
	navigateEvent: BindableEvent?,
	onButtonActivated: ((payload: any, inputObject: InputObject?, button: BottomBarButton) -> ())?,
}

return function(props: BottomBarProps)
	local responsive = Responsive.useResponsiveMetrics()
	local hudTokens = responsive.tokens.hud
	local buttons = props.buttons or {}
	local zIndex = props.zIndex or 10
	local children = {
		e("UIPadding", {
			PaddingTop = UDim.new(0, 6),
			PaddingBottom = UDim.new(0, 6),
			PaddingLeft = UDim.new(0, 8),
			PaddingRight = UDim.new(0, 8),
		}),
		e("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			Padding = props.padding or UDim.new(0, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	}

	for index, button in ipairs(buttons) do
		children[#children + 1] = e(NavButton, {
			id = button.id,
			route = button.route,
			label = button.label,
			icon = button.icon,
			size = button.size or UDim2.fromOffset(hudTokens.navButtonWidth, hudTokens.navButtonHeight),
			layoutOrder = button.layoutOrder or index,
			visible = button.visible,
			selected = button.selected,
			disabled = button.disabled,
			textSize = button.textSize or hudTokens.navButtonTextSize,
			font = button.font,
			zIndex = zIndex + 1,
			navigateEvent = button.navigateEvent or props.navigateEvent,
			onActivated = function(payload: any, inputObject: InputObject?)
				if button.onActivated then
					button.onActivated(payload, inputObject)
				end

				if props.onButtonActivated then
					props.onButtonActivated(payload, inputObject, button)
				end
			end,
		})
	end

	return e("Frame", {
		Size = props.size or UDim2.new(1, 0, 0, hudTokens.bottomBarHeight + responsive.safeArea.bottom),
		Position = props.position or UDim2.fromScale(0.5, 1),
		AnchorPoint = props.anchorPoint or Vector2.new(0.5, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Active = false,
		Selectable = false,
		LayoutOrder = props.layoutOrder or 4,
		ZIndex = zIndex,
		Visible = props.visible ~= false,
	}, {
		e("Frame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Active = false,
			Selectable = false,
			ZIndex = zIndex,
		}, {
			e("UIPadding", {
				PaddingTop = UDim.new(0, 0),
				PaddingBottom = UDim.new(0, responsive.safeArea.bottom),
				PaddingLeft = UDim.new(0, responsive.safeArea.left),
				PaddingRight = UDim.new(0, responsive.safeArea.right),
			}),
			e("Frame", {
				Size = UDim2.fromScale(1, 1),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Active = false,
				Selectable = false,
				ZIndex = zIndex,
			}, children),
		}),
	})
end
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="976">
                <Properties>
                  <string name="Name">LeftSideBar</string>
                  <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local HotbarLeftSideBar = require(script.HotbarLeftSideBar)
local NavButton = require(script:FindFirstAncestor("game").Client.UI.core.components.NavButton)
local React = require(ReplicatedStorage.Packages.React)
local Responsive = require(script:FindFirstAncestor("game").Client.UI.core.hooks.useViewportScale)
local inventorySlice = require(script:FindFirstAncestor("game").Client.UI.hud.state.slice.inventorySlice)
local useStore = require(script:FindFirstAncestor("game").Client.UI.core.hooks.useStore)

local e: typeof(React.createElement) = React.createElement

type InventoryHudState = inventorySlice.InventoryHudState

type LeftSideBarButton = {
	key: string?,
	id: string?,
	route: string?,
	label: string?,
	icon: string?,
	layoutOrder: number?,
	visible: boolean?,
	selected: boolean?,
	disabled: boolean?,
	size: UDim2?,
	textSize: number?,
	font: Enum.Font?,
	onActivated: ((payload: any, inputObject: InputObject?) -> ())?,
	navigateEvent: BindableEvent?,
}

type LeftSideBarProps = {
	layoutOrder: number?,
	visible: boolean?,
	zIndex: number?,
	size: UDim2?,
	position: UDim2?,
	anchorPoint: Vector2?,
	padding: UDim?,
	buttons: { LeftSideBarButton }?,
	navigateEvent: BindableEvent?,
	inventoryHotbarProps: { [string]: any }?,
	onButtonActivated: ((payload: any, inputObject: InputObject?, button: LeftSideBarButton) -> ())?,
}

return function(props: LeftSideBarProps)
	local responsive = Responsive.useResponsiveMetrics()
	local hudTokens = responsive.tokens.hud
	local inventoryTokens = responsive.tokens.inventory
	local inventoryHudState = (useStore(inventorySlice.inventoryHudStateAtom) :: InventoryHudState?)
		or inventorySlice.getInventoryHudState()
	local buttons = props.buttons or {}
	local zIndex = props.zIndex or 10
	local buttonListChildren = {
		e("UIPadding", {
			PaddingTop = UDim.new(0, 8),
			PaddingBottom = UDim.new(0, 8),
			PaddingLeft = UDim.new(0, 8),
			PaddingRight = UDim.new(0, 8),
		}),
		e("UIListLayout", {
			FillDirection = Enum.FillDirection.Vertical,
			HorizontalAlignment = Enum.HorizontalAlignment.Left,
			VerticalAlignment = Enum.VerticalAlignment.Top,
			Padding = props.padding or UDim.new(0, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	}

	for index, button in ipairs(buttons) do
		buttonListChildren[#buttonListChildren + 1] = e(NavButton, {
			id = button.id,
			route = button.route,
			label = button.label,
			icon = button.icon,
			size = button.size or UDim2.fromOffset(hudTokens.sideButtonWidth, hudTokens.navButtonHeight),
			layoutOrder = button.layoutOrder or index,
			visible = button.visible,
			selected = button.selected,
			disabled = button.disabled,
			textSize = button.textSize or hudTokens.navButtonTextSize,
			font = button.font,
			zIndex = zIndex + 1,
			navigateEvent = button.navigateEvent or props.navigateEvent,
			onActivated = function(payload: any, inputObject: InputObject?)
				if button.onActivated then
					button.onActivated(payload, inputObject)
				end

				if props.onButtonActivated then
					props.onButtonActivated(payload, inputObject, button)
				end
			end,
		})
	end

	local inventoryHotbarProps = {
		layoutOrder = 6,
		zIndex = zIndex + 1,
		position = UDim2.new(0, inventoryTokens.leftPadding, 0.5, 0),
		anchorPoint = Vector2.new(0, 0.5),
		slotSize = UDim2.fromOffset(inventoryTokens.slotSize, inventoryTokens.slotSize),
		slotPadding = UDim.new(0, inventoryTokens.slotGap),
		showKeyHints = not responsive.isCompactHud,
	}
	if props.inventoryHotbarProps ~= nil then
		for key, value in pairs(props.inventoryHotbarProps) do
			inventoryHotbarProps[key] = value
		end
	end

	return e("Frame", {
		Size = props.size or UDim2.new(0, hudTokens.sideBarWidth + responsive.safeArea.left, 1, 0),
		Position = props.position or UDim2.fromScale(0, 0.5),
		AnchorPoint = props.anchorPoint or Vector2.new(0, 0.5),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Active = false,
		Selectable = false,
		LayoutOrder = props.layoutOrder or 2,
		ZIndex = zIndex,
		Visible = props.visible ~= false and inventoryHudState.isLeftSideBarVisible,
	}, {
		e("Frame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Active = false,
			Selectable = false,
			ZIndex = zIndex,
		}, {
			e("UIPadding", {
				PaddingTop = UDim.new(0, responsive.safeArea.top + hudTokens.sideBarVerticalPadding),
				PaddingBottom = UDim.new(0, responsive.safeArea.bottom + hudTokens.sideBarVerticalPadding),
				PaddingLeft = UDim.new(0, responsive.safeArea.left),
				PaddingRight = UDim.new(0, 0),
			}),
			e("Frame", {
				Size = UDim2.fromScale(1, 1),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Active = false,
				Selectable = false,
				ZIndex = zIndex,
			}, buttonListChildren),
			e(HotbarLeftSideBar, inventoryHotbarProps),
		}),
	})
end
]]></string>
                </Properties>
                <Item class="ModuleScript" referent="977">
                  <Properties>
                    <string name="Name">HotbarLeftSideBar</string>
                    <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local Sift = require(ReplicatedStorage.Packages.Sift)

local CoinScreen = require(script:FindFirstAncestor("game").Client.UI.features.inventory.screens.coinScreen)
local HotbarRow = require(script:FindFirstAncestor("game").Client.UI.features.inventory.components.HotbarRow)
local HotbarSlot = require(script:FindFirstAncestor("game").Client.UI.features.inventory.components.HotbarSlot)
local ImageIds = require(script:FindFirstAncestor("game").Client.UI.core.ImageIds)
local InventoryGrid = require(script:FindFirstAncestor("game").Client.UI.features.inventory.components.InventoryGrid)
local InventoryServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.InventoryServiceUtils)
local InventorySlotComponent =
	require(script:FindFirstAncestor("game").Client.UI.features.inventory.components.InventorySlot)
local ItemScreen = require(script:FindFirstAncestor("game").Client.UI.features.item.screen.itemScreen)
local LeftSideBarButtons = require(script.Parent.LeftSideBarButtons)
local React = require(ReplicatedStorage.Packages.React)
local Responsive = require(script:FindFirstAncestor("game").Client.UI.core.hooks.useViewportScale)
local TrashScreen = require(script:FindFirstAncestor("game").Client.UI.features.inventory.screens.trashScreen)
local UiSound = require(script:FindFirstAncestor("game").Client.UI.core.utils.UiSound)
local hudInventorySlice = require(script:FindFirstAncestor("game").Client.UI.hud.state.slice.inventorySlice)
local hudInventoryThunks = require(script:FindFirstAncestor("game").Client.UI.hud.state.slice.inventoryThunks)
local infoThunks = require(script:FindFirstAncestor("game").Client.UI.features.info.state.infoThunks)
local inventorySlice = hudInventorySlice
local inventoryThunks = hudInventoryThunks
local itemSlice = require(script:FindFirstAncestor("game").Client.UI.features.item.state.itemSlice)
local itemThunks = require(script:FindFirstAncestor("game").Client.UI.features.item.state.itemThunks)
local trashThunks = require(script:FindFirstAncestor("game").Client.UI.features.inventory.state.trashThunks)
local useCoinEmerge = require(script:FindFirstAncestor("game").Client.UI.features.inventory.hooks.useCoinEmerge)
local useDrag = require(script:FindFirstAncestor("game").Client.UI.features.item.hooks.useDrag)
local useInterval = require(script:FindFirstAncestor("game").Client.UI.core.hooks.useInterval)
local useInventorySlide = require(script:FindFirstAncestor("game").Client.UI.features.inventory.hooks.useInventorySlide)
local useSlotSelect = require(script:FindFirstAncestor("game").Client.UI.features.inventory.hooks.useSlotSelect)
local useStore = require(script:FindFirstAncestor("game").Client.UI.core.hooks.useStore)
local useToggle = require(script:FindFirstAncestor("game").Client.UI.shared.useToggle)
local useTrashAppear = require(script:FindFirstAncestor("game").Client.UI.features.inventory.hooks.useTrashAppear)

type InventoryState = InventoryServiceUtils.InventoryState
type InventorySlot = InventoryServiceUtils.InventorySlot
type InventoryItemStack = InventoryServiceUtils.InventoryItemStack
type ItemDragState = itemSlice.ItemDragState
type InventoryHudState = hudInventorySlice.InventoryHudState

type InventoryHotbarProps = {
	layoutOrder: number?,
	visible: boolean?,
	zIndex: number?,
	slotSize: UDim2?,
	position: UDim2?,
	anchorPoint: Vector2?,
	slotPadding: UDim?,
	showKeyHints: boolean?,
}

local e: typeof(React.createElement) = React.createElement

local HOTBAR_SLOT_COUNT = 8
local HOTBAR_CONTROL_BUTTON_COUNT = 2
local INVENTORY_COLUMNS = 8
local INVENTORY_ROWS = 8
local INVENTORY_MAX_SLOTS = INVENTORY_COLUMNS * INVENTORY_ROWS
local GRID_SLOT_START_INDEX = HOTBAR_SLOT_COUNT + 1
local TOTAL_VISIBLE_SLOTS = HOTBAR_SLOT_COUNT + INVENTORY_MAX_SLOTS
local HOTBAR_SLOT_SELECTED_SCALE = 1.12
local SLOT_HOVER_ID_PREFIX = "inventory_slot_"
local EMPTY_SLOT_TINT = Color3.fromRGB(152, 160, 172)
local FILLED_SLOT_TINT = Color3.fromRGB(255, 255, 255)
local SELECTED_SLOT_TINT = Color3.fromRGB(142, 220, 255)
local DISABLED_SLOT_TINT = Color3.fromRGB(100, 108, 120)
local EXPANSION_VISIBILITY_EPSILON = 0.001
local TRASH_VISIBILITY_EPSILON = 0.001
type HoveredSlotSource = "Hotbar" | "Grid"
local GAMEPAD_INVENTORY_TOGGLE_KEY = Enum.KeyCode.ButtonY
local GAMEPAD_DROP_TRASH_KEY = Enum.KeyCode.ButtonX
local GAMEPAD_HOTBAR_PREVIOUS_KEY = Enum.KeyCode.ButtonL1
local GAMEPAD_HOTBAR_NEXT_KEY = Enum.KeyCode.ButtonR1
local KEYCODE_TO_SLOT_INDEX: { [Enum.KeyCode]: number } = {
	[Enum.KeyCode.One] = 1,
	[Enum.KeyCode.Two] = 2,
	[Enum.KeyCode.Three] = 3,
	[Enum.KeyCode.Four] = 4,
	[Enum.KeyCode.Five] = 5,
	[Enum.KeyCode.Six] = 6,
	[Enum.KeyCode.Seven] = 7,
	[Enum.KeyCode.Eight] = 8,
}

local DEFAULT_RENDER_INVENTORY_STATE =
	InventoryServiceUtils.createDefaultState(InventoryServiceUtils.LOAD_STATE_LOADING)

local function snapToPixel(value: number): number
	return math.floor(value + 0.5)
end

local function playUiHoverSound()
	UiSound.playHover()
end

local function playUiPressSound()
	UiSound.playPress()
end

local function sanitizeRenderState(stateRaw: any): InventoryState
	return InventoryServiceUtils.sanitizeState(stateRaw, DEFAULT_RENDER_INVENTORY_STATE)
end

local function resolveSlot(stateRaw: any, slotIndexRaw: any): InventorySlot
	local slotIndex = if typeof(slotIndexRaw) == "number" and slotIndexRaw == slotIndexRaw
		then math.max(1, math.floor(slotIndexRaw))
		else 1
	local state = sanitizeRenderState(stateRaw)
	local slot = InventoryServiceUtils.getSlot(state, slotIndex)
	if slot == nil or typeof(slot) ~= "table" then
		return {
			index = slotIndex,
			stack = nil,
		}
	end

	local stackRaw = (slot :: any).stack
	local stack = if typeof(stackRaw) == "table" then stackRaw :: InventoryItemStack else nil
	local indexRaw = (slot :: any).index
	local index = if typeof(indexRaw) == "number" and indexRaw == indexRaw
		then math.max(1, math.floor(indexRaw))
		else slotIndex
	return {
		index = index,
		stack = stack,
	}
end

local function resolveStackAmount(stackRaw: any): number
	if typeof(stackRaw) ~= "table" then
		return 0
	end
	local amountRaw = (stackRaw :: any).amount
	if typeof(amountRaw) ~= "number" or amountRaw ~= amountRaw then
		return 0
	end
	return math.max(0, math.floor(amountRaw))
end

local function resolveStackIcon(stackRaw: any): string?
	if typeof(stackRaw) ~= "table" then
		return nil
	end
	local success, icon = pcall(function()
		return itemThunks.resolveIconForStack(stackRaw :: InventoryItemStack)
	end)
	if not success then
		return nil
	end
	if typeof(icon) == "string" then
		return icon
	end
	return nil
end

local function resolveSlotHoverText(slot: InventorySlot): string
	local stack = slot.stack
	if typeof(stack) ~= "table" then
		return ("Slot %d\nEmpty"):format(slot.index)
	end

	local success, hoverText = pcall(function()
		return itemThunks.resolveHoverTextForStack(stack :: InventoryItemStack, slot.index)
	end)
	if success and typeof(hoverText) == "string" then
		return hoverText
	end
	return ("Slot %d\nEmpty"):format(slot.index)
end

local function cloneStackWithAmount(stack: InventoryItemStack, amount: number): InventoryItemStack
	return {
		stackId = stack.stackId,
		itemId = stack.itemId,
		amount = amount,
		maxStack = stack.maxStack,
		metadata = InventoryServiceUtils.cloneDeep(stack.metadata),
	}
end

local function resolveDisplayedStackForSlot(slot: InventorySlot, dragState: ItemDragState): InventoryItemStack?
	local stack = slot.stack
	if stack == nil then
		return nil
	end
	if not dragState.active or dragState.mode ~= "SplitHold" then
		return stack
	end
	if dragState.sourceSlot ~= slot.index then
		return stack
	end
	if dragState.stack == nil or dragState.sourceStackAmount == nil then
		return stack
	end
	if dragState.stack.stackId ~= stack.stackId then
		return stack
	end

	local remainingAmount = math.max(0, dragState.sourceStackAmount - dragState.stack.amount)
	if remainingAmount <= 0 then
		return nil
	end
	if remainingAmount == stack.amount then
		return stack
	end
	return cloneStackWithAmount(stack, remainingAmount)
end

local function selectSlot(slotIndex: number, currentlySelectedSlot: number?)
	if currentlySelectedSlot == slotIndex then
		inventoryThunks.clearSelectedSlot()
	else
		inventoryThunks.selectSlot(slotIndex)
	end
end

local function resolveColumnRevealProgress(progress: number, columnIndex: number, totalColumns: number): number
	local clampedProgress = math.clamp(progress, 0, 1)
	local start = (columnIndex - 1) / totalColumns
	local finish = columnIndex / totalColumns
	local span = math.max(0.0001, finish - start)
	return math.clamp((clampedProgress - start) / span, 0, 1)
end

local function lerpNumber(from: number, to: number, alpha: number): number
	return from + (to - from) * alpha
end

local function lerpVector2(from: Vector2, to: Vector2, alpha: number): Vector2
	return Vector2.new(lerpNumber(from.X, to.X, alpha), lerpNumber(from.Y, to.Y, alpha))
end

local function resolveLoadingInventoryText(dotCountRaw: number): string
	local dotCount = math.clamp(math.floor(dotCountRaw), 1, 3)
	return "Loading inventory" .. string.rep(".", dotCount)
end

local function isGamepadInputType(inputTypeRaw: any): boolean
	if typeof(inputTypeRaw) ~= "EnumItem" then
		return false
	end
	return string.sub((inputTypeRaw :: Enum.UserInputType).Name, 1, 7) == "Gamepad"
end

local function resolveHotbarSelectionSlot(stateRaw: any): number
	local state = sanitizeRenderState(stateRaw)
	local selectedSlot = state.selectedSlot
	if typeof(selectedSlot) == "number" and selectedSlot == selectedSlot then
		selectedSlot = math.floor(selectedSlot)
	else
		selectedSlot = nil
	end
	if selectedSlot == nil or selectedSlot < 1 or selectedSlot > HOTBAR_SLOT_COUNT then
		return 1
	end
	return selectedSlot
end

local function cycleHotbarSelection(stepRaw: any)
	local step = if typeof(stepRaw) == "number"
			and stepRaw == stepRaw
			and stepRaw ~= 0
		then if stepRaw < 0 then -1 else 1
		else nil
	if step == nil then
		return false
	end
	local currentState = inventorySlice.getInventoryState()
	local nextSelectedSlot = ((resolveHotbarSelectionSlot(currentState) - 1 + step) % HOTBAR_SLOT_COUNT) + 1
	return inventoryThunks.selectSlot(nextSelectedSlot)
end

local function handleSelectedSlotDropOrTrash(isInventoryExpandedRaw: any): boolean
	local currentState = sanitizeRenderState(inventorySlice.getInventoryState())
	if not InventoryServiceUtils.isLoadedState(currentState.loadState) then
		return false
	end

	local selectedSlot = currentState.selectedSlot
	if typeof(selectedSlot) ~= "number" or selectedSlot ~= selectedSlot then
		return false
	end
	selectedSlot = math.floor(selectedSlot)
	if selectedSlot < 1 then
		return false
	end

	local slot = resolveSlot(currentState, selectedSlot)
	if slot.stack == nil then
		return false
	end

	if isInventoryExpandedRaw == true and trashThunks.trashSelected(nil) then
		return true
	end

	return inventoryThunks.dropFromSlot(selectedSlot, nil)
end

return function(props: InventoryHotbarProps)
	local responsive = Responsive.useResponsiveMetrics()
	local inventoryTokens = responsive.tokens.inventory
	local inventoryState = (useStore(inventorySlice.inventoryStateAtom) :: InventoryState?)
		or inventorySlice.inventoryStateAtom()
	local renderState = sanitizeRenderState(inventoryState)
	local isInventoryStateInitialized = typeof(renderState.slots) == "table"
		and #renderState.slots >= math.max(1, renderState.capacity)
	local hoveredSlotIndex, setHoveredSlotIndex = React.useState(nil :: number?)
	local hoveredSlotSource, setHoveredSlotSource = React.useState(nil :: HoveredSlotSource?)
	local isExpandButtonPressed = useToggle(false)
	local inventoryHudState = (useStore(hudInventorySlice.inventoryHudStateAtom) :: InventoryHudState?)
		or hudInventorySlice.getInventoryHudState()
	local isInventoryExpanded = inventoryHudState.isHotbarExpanded
	local loadingDotCount, setLoadingDotCount = React.useState(1)
	local drag = useDrag({
		hoveredSlotIndex = hoveredSlotIndex,
	})

	local expansionProgress = useInventorySlide({
		enabled = isInventoryExpanded,
	})

	React.useEffect(function()
		local stop = inventoryThunks.start()

		return function()
			stop()
		end
	end, {})

	React.useEffect(function()
		if props.visible == false then
			return
		end

		local function onInputBegan(inputObject: InputObject, gameProcessed: boolean)
			if gameProcessed then
				return
			end
			if UserInputService:GetFocusedTextBox() ~= nil then
				return
			end
			if not isInventoryStateInitialized then
				return
			end
			if not InventoryServiceUtils.isLoadedState(renderState.loadState) then
				return
			end

			if inputObject.UserInputType == Enum.UserInputType.Keyboard then
				local selectedFromKey = KEYCODE_TO_SLOT_INDEX[inputObject.KeyCode]
				if selectedFromKey == nil then
					return
				end

				inventoryThunks.selectSlot(selectedFromKey)
				return
			end

			if not isGamepadInputType(inputObject.UserInputType) then
				return
			end

			if inputObject.KeyCode == GAMEPAD_INVENTORY_TOGGLE_KEY then
				playUiPressSound()
				hudInventoryThunks.toggleInventory()
				return
			end

			if inputObject.KeyCode == GAMEPAD_DROP_TRASH_KEY then
				handleSelectedSlotDropOrTrash(isInventoryExpanded)
				return
			end

			if inputObject.KeyCode == GAMEPAD_HOTBAR_PREVIOUS_KEY then
				cycleHotbarSelection(-1)
				return
			end

			if inputObject.KeyCode == GAMEPAD_HOTBAR_NEXT_KEY then
				cycleHotbarSelection(1)
			end
		end

		local function onInputChanged(inputObject: InputObject)
			if inputObject.UserInputType ~= Enum.UserInputType.MouseWheel then
				return
			end
			if UserInputService:GetFocusedTextBox() ~= nil then
				return
			end
			if not isInventoryStateInitialized then
				return
			end
			if not InventoryServiceUtils.isLoadedState(renderState.loadState) then
				return
			end

			local wheelDelta = inputObject.Position.Z
			if wheelDelta == 0 then
				return
			end

			local currentState = inventorySlice.getInventoryState()
			local currentSelectedSlot = currentState.selectedSlot
			if currentSelectedSlot == nil or currentSelectedSlot < 1 or currentSelectedSlot > HOTBAR_SLOT_COUNT then
				currentSelectedSlot = 1
			end

			local step = if wheelDelta > 0 then -1 else 1
			local nextSelectedSlot = ((currentSelectedSlot - 1 + step) % HOTBAR_SLOT_COUNT) + 1
			inventoryThunks.selectSlot(nextSelectedSlot)
		end

		local beganConnection = UserInputService.InputBegan:Connect(onInputBegan)
		local changedConnection = UserInputService.InputChanged:Connect(onInputChanged)

		return function()
			beganConnection:Disconnect()
			changedConnection:Disconnect()
		end
	end, {
		props.visible,
		renderState.loadState,
		isInventoryStateInitialized,
		isInventoryExpanded,
	})

	React.useEffect(function()
		if not isInventoryStateInitialized then
			return
		end
		local currentInteractiveLimit = math.min(renderState.capacity, TOTAL_VISIBLE_SLOTS)
		if hoveredSlotIndex == nil then
			return
		end
		if hoveredSlotSource == nil then
			return
		end
		if hoveredSlotIndex < 1 or hoveredSlotIndex > currentInteractiveLimit then
			return
		end

		local hoveredSlot = resolveSlot(renderState, hoveredSlotIndex)
		hoveredSlot = {
			index = hoveredSlot.index,
			stack = resolveDisplayedStackForSlot(hoveredSlot, drag.dragState),
		}
		infoThunks.showHover({
			id = SLOT_HOVER_ID_PREFIX .. tostring(hoveredSlotIndex),
			text = resolveSlotHoverText(hoveredSlot),
		})
	end, {
		hoveredSlotIndex,
		hoveredSlotSource,
		renderState.updatedAt,
		renderState.capacity,
		isInventoryStateInitialized,
		drag.dragState.updatedAt,
	})

	React.useEffect(function()
		return function()
			infoThunks.hideHover(nil)
		end
	end, {})

	local isLoading = not InventoryServiceUtils.isLoadedState(renderState.loadState)
		and renderState.loadState ~= InventoryServiceUtils.LOAD_STATE_FAILED
	useInterval(
		function()
			setLoadingDotCount(function(currentDotCount: number): number
				return (currentDotCount % 3) + 1
			end)
		end,
		0.4,
		{
			enabled = isLoading,
		}
	)

	React.useEffect(function()
		if not isLoading then
			setLoadingDotCount(1)
		end
	end, { isLoading })

	local zIndex = props.zIndex or 30
	local selectedSlot = renderState.selectedSlot
	local rawSlotSize = props.slotSize or UDim2.fromOffset(inventoryTokens.slotSize, inventoryTokens.slotSize)
	local slotWidth = snapToPixel(rawSlotSize.X.Offset)
	local slotHeight = snapToPixel(rawSlotSize.Y.Offset)
	local hotbarSlotSize = UDim2.fromOffset(slotWidth, slotHeight)
	local hotbarGap = snapToPixel(if props.slotPadding then props.slotPadding.Offset else inventoryTokens.slotGap)
	local hotbarWidth = slotWidth
	local hotbarSlotsHeight = slotHeight * HOTBAR_SLOT_COUNT + hotbarGap * (HOTBAR_SLOT_COUNT - 1)
	local hotbarSidebarHeight = slotHeight * (HOTBAR_SLOT_COUNT + HOTBAR_CONTROL_BUTTON_COUNT)
		+ hotbarGap * (HOTBAR_SLOT_COUNT + HOTBAR_CONTROL_BUTTON_COUNT - 1)

	local gridSlotSize = hotbarSlotSize
	local gridGap = hotbarGap
	local gridWidth = slotWidth * INVENTORY_COLUMNS + gridGap * (INVENTORY_COLUMNS - 1)
	local gridContainerWidth = gridWidth
	local gridContainerHeight = hotbarSlotsHeight
	local coinEmerge = useCoinEmerge({
		enabled = isInventoryExpanded,
		fromOffset = Vector2.new(-(gridContainerWidth + gridGap), 0),
		toOffset = Vector2.zero,
	})
	local trashAppear = useTrashAppear({
		enabled = isInventoryExpanded,
		fromOffset = Vector2.new(-(hotbarSlotSize.X.Offset * 0.65), 0),
		toOffset = Vector2.zero,
	})
	local showExpandedGrid = isInventoryExpanded or expansionProgress > EXPANSION_VISIBILITY_EPSILON
	local showRevealOverlay = showExpandedGrid and expansionProgress < (1 - EXPANSION_VISIBILITY_EPSILON)
	local showTrashScreen = isInventoryExpanded or trashAppear.progress > TRASH_VISIBILITY_EPSILON
	local maxInteractiveSlots = if isInventoryStateInitialized
		then math.min(renderState.capacity, TOTAL_VISIBLE_SLOTS)
		else 0

	React.useEffect(function()
		if showExpandedGrid then
			return
		end
		if hoveredSlotSource ~= "Grid" then
			return
		end

		setHoveredSlotSource(nil)
		setHoveredSlotIndex(nil)
		infoThunks.hideHover(nil)
	end, { showExpandedGrid, hoveredSlotSource })

	local leftPadding = inventoryTokens.leftPadding
	local expanderSize = hotbarSlotSize
	local rawHotbarPosition = props.position or UDim2.new(0, leftPadding, 0.5, 0)
	local hotbarPosition = UDim2.new(
		rawHotbarPosition.X.Scale,
		snapToPixel(rawHotbarPosition.X.Offset),
		rawHotbarPosition.Y.Scale,
		snapToPixel(rawHotbarPosition.Y.Offset)
	)
	local hotbarAnchorPoint = props.anchorPoint or Vector2.new(0, 0.5)
	local inventoryPanelPosition = UDim2.new(
		hotbarPosition.X.Scale,
		snapToPixel(hotbarPosition.X.Offset + hotbarWidth + gridGap),
		hotbarPosition.Y.Scale,
		snapToPixel(hotbarPosition.Y.Offset)
	)
	local inventoryPanelAnchorPoint = Vector2.new(0, hotbarAnchorPoint.Y)
	local inventoryTopOffset = -gridContainerHeight * hotbarAnchorPoint.Y
	local expanderPosition = UDim2.new(
		hotbarPosition.X.Scale,
		snapToPixel(hotbarPosition.X.Offset),
		hotbarPosition.Y.Scale,
		snapToPixel(hotbarPosition.Y.Offset + hotbarSlotsHeight * (1 - hotbarAnchorPoint.Y) + hotbarGap)
	)
	local trashPosition = UDim2.new(
		expanderPosition.X.Scale,
		snapToPixel(expanderPosition.X.Offset + expanderSize.X.Offset + hotbarGap),
		expanderPosition.Y.Scale,
		snapToPixel(expanderPosition.Y.Offset)
	)
	local hotbarSidebarPosition = UDim2.new(
		hotbarPosition.X.Scale,
		snapToPixel(hotbarPosition.X.Offset),
		hotbarPosition.Y.Scale,
		snapToPixel(hotbarPosition.Y.Offset + hotbarAnchorPoint.Y * (hotbarSidebarHeight - hotbarSlotsHeight))
	)
	local hotbarSlotScales: { number } = Sift.Array.create(HOTBAR_SLOT_COUNT)

	for hotbarIndex = 1, HOTBAR_SLOT_COUNT do
		local isSlotAvailable = isInventoryStateInitialized and hotbarIndex <= maxInteractiveSlots
		local isSelected = selectedSlot == hotbarIndex
		local isHovered = hoveredSlotSource == "Hotbar" and hoveredSlotIndex == hotbarIndex
		hotbarSlotScales[hotbarIndex] = useSlotSelect({
			enabled = isSlotAvailable and (isSelected or isHovered),
			selectedScale = HOTBAR_SLOT_SELECTED_SCALE,
		})
	end

	local hotbarChildren: { React.ReactNode } = {}

	for hotbarIndex = 1, HOTBAR_SLOT_COUNT do
		local slot = resolveSlot(renderState, hotbarIndex)
		local displayStack = resolveDisplayedStackForSlot(slot, drag.dragState)
		local isSlotAvailable = isInventoryStateInitialized and hotbarIndex <= maxInteractiveSlots
		local hasItem = isSlotAvailable and typeof(displayStack) == "table"
		local isSelected = selectedSlot == hotbarIndex
		local isSplitPreviewSource = drag.dragState.active
			and drag.dragState.mode == "SplitHold"
			and drag.dragState.sourceSlot == hotbarIndex
		local isDragSourceSlot = drag.isDragging and drag.dragSourceSlot == hotbarIndex and not isSplitPreviewSource
		local hasVisibleItem = hasItem and not isDragSourceSlot
		local showKeyHints = props.showKeyHints ~= false and not responsive.isCompactHud
		local isHovered = hoveredSlotSource == "Hotbar" and hoveredSlotIndex == hotbarIndex
		local slotScale = hotbarSlotScales[hotbarIndex]
		local isExpanded = slotScale > 1.001
		local slotTint = if isSelected
			then SELECTED_SLOT_TINT
			else if hasVisibleItem then FILLED_SLOT_TINT else EMPTY_SLOT_TINT
		local slotImage = if isSelected or isHovered then ImageIds.inventorySlotHovered else ImageIds.inventorySlot
		local slotZIndex = if isExpanded then zIndex + 3 else zIndex + 2
		local itemAmount = if hasVisibleItem then resolveStackAmount(displayStack) else 0
		local itemIcon = if hasVisibleItem then resolveStackIcon(displayStack) else nil

		hotbarChildren[#hotbarChildren + 1] = e(HotbarSlot, {
			index = hotbarIndex,
			size = hotbarSlotSize,
			image = slotImage,
			tint = slotTint,
			zIndex = slotZIndex,
			active = isSlotAvailable,
			selectable = isSlotAvailable,
			scale = slotScale,
			showKeyHint = showKeyHints,
			itemIcon = itemIcon,
			itemAmount = itemAmount,
			onMouseEnter = function()
				setHoveredSlotSource("Hotbar")
				setHoveredSlotIndex(hotbarIndex)
				playUiHoverSound()
			end,
			onMouseLeave = function()
				setHoveredSlotSource(nil)
				setHoveredSlotIndex(nil)
				infoThunks.hideHover(SLOT_HOVER_ID_PREFIX .. tostring(hotbarIndex))
			end,
			onSecondaryInput = function()
				if not isSlotAvailable then
					return
				end
				if UserInputService:GetFocusedTextBox() ~= nil then
					return
				end
				drag.handleSlotSecondaryInput(hotbarIndex, if typeof(slot.stack) == "table" then slot.stack else nil)
			end,
			onInputBegan = function(_: GuiObject, inputObject: InputObject)
				if not isSlotAvailable then
					return
				end
				local userInputType = inputObject.UserInputType
				if userInputType ~= Enum.UserInputType.MouseButton1 and userInputType ~= Enum.UserInputType.Touch then
					return
				end
				drag.handleSlotInput(
					hotbarIndex,
					if typeof(slot.stack) == "table" then slot.stack else nil,
					inputObject
				)
			end,
			onActivated = function()
				if not isSlotAvailable then
					return
				end
				if drag.isDragging or drag.shouldSuppressActivation(hotbarIndex) then
					return
				end
				if not isInventoryStateInitialized then
					return
				end
				if not InventoryServiceUtils.isLoadedState(renderState.loadState) then
					return
				end
				selectSlot(hotbarIndex, selectedSlot)
			end,
		})
	end

	hotbarChildren[#hotbarChildren + 1] = e(LeftSideBarButtons.ExpandInventoryButton, {
		size = expanderSize,
		iconSize = expanderSize,
		iconColor3 = Color3.new(1, 1, 1),
		padding = UDim.new(0, 0),
		cornerRadius = UDim.new(0, 0),
		backgroundTransparency = 1,
		strokeTransparency = 1,
		zIndex = zIndex + 4,
		layoutOrder = HOTBAR_SLOT_COUNT + 1,
		isPressed = isExpandButtonPressed.value,
		onPressedChanged = function(isPressedValue: boolean)
			isExpandButtonPressed.set(isPressedValue)
		end,
		onHoverChanged = function(isHovered: boolean)
			if isHovered then
				playUiHoverSound()
			end
		end,
		onActivated = function()
			playUiPressSound()
		end,
	})

	hotbarChildren[#hotbarChildren + 1] = e(LeftSideBarButtons.CraftingButton, {
		layoutOrder = HOTBAR_SLOT_COUNT + 2,
		size = expanderSize,
		zIndex = zIndex + 4,
	})

	local gridChildren: { React.ReactNode } = {}
	local gridStepX = gridSlotSize.X.Offset + gridGap
	local gridStepY = gridSlotSize.Y.Offset + gridGap
	local hotbarOriginOffsetX = -(hotbarWidth + gridGap)

	for slotIndex = 1, INVENTORY_MAX_SLOTS do
		local inventorySlotIndex = GRID_SLOT_START_INDEX + slotIndex - 1
		local slot = resolveSlot(renderState, inventorySlotIndex)
		local displayStack = resolveDisplayedStackForSlot(slot, drag.dragState)
		local isSlotAvailable = isInventoryStateInitialized and inventorySlotIndex <= maxInteractiveSlots
		local hasItem = isSlotAvailable and typeof(displayStack) == "table"
		local isSelected = isSlotAvailable and selectedSlot == inventorySlotIndex
		local isSplitPreviewSource = drag.dragState.active
			and drag.dragState.mode == "SplitHold"
			and drag.dragState.sourceSlot == inventorySlotIndex
		local isDragSourceSlot = drag.isDragging
			and drag.dragSourceSlot == inventorySlotIndex
			and not isSplitPreviewSource
		local hasVisibleItem = hasItem and not isDragSourceSlot
		local isHovered = hoveredSlotSource == "Grid" and hoveredSlotIndex == inventorySlotIndex
		local rowIndex = math.floor((slotIndex - 1) / INVENTORY_COLUMNS)
		local columnIndex = ((slotIndex - 1) % INVENTORY_COLUMNS) + 1
		local columnRevealProgress = resolveColumnRevealProgress(expansionProgress, columnIndex, INVENTORY_COLUMNS)
		local columnRevealTransparency = 1 - columnRevealProgress
		local finalSlotOffset = Vector2.new((columnIndex - 1) * gridStepX, rowIndex * gridStepY)
		local startSlotOffset = Vector2.new(hotbarOriginOffsetX, finalSlotOffset.Y)
		local currentSlotOffset = lerpVector2(startSlotOffset, finalSlotOffset, columnRevealProgress)
		local slotTint = if not isSlotAvailable
			then DISABLED_SLOT_TINT
			else if isSelected
				then SELECTED_SLOT_TINT
				else if hasVisibleItem then FILLED_SLOT_TINT else EMPTY_SLOT_TINT
		local slotImage = if isSelected or isHovered then ImageIds.inventorySlotHovered else ImageIds.inventorySlot
		local itemAmount = if hasVisibleItem then resolveStackAmount(displayStack) else 0
		local slotZIndex = zIndex + 3
		local slotBaseTransparency = if isSlotAvailable then 0 else 0.15
		local slotTransparency =
			math.clamp(slotBaseTransparency + columnRevealTransparency * (1 - slotBaseTransparency), 0, 1)
		local itemIcon = if hasVisibleItem then resolveStackIcon(displayStack) else nil
		local isGridSlotInteractable = isSlotAvailable and columnRevealProgress >= (1 - EXPANSION_VISIBILITY_EPSILON)

		gridChildren[#gridChildren + 1] = e(InventorySlotComponent, {
			layoutOrder = slotIndex,
			size = gridSlotSize,
			position = UDim2.fromOffset(snapToPixel(currentSlotOffset.X), snapToPixel(currentSlotOffset.Y)),
			image = slotImage,
			tint = slotTint,
			imageTransparency = slotTransparency,
			zIndex = slotZIndex,
			active = isGridSlotInteractable,
			selectable = isGridSlotInteractable,
			itemIcon = itemIcon,
			itemAmount = itemAmount,
			itemTransparency = columnRevealTransparency,
			stackTextTransparency = columnRevealTransparency,
			stackStrokeTransparency = math.clamp(0.3 + columnRevealTransparency * 0.7, 0, 1),
			selectedStrokeTransparency = if isSelected
				then math.clamp(0.15 + columnRevealTransparency * 0.85, 0, 1)
				else nil,
			onMouseEnter = function()
				if not isGridSlotInteractable then
					return
				end
				setHoveredSlotSource("Grid")
				setHoveredSlotIndex(inventorySlotIndex)
				playUiHoverSound()
			end,
			onMouseLeave = function()
				if isGridSlotInteractable then
					setHoveredSlotSource(nil)
					setHoveredSlotIndex(nil)
					infoThunks.hideHover(SLOT_HOVER_ID_PREFIX .. tostring(inventorySlotIndex))
				end
			end,
			onSecondaryInput = function()
				if not isGridSlotInteractable then
					return
				end
				if UserInputService:GetFocusedTextBox() ~= nil then
					return
				end
				drag.handleSlotSecondaryInput(
					inventorySlotIndex,
					if typeof(slot.stack) == "table" then slot.stack else nil
				)
			end,
			onInputBegan = function(_: GuiObject, inputObject: InputObject)
				if not isGridSlotInteractable then
					return
				end
				local userInputType = inputObject.UserInputType
				if userInputType ~= Enum.UserInputType.MouseButton1 and userInputType ~= Enum.UserInputType.Touch then
					return
				end
				drag.handleSlotInput(
					inventorySlotIndex,
					if typeof(slot.stack) == "table" then slot.stack else nil,
					inputObject
				)
			end,
			onActivated = function()
				if not isGridSlotInteractable then
					return
				end
				if drag.isDragging or drag.shouldSuppressActivation(inventorySlotIndex) then
					return
				end
				if not isInventoryStateInitialized then
					return
				end
				if not InventoryServiceUtils.isLoadedState(renderState.loadState) then
					return
				end
				selectSlot(inventorySlotIndex, selectedSlot)
			end,
		})
	end

	local rootChildren: { React.ReactNode } = {
		e(HotbarRow, {
			size = UDim2.fromOffset(hotbarWidth, hotbarSidebarHeight),
			position = hotbarSidebarPosition,
			anchorPoint = hotbarAnchorPoint,
			zIndex = zIndex + 1,
			gap = hotbarGap,
			children = hotbarChildren,
		}),
		e(TrashScreen, {
			layoutOrder = 3,
			visible = showTrashScreen,
			zIndex = zIndex + 7,
			position = trashPosition,
			anchorPoint = Vector2.new(0, 0),
			size = expanderSize,
			emergeOffset = trashAppear.offset,
			emergeTransparency = trashAppear.transparency,
		}),
	}

	if showExpandedGrid then
		rootChildren[#rootChildren + 1] = e(InventoryGrid, {
			size = UDim2.fromOffset(gridContainerWidth, gridContainerHeight),
			position = inventoryPanelPosition,
			anchorPoint = inventoryPanelAnchorPoint,
			zIndex = zIndex + 1,
			showRevealOverlay = showRevealOverlay,
			revealOverlayZIndex = zIndex + 6,
			children = gridChildren,
			extraChildren = {
				e(CoinScreen, {
					layoutOrder = 2,
					visible = showExpandedGrid,
					zIndex = zIndex + 7,
					position = UDim2.new(1, 0, 1, hotbarGap),
					anchorPoint = Vector2.new(1, 0),
					slotSize = gridSlotSize,
					emergeOffset = coinEmerge.offset,
					emergeTransparency = coinEmerge.transparency,
				}),
			},
		})
	end

	rootChildren[#rootChildren + 1] = if not InventoryServiceUtils.isLoadedState(renderState.loadState)
		then e("TextLabel", {
			Size = UDim2.fromOffset(0, 18),
			AutomaticSize = Enum.AutomaticSize.X,
			Position = UDim2.new(
				hotbarPosition.X.Scale,
				snapToPixel(hotbarPosition.X.Offset),
				hotbarPosition.Y.Scale,
				snapToPixel(hotbarPosition.Y.Offset + inventoryTopOffset - 6)
			),
			AnchorPoint = Vector2.new(0, 1),
			BackgroundTransparency = 1,
			Text = if renderState.loadState == InventoryServiceUtils.LOAD_STATE_FAILED
				then "Inventory unavailable"
				else resolveLoadingInventoryText(loadingDotCount),
			Font = Enum.Font.GothamMedium,
			TextSize = 12,
			TextColor3 = Color3.fromRGB(240, 242, 255),
			TextStrokeTransparency = 0.5,
			ZIndex = zIndex + 6,
		})
		else nil
	rootChildren[#rootChildren + 1] = e(ItemScreen, {
		layoutOrder = 99,
		visible = props.visible ~= false,
		zIndex = zIndex + 120,
	})

	return e("Frame", {
		Size = UDim2.fromScale(1, 1),
		Position = UDim2.fromScale(0, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		LayoutOrder = props.layoutOrder or 6,
		ZIndex = zIndex,
		Visible = props.visible ~= false,
		Active = false,
	}, rootChildren)
end
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="978">
                  <Properties>
                    <string name="Name">LeftSideBarButtons</string>
                    <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CraftingButton = require(script:FindFirstAncestor("game").Client.UI.features.crafting.components.craftingButton)
local ImageIds = require(script:FindFirstAncestor("game").Client.UI.core.ImageIds)
local NavButton = require(script:FindFirstAncestor("game").Client.UI.core.components.NavButton)
local React = require(ReplicatedStorage.Packages.React)
local craftingSlice = require(script:FindFirstAncestor("game").Client.UI.features.crafting.state.craftingSlice)
local craftingThunks = require(script:FindFirstAncestor("game").Client.UI.features.crafting.state.craftingThunks)
local hudInventorySlice = require(script:FindFirstAncestor("game").Client.UI.hud.state.slice.inventorySlice)
local hudInventoryThunks = require(script:FindFirstAncestor("game").Client.UI.hud.state.slice.inventoryThunks)
local useStore = require(script:FindFirstAncestor("game").Client.UI.core.hooks.useStore)

type CraftingState = craftingSlice.CraftingState
type InventoryHudState = hudInventorySlice.InventoryHudState

type AttachedButtonProps = {
	layoutOrder: number?,
	visible: boolean?,
	zIndex: number?,
	size: UDim2?,
	position: UDim2?,
	anchorPoint: Vector2?,
}

type ExpandInventoryButtonProps = AttachedButtonProps & {
	iconSize: UDim2?,
	iconColor3: Color3?,
	padding: UDim?,
	cornerRadius: UDim?,
	backgroundTransparency: number?,
	strokeTransparency: number?,
	isPressed: boolean?,
	onPressedChanged: ((boolean) -> ())?,
	onHoverChanged: ((boolean) -> ())?,
	onActivated: (() -> ())?,
}

local e: typeof(React.createElement) = React.createElement

local function ExpandInventoryButton(props: ExpandInventoryButtonProps): React.ReactNode
	local inventoryHudState = (useStore(hudInventorySlice.inventoryHudStateAtom) :: InventoryHudState?)
		or hudInventorySlice.getInventoryHudState()
	local isExpanded = inventoryHudState.isHotbarExpanded

	return e(NavButton, {
		id = "InventoryExpander",
		label = nil,
		icon = if props.isPressed == true or isExpanded
			then ImageIds.expandInventoryPressed
			else ImageIds.expandInventory,
		size = props.size,
		position = props.position,
		anchorPoint = props.anchorPoint,
		iconSize = props.iconSize or props.size,
		iconColor3 = props.iconColor3,
		padding = props.padding,
		cornerRadius = props.cornerRadius,
		backgroundTransparency = props.backgroundTransparency,
		strokeTransparency = props.strokeTransparency,
		zIndex = props.zIndex,
		layoutOrder = props.layoutOrder,
		visible = props.visible,
		selected = isExpanded,
		onPressedChanged = props.onPressedChanged,
		onHoverChanged = props.onHoverChanged,
		onActivated = function()
			hudInventoryThunks.toggleInventory()
			if props.onActivated ~= nil then
				props.onActivated()
			end
		end,
	})
end

local function CraftingHudButton(props: AttachedButtonProps): React.ReactNode
	local craftingState = (useStore(craftingSlice.craftingStateAtom) :: CraftingState?)
		or craftingSlice.getCraftingState()

	React.useEffect(function()
		local stop = craftingThunks.start()

		return function()
			stop()
		end
	end, {})

	return e(CraftingButton, {
		layoutOrder = props.layoutOrder,
		visible = props.visible,
		zIndex = props.zIndex,
		size = props.size,
		position = props.position,
		anchorPoint = props.anchorPoint,
		selected = craftingState.visible,
		onActivated = function()
			hudInventoryThunks.toggleCrafting()
		end,
	})
end

return {
	ExpandInventoryButton = ExpandInventoryButton,
	CraftingButton = CraftingHudButton,
}
]]></string>
                  </Properties>
                </Item>
              </Item>
              <Item class="ModuleScript" referent="979">
                <Properties>
                  <string name="Name">RightSideBar</string>
                  <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local BubblesScreen = require(script:FindFirstAncestor("game").Client.UI.features.breath.screens.bubblesScreen)
local ManaTopRightBar = require(script:FindFirstAncestor("game").Client.UI.hud.TopBar.ManaTopRightBar)
local NavButton = require(script:FindFirstAncestor("game").Client.UI.core.components.NavButton)
local React = require(ReplicatedStorage.Packages.React)
local Responsive = require(script:FindFirstAncestor("game").Client.UI.core.hooks.useViewportScale)

local e: typeof(React.createElement) = React.createElement

type RightSideBarButton = {
	key: string?,
	id: string?,
	route: string?,
	label: string?,
	icon: string?,
	layoutOrder: number?,
	visible: boolean?,
	selected: boolean?,
	disabled: boolean?,
	size: UDim2?,
	textSize: number?,
	font: Enum.Font?,
	onActivated: ((payload: any, inputObject: InputObject?) -> ())?,
	navigateEvent: BindableEvent?,
}

type RightSideBarProps = {
	layoutOrder: number?,
	visible: boolean?,
	zIndex: number?,
	size: UDim2?,
	position: UDim2?,
	anchorPoint: Vector2?,
	padding: UDim?,
	buttons: { RightSideBarButton }?,
	navigateEvent: BindableEvent?,
	manaBarProps: { [string]: any }?,
	breathBarProps: { [string]: any }?,
	onButtonActivated: ((payload: any, inputObject: InputObject?, button: RightSideBarButton) -> ())?,
}

return function(props: RightSideBarProps)
	local responsive = Responsive.useResponsiveMetrics()
	local hudTokens = responsive.tokens.hud
	local meterTokens = responsive.tokens.meter
	local buttons = props.buttons or {}
	local zIndex = props.zIndex or 10
	local buttonListChildren = {
		e("UIPadding", {
			PaddingTop = UDim.new(0, 8),
			PaddingBottom = UDim.new(0, 8),
			PaddingLeft = UDim.new(0, 8),
			PaddingRight = UDim.new(0, 8),
		}),
		e("UIListLayout", {
			FillDirection = Enum.FillDirection.Vertical,
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
			VerticalAlignment = Enum.VerticalAlignment.Top,
			Padding = props.padding or UDim.new(0, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	}

	for index, button in ipairs(buttons) do
		buttonListChildren[#buttonListChildren + 1] = e(NavButton, {
			id = button.id,
			route = button.route,
			label = button.label,
			icon = button.icon,
			size = button.size or UDim2.fromOffset(hudTokens.sideButtonWidth, hudTokens.navButtonHeight),
			layoutOrder = button.layoutOrder or index,
			visible = button.visible,
			selected = button.selected,
			disabled = button.disabled,
			textSize = button.textSize or hudTokens.navButtonTextSize,
			font = button.font,
			zIndex = zIndex + 1,
			navigateEvent = button.navigateEvent or props.navigateEvent,
			onActivated = function(payload: any, inputObject: InputObject?)
				if button.onActivated then
					button.onActivated(payload, inputObject)
				end

				if props.onButtonActivated then
					props.onButtonActivated(payload, inputObject, button)
				end
			end,
		})
	end

	local manaBarProps = {
		layoutOrder = 6,
		zIndex = zIndex + 1,
		position = UDim2.fromScale(1, 0),
		anchorPoint = Vector2.new(1, 0),
		size = UDim2.fromOffset(meterTokens.frameWidth, meterTokens.frameHeight),
		starSize = UDim2.fromOffset(meterTokens.segmentSize, meterTokens.segmentSize),
		padding = UDim.new(0, meterTokens.segmentGap),
		showValueLabel = not responsive.isCompactHud,
	}
	if props.manaBarProps ~= nil then
		for key, value in pairs(props.manaBarProps) do
			manaBarProps[key] = value
		end
	end

	local breathBarProps = {
		layoutOrder = 7,
		zIndex = zIndex + 1,
		position = UDim2.new(1, 0, 0, meterTokens.frameHeight + hudTokens.edgePadding),
		anchorPoint = Vector2.new(1, 0),
		size = UDim2.fromOffset(meterTokens.frameWidth, meterTokens.frameHeight),
		bubbleSize = UDim2.fromOffset(meterTokens.segmentSize, meterTokens.segmentSize),
		padding = UDim.new(0, meterTokens.segmentGap),
		showValueLabel = not responsive.isCompactHud,
	}
	if props.breathBarProps ~= nil then
		for key, value in pairs(props.breathBarProps) do
			breathBarProps[key] = value
		end
	end

	return e("Frame", {
		Size = props.size or UDim2.new(0, hudTokens.sideBarWidth + responsive.safeArea.right, 1, 0),
		Position = props.position or UDim2.fromScale(1, 0.5),
		AnchorPoint = props.anchorPoint or Vector2.new(1, 0.5),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Active = false,
		Selectable = false,
		LayoutOrder = props.layoutOrder or 3,
		ZIndex = zIndex,
		Visible = props.visible ~= false,
	}, {
		e("Frame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Active = false,
			Selectable = false,
			ZIndex = zIndex,
		}, {
			e("UIPadding", {
				PaddingTop = UDim.new(0, responsive.safeArea.top + hudTokens.sideBarVerticalPadding),
				PaddingBottom = UDim.new(0, responsive.safeArea.bottom + hudTokens.sideBarVerticalPadding),
				PaddingLeft = UDim.new(0, 0),
				PaddingRight = UDim.new(0, responsive.safeArea.right),
			}),
			e("Frame", {
				Size = UDim2.fromScale(1, 1),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Active = false,
				Selectable = false,
				ZIndex = zIndex,
			}, buttonListChildren),
			e(ManaTopRightBar, manaBarProps),
			e(BubblesScreen, breathBarProps),
		}),
	})
end
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="980">
                <Properties>
                  <string name="Name">TopBar</string>
                  <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local HpTopRightBar = require(script:FindFirstAncestor("game").Client.UI.hud.TopBar.HpTopRightBar)
local NavButton = require(script:FindFirstAncestor("game").Client.UI.core.components.NavButton)
local React = require(ReplicatedStorage.Packages.React)
local Responsive = require(script:FindFirstAncestor("game").Client.UI.core.hooks.useViewportScale)

local e: typeof(React.createElement) = React.createElement

type TopBarButton = {
	key: string?,
	id: string?,
	route: string?,
	label: string?,
	icon: string?,
	layoutOrder: number?,
	visible: boolean?,
	selected: boolean?,
	disabled: boolean?,
	size: UDim2?,
	textSize: number?,
	font: Enum.Font?,
	onActivated: ((payload: any, inputObject: InputObject?) -> ())?,
	navigateEvent: BindableEvent?,
}

type TopBarProps = {
	layoutOrder: number?,
	visible: boolean?,
	zIndex: number?,
	size: UDim2?,
	position: UDim2?,
	anchorPoint: Vector2?,
	padding: UDim?,
	buttons: { TopBarButton }?,
	hpBarProps: { [string]: any }?,
	navigateEvent: BindableEvent?,
	onButtonActivated: ((payload: any, inputObject: InputObject?, button: TopBarButton) -> ())?,
}

return function(props: TopBarProps)
	local responsive = Responsive.useResponsiveMetrics()
	local tokens = responsive.tokens
	local hudTokens = tokens.hud
	local meterTokens = tokens.meter
	local edgePadding = hudTokens.edgePadding
	local topPadding = responsive.safeArea.top
	local leftPadding = responsive.safeArea.left
	local rightPadding = responsive.safeArea.right
	local buttons = props.buttons or {}
	local zIndex = props.zIndex or 10
	local buttonListChildren = {
		e("UIPadding", {
			PaddingTop = UDim.new(0, 6),
			PaddingBottom = UDim.new(0, 6),
			PaddingLeft = UDim.new(0, 8),
			PaddingRight = UDim.new(0, 8),
		}),
		e("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Left,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			Padding = props.padding or UDim.new(0, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	}

	for index, button in ipairs(buttons) do
		buttonListChildren[#buttonListChildren + 1] = e(NavButton, {
			id = button.id,
			route = button.route,
			label = button.label,
			icon = button.icon,
			size = button.size or UDim2.fromOffset(hudTokens.navButtonWidth, hudTokens.navButtonHeight),
			layoutOrder = button.layoutOrder or index,
			visible = button.visible,
			selected = button.selected,
			disabled = button.disabled,
			textSize = button.textSize or hudTokens.navButtonTextSize,
			font = button.font,
			zIndex = zIndex + 1,
			navigateEvent = button.navigateEvent or props.navigateEvent,
			onActivated = function(payload: any, inputObject: InputObject?)
				if button.onActivated then
					button.onActivated(payload, inputObject)
				end

				if props.onButtonActivated then
					props.onButtonActivated(payload, inputObject, button)
				end
			end,
		})
	end

	local hpBarProps = {
		layoutOrder = 2,
		zIndex = zIndex + 1,
		position = UDim2.fromScale(1, 0),
		anchorPoint = Vector2.new(1, 0),
		size = UDim2.fromOffset(meterTokens.frameWidth, meterTokens.frameHeight),
		heartSize = UDim2.fromOffset(meterTokens.segmentSize, meterTokens.segmentSize),
		padding = UDim.new(0, meterTokens.segmentGap),
		showValueLabel = not responsive.isCompactHud,
	}
	if props.hpBarProps ~= nil then
		for key, value in pairs(props.hpBarProps) do
			hpBarProps[key] = value
		end
	end

	return e("Frame", {
		Size = props.size or UDim2.new(1, 0, 0, hudTokens.topBarHeight + topPadding),
		Position = props.position or UDim2.fromScale(0.5, 0),
		AnchorPoint = props.anchorPoint or Vector2.new(0.5, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Active = false,
		Selectable = false,
		LayoutOrder = props.layoutOrder or 1,
		ZIndex = zIndex,
		Visible = props.visible ~= false,
	}, {
		e("Frame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Active = false,
			Selectable = false,
			ZIndex = zIndex,
		}, {
			e("UIPadding", {
				PaddingTop = UDim.new(0, topPadding),
				PaddingBottom = UDim.new(0, 0),
				PaddingLeft = UDim.new(0, leftPadding),
				PaddingRight = UDim.new(0, rightPadding),
			}),
			e("Frame", {
				Size = UDim2.new(1, -(meterTokens.frameWidth + edgePadding), 1, 0),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Active = false,
				Selectable = false,
				ZIndex = zIndex,
			}, buttonListChildren),
			e(HpTopRightBar, hpBarProps),
		}),
	})
end
]]></string>
                </Properties>
                <Item class="ModuleScript" referent="981">
                  <Properties>
                    <string name="Name">HpTopRightBar</string>
                    <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local HeartMeter = require(script.Parent.components.HeartMeter)
local HpServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.HpServiceUtils)
local React = require(ReplicatedStorage.Packages.React)
local Responsive = require(script:FindFirstAncestor("game").Client.UI.core.hooks.useViewportScale)
local UiSound = require(script:FindFirstAncestor("game").Client.UI.core.utils.UiSound)
local hpSlice = require(script:FindFirstAncestor("game").Client.UI.hud.state.slice.hpSlice)
local hpThunks = require(script:FindFirstAncestor("game").Client.UI.hud.state.thunk.hpThunks)
local infoThunks = require(script:FindFirstAncestor("game").Client.UI.features.info.state.infoThunks)
local useHover = require(script:FindFirstAncestor("game").Client.UI.core.hooks.useHover)
local useStore = require(script:FindFirstAncestor("game").Client.UI.core.hooks.useStore)

type HeartState = HpServiceUtils.HeartState
type HpServiceState = HpServiceUtils.HpServiceState

type HpTopRightBarProps = {
	layoutOrder: number?,
	visible: boolean?,
	zIndex: number?,
	size: UDim2?,
	position: UDim2?,
	anchorPoint: Vector2?,
	heartSize: UDim2?,
	padding: UDim?,
	showValueLabel: boolean?,
	useServiceState: boolean?,
	mockState: HpServiceState?,
	mockReady: boolean?,
}

local e: typeof(React.createElement) = React.createElement

local function getBeatHeartIndexFromHearts(hearts: { HeartState }): number?
	for heartIndex = #hearts, 1, -1 do
		local heart = hearts[heartIndex]
		if heart.health > 0 then
			return heart.index
		end
	end

	return nil
end

return function(props: HpTopRightBarProps)
	local responsive = Responsive.useResponsiveMetrics()
	local meterTokens = responsive.tokens.meter
	local useServiceState = props.useServiceState ~= false
	local serviceHpState = useStore(if useServiceState then hpSlice.hpStateAtom else nil) :: HpServiceState?
	local serviceHpReady = useStore(if useServiceState then hpSlice.hpReadyAtom else nil) :: boolean?
	local hpState = if useServiceState
		then (serviceHpState or hpSlice.hpStateAtom())
		else if props.mockState ~= nil then props.mockState else hpSlice.hpStateAtom()
	local isHpReady = if useServiceState
		then (serviceHpReady or hpSlice.isHpReady())
		else if props.mockReady ~= nil then props.mockReady else true

	local heartsHoverId = "hp_hearts_row"
	local heartsHoverText = string.format("%.0f/%.0f", hpState.health, hpState.maxHealth)
	local heartsHover = useHover({
		onHoverStart = function()
			infoThunks.showHover({
				id = heartsHoverId,
				text = heartsHoverText,
			})

			UiSound.playHover()
		end,
		onHoverEnd = function()
			infoThunks.hideHover(heartsHoverId)
		end,
	})

	React.useEffect(function()
		if not useServiceState then
			return
		end

		local stop = hpThunks.start()

		return function()
			stop()
		end
	end, { useServiceState })

	React.useEffect(function()
		if not heartsHover.hovered then
			return
		end

		infoThunks.showHover({
			id = heartsHoverId,
			text = heartsHoverText,
		})
	end, { heartsHover.hovered, heartsHoverText })

	React.useEffect(function()
		return function()
			infoThunks.hideHover(heartsHoverId)
		end
	end, {})

	local zIndex = props.zIndex or 12
	local hearts = hpState.hearts
	local heartSize = props.heartSize or UDim2.fromOffset(meterTokens.segmentSize, meterTokens.segmentSize)
	local useLifeFruitHearts = hpState.maxHealth > 400
	local beatHeartIndex = if useServiceState then hpThunks.getBeatHeartIndex() else getBeatHeartIndexFromHearts(hearts)

	local children: { React.ReactNode } = {
		e(HeartMeter, {
			hearts = hearts,
			heartSize = heartSize,
			padding = props.padding or UDim.new(0, 4),
			zIndex = zIndex + 1,
			useLifeFruitHearts = useLifeFruitHearts,
			beatHeartIndex = beatHeartIndex,
			onMouseEnter = heartsHover.eventHandlers[React.Event.MouseEnter],
			onMouseLeave = heartsHover.eventHandlers[React.Event.MouseLeave],
		}),
	}

	if props.showValueLabel ~= false and not responsive.isCompactHud then
		children[#children + 1] = e("TextLabel", {
			Size = UDim2.new(1, -16, 0, 18),
			Position = UDim2.fromOffset(8, 0),
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamBold,
			Text = string.format("Life: %.0f/%.0f", hpState.health, hpState.maxHealth),
			TextColor3 = Color3.fromRGB(255, 255, 255),
			TextStrokeTransparency = 0.55,
			TextSize = meterTokens.labelTextSize,
			TextXAlignment = Enum.TextXAlignment.Right,
			TextYAlignment = Enum.TextYAlignment.Center,
			ZIndex = zIndex + 3,
		})
	end

	return e("Frame", {
		Size = props.size or UDim2.fromOffset(meterTokens.frameWidth, meterTokens.frameHeight),
		Position = props.position or UDim2.new(1, -responsive.safeArea.right, 0, responsive.safeArea.top),
		AnchorPoint = props.anchorPoint or Vector2.new(1, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		LayoutOrder = props.layoutOrder or 10,
		ZIndex = zIndex,
		Visible = props.visible ~= false and isHpReady,
	}, children)
end
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="982">
                  <Properties>
                    <string name="Name">ManaTopRightBar</string>
                    <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Sift = require(ReplicatedStorage.Packages.Sift)

local ManaMeter = require(script.Parent.components.ManaMeter)
local ManaServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.ManaServiceUtils)
local React = require(ReplicatedStorage.Packages.React)
local Responsive = require(script:FindFirstAncestor("game").Client.UI.core.hooks.useViewportScale)
local UiSound = require(script:FindFirstAncestor("game").Client.UI.core.utils.UiSound)
local infoThunks = require(script:FindFirstAncestor("game").Client.UI.features.info.state.infoThunks)
local manaSlice = require(script:FindFirstAncestor("game").Client.UI.hud.state.slice.manaSlice)
local manaThunks = require(script:FindFirstAncestor("game").Client.UI.hud.state.thunk.manaThunks)
local useHover = require(script:FindFirstAncestor("game").Client.UI.core.hooks.useHover)
local useManaTransparency = require(script:FindFirstAncestor("game").Client.UI.core.hooks.useManaTransparency)
local useStore = require(script:FindFirstAncestor("game").Client.UI.core.hooks.useStore)

type ManaServiceState = ManaServiceUtils.ManaServiceState

type ManaStarState = {
	index: number,
	mana: number,
	maxMana: number,
	fillAlpha: number,
	isFull: boolean,
	isEmpty: boolean,
}

type ManaTopRightBarProps = {
	layoutOrder: number?,
	visible: boolean?,
	zIndex: number?,
	size: UDim2?,
	position: UDim2?,
	anchorPoint: Vector2?,
	starSize: UDim2?,
	iconSize: UDim2?,
	padding: UDim?,
	showValueLabel: boolean?,
	starValue: number?,
	useServiceState: boolean?,
	mockState: ManaServiceState?,
	mockReady: boolean?,
}

local e: typeof(React.createElement) = React.createElement

local DEFAULT_MANA_STAR_VALUE = 20
local function buildManaStars(manaRaw: any, maxManaRaw: any, starValueRaw: any): { ManaStarState }
	local starValue = if typeof(starValueRaw) == "number" and starValueRaw == starValueRaw
		then math.max(1, starValueRaw)
		else DEFAULT_MANA_STAR_VALUE
	local maxMana = if typeof(maxManaRaw) == "number" and maxManaRaw == maxManaRaw then maxManaRaw else starValue
	maxMana = math.max(1, maxMana)
	local mana = if typeof(manaRaw) == "number" and manaRaw == manaRaw then manaRaw else maxMana
	mana = math.clamp(mana, 0, maxMana)

	local starCount = math.max(1, math.ceil(maxMana / starValue))
	local stars: { ManaStarState } = Sift.Array.create(starCount)
	for starIndex = 1, starCount do
		local starStart = (starIndex - 1) * starValue
		local maxManaInStar = math.clamp(maxMana - starStart, 0, starValue)
		local manaInStar = math.clamp(mana - starStart, 0, maxManaInStar)
		local fillAlpha = if maxManaInStar > 0 then manaInStar / maxManaInStar else 0
		stars[starIndex] = {
			index = starIndex,
			mana = manaInStar,
			maxMana = maxManaInStar,
			fillAlpha = fillAlpha,
			isFull = manaInStar >= maxManaInStar,
			isEmpty = manaInStar <= 0,
		}
	end
	return stars
end

return function(props: ManaTopRightBarProps)
	local responsive = Responsive.useResponsiveMetrics()
	local meterTokens = responsive.tokens.meter
	local useServiceState = props.useServiceState ~= false
	local serviceManaState = useStore(if useServiceState then manaSlice.manaStateAtom else nil) :: ManaServiceState?
	local serviceManaReady = useStore(if useServiceState then manaSlice.manaReadyAtom else nil) :: boolean?
	local manaState = if useServiceState
		then (serviceManaState or manaSlice.manaStateAtom())
		else if props.mockState ~= nil then props.mockState else manaSlice.manaStateAtom()
	local isManaReady = if useServiceState
		then (serviceManaReady or manaSlice.isManaReady())
		else if props.mockReady ~= nil then props.mockReady else true

	local hoverId = "mana_stars_row"
	local hoverText = string.format("%.0f/%.0f", manaState.mana, manaState.maxMana)
	local starsHover = useHover({
		onHoverStart = function()
			infoThunks.showHover({
				id = hoverId,
				text = hoverText,
			})

			UiSound.playHover()
		end,
		onHoverEnd = function()
			infoThunks.hideHover(hoverId)
		end,
	})
	local hoverAlpha = useManaTransparency({
		enabled = starsHover.hovered,
	})

	React.useEffect(function()
		if not useServiceState then
			return
		end

		local stop = manaThunks.start()

		return function()
			stop()
		end
	end, { useServiceState })

	React.useEffect(function()
		if not starsHover.hovered then
			return
		end

		infoThunks.showHover({
			id = hoverId,
			text = hoverText,
		})
	end, { starsHover.hovered, hoverText })

	React.useEffect(function()
		return function()
			infoThunks.hideHover(hoverId)
		end
	end, {})

	local zIndex = props.zIndex or 12
	local starSize = props.starSize
		or props.iconSize
		or UDim2.fromOffset(meterTokens.segmentSize, meterTokens.segmentSize)
	local stars = buildManaStars(manaState.mana, manaState.maxMana, props.starValue)

	local children: { React.ReactNode } = {
		e(ManaMeter, {
			stars = stars,
			starSize = starSize,
			padding = props.padding or UDim.new(0, meterTokens.segmentGap),
			zIndex = zIndex + 1,
			hoverAlpha = hoverAlpha,
			onMouseEnter = starsHover.eventHandlers[React.Event.MouseEnter],
			onMouseLeave = starsHover.eventHandlers[React.Event.MouseLeave],
		}),
	}

	if props.showValueLabel ~= false and not responsive.isCompactHud then
		children[#children + 1] = e("TextLabel", {
			Size = UDim2.new(1, -16, 0, 18),
			Position = UDim2.fromOffset(8, 0),
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamBold,
			Text = "mana",
			TextColor3 = Color3.fromRGB(255, 255, 255),
			TextStrokeTransparency = 0.55,
			TextSize = meterTokens.labelTextSize,
			TextXAlignment = Enum.TextXAlignment.Right,
			TextYAlignment = Enum.TextYAlignment.Center,
			ZIndex = zIndex + 3,
		})
	end

	return e("Frame", {
		Size = props.size or UDim2.fromOffset(meterTokens.frameWidth, meterTokens.frameHeight),
		Position = props.position or UDim2.fromScale(1, 0),
		AnchorPoint = props.anchorPoint or Vector2.new(1, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		LayoutOrder = props.layoutOrder or 11,
		ZIndex = zIndex,
		Visible = props.visible ~= false and isManaReady,
	}, children)
end
]]></string>
                  </Properties>
                </Item>
                <Item class="Folder" referent="983">
                  <Properties>
                    <string name="Name">components</string>
                  </Properties>
                  <Item class="ModuleScript" referent="984">
                    <Properties>
                      <string name="Name">HeartMeter</string>
                      <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ImageIds = require(script:FindFirstAncestor("game").Client.UI.core.ImageIds)
local React = require(ReplicatedStorage.Packages.React)
local SegmentIcon = require(script:FindFirstAncestor("game").Client.UI.core.components.SegmentIcon)
local SegmentMeter = require(script:FindFirstAncestor("game").Client.UI.core.components.SegmentMeter)
local useBeatMotion = require(script:FindFirstAncestor("game").Client.UI.core.hooks.useBeatMotion)

export type HeartSegment = {
	index: number,
	health: number,
	fillAlpha: number,
	isEmpty: boolean,
}

export type HeartMeterProps = {
	hearts: { HeartSegment },
	heartSize: UDim2,
	padding: UDim?,
	zIndex: number,
	useLifeFruitHearts: boolean?,
	beatHeartIndex: number?,
	onMouseEnter: (() -> ())?,
	onMouseLeave: (() -> ())?,
}

local e: typeof(React.createElement) = React.createElement

local EMPTY_HEART_COLOR = Color3.fromRGB(59, 25, 29)
local FILLED_HEART_COLOR = Color3.fromRGB(255, 90, 118)
local EMPTY_LIFE_FRUIT_HEART_COLOR = Color3.fromRGB(52, 78, 28)
local FILLED_LIFE_FRUIT_HEART_COLOR = Color3.fromRGB(255, 255, 255)

local function HeartItem(props: {
	heart: HeartSegment,
	heartSize: UDim2,
	heartImage: string,
	emptyColor: Color3,
	filledColor: Color3,
	zIndex: number,
	isBeating: boolean,
})
	local heart = props.heart
	local beatMotion = useBeatMotion({
		enabled = props.isBeating,
		auto = true,
		bpm = 72,
		baseScale = 1,
		primaryScale = 1.08,
		secondaryScale = 1.04,
	})
	local fillAlpha = math.clamp(heart.fillAlpha, 0, 1)
	local heartColor = if heart.isEmpty then props.emptyColor else props.filledColor

	return e(SegmentIcon, {
		icon = props.heartImage,
		size = props.heartSize,
		layoutOrder = heart.index,
		zIndex = props.zIndex,
		fillAlpha = fillAlpha,
		emptyColor = props.emptyColor,
		fullColor = heartColor,
		scale = beatMotion.scale,
	})
end

return function(props: HeartMeterProps): React.ReactNode
	local useLifeFruitHearts = props.useLifeFruitHearts == true
	local heartImage = if useLifeFruitHearts
		then if typeof((ImageIds :: any).lifeFruitHeart) == "string" and (ImageIds :: any).lifeFruitHeart ~= ""
			then (ImageIds :: any).lifeFruitHeart
			else ImageIds.heartLifeFruit
		else ImageIds.normalHeart
	local emptyHeartColor = if useLifeFruitHearts then EMPTY_LIFE_FRUIT_HEART_COLOR else EMPTY_HEART_COLOR
	local filledHeartColor = if useLifeFruitHearts then FILLED_LIFE_FRUIT_HEART_COLOR else FILLED_HEART_COLOR

	return e(SegmentMeter, {
		segments = props.hearts,
		size = UDim2.fromOffset(0, props.heartSize.Y.Offset),
		segmentHeight = props.heartSize.Y.Offset,
		anchorPoint = Vector2.new(1, 1),
		position = UDim2.new(1, 0, 1, -4),
		active = true,
		zIndex = props.zIndex,
		padding = props.padding,
		onMouseEnter = props.onMouseEnter,
		onMouseLeave = props.onMouseLeave,
		renderSegment = function(segment)
			local heart = segment :: any
			return e(HeartItem, {
				heart = heart,
				heartSize = props.heartSize,
				heartImage = heartImage,
				emptyColor = emptyHeartColor,
				filledColor = filledHeartColor,
				zIndex = props.zIndex + 1,
				isBeating = props.beatHeartIndex ~= nil and heart.index == props.beatHeartIndex,
			})
		end,
	})
end
]]></string>
                    </Properties>
                  </Item>
                  <Item class="ModuleScript" referent="985">
                    <Properties>
                      <string name="Name">ManaMeter</string>
                      <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ImageIds = require(script:FindFirstAncestor("game").Client.UI.core.ImageIds)
local React = require(ReplicatedStorage.Packages.React)
local SegmentIcon = require(script:FindFirstAncestor("game").Client.UI.core.components.SegmentIcon)
local SegmentMeter = require(script:FindFirstAncestor("game").Client.UI.core.components.SegmentMeter)

export type ManaSegment = {
	index: number,
	fillAlpha: number,
}

export type ManaMeterProps = {
	stars: { ManaSegment },
	starSize: UDim2,
	padding: UDim?,
	zIndex: number,
	hoverAlpha: number?,
	onMouseEnter: (() -> ())?,
	onMouseLeave: (() -> ())?,
}

local e: typeof(React.createElement) = React.createElement

local EMPTY_STAR_COLOR = Color3.fromRGB(24, 44, 75)
local FILLED_STAR_COLOR = Color3.fromRGB(133, 189, 255)

local function ManaStarItem(props: {
	star: ManaSegment,
	starSize: UDim2,
	zIndex: number,
	hoverAlpha: number,
})
	local fillAlpha = math.clamp(props.star.fillAlpha, 0, 1)
	local hoverAlpha = math.clamp(props.hoverAlpha, 0, 1)
	local fillTransparency = math.clamp((1 - fillAlpha) - (0.14 * hoverAlpha * fillAlpha), 0, 1)
	local scale = 1 + 0.03 * hoverAlpha

	return e(SegmentIcon, {
		icon = ImageIds.mana,
		size = props.starSize,
		layoutOrder = props.star.index,
		zIndex = props.zIndex,
		fillAlpha = fillAlpha,
		emptyColor = EMPTY_STAR_COLOR,
		fullColor = FILLED_STAR_COLOR,
		fullTransparency = fillTransparency,
		scale = scale,
	})
end

return function(props: ManaMeterProps): React.ReactNode
	return e(SegmentMeter, {
		segments = props.stars,
		size = UDim2.fromOffset(0, props.starSize.Y.Offset),
		segmentHeight = props.starSize.Y.Offset,
		anchorPoint = Vector2.new(1, 1),
		position = UDim2.new(1, 0, 1, -4),
		active = true,
		zIndex = props.zIndex,
		padding = props.padding,
		onMouseEnter = props.onMouseEnter,
		onMouseLeave = props.onMouseLeave,
		renderSegment = function(segment)
			return e(ManaStarItem, {
				star = segment :: any,
				starSize = props.starSize,
				zIndex = props.zIndex + 1,
				hoverAlpha = props.hoverAlpha or 0,
			})
		end,
	})
end
]]></string>
                    </Properties>
                  </Item>
                </Item>
              </Item>
              <Item class="Folder" referent="986">
                <Properties>
                  <string name="Name">state</string>
                </Properties>
                <Item class="Folder" referent="987">
                  <Properties>
                    <string name="Name">slice</string>
                  </Properties>
                  <Item class="ModuleScript" referent="988">
                    <Properties>
                      <string name="Name">hpSlice</string>
                      <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Charm = require(ReplicatedStorage.Packages.Charm)
local HpServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.HpServiceUtils)

type HpServiceState = HpServiceUtils.HpServiceState
type HeartState = HpServiceUtils.HeartState

local hpStateAtom: Charm.Atom<HpServiceState> = Charm.atom(HpServiceUtils.createDefaultState())
local hpReadyAtom: Charm.Atom<boolean> = Charm.atom(false)

local heartsAtom: Charm.Selector<{ HeartState }> = Charm.computed(function(): { HeartState }
	return hpStateAtom().hearts
end)

local healthAtom: Charm.Selector<number> = Charm.computed(function(): number
	return hpStateAtom().health
end)

local maxHealthAtom: Charm.Selector<number> = Charm.computed(function(): number
	return hpStateAtom().maxHealth
end)

local heartCountAtom: Charm.Selector<number> = Charm.computed(function(): number
	return hpStateAtom().heartCount
end)

local beatHeartIndexAtom: Charm.Selector<number?> = Charm.computed(function(): number?
	local hearts = hpStateAtom().hearts
	for heartIndex = #hearts, 1, -1 do
		local heart = hearts[heartIndex]
		if heart.health > 0 then
			return heart.index
		end
	end

	return nil
end)

local healthPercentAtom: Charm.Selector<number> = Charm.computed(function(): number
	local state = hpStateAtom()
	if state.maxHealth <= 0 then
		return 0
	end
	return math.clamp(state.health / state.maxHealth, 0, 1)
end)

local function getHpState(): HpServiceState
	return hpStateAtom()
end

local function setHpState(stateRaw: any): HpServiceState
	local nextState = HpServiceUtils.sanitizeState(stateRaw, hpStateAtom())
	hpStateAtom(nextState)
	return nextState
end

local function resetHpState(): HpServiceState
	local nextState = HpServiceUtils.createDefaultState()
	hpStateAtom(nextState)
	return nextState
end

local function isHpReady(): boolean
	return hpReadyAtom()
end

local function setHpReady(isReadyRaw: any): boolean
	local nextReady = isReadyRaw == true
	hpReadyAtom(nextReady)
	return nextReady
end

return {
	hpStateAtom = hpStateAtom,
	hpReadyAtom = hpReadyAtom,
	heartsAtom = heartsAtom,
	healthAtom = healthAtom,
	maxHealthAtom = maxHealthAtom,
	heartCountAtom = heartCountAtom,
	beatHeartIndexAtom = beatHeartIndexAtom,
	healthPercentAtom = healthPercentAtom,
	isHpReady = isHpReady,
	setHpReady = setHpReady,
	getHpState = getHpState,
	setHpState = setHpState,
	resetHpState = resetHpState,
}
]]></string>
                    </Properties>
                  </Item>
                  <Item class="ModuleScript" referent="989">
                    <Properties>
                      <string name="Name">inventorySlice</string>
                      <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Charm = require(ReplicatedStorage.Packages.Charm)
local InventoryServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.InventoryServiceUtils)

type InventoryState = InventoryServiceUtils.InventoryState
type InventorySlot = InventoryServiceUtils.InventorySlot

export type InventoryHudState = {
	isInventoryPanelOpen: boolean,
	isHotbarExpanded: boolean,
	isLeftSideBarVisible: boolean,
	updatedAt: number,
}

local DEFAULT_STATE: InventoryHudState = {
	isInventoryPanelOpen = false,
	isHotbarExpanded = false,
	isLeftSideBarVisible = true,
	updatedAt = os.clock(),
}

local inventoryStateAtom =
	Charm.atom(InventoryServiceUtils.createDefaultState(InventoryServiceUtils.LOAD_STATE_UNLOADED))
local inventoryHudStateAtom = Charm.atom(DEFAULT_STATE)

local slotsAtom = Charm.computed(function(): { InventorySlot }
	return inventoryStateAtom().slots
end)

local selectedSlotAtom = Charm.computed(function(): number?
	return inventoryStateAtom().selectedSlot
end)

local totalItemCountAtom = Charm.computed(function(): number
	return inventoryStateAtom().totalItemCount
end)

local occupiedSlotCountAtom = Charm.computed(function(): number
	return inventoryStateAtom().occupiedSlotCount
end)

local loadStateAtom = Charm.computed(function(): InventoryServiceUtils.InventoryLoadState
	return inventoryStateAtom().loadState
end)

local isInventoryPanelOpenAtom = Charm.computed(function(): boolean
	return inventoryHudStateAtom().isInventoryPanelOpen
end)

local isHotbarExpandedAtom = Charm.computed(function(): boolean
	return inventoryHudStateAtom().isHotbarExpanded
end)

local isLeftSideBarVisibleAtom = Charm.computed(function(): boolean
	return inventoryHudStateAtom().isLeftSideBarVisible
end)

local function sanitizeBoolean(valueRaw: any, fallback: boolean): boolean
	if typeof(valueRaw) == "boolean" then
		return valueRaw
	end
	return fallback
end

local function getInventoryState(): InventoryState
	return inventoryStateAtom()
end

local function setInventoryState(stateRaw: any): InventoryState
	local nextState = InventoryServiceUtils.sanitizeState(stateRaw, inventoryStateAtom())
	inventoryStateAtom(nextState)
	return nextState
end

local function resetInventoryState(): InventoryState
	local nextState = InventoryServiceUtils.createDefaultState(InventoryServiceUtils.LOAD_STATE_UNLOADED)
	inventoryStateAtom(nextState)
	return nextState
end

local function getInventoryHudState(): InventoryHudState
	return inventoryHudStateAtom()
end

local function setInventoryHudState(stateRaw: any): InventoryHudState
	local current = inventoryHudStateAtom()
	local source: { [string]: any } = if typeof(stateRaw) == "table" then stateRaw :: { [string]: any } else {}

	local nextIsHotbarExpanded = sanitizeBoolean(source.isHotbarExpanded, current.isHotbarExpanded)
	local nextIsInventoryPanelOpen = sanitizeBoolean(source.isInventoryPanelOpen, nextIsHotbarExpanded)

	local nextState: InventoryHudState = {
		isInventoryPanelOpen = nextIsInventoryPanelOpen,
		isHotbarExpanded = nextIsHotbarExpanded,
		isLeftSideBarVisible = sanitizeBoolean(source.isLeftSideBarVisible, current.isLeftSideBarVisible),
		updatedAt = os.clock(),
	}

	inventoryHudStateAtom(nextState)
	return nextState
end

local function resetInventoryHudState(): InventoryHudState
	local nextState: InventoryHudState = {
		isInventoryPanelOpen = DEFAULT_STATE.isInventoryPanelOpen,
		isHotbarExpanded = DEFAULT_STATE.isHotbarExpanded,
		isLeftSideBarVisible = DEFAULT_STATE.isLeftSideBarVisible,
		updatedAt = os.clock(),
	}
	inventoryHudStateAtom(nextState)
	return nextState
end

local function setInventoryPanelOpen(isOpenRaw: any): InventoryHudState
	local isOpen = isOpenRaw == true
	return setInventoryHudState({
		isInventoryPanelOpen = isOpen,
		isHotbarExpanded = isOpen,
	})
end

local function setHotbarExpanded(isExpandedRaw: any): InventoryHudState
	local isExpanded = isExpandedRaw == true
	return setInventoryHudState({
		isInventoryPanelOpen = isExpanded,
		isHotbarExpanded = isExpanded,
	})
end

local function toggleHotbarExpanded(): InventoryHudState
	return setHotbarExpanded(not inventoryHudStateAtom().isHotbarExpanded)
end

local function setLeftSideBarVisible(isVisibleRaw: any): InventoryHudState
	return setInventoryHudState({
		isLeftSideBarVisible = isVisibleRaw == true,
	})
end

return {
	inventoryStateAtom = inventoryStateAtom,
	slotsAtom = slotsAtom,
	selectedSlotAtom = selectedSlotAtom,
	totalItemCountAtom = totalItemCountAtom,
	occupiedSlotCountAtom = occupiedSlotCountAtom,
	loadStateAtom = loadStateAtom,
	inventoryHudStateAtom = inventoryHudStateAtom,
	isInventoryPanelOpenAtom = isInventoryPanelOpenAtom,
	isHotbarExpandedAtom = isHotbarExpandedAtom,
	isLeftSideBarVisibleAtom = isLeftSideBarVisibleAtom,
	getInventoryState = getInventoryState,
	setInventoryState = setInventoryState,
	resetInventoryState = resetInventoryState,
	getInventoryHudState = getInventoryHudState,
	setInventoryHudState = setInventoryHudState,
	resetInventoryHudState = resetInventoryHudState,
	setInventoryPanelOpen = setInventoryPanelOpen,
	setHotbarExpanded = setHotbarExpanded,
	toggleHotbarExpanded = toggleHotbarExpanded,
	setLeftSideBarVisible = setLeftSideBarVisible,
}
]]></string>
                    </Properties>
                  </Item>
                  <Item class="ModuleScript" referent="990">
                    <Properties>
                      <string name="Name">inventoryThunks</string>
                      <string name="Source"><![CDATA[--!strict

local ConnectionUtils = require(script:FindFirstAncestor("game").Client.UI.core.utils.ConnectionUtils)
local InventoryServiceClient = require(script:FindFirstAncestor("game").Client.Services.InventoryServiceClient)
local InventoryServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.InventoryServiceUtils)
local ServiceSync = require(script:FindFirstAncestor("game").Client.UI.core.utils.ServiceSync)
local craftingThunks = require(script:FindFirstAncestor("game").Client.UI.features.crafting.state.craftingThunks)
local inventorySlice = require(script.Parent.inventorySlice)

type InventoryHudState = inventorySlice.InventoryHudState
type InventoryState = InventoryServiceUtils.InventoryState

local inventoryThunks = {}

local runtime = {
	started = false,
	stateChangedConnection = nil :: RBXScriptConnection?,
}

local function applyState(nextStateRaw: any): InventoryState
	return inventorySlice.setInventoryState(nextStateRaw)
end

local function syncFromService(): InventoryState
	return ServiceSync.syncFromService(InventoryServiceClient, inventorySlice.getInventoryState, applyState)
end

function inventoryThunks.Start(): () -> ()
	if runtime.started then
		return inventoryThunks.Stop
	end

	runtime.started = true
	syncFromService()

	runtime.stateChangedConnection = ServiceSync.connectStateChanged(
		InventoryServiceClient,
		function(nextState: InventoryState)
			applyState(nextState)
		end
	)
	ServiceSync.requestSync(InventoryServiceClient)

	return inventoryThunks.Stop
end

function inventoryThunks.Stop()
	ConnectionUtils.disconnect(runtime.stateChangedConnection)
	runtime.stateChangedConnection = nil
	runtime.started = false
end

function inventoryThunks.SyncFromService(): InventoryState
	return syncFromService()
end

function inventoryThunks.ApplyState(nextStateRaw: any): InventoryState
	return applyState(nextStateRaw)
end

function inventoryThunks.SelectSlot(slotIndexRaw: any): boolean
	local success, didSet = pcall(function()
		return InventoryServiceClient:setSelectedSlot(slotIndexRaw, true)
	end)
	if success then
		return didSet == true
	end
	return false
end

function inventoryThunks.ClearSelectedSlot(): boolean
	local success, didSet = pcall(function()
		return InventoryServiceClient:clearSelectedSlot(true)
	end)
	if success then
		return didSet == true
	end
	return false
end

function inventoryThunks.MoveSlot(fromSlotRaw: any, toSlotRaw: any, amountRaw: any): boolean
	local currentState = inventorySlice.getInventoryState()
	local optimisticState = InventoryServiceUtils.cloneState(currentState)
	local optimisticResult = InventoryServiceUtils.moveSlot(optimisticState, fromSlotRaw, toSlotRaw, amountRaw)
	if optimisticResult.changed then
		inventorySlice.setInventoryState(optimisticState)
	end

	pcall(function()
		InventoryServiceClient:moveSlot(fromSlotRaw, toSlotRaw, amountRaw)
	end)
	return optimisticResult.changed
end

function inventoryThunks.SplitSlot(fromSlotRaw: any, toSlotRaw: any, amountRaw: any): boolean
	pcall(function()
		InventoryServiceClient:splitSlot(fromSlotRaw, toSlotRaw, amountRaw)
	end)
	return true
end

function inventoryThunks.DropFromSlot(slotIndexRaw: any, amountRaw: any): boolean
	local currentState = inventorySlice.getInventoryState()
	local safeState = InventoryServiceUtils.sanitizeState(currentState, currentState)
	if not InventoryServiceUtils.isLoadedState(safeState.loadState) then
		return false
	end

	local slot = InventoryServiceUtils.getSlot(safeState, slotIndexRaw)
	if slot == nil or slot.stack == nil then
		return false
	end

	task.defer(function()
		pcall(function()
			InventoryServiceClient:dropFromSlot(slotIndexRaw, amountRaw)
		end)
	end)
	return true
end

function inventoryThunks.TrashSlot(slotIndexRaw: any, amountRaw: any): boolean
	local currentState = inventorySlice.getInventoryState()
	local optimisticState = InventoryServiceUtils.cloneState(currentState)
	local optimisticResult = InventoryServiceUtils.trashSlot(optimisticState, slotIndexRaw, amountRaw)
	if optimisticResult.changed then
		inventorySlice.setInventoryState(optimisticState)
	end

	local success = pcall(function()
		InventoryServiceClient:trashSlot(slotIndexRaw, amountRaw)
	end)
	return success
end

function inventoryThunks.UseSelectedSlot(amountRaw: any)
	pcall(function()
		InventoryServiceClient:useSelectedSlot(amountRaw)
	end)
end

function inventoryThunks.OpenInventory(): InventoryHudState
	return inventorySlice.setInventoryPanelOpen(true)
end

function inventoryThunks.CloseInventory(): InventoryHudState
	return inventorySlice.setInventoryPanelOpen(false)
end

function inventoryThunks.ToggleInventory(): InventoryHudState
	return inventorySlice.toggleHotbarExpanded()
end

function inventoryThunks.SetHotbarExpanded(isExpandedRaw: any): InventoryHudState
	return inventorySlice.setHotbarExpanded(isExpandedRaw)
end

function inventoryThunks.ToggleHotbarExpanded(): InventoryHudState
	return inventorySlice.toggleHotbarExpanded()
end

function inventoryThunks.ShowLeftSideBar(): InventoryHudState
	return inventorySlice.setLeftSideBarVisible(true)
end

function inventoryThunks.HideLeftSideBar(): InventoryHudState
	return inventorySlice.setLeftSideBarVisible(false)
end

function inventoryThunks.SetLeftSideBarVisible(isVisibleRaw: any): InventoryHudState
	return inventorySlice.setLeftSideBarVisible(isVisibleRaw)
end

function inventoryThunks.ToggleCrafting()
	return craftingThunks.toggleVisible()
end

function inventoryThunks.SetCraftingVisible(isVisibleRaw: any)
	return craftingThunks.setVisible(isVisibleRaw)
end

inventoryThunks.start = inventoryThunks.Start
inventoryThunks.stop = inventoryThunks.Stop
inventoryThunks.syncFromService = inventoryThunks.SyncFromService
inventoryThunks.applyState = inventoryThunks.ApplyState
inventoryThunks.selectSlot = inventoryThunks.SelectSlot
inventoryThunks.clearSelectedSlot = inventoryThunks.ClearSelectedSlot
inventoryThunks.moveSlot = inventoryThunks.MoveSlot
inventoryThunks.splitSlot = inventoryThunks.SplitSlot
inventoryThunks.dropFromSlot = inventoryThunks.DropFromSlot
inventoryThunks.trashSlot = inventoryThunks.TrashSlot
inventoryThunks.useSelectedSlot = inventoryThunks.UseSelectedSlot
inventoryThunks.openInventory = inventoryThunks.OpenInventory
inventoryThunks.closeInventory = inventoryThunks.CloseInventory
inventoryThunks.toggleInventory = inventoryThunks.ToggleInventory
inventoryThunks.setHotbarExpanded = inventoryThunks.SetHotbarExpanded
inventoryThunks.toggleHotbarExpanded = inventoryThunks.ToggleHotbarExpanded
inventoryThunks.showLeftSideBar = inventoryThunks.ShowLeftSideBar
inventoryThunks.hideLeftSideBar = inventoryThunks.HideLeftSideBar
inventoryThunks.setLeftSideBarVisible = inventoryThunks.SetLeftSideBarVisible
inventoryThunks.toggleCrafting = inventoryThunks.ToggleCrafting
inventoryThunks.setCraftingVisible = inventoryThunks.SetCraftingVisible

return inventoryThunks
]]></string>
                    </Properties>
                  </Item>
