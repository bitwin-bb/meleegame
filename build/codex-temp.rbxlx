	* limitations under the License.
]]
--[[
	Special value for assigning tags to roblox instances via Roact
]]
local Symbol = require(script.Parent.Parent:WaitForChild('Symbol.roblox'))

local Tag = Symbol.named("RobloxTag")

return Tag
]]></string>
