              </Item>
              <Item class="ModuleScript" referent="1189">
                <Properties>
                  <string name="Name">TagQuery</string>
                  <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Sift = require(ReplicatedStorage.Packages.Sift)

local Signal = require(ReplicatedStorage.Packages.Signal)

local TagQuery = {}
TagQuery.__index = TagQuery

export type TagProvider = {
	GetTagged: (self: any, tag: string) -> { any },
	HasTag: ((self: any, instance: any, tag: string) -> boolean)?,
	GetTags: ((self: any, instance: any) -> { string })?,
	GetInstanceAddedSignal: ((self: any, tag: string) -> any)?,
	GetInstanceRemovedSignal: ((self: any, tag: string) -> any)?,
}

export type TagListener = (instance: any, isAdded: boolean, tag: string) -> ()

export type TagQuery = typeof(setmetatable({} :: any, TagQuery))

type SignalConnection = {
	Disconnect: (self: SignalConnection) -> (),
}

type TagSignal = {
	Connect: (self: TagSignal, callback: TagListener) -> SignalConnection,
	Fire: (self: TagSignal, instance: any, isAdded: boolean, tag: string) -> (),
	DisconnectAll: (self: TagSignal) -> (),
	Destroy: (self: TagSignal) -> (),
}

local function clearArray(array: { any })
	for index = #array, 1, -1 do
		array[index] = nil
	end
end

local function connectSignal(signal: any, callback: (...any) -> ()): any?
	if signal == nil then
		return nil
	end
	local ok, connection = pcall(function()
		return signal:Connect(callback)
	end)
	if not ok then
		return nil
	end
	return connection
end

function TagQuery.New(providerRaw: any): TagQuery
	if providerRaw == nil or typeof((providerRaw :: any).GetTagged) ~= "function" then
		error("TagQuery.New expects a provider with GetTagged(tag)")
	end
	local self = setmetatable({
		provider = providerRaw :: TagProvider,
		tagLists = {} :: { [string]: { any } },
		tagSets = {} :: { [string]: { [any]: true } },
		tagVersions = {} :: { [string]: number },
		signalsByTag = {} :: { [string]: TagSignal },
		tagConnections = {} :: { [string]: { any? } },
	}, TagQuery)
	return self
end

function TagQuery._getSignal(self: TagQuery, tag: string): TagSignal
	local signal = self.signalsByTag[tag]
	if signal ~= nil then
		return signal
	end
	signal = Signal.new() :: TagSignal
	self.signalsByTag[tag] = signal
	return signal
end

function TagQuery._refreshTag(self: TagQuery, tag: string)
	local list = self.provider:GetTagged(tag)
	if typeof(list) ~= "table" then
		list = {}
	end

	local outList = Sift.Array.create(#list)
	local outSet = {}
	for index = 1, #list do
		local instance = list[index]
		if outSet[instance] == nil then
			outSet[instance] = true
			outList[#outList + 1] = instance
		end
	end

	self.tagLists[tag] = outList
	self.tagSets[tag] = outSet
	self.tagVersions[tag] = (self.tagVersions[tag] or 0) + 1
end

function TagQuery._ensureTagSignals(self: TagQuery, tag: string)
	if self.tagConnections[tag] ~= nil then
		return
	end

	local addedConnection = nil
	local removedConnection = nil

	local getAdded = self.provider.GetInstanceAddedSignal
	if getAdded ~= nil then
		local ok, signal = pcall(function()
			return getAdded(self.provider, tag)
		end)
		if ok then
			addedConnection = connectSignal(signal, function(instance: any)
				if self.tagLists[tag] == nil then
					self:_refreshTag(tag)
				end
				local list = self.tagLists[tag]
				local set = self.tagSets[tag]
				if list == nil or set == nil then
					return
				end
				if set[instance] == nil then
					set[instance] = true
					list[#list + 1] = instance
					self.tagVersions[tag] = (self.tagVersions[tag] or 0) + 1
					self:_getSignal(tag):Fire(instance, true, tag)
				end
			end)
		end
	end

	local getRemoved = self.provider.GetInstanceRemovedSignal
	if getRemoved ~= nil then
		local ok, signal = pcall(function()
			return getRemoved(self.provider, tag)
		end)
		if ok then
			removedConnection = connectSignal(signal, function(instance: any)
				local list = self.tagLists[tag]
				local set = self.tagSets[tag]
				if list == nil or set == nil then
					return
				end
				if set[instance] ~= nil then
					set[instance] = nil
					for index = #list, 1, -1 do
						if list[index] == instance then
							table.remove(list, index)
							break
						end
					end
					self.tagVersions[tag] = (self.tagVersions[tag] or 0) + 1
					self:_getSignal(tag):Fire(instance, false, tag)
				end
			end)
		end
	end

	self.tagConnections[tag] = { addedConnection, removedConnection }
end

function TagQuery.GetTagged(self: TagQuery, tagRaw: any): { any }
	if typeof(tagRaw) ~= "string" or tagRaw == "" then
		return {}
	end
	if self.tagLists[tagRaw] == nil then
		self:_refreshTag(tagRaw)
	end
	self:_ensureTagSignals(tagRaw)
	return self.tagLists[tagRaw] or {}
end

function TagQuery.HasTag(self: TagQuery, instance: any, tagRaw: any): boolean
	if typeof(tagRaw) ~= "string" or tagRaw == "" then
		return false
	end
	if self.tagSets[tagRaw] == nil then
		self:_refreshTag(tagRaw)
	end
	self:_ensureTagSignals(tagRaw)
	local set = self.tagSets[tagRaw]
	if set ~= nil and set[instance] ~= nil then
		return true
	end
	local hasTag = self.provider.HasTag
	if hasTag ~= nil then
		local ok, result = pcall(hasTag, self.provider, instance, tagRaw)
		if ok and result then
			return true
		end
	end
	return false
end

function TagQuery.GetVersion(self: TagQuery, tagRaw: any): number
	if typeof(tagRaw) ~= "string" then
		return 0
	end
	return self.tagVersions[tagRaw] or 0
end

function TagQuery.Subscribe(self: TagQuery, tagRaw: any, listener: TagListener): () -> ()
	if typeof(tagRaw) ~= "string" or tagRaw == "" then
		return function() end
	end
	if typeof(listener) ~= "function" then
		return function() end
	end

	if self.tagLists[tagRaw] == nil then
		self:_refreshTag(tagRaw)
	end
	self:_ensureTagSignals(tagRaw)
	local connection = self:_getSignal(tagRaw):Connect(listener)

	return function()
		connection:Disconnect()
	end
end

function TagQuery.ObserveTag(self: TagQuery, tagRaw: any, onAdded: ((instance: any, tag: string) -> ())?, onRemoved: ((instance: any, tag: string) -> ())?): () -> ()
	if typeof(tagRaw) ~= "string" or tagRaw == "" then
		return function() end
	end

	if onAdded ~= nil then
		local tagged = self:getTagged(tagRaw)
		for index = 1, #tagged do
			onAdded(tagged[index], tagRaw)
		end
	end

	return self:subscribe(tagRaw, function(instance, isAdded, tag)
		if isAdded then
			if onAdded ~= nil then
				onAdded(instance, tag)
			end
		else
			if onRemoved ~= nil then
				onRemoved(instance, tag)
			end
		end
	end)
end

function TagQuery.Invalidate(self: TagQuery, tagRaw: any?)
	if tagRaw == nil then
		table.clear(self.tagLists)
		table.clear(self.tagSets)
		table.clear(self.tagVersions)
		return
	end
	if typeof(tagRaw) ~= "string" or tagRaw == "" then
		return
	end
	self.tagLists[tagRaw] = nil
	self.tagSets[tagRaw] = nil
	self.tagVersions[tagRaw] = nil
end

function TagQuery.Destroy(self: TagQuery)
	for _, connections in self.tagConnections do
		for _, connection in connections do
			if connection ~= nil then
				pcall(function()
					connection:Disconnect()
				end)
			end
		end
	end
	table.clear(self.tagConnections)
	for _, signal in self.signalsByTag do
		signal:DisconnectAll()
		signal:Destroy()
	end
	table.clear(self.signalsByTag)
	for _, list in self.tagLists do
		clearArray(list)
	end
	table.clear(self.tagLists)
	table.clear(self.tagSets)
	table.clear(self.tagVersions)
end

TagQuery.new = TagQuery.New
TagQuery.getTagged = TagQuery.GetTagged
TagQuery.hasTag = TagQuery.HasTag
TagQuery.getVersion = TagQuery.GetVersion
TagQuery.subscribe = TagQuery.Subscribe
TagQuery.observeTag = TagQuery.ObserveTag
TagQuery.invalidate = TagQuery.Invalidate
TagQuery.destroy = TagQuery.Destroy

return TagQuery
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="1190">
                <Properties>
                  <string name="Name">TickScheduler</string>
                  <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Sift = require(ReplicatedStorage.Packages.Sift)


local TickScheduler = {}
TickScheduler.__index = TickScheduler

TickScheduler.Priority = {
	HIGH = 200,
	NORMAL = 100,
	LOW = 0,
}

export type CancellationToken = {
	id: number,
	cancelled: boolean,
	group: string,
	cancel: (self: CancellationToken) -> (),
}

export type TaskRecord = {
	id: number,
	order: number,
	priority: number,
	group: string,
	callback: (dt: number, now: number, token: CancellationToken) -> (),
	nextRun: number,
	interval: number,
	repeatCount: number,
	useFixedClock: boolean,
	catchUp: boolean,
	token: CancellationToken,
}

export type ScheduleOptions = {
	interval: number?,
	repeatCount: number?,
	priority: number?,
	group: string?,
	fixed: boolean?,
	catchUp: boolean?,
}

export type SchedulerConfig = {
	fixedStep: number?,
}

export type TickScheduler = typeof(setmetatable({} :: any, TickScheduler))

local function clampPriority(valueRaw: any, fallback: number): number
	if typeof(valueRaw) ~= "number" then
		return fallback
	end
	local value = math.floor(valueRaw)
	if value < -1000000 then
		return -1000000
	end
	if value > 1000000 then
		return 1000000
	end
	return value
end

local function clampPositiveNumber(valueRaw: any, fallback: number, minValue: number, maxValue: number): number
	local value = if typeof(valueRaw) == "number" then valueRaw else fallback
	if value < minValue then
		return minValue
	end
	if value > maxValue then
		return maxValue
	end
	return value
end

local function compareDue(a: TaskRecord, b: TaskRecord): boolean
	if a.priority ~= b.priority then
		return a.priority > b.priority
	end
	if a.nextRun ~= b.nextRun then
		return a.nextRun < b.nextRun
	end
	if a.order ~= b.order then
		return a.order < b.order
	end
	return a.id < b.id
end

local function clearArray(array: { any })
	for index = #array, 1, -1 do
		array[index] = nil
	end
end

function TickScheduler.New(configRaw: SchedulerConfig?): TickScheduler
	local config = if typeof(configRaw) == "table" then configRaw else {}
	local fixedStep = clampPositiveNumber(config.fixedStep, 1 / 60, 1 / 240, 1)
	local self = setmetatable({
		now = 0,
		fixedNow = 0,
		fixedStep = fixedStep,
		fixedAccumulator = 0,
		nextTaskId = 0,
		nextOrder = 0,
		tasks = {} :: { [number]: TaskRecord },
		pausedGroups = {} :: { [string]: boolean },
		dueBuffer = {} :: { TaskRecord },
	}, TickScheduler)
	return self
end

function TickScheduler._isGroupPaused(self: TickScheduler, group: string): boolean
	return self.pausedGroups[group] == true
end

function TickScheduler._createToken(self: TickScheduler, id: number, group: string): CancellationToken
	local token = {
		id = id,
		cancelled = false,
		group = group,
	} :: CancellationToken

	function token.Cancel(selfToken: CancellationToken)
		if selfToken.cancelled then
			return
		end
		selfToken.cancelled = true
		self:cancel(selfToken)
	end

	token.cancel = token.Cancel

	return token
end

function TickScheduler.Schedule(self: TickScheduler, callbackRaw: any, delayRaw: any, optionsRaw: ScheduleOptions?): CancellationToken
	if typeof(callbackRaw) ~= "function" then
		error("TickScheduler.Schedule expects a callback")
	end

	local options = if typeof(optionsRaw) == "table" then optionsRaw else {}
	local delay = clampPositiveNumber(delayRaw, 0, 0, 1e9)
	local interval = clampPositiveNumber(options.interval, 0, 0, 1e9)
	local repeatCount = if typeof(options.repeatCount) == "number" then math.floor(options.repeatCount) else 1
	if repeatCount < -1 then
		repeatCount = -1
	end
	if repeatCount == 0 then
		repeatCount = 1
	end

	local group = if typeof(options.group) == "string" and options.group ~= "" then options.group else "default"
	local useFixedClock = options.fixed == true
	local priority = clampPriority(options.priority, TickScheduler.Priority.NORMAL)
	local nowBase = if useFixedClock then self.fixedNow else self.now

	self.nextTaskId += 1
	self.nextOrder += 1
	local taskId = self.nextTaskId
	local token = self:_createToken(taskId, group)

	local task = {
		id = taskId,
		order = self.nextOrder,
		priority = priority,
		group = group,
		callback = callbackRaw,
		nextRun = nowBase + delay,
		interval = interval,
		repeatCount = repeatCount,
		useFixedClock = useFixedClock,
		catchUp = options.catchUp == true,
		token = token,
	} :: TaskRecord
	self.tasks[taskId] = task
	return token
end

function TickScheduler.ScheduleEvery(self: TickScheduler, callbackRaw: any, intervalRaw: any, optionsRaw: ScheduleOptions?): CancellationToken
	local options = if typeof(optionsRaw) == "table" then Sift.Dictionary.copy(optionsRaw) else {}
	options.interval = intervalRaw
	options.repeatCount = -1
	return self:schedule(callbackRaw, intervalRaw, options)
end

function TickScheduler.ScheduleFixed(self: TickScheduler, callbackRaw: any, stepsRaw: any, optionsRaw: ScheduleOptions?): CancellationToken
	local steps = if typeof(stepsRaw) == "number" then math.max(1, math.floor(stepsRaw)) else 1
	local options = if typeof(optionsRaw) == "table" then Sift.Dictionary.copy(optionsRaw) else {}
	options.fixed = true
	options.interval = self.fixedStep * steps
	if options.repeatCount == nil then
		options.repeatCount = -1
	end
	return self:schedule(callbackRaw, options.interval, options)
end

function TickScheduler.Cancel(self: TickScheduler, tokenOrIdRaw: any): boolean
	local taskId: number? = nil
	if typeof(tokenOrIdRaw) == "number" then
		taskId = math.floor(tokenOrIdRaw)
	elseif typeof(tokenOrIdRaw) == "table" and typeof(tokenOrIdRaw.id) == "number" then
		taskId = math.floor(tokenOrIdRaw.id)
		local token = tokenOrIdRaw :: CancellationToken
		token.cancelled = true
	end
	if taskId == nil then
		return false
	end
	local task = self.tasks[taskId]
	if task == nil then
		return false
	end
	task.token.cancelled = true
	self.tasks[taskId] = nil
	return true
end

function TickScheduler.PauseGroup(self: TickScheduler, groupRaw: any)
	if typeof(groupRaw) ~= "string" or groupRaw == "" then
		return
	end
	self.pausedGroups[groupRaw] = true
end

function TickScheduler.ResumeGroup(self: TickScheduler, groupRaw: any)
	if typeof(groupRaw) ~= "string" or groupRaw == "" then
		return
	end
	self.pausedGroups[groupRaw] = nil
end

function TickScheduler.IsGroupPaused(self: TickScheduler, groupRaw: any): boolean
	if typeof(groupRaw) ~= "string" or groupRaw == "" then
		return false
	end
	return self.pausedGroups[groupRaw] == true
end

function TickScheduler.CancelGroup(self: TickScheduler, groupRaw: any): number
	if typeof(groupRaw) ~= "string" or groupRaw == "" then
		return 0
	end
	local cancelled = 0
	for taskId, task in self.tasks do
		if task.group == groupRaw then
			self.tasks[taskId] = nil
			task.token.cancelled = true
			cancelled += 1
		end
	end
	return cancelled
end

function TickScheduler._runClock(self: TickScheduler, nowTime: number, dt: number, useFixedClock: boolean): number
	local due = self.dueBuffer
	clearArray(due)

	for _, task in self.tasks do
		if task == nil or typeof(task) ~= "table" then
			continue
		end
		if task.token == nil then
			continue
		end
		if task.useFixedClock ~= useFixedClock then
			continue
		end
		if task.token.cancelled then
			continue
		end
		if self:_isGroupPaused(task.group) then
			continue
		end
		if task.nextRun <= nowTime then
			due[#due + 1] = task
		end
	end

	if #due == 0 then
		return 0
	end

	table.sort(due, compareDue)
	local fired = 0
	for index = 1, #due do
		local task = due[index]
		if task == nil or typeof(task) ~= "table" then
			continue
		end
		if task.token == nil then
			continue
		end
		if task.token.cancelled then
			continue
		end
		if self.tasks[task.id] == nil then
			continue
		end

		fired += 1
		pcall(task.callback, dt, nowTime, task.token)

		if task.token.cancelled then
			self.tasks[task.id] = nil
			continue
		end

		if task.interval <= 0 then
			self.tasks[task.id] = nil
			task.token.cancelled = true
			continue
		end

		if task.repeatCount > 0 then
			task.repeatCount -= 1
			if task.repeatCount <= 0 then
				self.tasks[task.id] = nil
				task.token.cancelled = true
				continue
			end
		end

		task.nextRun += task.interval
		if not task.catchUp and task.nextRun < nowTime then
			task.nextRun = nowTime + task.interval
		end
	end

	clearArray(due)
	return fired
end

function TickScheduler.Update(self: TickScheduler, dtRaw: any): number
	local dt = if typeof(dtRaw) == "number" and dtRaw > 0 then dtRaw else 0
	if dt <= 0 then
		return 0
	end

	self.now += dt
	local fired = self:_runClock(self.now, dt, false)

	self.fixedAccumulator += dt
	while self.fixedAccumulator >= self.fixedStep do
		self.fixedAccumulator -= self.fixedStep
		self.fixedNow += self.fixedStep
		fired += self:_runClock(self.fixedNow, self.fixedStep, true)
	end

	return fired
end

function TickScheduler.Flush(self: TickScheduler): number
	local fired = 0
	fired += self:_runClock(self.now, 0, false)
	fired += self:_runClock(self.fixedNow, self.fixedStep, true)
	return fired
end

function TickScheduler.GetStats(self: TickScheduler): { [string]: number }
	local active = 0
	local fixed = 0
	local variable = 0
	for _, task in self.tasks do
		if task == nil or typeof(task) ~= "table" or task.token == nil then
			continue
		end
		if task.token.cancelled then
			continue
		end
		active += 1
		if task.useFixedClock then
			fixed += 1
		else
			variable += 1
		end
	end
	return {
		now = self.now,
		fixedNow = self.fixedNow,
		fixedAccumulator = self.fixedAccumulator,
		activeTasks = active,
		fixedTasks = fixed,
		variableTasks = variable,
	}
end

function TickScheduler.Clear(self: TickScheduler)
	for _, task in self.tasks do
		if task == nil or typeof(task) ~= "table" or task.token == nil then
			continue
		end
		task.token.cancelled = true
	end
	table.clear(self.tasks)
	table.clear(self.pausedGroups)
end

TickScheduler.new = TickScheduler.New
TickScheduler.schedule = TickScheduler.Schedule
TickScheduler.scheduleEvery = TickScheduler.ScheduleEvery
TickScheduler.scheduleFixed = TickScheduler.ScheduleFixed
TickScheduler.cancel = TickScheduler.Cancel
TickScheduler.pauseGroup = TickScheduler.PauseGroup
TickScheduler.resumeGroup = TickScheduler.ResumeGroup
TickScheduler.isGroupPaused = TickScheduler.IsGroupPaused
TickScheduler.cancelGroup = TickScheduler.CancelGroup
TickScheduler.update = TickScheduler.Update
TickScheduler.flush = TickScheduler.Flush
TickScheduler.getStats = TickScheduler.GetStats
TickScheduler.clear = TickScheduler.Clear

return TickScheduler
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="1191">
                <Properties>
                  <string name="Name">TileMetadataRegistry</string>
                  <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Sift = require(ReplicatedStorage.Packages.Sift)


local Codec = require(script.Parent.Codec)

local TileMetadataRegistry = {}
TileMetadataRegistry.__index = TileMetadataRegistry

export type DropDefinition = {
	itemId: string,
	minAmount: number?,
	maxAmount: number?,
	chance: number?,
}

export type TileMetadata = {
	id: string,
	hardness: number,
	drops: { DropDefinition },
	flags: number,
	corruptionSusceptibility: number,
	lightBlocking: number,
	toolTier: number,
	attributes: { [string]: any },
}

export type TileMetadataRegistry = typeof(setmetatable({} :: any, TileMetadataRegistry))

local MAX_FLAGS = 31

local function clampNumber(valueRaw: any, fallback: number, minValue: number, maxValue: number): number
	local value = if typeof(valueRaw) == "number" then valueRaw else fallback
	if value < minValue then
		return minValue
	end
	if value > maxValue then
		return maxValue
	end
	return value
end

local function clampInteger(valueRaw: any, fallback: number, minValue: number, maxValue: number): number
	local value = if typeof(valueRaw) == "number" then math.floor(valueRaw) else fallback
	if value < minValue then
		return minValue
	end
	if value > maxValue then
		return maxValue
	end
	return value
end

local function sanitizeDrop(dropRaw: any): DropDefinition?
	if typeof(dropRaw) ~= "table" then
		return nil
	end
	local itemId = if typeof(dropRaw.itemId) == "string" then dropRaw.itemId else ""
	if itemId == "" then
		return nil
	end
	local minAmount = clampInteger(dropRaw.minAmount, 1, 1, 999999)
	local maxAmount = clampInteger(dropRaw.maxAmount, minAmount, minAmount, 999999)
	local chance = clampNumber(dropRaw.chance, 1, 0, 1)
	return {
		itemId = itemId,
		minAmount = minAmount,
		maxAmount = maxAmount,
		chance = chance,
	}
end

local function sortIds(a: string, b: string): boolean
	return a < b
end

function TileMetadataRegistry.New(initialTilesRaw: any?): TileMetadataRegistry
	local self = setmetatable({
		entries = {} :: { [string]: TileMetadata },
		idOrder = {} :: { string },
		flagLayout = {} :: { [string]: number },
		nextFlagIndex = 1,
	}, TileMetadataRegistry)

	if typeof(initialTilesRaw) == "table" then
		for tileId, metadata in initialTilesRaw do
			if typeof(tileId) == "string" then
				self:register(tileId, metadata)
			end
		end
	end

	return self
end

function TileMetadataRegistry.DefineFlag(self: TileMetadataRegistry, flagNameRaw: any, bitIndexRaw: any?): number
	if typeof(flagNameRaw) ~= "string" or flagNameRaw == "" then
		return 0
	end
	local existing = self.flagLayout[flagNameRaw]
	if existing ~= nil then
		return existing
	end

	local bitIndex = if bitIndexRaw ~= nil then clampInteger(bitIndexRaw, self.nextFlagIndex, 1, MAX_FLAGS) else self.nextFlagIndex
	self.flagLayout[flagNameRaw] = bitIndex
	if bitIndex >= self.nextFlagIndex then
		self.nextFlagIndex = math.min(MAX_FLAGS + 1, bitIndex + 1)
	end
	return bitIndex
end

function TileMetadataRegistry.EncodeFlags(self: TileMetadataRegistry, flagsRaw: any): number
	if typeof(flagsRaw) ~= "table" then
		return 0
	end
	local namedFlags = {}
	for flagName, enabled in flagsRaw do
		if typeof(flagName) == "string" and enabled then
			if self.flagLayout[flagName] == nil then
				self:defineFlag(flagName)
			end
			namedFlags[flagName] = true
		end
	end
	return Codec.packNamedBitmask(self.flagLayout, namedFlags)
end

function TileMetadataRegistry.DecodeFlags(self: TileMetadataRegistry, bitmaskRaw: any): { [string]: boolean }
	return Codec.unpackNamedBitmask(self.flagLayout, bitmaskRaw)
end

function TileMetadataRegistry.Register(self: TileMetadataRegistry, tileIdRaw: any, metadataRaw: any): boolean
	if typeof(tileIdRaw) ~= "string" or tileIdRaw == "" then
		return false
	end
	if typeof(metadataRaw) ~= "table" then
		return false
	end

	local drops = {}
	if typeof(metadataRaw.drops) == "table" then
		for _, rawDrop in metadataRaw.drops do
			local drop = sanitizeDrop(rawDrop)
			if drop ~= nil then
				drops[#drops + 1] = drop
			end
		end
	end

	local flags = 0
	if typeof(metadataRaw.flags) == "number" then
		flags = clampInteger(metadataRaw.flags, 0, 0, 2147483647)
	elseif typeof(metadataRaw.flags) == "table" then
		flags = self:encodeFlags(metadataRaw.flags)
	end

	local entry = {
		id = tileIdRaw,
		hardness = clampNumber(metadataRaw.hardness, 1, 0, 1000000),
		drops = drops,
		flags = flags,
		corruptionSusceptibility = clampNumber(metadataRaw.corruptionSusceptibility, 0, 0, 1),
		lightBlocking = clampNumber(metadataRaw.lightBlocking, 0, 0, 1),
		toolTier = clampInteger(metadataRaw.toolTier, 0, 0, 100),
		attributes = if typeof(metadataRaw.attributes) == "table" then Sift.Dictionary.copy(metadataRaw.attributes) else {},
	} :: TileMetadata

	local hadExisting = self.entries[tileIdRaw] ~= nil
	self.entries[tileIdRaw] = entry
	if not hadExisting then
		self.idOrder[#self.idOrder + 1] = tileIdRaw
		table.sort(self.idOrder, sortIds)
	end
	return true
end

function TileMetadataRegistry.RegisterBatch(self: TileMetadataRegistry, entriesRaw: any)
	if typeof(entriesRaw) ~= "table" then
		return
	end
	for tileId, metadata in entriesRaw do
		if typeof(tileId) == "string" then
			self:register(tileId, metadata)
		end
	end
end

function TileMetadataRegistry.Get(self: TileMetadataRegistry, tileIdRaw: any): TileMetadata?
	if typeof(tileIdRaw) ~= "string" then
		return nil
	end
	return self.entries[tileIdRaw]
end

function TileMetadataRegistry.Require(self: TileMetadataRegistry, tileIdRaw: any): TileMetadata
	local metadata = self:get(tileIdRaw)
	if metadata == nil then
		error(string.format("TileMetadataRegistry missing tile '%s'", tostring(tileIdRaw)))
	end
	return metadata
end

function TileMetadataRegistry.HasFlag(self: TileMetadataRegistry, tileIdRaw: any, flagNameRaw: any): boolean
	if typeof(tileIdRaw) ~= "string" or typeof(flagNameRaw) ~= "string" then
		return false
	end
	local metadata = self.entries[tileIdRaw]
	if metadata == nil then
		return false
	end
	local bitIndex = self.flagLayout[flagNameRaw]
	if bitIndex == nil then
		return false
	end
	local mask = bit32.lshift(1, bitIndex - 1)
	return bit32.band(metadata.flags, mask) ~= 0
end

function TileMetadataRegistry.ListIds(self: TileMetadataRegistry): { string }
	return Sift.Dictionary.copy(self.idOrder)
end

function TileMetadataRegistry.GetDrops(self: TileMetadataRegistry, tileIdRaw: any, rngRaw: any?): { [string]: number }
	local out = {}
	local metadata = self:get(tileIdRaw)
	if metadata == nil then
		return out
	end
	if #metadata.drops == 0 then
		return out
	end

	local rng = rngRaw
	for _, drop in metadata.drops do
		local chance = clampNumber(drop.chance, 1, 0, 1)
		local roll = 0
		if rng ~= nil and typeof((rng :: any).nextNumber) == "function" then
			roll = (rng :: any):nextNumber()
		else
			roll = if chance >= 1 then 0 else 1
		end
		if roll <= chance then
			local minAmount = clampInteger(drop.minAmount, 1, 1, 999999)
			local maxAmount = clampInteger(drop.maxAmount, minAmount, minAmount, 999999)
			local amount = minAmount
			if maxAmount > minAmount then
				if rng ~= nil and typeof((rng :: any).nextInteger) == "function" then
					amount = (rng :: any):nextInteger(minAmount, maxAmount)
				else
					amount = minAmount
				end
			end
			out[drop.itemId] = (out[drop.itemId] or 0) + amount
		end
	end

	return out
end

function TileMetadataRegistry.Snapshot(self: TileMetadataRegistry): { [string]: TileMetadata }
	local out = {}
	for _, tileId in self.idOrder do
		local metadata = self.entries[tileId]
		if metadata ~= nil then
			out[tileId] = {
				id = metadata.id,
				hardness = metadata.hardness,
				drops = Sift.Dictionary.copy(metadata.drops),
				flags = metadata.flags,
				corruptionSusceptibility = metadata.corruptionSusceptibility,
				lightBlocking = metadata.lightBlocking,
				toolTier = metadata.toolTier,
				attributes = Sift.Dictionary.copy(metadata.attributes),
			}
		end
	end
	return out
end

TileMetadataRegistry.new = TileMetadataRegistry.New
TileMetadataRegistry.defineFlag = TileMetadataRegistry.DefineFlag
TileMetadataRegistry.encodeFlags = TileMetadataRegistry.EncodeFlags
TileMetadataRegistry.decodeFlags = TileMetadataRegistry.DecodeFlags
TileMetadataRegistry.register = TileMetadataRegistry.Register
TileMetadataRegistry.registerBatch = TileMetadataRegistry.RegisterBatch
TileMetadataRegistry.get = TileMetadataRegistry.Get
TileMetadataRegistry.require = TileMetadataRegistry.Require
TileMetadataRegistry.hasFlag = TileMetadataRegistry.HasFlag
TileMetadataRegistry.listIds = TileMetadataRegistry.ListIds
TileMetadataRegistry.getDrops = TileMetadataRegistry.GetDrops
TileMetadataRegistry.snapshot = TileMetadataRegistry.Snapshot

return TileMetadataRegistry
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="1192">
                <Properties>
                  <string name="Name">TileVisibilityResolver</string>
                  <string name="Source"><![CDATA[--!strict

export type TileLookup = (worldX: number, worldY: number, layer: any?) -> any?

export type ChunkLike = {
	chunkX: number?,
	chunkY: number?,
	tileMinX: number,
	tileMinY: number,
	width: number,
	height: number,
	tiles: { any },
}

export type ResolverOptions = {
	airTileId: number?,
	tileMinX: number?,
	tileMinY: number?,
	layer: any?,
	includeDiagonals: boolean?,
	missingIsVisible: boolean?,
	transparentTileIds: { [number]: boolean }?,
	getTileAtWorldCell: TileLookup?,
}

export type DirtyWorldCell = {
	tileX: number,
	tileY: number,
}

export type DirtyBounds = {
	minTileX: number,
	minTileY: number,
	maxTileX: number,
	maxTileY: number,
}

local TileVisibilityResolver = {}

local DEFAULT_AIR_TILE_ID = 0
local CARDINAL_OFFSETS = {
	{ x = -1, y = 0 },
	{ x = 1, y = 0 },
	{ x = 0, y = -1 },
	{ x = 0, y = 1 },
}
local DIAGONAL_OFFSETS = {
	{ x = -1, y = -1 },
	{ x = 1, y = -1 },
	{ x = -1, y = 1 },
	{ x = 1, y = 1 },
}

local function isFiniteNumber(value: any): boolean
	return typeof(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

local function resolveAirTileId(options: ResolverOptions?): number
	if options ~= nil and isFiniteNumber(options.airTileId) then
		return math.floor(options.airTileId :: number)
	end
	return DEFAULT_AIR_TILE_ID
end

local function resolveTileId(tileRaw: any): number?
	if isFiniteNumber(tileRaw) then
		return math.floor(tileRaw :: number)
	end
	if typeof(tileRaw) ~= "table" then
		return nil
	end

	local tile = tileRaw :: { [any]: any }
	local idRaw = tile.id or tile.tileId or tile.TileId or tile.value
	if isFiniteNumber(idRaw) then
		return math.floor(idRaw :: number)
	end
	if tile.solid == false or tile.isSolid == false then
		return DEFAULT_AIR_TILE_ID
	end
	return nil
end

function TileVisibilityResolver.ComputeTileIndex(localX: number, localY: number, width: number): number
	return localY * width + localX + 1
end

function TileVisibilityResolver.PackChunkKey(chunkX: number, chunkY: number): string
	return `{chunkX}:{chunkY}`
end

function TileVisibilityResolver.ToChunkCoordinate(tile: number, chunkSize: number): number
	return math.floor(tile / math.max(1, math.floor(chunkSize)))
end

function TileVisibilityResolver.IsTileOpaque(tileRaw: any, options: ResolverOptions?): boolean
	if tileRaw == nil then
		return options ~= nil and options.missingIsVisible == false
	end

	if typeof(tileRaw) == "table" then
		local tile = tileRaw :: { [any]: any }
		if tile.opaque ~= nil then
			return tile.opaque == true
		end
		if tile.isOpaque ~= nil then
			return tile.isOpaque == true
		end
		if tile.solid ~= nil then
			return tile.solid == true
		end
		if tile.isSolid ~= nil then
			return tile.isSolid == true
		end
	end

	local tileId = resolveTileId(tileRaw)
	if tileId == nil then
		return false
	end

	local transparentTileIds = if options ~= nil then options.transparentTileIds else nil
	if transparentTileIds ~= nil and transparentTileIds[tileId] == true then
		return false
	end

	return tileId ~= resolveAirTileId(options)
end

function TileVisibilityResolver.GetTileAtChunkCell(
	chunksByKey: { [string]: ChunkLike },
	chunkX: number,
	chunkY: number,
	localX: number,
	localY: number
): any?
	local chunk = chunksByKey[TileVisibilityResolver.PackChunkKey(chunkX, chunkY)]
	if chunk == nil then
		return nil
	end
	if localX < 0 or localX >= chunk.width or localY < 0 or localY >= chunk.height then
		return nil
	end
	return chunk.tiles[TileVisibilityResolver.ComputeTileIndex(localX, localY, chunk.width)]
end

function TileVisibilityResolver.GetTileAtWorldCell(
	chunksByKey: { [string]: ChunkLike },
	worldX: number,
	worldY: number,
	chunkSize: number
): any?
	local chunkX = TileVisibilityResolver.ToChunkCoordinate(worldX, chunkSize)
	local chunkY = TileVisibilityResolver.ToChunkCoordinate(worldY, chunkSize)
	local chunk = chunksByKey[TileVisibilityResolver.PackChunkKey(chunkX, chunkY)]
	if chunk == nil then
		return nil
	end

	local localX = worldX - chunk.tileMinX
	local localY = worldY - chunk.tileMinY
	if localX < 0 or localX >= chunk.width or localY < 0 or localY >= chunk.height then
		return nil
	end

	return chunk.tiles[TileVisibilityResolver.ComputeTileIndex(localX, localY, chunk.width)]
end

function TileVisibilityResolver.ResolveNeighborTile(
	chunksByKey: { [string]: ChunkLike },
	chunk: ChunkLike,
	localX: number,
	localY: number,
	deltaX: number,
	deltaY: number,
	chunkSize: number
): any?
	local worldX = chunk.tileMinX + localX + deltaX
	local worldY = chunk.tileMinY + localY + deltaY
	return TileVisibilityResolver.GetTileAtWorldCell(chunksByKey, worldX, worldY, chunkSize)
end

function TileVisibilityResolver.ShouldRenderTile(tileRaw: any, worldX: number, worldY: number, options: ResolverOptions?): boolean
	if not TileVisibilityResolver.IsTileOpaque(tileRaw, options) then
		return false
	end

	local lookup = if options ~= nil then options.getTileAtWorldCell else nil
	if lookup == nil then
		return true
	end

	local layer = if options ~= nil then options.layer else nil
	for _, offset in CARDINAL_OFFSETS do
		local neighbor = lookup(worldX + offset.x, worldY + offset.y, layer)
		if not TileVisibilityResolver.IsTileOpaque(neighbor, options) then
			return true
		end
	end

	if options ~= nil and options.includeDiagonals == true then
		for _, offset in DIAGONAL_OFFSETS do
			local neighbor = lookup(worldX + offset.x, worldY + offset.y, layer)
			if not TileVisibilityResolver.IsTileOpaque(neighbor, options) then
				return true
			end
		end
	end

	return false
end

function TileVisibilityResolver.BuildVisibleTileMask(
	tiles: { any },
	width: number,
	height: number,
	options: ResolverOptions?
): ({ boolean }, number)
	local tileMinX = if options ~= nil and isFiniteNumber(options.tileMinX) then options.tileMinX :: number else 0
	local tileMinY = if options ~= nil and isFiniteNumber(options.tileMinY) then options.tileMinY :: number else 0
	local tileCount = math.max(0, width * height)
	local visible = table.create(tileCount, false) :: { boolean }
	local visibleCount = 0

	for localY = 0, height - 1 do
		for localX = 0, width - 1 do
			local index = TileVisibilityResolver.ComputeTileIndex(localX, localY, width)
			if TileVisibilityResolver.ShouldRenderTile(tiles[index], tileMinX + localX, tileMinY + localY, options) then
				visible[index] = true
				visibleCount += 1
			end
		end
	end

	return visible, visibleCount
end

function TileVisibilityResolver.BuildVisibleTileValues(
	tiles: { number },
	width: number,
	height: number,
	options: ResolverOptions?
): ({ number }, { boolean }, number)
	local visibleMask, visibleCount = TileVisibilityResolver.BuildVisibleTileMask(tiles, width, height, options)
	local airTileId = resolveAirTileId(options)
	local visibleTiles = table.create(math.max(0, width * height), airTileId) :: { number }

	for index, isVisible in visibleMask do
		if isVisible then
			visibleTiles[index] = tiles[index] or airTileId
		end
	end

	return visibleTiles, visibleMask, visibleCount
end

function TileVisibilityResolver.CollectVisibilityDirtyWorldCells(
	tileX: number,
	tileY: number,
	includeDiagonals: boolean?
): { DirtyWorldCell }
	local cells = {
		{ tileX = tileX, tileY = tileY },
	} :: { DirtyWorldCell }

	for _, offset in CARDINAL_OFFSETS do
		table.insert(cells, {
			tileX = tileX + offset.x,
			tileY = tileY + offset.y,
		})
	end

	if includeDiagonals == true then
		for _, offset in DIAGONAL_OFFSETS do
			table.insert(cells, {
				tileX = tileX + offset.x,
				tileY = tileY + offset.y,
			})
		end
	end

	return cells
end

function TileVisibilityResolver.ComputeDirtyBounds(
	tileX: number,
	tileY: number,
	includeDiagonals: boolean?
): DirtyBounds
	local minTileX = tileX
	local minTileY = tileY
	local maxTileX = tileX
	local maxTileY = tileY

	for _, cell in TileVisibilityResolver.CollectVisibilityDirtyWorldCells(tileX, tileY, includeDiagonals) do
		minTileX = math.min(minTileX, cell.tileX)
		minTileY = math.min(minTileY, cell.tileY)
		maxTileX = math.max(maxTileX, cell.tileX)
		maxTileY = math.max(maxTileY, cell.tileY)
	end

	return {
		minTileX = minTileX,
		minTileY = minTileY,
		maxTileX = maxTileX,
		maxTileY = maxTileY,
	}
end

TileVisibilityResolver.computeTileIndex = TileVisibilityResolver.ComputeTileIndex
TileVisibilityResolver.packChunkKey = TileVisibilityResolver.PackChunkKey
TileVisibilityResolver.toChunkCoordinate = TileVisibilityResolver.ToChunkCoordinate
TileVisibilityResolver.isTileOpaque = TileVisibilityResolver.IsTileOpaque
TileVisibilityResolver.getTileAtChunkCell = TileVisibilityResolver.GetTileAtChunkCell
TileVisibilityResolver.getTileAtWorldCell = TileVisibilityResolver.GetTileAtWorldCell
TileVisibilityResolver.resolveNeighborTile = TileVisibilityResolver.ResolveNeighborTile
TileVisibilityResolver.shouldRenderTile = TileVisibilityResolver.ShouldRenderTile
TileVisibilityResolver.buildVisibleTileMask = TileVisibilityResolver.BuildVisibleTileMask
TileVisibilityResolver.buildVisibleTileValues = TileVisibilityResolver.BuildVisibleTileValues
TileVisibilityResolver.collectVisibilityDirtyWorldCells = TileVisibilityResolver.CollectVisibilityDirtyWorldCells
TileVisibilityResolver.computeDirtyBounds = TileVisibilityResolver.ComputeDirtyBounds

return TileVisibilityResolver
]]></string>
