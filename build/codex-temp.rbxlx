                    <string name="Name">jest-fake-timers</string>
                    <string name="Source"><![CDATA[--!nonstrict
-- ROBLOX derived from: https://github.com/facebook/jest/blob/v28.0.0/packages/jest-fake-timers/src/modernFakeTimers.ts
--[[
