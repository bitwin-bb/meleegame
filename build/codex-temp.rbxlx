	deferredChunks: number,
	chunkReadinessWakeups: number,
	collisionChunksLoaded: number,
}

local LiquidServiceServer = {}

local function isGameplayReplicationActive(player: Player): boolean
	local activeCheck = (PlayerServiceServer :: any).isGameplayActiveForPlayer
	if typeof(activeCheck) ~= "function" then
		return true
	end
	local ok, isActive = pcall(function()
		return (PlayerServiceServer :: any):isGameplayActiveForPlayer(player)
	end)
	return ok and isActive == true
end

local LIQUID_TYPE = LiquidServiceUtils.LIQUID_TYPE
local CELL_DEBUG_STATE = LiquidServiceUtils.CELL_DEBUG_STATE
local LiquidCell = LiquidServiceUtils.LiquidCell
local LiquidQuery = LiquidServiceUtils.LiquidQuery
local LiquidDamage = LiquidServiceUtils.LiquidDamage
local LiquidSolver = LiquidServiceUtils.LiquidSolver

local FULL_SNAPSHOT_BUDGET_PER_PLAYER = 3
local QUERY_CACHE_WINDOW = 1 / 30
local CELL_DEBUG_PART_DEPTH = 0.08

local CELL_DEBUG_COLORS = {
	[CELL_DEBUG_STATE.ACTIVE] = Color3.fromRGB(255, 255, 255),
	[CELL_DEBUG_STATE.STABLE] = Color3.fromRGB(94, 218, 122),
	[CELL_DEBUG_STATE.BLOCKED] = Color3.fromRGB(133, 144, 156),
	[CELL_DEBUG_STATE.BLOCKED_BY_LOADED_TERRAIN] = Color3.fromRGB(83, 101, 120),
	[CELL_DEBUG_STATE.DEFERRED_WAITING_FOR_CHUNK] = Color3.fromRGB(255, 153, 71),
	[CELL_DEBUG_STATE.SEARCHING_LEAK_PATH] = Color3.fromRGB(255, 216, 84),
	[CELL_DEBUG_STATE.FALLING] = Color3.fromRGB(88, 196, 255),
	[CELL_DEBUG_STATE.EQUALIZING] = Color3.fromRGB(112, 154, 255),
}

local function isFiniteNumber(value: any): boolean
	return typeof(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

local function resolveSourceConfig(): any
	if typeof(Configs) ~= "table" then
		return nil
	end
	return (Configs :: any).liquid
end

local function createStringQueue(): ({ string }, number, number, { [string]: boolean })
	return {}, 1, 0, {}
end

local function enqueueString(queue: { string }, queueLookup: { [string]: boolean }, tail: number, value: string): number
	if queueLookup[value] then
		return tail
	end
	queueLookup[value] = true
	tail += 1
	queue[tail] = value
	return tail
end

local function dequeueString(
	queue: { string },
	queueLookup: { [string]: boolean },
	head: number,
	tail: number
): (string?, number, number)
	if head > tail then
		if head ~= 1 or tail ~= 0 then
			table.clear(queue)
			head = 1
			tail = 0
		end
		return nil, head, tail
	end
	local value = queue[head]
	queue[head] = nil
	head += 1
	if value ~= nil then
		queueLookup[value] = nil
	end
	if head > tail then
		table.clear(queue)
		head = 1
		tail = 0
	end
	return value, head, tail
end

local function sanitizeChunkDebugName(chunkKey: string): string
	return string.gsub(chunkKey, ":", "_")
end

local function getDirtyCount(runtime: ChunkRuntime): number
	return math.max(0, runtime.queuedDirtyCount)
end

local function appendReason(reasons: { string }, label: string)
	for _, existing in reasons do
		if existing == label then
			return
		end
	end
	table.insert(reasons, label)
end

local function createSimulationTickStats(): SimulationTickStats
	return {
		activeChunks = 0,
		dirtyChunks = 0,
		queuedCells = 0,
		wakeRequestsQueued = 0,
		wakeRequestsProcessed = 0,
		activeCells = 0,
		cellsProcessed = 0,
		crossChunkWakeups = 0,
		downwardTransfers = 0,
		lateralTransfers = 0,
		solverIterations = 0,
		consistencyRequeues = 0,
		deferredChunks = 0,
		chunkReadinessWakeups = 0,
		collisionChunksLoaded = 0,
	}
end

local function resolvePlayerCharacter(player: Player): Model?
	local character = player.Character
	if character ~= nil and character:IsA("Model") then
		return character
	end
	return nil
end

local function resolveCharacterRootPart(character: Model?): BasePart?
	if character == nil then
		return nil
	end
	local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
	if humanoidRootPart ~= nil and humanoidRootPart:IsA("BasePart") then
		return humanoidRootPart
	end
	if character.PrimaryPart ~= nil then
		return character.PrimaryPart
	end
	for _, descendant in character:GetDescendants() do
		if descendant:IsA("BasePart") then
			return descendant
		end
	end
	return nil
end

local function resolveCharacterHumanoid(character: Model?): Humanoid?
	if character == nil then
		return nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid ~= nil and humanoid:IsA("Humanoid") then
		return humanoid
	end
	return nil
end

function LiquidServiceServer:CreateChunkRuntime(chunkKey: string): ChunkRuntime
	local runtime: ChunkRuntime = {
		key = chunkKey,
		revision = 1,
		dirtyLookup = {},
		queuedDirtyCount = 0,
		pendingDeltaByIndex = {},
		pendingDeltaIndices = {},
		pendingDeltaCount = 0,
		forceFullResync = false,
		lastDisturbedAt = -math.huge,
		lastActiveStepId = 0,
		lastActivationAt = -math.huge,
		lastActivationReason = "never",
		lastStableAt = -math.huge,
		lastStableReason = "never",
		lastProcessedAt = -math.huge,
		lastProcessedCells = 0,
		lastChangedCells = 0,
		lastPrimedCells = 0,
		dirtyMarkCount = 0,
		mutationCount = 0,
		lastMutationTileX = 0,
		lastMutationTileY = 0,
		lastMutationFill = 0,
		lastMutationType = LIQUID_TYPE.NONE,
		lastActiveCellCount = 0,
		lastDownwardTransfer = 0,
		lastLateralTransfer = 0,
		lastCrossChunkWakeups = 0,
		lastStabilityScanUnstableCells = 0,
		waitingOnChunkReady = false,
		dependencyChunkKey = "",
		lastDeferredAt = -math.huge,
		lastDeferredReason = "never",
		regionState = CELL_DEBUG_STATE.ACTIVE,
		regionReason = "initial",
	}
	return runtime
end

function LiquidServiceServer:GetChunkRuntime(chunkKey: string): ChunkRuntime
	local runtime = self.chunkRuntimes[chunkKey]
	if runtime ~= nil then
		return runtime
	end
	runtime = self:createChunkRuntime(chunkKey)
	self.chunkRuntimes[chunkKey] = runtime
	return runtime
end

function LiquidServiceServer:IsCollisionChunkReadyByKey(chunkKey: string): boolean
	local world = self.world
	if world == nil then
		return false
	end
	local readinessMethod = (world :: any).isChunkCollisionReadyByKey
	if typeof(readinessMethod) == "function" then
		return readinessMethod(world, chunkKey) == true
	end
	return true
end

function LiquidServiceServer:GetLoadedCollisionChunkCount(): number
	local world = self.world
	if world == nil then
		return 0
	end
	local countMethod = (world :: any).getLoadedCollisionChunkCount
	if typeof(countMethod) == "function" then
		local count = countMethod(world)
		if isFiniteNumber(count) then
			return math.max(0, math.floor(count))
		end
	end
	return 0
end

function LiquidServiceServer:SetChunkRegionState(
	chunkKey: string,
	runtime: ChunkRuntime,
	state: string,
	reasonRaw: any?,
	dependencyChunkKeyRaw: any?
)
	local reason = if typeof(reasonRaw) == "string" and reasonRaw ~= "" then reasonRaw else state
	runtime.regionState = state
	runtime.regionReason = reason
	if state == CELL_DEBUG_STATE.DEFERRED_WAITING_FOR_CHUNK then
		runtime.waitingOnChunkReady = true
		runtime.dependencyChunkKey = if typeof(dependencyChunkKeyRaw) == "string" then dependencyChunkKeyRaw else ""
		runtime.lastDeferredAt = os.clock()
		runtime.lastDeferredReason = reason
	else
		runtime.waitingOnChunkReady = false
		runtime.dependencyChunkKey = ""
	end
	self:updateChunkDebugAttributes(chunkKey, runtime)
end

function LiquidServiceServer:RestoreQueuedDirtyCellsForChunk(chunkKey: string, reasonRaw: any?): number
	local runtime = self.chunkRuntimes[chunkKey]
	if runtime == nil or getDirtyCount(runtime) <= 0 then
		return 0
	end
	local snapshot = self:getChunkSnapshot(chunkKey)
	if snapshot == nil then
		return 0
	end
	local reason = if typeof(reasonRaw) == "string" and reasonRaw ~= "" then reasonRaw else "chunkReady"
	local requeued = 0
	for index in runtime.dirtyLookup do
		local zeroIndex = index - 1
		local localY = math.floor(zeroIndex / snapshot.width)
		local localX = zeroIndex - localY * snapshot.width
		self:requeueDirtyMutation({
			x = snapshot.tileMinX + localX,
			y = snapshot.tileMinY + localY,
			z = 0,
			tileId = 1,
			metadata = {
				chunkKey = chunkKey,
				reason = reason,
			},
		})
		requeued += 1
	end
	return requeued
end

function LiquidServiceServer:WakeChunkBounds(
	chunkX: number,
	chunkY: number,
	dirtyBoundsRaw: any?,
	reasonRaw: any?,
	sourceTileXRaw: any?,
	sourceTileYRaw: any?
)
	local world = self.world
	if world == nil then
		return 0
	end
	local dirtyBounds = if typeof(dirtyBoundsRaw) == "table" then dirtyBoundsRaw :: { [string]: any } else {}
	local chunkMinX = chunkX * world.chunkSize
	local chunkMinY = chunkY * world.chunkSize
	local chunkMaxX = chunkMinX + world.chunkSize - 1
	local chunkMaxY = chunkMinY + world.chunkSize - 1
	local minTileX = if isFiniteNumber(dirtyBounds.minTileX) then math.floor(dirtyBounds.minTileX) else chunkMinX
	local minTileY = if isFiniteNumber(dirtyBounds.minTileY) then math.floor(dirtyBounds.minTileY) else chunkMinY
	local maxTileX = if isFiniteNumber(dirtyBounds.maxTileX) then math.floor(dirtyBounds.maxTileX) else chunkMaxX
	local maxTileY = if isFiniteNumber(dirtyBounds.maxTileY) then math.floor(dirtyBounds.maxTileY) else chunkMaxY
	local sourceTileX = if isFiniteNumber(sourceTileXRaw) then math.floor(sourceTileXRaw) else nil
	local sourceTileY = if isFiniteNumber(sourceTileYRaw) then math.floor(sourceTileYRaw) else nil
	local reason = if typeof(reasonRaw) == "string" and reasonRaw ~= "" then reasonRaw else "chunkWake"
	local marked = 0

	for tileY = math.max(chunkMinY, minTileY), math.min(chunkMaxY, maxTileY) do
		for tileX = math.max(chunkMinX, minTileX), math.min(chunkMaxX, maxTileX) do
			if self:markTileDirty(tileX, tileY, reason, sourceTileX, sourceTileY) then
				marked += 1
			end
		end
	end

	return marked
end

function LiquidServiceServer:WakeChunkDependencyNeighborhood(chunkX: number, chunkY: number, reasonRaw: any?)
	local world = self.world
	if world == nil then
		return
	end
	local reason = if typeof(reasonRaw) == "string" and reasonRaw ~= "" then reasonRaw else "chunkReady"
	for offsetY = -1, 1 do
		for offsetX = -1, 1 do
			local neighborChunkX = chunkX + offsetX
			local neighborChunkY = chunkY + offsetY
			local neighborKey = LiquidServiceUtils.packChunkKey(neighborChunkX, neighborChunkY)
			local runtime = if offsetX == 0 and offsetY == 0
				then self:getChunkRuntime(neighborKey)
				else self.chunkRuntimes[neighborKey]
			if self:isCollisionChunkReadyByKey(neighborKey) then
				if runtime == nil then
					continue
				end
				local restored = self:restoreQueuedDirtyCellsForChunk(neighborKey, `{reason}:restoreDirty`)
				if restored == 0 then
					self:primeChunkRuntime(neighborKey, reason)
				end
				self:setChunkRegionState(neighborKey, runtime, CELL_DEBUG_STATE.ACTIVE, reason)
			else
				if runtime == nil then
					continue
				end
				self:setChunkRegionState(
					neighborKey,
					runtime,
					CELL_DEBUG_STATE.DEFERRED_WAITING_FOR_CHUNK,
					`awaitingCollisionChunk {neighborKey}`,
					neighborKey
				)
			end
		end
	end
end

function LiquidServiceServer:OnChunkCollisionReady(chunkXRaw: any, chunkYRaw: any, contextRaw: any?)
	if not isFiniteNumber(chunkXRaw) or not isFiniteNumber(chunkYRaw) then
		return
	end
	local chunkX = math.floor(chunkXRaw)
	local chunkY = math.floor(chunkYRaw)
	local chunkKey = LiquidServiceUtils.packChunkKey(chunkX, chunkY)
	local context = if typeof(contextRaw) == "table" then contextRaw :: { [string]: any } else {}
	self.pendingChunkReadinessWakeups += 1
	self:debugLog(
		"logActivations",
		`{chunkKey} collision-ready ({if typeof(context.reason) == "string" then context.reason else "ready"})`
	)
	self:wakeChunkDependencyNeighborhood(chunkX, chunkY, "chunkCollisionReady")
end

function LiquidServiceServer:OnChunkCollisionUnloaded(chunkXRaw: any, chunkYRaw: any, _contextRaw: any?)
	if not isFiniteNumber(chunkXRaw) or not isFiniteNumber(chunkYRaw) then
		return
	end
	local chunkX = math.floor(chunkXRaw)
	local chunkY = math.floor(chunkYRaw)
	local chunkKey = LiquidServiceUtils.packChunkKey(chunkX, chunkY)
	local runtime = self:getChunkRuntime(chunkKey)
	self:setChunkRegionState(
		chunkKey,
		runtime,
		CELL_DEBUG_STATE.DEFERRED_WAITING_FOR_CHUNK,
		`awaitingCollisionChunk {chunkKey}`,
		chunkKey
	)
	self:debugLog("logStableTransitions", `{chunkKey} deferred (collision chunk unloaded)`)
	for offsetY = -1, 1 do
		for offsetX = -1, 1 do
			if offsetX == 0 and offsetY == 0 then
				continue
			end
			local neighborChunkX = chunkX + offsetX
			local neighborChunkY = chunkY + offsetY
			local neighborKey = LiquidServiceUtils.packChunkKey(neighborChunkX, neighborChunkY)
			local neighborRuntime = self.chunkRuntimes[neighborKey]
			if neighborRuntime == nil or not self:isCollisionChunkReadyByKey(neighborKey) then
				continue
			end
			self:primeChunkRuntime(neighborKey, "neighborCollisionUnavailable")
			self:setChunkRegionState(
				neighborKey,
				neighborRuntime,
				CELL_DEBUG_STATE.DEFERRED_WAITING_FOR_CHUNK,
				`awaitingCollisionChunk {chunkKey}`,
				chunkKey
			)
		end
	end
end

function LiquidServiceServer:OnChunkTerrainChanged(
	chunkXRaw: any,
	chunkYRaw: any,
	dirtyBoundsRaw: any?,
	contextRaw: any?
)
	if not isFiniteNumber(chunkXRaw) or not isFiniteNumber(chunkYRaw) then
		return
	end
	local chunkX = math.floor(chunkXRaw)
	local chunkY = math.floor(chunkYRaw)
	local chunkKey = LiquidServiceUtils.packChunkKey(chunkX, chunkY)
	local context = if typeof(contextRaw) == "table" then contextRaw :: { [string]: any } else {}
	local runtime = self:getChunkRuntime(chunkKey)
	local sourceTileX = if isFiniteNumber(context.sourceTileX) then math.floor(context.sourceTileX) else nil
	local sourceTileY = if isFiniteNumber(context.sourceTileY) then math.floor(context.sourceTileY) else nil
	local nextTileId = if isFiniteNumber(context.nextTileId) then math.floor(context.nextTileId) else nil
	local reason = if typeof(context.reason) == "string" and context.reason ~= ""
		then context.reason
		else "chunkTerrainChanged"

	if
		sourceTileX ~= nil
		and sourceTileY ~= nil
		and nextTileId ~= nil
		and self.world ~= nil
		and nextTileId ~= self.world.tileId.AIR
	then
		local packedCell = self.world:getLiquidCellAt(sourceTileX, sourceTileY)
		if packedCell ~= 0 then
			self:setPackedCell(sourceTileX, sourceTileY, 0)
			self:redistributeDisplacedLiquid(sourceTileX, sourceTileY, packedCell)
		end
	end

	self:setChunkRegionState(
		chunkKey,
		runtime,
		CELL_DEBUG_STATE.DEFERRED_WAITING_FOR_CHUNK,
		`awaitingCollisionChunk {chunkKey}`,
		chunkKey
	)
	self:wakeChunkBounds(chunkX, chunkY, dirtyBoundsRaw, reason, sourceTileX, sourceTileY)
	if sourceTileX ~= nil and sourceTileY ~= nil then
		self:wakeLiquidRegion(sourceTileX, sourceTileY, reason, {
			radius = 2,
			sourceTileX = sourceTileX,
			sourceTileY = sourceTileY,
			scanNearby = true,
		})
	end
end

function LiquidServiceServer:IsDebugEnabled(): boolean
	return self.config.debug.enabled
end

function LiquidServiceServer:ShouldDebugLog(flagName: string): boolean
	if not self:isDebugEnabled() then
		return false
	end
	return (self.config.debug :: any)[flagName] == true
end

function LiquidServiceServer:DebugLog(_flagName: string, _message: string)
	return
end

function LiquidServiceServer:GetDebugFolder(): Folder?
	if not self:isDebugEnabled() then
		return nil
	end
	if not self.config.debug.visualizeChunks and not self.config.debug.visualizeCells then
		return nil
	end
	if self.debugFolder ~= nil and self.debugFolder.Parent ~= nil then
		return self.debugFolder
	end
	self.debugFolder = WorkspaceFolders.getOrCreateFolderInGame("LiquidDebug")
	return self.debugFolder
end

function LiquidServiceServer:GetChunkDebugFolder(chunkKey: string): Folder?
	local debugFolder = self:getDebugFolder()
	if debugFolder == nil then
		return nil
	end
	local folderName = `Chunk_{sanitizeChunkDebugName(chunkKey)}`
	local existing = debugFolder:FindFirstChild(folderName)
	if existing ~= nil and existing:IsA("Folder") then
		return existing
	end
	if existing ~= nil then
		existing:Destroy()
	end
	local folder = Instance.new("Folder")
	folder.Name = folderName
	folder.Parent = debugFolder
	return folder
end

function LiquidServiceServer:GetChunkCellDebugFolder(chunkKey: string): Folder?
	if not self.config.debug.visualizeCells then
		return nil
	end
	local chunkFolder = self:getChunkDebugFolder(chunkKey)
	if chunkFolder == nil then
		return nil
	end
	local existing = chunkFolder:FindFirstChild("Cells")
	if existing ~= nil and existing:IsA("Folder") then
		return existing
	end
	if existing ~= nil then
		existing:Destroy()
	end
	local folder = Instance.new("Folder")
	folder.Name = "Cells"
	folder.Parent = chunkFolder
	return folder
end

function LiquidServiceServer:UpdateSimulationDebugStats()
	local debugFolder = self:getDebugFolder()
	local debugCounters = if self.debug ~= nil then self.debug:getCounters() else {}
	local wakePoolStats = if self.wakeRequestPool ~= nil
			and typeof((self.wakeRequestPool :: any).getStats) == "function"
		then (self.wakeRequestPool :: any):getStats()
		else {}
	if debugFolder == nil then
		if self.debug ~= nil then
			self.debug:setCounter("liquid_active_chunks", self.currentSimulationStats.activeChunks)
			self.debug:setCounter("liquid_dirty_chunks", self.currentSimulationStats.dirtyChunks)
			self.debug:setCounter("liquid_queued_cells", self.currentSimulationStats.queuedCells)
			self.debug:setCounter("liquid_pending_wake_requests", self:getPendingWakeRequestCount())
			self.debug:setCounter("liquid_wake_requests_queued", self.currentSimulationStats.wakeRequestsQueued)
			self.debug:setCounter("liquid_wake_requests_processed", self.currentSimulationStats.wakeRequestsProcessed)
			self.debug:setCounter("liquid_cells_processed", self.currentSimulationStats.cellsProcessed)
			self.debug:setCounter("liquid_active_cells", self.currentSimulationStats.activeCells)
			self.debug:setCounter("liquid_cross_chunk_wakeups", self.currentSimulationStats.crossChunkWakeups)
			self.debug:setCounter("liquid_downward_transfer", self.currentSimulationStats.downwardTransfers)
			self.debug:setCounter("liquid_lateral_transfer", self.currentSimulationStats.lateralTransfers)
			self.debug:setCounter("liquid_solver_iterations", self.currentSimulationStats.solverIterations)
			self.debug:setCounter("liquid_consistency_requeues", self.currentSimulationStats.consistencyRequeues)
			self.debug:setCounter("liquid_deferred_chunks", self.currentSimulationStats.deferredChunks)
			self.debug:setCounter("liquid_chunk_readiness_wakeups", self.currentSimulationStats.chunkReadinessWakeups)
			self.debug:setCounter("liquid_collision_chunks_loaded", self.currentSimulationStats.collisionChunksLoaded)
			self.debug:setCounter(
				"liquid_wake_pool_available",
				if typeof(wakePoolStats.available) == "number" then wakePoolStats.available else 0
			)
			self.debug:setCounter(
				"liquid_wake_pool_in_use",
				if typeof(wakePoolStats.inUse) == "number" then wakePoolStats.inUse else 0
			)
		end
		return
	end
	debugFolder:SetAttribute("SimulationStepId", self.simulationStepId)
	debugFolder:SetAttribute("ActiveChunks", self.currentSimulationStats.activeChunks)
	debugFolder:SetAttribute("DirtyChunks", self.currentSimulationStats.dirtyChunks)
	debugFolder:SetAttribute("QueuedCells", self.currentSimulationStats.queuedCells)
	debugFolder:SetAttribute("PendingWakeRequests", self:getPendingWakeRequestCount())
	debugFolder:SetAttribute("WakeRequestsQueued", self.currentSimulationStats.wakeRequestsQueued)
	debugFolder:SetAttribute("WakeRequestsProcessed", self.currentSimulationStats.wakeRequestsProcessed)
	debugFolder:SetAttribute("ActiveCells", self.currentSimulationStats.activeCells)
	debugFolder:SetAttribute("CellsProcessed", self.currentSimulationStats.cellsProcessed)
	debugFolder:SetAttribute("CrossChunkWakeups", self.currentSimulationStats.crossChunkWakeups)
	debugFolder:SetAttribute("DownwardTransfers", self.currentSimulationStats.downwardTransfers)
	debugFolder:SetAttribute("LateralTransfers", self.currentSimulationStats.lateralTransfers)
	debugFolder:SetAttribute("SolverIterations", self.currentSimulationStats.solverIterations)
	debugFolder:SetAttribute("ConsistencyRequeues", self.currentSimulationStats.consistencyRequeues)
	debugFolder:SetAttribute("DeferredChunks", self.currentSimulationStats.deferredChunks)
	debugFolder:SetAttribute("ChunkReadinessWakeups", self.currentSimulationStats.chunkReadinessWakeups)
	debugFolder:SetAttribute("CollisionChunksLoaded", self.currentSimulationStats.collisionChunksLoaded)
	debugFolder:SetAttribute(
		"WakePoolAvailable",
		if typeof(wakePoolStats.available) == "number" then wakePoolStats.available else 0
	)
	debugFolder:SetAttribute(
		"WakePoolInUse",
		if typeof(wakePoolStats.inUse) == "number" then wakePoolStats.inUse else 0
	)
	debugFolder:SetAttribute(
		"TimeServerSolveMs",
		math.round(((debugCounters.time_liquid_server_solve or 0) * 1000) * 100) / 100
	)
	debugFolder:SetAttribute(
		"TimeConsistencySweepMs",
		math.round(((debugCounters.time_liquid_consistency_sweep or 0) * 1000) * 100) / 100
	)
	if self.debug ~= nil then
		self.debug:setCounter("liquid_active_chunks", self.currentSimulationStats.activeChunks)
		self.debug:setCounter("liquid_dirty_chunks", self.currentSimulationStats.dirtyChunks)
		self.debug:setCounter("liquid_queued_cells", self.currentSimulationStats.queuedCells)
		self.debug:setCounter("liquid_pending_wake_requests", self:getPendingWakeRequestCount())
		self.debug:setCounter("liquid_wake_requests_queued", self.currentSimulationStats.wakeRequestsQueued)
		self.debug:setCounter("liquid_wake_requests_processed", self.currentSimulationStats.wakeRequestsProcessed)
		self.debug:setCounter("liquid_cells_processed", self.currentSimulationStats.cellsProcessed)
		self.debug:setCounter("liquid_active_cells", self.currentSimulationStats.activeCells)
		self.debug:setCounter("liquid_cross_chunk_wakeups", self.currentSimulationStats.crossChunkWakeups)
		self.debug:setCounter("liquid_downward_transfer", self.currentSimulationStats.downwardTransfers)
		self.debug:setCounter("liquid_lateral_transfer", self.currentSimulationStats.lateralTransfers)
		self.debug:setCounter("liquid_solver_iterations", self.currentSimulationStats.solverIterations)
		self.debug:setCounter("liquid_consistency_requeues", self.currentSimulationStats.consistencyRequeues)
		self.debug:setCounter("liquid_deferred_chunks", self.currentSimulationStats.deferredChunks)
		self.debug:setCounter("liquid_chunk_readiness_wakeups", self.currentSimulationStats.chunkReadinessWakeups)
		self.debug:setCounter("liquid_collision_chunks_loaded", self.currentSimulationStats.collisionChunksLoaded)
		self.debug:setCounter(
			"liquid_wake_pool_available",
			if typeof(wakePoolStats.available) == "number" then wakePoolStats.available else 0
		)
		self.debug:setCounter(
			"liquid_wake_pool_in_use",
			if typeof(wakePoolStats.inUse) == "number" then wakePoolStats.inUse else 0
		)
	end
end

function LiquidServiceServer:UpdateCellDebugVisual(
	tileX: number,
	tileY: number,
	state: string,
	reason: string,
	fill: number,
	liquidType: number
)
	if not self:isDebugEnabled() or not self.config.debug.visualizeCells then
		return
	end
	local world = self.world
	if world == nil then
		return
	end
	local chunkKey = LiquidServiceUtils.packChunkKey(
		LiquidServiceUtils.toChunkCoordinate(tileX, world.chunkSize),
		LiquidServiceUtils.toChunkCoordinate(tileY, world.chunkSize)
	)
	local folder = self:getChunkCellDebugFolder(chunkKey)
	if folder == nil then
		return
	end

	local partName = `Cell_{tileX}_{tileY}`
	local existing = folder:FindFirstChild(partName)
	if fill <= 0 or liquidType == LIQUID_TYPE.NONE then
		if existing ~= nil then
			existing:Destroy()
		end
		return
	end

	local part = if existing ~= nil and existing:IsA("Part") then existing else nil
	if part == nil then
		if existing ~= nil then
			existing:Destroy()
		end
		part = Instance.new("Part")
		part.Name = partName
		part.Anchored = true
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.CastShadow = false
		part.Material = Enum.Material.Neon
		part.Parent = folder
	end

	local basePlaneX = if isFiniteNumber((world :: any).basePlaneX) then (world :: any).basePlaneX else 0
	local center = LiquidServiceUtils.tileToWorldCenter(tileX, tileY, world.worldOrigin, world.tileSize, basePlaneX)
	part.CFrame = CFrame.new(center.X - 0.9, center.Y, center.Z)
	part.Size = Vector3.new(CELL_DEBUG_PART_DEPTH, world.tileSize * 0.22, world.tileSize * 0.22)
	part.Color = CELL_DEBUG_COLORS[state] or Color3.fromRGB(255, 255, 255)
	part.Transparency = if state == CELL_DEBUG_STATE.STABLE
			or state == CELL_DEBUG_STATE.BLOCKED
			or state == CELL_DEBUG_STATE.BLOCKED_BY_LOADED_TERRAIN
		then 0.45
		else 0.15
	part:SetAttribute("TileX", tileX)
	part:SetAttribute("TileY", tileY)
	part:SetAttribute("State", state)
	part:SetAttribute("Reason", reason)
	part:SetAttribute("Fill", fill)
	part:SetAttribute("LiquidType", liquidType)
end

function LiquidServiceServer:UpdateChunkDebugAttributes(chunkKey: string, runtime: ChunkRuntime, extraRaw: any?)
	if not self.config.debug.visualizeChunks then
		return
	end
	local folder = self:getChunkDebugFolder(chunkKey)
	if folder == nil then
		return
	end
	local extra = if typeof(extraRaw) == "table" then extraRaw :: { [string]: any } else {}
	folder:SetAttribute("ChunkKey", chunkKey)
	folder:SetAttribute("Revision", runtime.revision)
	folder:SetAttribute("DirtyCount", getDirtyCount(runtime))
	folder:SetAttribute("HasDirtyCells", getDirtyCount(runtime) > 0)
	folder:SetAttribute("LastDisturbedAt", runtime.lastDisturbedAt)
	folder:SetAttribute("LastActiveStepId", runtime.lastActiveStepId)
	folder:SetAttribute("LastActivationAt", runtime.lastActivationAt)
	folder:SetAttribute("LastActivationReason", runtime.lastActivationReason)
	folder:SetAttribute("LastStableAt", runtime.lastStableAt)
	folder:SetAttribute("LastStableReason", runtime.lastStableReason)
	folder:SetAttribute("LastProcessedAt", runtime.lastProcessedAt)
	folder:SetAttribute("LastProcessedCells", runtime.lastProcessedCells)
	folder:SetAttribute("LastChangedCells", runtime.lastChangedCells)
	folder:SetAttribute("LastPrimedCells", runtime.lastPrimedCells)
	folder:SetAttribute("DirtyMarks", runtime.dirtyMarkCount)
	folder:SetAttribute("MutationCount", runtime.mutationCount)
	folder:SetAttribute("LastMutationTileX", runtime.lastMutationTileX)
	folder:SetAttribute("LastMutationTileY", runtime.lastMutationTileY)
	folder:SetAttribute("LastMutationFill", runtime.lastMutationFill)
	folder:SetAttribute("LastMutationType", runtime.lastMutationType)
	folder:SetAttribute("LastActiveCellCount", runtime.lastActiveCellCount)
	folder:SetAttribute("LastDownwardTransfer", runtime.lastDownwardTransfer)
	folder:SetAttribute("LastLateralTransfer", runtime.lastLateralTransfer)
	folder:SetAttribute("LastCrossChunkWakeups", runtime.lastCrossChunkWakeups)
	folder:SetAttribute("LastStabilityScanUnstableCells", runtime.lastStabilityScanUnstableCells)
	folder:SetAttribute("WaitingOnChunkReady", runtime.waitingOnChunkReady)
	folder:SetAttribute("DependencyChunkKey", runtime.dependencyChunkKey)
	folder:SetAttribute("LastDeferredAt", runtime.lastDeferredAt)
	folder:SetAttribute("LastDeferredReason", runtime.lastDeferredReason)
	folder:SetAttribute("RegionState", runtime.regionState)
	folder:SetAttribute("RegionReason", runtime.regionReason)
	folder:SetAttribute("CollisionChunkReady", self:isCollisionChunkReadyByKey(chunkKey))
	if extra.InActiveSet ~= nil then
		folder:SetAttribute("InActiveSet", extra.InActiveSet == true)
	end
	if typeof(extra.ActiveReason) == "string" then
		folder:SetAttribute("ActiveReason", extra.ActiveReason)
	end
	if isFiniteNumber(extra.LastStepBudget) then
		folder:SetAttribute("LastStepBudget", math.floor(extra.LastStepBudget))
	end
	if isFiniteNumber(extra.LastQueuedTileX) then
		folder:SetAttribute("LastQueuedTileX", math.floor(extra.LastQueuedTileX))
	end
	if isFiniteNumber(extra.LastQueuedTileY) then
		folder:SetAttribute("LastQueuedTileY", math.floor(extra.LastQueuedTileY))
	end
	if typeof(extra.LastDirtyReason) == "string" then
		folder:SetAttribute("LastDirtyReason", extra.LastDirtyReason)
	end
end

function LiquidServiceServer:CreatePlayerStream(): PlayerStream
	local fullQueue, head, tail, lookup = createStringQueue()
	return {
		ready = false,
		interestKeys = {},
		sentRevisions = {},
		fullQueue = fullQueue,
		fullQueueHead = head,
		fullQueueTail = tail,
		fullQueueLookup = lookup,
	}
end

function LiquidServiceServer:GetPlayerStream(player: Player): PlayerStream
	local stream = self.playerStreams[player]
	if stream ~= nil then
		return stream
	end
	stream = self:createPlayerStream()
	self.playerStreams[player] = stream
	return stream
end

function LiquidServiceServer:IsPlayerStreamReady(player: Player): boolean
	local stream = self.playerStreams[player]
	return stream ~= nil and stream.ready == true
end

function LiquidServiceServer:CreateHazardRuntime(): PlayerHazardRuntime
	return {
		lastQuery = nil,
		lastQueryAt = -math.huge,
		wasInLiquid = false,
		wasMeaningfullySubmerged = false,
		wasBurning = false,
		lastDominantType = LIQUID_TYPE.NONE,
		lastLavaDamageAt = -math.huge,
		lastBurnDamageAt = -math.huge,
		burnEndsAt = -math.huge,
	}
end

function LiquidServiceServer:GetHazardRuntime(player: Player): PlayerHazardRuntime
	local runtime = self.playerHazards[player]
	if runtime ~= nil then
		return runtime
	end
	runtime = self:createHazardRuntime()
	self.playerHazards[player] = runtime
	return runtime
end

function LiquidServiceServer:CreateStateSnapshot(): LiquidServiceState
	local world = self.world
	return LiquidServiceUtils.createState({
		ready = world ~= nil,
		tileSize = if world ~= nil and isFiniteNumber((world :: any).tileSize) then (world :: any).tileSize else 2,
		chunkSize = if world ~= nil and isFiniteNumber((world :: any).chunkSize)
			then math.floor((world :: any).chunkSize)
			else 32,
		worldOrigin = if world ~= nil and typeof((world :: any).worldOrigin) == "Vector3"
			then (world :: any).worldOrigin
			else Vector3.zero,
		maxFill = self.config.maxFill,
		interpolationTime = self.config.render.interpolationTime,
	}, self.state)
end

function LiquidServiceServer:PushState(player: Player)
	self.state = self:createStateSnapshot()
	self.networker:fire(player, LiquidServiceUtils.CLIENT_METHOD_APPLY_STATE, LiquidServiceUtils.cloneState(self.state))
end

function LiquidServiceServer:GetDefinition(liquidType: number): LiquidDefinition?
	return self.config.definitions[liquidType]
end

function LiquidServiceServer:GetChunkSnapshot(chunkKey: string): LiquidChunkSnapshot?
	local world = self.world
	if world == nil then
		return nil
	end
	local snapshotRaw = world:getLiquidChunkSnapshotByKey(chunkKey)
	if typeof(snapshotRaw) ~= "table" then
		return nil
	end
	local source = snapshotRaw :: { [string]: any }
	local runtime = self:getChunkRuntime(chunkKey)
	return {
		key = if typeof(source.key) == "string" then source.key else chunkKey,
		chunkX = if isFiniteNumber(source.chunkX) then math.floor(source.chunkX) else 0,
		chunkY = if isFiniteNumber(source.chunkY) then math.floor(source.chunkY) else 0,
		tileMinX = if isFiniteNumber(source.tileMinX) then math.floor(source.tileMinX) else 0,
		tileMinY = if isFiniteNumber(source.tileMinY) then math.floor(source.tileMinY) else 0,
		width = if isFiniteNumber(source.width) then math.floor(source.width) else world.chunkSize,
		height = if isFiniteNumber(source.height) then math.floor(source.height) else world.chunkSize,
		cells = if typeof(source.cells) == "table" then Sift.Dictionary.copy(source.cells) else {},
		revision = runtime.revision,
		updatedAt = os.clock(),
	}
end

function LiquidServiceServer:EnqueueFullSnapshot(stream: PlayerStream, chunkKey: string)
	stream.fullQueueTail = enqueueString(stream.fullQueue, stream.fullQueueLookup, stream.fullQueueTail, chunkKey)
end

function LiquidServiceServer:MarkChunkStable(chunkKey: string, runtime: ChunkRuntime, reason: string)
	runtime.lastStableAt = os.clock()
	runtime.lastStableReason = reason
	local stableState = if runtime.regionState == CELL_DEBUG_STATE.BLOCKED_BY_LOADED_TERRAIN
		then CELL_DEBUG_STATE.BLOCKED_BY_LOADED_TERRAIN
		else CELL_DEBUG_STATE.STABLE
	self:setChunkRegionState(chunkKey, runtime, stableState, reason)
	self:updateChunkDebugAttributes(chunkKey, runtime)
	self:debugLog("logStableTransitions", `{chunkKey} stable ({reason})`)
end

function LiquidServiceServer:RecordSimulationMetric(metricName: string, amountRaw: any?, runtime: ChunkRuntime?)
	if self.currentSimulationStats == nil then
		self.currentSimulationStats = createSimulationTickStats()
	end
	local amount = if isFiniteNumber(amountRaw) then math.max(0, amountRaw :: number) else 1
	if metricName == "activeCells" then
		self.currentSimulationStats.activeCells += amount
		if runtime ~= nil then
			runtime.lastActiveCellCount += amount
		end
	elseif metricName == "crossChunkWakeups" then
		self.currentSimulationStats.crossChunkWakeups += amount
		if runtime ~= nil then
			runtime.lastCrossChunkWakeups += amount
		end
	elseif metricName == "downwardTransfers" then
		self.currentSimulationStats.downwardTransfers += amount
		if runtime ~= nil then
			runtime.lastDownwardTransfer += amount
		end
	elseif metricName == "lateralTransfers" then
		self.currentSimulationStats.lateralTransfers += amount
		if runtime ~= nil then
			runtime.lastLateralTransfer += amount
		end
	elseif metricName == "solverIterations" then
		self.currentSimulationStats.solverIterations += amount
	elseif metricName == "cellsProcessed" then
		self.currentSimulationStats.cellsProcessed += amount
	elseif metricName == "consistencyRequeues" then
		self.currentSimulationStats.consistencyRequeues += amount
	elseif metricName == "chunkReadinessWakeups" then
		self.currentSimulationStats.chunkReadinessWakeups += amount
	end
end

function LiquidServiceServer:GetPendingWakeRequestCount(): number
	if self.pendingWakeHead > self.pendingWakeTail then
		return 0
	end
	return self.pendingWakeTail - self.pendingWakeHead + 1
end

function LiquidServiceServer:GetChunkWorldPosition(chunkX: number, chunkY: number): (number, number, number)
	local world = self.world
	if world == nil then
		return chunkX, chunkY, 0
	end
	local tileSize = math.max(0.001, world.tileSize)
	local centerTileX = chunkX * world.chunkSize + world.chunkSize * 0.5
	local centerTileY = chunkY * world.chunkSize + world.chunkSize * 0.5
	return world.worldOrigin.Z + centerTileX * tileSize, world.worldOrigin.Y + centerTileY * tileSize, 0
end

function LiquidServiceServer:TrackRecentChunkActivity(chunkKey: string, chunkX: number, chunkY: number)
	local touchedAt = os.clock()
	self.recentChunkTouchedAt[chunkKey] = touchedAt
	local worldX, worldY, worldZ = self:getChunkWorldPosition(chunkX, chunkY)
	local payload: RecentChunkActivity = {
		key = chunkKey,
		chunkX = chunkX,
		chunkY = chunkY,
		touchedAt = touchedAt,
	}
	if not self.recentChunkGrid:update(chunkKey, worldX, worldY, worldZ, payload) then
		self.recentChunkGrid:insert(chunkKey, worldX, worldY, worldZ, payload)
	end
end

function LiquidServiceServer:PruneRecentChunkActivity()
	local expiry = self.config.simulation.disturbedChunkKeepAliveSeconds * 2
	local now = os.clock()
	for chunkKey, touchedAt in self.recentChunkTouchedAt do
		if now - touchedAt <= expiry then
			continue
		end
		self.recentChunkTouchedAt[chunkKey] = nil
		self.recentChunkGrid:remove(chunkKey)
	end
end

function LiquidServiceServer:RequeueDirtyMutation(mutationRaw: any)
	if typeof(mutationRaw) ~= "table" then
		return
	end
	self.dirtyCellQueue:enqueue(mutationRaw)
end

function LiquidServiceServer:PrimeChunkRuntime(chunkKey: string, reasonRaw: any?): number
	local runtime = self:getChunkRuntime(chunkKey)
	if not self:isCollisionChunkReadyByKey(chunkKey) then
		self:setChunkRegionState(
			chunkKey,
			runtime,
			CELL_DEBUG_STATE.DEFERRED_WAITING_FOR_CHUNK,
			`awaitingCollisionChunk {chunkKey}`,
			chunkKey
		)
		runtime.lastPrimedCells = 0
		self:updateChunkDebugAttributes(chunkKey, runtime)
		return 0
	end
	if getDirtyCount(runtime) > 0 then
		runtime.lastPrimedCells = 0
		self:updateChunkDebugAttributes(chunkKey, runtime)
		return 0
	end

	local snapshot = self:getChunkSnapshot(chunkKey)
	if snapshot == nil then
		runtime.lastPrimedCells = 0
		self:updateChunkDebugAttributes(chunkKey, runtime)
		return 0
	end

	local primedCount = 0
	for index = 1, #snapshot.cells do
		local packedCell = snapshot.cells[index]
		if not isFiniteNumber(packedCell) or packedCell <= 0 then
			continue
		end
		local zeroIndex = index - 1
		local localY = math.floor(zeroIndex / snapshot.width)
		local localX = zeroIndex - localY * snapshot.width
		local tileX = snapshot.tileMinX + localX
		local tileY = snapshot.tileMinY + localY
		if self:markTileDirty(tileX, tileY, reasonRaw or "activation") then
			primedCount += 1
		end
	end

	runtime.lastPrimedCells = primedCount
	if primedCount > 0 then
		runtime.lastDisturbedAt = os.clock()
		self:debugLog(
			"logActivations",
			`{chunkKey} primed {primedCount} liquid cells ({if typeof(reasonRaw) == "string"
				then reasonRaw
				else "activation"})`
		)
	end
	self:updateChunkDebugAttributes(chunkKey, runtime)
	return primedCount
end

function LiquidServiceServer:ExpandInterestKeys(baseInterest: { [string]: boolean }): { [string]: boolean }
	local margin = math.max(0, self.config.simulation.activeSafetyMarginChunks)
	if margin <= 0 then
		local clone: { [string]: boolean } = {}
		for chunkKey in baseInterest do
			clone[chunkKey] = true
		end
		return clone
	end

	local expanded: { [string]: boolean } = {}
	for chunkKey in baseInterest do
		local chunkX, chunkY = LiquidServiceUtils.unpackChunkKey(chunkKey)
		if chunkX == nil or chunkY == nil then
			continue
		end
		for offsetY = -margin, margin do
			for offsetX = -margin, margin do
				expanded[LiquidServiceUtils.packChunkKey(chunkX + offsetX, chunkY + offsetY)] = true
			end
		end
	end
	return expanded
end

function LiquidServiceServer:RefreshPlayerInterest(player: Player)
	local world = self.world
	if world == nil then
		return
	end
	local stream = self:getPlayerStream(player)
	if not stream.ready then
		return
	end
	local nextInterest = self:expandInterestKeys(world:getPlayerInterestKeys(player))

	for chunkKey in nextInterest do
		if stream.interestKeys[chunkKey] == nil or stream.sentRevisions[chunkKey] == nil then
			self:enqueueFullSnapshot(stream, chunkKey)
		end
	end

	for chunkKey in stream.interestKeys do
		if nextInterest[chunkKey] then
			continue
		end
		stream.sentRevisions[chunkKey] = nil
		if self.networker ~= nil then
			self.networker:fire(player, LiquidServiceUtils.CLIENT_METHOD_ON_CHUNK_UNLOADED, chunkKey)
		end
	end

	stream.interestKeys = nextInterest
end

function LiquidServiceServer:MarkTileDirty(
	tileX: number,
	tileY: number,
	reasonRaw: any?,
	sourceTileXRaw: any?,
	sourceTileYRaw: any?
): boolean
	local world = self.world
	if world == nil then
		return false
	end
	local chunkSize = math.max(1, world.chunkSize)
	local chunkX = LiquidServiceUtils.toChunkCoordinate(tileX, chunkSize)
	local chunkY = LiquidServiceUtils.toChunkCoordinate(tileY, chunkSize)
	local chunkKey = LiquidServiceUtils.packChunkKey(chunkX, chunkY)
	local runtime = self:getChunkRuntime(chunkKey)
	local localX = tileX - chunkX * chunkSize
	local localY = tileY - chunkY * chunkSize
	if localX < 0 or localX >= chunkSize or localY < 0 or localY >= chunkSize then
		return false
	end
	local index = LiquidServiceUtils.computeTileIndex(localX, localY, chunkSize)
	if runtime.dirtyLookup[index] then
		return false
	end
	local sourceTileX = if isFiniteNumber(sourceTileXRaw) then math.floor(sourceTileXRaw) else nil
	local sourceTileY = if isFiniteNumber(sourceTileYRaw) then math.floor(sourceTileYRaw) else nil
	if sourceTileX ~= nil and sourceTileY ~= nil then
		local sourceChunkX = LiquidServiceUtils.toChunkCoordinate(sourceTileX, chunkSize)
		local sourceChunkY = LiquidServiceUtils.toChunkCoordinate(sourceTileY, chunkSize)
		local sourceChunkKey = LiquidServiceUtils.packChunkKey(sourceChunkX, sourceChunkY)
		if sourceChunkKey ~= chunkKey then
			self:recordSimulationMetric("crossChunkWakeups", 1, runtime)
		end
	end
	runtime.dirtyLookup[index] = true
	runtime.queuedDirtyCount += 1
	runtime.lastDisturbedAt = os.clock()
	runtime.dirtyMarkCount += 1
	local reason = if typeof(reasonRaw) == "string" and reasonRaw ~= "" then reasonRaw else "unspecified"
	self.dirtyCellQueue:enqueue({
		x = tileX,
		y = tileY,
		z = 0,
		tileId = 1,
		metadata = {
			chunkKey = chunkKey,
			reason = reason,
			sourceTileX = sourceTileX,
			sourceTileY = sourceTileY,
		},
	})
	self:trackRecentChunkActivity(chunkKey, chunkX, chunkY)
	self:updateChunkDebugAttributes(chunkKey, runtime, {
		LastQueuedTileX = tileX,
		LastQueuedTileY = tileY,
		LastDirtyReason = reason,
	})
	self:debugLog("logDirtyMarks", `{chunkKey} queued tile {tileX},{tileY} ({reason})`)
	if self.debug ~= nil then
		self.debug:incrementCounter("liquid_dirty_marks")
	end
	return true
end

function LiquidServiceServer:MarkAreaDirty(tileX: number, tileY: number, radiusRaw: any?, reasonRaw: any?)
	self:wakeLiquidRegion(tileX, tileY, reasonRaw, {
		radius = radiusRaw,
		sourceTileX = tileX,
		sourceTileY = tileY,
		scanNearby = false,
	})
end

function LiquidServiceServer:WakeLiquidRegion(tileXRaw: any, tileYRaw: any, reasonRaw: any?, optionsRaw: any?): boolean
	if not isFiniteNumber(tileXRaw) or not isFiniteNumber(tileYRaw) then
		return false
	end
	local options = if typeof(optionsRaw) == "table" then optionsRaw :: { [string]: any } else {}
	local tileX = math.floor(tileXRaw)
	local tileY = math.floor(tileYRaw)
	local radius = if isFiniteNumber(options.radius) then math.max(0, math.floor(options.radius)) else 1
	local sourceTileX = if isFiniteNumber(options.sourceTileX) then math.floor(options.sourceTileX) else nil
	local sourceTileY = if isFiniteNumber(options.sourceTileY) then math.floor(options.sourceTileY) else nil
	local scanNearby = options.scanNearby == true
	local reason = if typeof(reasonRaw) == "string" and reasonRaw ~= "" then reasonRaw else "wakeRegion"
	local key = `{tileX}:{tileY}:{radius}:{if scanNearby then 1 else 0}`
	if self.pendingWakeLookup[key] then
		return false
	end

	local request = self.wakeRequestPool:acquire() :: WakeRequest
	request.key = key
	request.tileX = tileX
	request.tileY = tileY
	request.radius = radius
	request.reason = reason
	request.sourceTileX = sourceTileX
	request.sourceTileY = sourceTileY
	request.scanNearby = scanNearby

	self.pendingWakeLookup[key] = true
	self.pendingWakeTail += 1
	self.pendingWakeQueue[self.pendingWakeTail] = request
	if self.debug ~= nil then
		self.debug:incrementCounter("liquid_wake_requests_enqueued")
	end
	return true
end

function LiquidServiceServer:ApplyWakeRequest(request: WakeRequest)
	local sourceTileX = if request.sourceTileX ~= nil then request.sourceTileX else request.tileX
	local sourceTileY = if request.sourceTileY ~= nil then request.sourceTileY else request.tileY
	for offsetY = -request.radius, request.radius do
		for offsetX = -request.radius, request.radius do
			self:markTileDirty(
				request.tileX + offsetX,
				request.tileY + offsetY,
				request.reason,
				sourceTileX,
				sourceTileY
			)
		end
	end

	if not request.scanNearby then
		return
	end
	local world = self.world
	if world == nil then
		return
	end
	local horizontalRadius = 4 + request.radius
	local verticalBelow = 3 + request.radius
	local verticalAbove = 7 + request.radius
	for scanY = request.tileY - verticalBelow, request.tileY + verticalAbove do
		for scanX = request.tileX - horizontalRadius, request.tileX + horizontalRadius do
			if world:getLiquidCellAt(scanX, scanY) == 0 then
				continue
			end
			self:markTileDirty(scanX, scanY, `{request.reason}:nearbyLiquid`, request.tileX, request.tileY)
		end
	end
end

function LiquidServiceServer:FlushWakeRequests(maxRequestsRaw: any?): number
	local maxRequests = if isFiniteNumber(maxRequestsRaw)
		then math.max(1, math.floor(maxRequestsRaw))
		else math.max(8, self.config.simulation.maxChunkStepsPerTick * 4)
	local processed = 0
	while processed < maxRequests do
		if self.pendingWakeHead > self.pendingWakeTail then
			if self.pendingWakeHead ~= 1 or self.pendingWakeTail ~= 0 then
				table.clear(self.pendingWakeQueue)
				self.pendingWakeHead = 1
				self.pendingWakeTail = 0
			end
			break
		end
		local request = self.pendingWakeQueue[self.pendingWakeHead] :: WakeRequest?
		self.pendingWakeQueue[self.pendingWakeHead] = nil
		self.pendingWakeHead += 1
		if request == nil then
			continue
		end
		self.pendingWakeLookup[request.key] = nil
		self:applyWakeRequest(request)
		self.wakeRequestPool:release(request)
		processed += 1
	end
	if processed > 0 and self.debug ~= nil then
		self.debug:incrementCounter("liquid_wake_requests_processed", processed)
	end
	return processed
end

function LiquidServiceServer:RegisterCellMutation(tileX: number, tileY: number, packedCell: number)
	local world = self.world
	if world == nil then
		return
	end
	local chunkSize = math.max(1, world.chunkSize)
	local chunkX = LiquidServiceUtils.toChunkCoordinate(tileX, chunkSize)
	local chunkY = LiquidServiceUtils.toChunkCoordinate(tileY, chunkSize)
	local chunkKey = LiquidServiceUtils.packChunkKey(chunkX, chunkY)
	local runtime = self:getChunkRuntime(chunkKey)
	local liquidType, fill = LiquidCell.unpack(packedCell)
	runtime.revision += 1
	runtime.lastDisturbedAt = os.clock()
	runtime.mutationCount += 1
	runtime.lastMutationTileX = tileX
	runtime.lastMutationTileY = tileY
	runtime.lastMutationFill = fill
	runtime.lastMutationType = liquidType
	self.changedChunkKeys[chunkKey] = true
	self:updateChunkDebugAttributes(chunkKey, runtime)
	self:debugLog("logSimulationSteps", `{chunkKey} mutated tile {tileX},{tileY} -> type={liquidType} fill={fill}`)
	if runtime.forceFullResync then
		return
	end

	local localX = tileX - chunkX * chunkSize
	local localY = tileY - chunkY * chunkSize
	local index = LiquidServiceUtils.computeTileIndex(localX, localY, chunkSize)
	if runtime.pendingDeltaByIndex[index] == nil then
		runtime.pendingDeltaCount += 1
		table.insert(runtime.pendingDeltaIndices, index)
	end
	runtime.pendingDeltaByIndex[index] = packedCell
	if
		runtime.pendingDeltaCount >= self.config.simulation.fullSnapshotThreshold
		or runtime.pendingDeltaCount >= self.config.simulation.maxDeltaCellsPerChunk
	then
		runtime.forceFullResync = true
	end
end

function LiquidServiceServer:SetPackedCell(tileX: number, tileY: number, packedCell: number): boolean
	local world = self.world
	if world == nil then
		return false
	end
	local changed, _, nextPackedCell = world:setLiquidCellAt(tileX, tileY, packedCell)
	if changed then
		self:registerCellMutation(tileX, tileY, nextPackedCell)
	end
	return changed
end

function LiquidServiceServer:IsSolid(tileX: number, tileY: number): boolean
	local world = self.world
	if world == nil then
		return true
	end
	local tileId = select(1, world:getTileAt(tileX, tileY))
	return tileId ~= world.tileId.AIR
end

function LiquidServiceServer:BuildSolverAccess(runtime: ChunkRuntime): LiquidSolverAccess
	local world = self.world
	local access: LiquidSolverAccess = {
		maxFill = self.config.maxFill,
		chunkSize = if world ~= nil then world.chunkSize else 32,
		maxLeakScanDistance = self.config.simulation.leakScanDistanceTiles,
		getCell = function(tileX: number, tileY: number): number
			if world == nil then
				return 0
			end
			return world:getLiquidCellAt(tileX, tileY)
		end,
		setCell = function(tileX: number, tileY: number, packedCell: number): boolean
			return self:setPackedCell(tileX, tileY, packedCell)
		end,
		isSolid = function(tileX: number, tileY: number): boolean
			return self:isSolid(tileX, tileY)
		end,
		isChunkReady = function(chunkX: number, chunkY: number): boolean
			if world == nil then
				return false
			end
			local readinessMethod = (world :: any).isChunkCollisionReady
			if typeof(readinessMethod) == "function" then
				return readinessMethod(world, chunkX, chunkY) == true
			end
			return true
		end,
		pushDirty = function(tileX: number, tileY: number, reason: string?, sourceTileX: number?, sourceTileY: number?)
			self:markTileDirty(tileX, tileY, reason or "solverCascade", sourceTileX, sourceTileY)
		end,
		getDefinition = function(liquidType: number): LiquidDefinition?
			return self:getDefinition(liquidType)
		end,
		reportCellState = function(
			tileX: number,
			tileY: number,
			state: string,
			reason: string,
			fill: number,
			liquidType: number
		)
			self:updateCellDebugVisual(tileX, tileY, state, reason, fill, liquidType)
		end,
		recordMetric = function(metricName: string, amountRaw: any?)
			self:recordSimulationMetric(metricName, amountRaw, runtime)
		end,
	}
	return access
end

function LiquidServiceServer:StepChunk(chunkKey: string, mutationsRaw: any, budgetRaw: any): (number, number)
	local world = self.world
	if world == nil then
		return 0, 0
	end
	local snapshot = self:getChunkSnapshot(chunkKey)
	if snapshot == nil then
		return 0, 0
	end
	local runtime = self:getChunkRuntime(chunkKey)
	local budget = if isFiniteNumber(budgetRaw)
		then math.max(1, math.floor(budgetRaw))
		else self.config.simulation.maxCellsPerChunkStep
	local mutations = if typeof(mutationsRaw) == "table" then mutationsRaw :: { [number]: any } else {}
	local access = self:buildSolverAccess(runtime)
	runtime.lastActiveCellCount = 0
	runtime.lastDownwardTransfer = 0
	runtime.lastLateralTransfer = 0
	runtime.lastCrossChunkWakeups = 0

	local processed = 0
	local changed = 0
	for mutationIndex = 1, #mutations do
		local mutation = mutations[mutationIndex]
		if processed >= budget then
			self:requeueDirtyMutation(mutation)
			continue
		end
		if typeof(mutation) ~= "table" then
			continue
		end
		local tileX = if isFiniteNumber(mutation.x) then math.floor(mutation.x) else nil
		local tileY = if isFiniteNumber(mutation.y) then math.floor(mutation.y) else nil
		if tileX == nil or tileY == nil then
			continue
		end
		local localX = tileX - snapshot.tileMinX
		local localY = tileY - snapshot.tileMinY
		if localX < 0 or localX >= snapshot.width or localY < 0 or localY >= snapshot.height then
			continue
		end
		local index = LiquidServiceUtils.computeTileIndex(localX, localY, snapshot.width)
		if not runtime.dirtyLookup[index] then
			continue
		end
		runtime.dirtyLookup[index] = nil
		if runtime.queuedDirtyCount > 0 then
			runtime.queuedDirtyCount -= 1
		end
		local stepResult: LiquidSolverStepResult = LiquidSolver.stepCell(access, tileX, tileY)
		if stepResult.changed then
			changed += 1
		end
		if stepResult.waitingOnChunkReady then
			self:setChunkRegionState(
				chunkKey,
				runtime,
				CELL_DEBUG_STATE.DEFERRED_WAITING_FOR_CHUNK,
				stepResult.reason,
				stepResult.dependencyChunkKey
			)
		elseif stepResult.active then
			self:setChunkRegionState(chunkKey, runtime, CELL_DEBUG_STATE.ACTIVE, stepResult.reason)
		elseif stepResult.state == CELL_DEBUG_STATE.BLOCKED_BY_LOADED_TERRAIN then
			self:setChunkRegionState(chunkKey, runtime, CELL_DEBUG_STATE.BLOCKED_BY_LOADED_TERRAIN, stepResult.reason)
		end
		processed += 1
	end
	runtime.lastProcessedAt = os.clock()
	runtime.lastProcessedCells = processed
	runtime.lastChangedCells = changed
	self:recordSimulationMetric("cellsProcessed", processed, runtime)
	self:updateChunkDebugAttributes(chunkKey, runtime, {
		LastStepBudget = budget,
	})
	if processed > 0 then
		self:debugLog(
			"logSimulationSteps",
			`{chunkKey} stepped processed={processed} changed={changed} active={runtime.lastActiveCellCount} down={runtime.lastDownwardTransfer} lateral={runtime.lastLateralTransfer} remainingDirty={getDirtyCount(
				runtime
			)}`
		)
	end
	return processed, changed
end

function LiquidServiceServer:VerifyChunkStability(
	chunkKey: string,
	runtime: ChunkRuntime,
	reasonRaw: any?
): (boolean, string, number)
	if not self:isCollisionChunkReadyByKey(chunkKey) then
		local deferredReason = `awaitingCollisionChunk {chunkKey}`
		self:setChunkRegionState(
			chunkKey,
			runtime,
			CELL_DEBUG_STATE.DEFERRED_WAITING_FOR_CHUNK,
			deferredReason,
			chunkKey
		)
		runtime.lastStabilityScanUnstableCells = math.max(1, runtime.lastStabilityScanUnstableCells)
		return false, deferredReason, runtime.lastStabilityScanUnstableCells
	end

	local snapshot = self:getChunkSnapshot(chunkKey)
	if snapshot == nil then
		runtime.lastStabilityScanUnstableCells = 0
		return true, "missingSnapshot", 0
	end

	local access = self:buildSolverAccess(runtime)
	local unstableCount = 0
	local deferredCount = 0
	local firstReason = nil :: string?
	local dependencyChunkKey = nil :: string?
	for index = 1, #snapshot.cells do
		local packedCell = snapshot.cells[index]
		if not isFiniteNumber(packedCell) or packedCell <= 0 then
			continue
		end
		local zeroIndex = index - 1
		local localY = math.floor(zeroIndex / snapshot.width)
		local localX = zeroIndex - localY * snapshot.width
		local tileX = snapshot.tileMinX + localX
		local tileY = snapshot.tileMinY + localY
		local inspection = LiquidSolver.inspectCell(access, tileX, tileY)
		if inspection.hasLiquid and not inspection.isStable then
			if inspection.waitingOnChunkReady then
				deferredCount += 1
				dependencyChunkKey = dependencyChunkKey or inspection.dependencyChunkKey
				if firstReason == nil then
					firstReason = inspection.reason
				end
			else
				unstableCount += 1
				if firstReason == nil then
					firstReason = inspection.reason
				end
				self:markTileDirty(tileX, tileY, `stabilityScan:{inspection.state}`)
				for _, wakeTileEntry in inspection.wakeTiles do
					self:markTileDirty(
						wakeTileEntry.tileX,
						wakeTileEntry.tileY,
						`stabilityScan:{inspection.state}`,
						tileX,
						tileY
					)
				end
			end
		end
	end

	runtime.lastStabilityScanUnstableCells = unstableCount + deferredCount
	self:updateChunkDebugAttributes(chunkKey, runtime)
	if deferredCount > 0 then
		local deferredReason = firstReason or `awaitingCollisionChunk {dependencyChunkKey or chunkKey}`
		self:setChunkRegionState(
			chunkKey,
			runtime,
			CELL_DEBUG_STATE.DEFERRED_WAITING_FOR_CHUNK,
			deferredReason,
			dependencyChunkKey
		)
		return false, deferredReason, deferredCount
	end
	if unstableCount > 0 then
		self:setChunkRegionState(chunkKey, runtime, CELL_DEBUG_STATE.ACTIVE, firstReason or "unstable")
		local reopenedReason =
			`{if typeof(reasonRaw) == "string" then reasonRaw else "stabilityScan"} reopened; unstableCells={unstableCount}; first={firstReason or "unknown"}`
		self:debugLog("logStableTransitions", `{chunkKey} reopened ({reopenedReason})`)
		return false, reopenedReason, unstableCount
	end

	return true, "downwardSealed lateralSealed leakPathClear boundaryClear", 0
end

function LiquidServiceServer:CollectActiveChunkKeys(): ({ string }, { [string]: string }, { [string]: boolean })
	local activeLookup: { [string]: boolean } = {}
	local activeKeys: { string } = {}
	local activeReasonLists: { [string]: { string } } = {}
	local now = os.clock()

	for _, stream in self.playerStreams do
		for chunkKey in stream.interestKeys do
			if not activeLookup[chunkKey] then
				activeLookup[chunkKey] = true
				table.insert(activeKeys, chunkKey)
				activeReasonLists[chunkKey] = {}
			end
			appendReason(activeReasonLists[chunkKey], "playerInterest")
		end
	end

	for chunkKey, runtime in self.chunkRuntimes do
		local hasDirtyTiles = getDirtyCount(runtime) > 0
		local recentlyDisturbed = now - runtime.lastDisturbedAt <= self.config.simulation.disturbedChunkKeepAliveSeconds
		local waitingOnChunkReady = runtime.waitingOnChunkReady
		if not hasDirtyTiles and not recentlyDisturbed and not waitingOnChunkReady then
			continue
		end
		if not activeLookup[chunkKey] then
			activeLookup[chunkKey] = true
			table.insert(activeKeys, chunkKey)
			activeReasonLists[chunkKey] = {}
		end
		if hasDirtyTiles then
			appendReason(activeReasonLists[chunkKey], "dirty")
		end
		if recentlyDisturbed then
			appendReason(activeReasonLists[chunkKey], "disturbed")
		end
		if waitingOnChunkReady then
			appendReason(activeReasonLists[chunkKey], "waitingOnChunkReady")
		end
	end

	table.sort(activeKeys)
	local activeReasons: { [string]: string } = {}
	for chunkKey, reasons in activeReasonLists do
		activeReasons[chunkKey] = table.concat(reasons, "+")
	end
	return activeKeys, activeReasons, activeLookup
end

function LiquidServiceServer:ProcessSimulationStep()
	if self.debug ~= nil then
		self.debug:resetFrameCounters()
	end
	local solveToken = if self.debug ~= nil then self.debug:beginFrameScope("liquid_server_solve") else nil
	self.simulationStepId += 1
	self.currentSimulationStats = createSimulationTickStats()
	self.currentSimulationStats.chunkReadinessWakeups = self.pendingChunkReadinessWakeups
	self.pendingChunkReadinessWakeups = 0
	self.currentSimulationStats.collisionChunksLoaded = self:getLoadedCollisionChunkCount()
	self.currentSimulationStats.wakeRequestsQueued = self:getPendingWakeRequestCount()
	self.currentSimulationStats.wakeRequestsProcessed =
		self:flushWakeRequests(self.config.simulation.maxWakeRequestsPerTick)
	local activeKeys, activeReasons, activeLookup = self:collectActiveChunkKeys()
	self.currentSimulationStats.activeChunks = #activeKeys
	local reactivatedChunks: { [string]: boolean } = {}
	for _, chunkKey in activeKeys do
		local runtime = self:getChunkRuntime(chunkKey)
		local activeReason = activeReasons[chunkKey] or "active"
		local wasActiveLastStep = runtime.lastActiveStepId > 0 and runtime.lastActiveStepId == self.simulationStepId - 1
		reactivatedChunks[chunkKey] = not wasActiveLastStep
		runtime.lastActiveStepId = self.simulationStepId
		if not wasActiveLastStep then
			runtime.lastActivationAt = os.clock()
			runtime.lastActivationReason = activeReason
			if self:isCollisionChunkReadyByKey(chunkKey) then
				local restored = self:restoreQueuedDirtyCellsForChunk(chunkKey, `{activeReason}:reactivationRestore`)
				if restored == 0 then
					self:primeChunkRuntime(chunkKey, activeReason)
				end
				self:setChunkRegionState(chunkKey, runtime, CELL_DEBUG_STATE.ACTIVE, activeReason)
			else
				self:setChunkRegionState(
					chunkKey,
					runtime,
					CELL_DEBUG_STATE.DEFERRED_WAITING_FOR_CHUNK,
					`awaitingCollisionChunk {chunkKey}`,
					chunkKey
				)
			end
			self:updateChunkDebugAttributes(chunkKey, runtime, {
				InActiveSet = true,
				ActiveReason = activeReason,
			})
			self:debugLog("logActivations", `{chunkKey} entered active set ({activeReason})`)
		end
	end
	self.currentSimulationStats.queuedCells = self.dirtyCellQueue:getPendingCount()
	for _, chunkKey in activeKeys do
		if getDirtyCount(self:getChunkRuntime(chunkKey)) > 0 then
			self.currentSimulationStats.dirtyChunks += 1
		end
	end
	if self:isDebugEnabled() and self.config.debug.visualizeChunks then
		for chunkKey, runtime in self.chunkRuntimes do
			self:updateChunkDebugAttributes(chunkKey, runtime, {
				InActiveSet = activeLookup[chunkKey] == true,
				ActiveReason = activeReasons[chunkKey] or "",
			})
		end
	end

	local processedChunks = 0
	local touchedChunks: { [string]: boolean } = {}
	local maxMutationBudget = self.config.simulation.maxChunkStepsPerTick * self.config.simulation.maxCellsPerChunkStep
	local flushBatch = self.dirtyCellQueue:flush(maxMutationBudget)
	if flushBatch ~= nil then
		for _, chunkBatch in flushBatch.chunks do
			local chunkKey = LiquidServiceUtils.packChunkKey(chunkBatch.chunkX, chunkBatch.chunkY)
			if processedChunks >= self.config.simulation.maxChunkStepsPerTick then
				for _, mutation in chunkBatch.mutations do
					self:requeueDirtyMutation(mutation)
				end
				continue
			end
			local runtime = self:getChunkRuntime(chunkKey)
			if not self:isCollisionChunkReadyByKey(chunkKey) then
				self:setChunkRegionState(
					chunkKey,
					runtime,
					CELL_DEBUG_STATE.DEFERRED_WAITING_FOR_CHUNK,
					`awaitingCollisionChunk {chunkKey}`,
					chunkKey
				)
				continue
			end
			local processedCells, _changedCells =
				self:stepChunk(chunkKey, chunkBatch.mutations, self.config.simulation.maxCellsPerChunkStep)
			if processedCells <= 0 then
				continue
			end
			processedChunks += 1
			touchedChunks[chunkKey] = true
			if getDirtyCount(runtime) <= 0 then
				local isStable, stableReason = self:verifyChunkStability(chunkKey, runtime, "dirtyQueueDrained")
				if isStable then
					self:markChunkStable(chunkKey, runtime, stableReason)
				end
			end
		end
	end

	for _, chunkKey in activeKeys do
		if touchedChunks[chunkKey] then
			continue
		end
		local runtime = self:getChunkRuntime(chunkKey)
		if getDirtyCount(runtime) > 0 then
			continue
		end
		if reactivatedChunks[chunkKey] then
			local isStable, stableReason = self:verifyChunkStability(chunkKey, runtime, "reactivatedWithoutDirtyWork")
			if isStable then
				self:markChunkStable(chunkKey, runtime, stableReason)
			end
		end
	end

	self.currentSimulationStats.queuedCells = self.dirtyCellQueue:getPendingCount()
	self.currentSimulationStats.dirtyChunks = 0
	self.currentSimulationStats.deferredChunks = 0
	for _, runtime in self.chunkRuntimes do
		if getDirtyCount(runtime) > 0 then
			self.currentSimulationStats.dirtyChunks += 1
		end
		if runtime.waitingOnChunkReady then
			self.currentSimulationStats.deferredChunks += 1
		end
	end
	self.currentSimulationStats.collisionChunksLoaded = self:getLoadedCollisionChunkCount()
	if self.debug ~= nil then
		self.debug:endFrameScope("liquid_server_solve", solveToken)
	end
	self:updateSimulationDebugStats()
end

function LiquidServiceServer:ProcessConsistencySweep()
	local world = self.world
	if world == nil then
		return
	end
	local debugToken = if self.debug ~= nil then self.debug:beginFrameScope("liquid_consistency_sweep") else nil
	self:pruneRecentChunkActivity()

	local queryResults = self.sweepResultPool:acquire() :: { any }
	local candidateLookup: { [string]: boolean } = {}
	local candidateKeys: { string } = {}
	local sweepRadiusStuds = world.chunkSize
		* world.tileSize
		* math.max(1, self.config.simulation.activeSafetyMarginChunks + 2)

	for player in self.playerStreams do
		local rootPart = resolveCharacterRootPart(resolvePlayerCharacter(player))
		if rootPart == nil then
			continue
		end
		table.clear(queryResults)
		local entries = self.recentChunkGrid:queryRadius(
			rootPart.Position.Z,
			rootPart.Position.Y,
			0,
			sweepRadiusStuds,
			queryResults
		)
		for entryIndex = 1, #entries do
			local entry = entries[entryIndex]
			local payload = if typeof(entry) == "table" then entry.payload else nil
			local chunkKey = if typeof(payload) == "table" and typeof(payload.key) == "string" then payload.key else nil
			if chunkKey == nil or candidateLookup[chunkKey] then
				continue
			end
			candidateLookup[chunkKey] = true
			candidateKeys[#candidateKeys + 1] = chunkKey
		end
	end

	table.clear(queryResults)
	self.sweepResultPool:release(queryResults)
	table.sort(candidateKeys)

	local processed = 0
	for _, chunkKey in candidateKeys do
		if processed >= self.config.simulation.consistencySweepChunkBudget then
			break
		end
		local runtime = self.chunkRuntimes[chunkKey]
		if runtime == nil or getDirtyCount(runtime) > 0 then
			continue
		end
		if
			runtime.waitingOnChunkReady
			and runtime.dependencyChunkKey ~= ""
			and self:isCollisionChunkReadyByKey(chunkKey)
			and self:isCollisionChunkReadyByKey(runtime.dependencyChunkKey)
		then
			local restored = self:restoreQueuedDirtyCellsForChunk(chunkKey, "consistencyChunkReady")
			if restored == 0 then
				self:primeChunkRuntime(chunkKey, "consistencyChunkReady")
			end
			self:setChunkRegionState(chunkKey, runtime, CELL_DEBUG_STATE.ACTIVE, "consistencyChunkReady")
			self:recordSimulationMetric("consistencyRequeues", 1, runtime)
			processed += 1
			continue
		end
		if not self:isCollisionChunkReadyByKey(chunkKey) then
			self:setChunkRegionState(
				chunkKey,
				runtime,
				CELL_DEBUG_STATE.DEFERRED_WAITING_FOR_CHUNK,
				`awaitingCollisionChunk {chunkKey}`,
				chunkKey
			)
			processed += 1
			continue
		end
		local isStable = self:verifyChunkStability(chunkKey, runtime, "consistencySweep")
		if not isStable then
			self:recordSimulationMetric("consistencyRequeues", 1, runtime)
		end
		processed += 1
	end

	if self.debug ~= nil then
		self.debug:setCounter("liquid_consistency_candidates", #candidateKeys)
		self.debug:setCounter("liquid_consistency_processed", processed)
		self.debug:endFrameScope("liquid_consistency_sweep", debugToken)
	end
	local debugFolder = self:getDebugFolder()
	if debugFolder ~= nil and self.debug ~= nil then
		local counters = self.debug:getCounters()
		debugFolder:SetAttribute("ConsistencyCandidates", #candidateKeys)
		debugFolder:SetAttribute("ConsistencyProcessed", processed)
		debugFolder:SetAttribute(
			"TimeConsistencySweepMs",
			math.round(((counters.time_liquid_consistency_sweep or 0) * 1000) * 100) / 100
		)
	end
end

function LiquidServiceServer:RedistributeDisplacedLiquid(tileX: number, tileY: number, packedCell: number)
	local liquidType, fill = LiquidCell.unpack(packedCell)
	if liquidType == LIQUID_TYPE.NONE or fill <= 0 then
		return
	end

	local remaining = fill
	for _, target in
		{
			{ tileX, tileY + 1 },
			{ tileX - 1, tileY },
			{ tileX + 1, tileY },
		}
	do
		if remaining <= 0 then
			break
		end
		local targetX = target[1]
		local targetY = target[2]
		if self:isSolid(targetX, targetY) then
			continue
		end
		local existingCell = if self.world ~= nil then self.world:getLiquidCellAt(targetX, targetY) else 0
		local existingType, existingFill = LiquidCell.unpack(existingCell)
		if existingType ~= LIQUID_TYPE.NONE and existingType ~= liquidType then
			continue
		end
		local transfer = math.min(remaining, self.config.maxFill - existingFill)
		if transfer <= 0 then
			continue
		end
		remaining -= transfer
		self:setPackedCell(
			targetX,
			targetY,
			LiquidCell.make(liquidType, existingFill + transfer, LiquidServiceUtils.FLOW_STATE.SPREADING)
		)
		self:wakeLiquidRegion(targetX, targetY, "displacedLiquid", {
			radius = 1,
			sourceTileX = tileX,
			sourceTileY = tileY,
			scanNearby = false,
		})
	end
end

function LiquidServiceServer:ReactivateNearbyLiquid(tileX: number, tileY: number, reasonRaw: any?)
	local reason = if typeof(reasonRaw) == "string" and reasonRaw ~= "" then reasonRaw else "terrainChange"
	self:wakeLiquidRegion(tileX, tileY, reason, {
		radius = 2,
		sourceTileX = tileX,
		sourceTileY = tileY,
		scanNearby = true,
	})
end

function LiquidServiceServer:NotifyTerrainChanged(
	tileXRaw: any,
	tileYRaw: any,
	previousTileIdRaw: any,
	nextTileIdRaw: any,
	reasonRaw: any?
)
	if not isFiniteNumber(tileXRaw) or not isFiniteNumber(tileYRaw) then
		return
	end
	local tileX = math.floor(tileXRaw)
	local tileY = math.floor(tileYRaw)
	local world = self.world
	if world == nil then
		return
	end
	local chunkX = LiquidServiceUtils.toChunkCoordinate(tileX, world.chunkSize)
	local chunkY = LiquidServiceUtils.toChunkCoordinate(tileY, world.chunkSize)
	self:OnChunkTerrainChanged(chunkX, chunkY, {
		minTileX = tileX,
		minTileY = tileY,
		maxTileX = tileX,
		maxTileY = tileY,
	}, {
		reason = if typeof(reasonRaw) == "string" and reasonRaw ~= "" then reasonRaw else "terrainChange",
		sourceTileX = tileX,
		sourceTileY = tileY,
		previousTileId = if isFiniteNumber(previousTileIdRaw) then math.floor(previousTileIdRaw) else world.tileId.AIR,
		nextTileId = if isFiniteNumber(nextTileIdRaw) then math.floor(nextTileIdRaw) else world.tileId.AIR,
	})
end

function LiquidServiceServer:ProcessFullSnapshotQueues()
	for player, stream in self.playerStreams do
		if not stream.ready then
			continue
		end
		local processed = 0
		while processed < FULL_SNAPSHOT_BUDGET_PER_PLAYER do
			local chunkKey
			chunkKey, stream.fullQueueHead, stream.fullQueueTail =
				dequeueString(stream.fullQueue, stream.fullQueueLookup, stream.fullQueueHead, stream.fullQueueTail)
			if chunkKey == nil then
				break
			end
			if stream.interestKeys[chunkKey] == nil then
				continue
			end
			local snapshot = self:getChunkSnapshot(chunkKey)
			if snapshot == nil then
				continue
			end
			self.networker:fire(player, LiquidServiceUtils.CLIENT_METHOD_ON_CHUNK_SNAPSHOT, snapshot)
			stream.sentRevisions[chunkKey] = snapshot.revision
			processed += 1
		end
	end
end

function LiquidServiceServer:ProcessChangedChunks()
	for chunkKey in self.changedChunkKeys do
		local runtime = self.chunkRuntimes[chunkKey]
		if runtime == nil then
			continue
		end
		if runtime.pendingDeltaCount <= 0 then
			continue
		end
		table.sort(runtime.pendingDeltaIndices)

		local snapshot = if runtime.forceFullResync then self:getChunkSnapshot(chunkKey) else nil
		local deltaPayload = nil :: { [string]: any }?
		if not runtime.forceFullResync then
			local chunkSnapshot = self:getChunkSnapshot(chunkKey)
			if chunkSnapshot ~= nil then
				local changes = Sift.Array.create(#runtime.pendingDeltaIndices)
				for index, cellIndex in runtime.pendingDeltaIndices do
					changes[index] = {
						index = cellIndex,
						cell = runtime.pendingDeltaByIndex[cellIndex],
					}
				end
				deltaPayload = {
					key = chunkKey,
					chunkX = chunkSnapshot.chunkX,
					chunkY = chunkSnapshot.chunkY,
					width = chunkSnapshot.width,
					height = chunkSnapshot.height,
					revision = runtime.revision,
					changes = changes,
					updatedAt = os.clock(),
				}
			end
		end

		for player, stream in self.playerStreams do
			if not stream.ready then
				continue
			end
			if stream.interestKeys[chunkKey] == nil then
				continue
			end
			if stream.sentRevisions[chunkKey] == nil then
				self:enqueueFullSnapshot(stream, chunkKey)
				continue
			end

			if runtime.forceFullResync then
				if snapshot ~= nil then
					self.networker:fire(player, LiquidServiceUtils.CLIENT_METHOD_ON_CHUNK_SNAPSHOT, snapshot)
					stream.sentRevisions[chunkKey] = snapshot.revision
				end
			elseif deltaPayload ~= nil then
				self.networker:fire(player, LiquidServiceUtils.CLIENT_METHOD_ON_CHUNK_DELTA, deltaPayload)
				stream.sentRevisions[chunkKey] = runtime.revision
			end
		end

		table.clear(runtime.pendingDeltaByIndex)
		table.clear(runtime.pendingDeltaIndices)
		runtime.pendingDeltaCount = 0
		runtime.forceFullResync = false
	end
	table.clear(self.changedChunkKeys)
end

function LiquidServiceServer:GetPlayerQuery(player: Player): LiquidQueryResult
	local hazard = self:getHazardRuntime(player)
	local now = os.clock()
	if hazard.lastQuery ~= nil and now - hazard.lastQueryAt <= QUERY_CACHE_WINDOW then
		return hazard.lastQuery
	end

	local query = LiquidQuery.queryCharacter({
		tileSize = if self.world ~= nil then self.world.tileSize else 2,
		worldOrigin = if self.world ~= nil then self.world.worldOrigin else Vector3.zero,
		getCellAt = function(tileX: number, tileY: number): number
			if self.world == nil then
				return 0
			end
			return self.world:getLiquidCellAt(tileX, tileY)
		end,
		getLiquidDefinition = function(liquidType: number): LiquidDefinition?
			return self:getDefinition(liquidType)
		end,
	}, resolvePlayerCharacter(player))
	hazard.lastQuery = query
	hazard.lastQueryAt = now
	return query
end

function LiquidServiceServer:FireEffectEvent(
	player: Player,
	eventType: string,
	liquidType: number,
	query: LiquidQueryResult
)
	if self.networker == nil or not self:isPlayerStreamReady(player) then
		return
	end
	self.networker:fire(player, LiquidServiceUtils.CLIENT_METHOD_ON_EFFECT_EVENT, {
		eventType = eventType,
		liquidType = liquidType,
		submersionRatio = query.submersionRatio,
		updatedAt = os.clock(),
	})
end

function LiquidServiceServer:ApplyLiquidMovementSpeed(player: Player, query: LiquidQueryResult)
	local humanoid = resolveCharacterHumanoid(resolvePlayerCharacter(player))
	if humanoid == nil or not PlayerServiceUtils.isHumanoidAlive(humanoid) then
		return
	end

	local multiplier = nil :: number?
	if query.inLiquid then
		local definition = self:getDefinition(query.dominantType)
		if definition ~= nil and definition.movementSpeedMultiplier < 0.999 then
			multiplier = definition.movementSpeedMultiplier
		end
	end

	PlayerServiceUtils.setMovementSpeedMultiplier(
		humanoid,
		PlayerServiceUtils.LIQUID_WALK_SPEED_MULTIPLIER_ATTRIBUTE,
		multiplier
	)
end

function LiquidServiceServer:ProcessHazards()
	local lavaDefinition = LiquidDamage.getLavaDefinition(self.config)
	local now = os.clock()

	for player in self.playerStreams do
		if not self:isPlayerStreamReady(player) then
			continue
		end
		local hazard = self:getHazardRuntime(player)
		local query = self:getPlayerQuery(player)
		self:applyLiquidMovementSpeed(player, query)

		if query.inLiquid ~= hazard.wasInLiquid then
			if query.inLiquid then
				self.enteredLiquid:Fire(player, query)
				self:fireEffectEvent(player, LiquidServiceUtils.EFFECT_EVENT.ENTER, query.dominantType, query)
			else
				self.exitedLiquid:Fire(player, hazard.lastDominantType, query)
				self:fireEffectEvent(player, LiquidServiceUtils.EFFECT_EVENT.EXIT, hazard.lastDominantType, query)
			end
		end

		if query.meaningfulSubmersion ~= hazard.wasMeaningfullySubmerged then
			if query.meaningfulSubmersion then
				self.submergedStarted:Fire(player, query)
				self:fireEffectEvent(player, LiquidServiceUtils.EFFECT_EVENT.SUBMERGED_START, query.dominantType, query)
			else
				self.submergedEnded:Fire(player, hazard.lastDominantType, query)
				self:fireEffectEvent(
					player,
					LiquidServiceUtils.EFFECT_EVENT.SUBMERGED_END,
					hazard.lastDominantType,
					query
				)
			end
		end

		if lavaDefinition ~= nil and LiquidDamage.shouldApplyLavaContact(self.config, query) then
			if now - hazard.lastLavaDamageAt >= lavaDefinition.lavaTouchInterval then
				self.hpService:damagePlayer(player, lavaDefinition.lavaTouchDamage)
				hazard.lastLavaDamageAt = now
			end
			hazard.burnEndsAt = math.max(hazard.burnEndsAt, now + lavaDefinition.burnDuration)
		end

		local isBurning = hazard.burnEndsAt > now
		if isBurning and lavaDefinition ~= nil and now - hazard.lastBurnDamageAt >= lavaDefinition.burnInterval then
			self.hpService:damagePlayer(player, lavaDefinition.burnDamage)
			hazard.lastBurnDamageAt = now
		end

		if isBurning ~= hazard.wasBurning then
			if isBurning then
				self.burnStarted:Fire(player, hazard.burnEndsAt - now)
				self:fireEffectEvent(player, LiquidServiceUtils.EFFECT_EVENT.BURN_START, LIQUID_TYPE.LAVA, query)
			else
				self.burnEnded:Fire(player)
				self:fireEffectEvent(player, LiquidServiceUtils.EFFECT_EVENT.BURN_END, LIQUID_TYPE.LAVA, query)
			end
		end

		hazard.wasInLiquid = query.inLiquid
		hazard.wasMeaningfullySubmerged = query.meaningfulSubmersion
		hazard.wasBurning = isBurning
		hazard.lastDominantType = query.dominantType
	end
end

function LiquidServiceServer:OnHeartbeat(deltaTime: number)
	self:refreshWorldBinding()

	self.streamAccumulator += deltaTime
	self.simulationAccumulator += deltaTime
	self.hazardAccumulator += deltaTime
	self.consistencyAccumulator += deltaTime

	if self.streamAccumulator >= self.config.simulation.streamSyncInterval then
		self.streamAccumulator = 0
		for player in self.playerStreams do
			self:refreshPlayerInterest(player)
		end
		self:processFullSnapshotQueues()
	end

	local simulationStep = 1 / self.config.simulation.stepRate
	while self.simulationAccumulator >= simulationStep do
		self.simulationAccumulator -= simulationStep
		self:processSimulationStep()
	end

	local hazardStep = 1 / self.config.simulation.hazardCheckRate
	while self.hazardAccumulator >= hazardStep do
		self.hazardAccumulator -= hazardStep
		self:processHazards()
	end

	local consistencyStep = self.config.simulation.consistencySweepInterval
	while self.consistencyAccumulator >= consistencyStep do
		self.consistencyAccumulator -= consistencyStep
		self:processConsistencySweep()
	end

	self:processChangedChunks()
end

function LiquidServiceServer:TrackPlayer(player: Player)
	local stream = self.playerStreams[player]
	if stream == nil then
		stream = self:createPlayerStream()
		self.playerStreams[player] = stream
	end
	self.playerHazards[player] = self:createHazardRuntime()
end

function LiquidServiceServer:UntrackPlayer(player: Player)
	self.playerStreams[player] = nil
	self.playerHazards[player] = nil
end

function LiquidServiceServer:RequestSync(player: Player)
	if self.playerStreams[player] == nil then
		self:trackPlayer(player)
	end
	self:refreshWorldBinding()
	local stream = self:getPlayerStream(player)
	stream.ready = true
	table.clear(stream.interestKeys)
	table.clear(stream.sentRevisions)
	table.clear(stream.fullQueue)
	table.clear(stream.fullQueueLookup)
	stream.fullQueueHead = 1
	stream.fullQueueTail = 0
	self:pushState(player)
	self:refreshPlayerInterest(player)
end

function LiquidServiceServer:GetPlayerLiquidQuery(player: Player): LiquidQueryResult
	return self:getPlayerQuery(player)
end

function LiquidServiceServer:RefreshWorldBinding()
	local latestWorld = self.worldGenerationService:getWorld()
	if latestWorld == self.world then
		return
	end

	if self.chunkLifecycleConnection ~= nil then
		self.chunkLifecycleConnection:Disconnect()
		self.chunkLifecycleConnection = nil
	end
	self.world = latestWorld
	if self.world ~= nil and typeof((self.world :: any).registerChunkLifecycleObserver) == "function" then
		self.chunkLifecycleConnection = (
			(self.world :: any):registerChunkLifecycleObserver(self)
		) :: ChunkLifecycleConnection?
	end

	table.clear(self.chunkRuntimes)
	table.clear(self.changedChunkKeys)
	table.clear(self.pendingWakeQueue)
	table.clear(self.pendingWakeLookup)
	self.pendingWakeHead = 1
	self.pendingWakeTail = 0
	self.pendingChunkReadinessWakeups = 0
	self.currentSimulationStats = createSimulationTickStats()

	if self.dirtyCellQueue ~= nil then
		self.dirtyCellQueue:destroy()
	end
	self.dirtyCellQueue = WorldMutationQueue.new({
		chunkSize = if self.world ~= nil then self.world.chunkSize else 32,
		flushInterval = 1 / self.config.simulation.stepRate,
		maxMutationsPerFlush = self.config.simulation.maxChunkStepsPerTick
			* self.config.simulation.maxCellsPerChunkStep,
	})

	self.recentChunkGrid = SpatialHashGrid.new({
		cellSize = if self.world ~= nil then math.max(1, self.world.chunkSize * self.world.tileSize) else 64,
		cellsPerChunk = 2,
		deterministicQueries = true,
	})
	table.clear(self.recentChunkTouchedAt)

	if self.debugFolder ~= nil and self.debugFolder.Parent ~= nil then
		self.debugFolder:Destroy()
		self.debugFolder = nil
	end

	for player, stream in self.playerStreams do
		local nextStream = self:createPlayerStream()
		nextStream.ready = stream.ready
		self.playerStreams[player] = nextStream
	end
	for player in self.playerHazards do
		self.playerHazards[player] = self:createHazardRuntime()
	end
end

function LiquidServiceServer:Init()
	self.runtimeContext = CoreRuntime.getServerRuntime()
	if self.runtimeContext ~= nil and typeof((self.runtimeContext :: any).init) == "function" then
		local runtimeAny = self.runtimeContext :: any
		runtimeAny:init()
	end
	self.config = LiquidServiceUtils.sanitizeConfig(resolveSourceConfig(), nil)
	self.state = LiquidServiceUtils.createDefaultState()
	self.worldGenerationService = WorldGenerationServiceServer :: WorldGenerationServiceServerObject
	self.world = self.worldGenerationService:getWorld()
	self.chunkLifecycleConnection = nil :: ChunkLifecycleConnection?
	if self.world ~= nil and typeof((self.world :: any).registerChunkLifecycleObserver) == "function" then
		self.chunkLifecycleConnection = (
			(self.world :: any):registerChunkLifecycleObserver(self)
		) :: ChunkLifecycleConnection?
	end
	self.hpService = HpServiceServer :: HpServiceServerObject
	self.debug = WorldSimulationDebug.new({
		enabled = self.config.debug.enabled,
		profilingEnabled = self.config.debug.enabled,
	})
	self.chunkRuntimes = {} :: { [string]: ChunkRuntime }
	self.playerStreams = {} :: { [Player]: PlayerStream }
	self.playerHazards = {} :: { [Player]: PlayerHazardRuntime }
	self.changedChunkKeys = {} :: { [string]: boolean }
	self.dirtyCellQueue = WorldMutationQueue.new({
		chunkSize = if self.world ~= nil then self.world.chunkSize else 32,
		flushInterval = 1 / self.config.simulation.stepRate,
		maxMutationsPerFlush = self.config.simulation.maxChunkStepsPerTick
			* self.config.simulation.maxCellsPerChunkStep,
	})
	self.wakeRequestPool = ObjectPool.new(function()
		return {
			key = "",
			tileX = 0,
			tileY = 0,
			radius = 0,
			reason = "",
			sourceTileX = nil,
			sourceTileY = nil,
			scanNearby = false,
		} :: WakeRequest
	end, {
		expandBy = 24,
		maxAvailable = 2048,
		reset = function(request: WakeRequest)
			request.key = ""
			request.tileX = 0
			request.tileY = 0
			request.radius = 0
			request.reason = ""
			request.sourceTileX = nil
			request.sourceTileY = nil
			request.scanNearby = false
		end,
	})
	self.sweepResultPool = ObjectPool.new(function()
		return {}
	end, {
		expandBy = 4,
		maxAvailable = 48,
		reset = function(array: { any })
			table.clear(array)
		end,
	})
	self.pendingWakeQueue = {} :: { WakeRequest }
	self.pendingWakeHead = 1
	self.pendingWakeTail = 0
	self.pendingWakeLookup = {} :: { [string]: boolean }
	self.recentChunkGrid = SpatialHashGrid.new({
		cellSize = if self.world ~= nil then math.max(1, self.world.chunkSize * self.world.tileSize) else 64,
		cellsPerChunk = 2,
		deterministicQueries = true,
	})
	self.recentChunkTouchedAt = {} :: { [string]: number }
	self.streamAccumulator = self.config.simulation.streamSyncInterval
	self.simulationAccumulator = 0
	self.hazardAccumulator = 0
	self.consistencyAccumulator = 0
	self.simulationStepId = 0
	self.pendingChunkReadinessWakeups = 0
	self.debugFolder = nil :: Folder?
	self.currentSimulationStats = createSimulationTickStats()

	self.enteredLiquid = Signal.new()
	self.exitedLiquid = Signal.new()
	self.submergedStarted = Signal.new()
	self.submergedEnded = Signal.new()
	self.burnStarted = Signal.new()
	self.burnEnded = Signal.new()

	self.networker = Networker.server.new("LiquidService", self, {
		self.RequestSync,
	})

	self.playerAddedConnection = Players.PlayerAdded:Connect(function(player: Player)
		if isGameplayReplicationActive(player) then
			self:trackPlayer(player)
		end
	end)
	self.playerRemovingConnection = Players.PlayerRemoving:Connect(function(player: Player)
		self:untrackPlayer(player)
	end)
	local tickScheduler = if self.runtimeContext ~= nil then (self.runtimeContext :: any).tickScheduler else nil
	if tickScheduler ~= nil and typeof((tickScheduler :: any).scheduleEvery) == "function" then
		self.heartbeatToken = (tickScheduler :: any):scheduleEvery(
			function(deltaTime: number)
				self:onHeartbeat(deltaTime)
			end,
			1 / 60,
			{
				group = "service.liquid.server",
				priority = TickSchedulerModule.Priority.NORMAL + 20,
				catchUp = false,
			}
		)
		self.poolMaintenanceToken = (tickScheduler :: any):scheduleEvery(
			function()
				self.wakeRequestPool:softShrink(24)
				self.sweepResultPool:softShrink(6)
			end,
			2.5,
			{
				group = "service.liquid.server",
				priority = TickSchedulerModule.Priority.LOW,
				catchUp = false,
			}
		)
	else
		self.heartbeatConnection = RunService.Heartbeat:Connect(function(deltaTime: number)
			self:onHeartbeat(deltaTime)
		end)
	end
end

function LiquidServiceServer:Destroy()
	if self.heartbeatToken ~= nil and typeof(self.heartbeatToken.cancel) == "function" then
		self.heartbeatToken:cancel()
		self.heartbeatToken = nil
	end
	if self.poolMaintenanceToken ~= nil and typeof(self.poolMaintenanceToken.cancel) == "function" then
		self.poolMaintenanceToken:cancel()
		self.poolMaintenanceToken = nil
	end
	if self.heartbeatConnection ~= nil then
		self.heartbeatConnection:Disconnect()
		self.heartbeatConnection = nil
	end
	if self.playerAddedConnection ~= nil then
		self.playerAddedConnection:Disconnect()
		self.playerAddedConnection = nil
	end
	if self.playerRemovingConnection ~= nil then
		self.playerRemovingConnection:Disconnect()
		self.playerRemovingConnection = nil
	end
	if self.chunkLifecycleConnection ~= nil then
		self.chunkLifecycleConnection:Disconnect()
		self.chunkLifecycleConnection = nil
	end
	if self.networker ~= nil then
		self.networker:destroy()
		self.networker = nil
	end
	if self.enteredLiquid ~= nil then
		self.enteredLiquid:Destroy()
		self.exitedLiquid:Destroy()
		self.submergedStarted:Destroy()
		self.submergedEnded:Destroy()
		self.burnStarted:Destroy()
		self.burnEnded:Destroy()
	end
	table.clear(self.chunkRuntimes)
	table.clear(self.playerStreams)
	table.clear(self.playerHazards)
	table.clear(self.changedChunkKeys)
	if self.dirtyCellQueue ~= nil then
		self.dirtyCellQueue:destroy()
	end
	if self.wakeRequestPool ~= nil then
		self.wakeRequestPool:destroy()
	end
	if self.sweepResultPool ~= nil then
		self.sweepResultPool:destroy()
	end
	if self.recentChunkGrid ~= nil then
		self.recentChunkGrid:clear()
	end
	if self.debug ~= nil then
		self.debug:destroy()
		self.debug = nil
	end
	if self.debugFolder ~= nil and self.debugFolder.Parent ~= nil then
		self.debugFolder:Destroy()
		self.debugFolder = nil
	end
end

LiquidServiceServer.createChunkRuntime = LiquidServiceServer.CreateChunkRuntime
LiquidServiceServer.getChunkRuntime = LiquidServiceServer.GetChunkRuntime
LiquidServiceServer.isCollisionChunkReadyByKey = LiquidServiceServer.IsCollisionChunkReadyByKey
LiquidServiceServer.getLoadedCollisionChunkCount = LiquidServiceServer.GetLoadedCollisionChunkCount
LiquidServiceServer.setChunkRegionState = LiquidServiceServer.SetChunkRegionState
LiquidServiceServer.restoreQueuedDirtyCellsForChunk = LiquidServiceServer.RestoreQueuedDirtyCellsForChunk
LiquidServiceServer.wakeChunkBounds = LiquidServiceServer.WakeChunkBounds
LiquidServiceServer.wakeChunkDependencyNeighborhood = LiquidServiceServer.WakeChunkDependencyNeighborhood
LiquidServiceServer.isDebugEnabled = LiquidServiceServer.IsDebugEnabled
LiquidServiceServer.shouldDebugLog = LiquidServiceServer.ShouldDebugLog
LiquidServiceServer.debugLog = LiquidServiceServer.DebugLog
LiquidServiceServer.getDebugFolder = LiquidServiceServer.GetDebugFolder
LiquidServiceServer.getChunkDebugFolder = LiquidServiceServer.GetChunkDebugFolder
LiquidServiceServer.getChunkCellDebugFolder = LiquidServiceServer.GetChunkCellDebugFolder
LiquidServiceServer.updateSimulationDebugStats = LiquidServiceServer.UpdateSimulationDebugStats
LiquidServiceServer.updateCellDebugVisual = LiquidServiceServer.UpdateCellDebugVisual
LiquidServiceServer.updateChunkDebugAttributes = LiquidServiceServer.UpdateChunkDebugAttributes
LiquidServiceServer.createPlayerStream = LiquidServiceServer.CreatePlayerStream
LiquidServiceServer.getPlayerStream = LiquidServiceServer.GetPlayerStream
LiquidServiceServer.isPlayerStreamReady = LiquidServiceServer.IsPlayerStreamReady
LiquidServiceServer.createHazardRuntime = LiquidServiceServer.CreateHazardRuntime
LiquidServiceServer.getHazardRuntime = LiquidServiceServer.GetHazardRuntime
LiquidServiceServer.createStateSnapshot = LiquidServiceServer.CreateStateSnapshot
LiquidServiceServer.pushState = LiquidServiceServer.PushState
LiquidServiceServer.getDefinition = LiquidServiceServer.GetDefinition
LiquidServiceServer.getChunkSnapshot = LiquidServiceServer.GetChunkSnapshot
LiquidServiceServer.enqueueFullSnapshot = LiquidServiceServer.EnqueueFullSnapshot
LiquidServiceServer.markChunkStable = LiquidServiceServer.MarkChunkStable
LiquidServiceServer.recordSimulationMetric = LiquidServiceServer.RecordSimulationMetric
LiquidServiceServer.getPendingWakeRequestCount = LiquidServiceServer.GetPendingWakeRequestCount
LiquidServiceServer.getChunkWorldPosition = LiquidServiceServer.GetChunkWorldPosition
LiquidServiceServer.trackRecentChunkActivity = LiquidServiceServer.TrackRecentChunkActivity
LiquidServiceServer.pruneRecentChunkActivity = LiquidServiceServer.PruneRecentChunkActivity
LiquidServiceServer.requeueDirtyMutation = LiquidServiceServer.RequeueDirtyMutation
LiquidServiceServer.primeChunkRuntime = LiquidServiceServer.PrimeChunkRuntime
LiquidServiceServer.expandInterestKeys = LiquidServiceServer.ExpandInterestKeys
LiquidServiceServer.refreshPlayerInterest = LiquidServiceServer.RefreshPlayerInterest
LiquidServiceServer.markTileDirty = LiquidServiceServer.MarkTileDirty
LiquidServiceServer.markAreaDirty = LiquidServiceServer.MarkAreaDirty
LiquidServiceServer.wakeLiquidRegion = LiquidServiceServer.WakeLiquidRegion
LiquidServiceServer.applyWakeRequest = LiquidServiceServer.ApplyWakeRequest
LiquidServiceServer.flushWakeRequests = LiquidServiceServer.FlushWakeRequests
LiquidServiceServer.registerCellMutation = LiquidServiceServer.RegisterCellMutation
LiquidServiceServer.setPackedCell = LiquidServiceServer.SetPackedCell
LiquidServiceServer.isSolid = LiquidServiceServer.IsSolid
LiquidServiceServer.buildSolverAccess = LiquidServiceServer.BuildSolverAccess
LiquidServiceServer.stepChunk = LiquidServiceServer.StepChunk
LiquidServiceServer.verifyChunkStability = LiquidServiceServer.VerifyChunkStability
LiquidServiceServer.collectActiveChunkKeys = LiquidServiceServer.CollectActiveChunkKeys
LiquidServiceServer.processSimulationStep = LiquidServiceServer.ProcessSimulationStep
LiquidServiceServer.processConsistencySweep = LiquidServiceServer.ProcessConsistencySweep
LiquidServiceServer.redistributeDisplacedLiquid = LiquidServiceServer.RedistributeDisplacedLiquid
LiquidServiceServer.reactivateNearbyLiquid = LiquidServiceServer.ReactivateNearbyLiquid
LiquidServiceServer.notifyTerrainChanged = LiquidServiceServer.NotifyTerrainChanged
LiquidServiceServer.processFullSnapshotQueues = LiquidServiceServer.ProcessFullSnapshotQueues
LiquidServiceServer.processChangedChunks = LiquidServiceServer.ProcessChangedChunks
LiquidServiceServer.getPlayerQuery = LiquidServiceServer.GetPlayerQuery
LiquidServiceServer.fireEffectEvent = LiquidServiceServer.FireEffectEvent
LiquidServiceServer.applyLiquidMovementSpeed = LiquidServiceServer.ApplyLiquidMovementSpeed
LiquidServiceServer.processHazards = LiquidServiceServer.ProcessHazards
LiquidServiceServer.onHeartbeat = LiquidServiceServer.OnHeartbeat
LiquidServiceServer.trackPlayer = LiquidServiceServer.TrackPlayer
LiquidServiceServer.untrackPlayer = LiquidServiceServer.UntrackPlayer
LiquidServiceServer.requestSync = LiquidServiceServer.RequestSync
LiquidServiceServer.getPlayerLiquidQuery = LiquidServiceServer.GetPlayerLiquidQuery
LiquidServiceServer.refreshWorldBinding = LiquidServiceServer.RefreshWorldBinding
LiquidServiceServer.init = LiquidServiceServer.Init
LiquidServiceServer.destroy = LiquidServiceServer.Destroy

type LiquidServiceServer = typeof(LiquidServiceServer) & {
	runtimeContext: any?,
	config: LiquidServiceConfig,
	state: LiquidServiceState,
	worldGenerationService: WorldGenerationServiceServerObject,
	playerService: PlayerServiceServerObject?,
	world: WorldObject,
	hpService: HpServiceServerObject,
	debug: DebugObject?,
	chunkRuntimes: { [string]: ChunkRuntime },
	playerStreams: { [Player]: PlayerStream },
	playerHazards: { [Player]: PlayerHazardRuntime },
	changedChunkKeys: { [string]: boolean },
	dirtyCellQueue: any,
	wakeRequestPool: any,
	sweepResultPool: any,
	pendingWakeQueue: { WakeRequest },
	pendingWakeHead: number,
	pendingWakeTail: number,
	pendingWakeLookup: { [string]: boolean },
	recentChunkGrid: any,
	recentChunkTouchedAt: { [string]: number },
	streamAccumulator: number,
	simulationAccumulator: number,
	hazardAccumulator: number,
	consistencyAccumulator: number,
	simulationStepId: number,
	pendingChunkReadinessWakeups: number,
	currentSimulationStats: SimulationTickStats,
	networker: Networker.Server?,
	enteredLiquid: SignalObject,
	exitedLiquid: SignalObject,
	submergedStarted: SignalObject,
	submergedEnded: SignalObject,
	burnStarted: SignalObject,
	burnEnded: SignalObject,
	debugFolder: Folder?,
	chunkLifecycleConnection: ChunkLifecycleConnection?,
	heartbeatToken: CancellationToken?,
	poolMaintenanceToken: CancellationToken?,
	heartbeatConnection: RBXScriptConnection?,
	playerAddedConnection: RBXScriptConnection?,
	playerRemovingConnection: RBXScriptConnection?,
}

return LiquidServiceServer :: LiquidServiceServer
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="1054">
              <Properties>
                <string name="Name">LootServiceServer</string>
                <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerScriptService = game:GetService("ServerScriptService")
local Workspace = game:GetService("Workspace")

local AudioRegistry = require(script:FindFirstAncestor("game").Shared.Modules.Items.Audio)
local AudioServiceServer = require(script:FindFirstAncestor("game").Server.Services.AudioServiceServer)
local AudioServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.AudioServiceUtils)
local InstanceUtils = require(script:FindFirstAncestor("game").Shared.Modules.Platform.InstanceUtils)
local InventoryServiceServer = require(script:FindFirstAncestor("game").Server.Services.InventoryServiceServer)
local InventoryServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.InventoryServiceUtils)
local LootServiceCache = require(script:FindFirstAncestor("game").Shared.Services.LootCache)
local LootServiceData = require(script:FindFirstAncestor("game").Shared.Services.Data)
local LootServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.LootServiceUtils)
local Networker = require(script:FindFirstAncestor("game").Shared.Modules.Networking.Networker)
local NevermoreSupport = require(script:FindFirstAncestor("game").Shared.Modules.Core.NevermoreSupport)
local PlayerDataServiceServer = require(script:FindFirstAncestor("game").Server.Services.PlayerDataServiceServer)
local ResolveItem = require(script:FindFirstAncestor("game").Shared.Modules.Game.Format.ResolveItem)
local ResolveToolInstance = require(script:FindFirstAncestor("game").Shared.Modules.Game.Format.ResolveToolInstance)
local Ripple = require(ReplicatedStorage.Packages.Ripple)
local ServerBinderSupport = require(script:FindFirstAncestor("game").Server.Binders.ServerBinderSupport)
local StringUtils = require(script:FindFirstAncestor("game").Shared.Modules.Core.StringUtils)
local Vec = require(script:FindFirstAncestor("game").Shared.Modules.Math.Vec)
local WorkspaceFolders = require(script:FindFirstAncestor("game").Shared.Modules.Core.WorkspaceFolders)

type NumberMotion = Ripple.Motion<number>
type SpringOptions = Ripple.SpringOptions

type LootState = LootServiceUtils.LootState
type LootSettings = LootServiceUtils.LootSettings
type LootMetadata = LootServiceUtils.LootMetadata
type LootRollContext = LootServiceUtils.LootRollContext
type LootRarity = LootServiceUtils.LootRarity
type LootRollResult = LootServiceUtils.LootRollResult

type InventoryState = InventoryServiceUtils.InventoryState
type InventoryItemStack = InventoryServiceUtils.InventoryItemStack
type AddItemResult = InventoryServiceUtils.AddItemResult
type SlotMutationResult = InventoryServiceUtils.SlotMutationResult

type InventoryServiceServerObject = {
	getState: (self: InventoryServiceServerObject, player: Player) -> InventoryState,
	addItem: (
		self: InventoryServiceServerObject,
		player: Player,
		itemIdRaw: any,
		amountRaw: any,
		optionsRaw: any
	) -> AddItemResult,
	removeFromSlot: (
		self: InventoryServiceServerObject,
		player: Player,
		slotIndexRaw: any,
		amountRaw: any
	) -> SlotMutationResult,
	releaseSuppressedToolImport: (
		self: InventoryServiceServerObject,
		player: Player,
		itemIdRaw: any,
		amountRaw: any
	) -> number,
	setDropFromSlotHandler: (self: InventoryServiceServerObject, handlerRaw: any) -> (),
}

type PlayerDataServiceServerObject = {
	incrementValue: (
		self: PlayerDataServiceServerObject,
		player: Player,
		pathRaw: any,
		amountRaw: any,
		fallbackValueRaw: any,
		replicateToClientRaw: any
	) -> number?,
}

type AudioServiceServerObject = {
	playSfxForPlayer: (
		self: AudioServiceServerObject,
		player: Player,
		soundAssetIdRaw: any,
		optionsRaw: any
	) -> (),
	playSfxForAll: (self: AudioServiceServerObject, soundAssetIdRaw: any, optionsRaw: any) -> (),
}

type LootServiceCacheObject = LootServiceCache.Cache

type PlayerContext = {
	player: Player,
	rootPart: BasePart,
	position: Vector3,
}

type MagnetRuntime = {
	player: Player,
	startedAt: number,
	elapsed: number,
	startDistance: number,
	speed: number,
	xMotion: NumberMotion,
	yMotion: NumberMotion,
	zMotion: NumberMotion,
}

type LootRuntime = {
	id: string,
	itemId: string,
	amount: number,
	maxStack: number,
	metadata: LootMetadata?,
	rarity: LootRarity,
	sourceType: string,
	state: LootState,
	ownerUserId: number?,
	ownerReleaseAt: number,
	spawnedAt: number,
	expiresAt: number,
	stateEnteredAt: number,
	instance: Instance,
	rootPart: BasePart,
	lastKnownPosition: Vector3,
	lockedPlaneX: number?,
	stableSince: number?,
	forceIdleUntil: number,
	magnet: MagnetRuntime?,
	disposed: boolean,
	destroyConnection: RBXScriptConnection?,
}

local LootServiceServer = {}

local EPSILON = 1e-4
local LOOT_FOLDER_NAME = "LootRuntime"
local DROP_REQUEST_THROTTLE_SECONDS = 1 / 30
local FALLBACK_LOOT_COLOR_BY_RARITY: { [LootRarity]: Color3 } = {
	Common = Color3.fromRGB(202, 202, 202),
	Uncommon = Color3.fromRGB(102, 210, 132),
	Rare = Color3.fromRGB(110, 166, 255),
	Epic = Color3.fromRGB(191, 118, 255),
	Legendary = Color3.fromRGB(255, 191, 97),
}
local FALLBACK_LOOT_DEFAULT_COLOR = Color3.fromRGB(220, 220, 220)
local COIN_TYPE_BY_ITEM_TOKEN: { [string]: "copper" | "silver" | "gold" | "platinum" } = {
	coppercoin = "copper",
	coincopper = "copper",
	silvercoin = "silver",
	coinsilver = "silver",
	goldcoin = "gold",
	coingold = "gold",
	platinumcoin = "platinum",
	coinplatinum = "platinum",
}
local KATANA_DROP_TOKEN = "katana"
local LOOT_AUDIO = (AudioRegistry :: any).Loot or {}
local LOOT_ITEM_PICKUP_AUDIO = LOOT_AUDIO.ItemPickup or {}
local LOOT_COIN_DROP_AUDIO = LOOT_AUDIO.CoinDrop or {}
local LOOT_COIN_PICKUP_AUDIO = LOOT_AUDIO.CoinPickup or {}
local LOOT_PICKUP_VOLUME = 1.5

local function sanitizeOwnerUserId(userIdRaw: any): number?
	if typeof(userIdRaw) ~= "number" or userIdRaw ~= userIdRaw then
		return nil
	end
	local userId = math.floor(userIdRaw)
	if userId <= 0 then
		return nil
	end
	return userId
end

local function resolvePlayerRootPart(player: Player): BasePart?
	local character = player.Character
	if character == nil then
		return nil
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid ~= nil and humanoid.Health <= 0 then
		return nil
	end

	local rootPart = character:FindFirstChild("HumanoidRootPart")
	if rootPart ~= nil and rootPart:IsA("BasePart") then
		return rootPart
	end

	if character.PrimaryPart ~= nil then
		return character.PrimaryPart
	end

	return character:FindFirstChildWhichIsA("BasePart")
end

local function forEachBasePart(instance: Instance, callback: (BasePart) -> ())
	if instance:IsA("BasePart") then
		callback(instance)
	end
	for _, descendant in instance:GetDescendants() do
		if descendant:IsA("BasePart") then
			callback(descendant)
		end
	end
end

local function toUnitVectorOrFallback(directionRaw: any, fallbackRaw: Vector3): Vector3
	local fallback = fallbackRaw
	if fallback.Magnitude <= EPSILON then
		fallback = Vector3.new(0, 0, -1)
	end
	local fallbackUnit = Vec.unit(fallback, Vector3.new(0, 0, -1))

	local direction = LootServiceUtils.sanitizeVector3(directionRaw, fallback)
	if direction.Magnitude <= EPSILON then
		return fallbackUnit
	end
	return Vec.unit(direction, fallbackUnit)
end

local function shallowCopy(sourceRaw: any): { [string]: any }
	local output = {}
	if typeof(sourceRaw) ~= "table" then
		return output
	end
	for key, value in sourceRaw do
		if typeof(key) == "string" then
			output[key] = value
		end
	end
	return output
end

local function pickRandomSoundAssetId(randomObject: Random, soundAssetIds: { string }): string?
	local count = #soundAssetIds
	if count <= 0 then
		return nil
	end
	return soundAssetIds[randomObject:NextInteger(1, count)]
end

function LootServiceServer.CacheToolTemplateIfPossible(self: LootServiceServer, itemId: string, template: Instance?)
	if template == nil then
		return
	end
	if template:IsA("Tool") then
		self.cache:rememberToolTemplate(itemId, template)
	end
end

function LootServiceServer.IsToolMatchingItemId(self: LootServiceServer, tool: Tool, itemIdRaw: any): boolean
	local itemId = LootServiceUtils.sanitizeString(itemIdRaw, nil)
	if itemId == nil then
		return false
	end

	local targetTokens: { [string]: boolean } = {}
	for _, candidate in LootServiceUtils.resolveItemNameCandidates(self.data, itemId) do
		local token = StringUtils.compactToken(candidate)
		if token ~= "" then
			targetTokens[token] = true
		end
	end
	if next(targetTokens) == nil then
		targetTokens[StringUtils.compactToken(itemId)] = true
	end

	local resolvedToolItemId = ResolveToolInstance.resolveToolItemId(tool)
	local idCandidates = {
		resolvedToolItemId,
		tool:GetAttribute("itemId"),
		tool:GetAttribute("ItemId"),
		tool:GetAttribute("ittemId"),
		tool.Name,
	}
	for _, candidate in idCandidates do
		local candidateToken = StringUtils.compactToken(candidate)
		if candidateToken ~= "" and targetTokens[candidateToken] == true then
			return true
		end
	end
	return false
end

function LootServiceServer.CaptureDropToolClones(
	self: LootServiceServer,
	player: Player,
	itemIdRaw: any,
	amountRaw: any
): { Tool }
	local itemId = LootServiceUtils.sanitizeString(itemIdRaw, nil)
	if itemId == nil then
		return {}
	end

	local amount = LootServiceUtils.resolveDropAmount(amountRaw, 1)
	local remaining = math.max(0, math.floor(amount))
	if remaining <= 0 then
		return {}
	end

	local captured = {}
	local function captureFromContainer(container: Instance?)
		if container == nil or remaining <= 0 then
			return
		end
		for _, child in container:GetChildren() do
			if remaining <= 0 then
				break
			end
			if not child:IsA("Tool") then
				continue
			end
			if not self:isToolMatchingItemId(child, itemId) then
				continue
			end
			local clone = child:Clone()
			if clone:IsA("Tool") then
				clone.Parent = nil
				table.insert(captured, clone)
				remaining -= 1
			else
				clone:Destroy()
			end
		end
	end

	captureFromContainer(player.Character)
	local backpack = player:FindFirstChildOfClass("Backpack")
	captureFromContainer(backpack)
	return captured
end

function LootServiceServer.RestoreCachedDropTools(
	self: LootServiceServer,
	player: Player,
	runtime: LootRuntime,
	amountRaw: any
)
	local amount = LootServiceUtils.resolveDropAmount(amountRaw, 1)
	local remaining = math.max(0, math.floor(amount))
	if remaining <= 0 then
		return
	end

	local targetContainer: Instance? = player:FindFirstChildOfClass("Backpack")
	if targetContainer == nil then
		targetContainer = player.Character
	end
	if targetContainer == nil then
		return
	end

	while remaining > 0 do
		local tool = self.cache:popDroppedTool(runtime.id, runtime.itemId)
		if tool == nil then
			tool = self.cache:cloneToolTemplate(runtime.itemId)
			if tool ~= nil then
				tool:SetAttribute("itemId", runtime.itemId)
				tool:SetAttribute("ItemId", runtime.itemId)
				local metadata = runtime.metadata
				if typeof(metadata) == "table" then
					local itemType = LootServiceUtils.sanitizeString((metadata :: { [string]: any }).itemType, nil)
					if itemType ~= nil then
						tool:SetAttribute("itemType", itemType)
						tool:SetAttribute("ItemType", itemType)
					end
				end
			end
		end
		if tool == nil then
			break
		end

		self.inventoryService:releaseSuppressedToolImport(player, runtime.itemId, 1)
		tool.Parent = targetContainer
		remaining -= 1
	end
end

function LootServiceServer.ResolveCoinTypeFromItemId(
	self: LootServiceServer,
	itemIdRaw: any
): ("copper" | "silver" | "gold" | "platinum")?
	local itemId = LootServiceUtils.sanitizeString(itemIdRaw, nil)
	if itemId == nil then
		return nil
	end

	local itemToken = StringUtils.compactToken(itemId)
	local mapped = COIN_TYPE_BY_ITEM_TOKEN[itemToken]
	if mapped ~= nil then
		return mapped
	end

	for _, candidate in LootServiceUtils.resolveItemNameCandidates(self.data, itemId) do
		local token = StringUtils.compactToken(candidate)
		local byToken = COIN_TYPE_BY_ITEM_TOKEN[token]
		if byToken ~= nil then
			return byToken
		end
	end

	return nil
end

function LootServiceServer.ShouldRouteRuntimeToCoinWallet(self: LootServiceServer, runtime: LootRuntime): boolean
	if runtime.sourceType == "PlayerDrop" then
		return false
	end
	return self:resolveCoinTypeFromItemId(runtime.itemId) ~= nil
end

function LootServiceServer.TryCollectRuntimeToCoinWallet(
	self: LootServiceServer,
	runtime: LootRuntime,
	player: Player
): boolean
	local coinType = self:resolveCoinTypeFromItemId(runtime.itemId)
	if coinType == nil then
		return false
	end

	local amount = math.max(1, math.floor(runtime.amount))
	local nextValue = self.playerDataService:incrementValue(player, { "coins", coinType }, amount, 0, true)
	if nextValue == nil then
		return false
	end

	self:playPickupSound(runtime, player)
	self:transitionState(runtime, LootServiceUtils.STATE_COLLECTED, "CollectedCoinWallet")
	self:disposeRuntime(runtime, "CollectedCoinWallet")
	return true
end

function LootServiceServer.EnsureLootFolder(self: LootServiceServer): Folder
	return WorkspaceFolders.getOrCreateFolderInGame(LOOT_FOLDER_NAME)
end

function LootServiceServer.RefreshPickupSoundTemplates(self: LootServiceServer)
	self.itemPickupSoundAssetIds = AudioServiceUtils.collectSoundAssetIds(LOOT_ITEM_PICKUP_AUDIO)
	self.coinDropSoundAssetIds = AudioServiceUtils.collectSoundAssetIds(LOOT_COIN_DROP_AUDIO)
	self.coinPickupSoundAssetIds = AudioServiceUtils.collectSoundAssetIds(LOOT_COIN_PICKUP_AUDIO)
end

function LootServiceServer.PlayCoinDropSound(self: LootServiceServer, runtime: LootRuntime)
	local soundService = self.soundService
	if soundService == nil or (soundService :: any).networker == nil then
		return
	end

	if #self.coinDropSoundAssetIds <= 0 then
		self:refreshPickupSoundTemplates()
	end

	local soundAssetId = pickRandomSoundAssetId(self.random, self.coinDropSoundAssetIds)
	if soundAssetId == nil then
		return
	end
	if runtime.rootPart.Parent == nil then
		return
	end

	soundService:playSfxForAll(soundAssetId, {
		category = "SFX",
		parent = runtime.rootPart,
		autoDestroy = true,
	})
end

function LootServiceServer.PlayPickupSound(self: LootServiceServer, runtime: LootRuntime, player: Player)
	local soundService = self.soundService
	if soundService == nil or (soundService :: any).networker == nil then
		return
	end

	if #self.itemPickupSoundAssetIds <= 0 and #self.coinPickupSoundAssetIds <= 0 then
		self:refreshPickupSoundTemplates()
	end

	local soundAssetId: string?
	if self:resolveCoinTypeFromItemId(runtime.itemId) ~= nil then
		soundAssetId = pickRandomSoundAssetId(self.random, self.coinPickupSoundAssetIds)
	else
		soundAssetId = pickRandomSoundAssetId(self.random, self.itemPickupSoundAssetIds)
	end
	if soundAssetId == nil then
		return
	end

	local parent: Instance? = resolvePlayerRootPart(player)
	if parent == nil then
		parent = player.Character
	end

	soundService:playSfxForPlayer(player, soundAssetId, {
		category = "SFX",
		volume = LOOT_PICKUP_VOLUME,
		parent = parent,
		autoDestroy = true,
	})
end

function LootServiceServer.ResolveItemTemplate(self: LootServiceServer, itemIdRaw: any): Instance?
	local itemId = LootServiceUtils.sanitizeString(itemIdRaw, nil)
	if itemId == nil then
		return nil
	end

	local cached = self.itemTemplateByItemId[itemId]
	if cached ~= nil then
		if cached == false then
			return nil
		end
		local cachedInstance = cached :: Instance
		if cachedInstance.Parent ~= nil then
			self:cacheToolTemplateIfPossible(itemId, cachedInstance)
			self:cacheToolTemplateIfPossible(itemId, ResolveItem.resolveToolTemplate(itemId))
			return cachedInstance
		end
		self.itemTemplateByItemId[itemId] = nil
	end

	local resolvedTemplate = ResolveItem.resolvePrimaryTemplate(itemId)
	if resolvedTemplate ~= nil then
		self.itemTemplateByItemId[itemId] = resolvedTemplate
		self:cacheToolTemplateIfPossible(itemId, resolvedTemplate)
		self:cacheToolTemplateIfPossible(itemId, ResolveItem.resolveToolTemplate(itemId))
		return resolvedTemplate
	end

	self.itemTemplateByItemId[itemId] = false
	return nil
end

function LootServiceServer.CloneLootInstanceFromTemplate(
	self: LootServiceServer,
	template: Instance,
	itemId: string
): (Instance?, BasePart?)
	if template:IsA("Tool") then
		local handle = template:FindFirstChild("Handle")
		if handle ~= nil and handle:IsA("BasePart") then
			local handleClone = handle:Clone()
			handleClone.Name = itemId
			return handleClone, handleClone
		end
		return nil, nil
	end

	if template:IsA("Accessory") then
		local handle = template:FindFirstChild("Handle")
		if handle ~= nil and handle:IsA("BasePart") then
			local model = Instance.new("Model")
			model.Name = itemId
			local handleClone = handle:Clone()
			handleClone.Parent = model
			model.PrimaryPart = handleClone
			return model, handleClone
		end
		return nil, nil
	end

	local clone = template:Clone()
	local rootPart = InstanceUtils.resolveInstanceRootPart(clone, true)
	if rootPart == nil then
		clone:Destroy()
		return nil, nil
	end

	return clone, rootPart
end

function LootServiceServer.ResolveFallbackLootColor(self: LootServiceServer, rarityRaw: any): Color3
	if
		rarityRaw == "Common"
		or rarityRaw == "Uncommon"
		or rarityRaw == "Rare"
		or rarityRaw == "Epic"
		or rarityRaw == "Legendary"
	then
		local rarity = rarityRaw :: LootRarity
		return FALLBACK_LOOT_COLOR_BY_RARITY[rarity] or FALLBACK_LOOT_DEFAULT_COLOR
	end
	return FALLBACK_LOOT_DEFAULT_COLOR
end

function LootServiceServer.CreateFallbackLootInstance(
	self: LootServiceServer,
	itemIdRaw: any,
	rarityRaw: any
): (Instance?, BasePart?)
	local itemId = LootServiceUtils.sanitizeString(itemIdRaw, "Loot") or "Loot"
	local rarity = LootServiceUtils.sanitizeRarity(rarityRaw, "Common")
	local token = string.lower(itemId)

	local part = Instance.new("Part")
	part.Name = itemId
	part.Material = Enum.Material.SmoothPlastic
	part.Color = self:resolveFallbackLootColor(rarity)
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Size = Vector3.new(1, 1, 1)
	part:SetAttribute("FallbackLootTemplate", true)
	part:SetAttribute("FallbackItemId", itemId)
	part:SetAttribute("FallbackRarity", rarity)

	if string.find(token, "coin", 1, true) ~= nil then
		part.Shape = Enum.PartType.Cylinder
		part.Size = Vector3.new(0.2, 0.8, 0.8)
	elseif string.find(token, "sword", 1, true) ~= nil then
		part.Size = Vector3.new(0.25, 2.3, 0.25)
	elseif string.find(token, "crystal", 1, true) ~= nil then
		part.Shape = Enum.PartType.Ball
		part.Size = Vector3.new(1.1, 1.1, 1.1)
	else
		part.Size = Vector3.new(1, 1, 1)
	end

	return part, part
end

function LootServiceServer.WarnMissingTemplateOnce(self: LootServiceServer, itemId: string)
	if self.missingTemplateWarnedByItemId[itemId] == true then
		return
	end
	self.missingTemplateWarnedByItemId[itemId] = true
end

function LootServiceServer.ResolveRuntimePlaneX(self: LootServiceServer, runtime: LootRuntime): number?
	if self.settings.lockTo2DPlane ~= true then
		return nil
	end
	return runtime.lockedPlaneX
end

function LootServiceServer.ClampPositionToRuntimePlane(
	self: LootServiceServer,
	runtime: LootRuntime,
	positionRaw: Vector3
): Vector3
	local planeX = self:resolveRuntimePlaneX(runtime)
	if planeX == nil then
		return positionRaw
	end
	return Vector3.new(planeX, positionRaw.Y, positionRaw.Z)
end

function LootServiceServer.ApplyRuntimePlaneConstraint(self: LootServiceServer, runtime: LootRuntime)
	local planeX = self:resolveRuntimePlaneX(runtime)
	if planeX == nil or runtime.disposed then
		return
	end
	if runtime.rootPart.Parent == nil then
		return
	end

	local velocity = runtime.rootPart.AssemblyLinearVelocity
	if math.abs(velocity.X) > EPSILON then
		runtime.rootPart.AssemblyLinearVelocity = Vector3.new(0, velocity.Y, velocity.Z)
	end

	local rootPosition = runtime.rootPart.Position
	if math.abs(rootPosition.X - planeX) > EPSILON then
		local pivot = runtime.instance:GetPivot()
		local rotationOnly = pivot - pivot.Position
		runtime.instance:PivotTo(CFrame.new(planeX, rootPosition.Y, rootPosition.Z) * rotationOnly)
	end

	local updatedRootPosition = runtime.rootPart.Position
	runtime.lastKnownPosition = Vector3.new(planeX, updatedRootPosition.Y, updatedRootPosition.Z)
end

function LootServiceServer.SetRuntimePosition(self: LootServiceServer, runtime: LootRuntime, positionRaw: any)
	local position = LootServiceUtils.sanitizeVector3(positionRaw, runtime.lastKnownPosition)
	position = self:clampPositionToRuntimePlane(runtime, position)
	if runtime.disposed then
		return
	end

	local pivot = runtime.instance:GetPivot()
	local rotationOnly = pivot - pivot.Position
	runtime.instance:PivotTo(CFrame.new(position) * rotationOnly)
	runtime.lastKnownPosition = position
end

function LootServiceServer.RefreshRuntimePosition(self: LootServiceServer, runtime: LootRuntime)
	if runtime.disposed then
		return
	end
	if runtime.rootPart.Parent == nil then
		return
	end
	local position = runtime.rootPart.Position
	runtime.lastKnownPosition = self:clampPositionToRuntimePlane(runtime, position)
end

function LootServiceServer.ApplyRuntimeAttributes(self: LootServiceServer, runtime: LootRuntime, reasonRaw: any?)
	local reason = LootServiceUtils.sanitizeString(reasonRaw, nil)
	runtime.instance:SetAttribute("LootId", runtime.id)
	runtime.instance:SetAttribute("ItemId", runtime.itemId)
	runtime.instance:SetAttribute("Amount", runtime.amount)
	runtime.instance:SetAttribute("MaxStack", runtime.maxStack)
	runtime.instance:SetAttribute("Rarity", runtime.rarity)
	runtime.instance:SetAttribute("SourceType", runtime.sourceType)
	runtime.instance:SetAttribute("LootState", runtime.state)
	runtime.instance:SetAttribute("OwnerUserId", runtime.ownerUserId)
	runtime.instance:SetAttribute("OwnerReleaseAt", runtime.ownerReleaseAt)
	runtime.instance:SetAttribute("ExpiresAt", runtime.expiresAt)
	if reason ~= nil then
		runtime.instance:SetAttribute("LootStateReason", reason)
	end

	runtime.rootPart:SetAttribute("LootId", runtime.id)
	runtime.rootPart:SetAttribute("ItemId", runtime.itemId)
	runtime.rootPart:SetAttribute("LootState", runtime.state)
end

function LootServiceServer.SetRuntimePhysics(
	self: LootServiceServer,
	runtime: LootRuntime,
	anchored: boolean,
	canCollide: boolean,
	canTouch: boolean,
	canQuery: boolean,
	applyBounceProperties: boolean
)
	if runtime.disposed then
		return
	end

	forEachBasePart(runtime.instance, function(part: BasePart)
		part.Anchored = anchored
		part.CanCollide = canCollide
		part.CanTouch = canTouch
		part.CanQuery = canQuery

		if applyBounceProperties then
			local current = part.CustomPhysicalProperties
			local density = if current ~= nil then current.Density else 0.7
			local frictionWeight = if current ~= nil then current.FrictionWeight else 1
			part.CustomPhysicalProperties = PhysicalProperties.new(
				density,
				self.settings.dropFriction,
				self.settings.dropBounciness,
				frictionWeight,
				self.settings.dropElasticityWeight
			)
		end
	end)

	if not anchored then
		pcall(function()
			runtime.rootPart:SetNetworkOwner(nil)
		end)
	end
end

function LootServiceServer.DestroyMagnetRuntime(self: LootServiceServer, runtime: LootRuntime)
	local magnet = runtime.magnet
	if magnet == nil then
		return
	end

	magnet.xMotion:destroy()
	magnet.yMotion:destroy()
	magnet.zMotion:destroy()
	runtime.magnet = nil
end

function LootServiceServer.TransitionState(
	self: LootServiceServer,
	runtime: LootRuntime,
	nextStateRaw: any,
	reasonRaw: any?
): boolean
	local currentState = runtime.state
	local nextState = LootServiceUtils.sanitizeState(nextStateRaw, currentState)
	if currentState == nextState then
		return true
	end

	if not LootServiceUtils.isAllowedStateTransition(currentState, nextState) then
		return false
	end

	runtime.state = nextState
	runtime.stateEnteredAt = os.clock()
	runtime.stableSince = nil

	if nextState ~= LootServiceUtils.STATE_MAGNETIZED then
		self:destroyMagnetRuntime(runtime)
	end

	if nextState == LootServiceUtils.STATE_DROPPED or nextState == LootServiceUtils.STATE_SETTLING then
		self:setRuntimePhysics(runtime, false, true, true, true, true)
	elseif nextState == LootServiceUtils.STATE_IDLE then
		self:setRuntimePhysics(runtime, true, true, true, true, false)
		runtime.rootPart.AssemblyLinearVelocity = Vector3.zero
		runtime.rootPart.AssemblyAngularVelocity = Vector3.zero
	elseif nextState == LootServiceUtils.STATE_MAGNETIZED then
		self:setRuntimePhysics(runtime, true, false, false, false, false)
	elseif nextState == LootServiceUtils.STATE_COLLECTED then
		self:setRuntimePhysics(runtime, true, false, false, false, false)
	end

	self:applyRuntimeAttributes(runtime, reasonRaw)
	return true
end

function LootServiceServer.DisposeRuntime(self: LootServiceServer, runtime: LootRuntime, reasonRaw: any?)
	if runtime.disposed then
		return
	end

	runtime.disposed = true
	self.lootById[runtime.id] = nil
	self.cache:discardDroppedTools(runtime.id)
	self:destroyMagnetRuntime(runtime)
	if runtime.destroyConnection ~= nil then
		runtime.destroyConnection:Disconnect()
		runtime.destroyConnection = nil
	end
	self:applyRuntimeAttributes(runtime, reasonRaw)
	if runtime.instance.Parent ~= nil then
		runtime.instance:Destroy()
	end
end

function LootServiceServer.RemoveRuntimeById(self: LootServiceServer, lootIdRaw: any, reasonRaw: any?)
	local lootId = LootServiceUtils.sanitizeString(lootIdRaw, nil)
	if lootId == nil then
		return
	end
	local runtime = self.lootById[lootId]
	if runtime == nil then
		return
	end

	self:transitionState(runtime, LootServiceUtils.STATE_COLLECTED, reasonRaw)
	self:disposeRuntime(runtime, reasonRaw)
end

function LootServiceServer.ApplyDropImpulse(self: LootServiceServer, runtime: LootRuntime, throwDirectionRaw: any)
	local isPlaneLocked = self:resolveRuntimePlaneX(runtime) ~= nil
	local randomHorizontal =
		Vector3.new(if isPlaneLocked then 0 else self.random:NextNumber(-1, 1), 0, self.random:NextNumber(-1, 1))
	if randomHorizontal.Magnitude <= EPSILON then
		randomHorizontal = if isPlaneLocked then Vector3.new(0, 0, 1) else Vector3.new(1, 0, 0)
	end

	local throwDirection = toUnitVectorOrFallback(throwDirectionRaw, randomHorizontal)
	if isPlaneLocked then
		throwDirection = Vector3.new(0, throwDirection.Y, throwDirection.Z)
		if throwDirection.Magnitude <= EPSILON then
			throwDirection = Vector3.new(0, 0, -1)
		end
		throwDirection = throwDirection.Unit
	end
	local lateralDirection = randomHorizontal.Unit
	local upwardVelocity = self.settings.dropImpulseUp + self.random:NextNumber(0, self.settings.dropImpulseRandomUp)
	local linearVelocity = throwDirection * self.settings.dropImpulseForward
		+ lateralDirection * self.settings.dropImpulseRandomHorizontal
		+ Vector3.new(0, upwardVelocity, 0)
	if isPlaneLocked then
		linearVelocity = Vector3.new(0, linearVelocity.Y, linearVelocity.Z)
	end

	local itemToken = StringUtils.compactToken(runtime.itemId)
	local linearScale = 1
	local angularScale = 1
	local maxLinearSpeed: number? = nil

	if itemToken == KATANA_DROP_TOKEN then
		linearScale = 0.28
		angularScale = 0.05
		maxLinearSpeed = 10
	elseif runtime.sourceType == "PlayerDrop" and runtime.maxStack <= 1 then
		linearScale = 0.5
		angularScale = 0.2
		maxLinearSpeed = 16
	end

	linearVelocity *= linearScale
	if maxLinearSpeed ~= nil then
		local speed = linearVelocity.Magnitude
		if speed > maxLinearSpeed and speed > EPSILON then
			linearVelocity = linearVelocity.Unit * maxLinearSpeed
		end
	end
	if isPlaneLocked then
		linearVelocity = Vector3.new(0, linearVelocity.Y, linearVelocity.Z)
	end

	local angularVelocity = Vector3.new(
		self.random:NextNumber(-1, 1),
		self.random:NextNumber(-1, 1),
		self.random:NextNumber(-1, 1)
	) * self.settings.dropAngularVelocity * angularScale

	runtime.rootPart.AssemblyLinearVelocity = linearVelocity
	runtime.rootPart.AssemblyAngularVelocity = angularVelocity
end

function LootServiceServer.ToPublicSnapshot(self: LootServiceServer, runtime: LootRuntime): { [string]: any }
	return {
		id = runtime.id,
		itemId = runtime.itemId,
		amount = runtime.amount,
		maxStack = runtime.maxStack,
		rarity = runtime.rarity,
		sourceType = runtime.sourceType,
		state = runtime.state,
		position = runtime.lastKnownPosition,
	}
end

function LootServiceServer.SpawnLootRuntime(
	self: LootServiceServer,
	itemIdRaw: any,
	amountRaw: any,
	positionRaw: any,
	optionsRaw: any
): LootRuntime?
	local itemId = LootServiceUtils.sanitizeString(itemIdRaw, nil)
	if itemId == nil then
		return nil
	end

	local itemConfig = LootServiceUtils.resolveItemConfig(self.data, itemId)
	local options = if typeof(optionsRaw) == "table" then optionsRaw else {}
	local amount = LootServiceUtils.sanitizeInteger(amountRaw, 1, 1, 999999)
	local maxStack = LootServiceUtils.sanitizeInteger((options :: any).maxStack, itemConfig.maxStack, 1, 999999)
	local rarity = LootServiceUtils.sanitizeRarity((options :: any).rarity, itemConfig.rarity)
	local sourceType = LootServiceUtils.sanitizeString((options :: any).sourceType, "Generic") or "Generic"
	local metadata = if typeof((options :: any).metadata) == "table"
		then LootServiceUtils.cloneDeep((options :: any).metadata)
		else nil
	local ownerUserId = sanitizeOwnerUserId((options :: any).ownerUserId)
	local ownerLockSeconds =
		LootServiceUtils.sanitizeNumber((options :: any).ownerLockSeconds, self.settings.ownerLockSeconds, 0, 120)
	local now = os.clock()
	local expiresAt = now
		+ LootServiceUtils.sanitizeNumber((options :: any).despawnSeconds, self.settings.despawnSeconds, 0.1, 3600)
	local requestedLootId = LootServiceUtils.sanitizeString((options :: any).lootId, nil)
	local lootId = requestedLootId or LootServiceUtils.createLootId(self.random, itemId)

	local template = self:resolveItemTemplate(itemId)
	local instance: Instance? = nil
	local rootPart: BasePart? = nil

	if template ~= nil then
		instance, rootPart = self:cloneLootInstanceFromTemplate(template, itemId)
	end
	if instance == nil or rootPart == nil then
		if template == nil then
			self:warnMissingTemplateOnce(itemId)
		else
		end
		instance, rootPart = self:createFallbackLootInstance(itemId, rarity)
	end

	if instance == nil or rootPart == nil then
		return nil
	end

	if self.lootById[lootId] ~= nil then
		self:removeRuntimeById(lootId, "Replaced")
	end

	instance.Name = ("Loot_%s"):format(itemId)
	instance.Parent = self.lootFolder

	local spawnPosition = LootServiceUtils.sanitizeVector3(positionRaw, Vector3.zero)
	local lockedPlaneX = if self.settings.lockTo2DPlane then spawnPosition.X else nil
	if lockedPlaneX ~= nil then
		spawnPosition = Vector3.new(lockedPlaneX, spawnPosition.Y, spawnPosition.Z)
	end
	local runtime: LootRuntime = {
		id = lootId,
		itemId = itemId,
		amount = amount,
		maxStack = maxStack,
		metadata = metadata,
		rarity = rarity,
		sourceType = sourceType,
		state = LootServiceUtils.STATE_DROPPED,
		ownerUserId = ownerUserId,
		ownerReleaseAt = if ownerUserId ~= nil then now + ownerLockSeconds else 0,
		spawnedAt = now,
		expiresAt = expiresAt,
		stateEnteredAt = now,
		instance = instance,
		rootPart = rootPart,
		lastKnownPosition = spawnPosition,
		lockedPlaneX = lockedPlaneX,
		stableSince = nil,
		forceIdleUntil = -math.huge,
		magnet = nil,
		disposed = false,
		destroyConnection = nil,
	}

	self.lootById[lootId] = runtime
	self:setRuntimePosition(runtime, spawnPosition)
	self:setRuntimePhysics(runtime, false, true, true, true, true)
	self:applyDropImpulse(runtime, (options :: any).throwDirection)
	self:applyRuntimeAttributes(runtime, "Spawned")
	if self:resolveCoinTypeFromItemId(itemId) ~= nil then
		self:playCoinDropSound(runtime)
	end

	runtime.destroyConnection = runtime.instance.Destroying:Connect(function()
		local liveRuntime = self.lootById[lootId]
		if liveRuntime == nil or liveRuntime.disposed then
			return
		end
		liveRuntime.disposed = true
		self.lootById[lootId] = nil
		self:destroyMagnetRuntime(liveRuntime)
	end)

	return runtime
end

function LootServiceServer.GetDropOriginForPlayer(
	self: LootServiceServer,
	player: Player,
	throwDirectionRaw: any
): Vector3
	local rootPart = resolvePlayerRootPart(player)
	if rootPart == nil then
		return Vector3.zero
	end

	local throwDirection = toUnitVectorOrFallback(throwDirectionRaw, rootPart.CFrame.LookVector)
	local origin = rootPart.Position
		+ throwDirection * self.settings.playerDropForwardOffset
		+ Vector3.new(0, self.settings.playerDropUpOffset, 0)
	if self.settings.lockTo2DPlane then
		return Vector3.new(rootPart.Position.X, origin.Y, origin.Z)
	end
	return origin
end

function LootServiceServer.SpawnDropsFromTable(
	self: LootServiceServer,
	dropTableIdRaw: any,
	originRaw: any,
	optionsRaw: any
): { [string]: any }
	local options = if typeof(optionsRaw) == "table" then optionsRaw else {}
	local onlyCoinLoot = (options :: any).onlyCoinLoot == true
	local origin = LootServiceUtils.sanitizeVector3(originRaw, Vector3.zero)
	local context = if typeof((options :: any).context) == "table" then shallowCopy((options :: any).context) else {}
	local mutableContext = context :: any
	local sourceType = LootServiceUtils.sanitizeString((options :: any).sourceType, nil)
	if sourceType ~= nil then
		mutableContext.sourceType = sourceType
	end

	local drops: { LootRollResult } =
		LootServiceUtils.rollDropTable(self.data, dropTableIdRaw, self.random, context :: LootRollContext)
	local ownerUserId = sanitizeOwnerUserId((options :: any).ownerUserId)
	local ownerLockSeconds =
		LootServiceUtils.sanitizeNumber((options :: any).ownerLockSeconds, self.settings.ownerLockSeconds, 0, 120)

	local output = {}
	for _, drop in drops do
		if onlyCoinLoot and self:resolveCoinTypeFromItemId(drop.itemId) == nil then
			continue
		end

		local radius = self.random:NextNumber(self.settings.scatterRadiusMin, self.settings.scatterRadiusMax)
		local horizontalOffset: Vector3
		if self.settings.lockTo2DPlane then
			horizontalOffset = Vector3.new(0, 0, self.random:NextNumber(-radius, radius))
		else
			local angle = self.random:NextNumber(0, math.pi * 2)
			horizontalOffset = Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
		end
		local spawnPosition = origin + horizontalOffset + Vector3.new(0, self.settings.spawnHeightOffset, 0)
		local throwDirection = if horizontalOffset.Magnitude > EPSILON then horizontalOffset.Unit else nil

		local runtime = self:spawnLootRuntime(drop.itemId, drop.amount, spawnPosition, {
			maxStack = drop.maxStack,
			metadata = drop.metadata,
			rarity = drop.rarity,
			sourceType = drop.sourceType,
			ownerUserId = ownerUserId,
			ownerLockSeconds = ownerLockSeconds,
			throwDirection = throwDirection,
		})
		if runtime ~= nil then
			table.insert(output, self:toPublicSnapshot(runtime))
		end
	end

	return output
end

function LootServiceServer.SpawnDropsFromSource(
	self: LootServiceServer,
	sourceRaw: any,
	originRaw: any,
	optionsRaw: any
): { [string]: any }
	local dropTableId = LootServiceUtils.resolveDropTableId(self.data, sourceRaw, "Slime")
	if dropTableId == nil then
		return {}
	end

	local options = if typeof(optionsRaw) == "table" then shallowCopy(optionsRaw) else {}
	local mutableOptions = options :: any
	local sourceType = LootServiceUtils.sanitizeString(mutableOptions.sourceType, nil)
	if sourceType == nil then
		if typeof(sourceRaw) == "string" then
			sourceType = sourceRaw
		elseif typeof(sourceRaw) == "table" then
			local source = sourceRaw :: { [string]: any }
			sourceType = LootServiceUtils.sanitizeString(source.sourceType, nil)
				or LootServiceUtils.sanitizeString(source.npcType, nil)
				or LootServiceUtils.sanitizeString(source.displayName, nil)
		end
	end
	mutableOptions.sourceType = sourceType or dropTableId
	mutableOptions.onlyCoinLoot = true

	return self:spawnDropsFromTable(dropTableId, originRaw, options)
end

function LootServiceServer.CanPlayerPickupRuntime(
	self: LootServiceServer,
	runtime: LootRuntime,
	playerContext: PlayerContext,
	now: number
): (boolean, string)
	if runtime.amount <= 0 then
		return false, "NoAmount"
	end
	if
		runtime.ownerUserId ~= nil
		and runtime.ownerUserId ~= playerContext.player.UserId
		and now < runtime.ownerReleaseAt
	then
		return false, "OwnerLocked"
	end
	local delta = playerContext.position - runtime.lastKnownPosition
	if delta.Magnitude > self.settings.pickupScanRadius then
		return false, "TooFar"
	end
	return true, "Ok"
end

function LootServiceServer.CollectPlayerContexts(
	self: LootServiceServer
): ({ PlayerContext }, { [Player]: PlayerContext })
	local contexts = {}
	local contextsByPlayer = {}
	for _, player in Players:GetPlayers() do
		local rootPart = resolvePlayerRootPart(player)
		if rootPart == nil then
			continue
		end

		local context: PlayerContext = {
			player = player,
			rootPart = rootPart,
			position = rootPart.Position,
		}
		table.insert(contexts, context)
		contextsByPlayer[player] = context
	end
	return contexts, contextsByPlayer
end

function LootServiceServer.FindNearestEligiblePlayerContext(
	self: LootServiceServer,
	runtime: LootRuntime,
	playerContexts: { PlayerContext },
	now: number
): PlayerContext?
	local nearest: PlayerContext? = nil
	local nearestDistance = math.huge
	for _, context in playerContexts do
		local canPickup = self:canPlayerPickupRuntime(runtime, context, now)
		if not canPickup then
			continue
		end

		local distance = (context.position - runtime.lastKnownPosition).Magnitude
		if distance < nearestDistance then
			nearestDistance = distance
			nearest = context
		end
	end
	return nearest
end

function LootServiceServer.BeginMagnetization(
	self: LootServiceServer,
	runtime: LootRuntime,
	playerContext: PlayerContext,
	now: number
): boolean
	if runtime.disposed then
		return false
	end

	local targetPosition = playerContext.position + Vector3.new(0, self.settings.collectOffsetY, 0)
	local currentPosition = runtime.lastKnownPosition
	local startDistance = (targetPosition - currentPosition).Magnitude
	local magnet: MagnetRuntime = {
		player = playerContext.player,
		startedAt = now,
		elapsed = 0,
		startDistance = math.max(startDistance, EPSILON),
		speed = self.settings.magnetBaseSpeed,
		xMotion = Ripple.createMotion(currentPosition.X),
		yMotion = Ripple.createMotion(currentPosition.Y),
		zMotion = Ripple.createMotion(currentPosition.Z),
	}
	runtime.magnet = magnet

	if not self:transitionState(runtime, LootServiceUtils.STATE_MAGNETIZED, "PickupEligible") then
		self:destroyMagnetRuntime(runtime)
		return false
	end
	return true
end

function LootServiceServer.CanInventoryAcceptRuntime(
	self: LootServiceServer,
	player: Player,
	runtime: LootRuntime
): boolean
	local inventoryState = self.inventoryService:getState(player)
	if not InventoryServiceUtils.isLoadedState(inventoryState.loadState) then
		return false
	end

	local remaining = runtime.amount
	for _, slot in inventoryState.slots do
		local stack = slot.stack
		if stack == nil then
			continue
		end
		if stack.itemId ~= runtime.itemId then
			continue
		end
		if not LootServiceUtils.deepEqual(stack.metadata, runtime.metadata) then
			continue
		end

		local room = math.max(0, stack.maxStack - stack.amount)
		remaining -= room
		if remaining <= 0 then
			return true
		end
	end

	local emptySlotCount = 0
	for _, slot in inventoryState.slots do
		if slot.stack == nil then
			emptySlotCount += 1
		end
	end

	local perSlotMax = math.max(1, runtime.maxStack)
	remaining -= emptySlotCount * perSlotMax
	return remaining <= 0
end

function LootServiceServer.TryCollectRuntime(
	self: LootServiceServer,
	runtime: LootRuntime,
	player: Player,
	now: number
): boolean
	if runtime.disposed or runtime.state ~= LootServiceUtils.STATE_MAGNETIZED then
		return false
	end

	if self:shouldRouteRuntimeToCoinWallet(runtime) then
		local didCollectToWallet = self:tryCollectRuntimeToCoinWallet(runtime, player)
		if didCollectToWallet then
			return true
		end
		runtime.forceIdleUntil = now + self.settings.magnetCooldownAfterFailedCollect
		return self:transitionState(runtime, LootServiceUtils.STATE_IDLE, "CoinWalletUnavailable")
	end

	if not self:canInventoryAcceptRuntime(player, runtime) then
		runtime.forceIdleUntil = now + self.settings.magnetCooldownAfterFailedCollect
		return self:transitionState(runtime, LootServiceUtils.STATE_IDLE, "InventoryFull")
	end

	local addResult = self.inventoryService:addItem(player, runtime.itemId, runtime.amount, {
		maxStack = runtime.maxStack,
		metadata = LootServiceUtils.cloneDeep(runtime.metadata),
		stackIdPrefix = "loot",
	})
	local addedAmount = math.clamp(addResult.added, 0, runtime.amount)
	if addedAmount > 0 then
		self:restoreCachedDropTools(player, runtime, addedAmount)
		self:playPickupSound(runtime, player)
	end
	if addedAmount ~= runtime.amount then
		if addedAmount > 0 then
			runtime.amount -= addedAmount
		end
		if runtime.amount <= 0 then
			self:transitionState(runtime, LootServiceUtils.STATE_COLLECTED, "Collected")
			self:disposeRuntime(runtime, "Collected")
			return true
		end
		runtime.forceIdleUntil = now + self.settings.magnetCooldownAfterFailedCollect
		return self:transitionState(runtime, LootServiceUtils.STATE_IDLE, "PartialCollect")
	end

	self:transitionState(runtime, LootServiceUtils.STATE_COLLECTED, "Collected")
	self:disposeRuntime(runtime, "Collected")
	return true
end

function LootServiceServer.UpdateDroppedRuntime(self: LootServiceServer, runtime: LootRuntime, now: number)
	if now - runtime.stateEnteredAt >= self.settings.droppedStateDuration then
		self:transitionState(runtime, LootServiceUtils.STATE_SETTLING, "DroppedImpulseComplete")
	end
end

function LootServiceServer.UpdateSettlingRuntime(self: LootServiceServer, runtime: LootRuntime, now: number)
	self:refreshRuntimePosition(runtime)
	if now - runtime.stateEnteredAt < self.settings.settleMinDuration then
		return
	end

	local linearSpeed = runtime.rootPart.AssemblyLinearVelocity.Magnitude
	local angularSpeed = runtime.rootPart.AssemblyAngularVelocity.Magnitude
	if
		linearSpeed <= self.settings.settleLinearSpeedThreshold
		and angularSpeed <= self.settings.settleAngularSpeedThreshold
	then
		if runtime.stableSince == nil then
			runtime.stableSince = now
		end
	else
		runtime.stableSince = nil
	end

	local isStableLongEnough = runtime.stableSince ~= nil
		and (now - runtime.stableSince) >= self.settings.settleStableDuration
	local exceededMaxDuration = (now - runtime.stateEnteredAt) >= self.settings.settleMaxDuration
	if isStableLongEnough or exceededMaxDuration then
		self:transitionState(runtime, LootServiceUtils.STATE_IDLE, "Settled")
		self:refreshRuntimePosition(runtime)
	end
end

function LootServiceServer.UpdateIdleRuntime(
	self: LootServiceServer,
	runtime: LootRuntime,
	playerContexts: { PlayerContext },
	now: number
)
	self:refreshRuntimePosition(runtime)
	if now < runtime.forceIdleUntil then
		return
	end

	local nearest = self:findNearestEligiblePlayerContext(runtime, playerContexts, now)
	if nearest ~= nil then
		self:beginMagnetization(runtime, nearest, now)
	end
end

function LootServiceServer.UpdateMagnetizedRuntime(
	self: LootServiceServer,
	runtime: LootRuntime,
	dt: number,
	contextsByPlayer: { [Player]: PlayerContext },
	now: number
)
	local magnet = runtime.magnet
	if magnet == nil then
		self:transitionState(runtime, LootServiceUtils.STATE_IDLE, "MissingMagnetRuntime")
		return
	end

	local targetContext = contextsByPlayer[magnet.player]
	if targetContext == nil then
		runtime.forceIdleUntil = now + self.settings.magnetCooldownAfterFailedCollect
		self:transitionState(runtime, LootServiceUtils.STATE_IDLE, "TargetMissing")
		return
	end

	local canPickup = self:canPlayerPickupRuntime(runtime, targetContext, now)
	if not canPickup then
		runtime.forceIdleUntil = now + self.settings.magnetCooldownAfterFailedCollect
		self:transitionState(runtime, LootServiceUtils.STATE_IDLE, "TargetInvalid")
		return
	end

	magnet.elapsed += dt
	local currentPosition = runtime.lastKnownPosition
	local targetPosition = targetContext.position + Vector3.new(0, self.settings.collectOffsetY, 0)
	local toTarget = targetPosition - currentPosition
	local distance = toTarget.Magnitude
	local radiusSpan = math.max(self.settings.pickupScanRadius, EPSILON)
	local distanceRatio = math.clamp(distance / radiusSpan, 0, 1)
	local nearFactor = 1 - distanceRatio
	local distanceStrength = math.max(0.2, nearFactor)
	local accelerationStrength = 0.35 + distanceStrength * 0.65
	magnet.speed = math.min(
		self.settings.magnetMaxSpeed,
		magnet.speed + self.settings.magnetAcceleration * accelerationStrength * dt
	)
	local progress = 1 - math.clamp(distance / magnet.startDistance, 0, 1)
	local closeSpeedBoost = 1 + nearFactor * 1.6

	local springFrequency = self.settings.magnetSpringFrequency
		+ magnet.elapsed * self.settings.magnetSpringFrequencyRamp
		+ progress * self.settings.magnetSpringFrequencyCloseBoost * closeSpeedBoost
	local spring: SpringOptions = {
		frequency = springFrequency,
		damping = self.settings.magnetSpringDamping + (1 - distanceStrength) * 0.2,
	}

	magnet.xMotion:spring(targetPosition.X, spring)
	magnet.yMotion:spring(targetPosition.Y, spring)
	magnet.zMotion:spring(targetPosition.Z, spring)
	local springPosition = Vector3.new(magnet.xMotion:step(dt), magnet.yMotion:step(dt), magnet.zMotion:step(dt))

	local speedPosition =
		Vec.moveTowards(currentPosition, targetPosition, magnet.speed * closeSpeedBoost * distanceStrength * dt)

	local nextPosition = springPosition:Lerp(speedPosition, self.settings.magnetSpeedBlend)
	self:setRuntimePosition(runtime, nextPosition)

	local nextDistance = (targetPosition - nextPosition).Magnitude
	if nextDistance <= self.settings.collectDistance then
		self:tryCollectRuntime(runtime, targetContext.player, now)
	end
end

function LootServiceServer.UpdateRuntime(
	self: LootServiceServer,
	runtime: LootRuntime,
	dt: number,
	playerContexts: { PlayerContext },
	contextsByPlayer: { [Player]: PlayerContext },
	now: number
)
	if runtime.disposed then
		return
	end
	if runtime.expiresAt <= now then
		self:transitionState(runtime, LootServiceUtils.STATE_COLLECTED, "Expired")
		self:disposeRuntime(runtime, "Expired")
		return
	end
	self:applyRuntimePlaneConstraint(runtime)

	if runtime.state == LootServiceUtils.STATE_DROPPED then
		self:updateDroppedRuntime(runtime, now)
		return
	end
	if runtime.state == LootServiceUtils.STATE_SETTLING then
		self:updateSettlingRuntime(runtime, now)
		return
	end
	if runtime.state == LootServiceUtils.STATE_IDLE then
		self:updateIdleRuntime(runtime, playerContexts, now)
		return
	end
	if runtime.state == LootServiceUtils.STATE_MAGNETIZED then
		self:updateMagnetizedRuntime(runtime, dt, contextsByPlayer, now)
		return
	end
end

function LootServiceServer.StepSimulation(self: LootServiceServer, dt: number)
	local now = os.clock()
	local playerContexts, contextsByPlayer = self:collectPlayerContexts()
	local runtimeIds = {}
	for runtimeId in self.lootById do
		table.insert(runtimeIds, runtimeId)
	end

	for _, runtimeId in runtimeIds do
		local runtime = self.lootById[runtimeId]
		if runtime ~= nil then
			self:updateRuntime(runtime, dt, playerContexts, contextsByPlayer, now)
		end
	end
end

function LootServiceServer.OnHeartbeat(self: LootServiceServer, dtRaw: any)
	local dt = LootServiceUtils.sanitizeNumber(dtRaw, 0, 0, 1)
	if dt <= 0 then
		return
	end

	self.simulationAccumulator += dt
	local step = self.settings.fixedStep
	local maxSteps = self.settings.maxSimulationStepsPerHeartbeat
	local steps = 0
	while self.simulationAccumulator >= step and steps < maxSteps do
		self.simulationAccumulator -= step
		steps += 1
		self:stepSimulation(step)
	end
	if steps >= maxSteps and self.simulationAccumulator >= step then
		self.simulationAccumulator = 0
	end
end

function LootServiceServer.DropFromInventorySlot(
	self: LootServiceServer,
	player: Player,
	slotIndexRaw: any,
	amountRaw: any,
	throwDirectionRaw: any
): boolean
	if not self:canAcceptDropRequest(player) then
		return false
	end

	local inventoryState = self.inventoryService:getState(player)
	if not InventoryServiceUtils.isLoadedState(inventoryState.loadState) then
		return false
	end

	local stack = InventoryServiceUtils.getStack(inventoryState, slotIndexRaw)
	if stack == nil then
		return false
	end

	local dropAmount = LootServiceUtils.resolveDropAmount(amountRaw, stack.amount)
	dropAmount = math.clamp(dropAmount, 1, stack.amount)

	local stackSnapshot: InventoryItemStack = {
		stackId = stack.stackId,
		itemId = stack.itemId,
		amount = stack.amount,
		maxStack = stack.maxStack,
		metadata = LootServiceUtils.cloneDeep(stack.metadata),
	}
	local cachedToolClones = self:captureDropToolClones(player, stackSnapshot.itemId, dropAmount)

	local removeResult = self.inventoryService:removeFromSlot(player, slotIndexRaw, dropAmount)
	if removeResult.removedAmount <= 0 then
		for _, toolClone in cachedToolClones do
			toolClone:Destroy()
		end
		return false
	end

	local dropOrigin = self:getDropOriginForPlayer(player, throwDirectionRaw)
	local runtime = self:spawnLootRuntime(stackSnapshot.itemId, removeResult.removedAmount, dropOrigin, {
		maxStack = stackSnapshot.maxStack,
		metadata = stackSnapshot.metadata,
		sourceType = "PlayerDrop",
		ownerUserId = player.UserId,
		ownerLockSeconds = self.settings.playerDropOwnerLockSeconds,
		throwDirection = throwDirectionRaw,
	})
	if runtime ~= nil then
		self.cache:cacheDroppedTools(runtime.id, stackSnapshot.itemId, player.UserId, cachedToolClones)
		return true
	end

	self.inventoryService:addItem(player, stackSnapshot.itemId, removeResult.removedAmount, {
		maxStack = stackSnapshot.maxStack,
		metadata = stackSnapshot.metadata,
		stackIdPrefix = "rollback",
	})
	local targetContainer: Instance? = player:FindFirstChildOfClass("Backpack")
	if targetContainer == nil then
		targetContainer = player.Character
	end
	for _, toolClone in cachedToolClones do
		self.inventoryService:releaseSuppressedToolImport(player, stackSnapshot.itemId, 1)
		if targetContainer ~= nil then
			toolClone.Parent = targetContainer
		else
			toolClone:Destroy()
		end
	end
	return false
end

function LootServiceServer.CanAcceptDropRequest(self: LootServiceServer, player: Player): boolean
	local now = os.clock()
	local lastAt = self.lastDropRequestAtByPlayer[player] or -math.huge
	if now - lastAt < DROP_REQUEST_THROTTLE_SECONDS then
		return false
	end
	self.lastDropRequestAtByPlayer[player] = now
	return true
end

function LootServiceServer.RequestSync(self: LootServiceServer, _player: Player) end

function LootServiceServer.RequestDropFromSlot(
	self: LootServiceServer,
	player: Player,
	slotIndexRaw: any,
	amountRaw: any,
	throwDirectionRaw: any
)
	self:dropFromInventorySlot(player, slotIndexRaw, amountRaw, throwDirectionRaw)
end

function LootServiceServer.RequestDropSelectedSlot(
	self: LootServiceServer,
	player: Player,
	amountRaw: any,
	throwDirectionRaw: any
)
	local inventoryState = self.inventoryService:getState(player)
	if not InventoryServiceUtils.isLoadedState(inventoryState.loadState) then
		return
	end
	local selectedSlot = inventoryState.selectedSlot
	if selectedSlot == nil then
		return
	end
	self:dropFromInventorySlot(player, selectedSlot, amountRaw, throwDirectionRaw)
end

function LootServiceServer.Init(self: LootServiceServer)
	self.networker = Networker.server.new("LootService", self, {
		self.RequestSync,
		self.RequestDropFromSlot,
		self.RequestDropSelectedSlot,
	})
	self.inventoryService = InventoryServiceServer :: InventoryServiceServerObject
	self.playerDataService = PlayerDataServiceServer :: PlayerDataServiceServerObject
	self.soundService = AudioServiceServer :: AudioServiceServerObject
	self.data = LootServiceData
	self.settings = LootServiceUtils.resolveSettings(self.data)
	self.random = Random.new()
	self.cache = LootServiceCache.new()
	self.lootById = {}
	self.itemTemplateByItemId = {}
	self.itemPickupSoundAssetIds = {} :: { string }
	self.coinDropSoundAssetIds = {} :: { string }
	self.coinPickupSoundAssetIds = {} :: { string }
	self:refreshPickupSoundTemplates()
	self.missingTemplateWarnedByItemId = {}
	self.lastDropRequestAtByPlayer = {}
	self.simulationAccumulator = 0
	self.lootFolder = self:ensureLootFolder()
	self.binders = NevermoreSupport.getService(ServerBinderSupport)

	self.inventoryService:setDropFromSlotHandler(
		function(player: Player, slotIndexRaw: any, amountRaw: any, throwDirectionRaw: any)
			return self:dropFromInventorySlot(player, slotIndexRaw, amountRaw, throwDirectionRaw)
		end
	)

	self.playerRemovingConnection = Players.PlayerRemoving:Connect(function(player: Player)
		self.lastDropRequestAtByPlayer[player] = nil
	end)
	self.heartbeatConnection = RunService.Heartbeat:Connect(function(dt: number)
		self:onHeartbeat(dt)
	end)
end

function LootServiceServer.Destroy(self: LootServiceServer)
	if self.playerRemovingConnection ~= nil then
		self.playerRemovingConnection:Disconnect()
		self.playerRemovingConnection = nil
	end
	if self.heartbeatConnection ~= nil then
		self.heartbeatConnection:Disconnect()
		self.heartbeatConnection = nil
	end

	self.inventoryService:setDropFromSlotHandler(nil)

	local runtimeIds = {}
	for runtimeId in self.lootById do
		table.insert(runtimeIds, runtimeId)
	end
	for _, runtimeId in runtimeIds do
		self:removeRuntimeById(runtimeId, "Cleanup")
	end
	if self.cache ~= nil then
		self.cache:destroy()
	end

	if self.networker ~= nil then
		self.networker:destroy()
	end
	self.soundService = nil
end

LootServiceServer.cacheToolTemplateIfPossible = LootServiceServer.CacheToolTemplateIfPossible
LootServiceServer.isToolMatchingItemId = LootServiceServer.IsToolMatchingItemId
LootServiceServer.captureDropToolClones = LootServiceServer.CaptureDropToolClones
LootServiceServer.restoreCachedDropTools = LootServiceServer.RestoreCachedDropTools
LootServiceServer.resolveCoinTypeFromItemId = LootServiceServer.ResolveCoinTypeFromItemId
LootServiceServer.shouldRouteRuntimeToCoinWallet = LootServiceServer.ShouldRouteRuntimeToCoinWallet
LootServiceServer.tryCollectRuntimeToCoinWallet = LootServiceServer.TryCollectRuntimeToCoinWallet
LootServiceServer.ensureLootFolder = LootServiceServer.EnsureLootFolder
LootServiceServer.refreshPickupSoundTemplates = LootServiceServer.RefreshPickupSoundTemplates
LootServiceServer.playCoinDropSound = LootServiceServer.PlayCoinDropSound
LootServiceServer.playPickupSound = LootServiceServer.PlayPickupSound
LootServiceServer.resolveItemTemplate = LootServiceServer.ResolveItemTemplate
LootServiceServer.cloneLootInstanceFromTemplate = LootServiceServer.CloneLootInstanceFromTemplate
LootServiceServer.resolveFallbackLootColor = LootServiceServer.ResolveFallbackLootColor
LootServiceServer.createFallbackLootInstance = LootServiceServer.CreateFallbackLootInstance
LootServiceServer.warnMissingTemplateOnce = LootServiceServer.WarnMissingTemplateOnce
LootServiceServer.resolveRuntimePlaneX = LootServiceServer.ResolveRuntimePlaneX
LootServiceServer.clampPositionToRuntimePlane = LootServiceServer.ClampPositionToRuntimePlane
LootServiceServer.applyRuntimePlaneConstraint = LootServiceServer.ApplyRuntimePlaneConstraint
LootServiceServer.setRuntimePosition = LootServiceServer.SetRuntimePosition
LootServiceServer.refreshRuntimePosition = LootServiceServer.RefreshRuntimePosition
LootServiceServer.applyRuntimeAttributes = LootServiceServer.ApplyRuntimeAttributes
LootServiceServer.setRuntimePhysics = LootServiceServer.SetRuntimePhysics
LootServiceServer.destroyMagnetRuntime = LootServiceServer.DestroyMagnetRuntime
LootServiceServer.transitionState = LootServiceServer.TransitionState
LootServiceServer.disposeRuntime = LootServiceServer.DisposeRuntime
LootServiceServer.removeRuntimeById = LootServiceServer.RemoveRuntimeById
LootServiceServer.applyDropImpulse = LootServiceServer.ApplyDropImpulse
LootServiceServer.toPublicSnapshot = LootServiceServer.ToPublicSnapshot
LootServiceServer.spawnLootRuntime = LootServiceServer.SpawnLootRuntime
LootServiceServer.getDropOriginForPlayer = LootServiceServer.GetDropOriginForPlayer
LootServiceServer.spawnDropsFromTable = LootServiceServer.SpawnDropsFromTable
LootServiceServer.spawnDropsFromSource = LootServiceServer.SpawnDropsFromSource
LootServiceServer.canPlayerPickupRuntime = LootServiceServer.CanPlayerPickupRuntime
LootServiceServer.collectPlayerContexts = LootServiceServer.CollectPlayerContexts
LootServiceServer.findNearestEligiblePlayerContext = LootServiceServer.FindNearestEligiblePlayerContext
LootServiceServer.beginMagnetization = LootServiceServer.BeginMagnetization
LootServiceServer.canInventoryAcceptRuntime = LootServiceServer.CanInventoryAcceptRuntime
LootServiceServer.tryCollectRuntime = LootServiceServer.TryCollectRuntime
LootServiceServer.updateDroppedRuntime = LootServiceServer.UpdateDroppedRuntime
LootServiceServer.updateSettlingRuntime = LootServiceServer.UpdateSettlingRuntime
LootServiceServer.updateIdleRuntime = LootServiceServer.UpdateIdleRuntime
LootServiceServer.updateMagnetizedRuntime = LootServiceServer.UpdateMagnetizedRuntime
LootServiceServer.updateRuntime = LootServiceServer.UpdateRuntime
LootServiceServer.stepSimulation = LootServiceServer.StepSimulation
LootServiceServer.onHeartbeat = LootServiceServer.OnHeartbeat
LootServiceServer.dropFromInventorySlot = LootServiceServer.DropFromInventorySlot
LootServiceServer.canAcceptDropRequest = LootServiceServer.CanAcceptDropRequest
LootServiceServer.requestSync = LootServiceServer.RequestSync
LootServiceServer.requestDropFromSlot = LootServiceServer.RequestDropFromSlot
LootServiceServer.requestDropSelectedSlot = LootServiceServer.RequestDropSelectedSlot
LootServiceServer.init = LootServiceServer.Init
LootServiceServer.destroy = LootServiceServer.Destroy

type LootServiceServer = typeof(LootServiceServer) & {
	networker: Networker.Server,
	inventoryService: InventoryServiceServerObject,
	playerDataService: PlayerDataServiceServerObject,
	soundService: AudioServiceServerObject?,
	data: { [string]: any },
	settings: LootSettings,
	random: Random,
	cache: LootServiceCacheObject,
	lootFolder: Folder,
	lootById: { [string]: LootRuntime },
	itemTemplateByItemId: { [string]: Instance | boolean },
	itemPickupSoundAssetIds: { string },
	coinDropSoundAssetIds: { string },
	coinPickupSoundAssetIds: { string },
	missingTemplateWarnedByItemId: { [string]: boolean },
	lastDropRequestAtByPlayer: { [Player]: number },
	simulationAccumulator: number,
	playerRemovingConnection: RBXScriptConnection?,
	heartbeatConnection: RBXScriptConnection?,
}

return LootServiceServer :: LootServiceServer
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="1055">
              <Properties>
                <string name="Name">MagicServiceServer</string>
                <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerScriptService = game:GetService("ServerScriptService")
local Workspace = game:GetService("Workspace")

local BossServiceServer = require(script:FindFirstAncestor("game").Server.Services.BossServiceServer)
local HpServiceServer = require(script:FindFirstAncestor("game").Server.Services.HpServiceServer)
local InventoryServiceServer = require(script:FindFirstAncestor("game").Server.Services.InventoryServiceServer)
local Janitor = require(ReplicatedStorage.Packages.Janitor)
local Magic = require(script:FindFirstAncestor("game").Shared.Classes.Magic)
local MagicServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.MagicServiceUtils)
local ManaServiceServer = require(script:FindFirstAncestor("game").Server.Services.ManaServiceServer)
local Networker = require(script:FindFirstAncestor("game").Shared.Modules.Networking.Networker)
local NevermoreSupport = require(script:FindFirstAncestor("game").Shared.Modules.Core.NevermoreSupport)
local NpcServiceServer = require(script:FindFirstAncestor("game").Server.Services.NpcServiceServer)
local PlayerServiceServer = require(script:FindFirstAncestor("game").Server.Services.PlayerServiceServer)
local PlayerServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.PlayerServiceUtils)
local ServerBinderSupport = require(script:FindFirstAncestor("game").Server.Binders.ServerBinderSupport)

type WeaponRuntimeConfig = MagicServiceUtils.WeaponRuntimeConfig
type ModifierStats = MagicServiceUtils.ModifierStats
type CastStats = MagicServiceUtils.CastStats
type CastRequest = MagicServiceUtils.CastRequest

type JanitorClass = {
	GiveChore: (self: JanitorClass, chore: any, ...any) -> (),
	Clean: (self: JanitorClass) -> (),
	Destroy: (self: JanitorClass) -> (),
}

type MagicController = {
	bindTool: (self: MagicController, toolRaw: any) -> boolean,
	unbindTool: (self: MagicController) -> (),
	setCharacter: (self: MagicController, characterRaw: any) -> (),
	setOwnerPlayer: (self: MagicController, playerRaw: any) -> (),
	queueCast: (self: MagicController, triggerRaw: any) -> boolean,
	resolveBoundWeaponConfig: (self: MagicController) -> any,
	destroy: (self: MagicController) -> (),
	cooldownUntil: number,
	weaponConfig: any,
}

type InventoryServiceServerObject = {
	getState: (self: InventoryServiceServerObject, player: Player) -> any,
}

type ManaServiceState = {
	mana: number,
	maxMana: number,
	regenPerSecond: number,
}

type ManaServiceServerObject = {
	getState: (self: ManaServiceServerObject, player: Player) -> ManaServiceState,
	canConsumeMana: (self: ManaServiceServerObject, player: Player?, amountRaw: any, contextRaw: any) -> boolean,
	consumeMana: (self: ManaServiceServerObject, player: Player?, amountRaw: any, contextRaw: any) -> boolean,
}

type NpcServiceServerObject = {
	damageNpcFromHitPart: (
		self: NpcServiceServerObject,
		hitPartRaw: any,
		damageRaw: any,
		source: any?
	) -> number,
}

type BossServiceServerObject = {
	damageBossFromHitPart: (
		self: BossServiceServerObject,
		hitPartRaw: any,
		damageRaw: any,
		sourceRaw: any?,
		damageContextRaw: any?
	) -> number,
}

type HpServiceServerObject = {
	healPlayer: (self: HpServiceServerObject, player: Player, amountRaw: any) -> number?,
}

type PlayerRuntime = {
	playerJanitor: JanitorClass,
	characterJanitor: JanitorClass,
	character: Model?,
	humanoid: Humanoid?,
	rootPart: BasePart?,
	inputHeld: boolean,
	lastAimRequest: CastRequest,
	lastAimDirection: Vector3,
	lastCastRequestAt: number,
	requestWindowStartedAt: number,
	requestsInWindow: number,
	lastStatePushAt: number,
	equippedItemId: string?,
	equippedSlot: number?,
	equippedTool: Tool?,
	magicController: MagicController?,
	weaponCooldowns: { [string]: number },
	pendingPreparedCast: { itemId: string, config: WeaponRuntimeConfig, stats: CastStats, castRequest: CastRequest }?,
	pendingCastByToken: {
		[number]: { itemId: string, config: WeaponRuntimeConfig, stats: CastStats, castRequest: CastRequest },
	},
	committedCastByToken: {
		[number]: { itemId: string, config: WeaponRuntimeConfig, stats: CastStats, castRequest: CastRequest },
	},
}

local MagicServiceServer = {}

local STATE_PUSH_INTERVAL = 0.15
local CAST_REQUEST_INTERVAL = 1 / 90
local CAST_REQUESTS_PER_SECOND_LIMIT = 30
local PROJECTILE_FIXED_STEP = 1 / 60
local PROJECTILE_MAX_OVERLAP_PARTS = 64

local function trim(raw: any): string
	if typeof(raw) ~= "string" then
		return ""
	end
	return string.match(raw, "^%s*(.-)%s*$") or ""
end

local function setCooldownValue(cooldowns: { [string]: number }, itemIdRaw: any, expiresAt: number)
	local itemId = trim(itemIdRaw)
	if itemId == "" then
		return
	end
	cooldowns[itemId] = expiresAt
	cooldowns[string.lower(itemId)] = expiresAt
end

local function getCooldownValue(cooldowns: { [string]: number }, itemIdRaw: any): number
	local itemId = trim(itemIdRaw)
	if itemId == "" then
		return 0
	end
	return cooldowns[itemId] or cooldowns[string.lower(itemId)] or 0
end

local function shallowCopy(sourceRaw: any): { [string]: any }
	local output = {}
	if typeof(sourceRaw) ~= "table" then
		return output
	end
	for key, value in sourceRaw do
		if typeof(key) == "string" then
			output[key] = value
		end
	end
	return output
end

local function looksLikeMagicDefinition(definitionRaw: any): boolean
	if typeof(definitionRaw) ~= "table" then
		return false
	end
	local definition = definitionRaw :: { [string]: any }
	if typeof(definition.magicWeapon) == "table" or typeof(definition.magic) == "table" then
		return true
	end

	local typeToken =
		string.lower(trim(definition.itemType or definition.type or definition.weaponType or definition.class))
	typeToken = string.gsub(typeToken, "[%s_%-]+", "")
	if typeToken == "magicweapon" or typeToken == "magic" or typeToken == "staff" or typeToken == "spell" then
		return true
	end

	local hasMagicLikeStats = definition.manaCost ~= nil
		or definition.castTime ~= nil
		or definition.onHitEffects ~= nil
		or definition.effects ~= nil
		or definition.projectile ~= nil
	return hasMagicLikeStats
end

local function shouldSilenceModuleRequireError(errorRaw: any): boolean
	local message = string.lower(trim(errorRaw))
	if message == "" then
		return false
	end
	if string.find(message, "did not return exactly one value", 1, true) ~= nil then
		return true
	end
	return false
end

local function resolveCastToken(contextRaw: any): number
	if typeof(contextRaw) ~= "table" then
		return -1
	end
	local context = contextRaw :: { [string]: any }
	local castTokenRaw = context.castToken
	if typeof(castTokenRaw) ~= "number" or castTokenRaw ~= castTokenRaw then
		return -1
	end
	local castToken = math.floor(castTokenRaw)
	if castToken <= 0 then
		return -1
	end
	return castToken
end

function MagicServiceServer.CreateRuntime(self: MagicServiceServer): PlayerRuntime
	return {
		playerJanitor = Janitor.new(),
		characterJanitor = Janitor.new(),
		character = nil,
		humanoid = nil,
		rootPart = nil,
		inputHeld = false,
		lastAimRequest = {
			trigger = "None",
			aimDirection = nil,
			aimPosition = nil,
		},
		lastAimDirection = Vector3.new(0, 0, -1),
		lastCastRequestAt = -math.huge,
		requestWindowStartedAt = os.clock(),
		requestsInWindow = 0,
		lastStatePushAt = 0,
		equippedItemId = nil,
		equippedSlot = nil,
		equippedTool = nil,
		magicController = nil,
		weaponCooldowns = {},
		pendingPreparedCast = nil,
		pendingCastByToken = {},
		committedCastByToken = {},
	}
end

function MagicServiceServer.GetRuntime(self: MagicServiceServer, player: Player): PlayerRuntime
	local runtime = self.playerRuntimes[player]
	if runtime ~= nil then
		return runtime
	end
	local nextRuntime = self:createRuntime()
	self.playerRuntimes[player] = nextRuntime
	return nextRuntime
end

function MagicServiceServer.ResolveRuntimeByMagic(
	self: MagicServiceServer,
	magicControllerRaw: any
): (Player?, PlayerRuntime?)
	if typeof(magicControllerRaw) ~= "table" then
		return nil, nil
	end
	for player, runtime in self.playerRuntimes do
		if runtime.magicController == magicControllerRaw then
			return player, runtime
		end
	end
	return nil, nil
end

function MagicServiceServer.ResolveManaStateSnapshot(self: MagicServiceServer, player: Player): (number, number, number)
	local mana = MagicServiceUtils.DEFAULT_MAX_MANA
	local maxMana = MagicServiceUtils.DEFAULT_MAX_MANA
	local regenPerSecond = MagicServiceUtils.DEFAULT_MANA_REGEN
	local manaService = self.manaService
	if manaService == nil then
		return mana, maxMana, regenPerSecond
	end

	local success, manaStateOrError = pcall(function()
		return manaService:getState(player)
	end)
	if not success then
		return mana, maxMana, regenPerSecond
	end
	if typeof(manaStateOrError) ~= "table" then
		return mana, maxMana, regenPerSecond
	end

	local manaState = manaStateOrError :: { [string]: any }
	if typeof(manaState.mana) == "number" and manaState.mana == manaState.mana then
		mana = manaState.mana
	end
	if typeof(manaState.maxMana) == "number" and manaState.maxMana == manaState.maxMana then
		maxMana = manaState.maxMana
	end
	if typeof(manaState.regenPerSecond) == "number" and manaState.regenPerSecond == manaState.regenPerSecond then
		regenPerSecond = manaState.regenPerSecond
	end
	return mana, maxMana, regenPerSecond
end

function MagicServiceServer.PushState(self: MagicServiceServer, player: Player, runtime: PlayerRuntime)
	local now = os.clock()
	if now - runtime.lastStatePushAt < STATE_PUSH_INTERVAL then
		return
	end
	runtime.lastStatePushAt = now
	local mana, maxMana, regenPerSecond = self:resolveManaStateSnapshot(player)
	self.networker:fire(player, MagicServiceUtils.CLIENT_METHOD_APPLY_STATE, {
		mana = mana,
		maxMana = maxMana,
		regenPerSecond = regenPerSecond,
		equippedWeaponId = runtime.equippedItemId,
		equippedSlot = runtime.equippedSlot,
		cooldowns = MagicServiceUtils.cooldownsToRemaining(runtime.weaponCooldowns, now),
		updatedAt = now,
	})
end

function MagicServiceServer.GetEquippedMagicToolFromInventory(
	self: MagicServiceServer,
	player: Player,
	runtime: PlayerRuntime
): (string?, number?, Tool?)
	local inventoryService = self.inventoryService
	if inventoryService == nil then
		return nil, nil, nil
	end
	local inventoryState = inventoryService:getState(player)
	local itemId, selectedSlot = MagicServiceUtils.resolveSelectedItemIdFromInventoryState(inventoryState)
	if itemId == nil then
		return nil, selectedSlot, nil
	end
	local backpack = player:FindFirstChildOfClass("Backpack")
	local tool = MagicServiceUtils.resolveToolByItemId(runtime.character, backpack, itemId)
	if tool == nil or not MagicServiceUtils.isMagicTool(tool) then
		return itemId, selectedSlot, nil
	end
	return itemId, selectedSlot, tool
end

function MagicServiceServer.RefreshEquippedWeaponFromInventory(
	self: MagicServiceServer,
	player: Player,
	runtime: PlayerRuntime
)
	local itemId, selectedSlot, tool = self:getEquippedMagicToolFromInventory(player, runtime)
	runtime.equippedItemId = itemId
	runtime.equippedSlot = selectedSlot
	runtime.equippedTool = tool

	local magicController = runtime.magicController
	if magicController == nil then
		return
	end

	if tool ~= nil then
		magicController:bindTool(tool)
		local weaponConfig = magicController:resolveBoundWeaponConfig()
		if typeof(weaponConfig) == "table" then
			local weaponId = trim((weaponConfig :: any).itemId)
			if weaponId ~= "" then
				magicController.cooldownUntil = getCooldownValue(runtime.weaponCooldowns, weaponId)
			end
		end
	else
		magicController:unbindTool()
	end

	self:pushState(player, runtime)
end

function MagicServiceServer.GetDefinitionOverride(self: MagicServiceServer, itemIdRaw: any): any?
	local itemId = trim(itemIdRaw)
	if itemId == "" then
		return nil
	end
	return self.definitionOverrides[itemId] or self.definitionOverrides[string.lower(itemId)]
end

function MagicServiceServer.BuildRuntimeConfigWithOverrides(
	self: MagicServiceServer,
	weaponConfigRaw: any
): WeaponRuntimeConfig?
	local weaponConfig = if typeof(weaponConfigRaw) == "table" then weaponConfigRaw :: { [string]: any } else nil
	if weaponConfig == nil then
		return nil
	end
	local itemId = trim((weaponConfig :: any).itemId)
	local override = self:getDefinitionOverride(itemId)
	if override == nil then
		return MagicServiceUtils.buildWeaponRuntimeConfig(weaponConfig)
	end

	local patched = shallowCopy(weaponConfig)
	local baseDefinition = if typeof((weaponConfig :: any).definition) == "table"
		then shallowCopy((weaponConfig :: any).definition)
		else {}
	baseDefinition.magicWeapon = override
	patched.definition = baseDefinition
	return MagicServiceUtils.buildWeaponRuntimeConfig(patched)
end

function MagicServiceServer.CollectCastModifiers(
	self: MagicServiceServer,
	player: Player,
	runtime: PlayerRuntime,
	config: WeaponRuntimeConfig,
	contextRaw: any
): ModifierStats
	local modifiers = {}
	local tool = runtime.equippedTool
	if tool ~= nil then
		table.insert(modifiers, {
			damageMultiplier = tool:GetAttribute("MagicDamageMultiplier"),
			damageBonus = tool:GetAttribute("MagicDamageBonus"),
			manaMultiplier = tool:GetAttribute("MagicManaMultiplier"),
			manaBonus = tool:GetAttribute("MagicManaBonus"),
			cooldownMultiplier = tool:GetAttribute("MagicCooldownMultiplier"),
			cooldownBonus = tool:GetAttribute("MagicCooldownBonus"),
			castTimeMultiplier = tool:GetAttribute("MagicCastTimeMultiplier"),
			castTimeBonus = tool:GetAttribute("MagicCastTimeBonus"),
			knockbackMultiplier = tool:GetAttribute("MagicKnockbackMultiplier"),
			knockbackBonus = tool:GetAttribute("MagicKnockbackBonus"),
			speedMultiplier = tool:GetAttribute("MagicProjectileSpeedMultiplier"),
			speedBonus = tool:GetAttribute("MagicProjectileSpeedBonus"),
			lifetimeMultiplier = tool:GetAttribute("MagicProjectileLifetimeMultiplier"),
			lifetimeBonus = tool:GetAttribute("MagicProjectileLifetimeBonus"),
			pierceBonus = tool:GetAttribute("MagicPierceBonus"),
			projectileCountBonus = tool:GetAttribute("MagicProjectileCountBonus"),
			forceHoming = tool:GetAttribute("MagicForceHoming"),
		})
	end

	for _, provider in self.modifierProviders do
		if typeof(provider) ~= "function" then
			continue
		end
		local ok, providerResult = pcall(provider, self, player, runtime, config, contextRaw)
		if ok and typeof(providerResult) == "table" then
			table.insert(modifiers, providerResult)
		end
	end

	return MagicServiceUtils.mergeModifiers(modifiers)
end

function MagicServiceServer.PrepareControllerStatsForCast(
	self: MagicServiceServer,
	player: Player,
	runtime: PlayerRuntime,
	castRequest: CastRequest
): boolean
	local magicController = runtime.magicController
	if magicController == nil then
		return false
	end
	local weaponConfigRaw = magicController:resolveBoundWeaponConfig()
	local config = self:buildRuntimeConfigWithOverrides(weaponConfigRaw)
	if config == nil then
		return false
	end

	local modifiers = self:collectCastModifiers(player, runtime, config, castRequest)
	local castStats = MagicServiceUtils.buildCastStats(config, modifiers)

	if typeof(magicController.weaponConfig) == "table" then
		local mutable = magicController.weaponConfig :: { [string]: any }
		mutable.manaCost = castStats.manaCost
		mutable.cooldown = castStats.cooldown
		mutable.castTime = castStats.castTime
		mutable.damage = castStats.damage
		if typeof(mutable.projectile) == "table" then
			local projectile = mutable.projectile :: { [string]: any }
			projectile.speed = castStats.projectileSpeed
			projectile.lifetime = castStats.projectileLifetime
			projectile.pierce = castStats.pierce
			projectile.count = castStats.projectileCount
			projectile.spread = castStats.projectileSpread
		end
	end

	runtime.pendingPreparedCast = {
		itemId = config.itemId,
		config = config,
		stats = castStats,
		castRequest = castRequest,
	}
	return true
end

function MagicServiceServer.OnMagicCastRequested(
	self: MagicServiceServer,
	magicController: MagicController,
	contextRaw: any
): boolean
	local player, runtime = self:resolveRuntimeByMagic(magicController)
	if player == nil or runtime == nil then
		return false
	end
	local context = if typeof(contextRaw) == "table" then contextRaw else {}
	if not MagicServiceUtils.isHumanoidAlive(runtime.humanoid) then
		return false
	end
	if MagicServiceUtils.isPlayerStunned(player, runtime.character, runtime.humanoid) then
		return false
	end

	local prepared = runtime.pendingPreparedCast
	if prepared == nil then
		return false
	end
	local now = os.clock()
	if now < getCooldownValue(runtime.weaponCooldowns, prepared.itemId) then
		return false
	end

	local castToken = resolveCastToken(context)
	if castToken < 1 then
		return false
	end
	runtime.pendingCastByToken[castToken] = prepared
	runtime.pendingPreparedCast = nil
	return true
end

function MagicServiceServer.CanConsumeMana(
	self: MagicServiceServer,
	player: Player?,
	amountRaw: number,
	contextRaw: any
): boolean
	if player == nil then
		return false
	end
	local runtime = self.playerRuntimes[player]
	if runtime == nil then
		return false
	end
	local castToken = resolveCastToken(contextRaw)
	if castToken < 1 then
		return false
	end
	local castData = runtime.pendingCastByToken[castToken]
	local manaCost = if castData ~= nil then castData.stats.manaCost else math.max(0, amountRaw)
	local manaService = self.manaService
	if manaService == nil then
		return false
	end
	local context = if typeof(contextRaw) == "table" then shallowCopy(contextRaw) else {}
	context.castToken = castToken
	if castData ~= nil then
		context.itemId = castData.itemId
	end
	local success, canConsumeOrError = pcall(function()
		return manaService:canConsumeMana(player, manaCost, context)
	end)
	if not success then
		return false
	end
	return canConsumeOrError == true
end

function MagicServiceServer.ConsumeMana(
	self: MagicServiceServer,
	player: Player?,
	amountRaw: number,
	contextRaw: any
): boolean
	if player == nil then
		return false
	end
	local runtime = self.playerRuntimes[player]
	if runtime == nil then
		return false
	end
	local castToken = resolveCastToken(contextRaw)
	if castToken < 1 then
		return false
	end
	local castData = runtime.pendingCastByToken[castToken]
	local manaCost = if castData ~= nil then castData.stats.manaCost else math.max(0, amountRaw)
	local manaService = self.manaService
	if manaService == nil then
		return false
	end
	local context = if typeof(contextRaw) == "table" then shallowCopy(contextRaw) else {}
	context.castToken = castToken
	if castData ~= nil then
		context.itemId = castData.itemId
	end
	local success, consumeResultOrError = pcall(function()
		return manaService:consumeMana(player, manaCost, context)
	end)
	if not success then
		return false
	end
	if consumeResultOrError ~= true then
		return false
	end

	if castData ~= nil then
		local cooldownEndsAt = os.clock() + castData.stats.cooldown
		setCooldownValue(runtime.weaponCooldowns, castData.itemId, cooldownEndsAt)
		if runtime.magicController ~= nil then
			runtime.magicController.cooldownUntil = cooldownEndsAt
		end
		runtime.committedCastByToken[castToken] = castData
	end
	self:pushState(player, runtime)
	return true
end

function MagicServiceServer.RequestSync(self: MagicServiceServer, player: Player)
	if self.playerRuntimes[player] == nil then
		self:trackPlayer(player)
		return
	end
	local runtime = self:getRuntime(player)
	self:pushState(player, runtime)
end

function MagicServiceServer.RequestRefreshEquipped(self: MagicServiceServer, player: Player)
	local runtime = self:getRuntime(player)
	self:refreshEquippedWeaponFromInventory(player, runtime)
end

function MagicServiceServer.RequestSetInputHeld(
	self: MagicServiceServer,
	player: Player,
	inputHeldRaw: any,
	castRequestRaw: any
)
	if typeof(inputHeldRaw) ~= "boolean" then
		return
	end
	local runtime = self:getRuntime(player)
	runtime.inputHeld = inputHeldRaw
	runtime.lastAimRequest = MagicServiceUtils.sanitizeCastRequest(castRequestRaw)
	if runtime.lastAimRequest.aimDirection ~= nil and runtime.lastAimRequest.aimDirection.Magnitude > 1e-4 then
		runtime.lastAimDirection = runtime.lastAimRequest.aimDirection.Unit
	end
end

function MagicServiceServer.RequestCast(self: MagicServiceServer, player: Player, castRequestRaw: any)
	local runtime = self:getRuntime(player)
	local now = os.clock()
	if now - runtime.requestWindowStartedAt > 1 then
		runtime.requestWindowStartedAt = now
		runtime.requestsInWindow = 0
	end
	runtime.requestsInWindow += 1
	if runtime.requestsInWindow > CAST_REQUESTS_PER_SECOND_LIMIT then
		return
	end
	if now - runtime.lastCastRequestAt < CAST_REQUEST_INTERVAL then
		return
	end
	runtime.lastCastRequestAt = now

	runtime.lastAimRequest = MagicServiceUtils.sanitizeCastRequest(castRequestRaw)
	if runtime.lastAimRequest.aimDirection ~= nil and runtime.lastAimRequest.aimDirection.Magnitude > 1e-4 then
		runtime.lastAimDirection = runtime.lastAimRequest.aimDirection.Unit
	end

	if not MagicServiceUtils.isHumanoidAlive(runtime.humanoid) then
		return
	end
	if MagicServiceUtils.isPlayerStunned(player, runtime.character, runtime.humanoid) then
		return
	end

	self:refreshEquippedWeaponFromInventory(player, runtime)
	if runtime.magicController == nil or runtime.equippedTool == nil then
		return
	end
	if not self:prepareControllerStatsForCast(player, runtime, runtime.lastAimRequest) then
		return
	end
	runtime.magicController:queueCast(runtime.lastAimRequest.trigger)
end

function MagicServiceServer.CreateProjectilePart(
	self: MagicServiceServer,
	weaponIdRaw: any,
	config: WeaponRuntimeConfig
): BasePart
	local weaponId = trim(weaponIdRaw)
	local template = config.projectile.template
	local part = if template ~= nil then template:Clone() else nil
	if part == nil then
		part = Instance.new("Part")
		part.Shape = Enum.PartType.Ball
		part.Size = Vector3.new(0.4, 0.4, 0.4)
	end
	part.Name = ("MagicProjectile_%s"):format(if weaponId ~= "" then weaponId else "Unknown")
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Transparency = 1
	part.Parent = self.projectileFolder
	return part
end

function MagicServiceServer.AcquireProjectilePart(
	self: MagicServiceServer,
	config: WeaponRuntimeConfig
): { part: BasePart, active: boolean, weaponId: string }
	local weaponId = config.itemId
	local pool = self.projectilePools[weaponId]
	if pool == nil then
		pool = {}
		self.projectilePools[weaponId] = pool
	end
	for _, entry in pool do
		if entry.active == false then
			entry.active = true
			return entry
		end
	end
	local entry = {
		part = self:createProjectilePart(weaponId, config),
		active = true,
		weaponId = weaponId,
	}
	table.insert(pool, entry)
	return entry
end

function MagicServiceServer.ReleaseProjectile(self: MagicServiceServer, projectile: any)
	local entry = projectile.poolEntry
	entry.active = false
	entry.part.Transparency = 1
	entry.part.CFrame = CFrame.new(0, -10000, 0)
end

function MagicServiceServer.ResolveCastOriginAndDirection(
	self: MagicServiceServer,
	runtime: PlayerRuntime,
	castRequest: CastRequest
): (Vector3, Vector3)
	local rootPart = runtime.rootPart
	if rootPart == nil then
		return Vector3.zero, Vector3.new(0, 0, -1)
	end
	local origin = rootPart.Position + Vector3.new(0, 1.35, 0)
	local fallback = rootPart.CFrame.LookVector
	local direction = MagicServiceUtils.resolveCastDirection(origin, castRequest, fallback)
	return origin, direction
end

function MagicServiceServer.InvokeWeaponCallback(self: MagicServiceServer, callbackRaw: any, context: { [string]: any })
	if typeof(callbackRaw) ~= "function" then
		return
	end
	pcall(callbackRaw, context)
end

function MagicServiceServer.ResolveHumanoidRootPart(self: MagicServiceServer, humanoid: Humanoid?): BasePart?
	if humanoid == nil then
		return nil
	end
	local model = humanoid.Parent
	if model == nil or not model:IsA("Model") then
		return nil
	end
	local rootPart = model:FindFirstChild("HumanoidRootPart")
	if rootPart ~= nil and rootPart:IsA("BasePart") then
		return rootPart
	end
	if model.PrimaryPart ~= nil and model.PrimaryPart:IsA("BasePart") then
		return model.PrimaryPart
	end
	return nil
end

function MagicServiceServer.CollectOverlapParts(
	self: MagicServiceServer,
	projectile: any,
	position: Vector3,
	radiusRaw: number
): { BasePart }
	local radius = math.max(0.25, radiusRaw)
	local overlapParams = projectile.overlapParams
	if typeof(overlapParams) ~= "OverlapParams" then
		overlapParams = OverlapParams.new()
		overlapParams.FilterType = Enum.RaycastFilterType.Exclude
		local exclude = { self.projectileFolder } :: { Instance }
		if projectile.caster.Character ~= nil then
			table.insert(exclude, projectile.caster.Character)
		end
		overlapParams.FilterDescendantsInstances = exclude
		overlapParams.MaxParts = PROJECTILE_MAX_OVERLAP_PARTS
		projectile.overlapParams = overlapParams
	end

	local ok, partsOrError = pcall(function()
		return Workspace:GetPartBoundsInRadius(position, radius, overlapParams)
	end)
	if not ok or typeof(partsOrError) ~= "table" then
		return {}
	end

	local parts = {} :: { BasePart }
	for _, part in partsOrError do
		if typeof(part) == "Instance" and part:IsA("BasePart") then
			table.insert(parts, part)
		end
	end
	return parts
end

function MagicServiceServer.IsValidHumanoidTarget(
	self: MagicServiceServer,
	projectile: any,
	humanoid: Humanoid?
): boolean
	if not MagicServiceUtils.isHumanoidAlive(humanoid) then
		return false
	end

	local casterCharacter = projectile.caster.Character
	local targetModel = humanoid.Parent
	if targetModel == nil or not targetModel:IsA("Model") then
		return false
	end
	if targetModel == casterCharacter then
		return false
	end

	local targetPlayer = Players:GetPlayerFromCharacter(targetModel)
	if targetPlayer ~= nil then
		return projectile.config.projectile.canHitPlayers
	end
	return projectile.config.projectile.canHitNpcs
end

function MagicServiceServer.ApplyKnockbackToHumanoid(self: MagicServiceServer, projectile: any, humanoid: Humanoid?)
	local rootPart = self:resolveHumanoidRootPart(humanoid)
	if rootPart == nil then
		return
	end
	rootPart.AssemblyLinearVelocity += projectile.direction * (projectile.stats.knockback * 8) + Vector3.new(0, 6, 0)
end

function MagicServiceServer.DamageHumanoidTarget(
	self: MagicServiceServer,
	projectile: any,
	humanoid: Humanoid?,
	damageRaw: number,
	markHitRaw: any
): boolean
	if not self:isValidHumanoidTarget(projectile, humanoid) then
		return false
	end
	if humanoid == nil then
		return false
	end

	local damage = math.max(0, damageRaw)
	if damage <= 0 then
		return false
	end

	local markHit = markHitRaw ~= false
	if markHit and projectile.hitHumanoids[humanoid] then
		return false
	end

	humanoid:TakeDamage(damage)
	if markHit then
		projectile.hitHumanoids[humanoid] = true
	end
	self:applyKnockbackToHumanoid(projectile, humanoid)
	return true
end

function MagicServiceServer.ApplyStackingStatusEffect(
	self: MagicServiceServer,
	projectile: any,
	effect: any,
	targetHumanoid: Humanoid,
	hitPart: BasePart
)
	local effectsMap = self.activeEffectsByHumanoid[targetHumanoid]
	if effectsMap == nil then
		effectsMap = {}
		self.activeEffectsByHumanoid[targetHumanoid] = effectsMap
	end

	local effectKey = ("%s:%d"):format(effect.effectType, projectile.caster.UserId)
	local existing = effectsMap[effectKey]
	local now = os.clock()
	local stackRule = effect.stackRule
	if existing ~= nil then
		if stackRule == "replace" or stackRule == "nostack" then
			existing.stacks = 1
		elseif stackRule == "stack" or stackRule == "add" or stackRule == "additive" then
			existing.stacks = math.min(effect.maxStacks, existing.stacks + 1)
		elseif stackRule == "max" then
			existing.stacks = math.max(existing.stacks, 1)
		end
		existing.expiresAt = now + effect.duration
		existing.nextTickAt = now + effect.tickInterval
		existing.targetPart = hitPart
		return
	end

	effectsMap[effectKey] = {
		key = effectKey,
		targetHumanoid = targetHumanoid,
		targetPart = hitPart,
		sourcePlayer = projectile.caster,
		definition = effect,
		stacks = 1,
		expiresAt = now + effect.duration,
		nextTickAt = now + effect.tickInterval,
	}
end

function MagicServiceServer.ApplySplashEffect(
	self: MagicServiceServer,
	projectile: any,
	effect: any,
	hitPosition: Vector3,
	hitHumanoid: Humanoid?
)
	local radius = math.max(0, effect.radius)
	if radius <= 0 then
		return
	end
	local damageScale = math.max(0, effect.magnitude)
	if damageScale <= 0 then
		return
	end

	local seenHumanoids = {}
	local seenNpcModels = {}
	if hitHumanoid ~= nil then
		seenHumanoids[hitHumanoid] = true
	end
	local parts = self:collectOverlapParts(projectile, hitPosition, radius)
	for _, part in parts do
		if part == nil then
			continue
		end

		local model = part:FindFirstAncestorOfClass("Model")
		local npcDamaged = false
		if
			model ~= nil
			and not seenNpcModels[model]
			and projectile.config.projectile.canHitNpcs
			and self.npcService ~= nil
		then
			seenNpcModels[model] = true
			local splashNpcDamage =
				self.npcService:damageNpcFromHitPart(part, projectile.stats.damage * damageScale, projectile.caster)
			if splashNpcDamage > 0 then
				npcDamaged = true
			end

			if not npcDamaged and self.bossService ~= nil then
				local splashBossDamage = self.bossService:damageBossFromHitPart(
					part,
					projectile.stats.damage * damageScale,
					projectile.caster,
					"MagicSplash"
				)
				if splashBossDamage > 0 then
					npcDamaged = true
				end
			end
		end

		local humanoid = MagicServiceUtils.resolveHumanoidFromHitPart(part)
		if not npcDamaged and humanoid ~= nil and not seenHumanoids[humanoid] then
			seenHumanoids[humanoid] = true
			local rootPart = self:resolveHumanoidRootPart(humanoid)
			local targetPosition = if rootPart ~= nil then rootPart.Position else part.Position
			local distanceAlpha = math.clamp((targetPosition - hitPosition).Magnitude / math.max(0.001, radius), 0, 1)
			local falloff = math.max(0.2, 1 - distanceAlpha)
			local splashDamage = projectile.stats.damage * damageScale * falloff
			self:damageHumanoidTarget(projectile, humanoid, splashDamage, true)
		end
	end
end

function MagicServiceServer.FindNearestChainTarget(
	self: MagicServiceServer,
	projectile: any,
	originPosition: Vector3,
	radiusRaw: number,
	visited: { [Humanoid]: boolean }
): (Humanoid?, Vector3?)
	local radius = math.max(0.25, radiusRaw)
	local nearest = nil :: Humanoid?
	local nearestPosition = nil :: Vector3?
	local nearestDistance = math.huge
	local parts = self:collectOverlapParts(projectile, originPosition, radius)
	for _, part in parts do
		local humanoid = MagicServiceUtils.resolveHumanoidFromHitPart(part)
		if humanoid == nil or visited[humanoid] then
			continue
		end
		if not self:isValidHumanoidTarget(projectile, humanoid) then
			continue
		end
		local rootPart = self:resolveHumanoidRootPart(humanoid)
		local position = if rootPart ~= nil then rootPart.Position else part.Position
		local distance = (position - originPosition).Magnitude
		if distance < nearestDistance then
			nearestDistance = distance
			nearest = humanoid
			nearestPosition = position
		end
	end
	return nearest, nearestPosition
end

function MagicServiceServer.ApplyChainEffect(
	self: MagicServiceServer,
	projectile: any,
	effect: any,
	hitPosition: Vector3,
	hitHumanoid: Humanoid?
)
	if hitHumanoid == nil then
		return
	end
	local jumpCount = math.max(0, math.floor(effect.jumps))
	if jumpCount <= 0 then
		return
	end

	local visited = {}
	visited[hitHumanoid] = true
	local currentPosition = hitPosition
	local damageScale = math.max(0, effect.magnitude)
	local jumpFalloff = math.clamp(effect.jumpFalloff, 0, 1)

	for _ = 1, jumpCount do
		local targetHumanoid, targetPosition =
			self:findNearestChainTarget(projectile, currentPosition, effect.radius, visited)
		if targetHumanoid == nil or targetPosition == nil then
			break
		end
		visited[targetHumanoid] = true

		local chainDamage = projectile.stats.damage * damageScale
		if self:damageHumanoidTarget(projectile, targetHumanoid, chainDamage, true) then
			for _, listedPlayer in Players:GetPlayers() do
				if PlayerServiceServer:isGameplayActiveForPlayer(listedPlayer) then
					self.networker:fire(listedPlayer, MagicServiceUtils.CLIENT_METHOD_ON_IMPACT_VISUAL, {
						castId = projectile.castId,
						weaponId = projectile.weaponId,
						position = targetPosition,
						normal = nil,
						visualColor = projectile.config.projectile.visualColor,
						visualSize = projectile.config.projectile.visualSize,
						reason = "Chain",
					})
				end
			end
		end

		currentPosition = targetPosition
		damageScale *= jumpFalloff
		if damageScale <= 0 then
			break
		end
	end
end

function MagicServiceServer.ApplyEffectsFromHit(
	self: MagicServiceServer,
	projectile: any,
	hitPart: BasePart,
	hitHumanoid: Humanoid?,
	hitPosition: Vector3
)
	for _, effect in projectile.config.effects do
		if effect.effectType == "lifesteal" then
			local healAmount = math.max(0, projectile.stats.damage * effect.magnitude)
			if healAmount > 0 and self.hpService ~= nil then
				pcall(function()
					self.hpService:healPlayer(projectile.caster, healAmount)
				end)
			end
		elseif effect.effectType == "burn" or effect.effectType == "slow" then
			if hitHumanoid ~= nil then
				self:applyStackingStatusEffect(projectile, effect, hitHumanoid, hitPart)
			end
		elseif effect.effectType == "splash" then
			self:applySplashEffect(projectile, effect, hitPosition, hitHumanoid)
		elseif effect.effectType == "chain" then
			self:applyChainEffect(projectile, effect, hitPosition, hitHumanoid)
		end
	end
end

function MagicServiceServer.ExpireProjectile(
	self: MagicServiceServer,
	projectileId: number,
	reason: string,
	position: Vector3,
	normal: Vector3?
)
	local projectile = self.activeProjectiles[projectileId]
	if projectile == nil then
		return
	end
	self.activeProjectiles[projectileId] = nil
	self:releaseProjectile(projectile)
	for _, listedPlayer in Players:GetPlayers() do
		if PlayerServiceServer:isGameplayActiveForPlayer(listedPlayer) then
			self.networker:fire(listedPlayer, MagicServiceUtils.CLIENT_METHOD_ON_IMPACT_VISUAL, {
				castId = projectile.castId,
				weaponId = projectile.weaponId,
				position = position,
				normal = normal,
				visualColor = projectile.config.projectile.visualColor,
				visualSize = projectile.config.projectile.visualSize,
				reason = reason,
			})
		end
	end
	self:invokeWeaponCallback(projectile.config.callbacks.OnExpire, {
		service = self,
		projectile = projectile,
		position = position,
		normal = normal,
		reason = reason,
	})
end

function MagicServiceServer.HandleProjectileHit(
	self: MagicServiceServer,
	projectileId: number,
	projectile: any,
	hit: any
)
	local hitPart = hit.Instance
	if typeof(hitPart) ~= "Instance" or not hitPart:IsA("BasePart") then
		if projectile.config.projectile.collisionBehavior ~= "pierce" then
			self:expireProjectile(projectileId, "WorldHit", hit.Position, hit.Normal)
		end
		return
	end
	local casterCharacter = projectile.caster.Character
	if casterCharacter ~= nil and hitPart:IsDescendantOf(casterCharacter) then
		return
	end

	local damage = projectile.stats.damage
	local didDamage = false
	local npcDamaged = false
	local hitHumanoid = nil :: Humanoid?
	if projectile.config.projectile.canHitNpcs and self.npcService ~= nil then
		local npcDamage = self.npcService:damageNpcFromHitPart(hitPart, damage, projectile.caster)
		if npcDamage > 0 then
			didDamage = true
			npcDamaged = true
		end
	end

	if projectile.config.projectile.canHitNpcs and not npcDamaged and self.bossService ~= nil then
		local bossDamage = self.bossService:damageBossFromHitPart(hitPart, damage, projectile.caster, "MagicProjectile")
		if bossDamage > 0 then
			didDamage = true
			npcDamaged = true
		end
	end

	hitHumanoid = MagicServiceUtils.resolveHumanoidFromHitPart(hitPart)
	if (not npcDamaged) and self:damageHumanoidTarget(projectile, hitHumanoid, damage, true) then
		didDamage = true
	end

	if didDamage then
		self:invokeWeaponCallback(projectile.config.callbacks.OnHit, {
			service = self,
			projectile = projectile,
			hitPart = hitPart,
			hitHumanoid = hitHumanoid,
			position = hit.Position,
			normal = hit.Normal,
			damage = damage,
		})
		self:applyEffectsFromHit(projectile, hitPart, hitHumanoid, hit.Position)
		if projectile.pierceRemaining > 0 then
			projectile.pierceRemaining -= 1
			return
		end
		self:expireProjectile(projectileId, "TargetHit", hit.Position, hit.Normal)
		return
	end

	if projectile.config.projectile.collisionBehavior == "pierce" then
		return
	end

	if projectile.config.projectile.destroyOnWorldHit then
		self:expireProjectile(projectileId, "WorldHit", hit.Position, hit.Normal)
	end
end

function MagicServiceServer.FindNearestHomingTarget(self: MagicServiceServer, projectile: any): (Humanoid?, Vector3?)
	local homingRange = projectile.config.projectile.homingRange
	if homingRange <= 0 then
		return nil, nil
	end
	local nearest = nil :: Humanoid?
	local nearestPosition = nil :: Vector3?
	local nearestDistance = math.huge
	local parts = self:collectOverlapParts(projectile, projectile.position, homingRange)
	for _, part in parts do
		local humanoid = MagicServiceUtils.resolveHumanoidFromHitPart(part)
		if humanoid == nil then
			continue
		end
		if projectile.hitHumanoids[humanoid] then
			continue
		end
		if not self:isValidHumanoidTarget(projectile, humanoid) then
			continue
		end
		local rootPart = self:resolveHumanoidRootPart(humanoid)
		local targetPosition = if rootPart ~= nil then rootPart.Position else part.Position
		local distance = (targetPosition - projectile.position).Magnitude
		if distance < nearestDistance then
			nearestDistance = distance
			nearest = humanoid
			nearestPosition = targetPosition
		end
	end
	return nearest, nearestPosition
end

function MagicServiceServer.StepProjectileHoming(self: MagicServiceServer, projectile: any, dt: number)
	if not projectile.stats.homingEnabled then
		projectile.homingTargetHumanoid = nil
		return
	end
	local homingRange = projectile.config.projectile.homingRange
	local targetHumanoid = projectile.homingTargetHumanoid
	local targetPosition = nil :: Vector3?
	if targetHumanoid ~= nil and self:isValidHumanoidTarget(projectile, targetHumanoid) then
		local rootPart = self:resolveHumanoidRootPart(targetHumanoid)
		if rootPart ~= nil then
			local distance = (rootPart.Position - projectile.position).Magnitude
			if distance <= homingRange then
				targetPosition = rootPart.Position
			end
		end
	end

	if targetPosition == nil then
		targetHumanoid, targetPosition = self:findNearestHomingTarget(projectile)
		projectile.homingTargetHumanoid = targetHumanoid
	end
	if targetPosition == nil then
		return
	end

	local desiredDirection = targetPosition - projectile.position
	if desiredDirection.Magnitude <= 1e-4 then
		return
	end
	local turnAlpha = math.clamp(projectile.config.projectile.homingTurnRate * dt, 0, 1)
	local nextDirection = projectile.direction:Lerp(desiredDirection.Unit, turnAlpha)
	if nextDirection.Magnitude <= 1e-4 then
		return
	end
	projectile.direction = nextDirection.Unit
	projectile.velocity = projectile.direction * projectile.stats.projectileSpeed
end

function MagicServiceServer.ResolveProjectileCollision(
	self: MagicServiceServer,
	projectile: any,
	fromPosition: Vector3,
	toPosition: Vector3
): any?
	if projectile.config.projectile.collisionBehavior == "overlap" then
		local parts = self:collectOverlapParts(projectile, toPosition, projectile.config.projectile.radius)
		if #parts <= 0 then
			return nil
		end
		local chosen = parts[1]
		local chosenDistance = (chosen.Position - toPosition).Magnitude
		for index = 2, #parts do
			local candidate = parts[index]
			local distance = (candidate.Position - toPosition).Magnitude
			if distance < chosenDistance then
				chosen = candidate
				chosenDistance = distance
			end
		end
		return {
			Instance = chosen,
			Position = toPosition,
			Normal = -projectile.direction,
		}
	end

	local rayDirection = toPosition - fromPosition
	if rayDirection.Magnitude <= 1e-4 then
		return nil
	end
	return Workspace:Raycast(fromPosition, rayDirection, projectile.raycastParams)
end

function MagicServiceServer.StepProjectiles(self: MagicServiceServer, dt: number)
	for projectileId, projectile in self.activeProjectiles do
		if projectile.lifetimeRemaining <= 0 then
			self:expireProjectile(projectileId, "LifetimeEnded", projectile.position, nil)
			continue
		end

		self:stepProjectileHoming(projectile, dt)
		local fromPosition = projectile.position
		local toPosition = fromPosition + projectile.velocity * dt
		local hit = self:resolveProjectileCollision(projectile, fromPosition, toPosition)
		if hit ~= nil then
			projectile.position = hit.Position
			self:handleProjectileHit(projectileId, projectile, hit)
			if self.activeProjectiles[projectileId] == nil then
				continue
			end
			projectile.poolEntry.part.CFrame =
				CFrame.lookAt(projectile.position, projectile.position + projectile.direction)
		else
			projectile.position = toPosition
			projectile.poolEntry.part.CFrame = CFrame.lookAt(toPosition, toPosition + projectile.direction)
		end

		projectile.lifetimeRemaining -= dt
		self:invokeWeaponCallback(projectile.config.callbacks.OnTick, {
			service = self,
			projectile = projectile,
			dt = dt,
			position = projectile.position,
		})
	end
end

function MagicServiceServer.StepEffects(self: MagicServiceServer, now: number)
	for humanoid, effectsMap in self.activeEffectsByHumanoid do
		if not MagicServiceUtils.isHumanoidAlive(humanoid) then
			self.activeEffectsByHumanoid[humanoid] = nil
			continue
		end

		local maxSlow = 0
		for key, effectRuntime in effectsMap do
			if now >= effectRuntime.expiresAt then
				effectsMap[key] = nil
				continue
			end
			if effectRuntime.definition.effectType == "burn" and now >= effectRuntime.nextTickAt then
				effectRuntime.nextTickAt = now + effectRuntime.definition.tickInterval
				local burnDamage = math.max(0, effectRuntime.definition.magnitude * effectRuntime.stacks)
				if burnDamage > 0 then
					humanoid:TakeDamage(burnDamage)
				end
			elseif effectRuntime.definition.effectType == "slow" then
				local slowAlpha = math.clamp(effectRuntime.definition.magnitude * effectRuntime.stacks, 0, 0.95)
				if slowAlpha > maxSlow then
					maxSlow = slowAlpha
				end
			end
		end

		if next(effectsMap) == nil then
			PlayerServiceUtils.setMovementSpeedMultiplier(
				humanoid,
				PlayerServiceUtils.MAGIC_WALK_SPEED_MULTIPLIER_ATTRIBUTE,
				nil
			)
			self.activeEffectsByHumanoid[humanoid] = nil
		else
			if maxSlow > 0 then
				PlayerServiceUtils.setMovementSpeedMultiplier(
					humanoid,
					PlayerServiceUtils.MAGIC_WALK_SPEED_MULTIPLIER_ATTRIBUTE,
					1 - maxSlow
				)
			else
				PlayerServiceUtils.setMovementSpeedMultiplier(
					humanoid,
					PlayerServiceUtils.MAGIC_WALK_SPEED_MULTIPLIER_ATTRIBUTE,
					nil
				)
			end
		end
	end
end

function MagicServiceServer.SpawnProjectile(
	self: MagicServiceServer,
	player: Player,
	runtime: PlayerRuntime,
	config: WeaponRuntimeConfig,
	stats: CastStats,
	direction: Vector3,
	origin: Vector3,
	castToken: number,
	projectileIndex: number
)
	local poolEntry = self:acquireProjectilePart(config)
	local castId = ("%d:%d:%d"):format(player.UserId, castToken, projectileIndex)
	local projectileId = self.nextProjectileId + 1
	self.nextProjectileId = projectileId
	local overlapParams = OverlapParams.new()
	overlapParams.FilterType = Enum.RaycastFilterType.Exclude
	local overlapExclude = { self.projectileFolder } :: { Instance }
	if runtime.character ~= nil then
		table.insert(overlapExclude, runtime.character)
	end
	overlapParams.FilterDescendantsInstances = overlapExclude
	overlapParams.MaxParts = PROJECTILE_MAX_OVERLAP_PARTS

	self.activeProjectiles[projectileId] = {
		id = projectileId,
		castId = castId,
		caster = player,
		weaponId = config.itemId,
		config = config,
		stats = stats,
		poolEntry = poolEntry,
		position = origin,
		direction = direction,
		velocity = direction * stats.projectileSpeed,
		lifetimeRemaining = stats.projectileLifetime,
		pierceRemaining = stats.pierce,
		hitHumanoids = {},
		homingTargetHumanoid = nil,
		raycastParams = (function()
			local params = RaycastParams.new()
			params.FilterType = Enum.RaycastFilterType.Exclude
			local exclude = { self.projectileFolder } :: { Instance }
			if runtime.character ~= nil then
				table.insert(exclude, runtime.character)
			end
			params.FilterDescendantsInstances = exclude
			params.IgnoreWater = false
			return params
		end)(),
		overlapParams = overlapParams,
	}

	poolEntry.part.CFrame = CFrame.lookAt(origin, origin + direction)
	poolEntry.part.Transparency = 1

	for _, listedPlayer in Players:GetPlayers() do
		if PlayerServiceServer:isGameplayActiveForPlayer(listedPlayer) then
			self.networker:fire(listedPlayer, MagicServiceUtils.CLIENT_METHOD_ON_CAST_VISUAL, {
				castId = castId,
				casterUserId = player.UserId,
				weaponId = config.itemId,
				origin = origin,
				direction = direction,
				speed = stats.projectileSpeed,
				lifetime = stats.projectileLifetime,
				castTime = stats.castTime,
				visualColor = config.projectile.visualColor,
				visualSize = config.projectile.visualSize,
				visualName = config.displayName,
			})
		end
	end
end

function MagicServiceServer.ExecuteCast(
	self: MagicServiceServer,
	player: Player,
	runtime: PlayerRuntime,
	config: WeaponRuntimeConfig,
	stats: CastStats,
	castRequest: CastRequest,
	castToken: number
)
	local origin, direction = self:resolveCastOriginAndDirection(runtime, castRequest)
	self:invokeWeaponCallback(config.callbacks.OnCast, {
		service = self,
		player = player,
		config = config,
		stats = stats,
		origin = origin,
		direction = direction,
		castToken = castToken,
		castRequest = castRequest,
	})

	if not config.projectile.enabled then
		return
	end
	for projectileIndex = 1, stats.projectileCount do
		local spreadDirection =
			MagicServiceUtils.applySpread(direction, stats.projectileSpread, projectileIndex, stats.projectileCount)
		self:spawnProjectile(player, runtime, config, stats, spreadDirection, origin, castToken, projectileIndex)
	end
end

function MagicServiceServer.OnMagicCastCommitted(
	self: MagicServiceServer,
	magicController: MagicController,
	contextRaw: any
)
	local player, runtime = self:resolveRuntimeByMagic(magicController)
	if player == nil or runtime == nil then
		return
	end
	local context = if typeof(contextRaw) == "table" then contextRaw else {}
	local castToken = resolveCastToken(context)
	if castToken < 1 then
		return
	end
	local castData = runtime.committedCastByToken[castToken] or runtime.pendingCastByToken[castToken]
	runtime.pendingCastByToken[castToken] = nil
	runtime.committedCastByToken[castToken] = nil
	if castData == nil then
		return
	end
	self:executeCast(player, runtime, castData.config, castData.stats, castData.castRequest, castToken)
end

function MagicServiceServer.StepHeldInput(self: MagicServiceServer)
	for player, runtime in self.playerRuntimes do
		if runtime.inputHeld and os.clock() - runtime.lastCastRequestAt >= 0.12 then
			self:requestCast(player, runtime.lastAimRequest)
		end
	end
end

function MagicServiceServer.OnHeartbeat(self: MagicServiceServer, dt: number)
	self.fixedStepAccumulator += dt
	local steps = 0
	while self.fixedStepAccumulator >= PROJECTILE_FIXED_STEP and steps < 4 do
		self.fixedStepAccumulator -= PROJECTILE_FIXED_STEP
		steps += 1
		self:stepHeldInput()
		self:stepProjectiles(PROJECTILE_FIXED_STEP)
		self:stepEffects(os.clock())
	end
	if steps >= 4 then
		self.fixedStepAccumulator = 0
	end
end

function MagicServiceServer.BindCharacter(
	self: MagicServiceServer,
	player: Player,
	runtime: PlayerRuntime,
	character: Model
)
	runtime.characterJanitor:Clean()
	runtime.character = character
	runtime.humanoid = character:FindFirstChildOfClass("Humanoid")
	local rootPart = character:FindFirstChild("HumanoidRootPart")
	runtime.rootPart = if rootPart ~= nil and rootPart:IsA("BasePart") then rootPart else nil

	if runtime.magicController ~= nil then
		runtime.magicController:setCharacter(character)
	end

	runtime.characterJanitor:GiveChore(character.ChildAdded:Connect(function(child: Instance)
		if child:IsA("Humanoid") then
			runtime.humanoid = child
		elseif child.Name == "HumanoidRootPart" and child:IsA("BasePart") then
			runtime.rootPart = child
		elseif child:IsA("Tool") then
			self:refreshEquippedWeaponFromInventory(player, runtime)
		end
	end))
	runtime.characterJanitor:GiveChore(character.ChildRemoved:Connect(function(child: Instance)
		if child == runtime.humanoid then
			runtime.humanoid = nil
		elseif child == runtime.rootPart then
			runtime.rootPart = nil
		elseif child:IsA("Tool") then
			self:refreshEquippedWeaponFromInventory(player, runtime)
		end
	end))

	self:refreshEquippedWeaponFromInventory(player, runtime)
end

function MagicServiceServer.BindBackpack(
	self: MagicServiceServer,
	player: Player,
	runtime: PlayerRuntime,
	backpack: Backpack
)
	runtime.playerJanitor:GiveChore(backpack.ChildAdded:Connect(function(child: Instance)
		if child:IsA("Tool") then
			self:refreshEquippedWeaponFromInventory(player, runtime)
		end
	end))
	runtime.playerJanitor:GiveChore(backpack.ChildRemoved:Connect(function(child: Instance)
		if child:IsA("Tool") then
			self:refreshEquippedWeaponFromInventory(player, runtime)
		end
	end))
end

function MagicServiceServer.CreateMagicController(self: MagicServiceServer, player: Player, runtime: PlayerRuntime)
	if runtime.magicController ~= nil then
		runtime.magicController:destroy()
	end
	local controller = Magic.new({
		ownerPlayer = player,
		character = runtime.character,
		service = self,
		expectedItemType = "magicWeapon",
		autoRepeatWhileHeld = false,
		allowQueueOnCooldown = true,
		validateDefinitionItemType = true,
	}) :: any
	runtime.magicController = controller
end

function MagicServiceServer.TrackPlayer(self: MagicServiceServer, player: Player)
	local runtime = self:getRuntime(player)
	runtime.playerJanitor:Clean()
	runtime.characterJanitor:Clean()
	runtime.character = nil
	runtime.humanoid = nil
	runtime.rootPart = nil
	runtime.inputHeld = false
	runtime.weaponCooldowns = {}
	runtime.pendingPreparedCast = nil
	runtime.pendingCastByToken = {}
	runtime.committedCastByToken = {}
	runtime.lastAimRequest = {
		trigger = "None",
		aimDirection = nil,
		aimPosition = nil,
	}
	runtime.lastAimDirection = Vector3.new(0, 0, -1)

	self:createMagicController(player, runtime)

	runtime.playerJanitor:GiveChore(player.CharacterAdded:Connect(function(character: Model)
		self:bindCharacter(player, runtime, character)
	end))
	runtime.playerJanitor:GiveChore(player.ChildAdded:Connect(function(child: Instance)
		if child:IsA("Backpack") then
			self:bindBackpack(player, runtime, child)
			self:refreshEquippedWeaponFromInventory(player, runtime)
		end
	end))

	if player.Character ~= nil then
		self:bindCharacter(player, runtime, player.Character)
	end
	local backpack = player:FindFirstChildOfClass("Backpack")
	if backpack ~= nil then
		self:bindBackpack(player, runtime, backpack)
	end
	self:pushState(player, runtime)
end

function MagicServiceServer.UntrackPlayer(self: MagicServiceServer, player: Player)
	local runtime = self.playerRuntimes[player]
	if runtime == nil then
		return
	end
	if runtime.magicController ~= nil then
		runtime.magicController:destroy()
		runtime.magicController = nil
	end
	runtime.playerJanitor:Destroy()
	runtime.characterJanitor:Destroy()
	self.playerRuntimes[player] = nil
end

function MagicServiceServer.RegisterModifierProvider(
	self: MagicServiceServer,
	providerNameRaw: any,
	callbackRaw: any
): boolean
	local providerName = trim(providerNameRaw)
	if providerName == "" or typeof(callbackRaw) ~= "function" then
		return false
	end
	self.modifierProviders[providerName] = callbackRaw
	return true
end

function MagicServiceServer.UnregisterModifierProvider(self: MagicServiceServer, providerNameRaw: any): boolean
	local providerName = trim(providerNameRaw)
	if providerName == "" then
		return false
	end
	if self.modifierProviders[providerName] == nil then
		return false
	end
	self.modifierProviders[providerName] = nil
	return true
end

function MagicServiceServer.RegisterWeaponDefinition(
	self: MagicServiceServer,
	itemIdRaw: any,
	definitionRaw: any
): boolean
	local itemId = trim(itemIdRaw)
	if itemId == "" or typeof(definitionRaw) ~= "table" then
		return false
	end
	if not looksLikeMagicDefinition(definitionRaw) then
		return false
	end
	self.definitionOverrides[itemId] = definitionRaw
	self.definitionOverrides[string.lower(itemId)] = definitionRaw
	return true
end

function MagicServiceServer.RegisterWeaponModule(self: MagicServiceServer, moduleScriptRaw: any): boolean
	if typeof(moduleScriptRaw) ~= "Instance" or not moduleScriptRaw:IsA("ModuleScript") then
		return false
	end
	local moduleScript = moduleScriptRaw :: ModuleScript
	local ok, moduleResultOrError = pcall(require, moduleScript)
	if not ok then
		if shouldSilenceModuleRequireError(moduleResultOrError) then
			return false
		end
		return false
	end
	if typeof(moduleResultOrError) ~= "table" then
		return false
	end
	local moduleResult = moduleResultOrError :: { [any]: any }
	local didRegister = false

	local function registerEntry(itemIdRaw: any, definitionRaw: any)
		local itemId = trim(itemIdRaw)
		if itemId == "" or typeof(definitionRaw) ~= "table" then
			return
		end
		if self:registerWeaponDefinition(itemId, definitionRaw) then
			didRegister = true
		end
	end

	registerEntry(moduleResult.itemId or moduleResult.id or moduleScript.Name, moduleResult)
	if typeof(moduleResult.definition) == "table" then
		registerEntry(
			(moduleResult.definition :: any).itemId or (moduleResult.definition :: any).id or moduleScript.Name,
			moduleResult.definition
		)
	end
	for key, value in moduleResult do
		if typeof(value) ~= "table" then
			continue
		end
		registerEntry((value :: any).itemId or (value :: any).id or key, value)
	end

	return didRegister
end

function MagicServiceServer.RegisterDefinitionsFromFolder(self: MagicServiceServer, folderRaw: any): number
	if typeof(folderRaw) ~= "Instance" or not folderRaw:IsA("Folder") then
		return 0
	end
	local registered = 0
	for _, child in (folderRaw :: Folder):GetChildren() do
		if child:IsA("ModuleScript") and self:registerWeaponModule(child) then
			registered += 1
		end
	end
	return registered
end

function MagicServiceServer.Init(self: MagicServiceServer)
	self.networker = Networker.server.new("MagicService", self, {
		self.RequestSync,
		self.RequestRefreshEquipped,
		self.RequestSetInputHeld,
		self.RequestCast,
	})
	self.inventoryService = InventoryServiceServer :: InventoryServiceServerObject
	self.manaService = ManaServiceServer :: ManaServiceServerObject
	self.npcService = NpcServiceServer :: NpcServiceServerObject
	self.bossService = BossServiceServer :: BossServiceServerObject
	self.hpService = HpServiceServer :: HpServiceServerObject
	self.playerRuntimes = {}
	self.projectilePools = {}
	self.activeProjectiles = {}
	self.activeEffectsByHumanoid = {}
	self.modifierProviders = {}
	self.definitionOverrides = {}
	self.nextProjectileId = 0
	self.fixedStepAccumulator = 0
	self.projectileFolder = MagicServiceUtils.ensureProjectileFolder()
	self.binders = NevermoreSupport.getService(ServerBinderSupport)

	local gameRoot = script:FindFirstAncestor("game")
	local sharedRoot = if gameRoot ~= nil then gameRoot:FindFirstChild("Shared") else nil
	local modulesRoot = if sharedRoot ~= nil then sharedRoot:FindFirstChild("Modules") else nil
	if modulesRoot ~= nil and modulesRoot:IsA("Folder") then
		local itemsFolder = modulesRoot:FindFirstChild("Items")
		if itemsFolder ~= nil and itemsFolder:IsA("Folder") then
			self:registerDefinitionsFromFolder(itemsFolder)
		end

		local gameFolder = modulesRoot:FindFirstChild("Game")
		if gameFolder ~= nil and gameFolder:IsA("Folder") then
			local magicFolder = gameFolder:FindFirstChild("MagicWeapons")
			if magicFolder ~= nil and magicFolder:IsA("Folder") then
				self:registerDefinitionsFromFolder(magicFolder)
			end
		end
	end

	for _, player in Players:GetPlayers() do
		if PlayerServiceServer:isGameplayActiveForPlayer(player) then
			self:trackPlayer(player)
		end
	end
	self.playerAddedConnection = Players.PlayerAdded:Connect(function(player: Player)
		if PlayerServiceServer:isGameplayActiveForPlayer(player) then
			self:trackPlayer(player)
		end
	end)
	self.playerRemovingConnection = Players.PlayerRemoving:Connect(function(player: Player)
		self:untrackPlayer(player)
	end)
	self.heartbeatConnection = RunService.Heartbeat:Connect(function(dt: number)
		self:onHeartbeat(dt)
	end)
end

function MagicServiceServer.Destroy(self: MagicServiceServer)
	if self.playerAddedConnection ~= nil then
		self.playerAddedConnection:Disconnect()
		self.playerAddedConnection = nil
	end
	if self.playerRemovingConnection ~= nil then
		self.playerRemovingConnection:Disconnect()
		self.playerRemovingConnection = nil
	end
	if self.heartbeatConnection ~= nil then
		self.heartbeatConnection:Disconnect()
		self.heartbeatConnection = nil
	end

	for player in self.playerRuntimes do
		self:untrackPlayer(player)
	end

	for _, pool in self.projectilePools do
		for _, entry in pool do
			if entry.part.Parent ~= nil then
				entry.part:Destroy()
			end
		end
	end
	self.projectilePools = {}
	self.activeProjectiles = {}

	if self.networker ~= nil then
		self.networker:destroy()
	end
end

MagicServiceServer.createRuntime = MagicServiceServer.CreateRuntime
MagicServiceServer.getRuntime = MagicServiceServer.GetRuntime
MagicServiceServer.resolveRuntimeByMagic = MagicServiceServer.ResolveRuntimeByMagic
MagicServiceServer.resolveManaStateSnapshot = MagicServiceServer.ResolveManaStateSnapshot
MagicServiceServer.pushState = MagicServiceServer.PushState
MagicServiceServer.getEquippedMagicToolFromInventory = MagicServiceServer.GetEquippedMagicToolFromInventory
MagicServiceServer.refreshEquippedWeaponFromInventory = MagicServiceServer.RefreshEquippedWeaponFromInventory
MagicServiceServer.getDefinitionOverride = MagicServiceServer.GetDefinitionOverride
MagicServiceServer.buildRuntimeConfigWithOverrides = MagicServiceServer.BuildRuntimeConfigWithOverrides
MagicServiceServer.collectCastModifiers = MagicServiceServer.CollectCastModifiers
MagicServiceServer.prepareControllerStatsForCast = MagicServiceServer.PrepareControllerStatsForCast
MagicServiceServer.onMagicCastRequested = MagicServiceServer.OnMagicCastRequested
MagicServiceServer.canConsumeMana = MagicServiceServer.CanConsumeMana
MagicServiceServer.consumeMana = MagicServiceServer.ConsumeMana
MagicServiceServer.requestSync = MagicServiceServer.RequestSync
MagicServiceServer.requestRefreshEquipped = MagicServiceServer.RequestRefreshEquipped
MagicServiceServer.requestSetInputHeld = MagicServiceServer.RequestSetInputHeld
