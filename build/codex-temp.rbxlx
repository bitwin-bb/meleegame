                <Item class="ModuleScript" referent="771">
                  <Properties>
                    <string name="Name">BillboardCard</string>
                    <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local FloatingCard = require(script.Parent.FloatingCard)
local React = require(ReplicatedStorage.Packages.React)
local ReactRoblox = require(ReplicatedStorage.Packages.ReactRoblox)

export type BillboardCardProps = {
	adornee: Instance?,
	enabled: boolean?,
	visible: boolean?,
	active: boolean?,
	alwaysOnTop: boolean?,
	maxDistance: number?,
	lightInfluence: number?,
	studsOffset: Vector3?,
	studsOffsetWorldSpace: Vector3?,
	extentsOffset: Vector3?,
	size: UDim2?,
	zIndex: number?,
	zIndexBehavior: Enum.ZIndexBehavior?,
	resetOnSpawn: boolean?,
	clipsDescendants: boolean?,
	playerToHideFrom: Player?,
	portalTarget: Instance?,
	disablePortal: boolean?,
	cardSize: UDim2?,
	cardPosition: UDim2?,
	cardAnchorPoint: Vector2?,
	title: string?,
	subtitle: string?,
	body: string?,
	icon: string?,
	nativeBillboard: { [any]: any }?,
	nativeCard: { [any]: any }?,
	cardVisible: boolean?,
	children: { React.ReactNode }?,
}

local e: typeof(React.createElement) = React.createElement

local DEFAULT_SIZE = UDim2.fromOffset(260, 112)
local DEFAULT_CARD_SIZE = UDim2.fromOffset(220, 72)
local DEFAULT_STUDS_OFFSET = Vector3.new(0, 3, 0)

local function sanitizeNumber(valueRaw: any, fallback: number, minimum: number?, maximum: number?): number
	local value = if typeof(valueRaw) == "number" and valueRaw == valueRaw then valueRaw else fallback
	if minimum ~= nil and value < minimum then
		value = minimum
	end
	if maximum ~= nil and value > maximum then
		value = maximum
	end
	return value
end

local function sanitizeVector3(valueRaw: any, fallback: Vector3): Vector3
	return if typeof(valueRaw) == "Vector3" then valueRaw else fallback
end

local function applyNativeProps(target: { [any]: any }, nativeProps: { [any]: any }?)
	if nativeProps == nil then
		return
	end

	for key, value in nativeProps do
		target[key] = value
	end
end

local function resolvePortalTarget(props: BillboardCardProps): Instance?
	if props.disablePortal == true then
		return nil
	end
	if props.portalTarget ~= nil then
		return props.portalTarget
	end

	local localPlayer = Players.LocalPlayer
	if localPlayer == nil then
		return nil
	end

	local playerGui = localPlayer:FindFirstChildOfClass("PlayerGui")
	return playerGui
end

return function(props: BillboardCardProps): React.ReactNode
	if props.visible == false then
		return nil
	end

	local zIndex = props.zIndex or 30
	local billboardProps: { [any]: any } = {
		Adornee = props.adornee,
		Enabled = props.enabled ~= false,
		Active = props.active == true,
		AlwaysOnTop = props.alwaysOnTop ~= false,
		MaxDistance = sanitizeNumber(props.maxDistance, 130, 0, 20000),
		LightInfluence = sanitizeNumber(props.lightInfluence, 0, 0, 1),
		StudsOffset = sanitizeVector3(props.studsOffset, DEFAULT_STUDS_OFFSET),
		StudsOffsetWorldSpace = sanitizeVector3(props.studsOffsetWorldSpace, Vector3.zero),
		ExtentsOffset = sanitizeVector3(props.extentsOffset, Vector3.zero),
		Size = props.size or DEFAULT_SIZE,
		ResetOnSpawn = props.resetOnSpawn == true,
		ClipsDescendants = props.clipsDescendants == true,
		PlayerToHideFrom = props.playerToHideFrom,
		ZIndexBehavior = props.zIndexBehavior or Enum.ZIndexBehavior.Sibling,
	}
	applyNativeProps(billboardProps, props.nativeBillboard)

	local billboardChildren: { React.ReactNode } = {}
	if props.cardVisible == false then
		if props.children ~= nil then
			for key, child in props.children do
				billboardChildren[key] = child
			end
		end
	else
		billboardChildren.Card = e(FloatingCard, {
			size = props.cardSize or DEFAULT_CARD_SIZE,
			position = props.cardPosition or UDim2.fromScale(0.5, 1),
			anchorPoint = props.cardAnchorPoint or Vector2.new(0.5, 1),
			title = props.title,
			subtitle = props.subtitle,
			body = props.body,
			icon = props.icon,
			zIndex = zIndex,
			native = props.nativeCard,
			children = props.children,
		})
	end

	local element = e("BillboardGui", billboardProps, billboardChildren)

	local portalTarget = resolvePortalTarget(props)
	if portalTarget ~= nil then
		return ReactRoblox.createPortal(element, portalTarget)
	end

	return element
end
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="772">
                  <Properties>
                    <string name="Name">DropsInfo</string>
                    <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Janitor = require(ReplicatedStorage.Packages.Janitor)
local RarityPill = require(script.Parent.RarityPill)
local React = require(ReplicatedStorage.Packages.React)
local ReactRoblox = require(ReplicatedStorage.Packages.ReactRoblox)
local formatNumber = require(script:FindFirstAncestor("game").Client.UI.core.utils.formatNumber)

local e: typeof(React.createElement) = React.createElement

export type DropsInfoRarity = RarityPill.Rarity

export type DropsInfoTheme = {
	backgroundColor: Color3?,
	backgroundTransparency: number?,
	strokeColor: Color3?,
	strokeTransparency: number?,
	accentColor: Color3?,
	titleColor: Color3?,
	titleTransparency: number?,
	subtitleColor: Color3?,
	subtitleTransparency: number?,
	descriptionColor: Color3?,
	descriptionTransparency: number?,
	amountColor: Color3?,
	amountTransparency: number?,
	iconColor: Color3?,
	iconTransparency: number?,
	glowColor: Color3?,
	gradientColor: ColorSequence?,
	gradientTransparency: NumberSequence?,
}

export type DropsInfoProps = {
	adornee: Instance?,
	portalTarget: Instance?,
	disablePortal: boolean?,
	playerToHideFrom: Player?,
	enabled: boolean?,
	visible: boolean?,
	active: boolean?,
	alwaysOnTop: boolean?,
	resetOnSpawn: boolean?,
	clipsDescendants: boolean?,
	zIndexBehavior: Enum.ZIndexBehavior?,
	displayOrder: number?,
	zIndex: number?,
	billboardSize: UDim2?,
	maxDistance: number?,
	lightInfluence: number?,
	studsOffset: Vector3?,
	studsOffsetWorldSpace: Vector3?,
	extentsOffset: Vector3?,
	cardSize: UDim2?,
	cardAutomaticSize: Enum.AutomaticSize?,
	cardPosition: UDim2?,
	cardAnchorPoint: Vector2?,
	cardCornerRadius: UDim?,
	cardPadding: UDim?,
	contentPadding: UDim?,
	strokeThickness: number?,
	icon: string?,
	iconSize: UDim2?,
	title: string?,
	subtitle: string?,
	description: string?,
	amount: number?,
	amountText: string?,
	amountPrefix: string?,
	rarity: DropsInfoRarity?,
	showIcon: boolean?,
	showAmount: boolean?,
	showRarityPill: boolean?,
	textOnly: boolean?,
	theme: DropsInfoTheme?,
	titleFont: Enum.Font?,
	subtitleFont: Enum.Font?,
	descriptionFont: Enum.Font?,
	amountFont: Enum.Font?,
	titleTextSize: number?,
	subtitleTextSize: number?,
	descriptionTextSize: number?,
	amountTextSize: number?,
	animationEnabled: boolean?,
	paused: boolean?,
	lifetime: number?,
	fadeInTime: number?,
	fadeOutTime: number?,
	floatAmplitude: number?,
	floatSpeed: number?,
	pulseScaleAmplitude: number?,
	pulseSpeed: number?,
	gradientEnabled: boolean?,
	gradientScrollSpeed: number?,
	removeOnExpire: boolean?,
	eventToken: any?,
	onExpire: (() -> ())?,
	onAnimationStep: ((elapsed: number, alpha: number) -> ())?,
	nativeBillboard: { [string]: any }?,
	nativeCard: { [string]: any }?,
	nativeTitle: { [string]: any }?,
	nativeSubtitle: { [string]: any }?,
	nativeDescription: { [string]: any }?,
	nativeAmount: { [string]: any }?,
	nativeIcon: { [string]: any }?,
	children: { React.ReactNode }?,
}

type JanitorClass = {
	GiveChore: (self: JanitorClass, chore: any, ...any) -> (),
	Destroy: (self: JanitorClass) -> (),
}

type DropsInfoState = {
	expired: boolean,
}

local DEFAULT_BILLBOARD_SIZE = UDim2.fromOffset(320, 124)
local DEFAULT_CARD_SIZE = UDim2.fromOffset(268, 72)
local DEFAULT_CARD_POSITION = UDim2.fromScale(0.5, 1)
local DEFAULT_CARD_ANCHOR_POINT = Vector2.new(0.5, 1)
local DEFAULT_STUDS_OFFSET = Vector3.new(0, 3.1, 0)
local DEFAULT_EXTENTS_OFFSET = Vector3.new(0, 0, 0)
local DEFAULT_STUDS_OFFSET_WORLD = Vector3.new(0, 0, 0)
local DEFAULT_MAX_DISTANCE = 130
local DEFAULT_LIGHT_INFLUENCE = 0
local DEFAULT_FADE_IN_TIME = 0.16
local DEFAULT_FADE_OUT_TIME = 0.22
local DEFAULT_LIFETIME = 2.6
local DEFAULT_FLOAT_AMPLITUDE = 2.8
local DEFAULT_FLOAT_SPEED = 1.2
local DEFAULT_PULSE_AMPLITUDE = 0.035
local DEFAULT_PULSE_SPEED = 2.1
local DEFAULT_GRADIENT_SCROLL_SPEED = 2.2
local DEFAULT_STROKE_THICKNESS = 1.3
local DEFAULT_CORNER_RADIUS = UDim.new(0, 11)
local DEFAULT_CARD_PADDING = UDim.new(0, 10)
local DEFAULT_CONTENT_PADDING = UDim.new(0, 10)

local DEFAULT_THEME = {
	backgroundColor = Color3.fromRGB(16, 20, 29),
	backgroundTransparency = 0.2,
	strokeColor = Color3.fromRGB(100, 119, 148),
	strokeTransparency = 0.22,
	accentColor = Color3.fromRGB(88, 198, 255),
	titleColor = Color3.fromRGB(246, 249, 255),
	titleTransparency = 0,
	subtitleColor = Color3.fromRGB(188, 203, 224),
	subtitleTransparency = 0.04,
	descriptionColor = Color3.fromRGB(164, 179, 205),
	descriptionTransparency = 0.08,
	amountColor = Color3.fromRGB(255, 255, 255),
	amountTransparency = 0,
	iconColor = Color3.fromRGB(235, 244, 255),
	iconTransparency = 0,
	glowColor = Color3.fromRGB(132, 208, 255),
	gradientColor = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(13, 17, 24)),
		ColorSequenceKeypoint.new(0.55, Color3.fromRGB(29, 38, 55)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(16, 20, 29)),
	}),
	gradientTransparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.06),
		NumberSequenceKeypoint.new(1, 0.16),
	}),
}

local function sanitizeNumber(value: any, fallback: number, minimum: number?, maximum: number?): number
	if typeof(value) ~= "number" or value ~= value then
		return fallback
	end

	local nextValue = value
	if minimum ~= nil and nextValue < minimum then
		nextValue = minimum
	end
	if maximum ~= nil and nextValue > maximum then
		nextValue = maximum
	end
	return nextValue
end

local function sanitizeColor(value: any, fallback: Color3): Color3
	if typeof(value) ~= "Color3" then
		return fallback
	end
	return value
end

local function sanitizeVector3(value: any, fallback: Vector3): Vector3
	if typeof(value) ~= "Vector3" then
		return fallback
	end
	if value.X ~= value.X or value.Y ~= value.Y or value.Z ~= value.Z then
		return fallback
	end
	return value
end

local function sanitizeTransparency(value: any, fallback: number): number
	return sanitizeNumber(value, fallback, 0, 1)
end

local function sanitizeString(value: any, fallback: string): string
	if typeof(value) ~= "string" then
		return fallback
	end
	return value
end

local function withAlpha(baseTransparency: number, alpha: number): number
	local safeBase = math.clamp(baseTransparency, 0, 1)
	local safeAlpha = math.clamp(alpha, 0, 1)
	return 1 - ((1 - safeBase) * safeAlpha)
end

local function resolveRarityColor(rarity: DropsInfoRarity?): Color3?
	if rarity == nil then
		return nil
	end
	return RarityPill.ResolveColor(rarity, nil)
end

local function applyNativeProps(targetProps: { [string]: any }, nativeProps: { [string]: any }?)
	if nativeProps == nil then
		return
	end

	for index, value in nativeProps do
		targetProps[index] = value
	end
end

local function resolveAmountText(props: DropsInfoProps): string?
	if props.amountText ~= nil and props.amountText ~= "" then
		return props.amountText
	end

	if typeof(props.amount) == "number" then
		local amountPrefix = sanitizeString(props.amountPrefix, "+")
		local amountValue = math.floor(props.amount)
		return amountPrefix .. formatNumber(amountValue)
	end

	return nil
end

local DropsInfo = React.Component:extend("DropsInfo")

function DropsInfo:init()
	self.state = {
		expired = false,
	} :: DropsInfoState

	self.janitor = Janitor.new() :: JanitorClass
	self.elapsed = 0
	self.didExpire = false

	self.alphaBinding, self.setAlphaBinding = React.createBinding(0)
	self.scaleBinding, self.setScaleBinding = React.createBinding(1)
	self.floatOffsetBinding, self.setFloatOffsetBinding = React.createBinding(0)
	self.gradientOffsetBinding, self.setGradientOffsetBinding = React.createBinding(Vector2.new(0, 0))
	self.glowTransparencyBinding, self.setGlowTransparencyBinding = React.createBinding(1)

	self:resetAnimation(false)
end

function DropsInfo:didMount()
	local connection = RunService.RenderStepped:Connect(function(deltaTime: number)
		self:stepAnimation(deltaTime)
	end)
	self.janitor:GiveChore(connection)
end

function DropsInfo:willUnmount()
	self.janitor:Destroy()
end

function DropsInfo:didUpdate(previousProps: DropsInfoProps)
	if previousProps.eventToken ~= self.props.eventToken then
		self:resetAnimation(true)
	end

	if previousProps.visible == false and self.props.visible ~= false then
		self:resetAnimation(true)
	end

	if previousProps.paused == true and self.props.paused ~= true and self.state.expired then
		self:resetAnimation(true)
	end
end

function DropsInfo:ResetAnimation(clearExpiredState: boolean)
	self.elapsed = 0
	self.didExpire = false

	local animationEnabled = self.props.animationEnabled ~= false
	self.setAlphaBinding(if animationEnabled then 0 else 1)
	self.setScaleBinding(1)
	self.setFloatOffsetBinding(0)
	self.setGradientOffsetBinding(Vector2.new(0, 0))
	self.setGlowTransparencyBinding(1)

	if clearExpiredState and self.state.expired then
		self:setState({
			expired = false,
		})
	end
end

function DropsInfo:StepAnimation(deltaTime: number)
	if self.state.expired then
		return
	end

	local props: DropsInfoProps = self.props
	if props.visible == false or props.paused == true then
		return
	end

	self.elapsed += deltaTime

	local animationEnabled = props.animationEnabled ~= false
	local fadeInTime = sanitizeNumber(props.fadeInTime, DEFAULT_FADE_IN_TIME, 0, 10)
	local fadeOutTime = sanitizeNumber(props.fadeOutTime, DEFAULT_FADE_OUT_TIME, 0, 10)
	local lifetime = sanitizeNumber(props.lifetime, DEFAULT_LIFETIME, 0, 600)

	local alpha = 1
	if animationEnabled and fadeInTime > 0 then
		alpha = math.min(alpha, self.elapsed / fadeInTime)
	end

	if lifetime > 0 and fadeOutTime > 0 then
		local fadeOutStart = math.max(0, lifetime - fadeOutTime)
		if self.elapsed >= fadeOutStart then
			local fadeOutAlpha = 1 - ((self.elapsed - fadeOutStart) / fadeOutTime)
			alpha = math.min(alpha, fadeOutAlpha)
		end
	end
	alpha = math.clamp(alpha, 0, 1)

	self.setAlphaBinding(alpha)

	if animationEnabled then
		local floatAmplitude = sanitizeNumber(props.floatAmplitude, DEFAULT_FLOAT_AMPLITUDE, 0, 60)
		local floatSpeed = sanitizeNumber(props.floatSpeed, DEFAULT_FLOAT_SPEED, 0, 15)
		local pulseAmplitude = sanitizeNumber(props.pulseScaleAmplitude, DEFAULT_PULSE_AMPLITUDE, 0, 0.45)
		local pulseSpeed = sanitizeNumber(props.pulseSpeed, DEFAULT_PULSE_SPEED, 0, 24)
		local gradientScrollSpeed = sanitizeNumber(props.gradientScrollSpeed, DEFAULT_GRADIENT_SCROLL_SPEED, 0, 16)

		local wave = math.sin(self.elapsed * floatSpeed * math.pi * 2)
		self.setFloatOffsetBinding(-wave * floatAmplitude)

		local pulseWave = math.sin(self.elapsed * pulseSpeed * math.pi * 2)
		self.setScaleBinding(1 + (pulseWave * pulseAmplitude * alpha))

		local offsetWave = math.sin(self.elapsed * gradientScrollSpeed)
		self.setGradientOffsetBinding(Vector2.new(offsetWave * 0.34, 0))

		local glowWave = (math.sin(self.elapsed * 8.5) + 1) * 0.5
		local glowTransparency = 1 - ((0.12 + glowWave * 0.18) * alpha)
		self.setGlowTransparencyBinding(math.clamp(glowTransparency, 0, 1))
	else
		self.setFloatOffsetBinding(0)
		self.setScaleBinding(1)
		self.setGradientOffsetBinding(Vector2.new(0, 0))
		self.setGlowTransparencyBinding(withAlpha(0.8, alpha))
	end

	if props.onAnimationStep then
		props.onAnimationStep(self.elapsed, alpha)
	end

	if lifetime > 0 and self.elapsed >= lifetime and not self.didExpire then
		self.didExpire = true

		if props.onExpire then
			props.onExpire()
		end

		if props.removeOnExpire ~= false then
			self:setState({
				expired = true,
			})
		end
	end
end

function DropsInfo:ResolvePortalTarget(): Instance?
	if self.props.disablePortal == true then
		return nil
	end

	if self.props.portalTarget ~= nil then
		return self.props.portalTarget
	end

	local localPlayer = Players.LocalPlayer
	if localPlayer == nil then
		return nil
	end

	local playerGui = localPlayer:FindFirstChildOfClass("PlayerGui")
	if playerGui and playerGui:IsA("PlayerGui") then
		return playerGui
	end

	return nil
end

function DropsInfo:render()
	local props: DropsInfoProps = self.props
	if props.visible == false or self.state.expired then
		return nil
	end

	local rarityColor = resolveRarityColor(props.rarity)
	local theme = props.theme or {}

	local accentColor = sanitizeColor(theme.accentColor, rarityColor or DEFAULT_THEME.accentColor)
	local backgroundColor = sanitizeColor(theme.backgroundColor, DEFAULT_THEME.backgroundColor)
	local backgroundTransparency =
		sanitizeTransparency(theme.backgroundTransparency, DEFAULT_THEME.backgroundTransparency)
	local strokeColor = sanitizeColor(theme.strokeColor, accentColor:Lerp(DEFAULT_THEME.strokeColor, 0.4))
	local strokeTransparency = sanitizeTransparency(theme.strokeTransparency, DEFAULT_THEME.strokeTransparency)
	local titleColor = sanitizeColor(theme.titleColor, accentColor:Lerp(DEFAULT_THEME.titleColor, 0.9))
	local titleTransparency = sanitizeTransparency(theme.titleTransparency, DEFAULT_THEME.titleTransparency)
	local subtitleColor = sanitizeColor(theme.subtitleColor, DEFAULT_THEME.subtitleColor)
	local subtitleTransparency = sanitizeTransparency(theme.subtitleTransparency, DEFAULT_THEME.subtitleTransparency)
	local descriptionColor = sanitizeColor(theme.descriptionColor, DEFAULT_THEME.descriptionColor)
	local descriptionTransparency =
		sanitizeTransparency(theme.descriptionTransparency, DEFAULT_THEME.descriptionTransparency)
	local amountColor = sanitizeColor(theme.amountColor, DEFAULT_THEME.amountColor)
	local amountTransparency = sanitizeTransparency(theme.amountTransparency, DEFAULT_THEME.amountTransparency)
	local iconColor = sanitizeColor(theme.iconColor, DEFAULT_THEME.iconColor)
	local iconTransparency = sanitizeTransparency(theme.iconTransparency, DEFAULT_THEME.iconTransparency)
	local glowColor = sanitizeColor(theme.glowColor, accentColor)
	local gradientColor = if theme.gradientColor ~= nil then theme.gradientColor else DEFAULT_THEME.gradientColor
	local gradientTransparency = if theme.gradientTransparency ~= nil
		then theme.gradientTransparency
		else DEFAULT_THEME.gradientTransparency

	local showIcon = props.showIcon ~= false and props.icon ~= nil and props.icon ~= ""
	local amountText = resolveAmountText(props)
	local showAmount = props.showAmount ~= false and amountText ~= nil
	local showRarityPill = props.showRarityPill == true and props.rarity ~= nil
	local showSubtitle = props.subtitle ~= nil and props.subtitle ~= ""
	local showDescription = props.description ~= nil and props.description ~= ""
	local useGradient = props.gradientEnabled ~= false
	local useTextOnly = props.textOnly == true

	local zIndex = if typeof(props.zIndex) == "number" then props.zIndex else 30
	local rootPosition = props.cardPosition or DEFAULT_CARD_POSITION
	local rootAnchorPoint = props.cardAnchorPoint or DEFAULT_CARD_ANCHOR_POINT

	if useTextOnly then
		local textValue = sanitizeString(props.title, "")
		if textValue == "" then
			textValue = sanitizeString(props.subtitle, "")
		end
		if textValue == "" then
			textValue = sanitizeString(props.description, "")
		end
		if textValue == "" and amountText ~= nil then
			textValue = amountText
		end
		if textValue == "" then
			textValue = " "
		end

		local textPositionBinding = self.floatOffsetBinding:map(function(offsetY: number)
			return UDim2.new(
				rootPosition.X.Scale,
				rootPosition.X.Offset,
				rootPosition.Y.Scale,
				rootPosition.Y.Offset + math.floor(offsetY)
			)
		end)
		local textTransparencyBinding = self.alphaBinding:map(function(alpha: number)
			return withAlpha(titleTransparency, alpha)
		end)
		local textStrokeTransparencyBinding = self.alphaBinding:map(function(alpha: number)
			local strokeBaseTransparency = math.clamp(0.28 + titleTransparency * 0.72, 0, 1)
			return withAlpha(strokeBaseTransparency, alpha)
		end)

		local billboardProps: { [string]: any } = {
			Enabled = props.enabled ~= false,
			Active = props.active == true,
			Adornee = props.adornee,
			AlwaysOnTop = props.alwaysOnTop ~= false,
			PlayerToHideFrom = props.playerToHideFrom,
			ResetOnSpawn = props.resetOnSpawn == true,
			ClipsDescendants = props.clipsDescendants == true,
			ZIndexBehavior = props.zIndexBehavior or Enum.ZIndexBehavior.Sibling,
			Size = props.billboardSize or DEFAULT_BILLBOARD_SIZE,
			MaxDistance = sanitizeNumber(props.maxDistance, DEFAULT_MAX_DISTANCE, 0, 20000),
			LightInfluence = sanitizeNumber(props.lightInfluence, DEFAULT_LIGHT_INFLUENCE, 0, 1),
			StudsOffset = sanitizeVector3(props.studsOffset, DEFAULT_STUDS_OFFSET),
			StudsOffsetWorldSpace = sanitizeVector3(props.studsOffsetWorldSpace, DEFAULT_STUDS_OFFSET_WORLD),
			ExtentsOffset = sanitizeVector3(props.extentsOffset, DEFAULT_EXTENTS_OFFSET),
		}
		applyNativeProps(billboardProps, props.nativeBillboard)

		local billboardElement = e("BillboardGui", billboardProps, {
			e("Frame", {
				AutomaticSize = Enum.AutomaticSize.XY,
				Size = UDim2.fromOffset(0, 0),
				Position = textPositionBinding,
				AnchorPoint = rootAnchorPoint,
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				ZIndex = zIndex + 1,
			}, {
				e("UIScale", {
					Scale = self.scaleBinding,
				}),
				e("TextLabel", {
					AutomaticSize = Enum.AutomaticSize.XY,
					Size = UDim2.fromOffset(0, 0),
					BackgroundTransparency = 1,
					BorderSizePixel = 0,
					Font = props.titleFont or Enum.Font.GothamBlack,
					Text = textValue,
					TextColor3 = titleColor,
					TextSize = sanitizeNumber(props.titleTextSize, 28, 8, 80),
					TextTransparency = textTransparencyBinding,
					TextStrokeColor3 = Color3.fromRGB(0, 0, 0),
					TextStrokeTransparency = textStrokeTransparencyBinding,
					TextXAlignment = Enum.TextXAlignment.Center,
					TextYAlignment = Enum.TextYAlignment.Center,
					TextWrapped = false,
					ZIndex = zIndex + 3,
				}),
			}),
		})

		local portalTarget = self:resolvePortalTarget()
		if portalTarget ~= nil then
			return ReactRoblox.createPortal(billboardElement, portalTarget)
		end

		return billboardElement
	end

	local cardPositionBinding = self.floatOffsetBinding:map(function(offsetY: number)
		return UDim2.new(
			rootPosition.X.Scale,
			rootPosition.X.Offset,
			rootPosition.Y.Scale,
			rootPosition.Y.Offset + math.floor(offsetY)
		)
	end)

	local cardBackgroundTransparencyBinding = self.alphaBinding:map(function(alpha: number)
		return withAlpha(backgroundTransparency, alpha)
	end)
	local cardStrokeTransparencyBinding = self.alphaBinding:map(function(alpha: number)
		return withAlpha(strokeTransparency, alpha)
	end)
	local titleTransparencyBinding = self.alphaBinding:map(function(alpha: number)
		return withAlpha(titleTransparency, alpha)
	end)
	local subtitleTransparencyBinding = self.alphaBinding:map(function(alpha: number)
		return withAlpha(subtitleTransparency, alpha)
	end)
	local descriptionTransparencyBinding = self.alphaBinding:map(function(alpha: number)
		return withAlpha(descriptionTransparency, alpha)
	end)
	local amountTransparencyBinding = self.alphaBinding:map(function(alpha: number)
		return withAlpha(amountTransparency, alpha)
	end)
	local iconTransparencyBinding = self.alphaBinding:map(function(alpha: number)
		return withAlpha(iconTransparency, alpha)
	end)
	local rarityPillTransparencyBinding = self.alphaBinding:map(function(alpha: number)
		return withAlpha(0.2, alpha)
	end)
	local rarityTextTransparencyBinding = self.alphaBinding:map(function(alpha: number)
		return withAlpha(0.02, alpha)
	end)
	local cardShadowTransparencyBinding = self.alphaBinding:map(function(alpha: number)
		return withAlpha(0.36, alpha)
	end)

	local cardProps: { [string]: any } = {
		Size = props.cardSize or DEFAULT_CARD_SIZE,
		AutomaticSize = props.cardAutomaticSize or Enum.AutomaticSize.None,
		Position = cardPositionBinding,
		AnchorPoint = rootAnchorPoint,
		BackgroundColor3 = backgroundColor,
		BackgroundTransparency = cardBackgroundTransparencyBinding,
		BorderSizePixel = 0,
		ZIndex = zIndex + 1,
	}
	applyNativeProps(cardProps, props.nativeCard)

	local titleProps: { [string]: any } = {
		Size = UDim2.new(1, 0, 0, 21),
		BackgroundTransparency = 1,
		Font = props.titleFont or Enum.Font.GothamBold,
		Text = props.title or "Picked Up",
		TextColor3 = titleColor,
		TextSize = sanitizeNumber(props.titleTextSize, 17, 8, 48),
		TextTransparency = titleTransparencyBinding,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		TextWrapped = false,
		TextTruncate = Enum.TextTruncate.AtEnd,
		ZIndex = zIndex + 4,
	}
	applyNativeProps(titleProps, props.nativeTitle)

	local subtitleProps: { [string]: any } = {
		Size = UDim2.new(1, 0, 0, 18),
		BackgroundTransparency = 1,
		Font = props.subtitleFont or Enum.Font.GothamMedium,
		Text = props.subtitle or "",
		TextColor3 = subtitleColor,
		TextSize = sanitizeNumber(props.subtitleTextSize, 14, 8, 38),
		TextTransparency = subtitleTransparencyBinding,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		TextWrapped = false,
		TextTruncate = Enum.TextTruncate.AtEnd,
		ZIndex = zIndex + 4,
	}
	applyNativeProps(subtitleProps, props.nativeSubtitle)

	local descriptionProps: { [string]: any } = {
		Size = UDim2.new(1, 0, 0, 16),
		BackgroundTransparency = 1,
		Font = props.descriptionFont or Enum.Font.Gotham,
		Text = props.description or "",
		TextColor3 = descriptionColor,
		TextSize = sanitizeNumber(props.descriptionTextSize, 12, 8, 34),
		TextTransparency = descriptionTransparencyBinding,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		TextWrapped = false,
		TextTruncate = Enum.TextTruncate.AtEnd,
		ZIndex = zIndex + 4,
	}
	applyNativeProps(descriptionProps, props.nativeDescription)

	local amountProps: { [string]: any } = {
		AutomaticSize = Enum.AutomaticSize.XY,
		BackgroundColor3 = accentColor,
		BackgroundTransparency = amountTransparencyBinding,
		BorderSizePixel = 0,
		Position = UDim2.new(1, -6, 0, -4),
		AnchorPoint = Vector2.new(1, 0),
		Font = props.amountFont or Enum.Font.GothamBlack,
		Text = amountText or "",
		TextColor3 = amountColor,
		TextSize = sanitizeNumber(props.amountTextSize, 14, 8, 36),
		TextWrapped = false,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextYAlignment = Enum.TextYAlignment.Center,
		ZIndex = zIndex + 5,
	}
	applyNativeProps(amountProps, props.nativeAmount)

	local iconProps: { [string]: any } = {
		Size = props.iconSize or UDim2.fromOffset(28, 28),
		BackgroundTransparency = 1,
		Image = props.icon or "",
		ImageColor3 = iconColor,
		ImageTransparency = iconTransparencyBinding,
		ZIndex = zIndex + 4,
	}
	applyNativeProps(iconProps, props.nativeIcon)

	local cardChildren: { React.ReactNode } = {
		e("UIScale", {
			Scale = self.scaleBinding,
		}),
		e("UICorner", {
			CornerRadius = props.cardCornerRadius or DEFAULT_CORNER_RADIUS,
		}),
		e("UIStroke", {
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
			Color = strokeColor,
			Thickness = sanitizeNumber(props.strokeThickness, DEFAULT_STROKE_THICKNESS, 0, 8),
			Transparency = cardStrokeTransparencyBinding,
		}),
		e("Frame", {
			Size = UDim2.fromScale(1, 1),
			Position = UDim2.fromOffset(0, 2),
			BackgroundColor3 = Color3.fromRGB(0, 0, 0),
			BackgroundTransparency = cardShadowTransparencyBinding,
			BorderSizePixel = 0,
			ZIndex = zIndex,
		}, {
			e("UICorner", {
				CornerRadius = props.cardCornerRadius or DEFAULT_CORNER_RADIUS,
			}),
		}),
		e("UIPadding", {
			PaddingTop = props.cardPadding or DEFAULT_CARD_PADDING,
			PaddingBottom = props.cardPadding or DEFAULT_CARD_PADDING,
			PaddingLeft = props.cardPadding or DEFAULT_CARD_PADDING,
			PaddingRight = props.cardPadding or DEFAULT_CARD_PADDING,
		}),
		e("Frame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			ZIndex = zIndex + 3,
		}, {
			e("UIListLayout", {
				FillDirection = Enum.FillDirection.Horizontal,
				VerticalAlignment = Enum.VerticalAlignment.Top,
				HorizontalAlignment = Enum.HorizontalAlignment.Left,
				Padding = props.contentPadding or DEFAULT_CONTENT_PADDING,
			}),
			if showIcon
				then e("Frame", {
					AutomaticSize = Enum.AutomaticSize.XY,
					BackgroundTransparency = 1,
					LayoutOrder = 1,
					ZIndex = zIndex + 3,
				}, {
					e("ImageLabel", iconProps),
					e("UIStroke", {
						ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
						Color = glowColor,
						Thickness = 1.1,
						Transparency = self.glowTransparencyBinding,
					}),
				})
				else nil,
			e("Frame", {
				AutomaticSize = Enum.AutomaticSize.Y,
				Size = UDim2.new(1, if showIcon then -32 else 0, 0, 0),
				BackgroundTransparency = 1,
				LayoutOrder = 2,
				ZIndex = zIndex + 3,
			}, {
				e("UIListLayout", {
					FillDirection = Enum.FillDirection.Vertical,
					VerticalAlignment = Enum.VerticalAlignment.Top,
					HorizontalAlignment = Enum.HorizontalAlignment.Left,
					Padding = UDim.new(0, 1),
				}),
				e("TextLabel", titleProps),
				if showSubtitle then e("TextLabel", subtitleProps) else nil,
				if showDescription then e("TextLabel", descriptionProps) else nil,
			}),
		}),
	}

	if useGradient then
		cardChildren[#cardChildren + 1] = e("UIGradient", {
			Color = gradientColor,
			Transparency = gradientTransparency,
			Rotation = -8,
			Offset = self.gradientOffsetBinding,
		})
	end

	if showAmount then
		cardChildren[#cardChildren + 1] = e("TextLabel", amountProps, {
			e("UIPadding", {
				PaddingTop = UDim.new(0, 3),
				PaddingBottom = UDim.new(0, 3),
				PaddingLeft = UDim.new(0, 8),
				PaddingRight = UDim.new(0, 8),
			}),
			e("UICorner", {
				CornerRadius = UDim.new(1, 0),
			}),
		})
	end

	if showRarityPill and props.rarity ~= nil then
		cardChildren[#cardChildren + 1] = e(RarityPill.Component, {
			rarity = props.rarity,
			color = accentColor,
			backgroundTransparency = rarityPillTransparencyBinding,
			textTransparency = rarityTextTransparencyBinding,
			position = UDim2.fromOffset(2, -7),
			anchorPoint = Vector2.new(0, 0),
			textSize = 12,
			zIndex = zIndex + 5,
		})
	end

	if props.children then
		for _, childNode in props.children do
			cardChildren[#cardChildren + 1] = childNode
		end
	end

	local billboardProps: { [string]: any } = {
		Enabled = props.enabled ~= false,
		Active = props.active == true,
		Adornee = props.adornee,
		AlwaysOnTop = props.alwaysOnTop ~= false,
		PlayerToHideFrom = props.playerToHideFrom,
		ResetOnSpawn = props.resetOnSpawn == true,
		ClipsDescendants = props.clipsDescendants == true,
		ZIndexBehavior = props.zIndexBehavior or Enum.ZIndexBehavior.Sibling,
		Size = props.billboardSize or DEFAULT_BILLBOARD_SIZE,
		MaxDistance = sanitizeNumber(props.maxDistance, DEFAULT_MAX_DISTANCE, 0, 20000),
		LightInfluence = sanitizeNumber(props.lightInfluence, DEFAULT_LIGHT_INFLUENCE, 0, 1),
		StudsOffset = sanitizeVector3(props.studsOffset, DEFAULT_STUDS_OFFSET),
		StudsOffsetWorldSpace = sanitizeVector3(props.studsOffsetWorldSpace, DEFAULT_STUDS_OFFSET_WORLD),
		ExtentsOffset = sanitizeVector3(props.extentsOffset, DEFAULT_EXTENTS_OFFSET),
	}
	applyNativeProps(billboardProps, props.nativeBillboard)

	local billboardElement = e("BillboardGui", billboardProps, {
		e("Frame", cardProps, cardChildren),
	})

	local portalTarget = self:resolvePortalTarget()
	if portalTarget ~= nil then
		return ReactRoblox.createPortal(billboardElement, portalTarget)
	end

	return billboardElement
end

DropsInfo.resetAnimation = DropsInfo.ResetAnimation
DropsInfo.stepAnimation = DropsInfo.StepAnimation
DropsInfo.resolvePortalTarget = DropsInfo.ResolvePortalTarget

return DropsInfo
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="773">
                  <Properties>
                    <string name="Name">FloatingCard</string>
                    <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local React = require(ReplicatedStorage.Packages.React)

export type FloatingCardTheme = {
	backgroundColor: Color3?,
	backgroundTransparency: number?,
	strokeColor: Color3?,
	strokeTransparency: number?,
	strokeThickness: number?,
	titleColor: Color3?,
	subtitleColor: Color3?,
	bodyColor: Color3?,
	iconColor: Color3?,
}

export type FloatingCardProps = {
	size: UDim2?,
	position: UDim2?,
	anchorPoint: Vector2?,
	layoutOrder: number?,
	automaticSize: Enum.AutomaticSize?,
	visible: boolean?,
	active: boolean?,
	clipsDescendants: boolean?,
	zIndex: number?,
	backgroundColor: Color3?,
	backgroundTransparency: number?,
	strokeColor: Color3?,
	strokeTransparency: number?,
	strokeThickness: number?,
	cornerRadius: UDim?,
	padding: UDim?,
	paddingTop: UDim?,
	paddingBottom: UDim?,
	paddingLeft: UDim?,
	paddingRight: UDim?,
	scale: number?,
	title: string?,
	subtitle: string?,
	body: string?,
	icon: string?,
	iconSize: UDim2?,
	content: React.ReactNode?,
	theme: FloatingCardTheme?,
	native: { [any]: any }?,
	nativeTitle: { [any]: any }?,
	nativeSubtitle: { [any]: any }?,
	nativeBody: { [any]: any }?,
	nativeIcon: { [any]: any }?,
	children: { React.ReactNode }?,
}

local e: typeof(React.createElement) = React.createElement

local DEFAULT_BACKGROUND_COLOR = Color3.fromRGB(16, 20, 29)
local DEFAULT_STROKE_COLOR = Color3.fromRGB(100, 119, 148)
local DEFAULT_TEXT_COLOR = Color3.fromRGB(246, 249, 255)
local DEFAULT_SUBTLE_TEXT_COLOR = Color3.fromRGB(188, 203, 224)
local DEFAULT_BODY_COLOR = Color3.fromRGB(164, 179, 205)
local DEFAULT_PADDING = UDim.new(0, 10)
local DEFAULT_CORNER_RADIUS = UDim.new(0, 8)

local function sanitizeNumber(valueRaw: any, fallback: number, minimum: number?, maximum: number?): number
	local value = if typeof(valueRaw) == "number" and valueRaw == valueRaw then valueRaw else fallback
	if minimum ~= nil and value < minimum then
		value = minimum
	end
	if maximum ~= nil and value > maximum then
		value = maximum
	end
	return value
end

local function sanitizeColor(valueRaw: any, fallback: Color3): Color3
	return if typeof(valueRaw) == "Color3" then valueRaw else fallback
end

local function applyNativeProps(target: { [any]: any }, nativeProps: { [any]: any }?)
	if nativeProps == nil then
		return
	end

	for key, value in nativeProps do
		target[key] = value
	end
end

local function addChildren(target: { React.ReactNode }, children: { React.ReactNode }?)
	if children == nil then
		return
	end

	for key, child in children do
		target[key] = child
	end
end

return function(props: FloatingCardProps): React.ReactNode
	local theme = props.theme or {}
	local zIndex = props.zIndex or 1
	local backgroundColor = sanitizeColor(props.backgroundColor or theme.backgroundColor, DEFAULT_BACKGROUND_COLOR)
	local strokeColor = sanitizeColor(props.strokeColor or theme.strokeColor, DEFAULT_STROKE_COLOR)
	local titleColor = sanitizeColor(theme.titleColor, DEFAULT_TEXT_COLOR)
	local subtitleColor = sanitizeColor(theme.subtitleColor, DEFAULT_SUBTLE_TEXT_COLOR)
	local bodyColor = sanitizeColor(theme.bodyColor, DEFAULT_BODY_COLOR)
	local iconColor = sanitizeColor(theme.iconColor, DEFAULT_TEXT_COLOR)
	local padding = props.padding or DEFAULT_PADDING

	local frameProps: { [any]: any } = {
		Size = props.size or UDim2.fromOffset(220, 80),
		Position = props.position,
		AnchorPoint = props.anchorPoint,
		LayoutOrder = props.layoutOrder,
		AutomaticSize = props.automaticSize,
		Visible = props.visible,
		Active = props.active,
		ClipsDescendants = props.clipsDescendants,
		BackgroundColor3 = backgroundColor,
		BackgroundTransparency = sanitizeNumber(
			props.backgroundTransparency or theme.backgroundTransparency,
			0.15,
			0,
			1
		),
		BorderSizePixel = 0,
		ZIndex = zIndex,
	}
	applyNativeProps(frameProps, props.native)

	local children: { React.ReactNode } = {
		UICorner = e("UICorner", {
			CornerRadius = props.cornerRadius or DEFAULT_CORNER_RADIUS,
		}),
		UIStroke = e("UIStroke", {
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
			Color = strokeColor,
			Thickness = sanitizeNumber(props.strokeThickness or theme.strokeThickness, 1, 0, 8),
			Transparency = sanitizeNumber(props.strokeTransparency or theme.strokeTransparency, 0.22, 0, 1),
		}),
		UIPadding = e("UIPadding", {
			PaddingTop = props.paddingTop or padding,
			PaddingBottom = props.paddingBottom or padding,
			PaddingLeft = props.paddingLeft or padding,
			PaddingRight = props.paddingRight or padding,
		}),
	}

	if props.scale ~= nil then
		children.UIScale = e("UIScale", {
			Scale = sanitizeNumber(props.scale, 1, 0.05, 10),
		})
	end

	local hasText = props.title ~= nil or props.subtitle ~= nil or props.body ~= nil or props.content ~= nil
	if props.icon ~= nil and props.icon ~= "" then
		local iconProps: { [any]: any } = {
			Size = props.iconSize or UDim2.fromOffset(28, 28),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Image = props.icon,
			ImageColor3 = iconColor,
			ScaleType = Enum.ScaleType.Fit,
			ZIndex = zIndex + 1,
		}
		applyNativeProps(iconProps, props.nativeIcon)
		children.Icon = e("ImageLabel", iconProps)
	end

	if hasText then
		local contentChildren: { React.ReactNode } = {
			Layout = e("UIListLayout", {
				FillDirection = Enum.FillDirection.Vertical,
				HorizontalAlignment = Enum.HorizontalAlignment.Left,
				VerticalAlignment = Enum.VerticalAlignment.Top,
				Padding = UDim.new(0, 2),
				SortOrder = Enum.SortOrder.LayoutOrder,
			}),
		}

		if props.title ~= nil then
			local titleProps: { [any]: any } = {
				LayoutOrder = 1,
				Size = UDim2.new(1, 0, 0, 20),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Font = Enum.Font.GothamBold,
				Text = props.title,
				TextColor3 = titleColor,
				TextSize = 16,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Center,
				TextTruncate = Enum.TextTruncate.AtEnd,
				ZIndex = zIndex + 1,
			}
			applyNativeProps(titleProps, props.nativeTitle)
			contentChildren.Title = e("TextLabel", titleProps)
		end

		if props.subtitle ~= nil then
			local subtitleProps: { [any]: any } = {
				LayoutOrder = 2,
				Size = UDim2.new(1, 0, 0, 18),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Font = Enum.Font.GothamMedium,
				Text = props.subtitle,
				TextColor3 = subtitleColor,
				TextSize = 13,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Center,
				TextTruncate = Enum.TextTruncate.AtEnd,
				ZIndex = zIndex + 1,
			}
			applyNativeProps(subtitleProps, props.nativeSubtitle)
			contentChildren.Subtitle = e("TextLabel", subtitleProps)
		end

		if props.body ~= nil then
			local bodyProps: { [any]: any } = {
				LayoutOrder = 3,
				Size = UDim2.new(1, 0, 0, 18),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Font = Enum.Font.Gotham,
				Text = props.body,
				TextColor3 = bodyColor,
				TextSize = 12,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Center,
				TextTruncate = Enum.TextTruncate.AtEnd,
				ZIndex = zIndex + 1,
			}
			applyNativeProps(bodyProps, props.nativeBody)
			contentChildren.Body = e("TextLabel", bodyProps)
		end

		if props.content ~= nil then
			contentChildren.Content = props.content
		end

		children.Content = e("Frame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ZIndex = zIndex + 1,
		}, contentChildren)
	end

	addChildren(children, props.children)

	return e("Frame", frameProps, children)
end
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="774">
                  <Properties>
                    <string name="Name">ImageButton</string>
                    <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local React = require(ReplicatedStorage.Packages.React)
local usePressState = require(script.Parent.Parent.hooks.usePressState)

export type ImageButtonProps = {
	image: string?,
	imagePressed: string?,
	imageHovered: string?,
	size: UDim2?,
	position: UDim2?,
	anchorPoint: Vector2?,
	layoutOrder: number?,
	visible: boolean?,
	zIndex: number?,
	disabled: boolean?,
	selected: boolean?,
	active: boolean?,
	selectable: boolean?,
	autoButtonColor: boolean?,
	backgroundTransparency: number?,
	imageTransparency: number?,
	imageColor3: Color3?,
	onActivated: ((GuiButton, InputObject?) -> ())?,
	onHoverChanged: ((boolean) -> ())?,
	onPressedChanged: ((boolean) -> ())?,
	children: { React.ReactNode }?,
	native: { [any]: any }?,
}

local e: typeof(React.createElement) = React.createElement

return function(props: ImageButtonProps): React.ReactNode
	local disabled = props.disabled == true
	local pressState = usePressState({
		disabled = disabled,
		onHoverChanged = props.onHoverChanged,
		onPressedChanged = props.onPressedChanged,
	})
	local image = props.image or ""
	if (pressState.pressed or props.selected == true) and props.imagePressed ~= nil then
		image = props.imagePressed
	elseif pressState.hovered and props.imageHovered ~= nil then
		image = props.imageHovered
	end

	local buttonProps: { [any]: any } = {
		Size = props.size,
		Position = props.position,
		AnchorPoint = props.anchorPoint,
		LayoutOrder = props.layoutOrder,
		Visible = props.visible,
		ZIndex = props.zIndex,
		BackgroundTransparency = if props.backgroundTransparency ~= nil then props.backgroundTransparency else 1,
		BorderSizePixel = 0,
		AutoButtonColor = if props.autoButtonColor ~= nil then props.autoButtonColor else false,
		Active = if props.active ~= nil then props.active else not disabled,
		Selectable = if props.selectable ~= nil then props.selectable else not disabled,
		Image = image,
		ImageColor3 = props.imageColor3,
		ImageTransparency = if disabled then 0.5 else props.imageTransparency,
		[React.Event.MouseEnter] = pressState.eventHandlers[React.Event.MouseEnter],
		[React.Event.MouseLeave] = pressState.eventHandlers[React.Event.MouseLeave],
		[React.Event.InputBegan] = pressState.eventHandlers[React.Event.InputBegan],
		[React.Event.InputEnded] = pressState.eventHandlers[React.Event.InputEnded],
		[React.Event.Activated] = function(rbx: GuiButton, inputObject: InputObject?)
			pressState.setPressed(false)
			if disabled or props.onActivated == nil then
				return
			end
			props.onActivated(rbx, inputObject)
		end,
	}

	if props.native ~= nil then
		for key, value in props.native do
			buttonProps[key] = value
		end
	end

	return e("ImageButton", buttonProps, props.children)
end
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="775">
                  <Properties>
                    <string name="Name">ItemIcon</string>
                    <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local React = require(ReplicatedStorage.Packages.React)

export type ItemIconProps = {
	icon: string?,
	size: UDim2?,
	position: UDim2?,
	anchorPoint: Vector2?,
	layoutOrder: number?,
	visible: boolean?,
	zIndex: number?,
	imageColor3: Color3?,
	imageTransparency: number?,
	scaleType: Enum.ScaleType?,
	resampleMode: Enum.ResamplerMode?,
	native: { [any]: any }?,
}

local e: typeof(React.createElement) = React.createElement

return function(props: ItemIconProps): React.ReactNode
	local imageProps: { [any]: any } = {
		Size = props.size or UDim2.fromOffset(32, 32),
		Position = props.position or UDim2.fromScale(0.5, 0.5),
		AnchorPoint = props.anchorPoint or Vector2.new(0.5, 0.5),
		LayoutOrder = props.layoutOrder,
		Visible = props.visible,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Image = props.icon or "",
		ImageColor3 = props.imageColor3 or Color3.fromRGB(255, 255, 255),
		ImageTransparency = props.imageTransparency or 0,
		ScaleType = props.scaleType,
		ResampleMode = props.resampleMode,
		ZIndex = props.zIndex,
	}

	if props.native ~= nil then
		for key, value in props.native do
			imageProps[key] = value
		end
	end

	return e("ImageLabel", imageProps)
end
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="776">
                  <Properties>
                    <string name="Name">ItemSlot</string>
                    <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ItemIcon = require(script.Parent.ItemIcon)
local React = require(ReplicatedStorage.Packages.React)
local StackAmountLabel = require(script.Parent.StackAmountLabel)

export type ItemSlotProps = {
	buttonProps: { [any]: any },
	scale: number?,
	keyHintText: string?,
	keyHintProps: { [any]: any }?,
	icon: string?,
	iconProps: { [any]: any }?,
	amount: number?,
	amountText: string?,
	stackLabelProps: { [any]: any }?,
	strokeProps: { [any]: any }?,
	children: { React.ReactNode }?,
}

local e: typeof(React.createElement) = React.createElement

return function(props: ItemSlotProps): React.ReactNode
	local children: { React.ReactNode } = {}

	if props.scale ~= nil then
		children[#children + 1] = e("UIScale", {
			Scale = props.scale,
		})
	end

	if props.keyHintText ~= nil then
		local keyHintProps: { [any]: any } = props.keyHintProps or {}
		keyHintProps.Text = props.keyHintText
		children[#children + 1] = e("TextLabel", keyHintProps)
	end

	if props.amount ~= nil or props.amountText ~= nil then
		local stackLabelProps: { [any]: any } = props.stackLabelProps or {}
		stackLabelProps.amount = props.amount
		stackLabelProps.text = props.amountText
		children[#children + 1] = e(StackAmountLabel, stackLabelProps)
	end

	if props.icon ~= nil then
		local iconProps: { [any]: any } = props.iconProps or {}
		iconProps.icon = props.icon
		children[#children + 1] = e(ItemIcon, iconProps)
	end

	if props.strokeProps ~= nil then
		children[#children + 1] = e("UIStroke", props.strokeProps)
	end

	if props.children ~= nil then
		for _, child in props.children do
			children[#children + 1] = child
		end
	end

	return e("ImageButton", props.buttonProps, children)
end
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="777">
                  <Properties>
                    <string name="Name">NavButton</string>
                    <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local React = require(ReplicatedStorage.Packages.React)

local e: typeof(React.createElement) = React.createElement

export type NavButtonTheme = {
	backgroundColor: Color3,
	hoveredBackgroundColor: Color3,
	pressedBackgroundColor: Color3,
	selectedBackgroundColor: Color3,
	disabledBackgroundColor: Color3,
	textColor: Color3,
	disabledTextColor: Color3,
	iconColor: Color3,
	disabledIconColor: Color3,
	strokeColor: Color3,
	selectedStrokeColor: Color3,
}

export type NavButtonActivatePayload = {
	id: string,
	route: string,
	label: string?,
	selected: boolean,
	source: string,
	timestamp: number,
}

export type NavButtonProps = {
	id: string?,
	route: string?,
	label: string?,
	icon: string?,
	size: UDim2?,
	position: UDim2?,
	anchorPoint: Vector2?,
	layoutOrder: number?,
	visible: boolean?,
	zIndex: number?,
	disabled: boolean?,
	selected: boolean?,
	automaticSize: Enum.AutomaticSize?,
	textSize: number?,
	font: Enum.Font?,
	iconSize: UDim2?,
	iconColor3: Color3?,
	padding: UDim?,
	cornerRadius: UDim?,
	backgroundTransparency: number?,
	strokeTransparency: number?,
	theme: NavButtonTheme?,
	navigateEvent: BindableEvent?,
	onActivated: ((payload: NavButtonActivatePayload, inputObject: InputObject?) -> ())?,
	onHoverChanged: ((isHovered: boolean) -> ())?,
	onPressedChanged: ((isPressed: boolean) -> ())?,
}

local DEFAULT_THEME: NavButtonTheme = {
	backgroundColor = Color3.fromRGB(32, 40, 52),
	hoveredBackgroundColor = Color3.fromRGB(45, 55, 71),
	pressedBackgroundColor = Color3.fromRGB(57, 67, 86),
	selectedBackgroundColor = Color3.fromRGB(31, 80, 126),
	disabledBackgroundColor = Color3.fromRGB(24, 28, 35),
	textColor = Color3.fromRGB(238, 243, 252),
	disabledTextColor = Color3.fromRGB(129, 136, 147),
	iconColor = Color3.fromRGB(229, 236, 249),
	disabledIconColor = Color3.fromRGB(117, 124, 136),
	strokeColor = Color3.fromRGB(90, 102, 122),
	selectedStrokeColor = Color3.fromRGB(118, 204, 255),
}

local DEFAULT_SIZE = UDim2.fromOffset(180, 42)
local DEFAULT_ICON_SIZE = UDim2.fromOffset(20, 20)

type NavButtonState = {
	isHovered: boolean,
	isPressed: boolean,
}

local function isPressInput(inputObject: InputObject?): boolean
	if inputObject == nil then
		return false
	end

	return inputObject.UserInputType == Enum.UserInputType.MouseButton1
		or inputObject.UserInputType == Enum.UserInputType.Touch
		or inputObject.KeyCode == Enum.KeyCode.ButtonA
end

local function resolveInputSource(inputObject: InputObject?): string
	if inputObject == nil then
		return "unknown"
	end

	if inputObject.UserInputType == Enum.UserInputType.MouseButton1 then
		return "mouse"
	end

	if inputObject.UserInputType == Enum.UserInputType.Touch then
		return "touch"
	end

	if inputObject.UserInputType == Enum.UserInputType.Gamepad1 then
		return "gamepad"
	end

	if inputObject.UserInputType == Enum.UserInputType.Keyboard then
		return "keyboard"
	end

	return "unknown"
end

local NavButton = React.Component:extend("NavButton")

function NavButton:init()
	self.state = {
		isHovered = false,
		isPressed = false,
	} :: NavButtonState
end

function NavButton:UpdateHover(nextValue: boolean)
	self:setState({
		isHovered = nextValue,
	})

	local onHoverChanged = self.props.onHoverChanged
	if onHoverChanged then
		onHoverChanged(nextValue)
	end
end

function NavButton:UpdatePressed(nextValue: boolean)
	self:setState({
		isPressed = nextValue,
	})

	local onPressedChanged = self.props.onPressedChanged
	if onPressedChanged then
		onPressedChanged(nextValue)
	end
end

function NavButton:EmitActivated(inputObject: InputObject?)
	local props: NavButtonProps = self.props
	local isDisabled = props.disabled == true
	local isSelected = props.selected == true
	if isDisabled then
		return
	end

	local resolvedRoute = props.route or props.id or props.label or ""
	local payload: NavButtonActivatePayload = {
		id = props.id or resolvedRoute,
		route = resolvedRoute,
		label = props.label,
		selected = isSelected,
		source = resolveInputSource(inputObject),
		timestamp = os.clock(),
	}

	if props.onActivated then
		props.onActivated(payload, inputObject)
	end

	if props.navigateEvent then
		props.navigateEvent:Fire(payload)
	end
end

function NavButton:render()
	local props: NavButtonProps = self.props
	local state: NavButtonState = self.state

	local theme = props.theme or DEFAULT_THEME
	local isDisabled = props.disabled == true
	local isSelected = props.selected == true
	local hasLabel = props.label ~= nil and props.label ~= ""
	local hasIcon = props.icon ~= nil and props.icon ~= ""

	local backgroundColor = theme.backgroundColor
	if isDisabled then
		backgroundColor = theme.disabledBackgroundColor
	elseif isSelected then
		backgroundColor = theme.selectedBackgroundColor
	elseif state.isPressed then
		backgroundColor = theme.pressedBackgroundColor
	elseif state.isHovered then
		backgroundColor = theme.hoveredBackgroundColor
	end

	local textColor = isDisabled and theme.disabledTextColor or theme.textColor
	local iconColor = props.iconColor3 or (if isDisabled then theme.disabledIconColor else theme.iconColor)
	local strokeColor = isSelected and theme.selectedStrokeColor or theme.strokeColor
	local backgroundTransparency = if typeof(props.backgroundTransparency) == "number"
			and props.backgroundTransparency == props.backgroundTransparency
		then math.clamp(props.backgroundTransparency, 0, 1)
		else 0
	local strokeTransparency = if typeof(props.strokeTransparency) == "number"
			and props.strokeTransparency == props.strokeTransparency
		then math.clamp(props.strokeTransparency, 0, 1)
		else (if isDisabled then 0.45 else 0.15)

	return e("ImageButton", {
		Size = props.size or DEFAULT_SIZE,
		Position = props.position,
		AnchorPoint = props.anchorPoint,
		LayoutOrder = props.layoutOrder,
		Visible = props.visible ~= false,
		ZIndex = props.zIndex or 1,
		AutomaticSize = props.automaticSize,
		BackgroundColor3 = backgroundColor,
		BackgroundTransparency = backgroundTransparency,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Active = not isDisabled,
		Selectable = not isDisabled,
		Image = "",
		[React.Event.MouseEnter] = function()
			if not isDisabled then
				self:updateHover(true)
			end
		end,
		[React.Event.MouseLeave] = function()
			self:updateHover(false)
			self:updatePressed(false)
		end,
		[React.Event.InputBegan] = function(_rbx: GuiObject, inputObject: InputObject)
			if isDisabled then
				return
			end

			if isPressInput(inputObject) then
				self:updatePressed(true)
			end
		end,
		[React.Event.InputEnded] = function(_rbx: GuiObject, inputObject: InputObject)
			if isPressInput(inputObject) then
				self:updatePressed(false)
			end
		end,
		[React.Event.Activated] = function(_rbx: GuiButton, inputObject: InputObject?)
			self:updatePressed(false)
			self:emitActivated(inputObject)
		end,
	}, {
		e("UICorner", {
			CornerRadius = props.cornerRadius or UDim.new(0, 10),
		}),
		e("UIStroke", {
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
			Color = strokeColor,
			Thickness = isSelected and 2 or 1,
			Transparency = strokeTransparency,
		}),
		e("Frame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			ZIndex = (props.zIndex or 1) + 1,
		}, {
			e("UIPadding", {
				PaddingLeft = props.padding or UDim.new(0, 12),
				PaddingRight = props.padding or UDim.new(0, 12),
				PaddingTop = UDim.new(0, 6),
				PaddingBottom = UDim.new(0, 6),
			}),
			e("UIListLayout", {
				FillDirection = Enum.FillDirection.Horizontal,
				VerticalAlignment = Enum.VerticalAlignment.Center,
				HorizontalAlignment = hasLabel and Enum.HorizontalAlignment.Left or Enum.HorizontalAlignment.Center,
				Padding = UDim.new(0, 8),
			}),
			if hasIcon
				then e("ImageLabel", {
					Size = props.iconSize or DEFAULT_ICON_SIZE,
					BackgroundTransparency = 1,
					LayoutOrder = 1,
					Image = props.icon,
					ImageColor3 = iconColor,
				})
				else nil,
			if hasLabel
				then e("TextLabel", {
					Size = UDim2.fromScale(1, 1),
					BackgroundTransparency = 1,
					LayoutOrder = 2,
					Font = props.font or Enum.Font.GothamSemibold,
					Text = props.label or "",
					TextColor3 = textColor,
					TextSize = props.textSize or 16,
					TextTruncate = Enum.TextTruncate.AtEnd,
					TextWrapped = false,
					TextXAlignment = Enum.TextXAlignment.Left,
					TextYAlignment = Enum.TextYAlignment.Center,
				})
				else nil,
		}),
	})
end

NavButton.updateHover = NavButton.UpdateHover
NavButton.updatePressed = NavButton.UpdatePressed
NavButton.emitActivated = NavButton.EmitActivated

return NavButton
]]></string>
                  </Properties>
                </Item>
