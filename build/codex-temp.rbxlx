            <Item class="ModuleScript" referent="1876">
              <Properties>
                <string name="Name">jest.config</string>
                <string name="Source"><![CDATA[return {
	testMatch = { "**/*.spec" },
}
]]></string>
              </Properties>
            </Item>
          </Item>
          <Item class="Folder" referent="1877">
            <Properties>
              <string name="Name">firstpersoncharactertransparency</string>
            </Properties>
            <Item class="Folder" referent="1878">
              <Properties>
