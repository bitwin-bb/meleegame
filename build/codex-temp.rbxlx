function LiquidServiceUtils.SanitizeConfig(configRaw: any, fallbackRaw: LiquidServiceConfig?): LiquidServiceConfig
	local fallback = if fallbackRaw ~= nil then fallbackRaw else LiquidServiceUtils.CreateDefaultConfig()
	local source = if typeof(configRaw) == "table" then configRaw else {}
	local definitions: { [number]: LiquidDefinition } = {}
	local definitionSource = if typeof(source.definitions) == "table" then source.definitions else {}
	for liquidType, fallbackDefinition in fallback.definitions do
		local sourceDefinition = if typeof(definitionSource) == "table" then definitionSource[liquidType] else nil
		definitions[liquidType] = sanitizeDefinition(liquidType, sourceDefinition, fallbackDefinition)
	end

	local simulationSource = if typeof(source.simulation) == "table" then source.simulation else {}
	local generationSource = if typeof(source.generation) == "table" then source.generation else {}
	local renderSource = if typeof(source.render) == "table" then source.render else {}
	local biomeTintsSource = if typeof(source.biomeTints) == "table" then source.biomeTints else {}
	local debugSource = if typeof(source.debug) == "table" then source.debug else {}

	return {
		maxFill = sanitizeInteger(source.maxFill, 32, MAX_FILL, fallback.maxFill),
		simulation = {
			stepRate = sanitizeNumber(simulationSource.stepRate, 1, 60, fallback.simulation.stepRate),
			hazardCheckRate = sanitizeNumber(
				simulationSource.hazardCheckRate,
				1,
				60,
				fallback.simulation.hazardCheckRate
			),
			streamSyncInterval = sanitizeNumber(
				simulationSource.streamSyncInterval,
				0.03,
				2,
				fallback.simulation.streamSyncInterval
			),
			activeSafetyMarginChunks = sanitizeInteger(
				simulationSource.activeSafetyMarginChunks,
				0,
				4,
				fallback.simulation.activeSafetyMarginChunks
			),
			disturbedChunkKeepAliveSeconds = sanitizeNumber(
				simulationSource.disturbedChunkKeepAliveSeconds,
				0,
				60,
				fallback.simulation.disturbedChunkKeepAliveSeconds
			),
			maxChunkStepsPerTick = sanitizeInteger(
				simulationSource.maxChunkStepsPerTick,
				1,
				128,
				fallback.simulation.maxChunkStepsPerTick
			),
			maxCellsPerChunkStep = sanitizeInteger(
				simulationSource.maxCellsPerChunkStep,
				4,
				2048,
				fallback.simulation.maxCellsPerChunkStep
			),
			maxWakeRequestsPerTick = sanitizeInteger(
				simulationSource.maxWakeRequestsPerTick,
				4,
				4096,
				fallback.simulation.maxWakeRequestsPerTick
			),
			maxDeltaCellsPerChunk = sanitizeInteger(
				simulationSource.maxDeltaCellsPerChunk,
				8,
				4096,
				fallback.simulation.maxDeltaCellsPerChunk
			),
			fullSnapshotThreshold = sanitizeInteger(
				simulationSource.fullSnapshotThreshold,
				8,
				4096,
				fallback.simulation.fullSnapshotThreshold
			),
			generationSettlePasses = sanitizeInteger(
				simulationSource.generationSettlePasses,
				0,
				128,
				fallback.simulation.generationSettlePasses
			),
			leakScanDistanceTiles = sanitizeInteger(
				simulationSource.leakScanDistanceTiles,
				4,
				256,
				fallback.simulation.leakScanDistanceTiles
			),
			consistencySweepInterval = sanitizeNumber(
				simulationSource.consistencySweepInterval,
				0.1,
				30,
				fallback.simulation.consistencySweepInterval
			),
			consistencySweepChunkBudget = sanitizeInteger(
				simulationSource.consistencySweepChunkBudget,
				1,
				256,
				fallback.simulation.consistencySweepChunkBudget
			),
		},
		generation = {
			depressionScanRadius = sanitizeInteger(
				generationSource.depressionScanRadius,
				2,
				24,
				fallback.generation.depressionScanRadius
			),
			surfacePoolChance = sanitizeNumber(
				generationSource.surfacePoolChance,
				0,
				1,
				fallback.generation.surfacePoolChance
			),
			surfacePoolMinDepth = sanitizeInteger(
				generationSource.surfacePoolMinDepth,
				1,
				16,
				fallback.generation.surfacePoolMinDepth
			),
			surfacePoolMaxDepth = sanitizeInteger(
				generationSource.surfacePoolMaxDepth,
				1,
				24,
				fallback.generation.surfacePoolMaxDepth
			),
			surfacePoolFillChance = sanitizeNumber(
				generationSource.surfacePoolFillChance,
				0,
				1,
				fallback.generation.surfacePoolFillChance
			),
			cavePocketChance = sanitizeNumber(
				generationSource.cavePocketChance,
				0,
				1,
				fallback.generation.cavePocketChance
			),
			cavePocketMinDepth = sanitizeInteger(
				generationSource.cavePocketMinDepth,
				0,
				512,
				fallback.generation.cavePocketMinDepth
			),
			cavePocketMaxDepth = sanitizeInteger(
				generationSource.cavePocketMaxDepth,
				0,
				512,
				fallback.generation.cavePocketMaxDepth
			),
			cavePocketMinRadius = sanitizeInteger(
				generationSource.cavePocketMinRadius,
				1,
				16,
				fallback.generation.cavePocketMinRadius
			),
			cavePocketMaxRadius = sanitizeInteger(
				generationSource.cavePocketMaxRadius,
				1,
				24,
				fallback.generation.cavePocketMaxRadius
			),
			reservoirChance = sanitizeNumber(
				generationSource.reservoirChance,
				0,
				1,
				fallback.generation.reservoirChance
			),
			reservoirMinDepth = sanitizeInteger(
				generationSource.reservoirMinDepth,
				0,
				512,
				fallback.generation.reservoirMinDepth
			),
			reservoirMaxDepth = sanitizeInteger(
				generationSource.reservoirMaxDepth,
				0,
				512,
				fallback.generation.reservoirMaxDepth
			),
			reservoirMinRadius = sanitizeInteger(
				generationSource.reservoirMinRadius,
				1,
				24,
				fallback.generation.reservoirMinRadius
			),
			reservoirMaxRadius = sanitizeInteger(
				generationSource.reservoirMaxRadius,
				1,
				32,
				fallback.generation.reservoirMaxRadius
			),
			lavaStartDepth = sanitizeInteger(
				generationSource.lavaStartDepth,
				0,
				1024,
				fallback.generation.lavaStartDepth
			),
			lavaCommonDepth = sanitizeInteger(
				generationSource.lavaCommonDepth,
				0,
				1024,
				fallback.generation.lavaCommonDepth
			),
			lavaPocketChance = sanitizeNumber(
				generationSource.lavaPocketChance,
				0,
				1,
				fallback.generation.lavaPocketChance
			),
			lavaReservoirChance = sanitizeNumber(
				generationSource.lavaReservoirChance,
				0,
				1,
				fallback.generation.lavaReservoirChance
			),
			lavaPocketMinRadius = sanitizeInteger(
				generationSource.lavaPocketMinRadius,
				1,
				24,
				fallback.generation.lavaPocketMinRadius
			),
			lavaPocketMaxRadius = sanitizeInteger(
				generationSource.lavaPocketMaxRadius,
				1,
				32,
				fallback.generation.lavaPocketMaxRadius
			),
		},
		render = {
			interpolationTime = sanitizeNumber(
				renderSource.interpolationTime,
				0.03,
				2,
				fallback.render.interpolationTime
			),
			surfaceWaveAmplitudeStuds = sanitizeNumber(
				renderSource.surfaceWaveAmplitudeStuds,
				0,
				1,
				fallback.render.surfaceWaveAmplitudeStuds
			),
			surfaceWaveSpeed = sanitizeNumber(renderSource.surfaceWaveSpeed, 0, 16, fallback.render.surfaceWaveSpeed),
			surfaceWaveScale = sanitizeNumber(renderSource.surfaceWaveScale, 0.01, 8, fallback.render.surfaceWaveScale),
			rebuildRowsPerFrame = sanitizeInteger(
				renderSource.rebuildRowsPerFrame,
				1,
				64,
				fallback.render.rebuildRowsPerFrame
			),
			rebuildFlushInterval = sanitizeNumber(
				renderSource.rebuildFlushInterval,
				1 / 240,
				1,
				fallback.render.rebuildFlushInterval
			),
			minVisibleFill = sanitizeInteger(renderSource.minVisibleFill, 1, MAX_FILL, fallback.render.minVisibleFill),
			fillBucketSize = sanitizeInteger(renderSource.fillBucketSize, 1, 64, fallback.render.fillBucketSize),
		},
		definitions = definitions,
		biomeTints = {
			byBiomeId = if next(cloneColor3Map(biomeTintsSource.byBiomeId)) ~= nil
				then cloneColor3Map(biomeTintsSource.byBiomeId)
				else cloneColor3Map(fallback.biomeTints.byBiomeId),
			byBiomeType = if next(cloneColor3Map(biomeTintsSource.byBiomeType)) ~= nil
				then cloneColor3Map(biomeTintsSource.byBiomeType)
				else cloneColor3Map(fallback.biomeTints.byBiomeType),
			lavaAmbientByBiomeId = if next(cloneColor3Map(biomeTintsSource.lavaAmbientByBiomeId)) ~= nil
				then cloneColor3Map(biomeTintsSource.lavaAmbientByBiomeId)
				else cloneColor3Map(fallback.biomeTints.lavaAmbientByBiomeId),
			lavaAmbientByBiomeType = if next(cloneColor3Map(biomeTintsSource.lavaAmbientByBiomeType)) ~= nil
				then cloneColor3Map(biomeTintsSource.lavaAmbientByBiomeType)
				else cloneColor3Map(fallback.biomeTints.lavaAmbientByBiomeType),
		},
		debug = {
			enabled = if typeof(debugSource.enabled) == "boolean" then debugSource.enabled else fallback.debug.enabled,
			logActivations = if typeof(debugSource.logActivations) == "boolean"
				then debugSource.logActivations
				else fallback.debug.logActivations,
			logDirtyMarks = if typeof(debugSource.logDirtyMarks) == "boolean"
				then debugSource.logDirtyMarks
				else fallback.debug.logDirtyMarks,
			logSimulationSteps = if typeof(debugSource.logSimulationSteps) == "boolean"
				then debugSource.logSimulationSteps
				else fallback.debug.logSimulationSteps,
			logStableTransitions = if typeof(debugSource.logStableTransitions) == "boolean"
				then debugSource.logStableTransitions
				else fallback.debug.logStableTransitions,
			visualizeChunks = if typeof(debugSource.visualizeChunks) == "boolean"
				then debugSource.visualizeChunks
				else fallback.debug.visualizeChunks,
			visualizeCells = if typeof(debugSource.visualizeCells) == "boolean"
				then debugSource.visualizeCells
				else fallback.debug.visualizeCells,
		},
	}
end

function LiquidServiceUtils.CreateDefaultState(): LiquidServiceState
	return {
		ready = false,
		tileSize = 2,
		chunkSize = 32,
		worldOrigin = Vector3.zero,
		maxFill = MAX_FILL,
		interpolationTime = DEFAULT_LIQUID_INTERPOLATION_TIME,
		updatedAt = os.clock(),
	}
end

function LiquidServiceUtils.CreateState(stateRaw: any, fallbackRaw: LiquidServiceState?): LiquidServiceState
	local fallback = if fallbackRaw ~= nil then fallbackRaw else LiquidServiceUtils.CreateDefaultState()
	local source = if typeof(stateRaw) == "table" then stateRaw else {}
	return {
		ready = if typeof(source.ready) == "boolean" then source.ready else fallback.ready,
		tileSize = sanitizeNumber(source.tileSize, 0.05, 64, fallback.tileSize),
		chunkSize = sanitizeInteger(source.chunkSize, 1, 256, fallback.chunkSize),
		worldOrigin = if typeof(source.worldOrigin) == "Vector3" then source.worldOrigin else fallback.worldOrigin,
		maxFill = sanitizeInteger(source.maxFill, 1, MAX_FILL, fallback.maxFill),
		interpolationTime = sanitizeNumber(source.interpolationTime, 0.03, 2, fallback.interpolationTime),
		updatedAt = os.clock(),
	}
end

function LiquidServiceUtils.CloneState(state: LiquidServiceState): LiquidServiceState
	return {
		ready = state.ready,
		tileSize = state.tileSize,
		chunkSize = state.chunkSize,
		worldOrigin = state.worldOrigin,
		maxFill = state.maxFill,
		interpolationTime = state.interpolationTime,
		updatedAt = state.updatedAt,
	}
end

function LiquidServiceUtils.GetDefinition(configRaw: LiquidServiceConfig?, liquidTypeRaw: any): LiquidDefinition?
	local config = if configRaw ~= nil then configRaw else LiquidServiceUtils.CreateDefaultConfig()
	local liquidType = sanitizeInteger(liquidTypeRaw, LiquidServiceUtils.LIQUID_TYPE.NONE, 7, 0)
	return config.definitions[liquidType]
end

local LiquidColor = {}

function LiquidColor.ResolveWaterTint(config: LiquidServiceConfig, biomeIdRaw: any, biomeTypeRaw: any): Color3
	local definitions = config.definitions
	local waterDefinition = definitions[LiquidServiceUtils.LIQUID_TYPE.WATER]
	local baseColor = if waterDefinition ~= nil then waterDefinition.baseColor else Color3.fromRGB(74, 174, 225)
	local biomeId = sanitizeInteger(biomeIdRaw, -2048, 2048, 1)
	local biomeType = sanitizeInteger(biomeTypeRaw, -2048, 2048, 1)
	local typeColor = config.biomeTints.byBiomeType[biomeType]
	local biomeColor = config.biomeTints.byBiomeId[biomeId]
	local blended = baseColor
	if typeColor ~= nil then
		blended = lerpColor(blended, typeColor, 0.45)
	end
	if biomeColor ~= nil then
		blended = lerpColor(blended, biomeColor, 0.65)
	end
	return blended
end

function LiquidColor.ResolveLavaAmbientTint(config: LiquidServiceConfig, biomeIdRaw: any, biomeTypeRaw: any): Color3?
	local biomeId = sanitizeInteger(biomeIdRaw, -2048, 2048, 1)
	local biomeType = sanitizeInteger(biomeTypeRaw, -2048, 2048, 1)
	local typeColor = config.biomeTints.lavaAmbientByBiomeType[biomeType]
	local biomeColor = config.biomeTints.lavaAmbientByBiomeId[biomeId]
	if typeColor == nil and biomeColor == nil then
		return nil
	end
	if typeColor ~= nil and biomeColor ~= nil then
		return lerpColor(typeColor, biomeColor, 0.5)
	end
	return if biomeColor ~= nil then biomeColor else typeColor
end

function LiquidColor.SampleWaterColorAtWorldPosition(
	config: LiquidServiceConfig,
	worldPosition: Vector3,
	tileSize: number,
	worldOrigin: Vector3,
	sampleBiomeAtTile: (tileX: number, tileY: number) -> (number, number)
): Color3
	local localTileX = (worldPosition.Z - worldOrigin.Z) / math.max(0.001, tileSize)
	local localTileY = (worldPosition.Y - worldOrigin.Y) / math.max(0.001, tileSize)
	local tileX0 = math.floor(localTileX)
	local tileY0 = math.floor(localTileY)
	local fracX = localTileX - tileX0
	local fracY = localTileY - tileY0

	local biomeId00, biomeType00 = sampleBiomeAtTile(tileX0, tileY0)
	local biomeId10, biomeType10 = sampleBiomeAtTile(tileX0 + 1, tileY0)
	local biomeId01, biomeType01 = sampleBiomeAtTile(tileX0, tileY0 + 1)
	local biomeId11, biomeType11 = sampleBiomeAtTile(tileX0 + 1, tileY0 + 1)

	local color00 = LiquidColor.ResolveWaterTint(config, biomeId00, biomeType00)
	local color10 = LiquidColor.ResolveWaterTint(config, biomeId10, biomeType10)
	local color01 = LiquidColor.ResolveWaterTint(config, biomeId01, biomeType01)
	local color11 = LiquidColor.ResolveWaterTint(config, biomeId11, biomeType11)

	local top = lerpColor(color00, color10, fracX)
	local bottom = lerpColor(color01, color11, fracX)
	return lerpColor(top, bottom, fracY)
end

function LiquidColor.ResolveLiquidColor(
	config: LiquidServiceConfig,
	liquidTypeRaw: any,
	biomeIdRaw: any,
	biomeTypeRaw: any
): Color3
	local liquidType = sanitizeInteger(liquidTypeRaw, 0, 7, 0)
	local definition = config.definitions[liquidType]
	if definition == nil then
		return Color3.fromRGB(255, 255, 255)
	end
	if liquidType == LiquidServiceUtils.LIQUID_TYPE.WATER then
		return LiquidColor.ResolveWaterTint(config, biomeIdRaw, biomeTypeRaw)
	end
	if liquidType == LiquidServiceUtils.LIQUID_TYPE.LAVA then
		local ambientTint = LiquidColor.ResolveLavaAmbientTint(config, biomeIdRaw, biomeTypeRaw)
		if ambientTint ~= nil then
			return lerpColor(definition.baseColor, ambientTint, definition.lavaAmbientTintStrength)
		end
	end
	return definition.baseColor
end

LiquidServiceUtils.LiquidColor = LiquidColor

local LiquidMesher = {}

local FOREGROUND_TILE_AIR_ID = 0

local function isOpenInBackgroundLayer(
	layerData: LiquidBackgroundLayerSource,
	worldTileX: number,
	worldTileY: number
): boolean
	local localX = worldTileX - layerData.tileMinX
	local localY = worldTileY - layerData.tileMinY
	if localX < 0 or localX >= layerData.width or localY < 0 or localY >= layerData.height then
		return false
	end
	local layerIndex = LiquidServiceUtils.ComputeTileIndex(localX, localY, layerData.width)
	return (layerData.tiles[layerIndex] or FOREGROUND_TILE_AIR_ID) == FOREGROUND_TILE_AIR_ID
end

function LiquidMesher.BuildBackgroundVisualCells(
	config: LiquidServiceConfig,
	sourceCellsRaw: any,
	tileMinXRaw: any,
	tileMinYRaw: any,
	widthRaw: any,
	heightRaw: any,
	layerDataRaw: any,
	layerListIndexRaw: any
): { number }
	local width = sanitizeInteger(widthRaw, 1, 512, 1)
	local height = sanitizeInteger(heightRaw, 1, 512, 1)
	local tileMinX = sanitizeInteger(tileMinXRaw, -10000000, 10000000, 0)
	local tileMinY = sanitizeInteger(tileMinYRaw, -10000000, 10000000, 0)
	local layerListIndex = sanitizeInteger(layerListIndexRaw, 1, 64, 1)
	local total = width * height
	local derivedCells = Sift.Array.create(total, 0)
	local sourceCells = if typeof(sourceCellsRaw) == "table" then sourceCellsRaw :: { number } else nil
	if sourceCells == nil then
		return derivedCells
	end
	if typeof(layerDataRaw) ~= "table" then
		return derivedCells
	end

	local layerSource = layerDataRaw :: { [string]: any }
	local layerWidth = sanitizeInteger(layerSource.width, 1, 512, width)
	local layerHeight = sanitizeInteger(layerSource.height, 1, 512, height)
	local layerData: LiquidBackgroundLayerSource = {
		tileMinX = sanitizeInteger(layerSource.tileMinX, -10000000, 10000000, tileMinX),
		tileMinY = sanitizeInteger(layerSource.tileMinY, -10000000, 10000000, tileMinY),
		width = layerWidth,
		height = layerHeight,
		tiles = if typeof(layerSource.tiles) == "table" then layerSource.tiles :: { number } else {},
	}
	local minVisibleFill = math.max(1, config.render.minVisibleFill)
	local maxLateralSpread = math.max(0, math.min(3, layerListIndex - 1))

	local queueLocalX = Sift.Array.create(total)
	local queueLocalY = Sift.Array.create(total)
	local queueType = Sift.Array.create(total)
	local queueFill = Sift.Array.create(total)
	local queueDistance = Sift.Array.create(total)
	local queueHead = 1
	local queueTail = 0

	local function tryOccupy(
		localX: number,
		localY: number,
		liquidType: number,
		fill: number,
		distance: number
	): boolean
		if localX < 0 or localX >= width or localY < 0 or localY >= height then
			return false
		end
		if liquidType == LiquidServiceUtils.LIQUID_TYPE.NONE or fill < minVisibleFill then
			return false
		end
		local targetIndex = LiquidServiceUtils.ComputeTileIndex(localX, localY, width)
		if derivedCells[targetIndex] ~= 0 then
			return false
		end
		local worldTileX = tileMinX + localX
		local worldTileY = tileMinY + localY
		if not isOpenInBackgroundLayer(layerData, worldTileX, worldTileY) then
			return false
		end
		derivedCells[targetIndex] = LiquidCell.Make(liquidType, fill, LiquidServiceUtils.FLOW_STATE.STILL)
		queueTail += 1
		queueLocalX[queueTail] = localX
		queueLocalY[queueTail] = localY
		queueType[queueTail] = liquidType
		queueFill[queueTail] = fill
		queueDistance[queueTail] = distance
		return true
	end

	for localY = 0, height - 1 do
		for localX = 0, width - 1 do
			local index = LiquidServiceUtils.ComputeTileIndex(localX, localY, width)
			local liquidType, fill = LiquidCell.Unpack(sourceCells[index] or 0)
			if liquidType ~= LiquidServiceUtils.LIQUID_TYPE.NONE and fill >= minVisibleFill then
				tryOccupy(localX, localY, liquidType, fill, 0)
			end
		end
	end

	while queueHead <= queueTail do
		local localX = queueLocalX[queueHead]
		local localY = queueLocalY[queueHead]
		local liquidType = queueType[queueHead]
		local fill = queueFill[queueHead]
		local distance = queueDistance[queueHead]
		queueHead += 1

		if distance >= maxLateralSpread then
			continue
		end

		tryOccupy(localX - 1, localY, liquidType, fill, distance + 1)
		tryOccupy(localX + 1, localY, liquidType, fill, distance + 1)
	end

	return derivedCells
end

function LiquidMesher.BuildRowDescriptors(
	config: LiquidServiceConfig,
	cells: { number },
	width: number,
	height: number,
	rowYRaw: any
): { LiquidStripDescriptor }
	local rowY = sanitizeInteger(rowYRaw, 0, math.max(0, height - 1), 0)
	local descriptors: { LiquidStripDescriptor } = {}
	local fillBucketSize = math.max(1, config.render.fillBucketSize)
	local minVisibleFill = math.max(1, config.render.minVisibleFill)

	local activeType = LiquidServiceUtils.LIQUID_TYPE.NONE
	local activeStartX = -1
	local activeFillBucket = -1
	local activeIsSurface = false
	local activeFill = 0

	local function flush(currentXExclusive: number)
		if activeType == LiquidServiceUtils.LIQUID_TYPE.NONE or activeStartX < 0 then
			return
		end
		local endX = currentXExclusive - 1
		local fillAlpha = math.clamp(activeFill / math.max(1, config.maxFill), 0, 1)
		table.insert(descriptors, {
			key = `{activeType}:{rowY}:{activeStartX}:{endX}:{activeFillBucket}:{if activeIsSurface then 1 else 0}`,
			typeId = activeType,
			rowY = rowY,
			startX = activeStartX,
			endX = endX,
			widthTiles = endX - activeStartX + 1,
			fill = activeFill,
			fillAlpha = fillAlpha,
			isSurface = activeIsSurface,
		})
		activeType = LiquidServiceUtils.LIQUID_TYPE.NONE
		activeStartX = -1
		activeFillBucket = -1
		activeIsSurface = false
		activeFill = 0
	end

	for localX = 0, width - 1 do
		local index = LiquidServiceUtils.ComputeTileIndex(localX, rowY, width)
		local packedCell = cells[index] or 0
		local liquidType, fill = LiquidCell.Unpack(packedCell)
		local isVisible = liquidType ~= LiquidServiceUtils.LIQUID_TYPE.NONE and fill >= minVisibleFill
		local cellIsSurface = false
		if isVisible then
			local aboveIndex = if rowY + 1 < height
				then LiquidServiceUtils.ComputeTileIndex(localX, rowY + 1, width)
				else nil
			local aboveType, aboveFill = LiquidServiceUtils.LIQUID_TYPE.NONE, 0
			if aboveIndex ~= nil then
				aboveType, aboveFill = LiquidCell.Unpack(cells[aboveIndex] or 0)
			end
			cellIsSurface = aboveType ~= liquidType or aboveFill < config.maxFill - DEFAULT_FLOW_SETTLE_EPSILON
		end

		local fillBucket = if cellIsSurface
			then math.floor(fill / fillBucketSize)
			else math.floor(config.maxFill / fillBucketSize)
		if not isVisible then
			flush(localX)
			continue
		end

		local canMerge = activeType == liquidType
			and activeFillBucket == fillBucket
			and activeIsSurface == cellIsSurface
		if not canMerge then
			flush(localX)
			activeType = liquidType
			activeStartX = localX
			activeFillBucket = fillBucket
			activeIsSurface = cellIsSurface
			activeFill = fill
		else
			activeFill = math.max(activeFill, fill)
		end
	end

	flush(width)
	return descriptors
end

function LiquidMesher.GetAffectedRowsForChanges(width: number, height: number, changedIndices: { number }): { number }
	local rowsLookup: { [number]: boolean } = {}
	local rows: { number } = {}
	for _, index in changedIndices do
		if not isFiniteNumber(index) then
			continue
		end
		local zeroBasedIndex = math.max(0, math.floor(index) - 1)
		local rowY = math.floor(zeroBasedIndex / math.max(1, width))
		for _, affectedRow in { rowY - 1, rowY, rowY + 1 } do
			if affectedRow < 0 or affectedRow >= height then
				continue
			end
			if rowsLookup[affectedRow] then
				continue
			end
			rowsLookup[affectedRow] = true
			table.insert(rows, affectedRow)
		end
	end
	table.sort(rows)
	return rows
end

LiquidServiceUtils.LiquidMesher = LiquidMesher

local LiquidQuery = {}

local DEFAULT_SAMPLE_DEFINITIONS = {
	{
		name = "Feet",
		weight = 0.12,
		offset = function(_root: BasePart, height: number): Vector3
			return Vector3.new(0, -height * 0.48, 0)
		end,
	},
	{
		name = "Root",
		weight = 0.22,
		offset = function(_root: BasePart, _height: number): Vector3
			return Vector3.zero
		end,
	},
	{
		name = "Chest",
		weight = 0.28,
		offset = function(_root: BasePart, height: number): Vector3
			return Vector3.new(0, height * 0.22, 0)
		end,
	},
	{
		name = "Head",
		weight = 0.38,
		offset = function(_root: BasePart, height: number): Vector3
			return Vector3.new(0, height * 0.52, 0)
		end,
	},
}

function LiquidQuery.WorldToTile(provider: LiquidQueryProvider, worldPosition: Vector3): (number, number)
	local tileSize = math.max(0.001, provider.tileSize)
	local worldOrigin = provider.worldOrigin
	return LiquidServiceUtils.ToTileCoordinate(worldPosition.Z - worldOrigin.Z, tileSize),
		LiquidServiceUtils.ToTileCoordinate(worldPosition.Y - worldOrigin.Y, tileSize)
end

function LiquidQuery.GetSurfaceWorldY(provider: LiquidQueryProvider, tileY: number, fillRaw: any): number
	local fill = sanitizeInteger(fillRaw, 0, MAX_FILL, 0)
	return provider.worldOrigin.Y + tileY * provider.tileSize + (fill / MAX_FILL) * provider.tileSize
end

function LiquidQuery.SampleWorldPoint(
	provider: LiquidQueryProvider,
	name: string,
	worldPosition: Vector3,
	weight: number
): LiquidSamplePoint
	local tileX, tileY = LiquidQuery.WorldToTile(provider, worldPosition)
	local packedCell = provider.getCellAt(tileX, tileY)
	local liquidType, fill = LiquidCell.Unpack(packedCell)
	local surfaceWorldY = nil :: number?
	local submerged = false
	if liquidType ~= LiquidServiceUtils.LIQUID_TYPE.NONE and fill > 0 then
		local nextSurfaceWorldY = LiquidQuery.GetSurfaceWorldY(provider, tileY, fill)
		surfaceWorldY = nextSurfaceWorldY
		submerged = worldPosition.Y <= nextSurfaceWorldY + 0.001
	end
	return {
		name = name,
		worldPosition = worldPosition,
		tileX = tileX,
		tileY = tileY,
		liquidType = liquidType,
		fill = fill,
		submerged = submerged,
		surfaceWorldY = surfaceWorldY,
		weight = weight,
	}
end

function LiquidQuery.QueryCharacter(provider: LiquidQueryProvider, characterRaw: any): LiquidQueryResult
	local emptyResult: LiquidQueryResult = {
		inLiquid = false,
		dominantType = LiquidServiceUtils.LIQUID_TYPE.NONE,
		breathingLiquidType = LiquidServiceUtils.LIQUID_TYPE.NONE,
		submersionRatio = 0,
		breathingSubmerged = false,
		meaningfulSubmersion = false,
		surfaceWorldY = nil,
		samples = {},
		typeWeights = {},
	}

	if typeof(characterRaw) ~= "Instance" or not characterRaw:IsA("Model") then
		return emptyResult
	end

	local rootPart = characterRaw:FindFirstChild("HumanoidRootPart")
	if rootPart == nil or not rootPart:IsA("BasePart") then
		rootPart = characterRaw.PrimaryPart
	end
	if rootPart == nil or not rootPart:IsA("BasePart") then
		return emptyResult
	end

	local height = math.max(2, rootPart.Size.Y + 2.5)
	local totalWeight = 0
	local submergedWeight = 0
	local dominantType = LiquidServiceUtils.LIQUID_TYPE.NONE
	local dominantWeight = -1
	local breathingSubmerged = false
	local breathingLiquidType = LiquidServiceUtils.LIQUID_TYPE.NONE
	local surfaceWorldY = nil :: number?
	local typeWeights: { [number]: number } = {}
	local samples: { LiquidSamplePoint } = {}

	for _, sampleDefinition in DEFAULT_SAMPLE_DEFINITIONS do
		local samplePosition = rootPart.Position + sampleDefinition.offset(rootPart, height)
		local sample =
			LiquidQuery.SampleWorldPoint(provider, sampleDefinition.name, samplePosition, sampleDefinition.weight)
		table.insert(samples, sample)
		totalWeight += sample.weight
		if sample.submerged then
			submergedWeight += sample.weight
			typeWeights[sample.liquidType] = (typeWeights[sample.liquidType] or 0) + sample.weight
			if sample.surfaceWorldY ~= nil then
				if surfaceWorldY == nil or sample.surfaceWorldY > surfaceWorldY then
					surfaceWorldY = sample.surfaceWorldY
				end
			end
			local definition = if provider.getLiquidDefinition ~= nil
				then provider.getLiquidDefinition(sample.liquidType)
				else nil
			if
				definition ~= nil
				and definition.blocksBreathing
				and (sample.name == "Head" or sample.name == "Chest")
			then
				breathingSubmerged = true
				if breathingLiquidType == LiquidServiceUtils.LIQUID_TYPE.NONE or sample.name == "Head" then
					breathingLiquidType = sample.liquidType
				end
			end
		end
	end

	for liquidType, weight in typeWeights do
		if weight > dominantWeight then
			dominantWeight = weight
			dominantType = liquidType
		end
	end

	local submersionRatio = if totalWeight > 0 then submergedWeight / totalWeight else 0
	local meaningfulSubmersion = submersionRatio >= 0.34 or breathingSubmerged
	return {
		inLiquid = submergedWeight > 0,
		dominantType = dominantType,
		breathingLiquidType = breathingLiquidType,
		submersionRatio = submersionRatio,
		breathingSubmerged = breathingSubmerged,
		meaningfulSubmersion = meaningfulSubmersion,
		surfaceWorldY = surfaceWorldY,
		samples = samples,
		typeWeights = typeWeights,
	}
end

LiquidServiceUtils.LiquidQuery = LiquidQuery

local LiquidDamage = {}

function LiquidDamage.ShouldBlockBreath(config: LiquidServiceConfig, queryResult: LiquidQueryResult): boolean
	local definition = config.definitions[queryResult.breathingLiquidType]
	if definition == nil then
		return false
	end
	return definition.supportsDrowning and queryResult.breathingSubmerged
end

function LiquidDamage.ShouldApplyLavaContact(config: LiquidServiceConfig, queryResult: LiquidQueryResult): boolean
	for liquidType, weight in queryResult.typeWeights do
		local definition = config.definitions[liquidType]
		if definition ~= nil and definition.isBurning and weight > 0 then
			return true
		end
	end
	return false
end

function LiquidDamage.GetLavaDefinition(config: LiquidServiceConfig): LiquidDefinition?
	return config.definitions[LiquidServiceUtils.LIQUID_TYPE.LAVA]
end

LiquidServiceUtils.LiquidDamage = LiquidDamage

local LiquidSolver = {}
local CELL_DEBUG_STATE = LiquidServiceUtils.CELL_DEBUG_STATE

local function getChunkCoordinatesForTile(access: LiquidSolverAccess, tileX: number, tileY: number): (number, number)
	local chunkSize = math.max(1, access.chunkSize)
	return LiquidServiceUtils.ToChunkCoordinate(tileX, chunkSize),
		LiquidServiceUtils.ToChunkCoordinate(tileY, chunkSize)
end

local function inspectOccupancy(
	access: LiquidSolverAccess,
	sourceChunkX: number,
	sourceChunkY: number,
	tileX: number,
	tileY: number,
	liquidType: number
)
	local targetChunkX, targetChunkY = getChunkCoordinatesForTile(access, tileX, tileY)
	if
		(targetChunkX ~= sourceChunkX or targetChunkY ~= sourceChunkY)
		and not access.isChunkReady(targetChunkX, targetChunkY)
	then
		return {
			queryable = false,
			canOccupy = false,
			fill = 0,
			blockedBySolid = false,
			waitingOnChunkReady = true,
			dependencyChunkKey = LiquidServiceUtils.PackChunkKey(targetChunkX, targetChunkY),
		}
	end
	if access.isSolid(tileX, tileY) then
		return {
			queryable = true,
			canOccupy = false,
			fill = 0,
			blockedBySolid = true,
			waitingOnChunkReady = false,
			dependencyChunkKey = nil,
		}
	end
	local packedCell = access.getCell(tileX, tileY)
	local existingType, existingFill = LiquidCell.Unpack(packedCell)
	if existingType ~= LiquidServiceUtils.LIQUID_TYPE.NONE and existingType ~= liquidType then
		return {
			queryable = true,
			canOccupy = false,
			fill = existingFill,
			blockedBySolid = false,
			waitingOnChunkReady = false,
			dependencyChunkKey = nil,
		}
	end
	return {
		queryable = true,
		canOccupy = true,
		fill = existingFill,
		blockedBySolid = false,
		waitingOnChunkReady = false,
		dependencyChunkKey = nil,
	}
end

local function recordMetric(access: LiquidSolverAccess, metricName: string, amountRaw: any?)
	if access.recordMetric ~= nil then
		access.recordMetric(metricName, amountRaw)
	end
end

local function reportCellState(
	access: LiquidSolverAccess,
	tileX: number,
	tileY: number,
	state: string,
	reason: string,
	fill: number,
	liquidType: number
)
	if access.reportCellState ~= nil then
		access.reportCellState(tileX, tileY, state, reason, fill, liquidType)
	end
end

local function addWakeTile(
	wakeTiles: { LiquidTileCoordinate },
	wakeLookup: { [string]: boolean },
	tileX: number,
	tileY: number
)
	local key = `{tileX}:{tileY}`
	if wakeLookup[key] then
		return
	end
	wakeLookup[key] = true
	table.insert(wakeTiles, {
		tileX = tileX,
		tileY = tileY,
	})
end

local function mergeWakeTiles(
	wakeTiles: { LiquidTileCoordinate },
	wakeLookup: { [string]: boolean },
	sourceTiles: { LiquidTileCoordinate }
)
	for _, tile in sourceTiles do
		addWakeTile(wakeTiles, wakeLookup, tile.tileX, tile.tileY)
	end
end

local function getLeakScanDistance(access: LiquidSolverAccess): number
	return sanitizeInteger(access.maxLeakScanDistance, 4, 256, 96)
end

local function wakeTile(
	access: LiquidSolverAccess,
	sourceTileX: number,
	sourceTileY: number,
	tileX: number,
	tileY: number,
	reason: string
)
	access.pushDirty(tileX, tileY, reason, sourceTileX, sourceTileY)
end

local function wakeInspectionTiles(
	access: LiquidSolverAccess,
	sourceTileX: number,
	sourceTileY: number,
	wakeTiles: { LiquidTileCoordinate },
	reason: string
)
	for _, wakeTileEntry in wakeTiles do
		wakeTile(access, sourceTileX, sourceTileY, wakeTileEntry.tileX, wakeTileEntry.tileY, reason)
	end
end

local function scanLeakPath(
	access: LiquidSolverAccess,
	tileX: number,
	tileY: number,
	liquidType: number,
	direction: number
)
	local wakeTiles: { LiquidTileCoordinate } = {}
	local wakeLookup: { [string]: boolean } = {}
	local maxDistance = getLeakScanDistance(access)
	local sourceChunkX, sourceChunkY = getChunkCoordinatesForTile(access, tileX, tileY)

	for distance = 1, maxDistance do
		local scanX = tileX + direction * distance
		local rowOccupancy = inspectOccupancy(access, sourceChunkX, sourceChunkY, scanX, tileY, liquidType)
		if rowOccupancy.waitingOnChunkReady then
			return {
				found = false,
				boundaryDependency = true,
				waitingOnChunkReady = true,
				dependencyChunkKey = rowOccupancy.dependencyChunkKey,
				distance = distance - 1,
				pathTiles = wakeTiles,
				reason = "awaitingCollisionChunk",
			}
		end
		if not rowOccupancy.canOccupy then
			return {
				found = false,
				boundaryDependency = false,
				waitingOnChunkReady = false,
				dependencyChunkKey = nil,
				distance = distance - 1,
				pathTiles = wakeTiles,
				reason = "sealedByWall",
			}
		end

		addWakeTile(wakeTiles, wakeLookup, scanX, tileY)
		local belowOccupancy = inspectOccupancy(access, sourceChunkX, sourceChunkY, scanX, tileY - 1, liquidType)
		if belowOccupancy.waitingOnChunkReady then
			return {
				found = false,
				boundaryDependency = true,
				waitingOnChunkReady = true,
				dependencyChunkKey = belowOccupancy.dependencyChunkKey,
				distance = distance,
				pathTiles = wakeTiles,
				reason = "awaitingCollisionChunkBelow",
			}
		end
		if belowOccupancy.canOccupy and belowOccupancy.fill < access.maxFill then
			addWakeTile(wakeTiles, wakeLookup, scanX, tileY - 1)
			return {
				found = true,
				boundaryDependency = false,
				waitingOnChunkReady = false,
				dependencyChunkKey = nil,
				distance = distance,
				pathTiles = wakeTiles,
				reason = "foundDrop",
			}
		end
	end

	return {
		found = false,
		boundaryDependency = true,
		waitingOnChunkReady = false,
		dependencyChunkKey = nil,
		distance = maxDistance,
		pathTiles = wakeTiles,
		reason = "scanLimitReached",
	}
end

local function inspectCellDetailed(access: LiquidSolverAccess, tileX: number, tileY: number)
	if access.isSolid(tileX, tileY) then
		return {
			hasLiquid = false,
			liquidType = LiquidServiceUtils.LIQUID_TYPE.NONE,
			fill = 0,
			isStable = true,
			state = CELL_DEBUG_STATE.BLOCKED,
			reason = "solidTile",
			canFlowDown = false,
			canEqualize = false,
			hasLeakPath = false,
			boundaryDependency = false,
			waitingOnChunkReady = false,
			dependencyChunkKey = nil,
			preferredDirection = 0,
			leakDistance = 0,
			wakeTiles = {},
			leftCanEqualize = false,
			rightCanEqualize = false,
			leftLeak = nil,
			rightLeak = nil,
			leftNeighborFill = 0,
			rightNeighborFill = 0,
		}
	end

	local packedCell = access.getCell(tileX, tileY)
	local liquidType, fill = LiquidCell.Unpack(packedCell)
	if liquidType == LiquidServiceUtils.LIQUID_TYPE.NONE or fill <= 0 then
		return {
			hasLiquid = false,
			liquidType = LiquidServiceUtils.LIQUID_TYPE.NONE,
			fill = 0,
			isStable = true,
			state = CELL_DEBUG_STATE.BLOCKED,
			reason = "emptyCell",
			canFlowDown = false,
			canEqualize = false,
			hasLeakPath = false,
			boundaryDependency = false,
			waitingOnChunkReady = false,
			dependencyChunkKey = nil,
			preferredDirection = 0,
			leakDistance = 0,
			wakeTiles = {},
			leftCanEqualize = false,
			rightCanEqualize = false,
			leftLeak = nil,
			rightLeak = nil,
			leftNeighborFill = 0,
			rightNeighborFill = 0,
		}
	end

	local definition = access.getDefinition(liquidType)
	local wakeTiles: { LiquidTileCoordinate } = {}
	local wakeLookup: { [string]: boolean } = {}
	addWakeTile(wakeTiles, wakeLookup, tileX, tileY)
	local sourceChunkX, sourceChunkY = getChunkCoordinatesForTile(access, tileX, tileY)

	if definition == nil then
		return {
			hasLiquid = true,
			liquidType = liquidType,
			fill = fill,
			isStable = false,
			state = CELL_DEBUG_STATE.ACTIVE,
			reason = "missingDefinition",
			canFlowDown = false,
			canEqualize = false,
			hasLeakPath = false,
			boundaryDependency = false,
			waitingOnChunkReady = false,
			dependencyChunkKey = nil,
			preferredDirection = 0,
			leakDistance = 0,
			wakeTiles = wakeTiles,
			leftCanEqualize = false,
			rightCanEqualize = false,
			leftLeak = nil,
			rightLeak = nil,
			leftNeighborFill = 0,
			rightNeighborFill = 0,
		}
	end

	local belowOccupancy = inspectOccupancy(access, sourceChunkX, sourceChunkY, tileX, tileY - 1, liquidType)
	local canFlowDown = belowOccupancy.canOccupy and belowOccupancy.fill < access.maxFill
	if canFlowDown then
		addWakeTile(wakeTiles, wakeLookup, tileX, tileY - 1)
	end

	local leftOccupancy = inspectOccupancy(access, sourceChunkX, sourceChunkY, tileX - 1, tileY, liquidType)
	local rightOccupancy = inspectOccupancy(access, sourceChunkX, sourceChunkY, tileX + 1, tileY, liquidType)
	local leftCanOccupy = leftOccupancy.canOccupy
	local rightCanOccupy = rightOccupancy.canOccupy
	local leftNeighborFill = leftOccupancy.fill
	local rightNeighborFill = rightOccupancy.fill
	local leftCanEqualize = leftCanOccupy
		and leftNeighborFill < access.maxFill
		and fill > leftNeighborFill + definition.settleEpsilon
	local rightCanEqualize = rightCanOccupy
		and rightNeighborFill < access.maxFill
		and fill > rightNeighborFill + definition.settleEpsilon

	if leftCanEqualize then
		addWakeTile(wakeTiles, wakeLookup, tileX - 1, tileY)
	end
	if rightCanEqualize then
		addWakeTile(wakeTiles, wakeLookup, tileX + 1, tileY)
	end

	local leftLeak = nil
	local rightLeak = nil
	local waitingOnChunkReady = belowOccupancy.waitingOnChunkReady
		or leftOccupancy.waitingOnChunkReady
		or rightOccupancy.waitingOnChunkReady
	local dependencyChunkKey = belowOccupancy.dependencyChunkKey
		or leftOccupancy.dependencyChunkKey
		or rightOccupancy.dependencyChunkKey
	if not canFlowDown and not waitingOnChunkReady then
		leftLeak = scanLeakPath(access, tileX, tileY, liquidType, -1)
		rightLeak = scanLeakPath(access, tileX, tileY, liquidType, 1)
		if leftLeak ~= nil then
			mergeWakeTiles(wakeTiles, wakeLookup, leftLeak.pathTiles)
		end
		if rightLeak ~= nil then
			mergeWakeTiles(wakeTiles, wakeLookup, rightLeak.pathTiles)
		end
	end

	local hasLeakPath = (leftLeak ~= nil and leftLeak.found) or (rightLeak ~= nil and rightLeak.found)
	local boundaryDependency = (leftLeak ~= nil and leftLeak.boundaryDependency)
		or (rightLeak ~= nil and rightLeak.boundaryDependency)
	waitingOnChunkReady = waitingOnChunkReady
		or (leftLeak ~= nil and leftLeak.waitingOnChunkReady)
		or (rightLeak ~= nil and rightLeak.waitingOnChunkReady)
	dependencyChunkKey = dependencyChunkKey
		or (if leftLeak ~= nil then leftLeak.dependencyChunkKey else nil)
		or (if rightLeak ~= nil then rightLeak.dependencyChunkKey else nil)
	if waitingOnChunkReady then
		boundaryDependency = true
	end
	local preferredDirection = 0
	local leakDistance = 0

	if leftLeak ~= nil and leftLeak.found and rightLeak ~= nil and rightLeak.found then
		if leftLeak.distance <= rightLeak.distance then
			preferredDirection = -1
			leakDistance = leftLeak.distance
		else
			preferredDirection = 1
			leakDistance = rightLeak.distance
		end
	elseif leftLeak ~= nil and leftLeak.found then
		preferredDirection = -1
		leakDistance = leftLeak.distance
	elseif rightLeak ~= nil and rightLeak.found then
		preferredDirection = 1
		leakDistance = rightLeak.distance
	elseif leftCanEqualize or rightCanEqualize then
		if leftCanEqualize and rightCanEqualize then
			if leftNeighborFill <= rightNeighborFill then
				preferredDirection = -1
			else
				preferredDirection = 1
			end
		elseif leftCanEqualize then
			preferredDirection = -1
		else
			preferredDirection = 1
		end
	elseif
		(leftLeak ~= nil and leftLeak.boundaryDependency and not (rightLeak ~= nil and rightLeak.boundaryDependency))
		or (leftOccupancy.waitingOnChunkReady and not rightOccupancy.waitingOnChunkReady)
	then
		preferredDirection = -1
	elseif
		(rightLeak ~= nil and rightLeak.boundaryDependency and not (leftLeak ~= nil and leftLeak.boundaryDependency))
		or (rightOccupancy.waitingOnChunkReady and not leftOccupancy.waitingOnChunkReady)
	then
		preferredDirection = 1
	end

	local canEqualize = leftCanEqualize or rightCanEqualize
	local isStable = not canFlowDown
		and not hasLeakPath
		and not canEqualize
		and not boundaryDependency
		and not waitingOnChunkReady
	local state = CELL_DEBUG_STATE.ACTIVE
	local reason = "containsEscapePath"

	if canFlowDown then
		state = CELL_DEBUG_STATE.FALLING
		reason = "airBelow"
	elseif waitingOnChunkReady then
		state = CELL_DEBUG_STATE.DEFERRED_WAITING_FOR_CHUNK
		reason = if dependencyChunkKey ~= nil
			then `awaitingCollisionChunk {dependencyChunkKey}`
			else "awaitingCollisionChunk"
	elseif hasLeakPath then
		state = CELL_DEBUG_STATE.SEARCHING_LEAK_PATH
		reason =
			`reachableDrop direction={(if preferredDirection < 0 then "left" else "right")} distance={leakDistance}`
	elseif boundaryDependency then
		state = CELL_DEBUG_STATE.SEARCHING_LEAK_PATH
		reason = "boundaryDependencyAwaitingLeakResolution"
	elseif canEqualize then
		state = CELL_DEBUG_STATE.EQUALIZING
		reason = "neighborCanAcceptLiquid"
	elseif isStable then
		if not leftCanOccupy and not rightCanOccupy then
			state = CELL_DEBUG_STATE.BLOCKED_BY_LOADED_TERRAIN
			reason = "downwardSealed lateralBlocked leakPathClear chunkReady"
		else
			state = CELL_DEBUG_STATE.STABLE
			reason = "downwardSealed lateralSealed leakPathClear chunkReady"
		end
	end

	return {
		hasLiquid = true,
		liquidType = liquidType,
		fill = fill,
		isStable = isStable,
		state = state,
		reason = reason,
		canFlowDown = canFlowDown,
		canEqualize = canEqualize,
		hasLeakPath = hasLeakPath,
		boundaryDependency = boundaryDependency,
		waitingOnChunkReady = waitingOnChunkReady,
		dependencyChunkKey = dependencyChunkKey,
		preferredDirection = preferredDirection,
		leakDistance = leakDistance,
		wakeTiles = wakeTiles,
		leftCanEqualize = leftCanEqualize,
		rightCanEqualize = rightCanEqualize,
		leftLeak = leftLeak,
		rightLeak = rightLeak,
		leftNeighborFill = leftNeighborFill,
		rightNeighborFill = rightNeighborFill,
	}
end

function LiquidSolver.InspectCell(access: LiquidSolverAccess, tileX: number, tileY: number)
	local inspection = inspectCellDetailed(access, tileX, tileY)
	reportCellState(access, tileX, tileY, inspection.state, inspection.reason, inspection.fill, inspection.liquidType)
	return inspection
end

local function commitCell(
	access: LiquidSolverAccess,
	tileX: number,
	tileY: number,
	liquidType: number,
	fill: number,
	flowState: number
)
	local packed = LiquidCell.Pack(liquidType, fill, flowState, 0)
	if access.setCell(tileX, tileY, packed) then
		for _, dx in { -1, 0, 1 } do
			for _, dy in { -1, 0, 1 } do
				wakeTile(access, tileX, tileY, tileX + dx, tileY + dy, "cellMutation")
			end
		end
	end
end

local function chooseDirectionOrder(tileX: number, tileY: number, preferredDirection: number): { number }
	if preferredDirection == -1 then
		return { -1, 1 }
	end
	if preferredDirection == 1 then
		return { 1, -1 }
	end
	if math.abs(tileX + tileY) % 2 == 0 then
		return { -1, 1 }
	end
	return { 1, -1 }
end

local function computeEqualizeTransfer(
	currentFill: number,
	neighborFill: number,
	definition: LiquidDefinition,
	maxFill: number
): number
	local capacity = maxFill - neighborFill
	if capacity <= 0 then
		return 0
	end
	local difference = currentFill - neighborFill
	if difference <= definition.settleEpsilon then
		return 0
	end
	local equalizedTarget = math.ceil((currentFill + neighborFill) * 0.5)
	local transfer = currentFill - equalizedTarget
	if transfer <= 0 then
		return 0
	end
	return math.min(
		math.max(1, math.floor(transfer * definition.sideEqualizeRate)),
		transfer,
		definition.maxSideTransfer,
		capacity
	)
end

local function computeLeakFeedTransfer(
	currentFill: number,
	neighborFill: number,
	definition: LiquidDefinition,
	maxFill: number,
	leakDistance: number
): number
	local capacity = maxFill - neighborFill
	if capacity <= 0 or currentFill <= 0 or currentFill < neighborFill then
		return 0
	end
	if leakDistance <= 1 then
		return math.min(currentFill, capacity, definition.maxSideTransfer)
	end
	return math.min(currentFill, capacity, definition.maxSideTransfer, math.max(1, math.floor(currentFill * 0.1)))
end

local function flowStateFromDebugState(state: string): number
	if state == CELL_DEBUG_STATE.FALLING then
		return LiquidServiceUtils.FLOW_STATE.FALLING
	end
	if state == CELL_DEBUG_STATE.EQUALIZING or state == CELL_DEBUG_STATE.SEARCHING_LEAK_PATH then
		return LiquidServiceUtils.FLOW_STATE.SPREADING
	end
	if state == CELL_DEBUG_STATE.ACTIVE then
		return LiquidServiceUtils.FLOW_STATE.SETTLING
	end
	return LiquidServiceUtils.FLOW_STATE.STILL
end

function LiquidSolver.StepCell(access: LiquidSolverAccess, tileX: number, tileY: number): LiquidSolverStepResult
	recordMetric(access, "solverIterations", 1)

	local originalPackedCell = access.getCell(tileX, tileY)
	local originalFlowState = LiquidCell.GetFlowState(originalPackedCell)
	local inspection = LiquidSolver.InspectCell(access, tileX, tileY)
	if not inspection.hasLiquid then
		return {
			changed = false,
			active = false,
			isStable = true,
			state = inspection.state,
			reason = inspection.reason,
			waitingOnChunkReady = inspection.waitingOnChunkReady,
			dependencyChunkKey = inspection.dependencyChunkKey,
			downwardTransfer = 0,
			lateralTransfer = 0,
			liquidType = inspection.liquidType,
			fill = inspection.fill,
			wakeTiles = inspection.wakeTiles,
		}
	end

	local definition = access.getDefinition(inspection.liquidType)
	if definition == nil then
		commitCell(access, tileX, tileY, LiquidServiceUtils.LIQUID_TYPE.NONE, 0, LiquidServiceUtils.FLOW_STATE.STILL)
		return {
			changed = true,
			active = true,
			isStable = false,
			state = CELL_DEBUG_STATE.ACTIVE,
			reason = "missingDefinition",
			waitingOnChunkReady = false,
			dependencyChunkKey = nil,
			downwardTransfer = 0,
			lateralTransfer = 0,
			liquidType = inspection.liquidType,
			fill = 0,
			wakeTiles = inspection.wakeTiles,
		}
	end

	local currentFill = inspection.fill
	local changed = false
	local downwardTransfer = 0
	local lateralTransfer = 0
	local sourceChunkX, sourceChunkY = getChunkCoordinatesForTile(access, tileX, tileY)

	if inspection.canFlowDown then
		local belowOccupancy =
			inspectOccupancy(access, sourceChunkX, sourceChunkY, tileX, tileY - 1, inspection.liquidType)
		downwardTransfer = math.min(currentFill, access.maxFill - belowOccupancy.fill)
		if downwardTransfer > 0 then
			currentFill -= downwardTransfer
			commitCell(
				access,
				tileX,
				tileY - 1,
				inspection.liquidType,
				belowOccupancy.fill + downwardTransfer,
				LiquidServiceUtils.FLOW_STATE.FALLING
			)
			changed = true
			recordMetric(access, "downwardTransfers", downwardTransfer)
		end
	end

	if currentFill > 0 and downwardTransfer <= 0 then
		for _, direction in chooseDirectionOrder(tileX, tileY, inspection.preferredDirection) do
			local neighborX = tileX + direction
			local neighborOccupancy =
				inspectOccupancy(access, sourceChunkX, sourceChunkY, neighborX, tileY, inspection.liquidType)
			if not neighborOccupancy.canOccupy then
				continue
			end

			local transfer = computeEqualizeTransfer(currentFill, neighborOccupancy.fill, definition, access.maxFill)
			local leakInfo = if direction < 0 then inspection.leftLeak else inspection.rightLeak
			local leakDistance = if leakInfo ~= nil then leakInfo.distance else 0
			if leakInfo ~= nil and (leakInfo.found or leakInfo.boundaryDependency) then
				transfer = math.max(
					transfer,
					computeLeakFeedTransfer(
						currentFill,
						neighborOccupancy.fill,
						definition,
						access.maxFill,
						leakDistance
					)
				)
			end

			if transfer <= 0 then
				continue
			end

			currentFill -= transfer
			lateralTransfer += transfer
			commitCell(
				access,
				neighborX,
				tileY,
				inspection.liquidType,
				neighborOccupancy.fill + transfer,
				LiquidServiceUtils.FLOW_STATE.SPREADING
			)
			changed = true
			recordMetric(access, "lateralTransfers", transfer)
			if currentFill <= 0 then
				break
			end
		end
	end

	local currentState = if downwardTransfer > 0
		then LiquidServiceUtils.FLOW_STATE.SETTLING
		elseif lateralTransfer > 0 then LiquidServiceUtils.FLOW_STATE.SPREADING
		else flowStateFromDebugState(inspection.state)
	if currentFill ~= inspection.fill or currentState ~= originalFlowState then
		changed = true
	end
	commitCell(access, tileX, tileY, inspection.liquidType, currentFill, currentState)

	local finalInspection = LiquidSolver.InspectCell(access, tileX, tileY)
	local isActive = not finalInspection.isStable
	if isActive and not changed and not finalInspection.waitingOnChunkReady then
		wakeInspectionTiles(access, tileX, tileY, finalInspection.wakeTiles, `unstable:{finalInspection.state}`)
		recordMetric(access, "activeCells", 1)
	elseif isActive then
		recordMetric(access, "activeCells", 1)
	end

	return {
		changed = changed,
		active = isActive,
		isStable = finalInspection.isStable,
		state = finalInspection.state,
		reason = finalInspection.reason,
		waitingOnChunkReady = finalInspection.waitingOnChunkReady,
		dependencyChunkKey = finalInspection.dependencyChunkKey,
		downwardTransfer = downwardTransfer,
		lateralTransfer = lateralTransfer,
		liquidType = inspection.liquidType,
		fill = currentFill,
		wakeTiles = finalInspection.wakeTiles,
	}
end

function LiquidSolver.SettleGrid(
	config: LiquidServiceConfig,
	cells: { number },
	width: number,
	height: number,
	isSolid: (tileX: number, tileY: number) -> boolean,
	passesRaw: any?
): { number }
	local settled = Sift.Dictionary.copy(cells)
	local passes = sanitizeInteger(passesRaw, 0, 256, config.simulation.generationSettlePasses)

	local function getCell(tileX: number, tileY: number): number
		if tileX < 0 or tileX >= width or tileY < 0 or tileY >= height then
			return 0
		end
		return settled[LiquidServiceUtils.ComputeTileIndex(tileX, tileY, width)] or 0
	end

	local function setCell(tileX: number, tileY: number, packedCell: number): boolean
		if tileX < 0 or tileX >= width or tileY < 0 or tileY >= height then
			return false
		end
		local index = LiquidServiceUtils.ComputeTileIndex(tileX, tileY, width)
		if settled[index] == packedCell then
			return false
		end
		settled[index] = packedCell
		return true
	end

	local noop = function(
		_tileX: number,
		_tileY: number,
		_reason: string?,
		_sourceTileX: number?,
		_sourceTileY: number?
	)
	end
	local access: LiquidSolverAccess = {
		maxFill = config.maxFill,
		chunkSize = math.max(1, width),
		maxLeakScanDistance = config.simulation.leakScanDistanceTiles,
		getCell = getCell,
		setCell = setCell,
		isSolid = isSolid,
		isChunkReady = function(_chunkX: number, _chunkY: number): boolean
			return true
		end,
		pushDirty = noop,
		getDefinition = function(liquidType: number): LiquidDefinition?
			return config.definitions[liquidType]
		end,
	}

	for _ = 1, passes do
		local changed = false
		for rowY = 0, height - 1 do
			for localX = 0, width - 1 do
				local stepResult = LiquidSolver.StepCell(access, localX, rowY)
				if stepResult.changed then
					changed = true
				end
			end
		end
		if not changed then
			break
		end
	end

	return settled
end

LiquidServiceUtils.LiquidSolver = LiquidSolver

LiquidServiceUtils.packChunkKey = LiquidServiceUtils.PackChunkKey
LiquidServiceUtils.unpackChunkKey = LiquidServiceUtils.UnpackChunkKey
LiquidServiceUtils.computeTileIndex = LiquidServiceUtils.ComputeTileIndex
LiquidServiceUtils.toTileCoordinate = LiquidServiceUtils.ToTileCoordinate
LiquidServiceUtils.toChunkCoordinate = LiquidServiceUtils.ToChunkCoordinate
LiquidServiceUtils.tileToWorldCenter = LiquidServiceUtils.TileToWorldCenter
LiquidCell.pack = LiquidCell.Pack
LiquidCell.unpack = LiquidCell.Unpack
LiquidCell.getType = LiquidCell.GetType
LiquidCell.getFill = LiquidCell.GetFill
LiquidCell.getFlowState = LiquidCell.GetFlowState
LiquidCell.isEmpty = LiquidCell.IsEmpty
LiquidCell.isFull = LiquidCell.IsFull
LiquidCell.withFill = LiquidCell.WithFill
LiquidCell.withFlowState = LiquidCell.WithFlowState
LiquidCell.make = LiquidCell.Make
LiquidServiceUtils.createDefaultConfig = LiquidServiceUtils.CreateDefaultConfig
LiquidServiceUtils.sanitizeConfig = LiquidServiceUtils.SanitizeConfig
LiquidServiceUtils.createDefaultState = LiquidServiceUtils.CreateDefaultState
LiquidServiceUtils.createState = LiquidServiceUtils.CreateState
LiquidServiceUtils.cloneState = LiquidServiceUtils.CloneState
LiquidServiceUtils.getDefinition = LiquidServiceUtils.GetDefinition
LiquidColor.resolveWaterTint = LiquidColor.ResolveWaterTint
LiquidColor.resolveLavaAmbientTint = LiquidColor.ResolveLavaAmbientTint
LiquidColor.sampleWaterColorAtWorldPosition = LiquidColor.SampleWaterColorAtWorldPosition
LiquidColor.resolveLiquidColor = LiquidColor.ResolveLiquidColor
LiquidMesher.buildBackgroundVisualCells = LiquidMesher.BuildBackgroundVisualCells
LiquidMesher.buildRowDescriptors = LiquidMesher.BuildRowDescriptors
LiquidMesher.getAffectedRowsForChanges = LiquidMesher.GetAffectedRowsForChanges
LiquidQuery.worldToTile = LiquidQuery.WorldToTile
LiquidQuery.getSurfaceWorldY = LiquidQuery.GetSurfaceWorldY
LiquidQuery.sampleWorldPoint = LiquidQuery.SampleWorldPoint
LiquidQuery.queryCharacter = LiquidQuery.QueryCharacter
LiquidDamage.shouldBlockBreath = LiquidDamage.ShouldBlockBreath
LiquidDamage.shouldApplyLavaContact = LiquidDamage.ShouldApplyLavaContact
LiquidDamage.getLavaDefinition = LiquidDamage.GetLavaDefinition
LiquidSolver.inspectCell = LiquidSolver.InspectCell
LiquidSolver.stepCell = LiquidSolver.StepCell
LiquidSolver.settleGrid = LiquidSolver.SettleGrid

return LiquidServiceUtils
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="1305">
              <Properties>
                <string name="Name">LootCache</string>
                <string name="Source"><![CDATA[--!strict

local Cache = {}
Cache.__index = Cache

type DroppedToolEntry = {
	itemId: string,
	ownerUserId: number?,
	tools: { Tool },
	createdAt: number,
}

local function sanitizeString(raw: any): string?
	if typeof(raw) ~= "string" then
		return nil
	end
	local trimmed = string.match(raw, "^%s*(.-)%s*$")
	if trimmed == nil or trimmed == "" then
		return nil
	end
	return trimmed
end

local function sanitizeUserId(raw: any): number?
	if typeof(raw) ~= "number" or raw ~= raw then
		return nil
	end
	local userId = math.floor(raw)
	if userId <= 0 then
		return nil
	end
	return userId
end

local function resolveToolArray(toolsRaw: any): { Tool }
	local output = {}
	if typeof(toolsRaw) ~= "table" then
		return output
	end

	for _, value in toolsRaw do
		if typeof(value) == "Instance" and value:IsA("Tool") then
			local tool = value :: Tool
			tool.Parent = nil
			table.insert(output, tool)
		end
	end
	return output
end

function Cache.New(): Cache
	local self = setmetatable({
		droppedToolsByLootId = {} :: { [string]: DroppedToolEntry },
		toolTemplateByItemId = {} :: { [string]: Tool | boolean },
	}, Cache)

	return self
end

function Cache.RememberToolTemplate(self: Cache, itemIdRaw: any, templateRaw: any): boolean
	local itemId = sanitizeString(itemIdRaw)
	if itemId == nil then
		return false
	end
	if typeof(templateRaw) ~= "Instance" or not templateRaw:IsA("Tool") then
		return false
	end

	self.toolTemplateByItemId[itemId] = templateRaw :: Tool
	return true
end

function Cache.CloneToolTemplate(self: Cache, itemIdRaw: any): Tool?
	local itemId = sanitizeString(itemIdRaw)
	if itemId == nil then
		return nil
	end

	local cached = self.toolTemplateByItemId[itemId]
	if cached == nil or cached == false then
		return nil
	end

	local template = cached :: Tool
	if template.Parent == nil then
		self.toolTemplateByItemId[itemId] = nil
		return nil
	end

	local clone = template:Clone()
	if not clone:IsA("Tool") then
		clone:Destroy()
		return nil
	end
	clone.Parent = nil
	return clone
end

function Cache.DiscardDroppedTools(self: Cache, lootIdRaw: any)
	local lootId = sanitizeString(lootIdRaw)
	if lootId == nil then
		return
	end

	local existing = self.droppedToolsByLootId[lootId]
	if existing == nil then
		return
	end

	for _, tool in existing.tools do
		tool:Destroy()
	end
	self.droppedToolsByLootId[lootId] = nil
end

function Cache.CacheDroppedTools(
	self: Cache,
	lootIdRaw: any,
	itemIdRaw: any,
	ownerUserIdRaw: any,
	toolsRaw: any
): number
	local lootId = sanitizeString(lootIdRaw)
	local itemId = sanitizeString(itemIdRaw)
	if lootId == nil or itemId == nil then
		return 0
	end

	local tools = resolveToolArray(toolsRaw)
	if #tools <= 0 then
		return 0
	end

	self:discardDroppedTools(lootId)
	self.droppedToolsByLootId[lootId] = {
		itemId = itemId,
		ownerUserId = sanitizeUserId(ownerUserIdRaw),
		tools = tools,
		createdAt = os.clock(),
	}
	return #tools
end

function Cache.PopDroppedTool(self: Cache, lootIdRaw: any, itemIdRaw: any): Tool?
	local lootId = sanitizeString(lootIdRaw)
	local expectedItemId = sanitizeString(itemIdRaw)
	if lootId == nil or expectedItemId == nil then
		return nil
	end

	local entry = self.droppedToolsByLootId[lootId]
	if entry == nil then
		return nil
	end
	if entry.itemId ~= expectedItemId then
		return nil
	end

	local lastIndex = #entry.tools
	if lastIndex <= 0 then
		self.droppedToolsByLootId[lootId] = nil
		return nil
	end

	local tool = entry.tools[lastIndex]
	entry.tools[lastIndex] = nil
	if #entry.tools <= 0 then
		self.droppedToolsByLootId[lootId] = nil
	end
	return tool
end

function Cache.Destroy(self: Cache)
	for lootId in self.droppedToolsByLootId do
		self:discardDroppedTools(lootId)
	end
	table.clear(self.toolTemplateByItemId)
end

export type Cache = typeof(setmetatable(
	{} :: {
		droppedToolsByLootId: { [string]: DroppedToolEntry },
		toolTemplateByItemId: { [string]: Tool | boolean },
	},
	Cache
))

Cache.new = Cache.New
Cache.rememberToolTemplate = Cache.RememberToolTemplate
Cache.cloneToolTemplate = Cache.CloneToolTemplate
Cache.discardDroppedTools = Cache.DiscardDroppedTools
Cache.cacheDroppedTools = Cache.CacheDroppedTools
Cache.popDroppedTool = Cache.PopDroppedTool
Cache.destroy = Cache.Destroy

return Cache
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="1306">
              <Properties>
                <string name="Name">LootServiceUtils</string>
                <string name="Source"><![CDATA[--!strict
local LootServiceUtils = {}

export type LootRarity = "Common" | "Uncommon" | "Rare" | "Epic" | "Legendary"
export type LootState = "Dropped" | "Settling" | "Idle" | "Magnetized" | "Collected"
export type LootMetadata = { [string]: any }

export type LootItemConfig = {
	maxStack: number,
	rarity: LootRarity,
}

export type LootSettings = {
	despawnSeconds: number,
	fixedStep: number,
	maxSimulationStepsPerHeartbeat: number,
	lockTo2DPlane: boolean,
	droppedStateDuration: number,
	settleMinDuration: number,
	settleMaxDuration: number,
	settleLinearSpeedThreshold: number,
	settleAngularSpeedThreshold: number,
	settleStableDuration: number,
	dropImpulseForward: number,
	dropImpulseUp: number,
	dropImpulseRandomHorizontal: number,
	dropImpulseRandomUp: number,
	dropAngularVelocity: number,
	dropBounciness: number,
	dropFriction: number,
	dropElasticityWeight: number,
	pickupScanRadius: number,
	collectDistance: number,
	collectOffsetY: number,
	magnetBaseSpeed: number,
	magnetAcceleration: number,
	magnetMaxSpeed: number,
	magnetSpringFrequency: number,
	magnetSpringFrequencyRamp: number,
	magnetSpringFrequencyCloseBoost: number,
	magnetSpringDamping: number,
	magnetSpeedBlend: number,
	magnetCooldownAfterFailedCollect: number,
	ownerLockSeconds: number,
	playerDropOwnerLockSeconds: number,
	playerDropForwardOffset: number,
	playerDropUpOffset: number,
	spawnHeightOffset: number,
	scatterRadiusMin: number,
	scatterRadiusMax: number,
	dropAmountDefault: number,
	dropAmountMin: number,
	dropAmountMax: number,
}

export type LootRollContext = {
	luck: number?,
	quantityMultiplier: number?,
	sourceType: string?,
}

export type LootRollResult = {
	itemId: string,
	amount: number,
	maxStack: number,
	metadata: LootMetadata?,
	rarity: LootRarity,
	sourceType: string,
}

LootServiceUtils.STATE_DROPPED = "Dropped"
LootServiceUtils.STATE_SETTLING = "Settling"
LootServiceUtils.STATE_IDLE = "Idle"
LootServiceUtils.STATE_MAGNETIZED = "Magnetized"
LootServiceUtils.STATE_COLLECTED = "Collected"

LootServiceUtils.NETWORK_METHOD_REQUEST_SYNC = "requestSync"
LootServiceUtils.NETWORK_METHOD_REQUEST_DROP_SLOT = "requestDropFromSlot"
LootServiceUtils.NETWORK_METHOD_REQUEST_DROP_SELECTED = "requestDropSelectedSlot"

local DEFAULT_RARITY: LootRarity = "Common"
local DEFAULT_SOURCE_TYPE = "Unknown"
local DEFAULT_ITEM_MAX_STACK = 99

local DEFAULT_ITEM_CONFIG: LootItemConfig = {
	maxStack = DEFAULT_ITEM_MAX_STACK,
	rarity = DEFAULT_RARITY,
}

local DEFAULT_SETTINGS: LootSettings = {
	despawnSeconds = 120,
	fixedStep = 1 / 60,
	maxSimulationStepsPerHeartbeat = 4,
	lockTo2DPlane = true,
	droppedStateDuration = 0.05,
	settleMinDuration = 0.12,
	settleMaxDuration = 1.8,
	settleLinearSpeedThreshold = 1.2,
	settleAngularSpeedThreshold = 3.6,
	settleStableDuration = 0.16,
	dropImpulseForward = 26,
	dropImpulseUp = 18,
	dropImpulseRandomHorizontal = 10,
	dropImpulseRandomUp = 6,
	dropAngularVelocity = 10,
	dropBounciness = 0.35,
	dropFriction = 0.55,
	dropElasticityWeight = 1,
	pickupScanRadius = 16,
	collectDistance = 2.05,
	collectOffsetY = 1.35,
	magnetBaseSpeed = 22,
	magnetAcceleration = 110,
	magnetMaxSpeed = 170,
	magnetSpringFrequency = 9.5,
	magnetSpringFrequencyRamp = 6.5,
	magnetSpringFrequencyCloseBoost = 9.5,
	magnetSpringDamping = 1.05,
	magnetSpeedBlend = 0.52,
	magnetCooldownAfterFailedCollect = 0.25,
	ownerLockSeconds = 1.1,
	playerDropOwnerLockSeconds = 0.45,
	playerDropForwardOffset = 3.5,
	playerDropUpOffset = 1.4,
	spawnHeightOffset = 0.35,
	scatterRadiusMin = 0.9,
	scatterRadiusMax = 3.2,
	dropAmountDefault = 1,
	dropAmountMin = 1,
	dropAmountMax = 9999,
}

local ALLOWED_STATE_TRANSITIONS: { [LootState]: { [LootState]: boolean } } = {
	Dropped = {
		Settling = true,
		Collected = true,
	},
	Settling = {
		Idle = true,
		Collected = true,
	},
	Idle = {
		Magnetized = true,
		Collected = true,
	},
	Magnetized = {
		Idle = true,
		Collected = true,
	},
	Collected = {},
}

type SanitizedDropEntry = {
	itemId: string,
	weight: number,
	amountMin: number,
	amountMax: number,
	chance: number,
	luckChanceScale: number,
	luckWeightScale: number,
	metadata: LootMetadata?,
}

local function trim(textRaw: any): string
	if typeof(textRaw) ~= "string" then
		return ""
	end
	return string.match(textRaw, "^%s*(.-)%s*$") or ""
end

local function sanitizeString(raw: any, fallback: string?): string?
	local value = trim(raw)
	if value == "" then
		return fallback
	end
	return value
end

local function token(raw: any): string
	local value = string.lower(trim(raw))
	if value == "" then
		return ""
	end
	return string.gsub(value, "[%s_%-%.]+", "")
end

local function sanitizeNumber(raw: any, fallback: number, minValue: number?, maxValue: number?): number
	local value = fallback
	if typeof(raw) == "number" and raw == raw then
		value = raw
	elseif typeof(raw) == "string" then
		local parsed = tonumber(trim(raw))
		if parsed ~= nil and parsed == parsed then
			value = parsed
		end
	end

	if minValue ~= nil and value < minValue then
		value = minValue
	end
	if maxValue ~= nil and value > maxValue then
		value = maxValue
	end
	return value
end

local function sanitizeInteger(raw: any, fallback: number, minValue: number, maxValue: number?): number
	local value = math.floor(sanitizeNumber(raw, fallback, minValue, maxValue))
	if value < minValue then
		value = minValue
	end
	if maxValue ~= nil and value > maxValue then
		value = maxValue
	end
	return value
end

local function sanitizeVector3(raw: any, fallback: Vector3): Vector3
	if typeof(raw) == "Vector3" then
		return raw
	end

	if typeof(raw) ~= "table" then
		return fallback
	end

	local source = raw :: { [string]: any }
	local xRaw = source.x
	if typeof(xRaw) ~= "number" then
		xRaw = source.X
	end
	local yRaw = source.y
	if typeof(yRaw) ~= "number" then
		yRaw = source.Y
	end
	local zRaw = source.z
	if typeof(zRaw) ~= "number" then
		zRaw = source.Z
	end
	if typeof(xRaw) ~= "number" or typeof(yRaw) ~= "number" or typeof(zRaw) ~= "number" then
		return fallback
	end
	return Vector3.new(xRaw, yRaw, zRaw)
end

local function cloneDeepInternal(value: any, seen: { [any]: any }): any
	if typeof(value) ~= "table" then
		return value
	end

	local existing = seen[value]
	if existing ~= nil then
		return existing
	end

	local output = {}
	seen[value] = output
	for key, nestedValue in value do
		local clonedKey = cloneDeepInternal(key, seen)
		output[clonedKey] = cloneDeepInternal(nestedValue, seen)
	end
	return output
end

local function deepEqualInternal(lhs: any, rhs: any, seen: { [any]: any }): boolean
	if lhs == rhs then
		return true
	end
	if typeof(lhs) ~= "table" or typeof(rhs) ~= "table" then
		return false
	end

	local seenRhs = seen[lhs]
	if seenRhs ~= nil then
		return seenRhs == rhs
	end
	seen[lhs] = rhs

	for key, lhsValue in lhs do
		if not deepEqualInternal(lhsValue, rhs[key], seen) then
			return false
		end
	end
	for key in rhs do
		if lhs[key] == nil then
			return false
		end
	end

	return true
end

local function sanitizeRarity(raw: any, fallback: LootRarity?): LootRarity
	if raw == "Common" then
		return "Common"
	end
	if raw == "Uncommon" then
		return "Uncommon"
	end
	if raw == "Rare" then
		return "Rare"
	end
	if raw == "Epic" then
		return "Epic"
	end
	if raw == "Legendary" then
		return "Legendary"
	end
	return fallback or DEFAULT_RARITY
end

local function sanitizeState(raw: any, fallback: LootState?): LootState
	if raw == "Dropped" then
		return "Dropped"
	end
	if raw == "Settling" then
		return "Settling"
	end
	if raw == "Idle" then
		return "Idle"
	end
	if raw == "Magnetized" then
		return "Magnetized"
	end
	if raw == "Collected" then
		return "Collected"
	end
	return fallback or "Dropped"
end

local function sanitizeMetadata(raw: any): LootMetadata?
	if typeof(raw) ~= "table" then
		return nil
	end
	return cloneDeepInternal(raw, {})
end

local function hasDropTable(dropTablesRaw: any, tableIdRaw: any): boolean
	if typeof(dropTablesRaw) ~= "table" then
		return false
	end
	local tableId = sanitizeString(tableIdRaw, nil)
	if tableId == nil then
		return false
	end
	return typeof((dropTablesRaw :: { [string]: any })[tableId]) == "table"
end

local function normalizeDropTableAliasMap(dataRaw: any): { [string]: string }
	local output = {}
	if typeof(dataRaw) ~= "table" then
		return output
	end

	local aliasesRaw = (dataRaw :: { [string]: any }).sourceAliases
	if typeof(aliasesRaw) ~= "table" then
		return output
	end

	for aliasRaw, tableIdRaw in aliasesRaw do
		local alias = token(aliasRaw)
		local tableId = sanitizeString(tableIdRaw, nil)
		if alias ~= "" and tableId ~= nil then
			output[alias] = tableId
		end
	end

	return output
end

local function sanitizeDropEntry(raw: any): SanitizedDropEntry?
	if typeof(raw) ~= "table" then
		return nil
	end

	local source = raw :: { [string]: any }
	local itemId = sanitizeString(source.itemId, nil)
	if itemId == nil then
		return nil
	end

	local weight = sanitizeNumber(source.weight, 1, 0, 100000)
	if weight <= 0 then
		return nil
	end

	local amountMin = sanitizeInteger(source.amountMin, 1, 1, 100000)
	local amountMax = sanitizeInteger(source.amountMax, amountMin, amountMin, 100000)

	return {
		itemId = itemId,
		weight = weight,
		amountMin = amountMin,
		amountMax = amountMax,
		chance = sanitizeNumber(source.chance, 1, 0, 1),
		luckChanceScale = sanitizeNumber(source.luckChanceScale, 0, -4, 4),
		luckWeightScale = sanitizeNumber(source.luckWeightScale, 0, -10000, 10000),
		metadata = sanitizeMetadata(source.metadata),
	}
end

local function chooseWeightedEntry(entriesRaw: any, randomObject: Random, luck: number): SanitizedDropEntry?
	if typeof(entriesRaw) ~= "table" then
		return nil
	end

	local weightedEntries: { { entry: SanitizedDropEntry, weight: number } } = {}
	local totalWeight = 0
	for _, rawEntry in entriesRaw do
		local entry = sanitizeDropEntry(rawEntry)
		if entry == nil then
			continue
		end

		local chance = math.clamp(entry.chance + luck * entry.luckChanceScale, 0, 1)
		if randomObject:NextNumber() > chance then
			continue
		end

		local weight = math.max(0, entry.weight + luck * entry.luckWeightScale)
		if weight <= 0 then
			continue
		end

		totalWeight += weight
		table.insert(weightedEntries, {
			entry = entry,
			weight = weight,
		})
	end

	if totalWeight <= 0 then
		return nil
	end

	local roll = randomObject:NextNumber(0, totalWeight)
	local cursor = 0
	for _, candidate in weightedEntries do
		cursor += candidate.weight
		if roll <= cursor then
			return candidate.entry
		end
	end

	return weightedEntries[#weightedEntries].entry
end

local function appendDropResult(
	output: { LootRollResult },
	dataRaw: any,
	entry: SanitizedDropEntry,
	randomObject: Random,
	quantityMultiplier: number,
	sourceType: string
)
	local baseAmount = if entry.amountMax > entry.amountMin
		then randomObject:NextInteger(entry.amountMin, entry.amountMax)
		else entry.amountMin
	local amount = math.max(1, math.floor(baseAmount * quantityMultiplier + 0.5))
	local itemConfig = LootServiceUtils.ResolveItemConfig(dataRaw, entry.itemId)
	table.insert(output, {
		itemId = entry.itemId,
		amount = amount,
		maxStack = itemConfig.maxStack,
		metadata = cloneDeepInternal(entry.metadata, {}),
		rarity = itemConfig.rarity,
		sourceType = sourceType,
	})
end

local function getDropTable(dataRaw: any, tableIdRaw: any): { [string]: any }?
	if typeof(dataRaw) ~= "table" then
		return nil
	end
	local dropTablesRaw = (dataRaw :: { [string]: any }).dropTables
	if typeof(dropTablesRaw) ~= "table" then
		return nil
	end

	local tableId = sanitizeString(tableIdRaw, nil)
	if tableId == nil then
		return nil
	end
	local dropTable = (dropTablesRaw :: { [string]: any })[tableId]
	if typeof(dropTable) ~= "table" then
		return nil
	end
	return dropTable
end

local function appendUniqueString(output: { string }, seen: { [string]: boolean }, valueRaw: any)
	local value = sanitizeString(valueRaw, nil)
	if value == nil then
		return
	end
	if seen[value] then
		return
	end
	seen[value] = true
	table.insert(output, value)
end

function LootServiceUtils.SanitizeString(raw: any, fallback: string?): string?
	return sanitizeString(raw, fallback)
end

function LootServiceUtils.Token(raw: any): string
	return token(raw)
end

function LootServiceUtils.SanitizeNumber(raw: any, fallback: number, minValue: number?, maxValue: number?): number
	return sanitizeNumber(raw, fallback, minValue, maxValue)
end

function LootServiceUtils.SanitizeInteger(raw: any, fallback: number, minValue: number, maxValue: number?): number
	return sanitizeInteger(raw, fallback, minValue, maxValue)
end

function LootServiceUtils.SanitizeVector3(raw: any, fallback: Vector3): Vector3
	return sanitizeVector3(raw, fallback)
end

function LootServiceUtils.SanitizeRarity(raw: any, fallback: LootRarity?): LootRarity
	return sanitizeRarity(raw, fallback)
end

function LootServiceUtils.SanitizeState(raw: any, fallback: LootState?): LootState
	return sanitizeState(raw, fallback)
end

function LootServiceUtils.CloneDeep(value: any): any
	return cloneDeepInternal(value, {})
end

function LootServiceUtils.DeepEqual(lhs: any, rhs: any): boolean
	return deepEqualInternal(lhs, rhs, {})
end

function LootServiceUtils.ResolveSettings(dataRaw: any): LootSettings
	local settingsRaw = if typeof(dataRaw) == "table" then (dataRaw :: { [string]: any }).settings else nil
	local settings = if typeof(settingsRaw) == "table" then settingsRaw else {}

	local scatterRadiusMin = sanitizeNumber(
		(settings :: any).scatterRadiusMin,
		DEFAULT_SETTINGS.scatterRadiusMin,
		0,
		100
	)
	local scatterRadiusMax = sanitizeNumber(
		(settings :: any).scatterRadiusMax,
		DEFAULT_SETTINGS.scatterRadiusMax,
		scatterRadiusMin,
		100
	)

	return {
		despawnSeconds = sanitizeNumber((settings :: any).despawnSeconds, DEFAULT_SETTINGS.despawnSeconds, 1, 3600),
		fixedStep = sanitizeNumber((settings :: any).fixedStep, DEFAULT_SETTINGS.fixedStep, 1 / 240, 1 / 10),
		maxSimulationStepsPerHeartbeat = sanitizeInteger(
			(settings :: any).maxSimulationStepsPerHeartbeat,
			DEFAULT_SETTINGS.maxSimulationStepsPerHeartbeat,
			1,
			16
		),
		lockTo2DPlane = if (settings :: any).lockTo2DPlane == nil
			then DEFAULT_SETTINGS.lockTo2DPlane
			else (settings :: any).lockTo2DPlane == true,
		droppedStateDuration = sanitizeNumber(
			(settings :: any).droppedStateDuration,
			DEFAULT_SETTINGS.droppedStateDuration,
			0,
			2
		),
		settleMinDuration = sanitizeNumber(
			(settings :: any).settleMinDuration,
			DEFAULT_SETTINGS.settleMinDuration,
			0,
			4
		),
		settleMaxDuration = sanitizeNumber(
			(settings :: any).settleMaxDuration,
			DEFAULT_SETTINGS.settleMaxDuration,
			0.05,
			12
		),
		settleLinearSpeedThreshold = sanitizeNumber(
			(settings :: any).settleLinearSpeedThreshold,
			DEFAULT_SETTINGS.settleLinearSpeedThreshold,
			0.01,
			100
		),
		settleAngularSpeedThreshold = sanitizeNumber(
			(settings :: any).settleAngularSpeedThreshold,
			DEFAULT_SETTINGS.settleAngularSpeedThreshold,
			0.01,
			200
		),
		settleStableDuration = sanitizeNumber(
			(settings :: any).settleStableDuration,
			DEFAULT_SETTINGS.settleStableDuration,
			0.01,
			4
		),
		dropImpulseForward = sanitizeNumber(
			(settings :: any).dropImpulseForward,
			DEFAULT_SETTINGS.dropImpulseForward,
			0,
			300
		),
		dropImpulseUp = sanitizeNumber((settings :: any).dropImpulseUp, DEFAULT_SETTINGS.dropImpulseUp, 0, 300),
		dropImpulseRandomHorizontal = sanitizeNumber(
			(settings :: any).dropImpulseRandomHorizontal,
			DEFAULT_SETTINGS.dropImpulseRandomHorizontal,
			0,
			300
		),
		dropImpulseRandomUp = sanitizeNumber(
			(settings :: any).dropImpulseRandomUp,
			DEFAULT_SETTINGS.dropImpulseRandomUp,
			0,
			300
		),
		dropAngularVelocity = sanitizeNumber(
			(settings :: any).dropAngularVelocity,
			DEFAULT_SETTINGS.dropAngularVelocity,
			0,
			200
		),
		dropBounciness = sanitizeNumber(
			(settings :: any).dropBounciness,
			DEFAULT_SETTINGS.dropBounciness,
			0,
			1
		),
		dropFriction = sanitizeNumber((settings :: any).dropFriction, DEFAULT_SETTINGS.dropFriction, 0, 1),
		dropElasticityWeight = sanitizeNumber(
			(settings :: any).dropElasticityWeight,
			DEFAULT_SETTINGS.dropElasticityWeight,
			0,
			100
		),
		pickupScanRadius = sanitizeNumber(
			(settings :: any).pickupScanRadius,
			DEFAULT_SETTINGS.pickupScanRadius,
			0.5,
			400
		),
		collectDistance = sanitizeNumber(
			(settings :: any).collectDistance,
			DEFAULT_SETTINGS.collectDistance,
			0.1,
			30
		),
		collectOffsetY = sanitizeNumber((settings :: any).collectOffsetY, DEFAULT_SETTINGS.collectOffsetY, 0, 20),
		magnetBaseSpeed = sanitizeNumber(
			(settings :: any).magnetBaseSpeed,
			DEFAULT_SETTINGS.magnetBaseSpeed,
			0.1,
			400
		),
		magnetAcceleration = sanitizeNumber(
			(settings :: any).magnetAcceleration,
			DEFAULT_SETTINGS.magnetAcceleration,
			0,
			4000
		),
		magnetMaxSpeed = sanitizeNumber(
			(settings :: any).magnetMaxSpeed,
			DEFAULT_SETTINGS.magnetMaxSpeed,
			0.1,
			5000
		),
		magnetSpringFrequency = sanitizeNumber(
			(settings :: any).magnetSpringFrequency,
			DEFAULT_SETTINGS.magnetSpringFrequency,
			0.01,
			120
		),
		magnetSpringFrequencyRamp = sanitizeNumber(
			(settings :: any).magnetSpringFrequencyRamp,
			DEFAULT_SETTINGS.magnetSpringFrequencyRamp,
			0,
			200
		),
		magnetSpringFrequencyCloseBoost = sanitizeNumber(
			(settings :: any).magnetSpringFrequencyCloseBoost,
			DEFAULT_SETTINGS.magnetSpringFrequencyCloseBoost,
			0,
			200
		),
		magnetSpringDamping = sanitizeNumber(
			(settings :: any).magnetSpringDamping,
			DEFAULT_SETTINGS.magnetSpringDamping,
			0,
			20
		),
		magnetSpeedBlend = sanitizeNumber(
			(settings :: any).magnetSpeedBlend,
			DEFAULT_SETTINGS.magnetSpeedBlend,
			0,
			1
		),
		magnetCooldownAfterFailedCollect = sanitizeNumber(
			(settings :: any).magnetCooldownAfterFailedCollect,
			DEFAULT_SETTINGS.magnetCooldownAfterFailedCollect,
			0,
			4
		),
		ownerLockSeconds = sanitizeNumber(
			(settings :: any).ownerLockSeconds,
			DEFAULT_SETTINGS.ownerLockSeconds,
			0,
			120
		),
		playerDropOwnerLockSeconds = sanitizeNumber(
			(settings :: any).playerDropOwnerLockSeconds,
			DEFAULT_SETTINGS.playerDropOwnerLockSeconds,
			0,
			120
		),
		playerDropForwardOffset = sanitizeNumber(
			(settings :: any).playerDropForwardOffset,
			DEFAULT_SETTINGS.playerDropForwardOffset,
			0,
			100
		),
		playerDropUpOffset = sanitizeNumber(
			(settings :: any).playerDropUpOffset,
			DEFAULT_SETTINGS.playerDropUpOffset,
			0,
			100
		),
		spawnHeightOffset = sanitizeNumber(
			(settings :: any).spawnHeightOffset,
			DEFAULT_SETTINGS.spawnHeightOffset,
			-50,
			50
		),
		scatterRadiusMin = scatterRadiusMin,
		scatterRadiusMax = scatterRadiusMax,
		dropAmountDefault = sanitizeInteger(
			(settings :: any).dropAmountDefault,
			DEFAULT_SETTINGS.dropAmountDefault,
			1,
			9999
		),
		dropAmountMin = sanitizeInteger((settings :: any).dropAmountMin, DEFAULT_SETTINGS.dropAmountMin, 1, 9999),
		dropAmountMax = sanitizeInteger(
			(settings :: any).dropAmountMax,
			DEFAULT_SETTINGS.dropAmountMax,
			1,
			999999
		),
	}
end

function LootServiceUtils.ResolveItemConfig(dataRaw: any, itemIdRaw: any): LootItemConfig
	local itemId = sanitizeString(itemIdRaw, nil)
	if itemId == nil then
		return DEFAULT_ITEM_CONFIG
	end
	if typeof(dataRaw) ~= "table" then
		return DEFAULT_ITEM_CONFIG
	end
	local itemsRaw = (dataRaw :: { [string]: any }).items
	if typeof(itemsRaw) ~= "table" then
		return DEFAULT_ITEM_CONFIG
	end
	local configRaw = (itemsRaw :: { [string]: any })[itemId]
	if typeof(configRaw) ~= "table" then
		return DEFAULT_ITEM_CONFIG
	end

	local config = configRaw :: { [string]: any }
	return {
		maxStack = sanitizeInteger(config.maxStack, DEFAULT_ITEM_MAX_STACK, 1, 9999),
		rarity = sanitizeRarity(config.rarity, DEFAULT_RARITY),
	}
end

function LootServiceUtils.ResolveDropTableId(dataRaw: any, sourceRaw: any, fallbackRaw: any): string?
	local aliases = normalizeDropTableAliasMap(dataRaw)
	local dropTablesRaw = if typeof(dataRaw) == "table" then (dataRaw :: { [string]: any }).dropTables else nil
	local fallback = sanitizeString(fallbackRaw, nil)

	local function resolveValue(valueRaw: any): string?
		local value = sanitizeString(valueRaw, nil)
		if value == nil then
			return nil
		end
		if hasDropTable(dropTablesRaw, value) then
			return value
		end
		local alias = aliases[token(value)]
		if alias ~= nil and hasDropTable(dropTablesRaw, alias) then
			return alias
		end
		return nil
	end

	if typeof(sourceRaw) == "string" then
		return resolveValue(sourceRaw) or resolveValue(fallback)
	end

	if typeof(sourceRaw) == "table" then
		local source = sourceRaw :: { [string]: any }
		local direct = resolveValue(source.dropTableId)
		if direct ~= nil then
			return direct
		end
		for _, fieldValue in {
			source.sourceType,
			source.npcType,
			source.displayName,
			source.name,
			source.itemId,
		} do
			local resolved = resolveValue(fieldValue)
			if resolved ~= nil then
				return resolved
			end
		end
	end

	return resolveValue(fallback)
end

function LootServiceUtils.RollDropTable(
	dataRaw: any,
	dropTableIdRaw: any,
	randomObjectRaw: any,
	contextRaw: any
): { LootRollResult }
	local dropTable = getDropTable(dataRaw, dropTableIdRaw)
	if dropTable == nil then
		return {}
	end

	local randomObject = if typeof(randomObjectRaw) == "Random" then (randomObjectRaw :: Random) else Random.new()
	local context = if typeof(contextRaw) == "table" then contextRaw else {}
	local luck = sanitizeNumber((context :: any).luck, 0, -1, 1)
	local quantityMultiplier = sanitizeNumber((context :: any).quantityMultiplier, 1, 0.01, 100)
	local sourceType = sanitizeString((context :: any).sourceType, sanitizeString((dropTable :: any).sourceType, nil))
		or DEFAULT_SOURCE_TYPE

	local rollsMin = sanitizeInteger((dropTable :: any).rollsMin, 1, 0, 100)
	local rollsMax = sanitizeInteger((dropTable :: any).rollsMax, rollsMin, rollsMin, 100)
	local rollCount = if rollsMax > rollsMin then randomObject:NextInteger(rollsMin, rollsMax) else rollsMin

	local bonusRollChance = sanitizeNumber((dropTable :: any).bonusRollChance, 0, 0, 1)
	local bonusRollChanceFromLuck = sanitizeNumber((dropTable :: any).bonusRollChanceFromLuck, 0, 0, 1)
	local maxBonusRolls = sanitizeInteger((dropTable :: any).maxBonusRolls, 0, 0, 12)
	local effectiveBonusChance = math.clamp(bonusRollChance + luck * bonusRollChanceFromLuck, 0, 1)
	local bonusRolls = 0
	while bonusRolls < maxBonusRolls and randomObject:NextNumber() <= effectiveBonusChance do
		bonusRolls += 1
	end

	local output = {}
	local guaranteedDropsRaw = (dropTable :: any).guaranteedDrops
	if typeof(guaranteedDropsRaw) == "table" then
		for _, rawEntry in guaranteedDropsRaw do
			local entry = sanitizeDropEntry(rawEntry)
			if entry ~= nil then
				appendDropResult(output, dataRaw, entry, randomObject, quantityMultiplier, sourceType)
			end
		end
	end

	local totalRolls = rollCount + bonusRolls
	for _ = 1, totalRolls do
		local entry = chooseWeightedEntry((dropTable :: any).entries, randomObject, luck)
		if entry == nil then
			continue
		end

		appendDropResult(output, dataRaw, entry, randomObject, quantityMultiplier, sourceType)
	end

	return output
end

function LootServiceUtils.ResolveDropAmount(amountRaw: any, fallbackAmountRaw: any): number
	local fallbackAmount = sanitizeInteger(
		fallbackAmountRaw,
		DEFAULT_SETTINGS.dropAmountDefault,
		DEFAULT_SETTINGS.dropAmountMin,
		DEFAULT_SETTINGS.dropAmountMax
	)
	return sanitizeInteger(
		amountRaw,
		fallbackAmount,
		DEFAULT_SETTINGS.dropAmountMin,
		DEFAULT_SETTINGS.dropAmountMax
	)
end

function LootServiceUtils.ResolveItemNameCandidates(dataRaw: any, itemIdRaw: any): { string }
	local candidates = {}
	local seen = {}

	local itemId = sanitizeString(itemIdRaw, nil)
	if itemId == nil then
		return candidates
	end

	appendUniqueString(candidates, seen, itemId)
	appendUniqueString(candidates, seen, token(itemId))
	appendUniqueString(candidates, seen, string.lower(itemId))

	if typeof(dataRaw) ~= "table" then
		return candidates
	end

	local aliasesRoot = (dataRaw :: { [string]: any }).itemAssetAliases
	if typeof(aliasesRoot) ~= "table" then
		return candidates
	end

	local aliasesRaw = (aliasesRoot :: { [string]: any })[itemId]
	if typeof(aliasesRaw) == "table" then
		for _, aliasRaw in aliasesRaw do
			appendUniqueString(candidates, seen, aliasRaw)
		end
	end

	return candidates
end

function LootServiceUtils.CreateLootId(randomObjectRaw: any, itemIdRaw: any): string
	local randomObject = if typeof(randomObjectRaw) == "Random" then (randomObjectRaw :: Random) else Random.new()
	local itemToken = token(itemIdRaw)
	if itemToken == "" then
		itemToken = "loot"
	end
	local timeToken = math.floor(os.clock() * 1000)
	local randomToken = randomObject:NextInteger(1000, 999999)
	return ("%s_%d_%d"):format(itemToken, timeToken, randomToken)
end

function LootServiceUtils.IsAllowedStateTransition(currentRaw: any, nextRaw: any): boolean
	local currentState = sanitizeState(currentRaw, "Dropped")
	local nextState = sanitizeState(nextRaw, currentState)
	if currentState == nextState then
		return true
	end
	local allowedNext = ALLOWED_STATE_TRANSITIONS[currentState]
	return allowedNext[nextState] == true
end

LootServiceUtils.sanitizeString = LootServiceUtils.SanitizeString
LootServiceUtils.token = LootServiceUtils.Token
LootServiceUtils.sanitizeNumber = LootServiceUtils.SanitizeNumber
LootServiceUtils.sanitizeInteger = LootServiceUtils.SanitizeInteger
LootServiceUtils.sanitizeVector3 = LootServiceUtils.SanitizeVector3
LootServiceUtils.sanitizeRarity = LootServiceUtils.SanitizeRarity
LootServiceUtils.sanitizeState = LootServiceUtils.SanitizeState
LootServiceUtils.cloneDeep = LootServiceUtils.CloneDeep
LootServiceUtils.deepEqual = LootServiceUtils.DeepEqual
LootServiceUtils.resolveSettings = LootServiceUtils.ResolveSettings
LootServiceUtils.resolveItemConfig = LootServiceUtils.ResolveItemConfig
LootServiceUtils.resolveDropTableId = LootServiceUtils.ResolveDropTableId
LootServiceUtils.rollDropTable = LootServiceUtils.RollDropTable
LootServiceUtils.resolveDropAmount = LootServiceUtils.ResolveDropAmount
LootServiceUtils.resolveItemNameCandidates = LootServiceUtils.ResolveItemNameCandidates
LootServiceUtils.createLootId = LootServiceUtils.CreateLootId
LootServiceUtils.isAllowedStateTransition = LootServiceUtils.IsAllowedStateTransition

return LootServiceUtils
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="1307">
              <Properties>
                <string name="Name">MagicServiceUtils</string>
                <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Trig = require(script:FindFirstAncestor("game").Shared.Modules.Math.Trig)
local Vec = require(script:FindFirstAncestor("game").Shared.Modules.Math.Vec)
local WorkspaceFolders = require(script:FindFirstAncestor("game").Shared.Modules.Core.WorkspaceFolders)
local ResolveToolInstance = require(script:FindFirstAncestor("game").Shared.Modules.Game.Format.ResolveToolInstance)

local MagicServiceUtils = {}

export type EffectDefinition = {
	effectType: string,
	magnitude: number,
	duration: number,
	tickInterval: number,
	stackRule: string,
	maxStacks: number,
	radius: number,
	jumps: number,
	jumpFalloff: number,
}

export type ProjectileRuntimeConfig = {
	enabled: boolean,
	speed: number,
	spread: number,
	count: number,
	lifetime: number,
	pierce: number,
	collisionBehavior: string,
	radius: number,
	homingEnabled: boolean,
	homingRange: number,
	homingTurnRate: number,
	poolSize: number,
	destroyOnWorldHit: boolean,
	canHitPlayers: boolean,
	canHitNpcs: boolean,
	template: BasePart?,
	visualSize: Vector3?,
	visualColor: Color3?,
}

export type WeaponCallbacks = {
	OnCast: ((context: { [string]: any }) -> ())?,
	OnTick: ((context: { [string]: any }) -> ())?,
	OnHit: ((context: { [string]: any }) -> ())?,
	OnExpire: ((context: { [string]: any }) -> ())?,
}

export type WeaponRuntimeConfig = {
	itemId: string,
	displayName: string,
	manaCost: number,
	baseDamage: number,
	knockback: number,
	castTime: number,
	cooldown: number,
	range: number,
	projectile: ProjectileRuntimeConfig,
	effects: { EffectDefinition },
	callbacks: WeaponCallbacks,
	definition: { [string]: any },
}

export type ModifierStats = {
	damageMultiplier: number,
	damageBonus: number,
	manaMultiplier: number,
	manaBonus: number,
	cooldownMultiplier: number,
	cooldownBonus: number,
	castTimeMultiplier: number,
	castTimeBonus: number,
	knockbackMultiplier: number,
	knockbackBonus: number,
	speedMultiplier: number,
	speedBonus: number,
	lifetimeMultiplier: number,
	lifetimeBonus: number,
	pierceBonus: number,
	projectileCountBonus: number,
	forceHoming: boolean?,
}

export type CastStats = {
	damage: number,
	manaCost: number,
	cooldown: number,
	castTime: number,
	knockback: number,
	projectileSpeed: number,
	projectileLifetime: number,
	pierce: number,
	projectileCount: number,
	projectileSpread: number,
	homingEnabled: boolean,
}

export type CastRequest = {
	trigger: string,
	aimDirection: Vector3?,
	aimPosition: Vector3?,
}

export type ReplicatedState = {
	mana: number,
	maxMana: number,
	regenPerSecond: number,
	equippedWeaponId: string?,
	equippedSlot: number?,
	cooldowns: { [string]: number },
	updatedAt: number,
}

MagicServiceUtils.NETWORK_METHOD_REQUEST_SYNC = "requestSync"
MagicServiceUtils.NETWORK_METHOD_REQUEST_REFRESH_EQUIPPED = "requestRefreshEquipped"
MagicServiceUtils.NETWORK_METHOD_REQUEST_SET_INPUT_HELD = "requestSetInputHeld"
MagicServiceUtils.NETWORK_METHOD_REQUEST_CAST = "requestCast"
MagicServiceUtils.CLIENT_METHOD_APPLY_STATE = "applyState"
MagicServiceUtils.CLIENT_METHOD_ON_CAST_VISUAL = "onCastVisual"
MagicServiceUtils.CLIENT_METHOD_ON_IMPACT_VISUAL = "onImpactVisual"
MagicServiceUtils.DEFAULT_MANA_DATA_PATH = { "mana" }
MagicServiceUtils.MAGIC_PROJECTILE_FOLDER_NAME = "MagicProjectiles"
MagicServiceUtils.CLIENT_CAST_REQUEST_INTERVAL = 1 / 20
MagicServiceUtils.DEFAULT_MAX_MANA = 20
MagicServiceUtils.DEFAULT_MANA_REGEN = 8

local ATTACK_SPEED_TO_COOLDOWN = {
	["insanelyfast"] = 0.18,
	["veryfast"] = 0.24,
	["fast"] = 0.32,
	["normalspeed"] = 0.42,
	["normal"] = 0.42,
	["slow"] = 0.6,
	["veryslow"] = 0.82,
}

local KNOCKBACK_MAP = {
	none = 0,
	verylow = 1,
	low = 2,
	medium = 4,
	high = 6,
	veryhigh = 8,
	extreme = 10,
}

local STUN_ATTRIBUTE_NAMES = {
	"Stunned",
	"IsStunned",
	"MagicCastLocked",
	"MagicWeaponService_Stunned",
}

local function trim(raw: any): string
	if typeof(raw) ~= "string" then
		return ""
	end
	return string.match(raw, "^%s*(.-)%s*$") or ""
end

local function token(raw: any): string
	local value = string.lower(trim(raw))
	if value == "" then
		return ""
	end
	return string.gsub(value, "[%s_%-%.]+", "")
end

local function num(raw: any, fallback: number, minValue: number?, maxValue: number?): number
	local value = fallback
	if typeof(raw) == "number" and raw == raw then
		value = raw
	elseif typeof(raw) == "string" then
		local parsed = tonumber(trim(raw))
		if parsed ~= nil and parsed == parsed then
			value = parsed
		end
	end
	if minValue ~= nil and value < minValue then
		value = minValue
	end
	if maxValue ~= nil and value > maxValue then
		value = maxValue
	end
	return value
end

local function int(raw: any, fallback: number, minValue: number?, maxValue: number?): number
	return math.floor(num(raw, fallback, minValue, maxValue))
end

local function bool(raw: any, fallback: boolean): boolean
	if typeof(raw) == "boolean" then
		return raw
	end
	return fallback
end

local function asVector3(raw: any): Vector3?
	if typeof(raw) == "Vector3" then
		return raw
	end
	if typeof(raw) ~= "table" then
		return nil
	end
	local source = raw :: { [string]: any }
	local x = source.x
	if typeof(x) ~= "number" then
		x = source.X
	end
	local y = source.y
	if typeof(y) ~= "number" then
		y = source.Y
	end
	local z = source.z
	if typeof(z) ~= "number" then
		z = source.Z
	end
	if typeof(x) ~= "number" or typeof(y) ~= "number" or typeof(z) ~= "number" then
		return nil
	end
	return Vector3.new(x, y, z)
end

local function asColor3(raw: any): Color3?
	if typeof(raw) == "Color3" then
		return raw
	end
	if typeof(raw) ~= "table" then
		return nil
	end
	local source = raw :: { [string]: any }
	local r = source.r
	if typeof(r) ~= "number" then
		r = source.R
	end
	local g = source.g
	if typeof(g) ~= "number" then
		g = source.G
	end
	local b = source.b
	if typeof(b) ~= "number" then
		b = source.B
	end
	if typeof(r) ~= "number" or typeof(g) ~= "number" or typeof(b) ~= "number" then
		return nil
	end
	return Color3.new(math.clamp(r, 0, 1), math.clamp(g, 0, 1), math.clamp(b, 0, 1))
end

local function knockback(raw: any): number
	if typeof(raw) == "number" then
		return math.max(0, raw)
	end
	local mapped = KNOCKBACK_MAP[token(raw)]
	if mapped ~= nil then
		return mapped
	end
	return 2.5
end

local function attackSpeedCooldown(raw: any): number?
	return ATTACK_SPEED_TO_COOLDOWN[token(raw)]
end

function MagicServiceUtils.IsMagicTool(toolRaw: any): boolean
	local normalized = token(ResolveToolInstance.resolveToolItemType(toolRaw))
	return normalized == "magicweapon" or normalized == "magic" or normalized == "staff" or normalized == "spell"
end

function MagicServiceUtils.ResolveToolItemId(toolRaw: any): string?
	return ResolveToolInstance.resolveToolItemId(toolRaw)
end

function MagicServiceUtils.ResolveToolByItemId(characterRaw: any, backpackRaw: any, itemIdRaw: any): Tool?
	local itemId = trim(itemIdRaw)
	if itemId == "" then
		return nil
	end
	local function findIn(containerRaw: any): Tool?
		if typeof(containerRaw) ~= "Instance" then
			return nil
		end
		for _, child in (containerRaw :: Instance):GetChildren() do
			if not child:IsA("Tool") then
				continue
			end
			if MagicServiceUtils.ResolveToolItemId(child) == itemId then
				return child
			end
		end
		return nil
	end
	return findIn(characterRaw) or findIn(backpackRaw)
end

function MagicServiceUtils.ResolveSelectedItemIdFromInventoryState(stateRaw: any): (string?, number?)
	if typeof(stateRaw) ~= "table" then
		return nil, nil
	end
	local state = stateRaw :: { [string]: any }
	local selectedSlot = state.selectedSlot
	if typeof(selectedSlot) ~= "number" then
		return nil, nil
	end
	local slots = state.slots
	if typeof(slots) ~= "table" then
		return nil, math.floor(selectedSlot)
	end
	local slot = slots[math.floor(selectedSlot)]
	if typeof(slot) ~= "table" then
		return nil, math.floor(selectedSlot)
	end
	local stack = (slot :: any).stack
	if typeof(stack) ~= "table" then
		return nil, math.floor(selectedSlot)
	end
	local itemId = trim((stack :: any).itemId)
	if itemId == "" then
		return nil, math.floor(selectedSlot)
	end
	return itemId, math.floor(selectedSlot)
end

function MagicServiceUtils.SanitizeManaState(manaRaw: any): (number, number, number)
	if typeof(manaRaw) ~= "table" then
		return MagicServiceUtils.DEFAULT_MAX_MANA, MagicServiceUtils.DEFAULT_MAX_MANA, MagicServiceUtils.DEFAULT_MANA_REGEN
	end
	local source = manaRaw :: { [string]: any }
	local maxMana = num(
		source.maxMana or source.maximum or source.max,
		MagicServiceUtils.DEFAULT_MAX_MANA,
		1,
		100000
	)
	local mana = num(source.mana or source.current, maxMana, 0, maxMana)
	local regen = num(
		source.regenPerSecond or source.manaRegen or source.regen or source.recovery,
		MagicServiceUtils.DEFAULT_MANA_REGEN,
		0,
		10000
	)
	return mana, maxMana, regen
end

function MagicServiceUtils.SanitizeReplicatedState(raw: any, fallbackRaw: any): ReplicatedState
	local fallback = if typeof(fallbackRaw) == "table"
		then (fallbackRaw :: ReplicatedState)
		else {
			mana = MagicServiceUtils.DEFAULT_MAX_MANA,
			maxMana = MagicServiceUtils.DEFAULT_MAX_MANA,
			regenPerSecond = MagicServiceUtils.DEFAULT_MANA_REGEN,
			equippedWeaponId = nil,
			equippedSlot = nil,
			cooldowns = {},
			updatedAt = os.clock(),
		}
	local source = if typeof(raw) == "table" then (raw :: { [string]: any }) else {}
	local maxMana = num(source.maxMana, fallback.maxMana, 1, 100000)
	local mana = num(source.mana, fallback.mana, 0, maxMana)
	local regenPerSecond = num(source.regenPerSecond, fallback.regenPerSecond, 0, 10000)
	local equippedWeaponId = trim(source.equippedWeaponId)
	local equippedSlotRaw = source.equippedSlot
	local equippedSlot = if typeof(equippedSlotRaw) == "number" and equippedSlotRaw == equippedSlotRaw
		then math.floor(equippedSlotRaw)
		else fallback.equippedSlot
	local cooldowns: { [string]: number } = {}
	if typeof(source.cooldowns) == "table" then
		for key, value in source.cooldowns do
			if typeof(key) ~= "string" then
				continue
			end
			local remaining = num(value, 0, 0, 600)
			if remaining > 0 then
				cooldowns[key] = remaining
			end
		end
	else
		for key, value in fallback.cooldowns do
			cooldowns[key] = value
		end
	end

	return {
		mana = mana,
		maxMana = maxMana,
		regenPerSecond = regenPerSecond,
		equippedWeaponId = if equippedWeaponId ~= "" then equippedWeaponId else nil,
		equippedSlot = equippedSlot,
		cooldowns = cooldowns,
		updatedAt = num(source.updatedAt, fallback.updatedAt, 0, math.huge),
	}
end

function MagicServiceUtils.SanitizeCastRequest(raw: any): CastRequest
	local source = if typeof(raw) == "table" then (raw :: { [string]: any }) else {}
	return {
		trigger = trim(source.trigger) ~= "" and trim(source.trigger) or "Cast",
		aimDirection = asVector3(source.aimDirection),
		aimPosition = asVector3(source.aimPosition),
	}
end

function MagicServiceUtils.ResolveCastDirection(origin: Vector3, castRequestRaw: any, fallbackRaw: any): Vector3
	local request = MagicServiceUtils.SanitizeCastRequest(castRequestRaw)
	local fallback = if typeof(fallbackRaw) == "Vector3" then fallbackRaw else Vector3.new(0, 0, -1)
	local fallbackUnit = Vec.unit(fallback, Vector3.new(0, 0, -1))
	if request.aimDirection ~= nil and request.aimDirection.Magnitude > 1e-4 then
		return Vec.unit(request.aimDirection, fallbackUnit)
	end
	if request.aimPosition ~= nil then
		local offset = request.aimPosition - origin
		if offset.Magnitude > 1e-4 then
			return Vec.unit(offset, fallbackUnit)
		end
	end
	return fallbackUnit
end

function MagicServiceUtils.ApplySpread(directionRaw: Vector3, spreadRaw: any, indexRaw: any, countRaw: any): Vector3
	local direction = Vec.unit(directionRaw, Vector3.new(0, 0, -1))
	local spread = num(spreadRaw, 0, 0, 120)
	local count = int(countRaw, 1, 1, 64)
	if spread <= 1e-3 or count <= 1 then
		return direction
	end
	local index = int(indexRaw, 1, 1, count)
	local alpha = ((index - 1) / (count - 1)) - 0.5
	local yaw = Trig.degToRad(alpha * spread)
	local look = CFrame.lookAt(Vector3.zero, direction) * CFrame.Angles(0, yaw, 0)
	return look.LookVector
end

function MagicServiceUtils.ResolveHumanoidFromHitPart(hitPartRaw: any): Humanoid?
	if typeof(hitPartRaw) ~= "Instance" or not hitPartRaw:IsA("BasePart") then
		return nil
	end
	local model = (hitPartRaw :: BasePart):FindFirstAncestorOfClass("Model")
	if model == nil then
		return nil
	end
	return model:FindFirstChildOfClass("Humanoid")
end

function MagicServiceUtils.IsHumanoidAlive(humanoidRaw: any): boolean
	if typeof(humanoidRaw) ~= "Instance" or not humanoidRaw:IsA("Humanoid") then
		return false
	end
	local humanoid = humanoidRaw :: Humanoid
	if humanoid.Health <= 0 then
		return false
	end
	return humanoid:GetState() ~= Enum.HumanoidStateType.Dead
end

function MagicServiceUtils.IsPlayerStunned(player: Player, character: Model?, humanoid: Humanoid?): boolean
	local function hasAny(instance: Instance?): boolean
		if instance == nil then
			return false
		end
		for _, attributeName in STUN_ATTRIBUTE_NAMES do
			if instance:GetAttribute(attributeName) == true then
				return true
			end
		end
		return false
	end
	return hasAny(player) or hasAny(character) or hasAny(humanoid)
end

function MagicServiceUtils.BuildWeaponRuntimeConfig(weaponConfigRaw: any): WeaponRuntimeConfig?
	if typeof(weaponConfigRaw) ~= "table" then
		return nil
	end
	local weaponConfig = weaponConfigRaw :: { [string]: any }
	local definition = if typeof(weaponConfig.definition) == "table" then weaponConfig.definition else {}
	local root = if typeof((definition :: any).magicWeapon) == "table"
		then (definition :: any).magicWeapon
		else if typeof((definition :: any).magic) == "table" then (definition :: any).magic else {}
	local stats = if typeof((definition :: any).stats) == "table" then (definition :: any).stats else {}
	local baseProjectile = if typeof(weaponConfig.projectile) == "table" then weaponConfig.projectile else {}
	local projectileExtra = if typeof((root :: any).projectile) == "table"
		then (root :: any).projectile
		else if typeof((definition :: any).projectile) == "table" then (definition :: any).projectile else {}
	local homingRaw = (projectileExtra :: any).homing
	local homingTable = if typeof(homingRaw) == "table" then (homingRaw :: { [string]: any }) else nil
	local collisionBehavior = token((projectileExtra :: any).collisionBehavior)
	local collisionMode = if collisionBehavior == "overlap" or collisionBehavior == "pierce" or collisionBehavior == "raycast"
		then collisionBehavior
		else "raycast"

	local effectsRaw = (root :: any).onHitEffects
		or (root :: any).effects
		or (definition :: any).onHitEffects
		or (definition :: any).effects
	local effects: { EffectDefinition } = {}
	if typeof(effectsRaw) == "table" then
		for _, effectRaw in effectsRaw do
			if typeof(effectRaw) ~= "table" then
				continue
			end
			local effect = effectRaw :: { [string]: any }
			local effectType = token(effect.effectType or effect.type)
			if effectType == "" then
				continue
			end
			table.insert(effects, {
				effectType = effectType,
				magnitude = num(effect.magnitude, if effectType == "lifesteal" then 0.1 else 1, 0, 100000),
				duration = num(effect.duration, if effectType == "burn" or effectType == "slow" then 4 else 0, 0, 60),
				tickInterval = num(effect.tickInterval, 0.5, 0.05, 10),
				stackRule = token(effect.stackRule) ~= "" and token(effect.stackRule) or "refresh",
				maxStacks = int(effect.maxStacks, 1, 1, 99),
				radius = num(effect.radius, 10, 0, 500),
				jumps = int(effect.jumps, 2, 0, 16),
				jumpFalloff = num(effect.jumpFalloff, 0.65, 0, 1),
			})
		end
	end

	local attackSpeedCooldownValue = attackSpeedCooldown((stats :: any).attackSpeed)
	local cooldownFallback =
		if attackSpeedCooldownValue ~= nil then attackSpeedCooldownValue else num(weaponConfig.cooldown, 0.42, 0, 60)
	local callbacksRaw = if typeof((root :: any).callbacks) == "table"
		then (root :: any).callbacks
		else if typeof((definition :: any).callbacks) == "table" then (definition :: any).callbacks else {}

	return {
		itemId = trim(weaponConfig.itemId) ~= "" and trim(weaponConfig.itemId) or "unknownMagicWeapon",
		displayName = trim(weaponConfig.displayName) ~= "" and trim(weaponConfig.displayName) or "Magic Weapon",
		manaCost = num((root :: any).manaCost or weaponConfig.manaCost or (stats :: any).manaCost or (stats :: any).mana, 8, 0, 100000),
		baseDamage = num((root :: any).damage or weaponConfig.damage or (stats :: any).magicDamage or (stats :: any).dmg, 10, 0, 1_000_000),
		knockback = knockback((root :: any).knockback or (definition :: any).knockback or (stats :: any).knockback),
		castTime = num((root :: any).castTime or weaponConfig.castTime, 0.12, 0, 30),
		cooldown = num((root :: any).cooldown or weaponConfig.cooldown, cooldownFallback, 0, 60),
		range = num((root :: any).range or weaponConfig.range or (definition :: any).range, 250, 1, 2000),
		projectile = {
			enabled = bool(baseProjectile.enabled, true),
			speed = num((projectileExtra :: any).speed or baseProjectile.speed, 120, 1, 5000),
			spread = num((projectileExtra :: any).spread or baseProjectile.spread, 0, 0, 120),
			count = int((projectileExtra :: any).count or baseProjectile.count, 1, 1, 32),
			lifetime = num((projectileExtra :: any).lifetime or baseProjectile.lifetime, 2, 0.02, 120),
			pierce = int((projectileExtra :: any).pierce or (projectileExtra :: any).pierceCount or baseProjectile.pierce, 0, 0, 100),
			collisionBehavior = collisionMode,
			radius = num((projectileExtra :: any).radius, 0.5, 0, 64),
			homingEnabled = bool(
				(projectileExtra :: any).homingEnabled
					or (if homingTable ~= nil then homingTable.enabled else nil)
					or (if homingTable ~= nil then true else nil),
				false
			),
			homingRange = num(
				(projectileExtra :: any).homingRange or (if homingTable ~= nil then homingTable.range else nil),
				40,
				0,
				1000
			),
			homingTurnRate = num(
				(projectileExtra :: any).homingTurnRate or (if homingTable ~= nil then homingTable.turnRate else nil),
				4,
				0.01,
				40
			),
			poolSize = int((projectileExtra :: any).poolSize, 16, 1, 512),
			destroyOnWorldHit = bool((projectileExtra :: any).destroyOnWorldHit, true),
			canHitPlayers = bool((projectileExtra :: any).canHitPlayers, true),
			canHitNpcs = bool((projectileExtra :: any).canHitNpcs, true),
			template = if typeof((projectileExtra :: any).template) == "Instance" and (projectileExtra :: any).template:IsA("BasePart")
				then (projectileExtra :: any).template
				else nil,
			visualSize = asVector3((projectileExtra :: any).visualSize or (projectileExtra :: any).size),
			visualColor = asColor3((projectileExtra :: any).visualColor or (projectileExtra :: any).color),
		},
		effects = effects,
		callbacks = {
			OnCast = if typeof((callbacksRaw :: any).OnCast) == "function"
				then (callbacksRaw :: any).OnCast
				else if typeof((callbacksRaw :: any).onCast) == "function" then (callbacksRaw :: any).onCast else nil,
			OnTick = if typeof((callbacksRaw :: any).OnTick) == "function"
				then (callbacksRaw :: any).OnTick
				else if typeof((callbacksRaw :: any).onTick) == "function" then (callbacksRaw :: any).onTick else nil,
			OnHit = if typeof((callbacksRaw :: any).OnHit) == "function"
				then (callbacksRaw :: any).OnHit
				else if typeof((callbacksRaw :: any).onHit) == "function" then (callbacksRaw :: any).onHit else nil,
			OnExpire = if typeof((callbacksRaw :: any).OnExpire) == "function"
				then (callbacksRaw :: any).OnExpire
				else if typeof((callbacksRaw :: any).onExpire) == "function" then (callbacksRaw :: any).onExpire else nil,
		},
		definition = definition,
	}
end

function MagicServiceUtils.CreateDefaultModifier(): ModifierStats
	return {
		damageMultiplier = 1,
		damageBonus = 0,
		manaMultiplier = 1,
		manaBonus = 0,
		cooldownMultiplier = 1,
		cooldownBonus = 0,
		castTimeMultiplier = 1,
		castTimeBonus = 0,
		knockbackMultiplier = 1,
		knockbackBonus = 0,
		speedMultiplier = 1,
		speedBonus = 0,
		lifetimeMultiplier = 1,
		lifetimeBonus = 0,
		pierceBonus = 0,
		projectileCountBonus = 0,
		forceHoming = nil,
	}
end

function MagicServiceUtils.SanitizeModifier(raw: any): ModifierStats
	local source = if typeof(raw) == "table" then (raw :: { [string]: any }) else {}
	local modifier = MagicServiceUtils.CreateDefaultModifier()
	modifier.damageMultiplier = num(source.damageMultiplier, 1, 0, 100)
	modifier.damageBonus = num(source.damageBonus, 0, -100000, 100000)
	modifier.manaMultiplier = num(source.manaMultiplier or source.manaCostMultiplier, 1, 0, 100)
	modifier.manaBonus = num(source.manaBonus or source.manaCostBonus, 0, -100000, 100000)
	modifier.cooldownMultiplier = num(source.cooldownMultiplier, 1, 0, 100)
	modifier.cooldownBonus = num(source.cooldownBonus, 0, -100000, 100000)
	modifier.castTimeMultiplier = num(source.castTimeMultiplier, 1, 0, 100)
	modifier.castTimeBonus = num(source.castTimeBonus, 0, -100000, 100000)
	modifier.knockbackMultiplier = num(source.knockbackMultiplier, 1, 0, 100)
	modifier.knockbackBonus = num(source.knockbackBonus, 0, -100000, 100000)
	modifier.speedMultiplier = num(source.speedMultiplier or source.projectileSpeedMultiplier, 1, 0, 100)
	modifier.speedBonus = num(source.speedBonus or source.projectileSpeedBonus, 0, -100000, 100000)
	modifier.lifetimeMultiplier = num(source.lifetimeMultiplier or source.projectileLifetimeMultiplier, 1, 0, 100)
	modifier.lifetimeBonus = num(source.lifetimeBonus or source.projectileLifetimeBonus, 0, -100000, 100000)
	modifier.pierceBonus = int(source.pierceBonus, 0, -100, 100)
	modifier.projectileCountBonus = int(source.projectileCountBonus, 0, -20, 20)
	if typeof(source.forceHoming) == "boolean" then
		modifier.forceHoming = source.forceHoming
	end
	return modifier
end

function MagicServiceUtils.MergeModifiers(list: { any }): ModifierStats
	local merged = MagicServiceUtils.CreateDefaultModifier()
	for _, raw in list do
		local modifier = MagicServiceUtils.SanitizeModifier(raw)
		merged.damageMultiplier *= modifier.damageMultiplier
		merged.damageBonus += modifier.damageBonus
		merged.manaMultiplier *= modifier.manaMultiplier
		merged.manaBonus += modifier.manaBonus
		merged.cooldownMultiplier *= modifier.cooldownMultiplier
		merged.cooldownBonus += modifier.cooldownBonus
		merged.castTimeMultiplier *= modifier.castTimeMultiplier
		merged.castTimeBonus += modifier.castTimeBonus
		merged.knockbackMultiplier *= modifier.knockbackMultiplier
		merged.knockbackBonus += modifier.knockbackBonus
		merged.speedMultiplier *= modifier.speedMultiplier
		merged.speedBonus += modifier.speedBonus
		merged.lifetimeMultiplier *= modifier.lifetimeMultiplier
		merged.lifetimeBonus += modifier.lifetimeBonus
		merged.pierceBonus += modifier.pierceBonus
		merged.projectileCountBonus += modifier.projectileCountBonus
		if modifier.forceHoming ~= nil then
			merged.forceHoming = modifier.forceHoming
		end
	end
	return merged
end

function MagicServiceUtils.BuildCastStats(config: WeaponRuntimeConfig, modifierRaw: any): CastStats
	local modifier = MagicServiceUtils.SanitizeModifier(modifierRaw)
	local homingEnabled = config.projectile.homingEnabled
	if modifier.forceHoming ~= nil then
		homingEnabled = modifier.forceHoming
	end
	return {
		damage = math.max(0, config.baseDamage * modifier.damageMultiplier + modifier.damageBonus),
		manaCost = math.max(0, config.manaCost * modifier.manaMultiplier + modifier.manaBonus),
		cooldown = math.max(0, config.cooldown * modifier.cooldownMultiplier + modifier.cooldownBonus),
		castTime = math.max(0, config.castTime * modifier.castTimeMultiplier + modifier.castTimeBonus),
		knockback = math.max(0, config.knockback * modifier.knockbackMultiplier + modifier.knockbackBonus),
		projectileSpeed = math.max(1, config.projectile.speed * modifier.speedMultiplier + modifier.speedBonus),
		projectileLifetime = math.max(0.02, config.projectile.lifetime * modifier.lifetimeMultiplier + modifier.lifetimeBonus),
		pierce = math.max(0, config.projectile.pierce + modifier.pierceBonus),
		projectileCount = math.max(1, config.projectile.count + modifier.projectileCountBonus),
		projectileSpread = math.max(0, config.projectile.spread),
		homingEnabled = homingEnabled,
	}
end

function MagicServiceUtils.EnsureProjectileFolder(): Folder
	return WorkspaceFolders.getOrCreateFolderInGame(MagicServiceUtils.MAGIC_PROJECTILE_FOLDER_NAME)
end

function MagicServiceUtils.CooldownsToRemaining(cooldownsRaw: any, now: number): { [string]: number }
	local remaining: { [string]: number } = {}
	if typeof(cooldownsRaw) ~= "table" then
		return remaining
	end
	for weaponId, expiresAtRaw in cooldownsRaw do
		if typeof(weaponId) ~= "string" or typeof(expiresAtRaw) ~= "number" then
			continue
		end
		local delta = expiresAtRaw - now
		if delta > 0 then
			remaining[weaponId] = delta
		end
	end
	return remaining
end

MagicServiceUtils.isMagicTool = MagicServiceUtils.IsMagicTool
MagicServiceUtils.resolveToolItemId = MagicServiceUtils.ResolveToolItemId
MagicServiceUtils.resolveToolByItemId = MagicServiceUtils.ResolveToolByItemId
MagicServiceUtils.resolveSelectedItemIdFromInventoryState = MagicServiceUtils.ResolveSelectedItemIdFromInventoryState
MagicServiceUtils.sanitizeManaState = MagicServiceUtils.SanitizeManaState
MagicServiceUtils.sanitizeReplicatedState = MagicServiceUtils.SanitizeReplicatedState
MagicServiceUtils.sanitizeCastRequest = MagicServiceUtils.SanitizeCastRequest
MagicServiceUtils.resolveCastDirection = MagicServiceUtils.ResolveCastDirection
MagicServiceUtils.applySpread = MagicServiceUtils.ApplySpread
MagicServiceUtils.resolveHumanoidFromHitPart = MagicServiceUtils.ResolveHumanoidFromHitPart
MagicServiceUtils.isHumanoidAlive = MagicServiceUtils.IsHumanoidAlive
MagicServiceUtils.isPlayerStunned = MagicServiceUtils.IsPlayerStunned
MagicServiceUtils.buildWeaponRuntimeConfig = MagicServiceUtils.BuildWeaponRuntimeConfig
MagicServiceUtils.createDefaultModifier = MagicServiceUtils.CreateDefaultModifier
MagicServiceUtils.sanitizeModifier = MagicServiceUtils.SanitizeModifier
MagicServiceUtils.mergeModifiers = MagicServiceUtils.MergeModifiers
MagicServiceUtils.buildCastStats = MagicServiceUtils.BuildCastStats
MagicServiceUtils.ensureProjectileFolder = MagicServiceUtils.EnsureProjectileFolder
MagicServiceUtils.cooldownsToRemaining = MagicServiceUtils.CooldownsToRemaining

return MagicServiceUtils
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="1308">
              <Properties>
                <string name="Name">ManaServiceUtils</string>
                <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Sift = require(ReplicatedStorage.Packages.Sift)

local ManaServiceUtils = {}

export type ManaServiceState = {
	mana: number,
	maxMana: number,
	regenPerSecond: number,
	normalizedMana: number,
	delta: number,
	lastSpend: number,
	lastGain: number,
	isLoaded: boolean,
	updatedAt: number,
}

local DEFAULT_MAX_MANA = 20
local DEFAULT_REGEN_PER_SECOND = 8
local DEFAULT_DATA_PATH = { "mana" }

ManaServiceUtils.NETWORK_METHOD_REQUEST_SYNC = "requestSync"
ManaServiceUtils.CLIENT_METHOD_APPLY_STATE = "applyState"
ManaServiceUtils.DEFAULT_MAX_MANA = DEFAULT_MAX_MANA
ManaServiceUtils.DEFAULT_REGEN_PER_SECOND = DEFAULT_REGEN_PER_SECOND
ManaServiceUtils.DEFAULT_DATA_PATH = DEFAULT_DATA_PATH

local function sanitizeNumber(valueRaw: any, fallback: number, minimum: number?, maximum: number?): number
	local value = fallback
	if typeof(valueRaw) == "number" and valueRaw == valueRaw then
		value = valueRaw
	elseif typeof(valueRaw) == "string" then
		local parsed = tonumber(valueRaw)
		if parsed ~= nil and parsed == parsed then
			value = parsed
		end
	end

	if minimum ~= nil and value < minimum then
		value = minimum
	end
	if maximum ~= nil and value > maximum then
		value = maximum
	end
	return value
end

local function sanitizeLoadedFlag(valueRaw: any, fallback: boolean): boolean
	if typeof(valueRaw) == "boolean" then
		return valueRaw
	end
	return fallback
end

function ManaServiceUtils.CreateState(
	manaRaw: any,
	maxManaRaw: any,
	regenPerSecondRaw: any,
	isLoadedRaw: any,
	fallbackRaw: ManaServiceState?
): ManaServiceState
	local fallback = fallbackRaw
	local fallbackMaxMana = if fallback ~= nil then fallback.maxMana else DEFAULT_MAX_MANA
	local maxMana = sanitizeNumber(maxManaRaw, fallbackMaxMana, 1, 100000)
	local fallbackMana = if fallback ~= nil then fallback.mana else maxMana
	local mana = sanitizeNumber(manaRaw, fallbackMana, 0, maxMana)
	local fallbackRegenPerSecond = if fallback ~= nil then fallback.regenPerSecond else DEFAULT_REGEN_PER_SECOND
	local regenPerSecond = sanitizeNumber(regenPerSecondRaw, fallbackRegenPerSecond, 0, 10000)
	local previousMana = if fallback ~= nil then fallback.mana else mana
	local delta = mana - previousMana
	local isLoaded = sanitizeLoadedFlag(isLoadedRaw, if fallback ~= nil then fallback.isLoaded else false)

	return {
		mana = mana,
		maxMana = maxMana,
		regenPerSecond = regenPerSecond,
		normalizedMana = math.clamp(mana / maxMana, 0, 1),
		delta = delta,
		lastSpend = math.max(0, -delta),
		lastGain = math.max(0, delta),
		isLoaded = isLoaded,
		updatedAt = os.clock(),
	}
end

function ManaServiceUtils.CreateDefaultState(): ManaServiceState
	return ManaServiceUtils.CreateState(DEFAULT_MAX_MANA, DEFAULT_MAX_MANA, DEFAULT_REGEN_PER_SECOND, false, nil)
end

function ManaServiceUtils.SanitizeState(stateRaw: any, fallbackRaw: ManaServiceState?): ManaServiceState
	local source = if typeof(stateRaw) == "table" then (stateRaw :: { [string]: any }) else {}
	local fallback = if fallbackRaw ~= nil then fallbackRaw else ManaServiceUtils.CreateDefaultState()
	local nextState = ManaServiceUtils.CreateState(
		source.mana,
		source.maxMana,
		source.regenPerSecond,
		source.isLoaded,
		fallback
	)
	local updatedAtRaw = source.updatedAt
	if typeof(updatedAtRaw) == "number" and updatedAtRaw == updatedAtRaw then
		nextState.updatedAt = updatedAtRaw
	end
	return nextState
end

function ManaServiceUtils.CloneState(state: ManaServiceState): ManaServiceState
	return Sift.Dictionary.copy(state) :: ManaServiceState
end

function ManaServiceUtils.ClonePath(pathRaw: any): { string }
	local source = if typeof(pathRaw) == "table" then pathRaw else DEFAULT_DATA_PATH
	local output = Sift.Array.map(source, function(segmentRaw: any): string?
		if typeof(segmentRaw) == "string" and segmentRaw ~= "" then
			return segmentRaw
		end
		return nil
	end)
	if #output <= 0 then
		return { "mana" }
	end
	return output
end

function ManaServiceUtils.GetDefaultDataPath(): { string }
	return ManaServiceUtils.ClonePath(DEFAULT_DATA_PATH)
end

function ManaServiceUtils.SerializeStateForData(stateRaw: any): { [string]: any }
	local state = if typeof(stateRaw) == "table"
		then ManaServiceUtils.SanitizeState(stateRaw, ManaServiceUtils.CreateDefaultState())
		else ManaServiceUtils.CreateDefaultState()

	return {
		mana = state.mana,
		maxMana = state.maxMana,
		regenPerSecond = state.regenPerSecond,
		updatedAt = os.time(),
	}
end

function ManaServiceUtils.CreateStateFromData(
	persistedRaw: any,
	fallbackRaw: ManaServiceState?,
	isLoadedRaw: any
): ManaServiceState
	local fallback = if fallbackRaw ~= nil then fallbackRaw else ManaServiceUtils.CreateDefaultState()

	if typeof(persistedRaw) == "number" and persistedRaw == persistedRaw then
		return ManaServiceUtils.CreateState(
			persistedRaw,
			fallback.maxMana,
			fallback.regenPerSecond,
			isLoadedRaw,
			fallback
		)
	end

	if typeof(persistedRaw) ~= "table" then
		return ManaServiceUtils.CreateState(
			fallback.mana,
			fallback.maxMana,
			fallback.regenPerSecond,
			isLoadedRaw,
			fallback
		)
	end

	local source = persistedRaw :: { [string]: any }
	local manaRaw = source.mana or source.current
	local maxManaRaw = source.maxMana or source.max or source.maximum
	local regenRaw = source.regenPerSecond or source.manaRegen or source.regen or source.recovery
	return ManaServiceUtils.CreateState(manaRaw, maxManaRaw, regenRaw, isLoadedRaw, fallback)
end

ManaServiceUtils.createState = ManaServiceUtils.CreateState
ManaServiceUtils.createDefaultState = ManaServiceUtils.CreateDefaultState
ManaServiceUtils.sanitizeState = ManaServiceUtils.SanitizeState
ManaServiceUtils.cloneState = ManaServiceUtils.CloneState
ManaServiceUtils.clonePath = ManaServiceUtils.ClonePath
ManaServiceUtils.getDefaultDataPath = ManaServiceUtils.GetDefaultDataPath
ManaServiceUtils.serializeStateForData = ManaServiceUtils.SerializeStateForData
ManaServiceUtils.createStateFromData = ManaServiceUtils.CreateStateFromData

return ManaServiceUtils
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="1309">
              <Properties>
                <string name="Name">MeleeServiceUtils</string>
                <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Sift = require(ReplicatedStorage.Packages.Sift)

local MeleeServiceUtils = {}
local AudioRegistry = require(script:FindFirstAncestor("game").Shared.Modules.Items.Audio)
local ItemRegistry = require(script:FindFirstAncestor("game").Shared.Modules.Items.Registry)
local ResolveToolInstance = require(script:FindFirstAncestor("game").Shared.Modules.Game.Format.ResolveToolInstance)
local AudioServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.AudioServiceUtils)

export type MeleeWeaponConfig = {
	itemId: string,
	displayName: string,
	damage: number,
	cooldown: number,
	slashCooldown: number,
	slashResetCooldown: number,
	swingDuration: number,
	hitboxDuration: number,
	range: number,
	width: number,
	height: number,
	pointCount: number,
	autoRepeatWhileHeld: boolean,
	canHitPlayers: boolean,
	canHitNpcs: boolean,
	animations: { [string]: any }?,
}

local DEFAULT_DAMAGE = 7
local DEFAULT_COOLDOWN = 0.45
local DEFAULT_SLASH_RESET_COOLDOWN = 0.9
local DEFAULT_SWING_DURATION = 1
local DEFAULT_HITBOX_DURATION = 0.2
local DEFAULT_RANGE = 4.6
local DEFAULT_WIDTH = 2.25
local DEFAULT_HEIGHT = 1.8
local DEFAULT_POINT_COUNT = 5
local DEFAULT_AUTO_REPEAT = true
local DEFAULT_CAN_HIT_PLAYERS = true
local DEFAULT_CAN_HIT_NPCS = true
local DEFAULT_FALLBACK_SWING_PADDING = 0.04

local MELEE_ITEM_NAME_HINTS = {
	"sword",
	"blade",
	"dagger",
	"knife",
	"axe",
	"hammer",
	"mace",
	"spear",
	"trident",
	"scythe",
	"club",
}
local MELEE_ITEM_TYPE_HINTS = {
	sword = true,
	blade = true,
	dagger = true,
	knife = true,
	axe = true,
	hammer = true,
	mace = true,
	spear = true,
	trident = true,
	scythe = true,
	club = true,
	melee = true,
}

local ATTACK_SPEED_TO_COOLDOWN = {
	["insanely fast"] = 0.14,
	["very fast"] = 0.2,
	["fast"] = 0.28,
	["normal speed"] = 0.38,
	["normal"] = 0.38,
	["slow"] = 0.52,
	["very slow"] = 0.66,
}
local DEFAULT_TOOL_ANIMATION_LOOKUP_ORDER = {
	"Equip",
	"Idle",
	"StanceTransition",
	"StanceIdle",
	"Swing1",
	"Swing2",
	"Swing3",
	"Unequip",
	"Walk",
}
local DEFAULT_TOOL_SWING_LOOKUP_ORDER = {
	"Swing1",
	"Swing2",
	"Swing3",
	"Swing",
}
local NAMED_ANIMATION_STATE_ALIASES: { [string]: { string } } = {
	Equip = { "equip", "draw", "equipanimation", "drawanimation" },
	Idle = { "idle", "weaponidle", "holdidle", "idleanimation" },
	Unequip = { "unequip", "holster", "sheath", "sheathe", "unequipanimation" },
	StanceTransition = {
		"stancetransition",
		"transitiontostance",
		"enterstance",
		"stancestart",
		"stancetransitionanimation",
	},
	StanceIdle = { "stanceidle", "stance", "combatidle", "readyidle", "stanceidleanimation" },
	Walk = { "walk", "walkcycle", "walkanimation" },
}
local NAMED_ANIMATION_TOKEN_TO_STATE: { [string]: string } = {}

for stateName, aliases in NAMED_ANIMATION_STATE_ALIASES do
	for _, alias in aliases do
		NAMED_ANIMATION_TOKEN_TO_STATE[alias] = stateName
	end
end

MeleeServiceUtils.NETWORK_METHOD_REFRESH_EQUIPPED = "requestRefreshEquipped"
MeleeServiceUtils.NETWORK_METHOD_SET_INPUT_HELD = "requestSetInputHeld"
MeleeServiceUtils.DEFAULT_FALLBACK_SWING_PADDING = DEFAULT_FALLBACK_SWING_PADDING

local ITEM_AUDIO = ((AudioRegistry :: any).Items or {}) :: { [string]: any }
local WEAPON_AUDIO = (ITEM_AUDIO.Weapons or {}) :: { [string]: any }
local AXE_AUDIO = (ITEM_AUDIO.Axes or {}) :: { [string]: any }
local PICKAXE_AUDIO = (ITEM_AUDIO.Pickaxes or {}) :: { [string]: any }
local ITEM_AUDIO_BY_TYPE = {
	axe = AXE_AUDIO,
	pickaxe = PICKAXE_AUDIO,
	sword = WEAPON_AUDIO,
	blade = WEAPON_AUDIO,
	dagger = WEAPON_AUDIO,
	knife = WEAPON_AUDIO,
	hammer = WEAPON_AUDIO,
	mace = WEAPON_AUDIO,
	spear = WEAPON_AUDIO,
	trident = WEAPON_AUDIO,
	scythe = WEAPON_AUDIO,
	club = WEAPON_AUDIO,
	melee = WEAPON_AUDIO,
} :: { [string]: { [string]: any } }
local ITEM_AUDIO_GROUPS = {
	WEAPON_AUDIO,
	AXE_AUDIO,
	PICKAXE_AUDIO,
} :: { { [string]: any } }

local cachedDefinitions: { [string]: any } = {}
local cachedWeaponConfigs: { [string]: MeleeWeaponConfig | false } = {}

local function trim(valueRaw: any): string
	if typeof(valueRaw) ~= "string" then
		return ""
	end
	return string.match(valueRaw, "^%s*(.-)%s*$") or ""
end

local function sanitizeString(valueRaw: any, fallback: string): string
	local value = trim(valueRaw)
	if value == "" then
		return fallback
	end
	return value
end

local function sanitizeItemId(itemIdRaw: any): string?
	local itemId = trim(itemIdRaw)
	if itemId == "" then
		return nil
	end
	return itemId
end

local function sanitizeNumber(valueRaw: any, fallback: number, minimum: number?, maximum: number?): number
	local value = fallback
	if typeof(valueRaw) == "number" and valueRaw == valueRaw then
		value = valueRaw
	elseif typeof(valueRaw) == "string" then
		local numericText = string.match(string.lower(valueRaw), "%-?%d+%.?%d*")
		if numericText ~= nil then
			local parsed = tonumber(numericText)
			if parsed ~= nil and parsed == parsed then
				value = parsed
			end
		end
	end

	if minimum ~= nil and value < minimum then
		value = minimum
	end
	if maximum ~= nil and value > maximum then
		value = maximum
	end
	return value
end

local function resolveCanonicalItemId(itemIdRaw: any): string?
	local itemId = sanitizeItemId(itemIdRaw)
	if itemId == nil then
		return nil
	end

	return ItemRegistry.resolveCanonicalItemId(itemId)
end

local function sanitizeBoolean(valueRaw: any, fallback: boolean): boolean
	if typeof(valueRaw) == "boolean" then
		return valueRaw
	end
	return fallback
end

local function sanitizeAttackSpeedToCooldown(valueRaw: any, fallback: number): number
	local attackSpeed = string.lower(trim(valueRaw))
	if attackSpeed == "" then
		return fallback
	end
	local fromMap = ATTACK_SPEED_TO_COOLDOWN[attackSpeed]
	if fromMap ~= nil then
		return fromMap
	end
	return fallback
end

local function resolveConfiguredSwingSpeed(meleeRaw: any, definitionRaw: any, statsRaw: any): number
	local melee = if typeof(meleeRaw) == "table" then (meleeRaw :: { [string]: any }) else {}
	local definition = if typeof(definitionRaw) == "table" then (definitionRaw :: { [string]: any }) else {}
	local stats = if typeof(statsRaw) == "table" then (statsRaw :: { [string]: any }) else {}
	return sanitizeNumber(
		(melee :: any).swingSpeed
			or (melee :: any).animationSpeed
			or (melee :: any).swingAnimationSpeed
			or definition.swingSpeed
			or definition.animationSpeed
			or definition.swingAnimationSpeed
			or stats.swingSpeed
			or stats.animationSpeed,
		1,
		0.05,
		8
	)
end

local function normalizeTypeToken(valueRaw: any): string
	local normalized = string.lower(trim(valueRaw))
	if normalized == "" then
		return ""
	end
	normalized = string.gsub(normalized, "[%s_%-]+", "")
	return normalized
end

local function normalizeAnimationLookupKey(nameRaw: any): string
	local normalized = string.lower(trim(nameRaw))
	if normalized == "" then
		return ""
	end
	normalized = string.gsub(normalized, "[%s_%-]+", "")
	return normalized
end

local function normalizeNamedAnimationStateKey(nameRaw: any): string?
	local token = normalizeAnimationLookupKey(nameRaw)
	if token == "" then
		return nil
	end
	return NAMED_ANIMATION_TOKEN_TO_STATE[token]
end

local function normalizeAnimationMode(modeRaw: any): string
	local mode = string.lower(trim(modeRaw))
	if mode == "sequence" or mode == "sequential" or mode == "ordered" then
		return "Sequence"
	end
	return "Sequence"
end

local function normalizeAnimationId(animationIdRaw: any): string?
	if typeof(animationIdRaw) == "number" then
		if animationIdRaw <= 0 or animationIdRaw ~= animationIdRaw then
			return nil
		end
		return "rbxassetid://" .. tostring(math.floor(animationIdRaw))
	end

	if typeof(animationIdRaw) ~= "string" then
		return nil
	end

	local text = trim(animationIdRaw)
	if text == "" then
		return nil
	end

	if string.find(text, "rbxassetid://", 1, true) == 1 then
		return text
	end

	local digits = string.match(text, "^%d+$")
	if digits ~= nil then
		return "rbxassetid://" .. digits
	end

	return text
end

local function mergeNamedAnimationsFromSource(
	target: { [string]: any },
	sourceRaw: any,
	parseClip: (clipRaw: any, fallbackNameRaw: any) -> { [string]: any }?
)
	if typeof(sourceRaw) ~= "table" then
		return
	end

	for key, value in sourceRaw do
		local stateKey = normalizeNamedAnimationStateKey(key)
		if stateKey == nil or target[stateKey] ~= nil then
			continue
		end

		local clip = parseClip(value, stateKey)
		if clip ~= nil then
			target[stateKey] = clip
		end
	end
end

local function shallowCopyTable(sourceRaw: any): { [string]: any }
	local copied = {}
	if typeof(sourceRaw) ~= "table" then
		return copied
	end

	for key, value in (sourceRaw :: { [string]: any }) do
		copied[key] = value
	end
	return copied
end

local function findNamedChild(container: Instance?, childName: string): Instance?
	if container == nil then
		return nil
	end
	for _, child in container:GetChildren() do
		if child.Name == childName then
			return child
		end
	end
	return nil
end

local function resolveOptionalNumber(valueRaw: any): number?
	if typeof(valueRaw) == "number" and valueRaw == valueRaw then
		return valueRaw
	end
	if typeof(valueRaw) == "string" then
		local parsed = tonumber(valueRaw)
		if parsed ~= nil and parsed == parsed then
			return parsed
		end
	end
	return nil
end

function MeleeServiceUtils.ResolveToolItemId(toolRaw: any): string?
	return ResolveToolInstance.resolveToolItemId(toolRaw)
end

function MeleeServiceUtils.ResolveToolItemType(toolRaw: any): string?
	local itemType = ResolveToolInstance.resolveToolItemType(toolRaw)
	if itemType == nil then
		return nil
	end

	local normalized = normalizeTypeToken(itemType)
	if normalized == "" then
		return nil
	end
	return normalized
end

function MeleeServiceUtils.IsSwordTool(toolRaw: any): boolean
	return MeleeServiceUtils.ResolveToolItemType(toolRaw) == "sword"
end

function MeleeServiceUtils.IsMeleeTool(toolRaw: any): boolean
	if typeof(toolRaw) ~= "Instance" or not toolRaw:IsA("Tool") then
		return false
	end

	local toolItemId = MeleeServiceUtils.ResolveToolItemId(toolRaw)
	if toolItemId ~= nil then
		local weaponConfig = MeleeServiceUtils.ResolveWeaponConfig(toolItemId)
		if weaponConfig ~= nil then
			return true
		end
	end

	local itemType = MeleeServiceUtils.ResolveToolItemType(toolRaw)
	if itemType ~= nil and MELEE_ITEM_TYPE_HINTS[itemType] then
		return true
	end

	return false
end

function MeleeServiceUtils.ResolveToolByItemId(characterRaw: any, backpackRaw: any, itemIdRaw: any): Tool?
	local itemId = resolveCanonicalItemId(itemIdRaw)
	if itemId == nil then
		return nil
	end

	local function findInContainer(containerRaw: any): Tool?
		if typeof(containerRaw) ~= "Instance" then
			return nil
		end
		local container = containerRaw :: Instance
		for _, child in container:GetChildren() do
			if not child:IsA("Tool") then
				continue
			end
			local childItemId = MeleeServiceUtils.ResolveToolItemId(child)
			if childItemId == itemId then
				return child
			end
		end
		return nil
	end

	local tool = findInContainer(characterRaw)
	if tool ~= nil then
		return tool
	end
	return findInContainer(backpackRaw)
end

function MeleeServiceUtils.ResolveToolAnimationOverrides(toolRaw: any, fallbackAnimationsRaw: any): { [string]: any }?
	if typeof(toolRaw) ~= "Instance" or not toolRaw:IsA("Tool") then
		if typeof(fallbackAnimationsRaw) == "table" then
			return shallowCopyTable(fallbackAnimationsRaw)
		end
		return nil
	end

	local tool = toolRaw :: Tool
	local animationsContainer = findNamedChild(tool, "Animations")
	if animationsContainer == nil then
		if typeof(fallbackAnimationsRaw) == "table" then
			return shallowCopyTable(fallbackAnimationsRaw)
		end
		return nil
	end

	local indexedAnimations: { { order: number, animation: Animation } } = {}
	for _, descendant in animationsContainer:GetDescendants() do
		if not descendant:IsA("Animation") then
			continue
		end

		local order = sanitizeNumber(descendant:GetAttribute("Order"), #indexedAnimations + 1, -100000, 100000)
		table.insert(indexedAnimations, {
			order = order,
			animation = descendant,
		})
	end

	table.sort(indexedAnimations, function(a, b)
		if a.order == b.order then
			return a.animation.Name < b.animation.Name
		end
		return a.order < b.order
	end)

	if #indexedAnimations <= 0 then
		if typeof(fallbackAnimationsRaw) == "table" then
			return shallowCopyTable(fallbackAnimationsRaw)
		end
		return nil
	end

	local animationConfig = if typeof(fallbackAnimationsRaw) == "table"
		then shallowCopyTable(fallbackAnimationsRaw)
		else {}
	local modeRaw = animationsContainer:GetAttribute("mode")
		or animationsContainer:GetAttribute("animationMode")
		or animationsContainer:GetAttribute("swingMode")
		or tool:GetAttribute("animationMode")
		or tool:GetAttribute("swingMode")
		or animationConfig.mode
	animationConfig.mode = normalizeAnimationMode(modeRaw)
	local stanceDelayRaw = animationsContainer:GetAttribute("stanceDelay")
		or animationsContainer:GetAttribute("weaponStanceDelay")
		or tool:GetAttribute("stanceDelay")
		or tool:GetAttribute("weaponStanceDelay")
		or animationConfig.stanceDelay
	if stanceDelayRaw ~= nil then
		animationConfig.stanceDelay = sanitizeNumber(stanceDelayRaw, 1.35, 0.05, 30)
	end

	local stanceEnabledRaw = animationsContainer:GetAttribute("stanceEnabled")
	if stanceEnabledRaw == nil then
		stanceEnabledRaw = tool:GetAttribute("stanceEnabled")
	end
	if typeof(stanceEnabledRaw) == "boolean" then
		animationConfig.stanceEnabled = stanceEnabledRaw
	end

	local clips = {}
	local animationsByLookupKey: { [string]: Animation } = {}
	for _, indexed in indexedAnimations do
		local lookupKey = normalizeAnimationLookupKey(indexed.animation.Name)
		if lookupKey ~= "" and animationsByLookupKey[lookupKey] == nil then
			animationsByLookupKey[lookupKey] = indexed.animation
		end
	end

	local namedAnimations: { [string]: any } = {}
	if typeof(animationConfig.namedAnimations) == "table" then
		for key, value in (animationConfig.namedAnimations :: { [any]: any }) do
			if typeof(key) == "string" and value ~= nil then
				namedAnimations[key] = value
			end
		end
	end

	for _, animationName in DEFAULT_TOOL_ANIMATION_LOOKUP_ORDER do
		local stateKey = normalizeNamedAnimationStateKey(animationName)
		local namedAnimation = animationsByLookupKey[normalizeAnimationLookupKey(animationName)]
		if stateKey ~= nil and namedAnimation ~= nil then
			namedAnimations[stateKey] = namedAnimation
		end
	end

	for lookupKey, animation in animationsByLookupKey do
		local stateKey = normalizeNamedAnimationStateKey(lookupKey)
		if stateKey ~= nil then
			namedAnimations[stateKey] = animation
		end
	end

	local chosenSwingAnimations: { Animation } = {}
	local chosenSwingSet: { [Animation]: boolean } = {}
	local function pushSwingAnimation(animation: Animation?)
		if animation == nil then
			return
		end
		if chosenSwingSet[animation] then
			return
		end
		chosenSwingSet[animation] = true
		table.insert(chosenSwingAnimations, animation)
	end

	for _, animationName in DEFAULT_TOOL_SWING_LOOKUP_ORDER do
		pushSwingAnimation(animationsByLookupKey[normalizeAnimationLookupKey(animationName)])
	end

	if #chosenSwingAnimations <= 0 then
		for _, indexed in indexedAnimations do
			local lookupKey = normalizeAnimationLookupKey(indexed.animation.Name)
			local isSwingLike = string.find(lookupKey, "swing", 1, true) ~= nil
				or string.find(lookupKey, "attack", 1, true) ~= nil
			if isSwingLike then
				pushSwingAnimation(indexed.animation)
			end
		end
	end

	if #chosenSwingAnimations <= 0 then
		for _, indexed in indexedAnimations do
			pushSwingAnimation(indexed.animation)
		end
	end

	for index, animation in chosenSwingAnimations do
		local speed = resolveOptionalNumber(animation:GetAttribute("speed"))
		local weight = resolveOptionalNumber(animation:GetAttribute("weight"))
		local fadeTime = resolveOptionalNumber(animation:GetAttribute("fadeTime"))
		local duration = resolveOptionalNumber(animation:GetAttribute("duration"))
		local priority = animation:GetAttribute("priority")
		table.insert(clips, {
			name = animation.Name ~= "" and animation.Name or ("Swing_%d"):format(index),
			animation = animation,
			priority = if typeof(priority) == "EnumItem" then priority else Enum.AnimationPriority.Action,
			speed = if speed ~= nil then sanitizeNumber(speed, 1, 0.01, 4) else nil,
			weight = if weight ~= nil then sanitizeNumber(weight, 1, 0.01, 10) else nil,
			fadeTime = if fadeTime ~= nil then sanitizeNumber(fadeTime, 0.06, 0, 2) else nil,
			cooldown = nil,
			duration = if duration ~= nil then sanitizeNumber(duration, duration, 0.01, 10) else nil,
		})
	end

	animationConfig.clips = clips
	if next(namedAnimations) ~= nil then
		animationConfig.namedAnimations = namedAnimations
	end
	return animationConfig
end

local function addNamedToolSound(sounds: { [string]: string }, soundName: string, soundAssetId: string)
	sounds[soundName] = soundAssetId
	sounds[string.lower(soundName)] = soundAssetId
end

local function resolveRegistryToolAudio(tool: Tool): { [string]: any }?
	local itemId = MeleeServiceUtils.ResolveToolItemId(tool)
	if itemId == nil then
		return nil
	end

	local itemType = MeleeServiceUtils.ResolveToolItemType(tool)
	if itemType ~= nil then
		local preferredAudio = ITEM_AUDIO_BY_TYPE[itemType]
		if typeof(preferredAudio) == "table" then
			local preferredEntry = preferredAudio[itemId]
			if typeof(preferredEntry) == "table" then
				return preferredEntry
			end
		end
	end

	for _, audioGroup in ITEM_AUDIO_GROUPS do
		local entry = audioGroup[itemId]
		if typeof(entry) == "table" then
			return entry
		end
	end

	return nil
end

local function buildRegistryToolSounds(tool: Tool): { [string]: string }
	local sounds: { [string]: string } = {}
	local registryAudio = resolveRegistryToolAudio(tool)
	if typeof(registryAudio) ~= "table" then
		return sounds
	end

	local equipSoundAssetId = AudioServiceUtils.normalizeSoundAssetId((registryAudio :: any).Equip)
	if equipSoundAssetId ~= nil then
		addNamedToolSound(sounds, "Equip", equipSoundAssetId)
	end

	return sounds
end

local function pushSwingSound(swingSounds: { [string]: { string } }, groupName: string, soundAssetId: string)
	local bucket = swingSounds[groupName]
	if bucket == nil then
		bucket = {}
		swingSounds[groupName] = bucket
	end
	table.insert(bucket, soundAssetId)
end

local function buildRegistryToolSwingSounds(tool: Tool): { [string]: { string } }
	local swingSounds: { [string]: { string } } = {}
	local registryAudio = resolveRegistryToolAudio(tool)
	if typeof(registryAudio) ~= "table" then
		return swingSounds
	end

	if typeof((registryAudio :: any).Swings) ~= "table" then
		return swingSounds
	end

	for index, soundIdRaw in (registryAudio :: any).Swings do
		if typeof(index) ~= "number" then
			continue
		end

		local soundAssetId = AudioServiceUtils.normalizeSoundAssetId(soundIdRaw)
		if soundAssetId ~= nil then
			pushSwingSound(swingSounds, "swing" .. tostring(math.max(1, math.floor(index))), soundAssetId)
		end
	end

	return swingSounds
end

function MeleeServiceUtils.ResolveToolSounds(toolRaw: any): { [string]: string }
	local sounds: { [string]: string } = {}
	if typeof(toolRaw) ~= "Instance" or not toolRaw:IsA("Tool") then
		return sounds
	end

	local tool = toolRaw :: Tool
	for soundName, soundAssetId in buildRegistryToolSounds(tool) do
		sounds[soundName] = soundAssetId
	end

	local soundsContainer = findNamedChild(tool, "Sounds")
	if soundsContainer == nil then
		return sounds
	end

	for _, descendant in soundsContainer:GetDescendants() do
		if not descendant:IsA("Sound") then
			continue
		end

		local soundName = trim(descendant.Name)
		if soundName ~= "" then
			local soundAssetId = AudioServiceUtils.resolveSoundAssetId(descendant)
			if soundAssetId ~= nil then
				sounds[soundName] = soundAssetId
				sounds[string.lower(soundName)] = soundAssetId
			end
		end
	end

	return sounds
end

local function normalizeSoundLookupKey(nameRaw: any): string
	local normalized = string.lower(trim(nameRaw))
	if normalized == "" then
		return ""
	end
	return string.gsub(normalized, "[%s_%-]+", "")
end

local function resolveSwingSoundGroupFromName(nameRaw: any): string?
	local normalized = normalizeSoundLookupKey(nameRaw)
	if normalized == "" then
		return nil
	end
	local swingIndexText = string.match(normalized, "^swing(%d+)$")
	if swingIndexText == nil then
		return nil
	end
	return "swing" .. swingIndexText
end

function MeleeServiceUtils.ResolveToolSwingSounds(toolRaw: any): { [string]: { string } }
	local swingSounds: { [string]: { string } } = {}
	if typeof(toolRaw) ~= "Instance" or not toolRaw:IsA("Tool") then
		return swingSounds
	end

	local tool = toolRaw :: Tool
	for groupName, soundAssetIds in buildRegistryToolSwingSounds(tool) do
		swingSounds[groupName] = Sift.Dictionary.copy(soundAssetIds)
	end

	local soundsContainer = findNamedChild(tool, "Sounds")
	if soundsContainer == nil then
		return swingSounds
	end

	for _, descendant in soundsContainer:GetDescendants() do
		if not descendant:IsA("Sound") then
			continue
		end

		local groupName = nil :: string?
		local cursor = descendant.Parent
		while cursor ~= nil and cursor ~= soundsContainer do
			groupName = resolveSwingSoundGroupFromName(cursor.Name)
			if groupName ~= nil then
				break
			end
			cursor = cursor.Parent
		end

		if groupName == nil then
			groupName = resolveSwingSoundGroupFromName(descendant.Name)
		end

		if groupName ~= nil then
			local soundAssetId = AudioServiceUtils.resolveSoundAssetId(descendant)
			if soundAssetId ~= nil then
				pushSwingSound(swingSounds, groupName, soundAssetId)
			end
		end
	end

	return swingSounds
end

local function collectStringArray(valueRaw: any): { string }
	local values = {}
	local seen = {}

	local function push(textRaw: any)
		local text = trim(textRaw)
		if text == "" or seen[text] then
			return
		end
		seen[text] = true
		table.insert(values, text)
	end

	if typeof(valueRaw) == "string" then
		push(valueRaw)
		return values
	end

	if typeof(valueRaw) == "table" then
		for _, entry in valueRaw do
			push(entry)
		end
	end

	return values
end

local function normalizeAnimationClip(clipRaw: any, fallbackNameRaw: any): { [string]: any }?
	local fallbackName = sanitizeString(fallbackNameRaw, "Swing")

	if typeof(clipRaw) == "table" then
		local clip = clipRaw :: { [string]: any }
		local animation = if typeof(clip.animation) == "Instance" and clip.animation:IsA("Animation")
			then clip.animation
			else nil
		local animationId = normalizeAnimationId(clip.id)
			or normalizeAnimationId(clip.animationId)
			or normalizeAnimationId(clip.AnimationId)
			or normalizeAnimationId(clip.assetId)
			or normalizeAnimationId(clip.animId)

		if animationId == nil then
			animationId = normalizeAnimationId(clip.animation)
		end

		if animation == nil and animationId == nil then
			return nil
		end

		return {
			name = sanitizeString(clip.name, fallbackName),
			animation = animation,
			id = animationId,
			looped = if typeof(clip.looped) == "boolean" then clip.looped else nil,
			priority = if typeof(clip.priority) == "EnumItem" then clip.priority else nil,
			speed = if typeof(clip.speed) == "number" then clip.speed else nil,
			weight = if typeof(clip.weight) == "number" then clip.weight else nil,
			fadeTime = if typeof(clip.fadeTime) == "number" then clip.fadeTime else nil,
			cooldown = nil,
			duration = if typeof(clip.duration) == "number" then clip.duration else nil,
		}
	end

	if typeof(clipRaw) == "Instance" and clipRaw:IsA("Animation") then
		return {
			name = fallbackName,
			animation = clipRaw,
			id = normalizeAnimationId(clipRaw.AnimationId),
		}
	end

	local animationId = normalizeAnimationId(clipRaw)
	if animationId == nil then
		return nil
	end

	return {
		name = fallbackName,
		id = animationId,
	}
end

local function normalizeAnimationClips(clipsRaw: any): { [number]: { [string]: any } }
	local clips = {}
	if clipsRaw == nil then
		return clips
	end

	if typeof(clipsRaw) ~= "table" then
		local single = normalizeAnimationClip(clipsRaw, "Swing_1")
		if single ~= nil then
			table.insert(clips, single)
		end
		return clips
	end

	local source = clipsRaw :: { [any]: any }
	local numericKeys = {}
	for key in source do
		if typeof(key) == "number" and key == key then
			table.insert(numericKeys, key)
		end
	end
	table.sort(numericKeys)

	local consumedKeys = {}
	local nextFallbackIndex = 1
	for _, numericKey in numericKeys do
		consumedKeys[numericKey] = true
		local fallbackName = ("Swing_%d"):format(nextFallbackIndex)
		nextFallbackIndex += 1
		local clip = normalizeAnimationClip(source[numericKey], fallbackName)
		if clip ~= nil then
			table.insert(clips, clip)
		end
	end

	local remainingEntries = {}
	for key, value in source do
		if not consumedKeys[key] then
			table.insert(remainingEntries, {
				key = key,
				value = value,
			})
		end
	end

	local function resolveSortIndex(entry: { key: any, value: any }): number
		if typeof(entry.key) ~= "string" then
			return 1_000_000
		end
		local normalized = normalizeAnimationLookupKey(entry.key)
		local indexText = string.match(normalized, "^swing(%d+)$")
		if indexText ~= nil then
			local parsed = tonumber(indexText)
			if parsed ~= nil then
				return parsed
			end
		end
		return 1_000_000
	end

	table.sort(remainingEntries, function(a, b)
		local aSortIndex = resolveSortIndex(a)
		local bSortIndex = resolveSortIndex(b)
		if aSortIndex ~= bSortIndex then
			return aSortIndex < bSortIndex
		end
		local aKeyString = tostring(a.key)
		local bKeyString = tostring(b.key)
		return aKeyString < bKeyString
	end)

	for _, entry in remainingEntries do
		local key = entry.key
		local value = entry.value
		local fallbackName = if typeof(key) == "string"
			then key
			else ("Swing_%d"):format(nextFallbackIndex)
		nextFallbackIndex += 1

		local clip: { [string]: any }?
		if typeof(key) == "string"
			and (typeof(value) == "string"
				or typeof(value) == "number"
				or (typeof(value) == "Instance" and value:IsA("Animation"))) then
			clip = normalizeAnimationClip({
				name = key,
				id = value,
			}, fallbackName)
		else
			clip = normalizeAnimationClip(value, fallbackName)
		end

		if clip ~= nil then
			table.insert(clips, clip)
		end
	end

	return clips
end

local function normalizeNamedAnimationClips(
	animationTableRaw: any,
	meleeRaw: any,
	definitionRaw: any
): { [string]: { [string]: any } }?
	local animationTable = if typeof(animationTableRaw) == "table" then (animationTableRaw :: { [string]: any }) else nil
	local melee = if typeof(meleeRaw) == "table" then (meleeRaw :: { [string]: any }) else {}
	local definition = if typeof(definitionRaw) == "table" then (definitionRaw :: { [string]: any }) else {}

	local namedAnimations: { [string]: { [string]: any } } = {}
	local function parseNamedClip(clipRaw: any, fallbackNameRaw: any): { [string]: any }?
		local clip = normalizeAnimationClip(clipRaw, fallbackNameRaw)
		if clip == nil then
			return nil
		end

		local stateKey = if typeof(fallbackNameRaw) == "string" then fallbackNameRaw else nil
		if stateKey == "Idle" or stateKey == "StanceIdle" then
			if clip.looped == nil then
				clip.looped = true
			end
		elseif stateKey == "Equip" or stateKey == "Unequip" or stateKey == "StanceTransition" then
			if clip.looped == nil then
				clip.looped = false
			end
		end
		return clip
	end

	if animationTable ~= nil then
		mergeNamedAnimationsFromSource(namedAnimations, animationTable.namedAnimations, parseNamedClip)
		mergeNamedAnimationsFromSource(namedAnimations, animationTable.named, parseNamedClip)
		mergeNamedAnimationsFromSource(namedAnimations, animationTable, parseNamedClip)
	end

	mergeNamedAnimationsFromSource(namedAnimations, melee.namedAnimations, parseNamedClip)
	mergeNamedAnimationsFromSource(namedAnimations, melee.named, parseNamedClip)
	mergeNamedAnimationsFromSource(namedAnimations, definition.namedAnimations, parseNamedClip)
	mergeNamedAnimationsFromSource(namedAnimations, definition.named, parseNamedClip)

	if next(namedAnimations) == nil then
		return nil
	end
	return namedAnimations
end

local function normalizeItemDefinition(itemId: string, moduleResultRaw: any): any?
	if typeof(moduleResultRaw) ~= "table" then
		return nil
	end

	local moduleResult = moduleResultRaw :: { [string]: any }

	local direct = moduleResult[itemId]
	if typeof(direct) == "table" then
		return direct
	end

	local definition = moduleResult.definition
	if typeof(definition) == "table" then
		return definition
	end

	if moduleResult.name ~= nil or moduleResult.useCase ~= nil or moduleResult.melee ~= nil then
		return moduleResultRaw
	end

	for _, value in moduleResult do
		if typeof(value) ~= "table" then
			continue
		end
		local candidate = value :: { [string]: any }
		if candidate.name ~= nil or candidate.useCase ~= nil or candidate.melee ~= nil then
			return candidate
		end
	end

	return nil
end

local function getItemDefinition(itemIdRaw: any): any?
	local itemId = sanitizeItemId(itemIdRaw)
	if itemId == nil then
		return nil
	end

	local canonicalItemId = resolveCanonicalItemId(itemId)
	if canonicalItemId == nil then
		return nil
	end

	local cached = cachedDefinitions[itemId]
	if cached ~= nil then
		return cached
	end
	local canonicalCached = cachedDefinitions[canonicalItemId]
	if canonicalCached ~= nil then
		cachedDefinitions[itemId] = canonicalCached
		return canonicalCached
	end

	local definitionRaw = ItemRegistry.resolveDefinition(canonicalItemId)
	if definitionRaw == nil then
		return nil
	end

	local definition = normalizeItemDefinition(canonicalItemId, definitionRaw)
	if definition == nil then
		return nil
	end

	cachedDefinitions[itemId] = definition
	cachedDefinitions[canonicalItemId] = definition
	local definitionId = sanitizeItemId((definition :: any).id)
	if definitionId ~= nil then
		cachedDefinitions[definitionId] = definition
		cachedDefinitions[string.lower(definitionId)] = definition
	end
	return definition
end

local function looksLikeMeleeWeaponName(itemId: string, displayName: string): boolean
	local haystack = string.lower(itemId .. " " .. displayName)
	for _, hint in MELEE_ITEM_NAME_HINTS do
		if string.find(haystack, hint, 1, true) ~= nil then
			return true
		end
	end
	return false
end

local function isMeleeDefinition(itemId: string, definitionRaw: any): boolean
	if typeof(definitionRaw) ~= "table" then
		return false
	end

	local definition = definitionRaw :: { [string]: any }
	if typeof(definition.melee) == "table" then
		return true
	end

	local weaponType = normalizeTypeToken(definition.weaponType)
	local weaponClass = normalizeTypeToken(definition.weaponClass)
	local className = normalizeTypeToken(definition.class)
	if weaponType == "melee" or weaponClass == "melee" or className == "melee" then
		return true
	end

	local itemType = normalizeTypeToken(definition.itemType or definition.type)
	if itemType ~= "" and MELEE_ITEM_TYPE_HINTS[itemType] then
		return true
	end

	local useCase = string.lower(trim(definition.useCase))
	if useCase ~= "weapon" then
		return false
	end

	local displayName = sanitizeString(definition.name, itemId)
	return looksLikeMeleeWeaponName(itemId, displayName)
end

local function sanitizeAnimations(animationsRaw: any, meleeRaw: any, definitionRaw: any): { [string]: any }?
	local animationTable = if typeof(animationsRaw) == "table" then (animationsRaw :: { [string]: any }) else nil
	local melee = if typeof(meleeRaw) == "table" then (meleeRaw :: { [string]: any }) else {}
	local definition = if typeof(definitionRaw) == "table" then (definitionRaw :: { [string]: any }) else {}

	local clipsRaw = nil
	if animationTable ~= nil then
		clipsRaw = animationTable.clips
		if clipsRaw == nil then
			clipsRaw = animationTable.swingAnimations
		end
		if clipsRaw == nil then
			clipsRaw = animationTable.swings
		end
		if clipsRaw == nil then
			clipsRaw = animationTable.animationIds
		end
		if clipsRaw == nil and #animationTable > 0 then
			clipsRaw = animationTable
		end
	end

	if clipsRaw == nil then
		clipsRaw = melee.swingAnimations
			or melee.swings
			or melee.animationIds
			or melee.clips
	end

	if clipsRaw == nil then
		local oneAnimation = melee.animationId
			or melee.animId
			or melee.animation
			or definition.animationId
			or definition.animId
			or definition.animation
		if oneAnimation ~= nil then
			clipsRaw = { oneAnimation }
		end
	end

	if clipsRaw == nil then
		clipsRaw = definition.swingAnimations
			or definition.swings
			or definition.animationIds
	end

	if clipsRaw == nil and animationsRaw ~= nil and typeof(animationsRaw) ~= "table" then
		clipsRaw = { animationsRaw }
	end

	local clips = normalizeAnimationClips(clipsRaw)
	if #clips <= 0 then
		return nil
	end

	local swingSpeed = resolveConfiguredSwingSpeed(melee, definition, nil)
	if swingSpeed ~= 1 then
		for _, clip in clips do
			local baseSpeed = if typeof(clip.speed) == "number" then clip.speed else 1
			clip.speed = sanitizeNumber(baseSpeed * swingSpeed, baseSpeed * swingSpeed, 0.01, 8)
			if typeof(clip.duration) == "number" then
				clip.duration = sanitizeNumber(clip.duration / swingSpeed, clip.duration / swingSpeed, 0.01, 10)
			end
			if typeof(clip.cooldown) == "number" then
				clip.cooldown = sanitizeNumber(clip.cooldown / swingSpeed, clip.cooldown / swingSpeed, 0.01, 10)
			end
		end
	end

	local modeRaw = nil
	if animationTable ~= nil then
		modeRaw = animationTable.mode or animationTable.animationMode or animationTable.swingMode
	end
	if modeRaw == nil then
		modeRaw = melee.animationMode or melee.swingMode or definition.animationMode or definition.swingMode
	end

	local markerNamesRaw = if animationTable ~= nil then animationTable.markerNames else nil
	if markerNamesRaw == nil then
		markerNamesRaw = melee.markerNames or definition.markerNames
	end
	local markerNames = collectStringArray(markerNamesRaw)
	local namedAnimations = normalizeNamedAnimationClips(animationTable, melee, definition)

	local stanceDelayRaw = if animationTable ~= nil
		then animationTable.stanceDelay or animationTable.weaponStanceDelay
		else nil
	if stanceDelayRaw == nil then
		stanceDelayRaw = melee.stanceDelay or melee.weaponStanceDelay or definition.stanceDelay or definition.weaponStanceDelay
	end
	local stanceEnabledRaw = if animationTable ~= nil then animationTable.stanceEnabled else nil
	if stanceEnabledRaw == nil then
		stanceEnabledRaw = melee.stanceEnabled or definition.stanceEnabled
	end

	local normalizedAnimations: { [string]: any } = {
		mode = normalizeAnimationMode(modeRaw),
		clips = clips,
	}
	if #markerNames > 0 then
		normalizedAnimations.markerNames = markerNames
	end
	if namedAnimations ~= nil then
		normalizedAnimations.namedAnimations = namedAnimations
	end
	if stanceDelayRaw ~= nil then
		normalizedAnimations.stanceDelay = sanitizeNumber(stanceDelayRaw, 1.35, 0.05, 30)
	end
	if typeof(stanceEnabledRaw) == "boolean" then
		normalizedAnimations.stanceEnabled = stanceEnabledRaw
	end

	return normalizedAnimations
end

local function cloneWeaponConfig(config: MeleeWeaponConfig): MeleeWeaponConfig
	return {
		itemId = config.itemId,
		displayName = config.displayName,
		damage = config.damage,
		cooldown = config.cooldown,
		slashCooldown = config.slashCooldown,
		slashResetCooldown = config.slashResetCooldown,
		swingDuration = config.swingDuration,
		hitboxDuration = config.hitboxDuration,
		range = config.range,
		width = config.width,
		height = config.height,
		pointCount = config.pointCount,
		autoRepeatWhileHeld = config.autoRepeatWhileHeld,
		canHitPlayers = config.canHitPlayers,
		canHitNpcs = config.canHitNpcs,
		animations = config.animations,
	}
end

function MeleeServiceUtils.ResolveWeaponConfig(itemIdRaw: any): MeleeWeaponConfig?
	local rawItemId = sanitizeItemId(itemIdRaw)
	if rawItemId == nil then
		return nil
	end

	local itemId = resolveCanonicalItemId(rawItemId)
	if itemId == nil then
		cachedWeaponConfigs[rawItemId] = false
		return nil
	end

	local cached = cachedWeaponConfigs[itemId]
	if cached == nil then
		cached = cachedWeaponConfigs[rawItemId]
	end
	if cached ~= nil then
		if cached == false then
			return nil
		end
		return cloneWeaponConfig(cached)
	end

	local definitionRaw = getItemDefinition(itemId)
	if definitionRaw == nil then
		cachedWeaponConfigs[itemId] = false
		cachedWeaponConfigs[rawItemId] = false
		return nil
	end

	if not isMeleeDefinition(itemId, definitionRaw) then
		cachedWeaponConfigs[itemId] = false
		cachedWeaponConfigs[rawItemId] = false
		return nil
	end

	local definition = definitionRaw :: { [string]: any }
	local stats = if typeof(definition.stats) == "table" then definition.stats else {}
	local melee = if typeof(definition.melee) == "table" then definition.melee else {}

	local damage = sanitizeNumber(
		(melee :: any).damage or (stats :: any).dmg or definition.damage,
		DEFAULT_DAMAGE,
		1,
		50000
	)
	local swingSpeed = resolveConfiguredSwingSpeed(melee, definition, stats)
	local cooldownFromSpeed = sanitizeAttackSpeedToCooldown((stats :: any).attackSpeed, DEFAULT_COOLDOWN)
	local slashCooldownBase = sanitizeNumber(
		(melee :: any).slashCooldown or (melee :: any).cooldown,
		cooldownFromSpeed,
		0.05,
		10
	)
	local slashCooldown = sanitizeNumber(slashCooldownBase / swingSpeed, slashCooldownBase / swingSpeed, 0.05, 10)
	local slashResetCooldownBase = sanitizeNumber(
		(melee :: any).slashResetCooldown or (melee :: any).comboResetCooldown or (melee :: any).resetCooldown,
		math.max(DEFAULT_SLASH_RESET_COOLDOWN, slashCooldownBase * 2),
		slashCooldownBase,
		30
	)
	local slashResetCooldown = sanitizeNumber(
		slashResetCooldownBase / swingSpeed,
		slashResetCooldownBase / swingSpeed,
		slashCooldown,
		30
	)
	local swingDurationBase = sanitizeNumber((melee :: any).swingDuration, DEFAULT_SWING_DURATION, 0.05, 5)
	local swingDuration = sanitizeNumber(swingDurationBase / swingSpeed, swingDurationBase / swingSpeed, 0.05, 5)
	local hitboxDurationBase = sanitizeNumber(
		(melee :: any).hitboxDuration,
		math.min(slashCooldownBase, DEFAULT_HITBOX_DURATION),
		0.02,
		5
	)
	local hitboxDuration =
		sanitizeNumber(hitboxDurationBase / swingSpeed, hitboxDurationBase / swingSpeed, 0.02, 5)
	local range = sanitizeNumber((melee :: any).range, DEFAULT_RANGE, 1, 30)
	local width = sanitizeNumber((melee :: any).width, DEFAULT_WIDTH, 0.1, 20)
	local height = sanitizeNumber((melee :: any).height, DEFAULT_HEIGHT, 0.1, 20)
	local pointCount = math.max(
		2,
		math.floor(sanitizeNumber((melee :: any).pointCount, DEFAULT_POINT_COUNT, 2, 30))
	)
	local displayName = sanitizeString(definition.name, itemId)

	local weaponConfig: MeleeWeaponConfig = {
		itemId = itemId,
		displayName = displayName,
		damage = damage,
		cooldown = slashCooldown,
		slashCooldown = slashCooldown,
		slashResetCooldown = slashResetCooldown,
		swingDuration = swingDuration,
		hitboxDuration = hitboxDuration,
		range = range,
		width = width,
		height = height,
		pointCount = pointCount,
		autoRepeatWhileHeld = sanitizeBoolean((melee :: any).autoRepeatWhileHeld, DEFAULT_AUTO_REPEAT),
		canHitPlayers = sanitizeBoolean((melee :: any).canHitPlayers, DEFAULT_CAN_HIT_PLAYERS),
		canHitNpcs = sanitizeBoolean((melee :: any).canHitNpcs, DEFAULT_CAN_HIT_NPCS),
		animations = sanitizeAnimations((melee :: any).animations, melee, definition),
	}

	cachedWeaponConfigs[itemId] = weaponConfig
	cachedWeaponConfigs[rawItemId] = weaponConfig
	return cloneWeaponConfig(weaponConfig)
end

function MeleeServiceUtils.BuildHitboxPoints(weaponConfigRaw: any): { Vector3 }
	if typeof(weaponConfigRaw) ~= "table" then
		return {}
	end

	local weaponConfig = weaponConfigRaw :: MeleeWeaponConfig
	local range = sanitizeNumber(weaponConfig.range, DEFAULT_RANGE, 1, 30)
	local width = sanitizeNumber(weaponConfig.width, DEFAULT_WIDTH, 0.1, 20)
	local height = sanitizeNumber(weaponConfig.height, DEFAULT_HEIGHT, 0.1, 20)
	local pointCount = math.max(2, math.floor(sanitizeNumber(weaponConfig.pointCount, DEFAULT_POINT_COUNT, 2, 40)))

	local points: { Vector3 } = {}
	local halfWidth = width * 0.5
	local startY = 1
	local yScale = math.max(0.1, height)

	for pointIndex = 0, pointCount do
		local alpha = pointIndex / pointCount
		local z = -(range * alpha)
		local y = startY + yScale * alpha
		table.insert(points, Vector3.new(0, y, z))
		table.insert(points, Vector3.new(halfWidth, y, z))
		table.insert(points, Vector3.new(-halfWidth, y, z))
	end

	return points
end

function MeleeServiceUtils.CreateMeleeClassConfig(weaponConfigRaw: any, overridesRaw: any): { [string]: any }?
	if typeof(weaponConfigRaw) ~= "table" then
		return nil
	end

	local weaponConfig = weaponConfigRaw :: MeleeWeaponConfig
	local overrides = if typeof(overridesRaw) == "table" then overridesRaw else {}
	local overrideAnimations = (overrides :: any).animations
	local weaponAnimations = weaponConfig.animations
	local animations = if overrideAnimations ~= nil then overrideAnimations else weaponAnimations
	local callbacks = if typeof((overrides :: any).callbacks) == "table" then (overrides :: any).callbacks else {}

	return {
		enabled = true,
		autoRepeatWhileHeld = if typeof((overrides :: any).autoRepeatWhileHeld) == "boolean"
			then (overrides :: any).autoRepeatWhileHeld
			else weaponConfig.autoRepeatWhileHeld,
		namedAnimationPlaybackEnabled = sanitizeBoolean((overrides :: any).namedAnimationPlaybackEnabled, true),
		stanceEnabled = if typeof((overrides :: any).stanceEnabled) == "boolean"
			then (overrides :: any).stanceEnabled
			else nil,
		stanceDelay = if (overrides :: any).stanceDelay ~= nil
			then sanitizeNumber((overrides :: any).stanceDelay, 1.35, 0.05, 30)
			else nil,
		cooldown = weaponConfig.slashCooldown,
		slashResetCooldown = weaponConfig.slashResetCooldown,
		fallbackSwingDuration = weaponConfig.swingDuration,
		fallbackSwingPadding = sanitizeNumber(
			(overrides :: any).fallbackSwingPadding,
			DEFAULT_FALLBACK_SWING_PADDING,
			0,
			2
		),
		syntheticSwingEventsWhenMissing = true,
		syntheticAttackWhenNoTrack = true,
		trackAllKeyframes = false,
		animations = animations,
		callbacks = callbacks,
		character = (overrides :: any).character,
		humanoid = (overrides :: any).humanoid,
		animator = (overrides :: any).animator,
	}
end

local function resolveClipComparableToken(clipRaw: any): string
	if typeof(clipRaw) == "Instance" and clipRaw:IsA("Animation") then
		local animationId = normalizeAnimationId(clipRaw.AnimationId)
		if animationId ~= nil then
			return animationId
		end
		return clipRaw:GetFullName()
	end

	if typeof(clipRaw) ~= "table" then
		local normalizedDirectId = normalizeAnimationId(clipRaw)
		if normalizedDirectId ~= nil then
			return normalizedDirectId
		end
		return ""
	end

	local clip = clipRaw :: { [string]: any }
	local normalizedId = normalizeAnimationId(clip.id)
		or normalizeAnimationId(clip.animationId)
		or normalizeAnimationId(clip.AnimationId)
		or normalizeAnimationId(clip.assetId)
		or normalizeAnimationId(clip.animId)

	if normalizedId ~= nil then
		return normalizedId
	end

	local animation = clip.animation
	if typeof(animation) == "Instance" and animation:IsA("Animation") then
		local animationId = normalizeAnimationId(animation.AnimationId)
		if animationId ~= nil then
			return animationId
		end
		return animation:GetFullName()
	end

	return ""
end

local function resolveNamedAnimationComparableTokens(namedRaw: any): { [string]: string }
	local comparable: { [string]: string } = {}
	if typeof(namedRaw) ~= "table" then
		return comparable
	end

	for key, value in (namedRaw :: { [any]: any }) do
		local normalizedKey = normalizeNamedAnimationStateKey(key)
		if normalizedKey == nil then
			if typeof(key) == "string" and trim(key) ~= "" then
				normalizedKey = key
			else
				continue
			end
		end

		local token = resolveClipComparableToken(value)
		if token ~= "" then
			comparable[normalizedKey] = token
		end
	end

	return comparable
end

function MeleeServiceUtils.AreAnimationConfigsEquivalent(lhsRaw: any, rhsRaw: any): boolean
	if lhsRaw == rhsRaw then
		return true
	end
	if lhsRaw == nil or rhsRaw == nil then
		return false
	end
	if typeof(lhsRaw) ~= "table" or typeof(rhsRaw) ~= "table" then
		return false
	end

	local lhs = lhsRaw :: { [string]: any }
	local rhs = rhsRaw :: { [string]: any }
	local lhsMode = normalizeAnimationMode(lhs.mode)
	local rhsMode = normalizeAnimationMode(rhs.mode)
	if lhsMode ~= rhsMode then
		return false
	end

	local lhsClips = normalizeAnimationClips(lhs.clips)
	local rhsClips = normalizeAnimationClips(rhs.clips)
	if #lhsClips ~= #rhsClips then
		return false
	end

	for clipIndex = 1, #lhsClips do
		local lhsToken = resolveClipComparableToken(lhsClips[clipIndex])
		local rhsToken = resolveClipComparableToken(rhsClips[clipIndex])
		if lhsToken ~= rhsToken then
			return false
		end
	end

	local lhsNamedComparable = resolveNamedAnimationComparableTokens(lhs.namedAnimations)
	local rhsNamedComparable = resolveNamedAnimationComparableTokens(rhs.namedAnimations)
	local lhsNamedCount = 0
	local rhsNamedCount = 0
	for _ in lhsNamedComparable do
		lhsNamedCount += 1
	end
	for _ in rhsNamedComparable do
		rhsNamedCount += 1
	end
	if lhsNamedCount ~= rhsNamedCount then
		return false
	end
	for key, lhsToken in lhsNamedComparable do
		if rhsNamedComparable[key] ~= lhsToken then
			return false
		end
	end

	local lhsStanceDelay = sanitizeNumber(lhs.stanceDelay, -1, -1, 30)
	local rhsStanceDelay = sanitizeNumber(rhs.stanceDelay, -1, -1, 30)
	if lhsStanceDelay ~= rhsStanceDelay then
		return false
	end

	local lhsStanceEnabled = if typeof(lhs.stanceEnabled) == "boolean" then lhs.stanceEnabled else nil
	local rhsStanceEnabled = if typeof(rhs.stanceEnabled) == "boolean" then rhs.stanceEnabled else nil
	if lhsStanceEnabled ~= rhsStanceEnabled then
		return false
	end

	return true
end

function MeleeServiceUtils.ResolveSelectedItemIdFromInventoryState(stateRaw: any): (string?, number?)
	if typeof(stateRaw) ~= "table" then
		return nil, nil
	end

	local state = stateRaw :: { [string]: any }
	local selectedSlotRaw = state.selectedSlot
	if typeof(selectedSlotRaw) ~= "number" or selectedSlotRaw ~= selectedSlotRaw then
		return nil, nil
	end

	local selectedSlot = math.floor(selectedSlotRaw)
	local slots = state.slots
	if typeof(slots) ~= "table" then
		return nil, selectedSlot
	end

	local slot = slots[selectedSlot]
	if typeof(slot) ~= "table" then
		return nil, selectedSlot
	end

	local stack = (slot :: any).stack
	if typeof(stack) ~= "table" then
		return nil, selectedSlot
	end

	local itemId = sanitizeItemId((stack :: any).itemId)
	return itemId, selectedSlot
end

MeleeServiceUtils.resolveToolItemId = MeleeServiceUtils.ResolveToolItemId
MeleeServiceUtils.resolveToolItemType = MeleeServiceUtils.ResolveToolItemType
MeleeServiceUtils.isSwordTool = MeleeServiceUtils.IsSwordTool
MeleeServiceUtils.isMeleeTool = MeleeServiceUtils.IsMeleeTool
MeleeServiceUtils.resolveToolByItemId = MeleeServiceUtils.ResolveToolByItemId
MeleeServiceUtils.resolveToolAnimationOverrides = MeleeServiceUtils.ResolveToolAnimationOverrides
MeleeServiceUtils.resolveToolSounds = MeleeServiceUtils.ResolveToolSounds
MeleeServiceUtils.resolveToolSwingSounds = MeleeServiceUtils.ResolveToolSwingSounds
MeleeServiceUtils.resolveWeaponConfig = MeleeServiceUtils.ResolveWeaponConfig
MeleeServiceUtils.buildHitboxPoints = MeleeServiceUtils.BuildHitboxPoints
MeleeServiceUtils.createMeleeClassConfig = MeleeServiceUtils.CreateMeleeClassConfig
MeleeServiceUtils.areAnimationConfigsEquivalent = MeleeServiceUtils.AreAnimationConfigsEquivalent
MeleeServiceUtils.resolveSelectedItemIdFromInventoryState = MeleeServiceUtils.ResolveSelectedItemIdFromInventoryState

return MeleeServiceUtils
]]></string>
              </Properties>
