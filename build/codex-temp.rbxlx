local brickcolorbyte = 30

return {
    [brickcolorbyte] = @native function(buff: buffer, byte: number, cursor: number): (BrickColor, number)
        return BrickColor.new(buffer.readu16(buff, cursor)), cursor + 2
    end;
} :: datatypedecodinginfo</string>
