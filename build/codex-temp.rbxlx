            <Item class="ModuleScript" referent="1310">
              <Properties>
                <string name="Name">Net</string>
                <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Sift = require(ReplicatedStorage.Packages.Sift)


local Shared = require(script.Parent.Shared)

local Net = {}

Net.NETWORK_METHOD_REQUEST_SYNC = "requestSync"
Net.NETWORK_METHOD_SET_STREAM_RADIUS = "setStreamRadius"
Net.NETWORK_METHOD_SUBMIT_INPUT = "submitInput"

Net.CLIENT_METHOD_APPLY_STATE = "applyState"
Net.CLIENT_METHOD_CHUNK_DELTA = "onChunkDelta"
Net.CLIENT_METHOD_CHUNK_UNLOADED = "onChunkUnloaded"
Net.CLIENT_METHOD_ENTITY_DELTA = "onEntityDelta"
Net.CLIENT_METHOD_DEBUG_COUNTERS = "onDebugCounters"
Net.TRANSITIONAL_LEGACY_BRIDGE_ENABLED = true

export type RlePair = { value: number, length: number }

export type ChunkDelta = {
	key: string,
	chunkX: number,
	chunkY: number,
	chunkZ: number,
	revision: number,
	clusterCountX: number,
	clusterCountY: number,
	clusterCountZ: number,
	clusterChosenBiomeIdsRle: { RlePair },
	clusterBlendWeightsRle: { RlePair },
	clusterSolidMaskRle: { RlePair },
	clusterSurfaceYRle: { RlePair },
	entityCount: number,
	entityIds: { number },
	entityKinds: { number },
	entityFlags: { number },
	entityPosX: { number },
	entityPosY: { number },
	entityPosZ: { number },
}

local LEGACY_BIOME_TYPE_CORRUPTION = 2
local LEGACY_AXIS_MAX = 2048

local function isFiniteNumber(value: any): boolean
	return typeof(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

local function sanitizeInteger(valueRaw: any, minimum: number, maximum: number, fallback: number): number
	if not isFiniteNumber(valueRaw) then
		return fallback
	end
	return math.clamp(math.floor(valueRaw), minimum, maximum)
end

local function sanitizeBiomeId(valueRaw: any, fallback: number): number
	return sanitizeInteger(valueRaw, Shared.BIOME_ID.FOREST, Shared.BIOME_ID.CORRUPTION, fallback)
end

local function decodeClusterIndex(index: number, countX: number, countY: number): (number, number, number)
	local linear = index - 1
	local clusterX = linear % countX
	local layer = math.floor(linear / countX)
	local clusterY = layer % countY
	local clusterZ = math.floor(layer / countY)
	return clusterX, clusterY, clusterZ
end

local function unpackLegacyChunkKey(chunkKeyRaw: any): (number?, number?, number?)
	if typeof(chunkKeyRaw) ~= "string" then
		return nil, nil, nil
	end

	local chunkX, chunkY, chunkZ = Shared.unpackChunkKey(chunkKeyRaw)
	if chunkX ~= nil and chunkY ~= nil and chunkZ ~= nil then
		return chunkX, chunkY, chunkZ
	end

	local xRaw, yRaw = string.match(chunkKeyRaw, "^(-?%d+):(-?%d+)$")
	if xRaw == nil or yRaw == nil then
		return nil, nil, nil
	end

	local x = tonumber(xRaw)
	local y = tonumber(yRaw)
	if x == nil or y == nil then
		return nil, nil, nil
	end

	return x, y, 0
end

function Net.EncodeRle(numbers: { number }): { RlePair }
	local encoded: { RlePair } = {}
	if #numbers <= 0 then
		return encoded
	end

	local currentValue = numbers[1]
	local currentLength = 1
	for index = 2, #numbers do
		local value = numbers[index]
		if value == currentValue then
			currentLength += 1
		else
			encoded[#encoded + 1] = {
				value = currentValue,
				length = currentLength,
			}
			currentValue = value
			currentLength = 1
		end
	end

	encoded[#encoded + 1] = {
		value = currentValue,
		length = currentLength,
	}
	return encoded
end

function Net.DecodeRle(rleRaw: any): { number }
	if typeof(rleRaw) ~= "table" then
		return {}
	end

	local totalLength = 0
	for _, pair in rleRaw do
		if typeof(pair) == "table" then
			local length = sanitizeInteger((pair :: any).length, 1, 10000000, 1)
			totalLength += length
		end
	end

	local output = Sift.Array.create(totalLength, 0)
	local cursor = 1
	for _, pair in rleRaw do
		if typeof(pair) ~= "table" then
			continue
		end
		local value = if isFiniteNumber((pair :: any).value) then (pair :: any).value else 0
		local length = sanitizeInteger((pair :: any).length, 1, 10000000, 1)
		for _ = 1, length do
			output[cursor] = value
			cursor += 1
		end
	end
	return output
end

local function copyEntitySlice(array: { number }, count: number): { number }
	local copied = Sift.Array.create(count, 0)
	for index = 1, count do
		copied[index] = array[index]
	end
	return copied
end

local function copyLegacyEntitySlice(valuesRaw: any, count: number): { number }
	local copied = Sift.Array.create(count, 0)
	if typeof(valuesRaw) ~= "table" then
		return copied
	end
	for index = 1, count do
		local raw = (valuesRaw :: any)[index]
		copied[index] = if isFiniteNumber(raw) then raw else 0
	end
	return copied
end

function Net.BuildChunkDelta(chunk: { [string]: any }, previousRevision: number?): ChunkDelta?
	if typeof(chunk) ~= "table" then
		return nil
	end

	local hasClusterArrays = typeof(chunk.clusterChosenBiomeIds) == "table"
		and typeof(chunk.clusterBlendWeights) == "table"
		and typeof(chunk.clusterSolidMask) == "table"
		and typeof(chunk.clusterSurfaceY) == "table"

	if not hasClusterArrays then
		if not Net.TRANSITIONAL_LEGACY_BRIDGE_ENABLED then
			return nil
		end
		local translated = Net.TranslateLegacyChunkToChunkDeltaTransitional(chunk)
		if translated == nil then
			return nil
		end
		if previousRevision ~= nil and previousRevision == translated.revision then
			return nil
		end
		return translated
	end

	if previousRevision ~= nil and previousRevision == chunk.revision then
		return nil
	end

	local entities = chunk.entities
	local entityCount = if typeof(entities) == "table" then sanitizeInteger((entities :: any).count, 0, 1000000, 0) else 0

	return {
		key = chunk.key,
		chunkX = chunk.chunkX,
		chunkY = chunk.chunkY,
		chunkZ = chunk.chunkZ,
		revision = chunk.revision,
		clusterCountX = chunk.clusterCountX,
		clusterCountY = chunk.clusterCountY,
		clusterCountZ = chunk.clusterCountZ,
		clusterChosenBiomeIdsRle = Net.EncodeRle(chunk.clusterChosenBiomeIds),
		clusterBlendWeightsRle = Net.EncodeRle(chunk.clusterBlendWeights),
		clusterSolidMaskRle = Net.EncodeRle(chunk.clusterSolidMask),
		clusterSurfaceYRle = Net.EncodeRle(chunk.clusterSurfaceY),
		entityCount = entityCount,
		entityIds = if entityCount > 0 then copyEntitySlice(entities.ids, entityCount) else {},
		entityKinds = if entityCount > 0 then copyEntitySlice(entities.kinds, entityCount) else {},
		entityFlags = if entityCount > 0 then copyEntitySlice(entities.flags, entityCount) else {},
		entityPosX = if entityCount > 0 then copyEntitySlice(entities.posX, entityCount) else {},
		entityPosY = if entityCount > 0 then copyEntitySlice(entities.posY, entityCount) else {},
		entityPosZ = if entityCount > 0 then copyEntitySlice(entities.posZ, entityCount) else {},
	}
end

function Net.DecodeChunkDelta(deltaRaw: any): { [string]: any }?
	if typeof(deltaRaw) ~= "table" then
		return nil
	end
	local key = (deltaRaw :: any).key
	if typeof(key) ~= "string" or key == "" then
		return nil
	end

	local clusterChosenBiomeIds = Net.DecodeRle((deltaRaw :: any).clusterChosenBiomeIdsRle)
	local clusterBlendWeights = Net.DecodeRle((deltaRaw :: any).clusterBlendWeightsRle)
	local clusterSolidMask = Net.DecodeRle((deltaRaw :: any).clusterSolidMaskRle)
	local clusterSurfaceY = Net.DecodeRle((deltaRaw :: any).clusterSurfaceYRle)

	return {
		key = key,
		chunkX = sanitizeInteger((deltaRaw :: any).chunkX, -1000000, 1000000, 0),
		chunkY = sanitizeInteger((deltaRaw :: any).chunkY, -1000000, 1000000, 0),
		chunkZ = sanitizeInteger((deltaRaw :: any).chunkZ, -1000000, 1000000, 0),
		revision = sanitizeInteger((deltaRaw :: any).revision, 0, 1000000000, 0),
		clusterCountX = sanitizeInteger((deltaRaw :: any).clusterCountX, 1, 512, 1),
		clusterCountY = sanitizeInteger((deltaRaw :: any).clusterCountY, 1, 512, 1),
		clusterCountZ = sanitizeInteger((deltaRaw :: any).clusterCountZ, 1, 512, 1),
		clusterChosenBiomeIds = clusterChosenBiomeIds,
		clusterBlendWeights = clusterBlendWeights,
		clusterSolidMask = clusterSolidMask,
		clusterSurfaceY = clusterSurfaceY,
		entityCount = sanitizeInteger((deltaRaw :: any).entityCount, 0, 100000, 0),
		entityIds = if typeof((deltaRaw :: any).entityIds) == "table" then (deltaRaw :: any).entityIds else {},
		entityKinds = if typeof((deltaRaw :: any).entityKinds) == "table" then (deltaRaw :: any).entityKinds else {},
		entityFlags = if typeof((deltaRaw :: any).entityFlags) == "table" then (deltaRaw :: any).entityFlags else {},
		entityPosX = if typeof((deltaRaw :: any).entityPosX) == "table" then (deltaRaw :: any).entityPosX else {},
		entityPosY = if typeof((deltaRaw :: any).entityPosY) == "table" then (deltaRaw :: any).entityPosY else {},
		entityPosZ = if typeof((deltaRaw :: any).entityPosZ) == "table" then (deltaRaw :: any).entityPosZ else {},
	}
end

local function resolveLegacyBiomeId(biomeIdRaw: any, biomeTypeRaw: any, fallbackBiomeId: number): number
	if isFiniteNumber(biomeIdRaw) then
		return sanitizeBiomeId(biomeIdRaw, fallbackBiomeId)
	end
	if isFiniteNumber(biomeTypeRaw) then
		local biomeType = math.floor(biomeTypeRaw)
		if biomeType == LEGACY_BIOME_TYPE_CORRUPTION then
			return Shared.BIOME_ID.CORRUPTION
		end
	end
	return fallbackBiomeId
end

local function resolveLegacyChunkCoordinates(legacy: { [string]: any }): (number, number, number, string)
	local chunkX = sanitizeInteger(legacy.chunkX, -1000000, 1000000, 0)
	local chunkY = sanitizeInteger(legacy.chunkY, -1000000, 1000000, 0)
	local chunkZ = sanitizeInteger(legacy.chunkZ, -1000000, 1000000, 0)
	local key = Shared.packChunkKey(chunkX, chunkY, chunkZ)

	local parsedX, parsedY, parsedZ = unpackLegacyChunkKey(legacy.key)
	if parsedX ~= nil and parsedY ~= nil and parsedZ ~= nil then
		chunkX = parsedX
		chunkY = parsedY
		chunkZ = parsedZ
		key = Shared.packChunkKey(chunkX, chunkY, chunkZ)
	end

	return chunkX, chunkY, chunkZ, key
end

local function resolveLegacyAxisSize(legacy: { [string]: any }, fieldPrimary: string, fieldSecondary: string, fallback: number): number
	local primary = sanitizeInteger(legacy[fieldPrimary], 1, LEGACY_AXIS_MAX, 0)
	if primary > 0 then
		return primary
	end
	local secondary = sanitizeInteger(legacy[fieldSecondary], 1, LEGACY_AXIS_MAX, 0)
	if secondary > 0 then
		return secondary
	end
	return fallback
end

local function resolveLegacyClusterAxisCount(legacy: { [string]: any }, clusterField: string, tileAxisSize: number): number
	local direct = sanitizeInteger(legacy[clusterField], 1, 512, 0)
	if direct > 0 then
		return direct
	end
	return math.max(1, math.ceil(tileAxisSize / math.max(1, Shared.CLUSTER_SIZE)))
end

function Net.DecodeLegacyChunkTransitional(legacyRaw: any): { [string]: any }?
	if not Net.TRANSITIONAL_LEGACY_BRIDGE_ENABLED then
		return nil
	end
	if typeof(legacyRaw) ~= "table" then
		return nil
	end

	local legacy = legacyRaw :: { [string]: any }
	local hasLegacyData = typeof(legacy.tiles) == "table"
		or typeof(legacy.biomeIds) == "table"
		or typeof(legacy.biomeTypes) == "table"
		or typeof(legacy.clusterChosenBiomeIds) == "table"
		or typeof(legacy.clusterSolidMask) == "table"
	if not hasLegacyData then
		return nil
	end

	local chunkX, chunkY, chunkZ, key = resolveLegacyChunkCoordinates(legacy)
	local tileCountX = resolveLegacyAxisSize(legacy, "tileCountX", "width", Shared.CLUSTER_SIZE)
	local tileCountY = resolveLegacyAxisSize(legacy, "tileCountY", "height", Shared.CLUSTER_SIZE)
	local tileCountZ = resolveLegacyAxisSize(legacy, "tileCountZ", "depth", 1)

	local clusterCountX = resolveLegacyClusterAxisCount(legacy, "clusterCountX", tileCountX)
	local clusterCountY = resolveLegacyClusterAxisCount(legacy, "clusterCountY", tileCountY)
	local clusterCountZ = resolveLegacyClusterAxisCount(legacy, "clusterCountZ", tileCountZ)
	local expectedClusters = clusterCountX * clusterCountY * clusterCountZ
	local clusterSize = math.max(1, Shared.CLUSTER_SIZE)

	local dominantBiomeId = sanitizeBiomeId(legacy.dominantBiomeId, Shared.BIOME_ID.FOREST)
	local revision = sanitizeInteger(legacy.revision, 0, 1000000000, 0)
	local tileMinY = sanitizeInteger(legacy.tileMinY, -1000000, 1000000, chunkY * tileCountY)

	local clusterChosenBiomeIds = Sift.Array.create(expectedClusters, dominantBiomeId)
	local clusterBlendWeights = Sift.Array.create(expectedClusters, 0)
	local clusterSolidMask = Sift.Array.create(expectedClusters, 0)
	local clusterSurfaceY = Sift.Array.create(expectedClusters, tileMinY)

	local clusterChosenBiomeIdsRaw = if typeof(legacy.clusterChosenBiomeIds) == "table"
		then (legacy.clusterChosenBiomeIds :: { any })
		else nil
	local clusterBlendWeightsRaw = if typeof(legacy.clusterBlendWeights) == "table"
		then (legacy.clusterBlendWeights :: { any })
		else nil
	local clusterSolidMaskRaw = if typeof(legacy.clusterSolidMask) == "table" then (legacy.clusterSolidMask :: { any }) else nil
	local clusterSurfaceYRaw = if typeof(legacy.clusterSurfaceY) == "table" then (legacy.clusterSurfaceY :: { any }) else nil

	if clusterChosenBiomeIdsRaw ~= nil then
		for clusterIndex = 1, expectedClusters do
			clusterChosenBiomeIds[clusterIndex] = sanitizeBiomeId(clusterChosenBiomeIdsRaw[clusterIndex], dominantBiomeId)
			clusterBlendWeights[clusterIndex] = if clusterBlendWeightsRaw ~= nil
				then sanitizeInteger(clusterBlendWeightsRaw[clusterIndex], 0, 255, 0)
				else 0
			clusterSolidMask[clusterIndex] = if clusterSolidMaskRaw ~= nil
				then sanitizeInteger(clusterSolidMaskRaw[clusterIndex], 0, 1, 0)
				else 0

			local clusterLocalX, clusterLocalY, _ = decodeClusterIndex(clusterIndex, clusterCountX, clusterCountY)
			local fallbackSurface = tileMinY + clusterLocalY * clusterSize + (clusterSize - 1)
			clusterSurfaceY[clusterIndex] = if clusterSurfaceYRaw ~= nil
				then sanitizeInteger(clusterSurfaceYRaw[clusterIndex], -1000000, 1000000, fallbackSurface)
				else fallbackSurface
		end
	else
		local tiles = if typeof(legacy.tiles) == "table" then (legacy.tiles :: { any }) else {}
		local biomeIds = if typeof(legacy.biomeIds) == "table" then (legacy.biomeIds :: { any }) else {}
		local biomeTypes = if typeof(legacy.biomeTypes) == "table" then (legacy.biomeTypes :: { any }) else {}
		local blendWeightsRaw = if typeof(legacy.blendWeights) == "table" then (legacy.blendWeights :: { any }) else nil

		local layerArea = tileCountX * tileCountY
		for clusterLocalZ = 0, clusterCountZ - 1 do
			for clusterLocalY = 0, clusterCountY - 1 do
				for clusterLocalX = 0, clusterCountX - 1 do
					local clusterIndex = Shared.computeClusterIndex(
						clusterLocalX,
						clusterLocalY,
						clusterLocalZ,
						clusterCountX,
						clusterCountY
					)
					local minTileX = clusterLocalX * clusterSize
					local minLocalTileY = clusterLocalY * clusterSize
					local minLocalTileZ = clusterLocalZ * clusterSize
					local maxTileX = math.min(tileCountX - 1, minTileX + clusterSize - 1)
					local maxLocalTileY = math.min(tileCountY - 1, minLocalTileY + clusterSize - 1)
					local maxLocalTileZ = math.min(tileCountZ - 1, minLocalTileZ + clusterSize - 1)

					local forestCount = 0
					local desertCount = 0
					local snowCount = 0
					local jungleCount = 0
					local corruptionCount = 0
					local solidMask = 0
					local highestSolidTileY = -1

					for localTileZ = minLocalTileZ, maxLocalTileZ do
						for localTileY = minLocalTileY, maxLocalTileY do
							for localTileX = minTileX, maxTileX do
								local tileIndex = localTileZ * layerArea + localTileY * tileCountX + localTileX + 1
								local tileId = sanitizeInteger(tiles[tileIndex], 0, 65535, 0)
								if tileId ~= 0 then
									solidMask = 1
									if localTileY > highestSolidTileY then
										highestSolidTileY = localTileY
									end
								end

								local biomeId = resolveLegacyBiomeId(biomeIds[tileIndex], biomeTypes[tileIndex], dominantBiomeId)
								if biomeId == Shared.BIOME_ID.CORRUPTION then
									corruptionCount += 1
								elseif biomeId == Shared.BIOME_ID.JUNGLE then
									jungleCount += 1
								elseif biomeId == Shared.BIOME_ID.SNOW then
									snowCount += 1
								elseif biomeId == Shared.BIOME_ID.DESERT then
									desertCount += 1
								else
									forestCount += 1
								end
							end
						end
					end

					local chosenBiome = dominantBiomeId
					local bestCount = 0
					if forestCount > bestCount then
						bestCount = forestCount
						chosenBiome = Shared.BIOME_ID.FOREST
					end
					if desertCount > bestCount then
						bestCount = desertCount
						chosenBiome = Shared.BIOME_ID.DESERT
					end
					if snowCount > bestCount then
						bestCount = snowCount
						chosenBiome = Shared.BIOME_ID.SNOW
					end
					if jungleCount > bestCount then
						bestCount = jungleCount
						chosenBiome = Shared.BIOME_ID.JUNGLE
					end
					if corruptionCount > bestCount then
						chosenBiome = Shared.BIOME_ID.CORRUPTION
					end

					clusterChosenBiomeIds[clusterIndex] = chosenBiome
					clusterSolidMask[clusterIndex] = solidMask
					clusterSurfaceY[clusterIndex] = tileMinY + (if highestSolidTileY >= 0 then highestSolidTileY else maxLocalTileY)
					clusterBlendWeights[clusterIndex] = if blendWeightsRaw ~= nil
						then sanitizeInteger(blendWeightsRaw[clusterIndex], 0, 255, 0)
						else 0
				end
			end
		end
	end

	local entityCount = sanitizeInteger(legacy.entityCount, 0, 100000, 0)
	return {
		key = key,
		chunkX = chunkX,
		chunkY = chunkY,
		chunkZ = chunkZ,
		revision = revision,
		clusterCountX = clusterCountX,
		clusterCountY = clusterCountY,
		clusterCountZ = clusterCountZ,
		clusterChosenBiomeIds = clusterChosenBiomeIds,
		clusterBlendWeights = clusterBlendWeights,
		clusterSolidMask = clusterSolidMask,
		clusterSurfaceY = clusterSurfaceY,
		entityCount = entityCount,
		entityIds = copyLegacyEntitySlice(legacy.entityIds, entityCount),
		entityKinds = copyLegacyEntitySlice(legacy.entityKinds, entityCount),
		entityFlags = copyLegacyEntitySlice(legacy.entityFlags, entityCount),
		entityPosX = copyLegacyEntitySlice(legacy.entityPosX, entityCount),
		entityPosY = copyLegacyEntitySlice(legacy.entityPosY, entityCount),
		entityPosZ = copyLegacyEntitySlice(legacy.entityPosZ, entityCount),
	}
end

function Net.TranslateLegacyChunkToChunkDeltaTransitional(legacyRaw: any): ChunkDelta?
	local decoded = Net.DecodeLegacyChunkTransitional(legacyRaw)
	if decoded == nil then
		return nil
	end

	local entityCount = sanitizeInteger(decoded.entityCount, 0, 100000, 0)
	return {
		key = decoded.key,
		chunkX = decoded.chunkX,
		chunkY = decoded.chunkY,
		chunkZ = decoded.chunkZ,
		revision = decoded.revision,
		clusterCountX = decoded.clusterCountX,
		clusterCountY = decoded.clusterCountY,
		clusterCountZ = decoded.clusterCountZ,
		clusterChosenBiomeIdsRle = Net.EncodeRle(decoded.clusterChosenBiomeIds),
		clusterBlendWeightsRle = Net.EncodeRle(decoded.clusterBlendWeights),
		clusterSolidMaskRle = Net.EncodeRle(decoded.clusterSolidMask),
		clusterSurfaceYRle = Net.EncodeRle(decoded.clusterSurfaceY),
		entityCount = entityCount,
		entityIds = if entityCount > 0 then copyEntitySlice(decoded.entityIds, entityCount) else {},
		entityKinds = if entityCount > 0 then copyEntitySlice(decoded.entityKinds, entityCount) else {},
		entityFlags = if entityCount > 0 then copyEntitySlice(decoded.entityFlags, entityCount) else {},
		entityPosX = if entityCount > 0 then copyEntitySlice(decoded.entityPosX, entityCount) else {},
		entityPosY = if entityCount > 0 then copyEntitySlice(decoded.entityPosY, entityCount) else {},
		entityPosZ = if entityCount > 0 then copyEntitySlice(decoded.entityPosZ, entityCount) else {},
	}
end

function Net.DecodeChunkPayload(payloadRaw: any): { [string]: any }?
	local decoded = Net.DecodeChunkDelta(payloadRaw)
	if decoded ~= nil then
		return decoded
	end
	return Net.DecodeLegacyChunkTransitional(payloadRaw)
end

function Net.ValidateClientInput(inputRaw: any): (boolean, string)
	if typeof(inputRaw) ~= "table" then
		return false, "payload must be a table"
	end

	local input = inputRaw :: { [string]: any }
	local entityId = sanitizeInteger(input.entityId, 0, 1000000000, 0)
	if entityId <= 0 then
		return false, "entityId is required"
	end
	if not isFiniteNumber(input.moveX) or not isFiniteNumber(input.moveZ) then
		return false, "moveX/moveZ must be numbers"
	end
	if math.abs(input.moveX) > 1.001 or math.abs(input.moveZ) > 1.001 then
		return false, "move input outside [-1, 1]"
	end
	return true, "ok"
end

function Net.PredictEntityPosition(
	currentX: number,
	currentY: number,
	currentZ: number,
	velocityX: number,
	velocityY: number,
	velocityZ: number,
	deltaTime: number
): (number, number, number)
	return currentX + velocityX * deltaTime, currentY + velocityY * deltaTime, currentZ + velocityZ * deltaTime
end

function Net.SanitizeStreamRadius(valueRaw: any, fallback: number): number
	return sanitizeInteger(valueRaw, 1, 32, fallback)
end

function Net.ChunkPriorityFromCenter(chunkX: number, chunkY: number, chunkZ: number, centerX: number, centerY: number, centerZ: number): number
	local dx = chunkX - centerX
	local dy = chunkY - centerY
	local dz = chunkZ - centerZ
	return dx * dx + dy * dy + dz * dz
end

function Net.UnpackChunkKey(chunkKey: string): (number?, number?, number?)
	return Shared.unpackChunkKey(chunkKey)
end

Net.encodeRle = Net.EncodeRle
Net.decodeRle = Net.DecodeRle
Net.buildChunkDelta = Net.BuildChunkDelta
Net.decodeChunkDelta = Net.DecodeChunkDelta
Net.decodeLegacyChunkTransitional = Net.DecodeLegacyChunkTransitional
Net.translateLegacyChunkToChunkDeltaTransitional = Net.TranslateLegacyChunkToChunkDeltaTransitional
Net.decodeChunkPayload = Net.DecodeChunkPayload
Net.validateClientInput = Net.ValidateClientInput
Net.predictEntityPosition = Net.PredictEntityPosition
Net.sanitizeStreamRadius = Net.SanitizeStreamRadius
Net.chunkPriorityFromCenter = Net.ChunkPriorityFromCenter
Net.unpackChunkKey = Net.UnpackChunkKey

return Net
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="1311">
              <Properties>
                <string name="Name">NpcServiceUtils</string>
                <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Sift = require(ReplicatedStorage.Packages.Sift)

local Workspace = game:GetService("Workspace")
local TagBinder = require(script:FindFirstAncestor("game").Shared.Binders.TagBinder)

local NpcServiceUtils = {}

export type NpcType = "Slime"
export type NpcRuntimeState =
	"Dormant"
	| "Spawning"
	| "AwaitingBiome"
	| "Idle"
	| "Searching"
	| "Aggro"
	| "Attacking"
	| "Dead"
export type BiomeName = "Unknown" | "Forest" | "Desert" | "Snow" | "Jungle"

export type StateMachineGraph = {
	[NpcRuntimeState]: { [NpcRuntimeState]: boolean },
}

export type AnimationEventActionKind = "sound" | "animation"

export type AnimationEventAction = {
	kind: AnimationEventActionKind,
	source: any?,
	sound: any?,
	animation: any?,
	soundName: string?,
	animationName: string?,
	volume: number?,
	playbackSpeed: number?,
	weight: number?,
	fadeTime: number?,
	looped: boolean?,
	autoDestroy: boolean?,
	priority: Enum.AnimationPriority?,
	rollOffMaxDistance: number?,
	emitterSize: number?,
	stopOtherTracks: boolean?,
	playOnClient: boolean?,
}

export type AnimationEventBinding = {
	markers: { [string]: { AnimationEventAction } },
	keyframes: { [string]: { AnimationEventAction } },
}

export type AnimationEventsByTrack = {
	[string]: AnimationEventBinding,
}

export type NpcSnapshot = {
	id: string,
	npcType: NpcType,
	displayName: string,
	state: NpcRuntimeState,
	biomeName: BiomeName,
	biomeReady: boolean,
	hp: number,
	maxHp: number,
	isAlive: boolean,
	position: Vector3?,
	updatedAt: number,
	lastReason: string,
}

export type SlimeSpawnConfig = {
	slimeType: string,
	displayName: string,
	modelName: string,
	modelHierarchy: string?,
	planeX: number?,
	aggroOnPlayer: boolean,
	passiveUntilHit: boolean,
	spawnCFrame: CFrame,
	restDuration: number?,
	hopDuration: number?,
	hopDistance: number?,
	animationEvents: AnimationEventsByTrack?,
}

export type SlimeSpawnSettings = {
	enabled: boolean,
	initialSpawnCount: number,
	maxAlive: number,
	spawnRate: number,
	spawnChance: number,
	despawnDistance: number,
}

local RBX_ASSET_PREFIX = "rbxassetid://"

local DEFAULT_SLIME_SPAWN_SETTINGS: SlimeSpawnSettings = {
	enabled = true,
	initialSpawnCount = 3,
	maxAlive = 8,
	spawnRate = 2,
	spawnChance = 0.4,
	despawnDistance = 220,
}

local DEFAULT_REQUEST_SYNC_METHOD = "requestSync"
local DEFAULT_APPLY_STATE_METHOD = "applyState"
local DEFAULT_NPC_ADDED_METHOD = "onNpcAdded"
local DEFAULT_NPC_REMOVED_METHOD = "onNpcRemoved"
local DEFAULT_NPC_STATE_CHANGED_METHOD = "onNpcStateChanged"
local DEFAULT_NPC_ANIMATION_EVENT_METHOD = "onNpcAnimationEvent"

NpcServiceUtils.NETWORK_METHOD_REQUEST_SYNC = DEFAULT_REQUEST_SYNC_METHOD
NpcServiceUtils.CLIENT_METHOD_APPLY_STATE = DEFAULT_APPLY_STATE_METHOD
NpcServiceUtils.CLIENT_METHOD_NPC_ADDED = DEFAULT_NPC_ADDED_METHOD
NpcServiceUtils.CLIENT_METHOD_NPC_REMOVED = DEFAULT_NPC_REMOVED_METHOD
NpcServiceUtils.CLIENT_METHOD_NPC_STATE_CHANGED = DEFAULT_NPC_STATE_CHANGED_METHOD
NpcServiceUtils.CLIENT_METHOD_NPC_ANIMATION_EVENT = DEFAULT_NPC_ANIMATION_EVENT_METHOD
NpcServiceUtils.RUNTIME_ID_ATTRIBUTE = "NpcRuntimeId"
NpcServiceUtils.RUNTIME_NPC_TYPE_ATTRIBUTE = "NpcRuntimeType"
NpcServiceUtils.RUNTIME_DISPLAY_NAME_ATTRIBUTE = "NpcDisplayName"

local DEFAULT_STATE_MACHINE_GRAPH: StateMachineGraph = {
	Dormant = {
		Spawning = true,
		Dead = true,
	},
	Spawning = {
		AwaitingBiome = true,
		Idle = true,
		Searching = true,
		Aggro = true,
		Dead = true,
	},
	AwaitingBiome = {
		Idle = true,
		Searching = true,
		Aggro = true,
		Attacking = true,
		Dead = true,
	},
	Idle = {
		Searching = true,
		Aggro = true,
		Attacking = true,
		AwaitingBiome = true,
		Dead = true,
	},
	Searching = {
		Idle = true,
		Aggro = true,
		Attacking = true,
		AwaitingBiome = true,
		Dead = true,
	},
	Aggro = {
		Idle = true,
		Searching = true,
		Attacking = true,
		AwaitingBiome = true,
		Dead = true,
	},
	Attacking = {
		Idle = true,
		Searching = true,
		Aggro = true,
		AwaitingBiome = true,
		Dead = true,
	},
	Dead = {
		Dormant = true,
		Spawning = true,
	},
}

local BIOME_ID_TO_NAME = {
	FOREST = "Forest" :: BiomeName,
	DESERT = "Desert" :: BiomeName,
	SNOW = "Snow" :: BiomeName,
	JUNGLE = "Jungle" :: BiomeName,
}

local function clampNumber(valueRaw: any, minimum: number, maximum: number, fallback: number): number
	if typeof(valueRaw) ~= "number" or valueRaw ~= valueRaw then
		return fallback
	end
	return math.clamp(valueRaw, minimum, maximum)
end

local function clampInteger(valueRaw: any, minimum: number, maximum: number, fallback: number): number
	return math.floor(clampNumber(valueRaw, minimum, maximum, fallback))
end

local function trim(textRaw: any): string
	if typeof(textRaw) ~= "string" then
		return ""
	end
	return string.match(textRaw, "^%s*(.-)%s*$") or ""
end

local function cloneStateGraph(source: StateMachineGraph): StateMachineGraph
	local out: StateMachineGraph = {}
	for fromState, toStates in source do
		local outTransitions: { [NpcRuntimeState]: boolean } = {}
		for toState, allowed in toStates do
			outTransitions[toState] = allowed == true
		end
		out[fromState] = outTransitions
	end
	return out
end

local function cloneAnimationEventAction(action: AnimationEventAction): AnimationEventAction
	return {
		kind = action.kind,
		source = action.source,
		sound = action.sound,
		animation = action.animation,
		soundName = action.soundName,
		animationName = action.animationName,
		volume = action.volume,
		playbackSpeed = action.playbackSpeed,
		weight = action.weight,
		fadeTime = action.fadeTime,
		looped = action.looped,
		autoDestroy = action.autoDestroy,
		priority = action.priority,
		rollOffMaxDistance = action.rollOffMaxDistance,
		emitterSize = action.emitterSize,
		stopOtherTracks = action.stopOtherTracks,
		playOnClient = action.playOnClient,
	}
end

local function cloneAnimationActions(actions: { AnimationEventAction }): { AnimationEventAction }
	local out = Sift.Array.create(#actions)
	for index, action in actions do
		out[index] = cloneAnimationEventAction(action)
	end
	return out
end

local function cloneAnimationEventBinding(binding: AnimationEventBinding): AnimationEventBinding
	local markers: { [string]: { AnimationEventAction } } = {}
	local keyframes: { [string]: { AnimationEventAction } } = {}

	for eventName, actions in binding.markers do
		markers[eventName] = cloneAnimationActions(actions)
	end

	for eventName, actions in binding.keyframes do
		keyframes[eventName] = cloneAnimationActions(actions)
	end

	return {
		markers = markers,
		keyframes = keyframes,
	}
end

local function cloneAnimationEvents(events: AnimationEventsByTrack): AnimationEventsByTrack
	local out: AnimationEventsByTrack = {}
	for trackName, binding in events do
		out[trackName] = cloneAnimationEventBinding(binding)
	end
	return out
end

local function normalizeActionKind(actionRaw: any): AnimationEventActionKind
	local token = string.lower(trim((actionRaw :: any).kind))
	if token == "animation" then
		return "animation"
	end
	if token == "sound" then
		return "sound"
	end
	if (actionRaw :: any).animation ~= nil or (actionRaw :: any).animationName ~= nil then
		return "animation"
	end
	return "sound"
end

local function sanitizeAnimationAction(actionRaw: any): AnimationEventAction?
	if typeof(actionRaw) ~= "table" then
		return nil
	end

	local action = actionRaw :: { [string]: any }
	local kind = normalizeActionKind(action)
	local soundName = trim(action.soundName)
	local animationName = trim(action.animationName)
	local source = action.source

	if kind == "sound" then
		source = if action.sound ~= nil then action.sound else source
	else
		source = if action.animation ~= nil then action.animation else source
	end

	if source == nil and soundName == "" and animationName == "" then
		return nil
	end

	return {
		kind = kind,
		source = source,
		sound = action.sound,
		animation = action.animation,
		soundName = if soundName ~= "" then soundName else nil,
		animationName = if animationName ~= "" then animationName else nil,
		volume = if typeof(action.volume) == "number" then clampNumber(action.volume, 0, 10, 1) else nil,
		playbackSpeed = if typeof(action.playbackSpeed) == "number"
			then clampNumber(action.playbackSpeed, 0.05, 6, 1)
			else nil,
		weight = if typeof(action.weight) == "number" then clampNumber(action.weight, 0.05, 10, 1) else nil,
		fadeTime = if typeof(action.fadeTime) == "number" then clampNumber(action.fadeTime, 0, 10, 0.08) else nil,
		looped = if typeof(action.looped) == "boolean" then action.looped else nil,
		autoDestroy = if typeof(action.autoDestroy) == "boolean" then action.autoDestroy else nil,
		priority = if typeof(action.priority) == "EnumItem" then action.priority else nil,
		rollOffMaxDistance = if typeof(action.rollOffMaxDistance) == "number"
			then clampNumber(action.rollOffMaxDistance, 4, 512, 64)
			else nil,
		emitterSize = if typeof(action.emitterSize) == "number" then clampNumber(action.emitterSize, 0, 64, 4) else nil,
		stopOtherTracks = if typeof(action.stopOtherTracks) == "boolean" then action.stopOtherTracks else nil,
		playOnClient = if typeof(action.playOnClient) == "boolean" then action.playOnClient else nil,
	}
end

local function sanitizeAnimationActions(actionsRaw: any): { AnimationEventAction }
	local out = {}
	if actionsRaw == nil then
		return out
	end

	if typeof(actionsRaw) ~= "table" then
		local singleAction = sanitizeAnimationAction({
			kind = "sound",
			source = actionsRaw,
		})
		if singleAction ~= nil then
			table.insert(out, singleAction)
		end
		return out
	end

	local source = actionsRaw :: { [any]: any }
	if source.kind ~= nil or source.source ~= nil or source.sound ~= nil or source.animation ~= nil then
		local singleAction = sanitizeAnimationAction(source)
		if singleAction ~= nil then
			table.insert(out, singleAction)
		end
		return out
	end

	for _, candidate in source do
		local action = sanitizeAnimationAction(candidate)
		if action ~= nil then
			table.insert(out, action)
		end
	end

	return out
end

local function sanitizeAnimationBinding(bindingRaw: any, fallback: AnimationEventBinding?): AnimationEventBinding
	local source = if typeof(bindingRaw) == "table" then bindingRaw else {}
	local markers: { [string]: { AnimationEventAction } } = {}
	local keyframes: { [string]: { AnimationEventAction } } = {}

	if fallback ~= nil then
		for eventName, fallbackActions in fallback.markers do
			markers[eventName] = cloneAnimationActions(fallbackActions)
		end
		for eventName, fallbackActions in fallback.keyframes do
			keyframes[eventName] = cloneAnimationActions(fallbackActions)
		end
	end

	if typeof((source :: any).markers) == "table" then
		for eventName, actionsRaw in (source :: any).markers do
			if typeof(eventName) == "string" and eventName ~= "" then
				markers[eventName] = sanitizeAnimationActions(actionsRaw)
			end
		end
	end

	if typeof((source :: any).keyframes) == "table" then
		for eventName, actionsRaw in (source :: any).keyframes do
			if typeof(eventName) == "string" and eventName ~= "" then
				keyframes[eventName] = sanitizeAnimationActions(actionsRaw)
			end
		end
	end

	return {
		markers = markers,
		keyframes = keyframes,
	}
end

function NpcServiceUtils.NormalizeAssetId(rawId: any): string?
	if typeof(rawId) == "number" then
		if rawId <= 0 then
			return nil
		end
		return RBX_ASSET_PREFIX .. tostring(math.floor(rawId))
	end

	if typeof(rawId) ~= "string" then
		return nil
	end

	local text = string.gsub(rawId, "%s", "")
	if text == "" then
		return nil
	end

	if string.sub(text, 1, #RBX_ASSET_PREFIX) == RBX_ASSET_PREFIX then
		local numericId = string.match(text, "(%d+)")
		if numericId == nil then
			return nil
		end
		return RBX_ASSET_PREFIX .. numericId
	end

	local numericOnly = string.match(text, "^%d+$")
	if numericOnly then
		return RBX_ASSET_PREFIX .. numericOnly
	end

	local trailingNumeric = string.match(text, "(%d+)$")
	if trailingNumeric then
		return RBX_ASSET_PREFIX .. trailingNumeric
	end

	return nil
end

function NpcServiceUtils.ResolveAnimationTemplate(raw: any): Animation?
	if typeof(raw) ~= "Instance" then
		return nil
	end
	if raw:IsA("Animation") then
		return raw
	end
	return nil
end

function NpcServiceUtils.ResolveAnimationSource(raw: any): (Animation?, string?)
	local template = NpcServiceUtils.ResolveAnimationTemplate(raw)
	if template then
		return template, nil
	end

	if typeof(raw) == "table" then
		local source = raw :: { [string]: any }
		local candidateTemplate = NpcServiceUtils.ResolveAnimationTemplate(source.animation)
		if candidateTemplate then
			return candidateTemplate, nil
		end

		local candidateId =
			NpcServiceUtils.NormalizeAssetId(source.id or source.animationId or source.assetId or source.source)
		if candidateId then
			return nil, candidateId
		end
	end

	local assetId = NpcServiceUtils.NormalizeAssetId(raw)
	if assetId then
		return nil, assetId
	end

	return nil, nil
end

function NpcServiceUtils.ResolveSoundSource(raw: any): string?
	if typeof(raw) == "Instance" and raw:IsA("Sound") then
		return NpcServiceUtils.NormalizeAssetId(raw.SoundId)
	end

	if typeof(raw) == "table" then
		local source = raw :: { [string]: any }
		if typeof(source.sound) == "Instance" and source.sound:IsA("Sound") then
			local candidateId = NpcServiceUtils.NormalizeAssetId((source.sound :: Sound).SoundId)
			if candidateId then
				return candidateId
			end
		end

		local candidateId = NpcServiceUtils.NormalizeAssetId(source.id or source.soundId or source.assetId or source.source)
		if candidateId then
			return candidateId
		end
	end

	local assetId = NpcServiceUtils.NormalizeAssetId(raw)
	if assetId then
		return assetId
	end

	return nil
end

function NpcServiceUtils.FindDescendantByNameOfClass(
	root: Instance?,
	expectedNameRaw: any,
	classNameRaw: any
): Instance?
	if root == nil then
		return nil
	end
	if typeof(expectedNameRaw) ~= "string" or expectedNameRaw == "" then
		return nil
	end
	if typeof(classNameRaw) ~= "string" or classNameRaw == "" then
		return nil
	end

	local expectedName = string.lower(expectedNameRaw)
	for _, descendant in root:GetDescendants() do
		if descendant.ClassName == classNameRaw and string.lower(descendant.Name) == expectedName then
			return descendant
		end
	end

	return nil
end

function NpcServiceUtils.CreateDefaultStateMachineGraph(): StateMachineGraph
	return cloneStateGraph(DEFAULT_STATE_MACHINE_GRAPH)
end

function NpcServiceUtils.SanitizeSlimeSpawnSettings(
	settingsRaw: any,
	fallback: SlimeSpawnSettings?
): SlimeSpawnSettings
	local base = if fallback ~= nil then fallback else DEFAULT_SLIME_SPAWN_SETTINGS
	local settings = if typeof(settingsRaw) == "table" then settingsRaw else {}

	return {
		enabled = if typeof((settings :: any).enabled) == "boolean" then (settings :: any).enabled else base.enabled,
		initialSpawnCount = clampInteger((settings :: any).initialSpawnCount, 0, 128, base.initialSpawnCount),
		maxAlive = clampInteger((settings :: any).maxAlive, 1, 256, base.maxAlive),
		spawnRate = clampNumber((settings :: any).spawnRate, 0.05, 600, base.spawnRate),
		spawnChance = clampNumber((settings :: any).spawnChance, 0, 1, base.spawnChance),
		despawnDistance = clampNumber((settings :: any).despawnDistance, 32, 4096, base.despawnDistance),
	}
end

function NpcServiceUtils.CanTransition(
	graph: StateMachineGraph,
	currentState: NpcRuntimeState,
	nextState: NpcRuntimeState
): boolean
	if currentState == nextState then
		return true
	end
	local transitions = graph[currentState]
	if transitions == nil then
		return false
	end
	return transitions[nextState] == true
end

function NpcServiceUtils.CreateDefaultSlimeAnimationEvents(): AnimationEventsByTrack
	local defaultEvents: AnimationEventsByTrack = {
		Jump = {
			markers = {
				jump = {
					{
						kind = "sound",
						soundName = "Jump",
					},
				},
			},
			keyframes = {
				jump = {
					{
						kind = "sound",
						soundName = "Jump",
					},
				},
			},
		},
		Land = {
			markers = {
				land = {
					{
						kind = "sound",
						soundName = "Land",
					},
				},
			},
			keyframes = {
				land = {
					{
						kind = "sound",
						soundName = "Land",
					},
				},
			},
		},
		Hurt = {
			markers = {
				hit = {
					{
						kind = "sound",
						soundName = "Hurt",
					},
				},
			},
			keyframes = {
				hit = {
					{
						kind = "sound",
						soundName = "Hurt",
					},
				},
			},
		},
	}

	return cloneAnimationEvents(defaultEvents)
end

function NpcServiceUtils.SanitizeAnimationEventsByTrack(
	eventsRaw: any,
	fallback: AnimationEventsByTrack?
): AnimationEventsByTrack
	local source = if typeof(eventsRaw) == "table" then eventsRaw else {}
	local out = if fallback ~= nil then cloneAnimationEvents(fallback) else ({} :: AnimationEventsByTrack)

	for trackName, bindingRaw in source do
		if typeof(trackName) ~= "string" or trackName == "" then
			continue
		end
		local fallbackBinding = out[trackName]
		out[trackName] = sanitizeAnimationBinding(bindingRaw, fallbackBinding)
	end

	return out
end

function NpcServiceUtils.ResolveBiomeNameFromWorld(worldRaw: any, worldPosition: Vector3): (BiomeName, boolean)
	if typeof(worldRaw) ~= "table" then
		return "Unknown", false
	end

	local world = worldRaw :: { [string]: any }
	local worldOrigin = if typeof(world.worldOrigin) == "Vector3" then world.worldOrigin else Vector3.zero
	local tileSize = if typeof(world.tileSize) == "number" and world.tileSize > 0 then world.tileSize else 2
	local biomeGenerator = world.biomeGenerator
	local biomeIdMap = world.biomeId

	if typeof(biomeGenerator) ~= "table" then
		return "Unknown", false
	end
	if typeof((biomeGenerator :: any).getColumnProfile) ~= "function" then
		return "Unknown", false
	end

	local tileX = math.floor((worldPosition.Z - worldOrigin.Z) / tileSize)
	local ok, columnOrError = pcall(function()
		return (biomeGenerator :: any):getColumnProfile(tileX)
	end)
	if not ok then
		return "Unknown", false
	end
	if typeof(columnOrError) ~= "table" then
		return "Unknown", false
	end

	local biomeId = (columnOrError :: any).biomeId
	if typeof(biomeId) ~= "number" then
		return "Unknown", false
	end
	if typeof(biomeIdMap) ~= "table" then
		return "Unknown", false
	end

	for biomeKey, biomeName in BIOME_ID_TO_NAME do
		if (biomeIdMap :: any)[biomeKey] == biomeId then
			return biomeName, true
		end
	end

	return "Unknown", false
end

function NpcServiceUtils.CollectSpawnCFrames(maxCountRaw: any): { CFrame }
	local maxCount = math.max(1, math.floor(clampNumber(maxCountRaw, 1, 128, 8)))
	local out = {}

	local candidateFolders = { "NpcSpawns", "NpcSpawnPoints", "SlimeSpawns" }
	for _, folderName in candidateFolders do
		local folder = Workspace:FindFirstChild(folderName)
		if folder == nil then
			continue
		end

		for _, child in folder:GetDescendants() do
			if #out >= maxCount then
				break
			end

			if child:IsA("BasePart") then
				table.insert(out, child.CFrame)
			elseif child:IsA("Attachment") then
				table.insert(out, child.WorldCFrame)
			end
		end

		if #out >= maxCount then
			break
		end
	end

	if #out == 0 then
		local spawnLocation = Workspace:FindFirstChild("SpawnLocation")
		if spawnLocation and spawnLocation:IsA("BasePart") then
			table.insert(out, spawnLocation.CFrame + Vector3.new(0, 4, 0))
		end
	end

	if #out == 0 then
		local basePosition = Vector3.new(0, 8, 0)
		for index = 1, maxCount do
			local zOffset = (index - 1) * 12
			table.insert(out, CFrame.new(basePosition + Vector3.new(0, 0, zOffset)))
		end
	end

	return out
end

function NpcServiceUtils.CreateDefaultSlimeSpawnConfigs(spawnCFrames: { CFrame }?): { SlimeSpawnConfig }
	local cframes = spawnCFrames
	if cframes == nil or #cframes == 0 then
		cframes = NpcServiceUtils.CollectSpawnCFrames(3)
	end

	local variants = {
		{
			slimeType = "GreenSlime",
			displayName = "Green Slime",
			modelName = "GreenSlime",
			modelHierarchy = "Enemies.GreenSlime",
			aggroOnPlayer = true,
			passiveUntilHit = true,
		},
	}

	local defaultAnimationEvents = NpcServiceUtils.CreateDefaultSlimeAnimationEvents()
	local out = {}
	local planeX = if #cframes > 0 then cframes[1].Position.X else 0
	for index, spawnCFrame in cframes do
		local variant = variants[((index - 1) % #variants) + 1]
		local spawnPosition = spawnCFrame.Position
		local projectedCFrame = CFrame.new(Vector3.new(planeX, spawnPosition.Y, spawnPosition.Z))
		table.insert(out, {
			slimeType = variant.slimeType,
			displayName = variant.displayName,
			modelName = variant.modelName,
			modelHierarchy = variant.modelHierarchy,
			planeX = planeX,
			aggroOnPlayer = variant.aggroOnPlayer,
			passiveUntilHit = variant.passiveUntilHit,
			spawnCFrame = projectedCFrame,
			animationEvents = cloneAnimationEvents(defaultAnimationEvents),
		})
	end

	return out
end

function NpcServiceUtils.ApplyRuntimeModelAttributes(
	modelRaw: any,
	runtimeIdRaw: any,
	npcTypeRaw: any,
	displayNameRaw: any
): boolean
	if typeof(modelRaw) ~= "Instance" or not modelRaw:IsA("Model") then
		return false
	end

	local runtimeId = trim(runtimeIdRaw)
	if runtimeId == "" then
		return false
	end

	modelRaw:SetAttribute(NpcServiceUtils.RUNTIME_ID_ATTRIBUTE, runtimeId)

	local npcType = trim(npcTypeRaw)
	if npcType ~= "" then
		modelRaw:SetAttribute(NpcServiceUtils.RUNTIME_NPC_TYPE_ATTRIBUTE, npcType)
	end
	TagBinder.applyTag(modelRaw, TagBinder.Tags.Npc)
	local npcTypeToken = string.lower(npcType)
	if string.find(npcTypeToken, "slime", 1, true) ~= nil then
		TagBinder.applyTag(modelRaw, TagBinder.Tags.Npc_Slime)
		TagBinder.applyTag(modelRaw, TagBinder.Tags.Gore_Slime)
	end
	if string.find(npcTypeToken, "flying", 1, true) ~= nil then
		TagBinder.applyTag(modelRaw, TagBinder.Tags.Npc_Flying)
	end
	if string.find(npcTypeToken, "ground", 1, true) ~= nil then
		TagBinder.applyTag(modelRaw, TagBinder.Tags.Npc_Ground)
	end

	local displayName = trim(displayNameRaw)
	if displayName ~= "" then
		modelRaw:SetAttribute(NpcServiceUtils.RUNTIME_DISPLAY_NAME_ATTRIBUTE, displayName)
	end

	return true
end

function NpcServiceUtils.ResolveRuntimeModelFromInstance(instanceRaw: any): Model?
	if typeof(instanceRaw) ~= "Instance" then
		return nil
	end

	local cursor: Instance? = instanceRaw
	while cursor ~= nil do
		if cursor:IsA("Model") then
			local runtimeId = cursor:GetAttribute(NpcServiceUtils.RUNTIME_ID_ATTRIBUTE)
			if typeof(runtimeId) == "string" and runtimeId ~= "" then
				return cursor
			end
		end
		cursor = cursor.Parent
	end

	return nil
end

function NpcServiceUtils.ResolveRuntimeIdFromInstance(instanceRaw: any): string?
	local runtimeModel = NpcServiceUtils.ResolveRuntimeModelFromInstance(instanceRaw)
	if runtimeModel == nil then
		return nil
	end

	local runtimeId = runtimeModel:GetAttribute(NpcServiceUtils.RUNTIME_ID_ATTRIBUTE)
	if typeof(runtimeId) == "string" and runtimeId ~= "" then
		return runtimeId
	end

	return nil
end

function NpcServiceUtils.SanitizeSnapshot(snapshotRaw: any, fallback: NpcSnapshot?): NpcSnapshot?
	if typeof(snapshotRaw) ~= "table" then
		return fallback
	end

	local source = snapshotRaw :: { [string]: any }
	local id = trim(source.id)
	if id == "" then
		return fallback
	end

	local fallbackSnapshot = fallback
	local state = source.state
	if state ~= "Dormant"
		and state ~= "Spawning"
		and state ~= "AwaitingBiome"
		and state ~= "Idle"
		and state ~= "Searching"
		and state ~= "Aggro"
		and state ~= "Attacking"
		and state ~= "Dead" then
		state = if fallbackSnapshot then fallbackSnapshot.state else "Dormant"
	end

	local biomeName = source.biomeName
	if biomeName ~= "Forest" and biomeName ~= "Desert" and biomeName ~= "Snow" and biomeName ~= "Jungle" then
		biomeName = "Unknown"
	end

	local fallbackMaxHp = if fallbackSnapshot ~= nil then fallbackSnapshot.maxHp else 1
	local rawMaxHp = if typeof(source.maxHp) == "number" and source.maxHp == source.maxHp then source.maxHp else fallbackMaxHp
	local maxHp = math.max(1, rawMaxHp)

	local fallbackHp = if fallbackSnapshot ~= nil then fallbackSnapshot.hp else maxHp
	local rawHp = if typeof(source.hp) == "number" and source.hp == source.hp then source.hp else fallbackHp
	local hp = math.clamp(rawHp, 0, maxHp)

	local isAlive = if typeof(source.isAlive) == "boolean"
		then source.isAlive
		else if fallbackSnapshot ~= nil then fallbackSnapshot.isAlive else state ~= "Dead"
	if state == "Dead" then
		isAlive = false
		hp = 0
	end

	local npcType = if source.npcType == "Slime"
		then "Slime"
		else if fallbackSnapshot then fallbackSnapshot.npcType else "Slime"

	return {
		id = id,
		npcType = npcType,
		displayName = if typeof(source.displayName) == "string" and source.displayName ~= ""
			then source.displayName
			else if fallbackSnapshot then fallbackSnapshot.displayName else id,
		state = state :: NpcRuntimeState,
		biomeName = biomeName :: BiomeName,
		biomeReady = if typeof(source.biomeReady) == "boolean"
			then source.biomeReady
			else if fallbackSnapshot then fallbackSnapshot.biomeReady else false,
		hp = hp,
		maxHp = maxHp,
		isAlive = isAlive,
		position = if typeof(source.position) == "Vector3"
			then source.position
			else if fallbackSnapshot then fallbackSnapshot.position else nil,
		updatedAt = if typeof(source.updatedAt) == "number" and source.updatedAt == source.updatedAt
			then source.updatedAt
			else os.clock(),
		lastReason = if typeof(source.lastReason) == "string"
			then source.lastReason
			else if fallbackSnapshot then fallbackSnapshot.lastReason else "unknown",
	}
end

NpcServiceUtils.normalizeAssetId = NpcServiceUtils.NormalizeAssetId
NpcServiceUtils.resolveAnimationTemplate = NpcServiceUtils.ResolveAnimationTemplate
NpcServiceUtils.resolveAnimationSource = NpcServiceUtils.ResolveAnimationSource
NpcServiceUtils.resolveSoundSource = NpcServiceUtils.ResolveSoundSource
NpcServiceUtils.findDescendantByNameOfClass = NpcServiceUtils.FindDescendantByNameOfClass
NpcServiceUtils.createDefaultStateMachineGraph = NpcServiceUtils.CreateDefaultStateMachineGraph
NpcServiceUtils.sanitizeSlimeSpawnSettings = NpcServiceUtils.SanitizeSlimeSpawnSettings
NpcServiceUtils.canTransition = NpcServiceUtils.CanTransition
NpcServiceUtils.createDefaultSlimeAnimationEvents = NpcServiceUtils.CreateDefaultSlimeAnimationEvents
NpcServiceUtils.sanitizeAnimationEventsByTrack = NpcServiceUtils.SanitizeAnimationEventsByTrack
NpcServiceUtils.resolveBiomeNameFromWorld = NpcServiceUtils.ResolveBiomeNameFromWorld
NpcServiceUtils.collectSpawnCFrames = NpcServiceUtils.CollectSpawnCFrames
NpcServiceUtils.createDefaultSlimeSpawnConfigs = NpcServiceUtils.CreateDefaultSlimeSpawnConfigs
NpcServiceUtils.applyRuntimeModelAttributes = NpcServiceUtils.ApplyRuntimeModelAttributes
NpcServiceUtils.resolveRuntimeModelFromInstance = NpcServiceUtils.ResolveRuntimeModelFromInstance
NpcServiceUtils.resolveRuntimeIdFromInstance = NpcServiceUtils.ResolveRuntimeIdFromInstance
NpcServiceUtils.sanitizeSnapshot = NpcServiceUtils.SanitizeSnapshot

return NpcServiceUtils
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="1312">
              <Properties>
                <string name="Name">ParallaxServiceUtils</string>
                <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Sift = require(ReplicatedStorage.Packages.Sift)

local Lerp = require(script:FindFirstAncestor("game").Shared.Modules.Math.Lerp)
local WorldSimulationShared = require(script:FindFirstAncestor("game").Shared.Services.Shared)

local ParallaxServiceUtils = {}

export type TransitionState = "Idle" | "Blending" | "Interrupting"
export type VerticalAlign = "Top" | "Center" | "Bottom"

export type LayerDefinition = {
	id: string,
	image: string,
	imageAspectRatio: number,
	depth: number,
	planeDepthBlocks: number,
	heightScale: number,
	segmentWidthScale: number,
	minSegments: number,
	overscanSegments: number,
	tint: Color3,
	transparency: number,
	scrollSpeed: number,
	textureStudsPerTileU: number,
	textureStudsPerTileV: number,
	verticalAlign: VerticalAlign,
	verticalOffsetStuds: number,
	verticalDepth: number,
}

export type BiomeVariantDefinition = {
	name: string,
	layers: { LayerDefinition },
}

export type BiomeDefinition = {
	name: string,
	aliases: { string },
	defaultVariantName: string,
	orderedVariantNames: { string },
	variants: { [string]: BiomeVariantDefinition },
}

export type CatalogSettings = {
	defaultBiome: string,
	transitionSeconds: number,
	biomeSampleIntervalSeconds: number,
	folderName: string,
	segmentThickness: number,
}

export type Catalog = {
	settings: CatalogSettings,
	biomes: { [string]: BiomeDefinition },
	orderedBiomeNames: { string },
	aliases: { [string]: string },
}

export type ServiceState = {
	initialized: boolean,
	currentBiome: string,
	targetBiome: string,
	transitionState: TransitionState,
}

export type PlaneSizing = {
	planeWidth: number,
	textureRepeatWidth: number,
	textureRepeatHeight: number,
}

ParallaxServiceUtils.DEPTH_LAYER_SKY = 0
ParallaxServiceUtils.DEPTH_LAYER_UNDERGROUND = 2

local BIOME_RESERVED_KEYS = {
	settings = true,
	aliases = true,
	layers = true,
	variants = true,
	defaultVariant = true,
	selectedVariant = true,
}

local BUILT_IN_BIOME_ALIASES = {
	overworld = { "Forest", "Default", "Overworld", "Surface" },
	forest = { "Forest", "Default", "Overworld", "Surface" },
	desert = { "Desert", "Sand", "Dunes" },
	snow = { "Snow", "Tundra", "Ice" },
	jungle = { "Jungle", "Rainforest" },
	corruption = { "Corruption", "Corrupt", "Evil" },
	underground = { "Underground", "Cavern", "Caves" },
}

local IMPLICIT_BIOME_TINTS = {
	overworld = Color3.fromRGB(175, 214, 188),
	forest = Color3.fromRGB(175, 214, 188),
	desert = Color3.fromRGB(229, 205, 160),
	snow = Color3.fromRGB(208, 227, 255),
	jungle = Color3.fromRGB(141, 190, 132),
	corruption = Color3.fromRGB(166, 140, 208),
	underground = Color3.fromRGB(132, 144, 170),
}

local IMPLICIT_LAYER_FALLBACK_IMAGE_ASPECT_RATIO = 3.3
local IMPLICIT_LAYER_BASE_TEXTURE_TILE_STUDS = 96
local IMPLICIT_LAYER_DEPTH_BASE = 0.32
local IMPLICIT_LAYER_DEPTH_STEP = 0.08
local IMPLICIT_LAYER_PLANE_DEPTH_BASE = 10
local IMPLICIT_LAYER_PLANE_DEPTH_STEP = 7
local IMPLICIT_LAYER_SEGMENT_WIDTH_SCALE_BASE = 0.54
local IMPLICIT_LAYER_SEGMENT_WIDTH_SCALE_STEP = 0.09
local IMPLICIT_LAYER_TRANSPARENCY_BASE = 0
local IMPLICIT_LAYER_TRANSPARENCY_STEP = 0
local IMPLICIT_LAYER_VERTICAL_OFFSET_BASE = -18
local IMPLICIT_LAYER_VERTICAL_OFFSET_STEP = 10
local IMPLICIT_LAYER_VERTICAL_DEPTH_BASE = 0.008
local IMPLICIT_LAYER_VERTICAL_DEPTH_STEP = 0.004
local DEFAULT_HORIZONTAL_VISION_STUDS = 576
local MINIMUM_TEXTURE_REPEAT_WIDTH_STUDS = 12
local MINIMUM_HORIZONTAL_PLANE_BLEED_STUDS = 8
local HORIZONTAL_PLANE_BLEED_FACTOR = 0.08
local IMPLICIT_PARALLAX_SOURCE_DIMENSIONS = {
	overworld = {
		[1] = { width = 1024, height = 533 },
		[2] = { width = 1024, height = 600 },
		[3] = { width = 1024, height = 660 },
		[4] = { width = 1024, height = 699 },
	},
	corruption = {
		[1] = { width = 1024, height = 533 },
		[2] = { width = 1024, height = 533 },
		[3] = { width = 1024, height = 533 },
		[4] = { width = 1024, height = 371 },
	},
	jungle = {
		[1] = { width = 1024, height = 768 },
		[2] = { width = 1024, height = 533 },
		[3] = { width = 1024, height = 540 },
		[4] = { width = 1024, height = 533 },
	},
	desert = {
		[1] = { width = 1024, height = 400 },
		[2] = { width = 1024, height = 500 },
		[3] = { width = 1024, height = 434 },
		[4] = { width = 1024, height = 434 },
	},
	snow = {
		[1] = { width = 1024, height = 529 },
		[2] = { width = 1024, height = 529 },
		[3] = { width = 1024, height = 600 },
		[4] = { width = 1024, height = 600 },
	},
}

local function trim(valueRaw: any): string
	if typeof(valueRaw) ~= "string" then
		return ""
	end
	return string.match(valueRaw, "^%s*(.-)%s*$") or ""
end

local function normalizeToken(valueRaw: any): string
	local value = string.lower(trim(valueRaw))
	value = string.gsub(value, "%s+", "")
	value = string.gsub(value, "_", "")
	value = string.gsub(value, "%-", "")
	return value
end

local function sanitizeNumber(valueRaw: any, fallback: number, minimum: number?, maximum: number?): number
	local value = fallback
	if typeof(valueRaw) == "number" and valueRaw == valueRaw and valueRaw ~= math.huge and valueRaw ~= -math.huge then
		value = valueRaw
	end
	if minimum ~= nil and value < minimum then
		value = minimum
	end
	if maximum ~= nil and value > maximum then
		value = maximum
	end
	return value
end

local function sanitizeInteger(valueRaw: any, fallback: number, minimum: number?, maximum: number?): number
	return math.floor(sanitizeNumber(valueRaw, fallback, minimum, maximum))
end

local function sanitizeColor3(valueRaw: any, fallback: Color3): Color3
	if typeof(valueRaw) == "Color3" then
		return valueRaw
	end
	return fallback
end

local function resolveImageAspectRatio(source: { [string]: any }, fallback: number): number
	local directAspectRatio = sanitizeNumber(source.imageAspectRatio, fallback, 0.05, 64)
	if typeof(source.imageAspectRatio) == "number" then
		return directAspectRatio
	end

	local imageWidth = sanitizeNumber(source.imageWidth, -1, 1, 65536)
	local imageHeight = sanitizeNumber(source.imageHeight, -1, 1, 65536)
	if imageWidth > 0 and imageHeight > 0 then
		return sanitizeNumber(imageWidth / imageHeight, fallback, 0.05, 64)
	end

	local tileWidth = sanitizeNumber(source.textureStudsPerTileU, -1, 1, 4096)
	local tileHeight = sanitizeNumber(source.textureStudsPerTileV, -1, 1, 4096)
	if tileWidth > 0 and tileHeight > 0 then
		return sanitizeNumber(tileWidth / tileHeight, fallback, 0.05, 64)
	end

	return directAspectRatio
end

local function lerpColor3(from: Color3, to: Color3, alpha: number): Color3
	return Lerp.color3(from, to, alpha)
end

local function resolveImplicitBiomeTint(biomeName: string, farAlpha: number): Color3
	local baseTint = IMPLICIT_BIOME_TINTS[normalizeToken(biomeName)] or Color3.fromRGB(190, 205, 220)
	return lerpColor3(Color3.new(1, 1, 1), baseTint, 0.14 + farAlpha * 0.16)
end

local function resolveImplicitSourceImageAspectRatio(biomeName: string, layerIndex: number): number?
	local normalizedBiomeName = normalizeToken(biomeName)
	if normalizedBiomeName == "forest" then
		normalizedBiomeName = "overworld"
	end

	local biomeDimensions = IMPLICIT_PARALLAX_SOURCE_DIMENSIONS[normalizedBiomeName]
	if biomeDimensions == nil then
		return nil
	end

	local imageDimensions = biomeDimensions[layerIndex]
	if imageDimensions == nil or imageDimensions.width <= 0 or imageDimensions.height <= 0 then
		return nil
	end

	return imageDimensions.width / imageDimensions.height
end

local function resolveImplicitLayerDefaults(
	biomeName: string,
	layerIndex: number,
	totalLayers: number
): { [string]: any }
	local total = math.max(totalLayers, 1)
	local stackIndex = math.max(layerIndex - 1, 0)
	local farAlpha = if total <= 1 then 0 else (layerIndex - 1) / (total - 1)
	local imageAspectRatio = resolveImplicitSourceImageAspectRatio(biomeName, layerIndex)
		or IMPLICIT_LAYER_FALLBACK_IMAGE_ASPECT_RATIO

	return {
		imageAspectRatio = imageAspectRatio,
		depth = math.clamp(IMPLICIT_LAYER_DEPTH_BASE - stackIndex * IMPLICIT_LAYER_DEPTH_STEP, 0.05, 0.98),
		planeDepthBlocks = IMPLICIT_LAYER_PLANE_DEPTH_BASE + stackIndex * IMPLICIT_LAYER_PLANE_DEPTH_STEP,
		heightScale = 1,
		segmentWidthScale = IMPLICIT_LAYER_SEGMENT_WIDTH_SCALE_BASE
			+ stackIndex * IMPLICIT_LAYER_SEGMENT_WIDTH_SCALE_STEP,
		minSegments = 2,
		overscanSegments = 4,
		tint = resolveImplicitBiomeTint(biomeName, farAlpha),
		transparency = IMPLICIT_LAYER_TRANSPARENCY_BASE + stackIndex * IMPLICIT_LAYER_TRANSPARENCY_STEP,
		scrollSpeed = 0,
		textureStudsPerTileU = IMPLICIT_LAYER_BASE_TEXTURE_TILE_STUDS,
		textureStudsPerTileV = IMPLICIT_LAYER_BASE_TEXTURE_TILE_STUDS,
		verticalAlign = "Center",
		verticalOffsetStuds = IMPLICIT_LAYER_VERTICAL_OFFSET_BASE + stackIndex * IMPLICIT_LAYER_VERTICAL_OFFSET_STEP,
		verticalDepth = IMPLICIT_LAYER_VERTICAL_DEPTH_BASE + stackIndex * IMPLICIT_LAYER_VERTICAL_DEPTH_STEP,
	}
end

local function sanitizeVerticalAlign(valueRaw: any, fallback: VerticalAlign): VerticalAlign
	local token = normalizeToken(valueRaw)
	if token == "top" then
		return "Top"
	end
	if token == "center" or token == "middle" then
		return "Center"
	end
	if token == "bottom" then
		return "Bottom"
	end
	return fallback
end

local function collectSortedNumericIndices(sourceRaw: any): { number }
	local source = if typeof(sourceRaw) == "table" then sourceRaw :: { [any]: any } else {}
	local indices: { number } = {}
	for key in source do
		if typeof(key) == "number" and key % 1 == 0 then
			table.insert(indices, key)
		end
	end
	table.sort(indices)
	return indices
end

local function collectSortedStringKeys(sourceRaw: any): { string }
	local source = if typeof(sourceRaw) == "table" then sourceRaw :: { [any]: any } else {}
	local keys: { string } = {}
	for key in source do
		if typeof(key) == "string" then
			table.insert(keys, key)
		end
	end
	table.sort(keys)
	return keys
end

local function createImplicitLayerSource(
	biomeName: string,
	variantName: string,
	layerIndex: number,
	totalLayers: number,
	image: string
): { [string]: any }
	local defaults = resolveImplicitLayerDefaults(biomeName, layerIndex, totalLayers)
	return {
		id = `{biomeName}_{variantName}_Layer_{layerIndex}`,
		image = image,
		imageAspectRatio = defaults.imageAspectRatio,
		depth = defaults.depth,
		planeDepthBlocks = defaults.planeDepthBlocks,
		heightScale = defaults.heightScale,
		segmentWidthScale = defaults.segmentWidthScale,
		minSegments = defaults.minSegments,
		overscanSegments = defaults.overscanSegments,
		tint = defaults.tint,
		transparency = defaults.transparency,
		scrollSpeed = defaults.scrollSpeed,
		textureStudsPerTileU = defaults.textureStudsPerTileU,
		textureStudsPerTileV = defaults.textureStudsPerTileV,
		verticalAlign = defaults.verticalAlign,
		verticalOffsetStuds = defaults.verticalOffsetStuds,
		verticalDepth = defaults.verticalDepth,
	}
end

local function sanitizeLayerDefinition(
	layerRaw: any,
	fallbackId: string,
	layerIndex: number,
	totalLayers: number,
	biomeName: string,
	variantName: string
): LayerDefinition?
	local source: { [string]: any }
	if typeof(layerRaw) == "string" then
		local image = trim(layerRaw)
		if image == "" then
			return nil
		end
		source = createImplicitLayerSource(biomeName, variantName, layerIndex, totalLayers, image)
	elseif typeof(layerRaw) == "table" then
		source = layerRaw :: { [string]: any }
		if trim(source.image) == "" and trim(source.asset) ~= "" then
			source = Sift.Dictionary.copy(source)
			source.image = source.asset
		end
	else
		return nil
	end

	local image = trim(source.image)
	if image == "" then
		return nil
	end

	local defaults = resolveImplicitLayerDefaults(biomeName, layerIndex, totalLayers)
	return {
		id = trim(source.id) ~= "" and trim(source.id) or fallbackId,
		image = image,
		imageAspectRatio = resolveImageAspectRatio(source, defaults.imageAspectRatio),
		depth = sanitizeNumber(source.depth, defaults.depth, 0, 0.98),
		planeDepthBlocks = sanitizeNumber(source.planeDepthBlocks, defaults.planeDepthBlocks, 1, 256),
		heightScale = sanitizeNumber(source.heightScale, defaults.heightScale, 0.05, 4),
		segmentWidthScale = sanitizeNumber(source.segmentWidthScale, defaults.segmentWidthScale, 0.25, 8),
		minSegments = sanitizeInteger(source.minSegments, defaults.minSegments, 1, 32),
		overscanSegments = sanitizeInteger(source.overscanSegments, defaults.overscanSegments, 0, 16),
		tint = sanitizeColor3(source.tint, defaults.tint),
		transparency = 0,
		scrollSpeed = sanitizeNumber(source.scrollSpeed, defaults.scrollSpeed, -256, 256),
		textureStudsPerTileU = sanitizeNumber(source.textureStudsPerTileU, defaults.textureStudsPerTileU, 1, 4096),
		textureStudsPerTileV = sanitizeNumber(source.textureStudsPerTileV, defaults.textureStudsPerTileV, 1, 4096),
		verticalAlign = sanitizeVerticalAlign(source.verticalAlign, defaults.verticalAlign),
		verticalOffsetStuds = sanitizeNumber(source.verticalOffsetStuds, defaults.verticalOffsetStuds, -4096, 4096),
		verticalDepth = sanitizeNumber(source.verticalDepth, defaults.verticalDepth, 0, 1),
	}
end

local function sanitizeVariantDefinition(
	biomeName: string,
	variantNameRaw: any,
	variantRaw: any
): BiomeVariantDefinition?
	local variantName = trim(variantNameRaw)
	if variantName == "" or typeof(variantRaw) ~= "table" then
		return nil
	end

	local source = variantRaw :: { [string]: any }
	local layersRaw = if typeof(source.layers) == "table" then source.layers else variantRaw
	local indices = collectSortedNumericIndices(layersRaw)
	local totalLayers = #indices
	if totalLayers <= 0 then
		return nil
	end

	local layers: { LayerDefinition } = {}
	for ordinal, numericIndex in indices do
		local layer = sanitizeLayerDefinition(
			(layersRaw :: { [any]: any })[numericIndex],
			`{biomeName}_{variantName}_Layer_{numericIndex}`,
			ordinal,
			totalLayers,
			biomeName,
			variantName
		)
		if layer ~= nil then
			table.insert(layers, layer)
		end
	end

	if #layers <= 0 then
		return nil
	end

	return {
		name = variantName,
		layers = layers,
	}
end

local function appendBuiltInAliases(aliases: { string }, biomeName: string)
	local builtIns = BUILT_IN_BIOME_ALIASES[normalizeToken(biomeName)]
	if builtIns == nil then
		return
	end

	local seen: { [string]: boolean } = {}
	for _, alias in aliases do
		seen[normalizeToken(alias)] = true
	end
	for _, alias in builtIns do
		local token = normalizeToken(alias)
		if not seen[token] then
			seen[token] = true
			table.insert(aliases, alias)
		end
	end
end

local function sanitizeBiomeDefinition(nameRaw: any, biomeRaw: any): BiomeDefinition?
	local name = trim(nameRaw)
	if name == "" or typeof(biomeRaw) ~= "table" then
		return nil
	end

	local source = biomeRaw :: { [string]: any }
	local aliasesRaw = if typeof(source.aliases) == "table" then source.aliases :: { any } else {}
	local aliases: { string } = {}
	for _, alias in aliasesRaw do
		local text = trim(alias)
		if text ~= "" then
			table.insert(aliases, text)
		end
	end
	appendBuiltInAliases(aliases, name)

	local variants: { [string]: BiomeVariantDefinition } = {}
	local orderedVariantNames: { string } = {}

	if typeof(source.layers) == "table" then
		local implicitVariantName = trim(source.defaultVariant)
		if implicitVariantName == "" then
			implicitVariantName = "default"
		end
		local variant = sanitizeVariantDefinition(name, implicitVariantName, {
			layers = source.layers,
		})
		if variant ~= nil then
			variants[variant.name] = variant
			table.insert(orderedVariantNames, variant.name)
		end
	elseif typeof(source.variants) == "table" then
		for _, variantName in collectSortedStringKeys(source.variants) do
			local variant =
				sanitizeVariantDefinition(name, variantName, (source.variants :: { [string]: any })[variantName])
			if variant ~= nil then
				variants[variant.name] = variant
				table.insert(orderedVariantNames, variant.name)
			end
		end
	else
		for _, variantName in collectSortedStringKeys(source) do
			if BIOME_RESERVED_KEYS[variantName] then
				continue
			end
			local variant = sanitizeVariantDefinition(name, variantName, source[variantName])
			if variant ~= nil then
				variants[variant.name] = variant
				table.insert(orderedVariantNames, variant.name)
			end
		end
	end

	if #orderedVariantNames <= 0 then
		return nil
	end

	local defaultVariantName = trim(source.defaultVariant)
	if defaultVariantName == "" or variants[defaultVariantName] == nil then
		defaultVariantName = orderedVariantNames[1]
	end

	return {
		name = name,
		aliases = aliases,
		defaultVariantName = defaultVariantName,
		orderedVariantNames = orderedVariantNames,
		variants = variants,
	}
end

function ParallaxServiceUtils.NormalizeCatalog(rawCatalog: any): Catalog
	local source = if typeof(rawCatalog) == "table" then rawCatalog :: { [string]: any } else {}
	local settingsRaw = if typeof(source.settings) == "table" then source.settings :: { [string]: any } else {}
	local rawBiomes = if typeof(source.biomes) == "table" then source.biomes :: { [string]: any } else source

	local biomes: { [string]: BiomeDefinition } = {}
	local orderedBiomeNames: { string } = {}
	local aliases: { [string]: string } = {}

	for _, biomeName in collectSortedStringKeys(rawBiomes) do
		if BIOME_RESERVED_KEYS[biomeName] or biomeName == "settings" then
			continue
		end

		local biome = sanitizeBiomeDefinition(biomeName, rawBiomes[biomeName])
		if biome == nil then
			continue
		end

		biomes[biome.name] = biome
		table.insert(orderedBiomeNames, biome.name)
		aliases[normalizeToken(biome.name)] = biome.name
		for _, alias in biome.aliases do
			aliases[normalizeToken(alias)] = biome.name
		end
	end

	if next(biomes) == nil then
		local fallbackBiome = sanitizeBiomeDefinition("overworld", {
			defaultVariant = "default",
			default = {
				[1] = "rbxassetid://79294783523700",
			},
		})
		if fallbackBiome ~= nil then
			biomes[fallbackBiome.name] = fallbackBiome
			orderedBiomeNames = { fallbackBiome.name }
			aliases[normalizeToken(fallbackBiome.name)] = fallbackBiome.name
			for _, alias in fallbackBiome.aliases do
				aliases[normalizeToken(alias)] = fallbackBiome.name
			end
		end
	end

	local defaultBiome = trim(settingsRaw.defaultBiome)
	if defaultBiome == "" then
		if biomes.overworld ~= nil then
			defaultBiome = "overworld"
		else
			defaultBiome = orderedBiomeNames[1]
		end
	end

	local settings: CatalogSettings = {
		defaultBiome = if biomes[defaultBiome] ~= nil then defaultBiome else orderedBiomeNames[1],
		transitionSeconds = sanitizeNumber(settingsRaw.transitionSeconds, 1.35, 0, 10),
		biomeSampleIntervalSeconds = sanitizeNumber(settingsRaw.biomeSampleIntervalSeconds, 0.2, 0.02, 5),
		folderName = trim(settingsRaw.folderName) ~= "" and trim(settingsRaw.folderName) or "ParallaxDepth",
		segmentThickness = sanitizeNumber(settingsRaw.segmentThickness, 0.2, 0.01, 16),
	}

	return {
		settings = settings,
		biomes = biomes,
		orderedBiomeNames = orderedBiomeNames,
		aliases = aliases,
	}
end

function ParallaxServiceUtils.ResolveBiomeName(catalog: Catalog, biomeNameRaw: any): string
	local requestedName = trim(biomeNameRaw)
	if requestedName ~= "" and catalog.biomes[requestedName] ~= nil then
		return requestedName
	end

	local aliasTarget = catalog.aliases[normalizeToken(biomeNameRaw)]
	if aliasTarget ~= nil and catalog.biomes[aliasTarget] ~= nil then
		return aliasTarget
	end

	return catalog.settings.defaultBiome
end

function ParallaxServiceUtils.ResolveBiomeDefinition(catalog: Catalog, biomeNameRaw: any): BiomeDefinition
	return catalog.biomes[ParallaxServiceUtils.ResolveBiomeName(catalog, biomeNameRaw)]
end

function ParallaxServiceUtils.ResolveVariantName(biomeDefinition: BiomeDefinition, variantNameRaw: any): string
	local requestedName = trim(variantNameRaw)
	if requestedName ~= "" and biomeDefinition.variants[requestedName] ~= nil then
		return requestedName
	end
	return biomeDefinition.defaultVariantName
end

function ParallaxServiceUtils.ResolveVariantDefinition(
	catalog: Catalog,
	biomeNameRaw: any,
	variantNameRaw: any
): BiomeVariantDefinition
	local biomeDefinition = ParallaxServiceUtils.ResolveBiomeDefinition(catalog, biomeNameRaw)
	local variantName = ParallaxServiceUtils.ResolveVariantName(biomeDefinition, variantNameRaw)
	return biomeDefinition.variants[variantName]
end

function ParallaxServiceUtils.CollectAssetIds(catalog: Catalog, biomeNamesRaw: { any }?): { string }
	local assetIds: { string } = {}
	local seen: { [string]: boolean } = {}
	local biomeNames = if biomeNamesRaw ~= nil then biomeNamesRaw else catalog.orderedBiomeNames

	for _, biomeNameRaw in biomeNames do
		local biome = ParallaxServiceUtils.ResolveBiomeDefinition(catalog, biomeNameRaw)
		for _, variantName in biome.orderedVariantNames do
			local variant = biome.variants[variantName]
			for _, layer in variant.layers do
				if layer.image ~= "" and not seen[layer.image] then
					seen[layer.image] = true
					table.insert(assetIds, layer.image)
				end
			end
		end
	end

	return assetIds
end

function ParallaxServiceUtils.CreateDefaultState(catalog: Catalog): ServiceState
	return {
		initialized = false,
		currentBiome = catalog.settings.defaultBiome,
		targetBiome = catalog.settings.defaultBiome,
		transitionState = "Idle",
	}
end

function ParallaxServiceUtils.CloneState(state: ServiceState): ServiceState
	return {
		initialized = state.initialized,
		currentBiome = state.currentBiome,
		targetBiome = state.targetBiome,
		transitionState = state.transitionState,
	}
end

function ParallaxServiceUtils.ComputeHorizontalVisionStuds(
	chunkSizeRaw: any,
	tileSizeRaw: any,
	renderDistanceChunksRaw: any
): number
	local chunkSize = sanitizeInteger(chunkSizeRaw, 32, 1, 512)
	local tileSize = sanitizeNumber(tileSizeRaw, 2, 0.25, 128)
	local renderDistanceChunks = sanitizeInteger(renderDistanceChunksRaw, 4, 1, 128)
	return math.max(DEFAULT_HORIZONTAL_VISION_STUDS, (renderDistanceChunks * 2 + 1) * chunkSize * tileSize)
end

function ParallaxServiceUtils.ResolveDeterministicPlaneSizing(
	visibleWidthRaw: any,
	sizeReferenceWidthRaw: any,
	horizontalVisionStudsRaw: any,
	imageAspectRatioRaw: any,
	heightScaleRaw: any,
	segmentWidthScaleRaw: any,
	textureStudsPerTileURaw: any,
	requiredPlaneHeightRaw: any?
): PlaneSizing
	local visibleWidth = sanitizeNumber(visibleWidthRaw, 0, 0, 1000000)
	local sizeReferenceWidth = sanitizeNumber(sizeReferenceWidthRaw, visibleWidth, 0, 1000000)
	local horizontalVisionStuds = sanitizeNumber(horizontalVisionStudsRaw, DEFAULT_HORIZONTAL_VISION_STUDS, 0, 1000000)
	local imageAspectRatio = sanitizeNumber(imageAspectRatioRaw, IMPLICIT_LAYER_FALLBACK_IMAGE_ASPECT_RATIO, 0.05, 64)
	local heightScale = sanitizeNumber(heightScaleRaw, 1, 0.05, 4)
	local segmentWidthScale = sanitizeNumber(segmentWidthScaleRaw, IMPLICIT_LAYER_SEGMENT_WIDTH_SCALE_BASE, 0.25, 8)
	local textureStudsPerTileU =
		sanitizeNumber(textureStudsPerTileURaw, IMPLICIT_LAYER_BASE_TEXTURE_TILE_STUDS, 1, 4096)

	local minimumTextureRepeatWidth = math.max(textureStudsPerTileU * 0.25, MINIMUM_TEXTURE_REPEAT_WIDTH_STUDS)
	local baseTextureRepeatWidth = math.max(sizeReferenceWidth * segmentWidthScale, minimumTextureRepeatWidth)
	local baseTextureRepeatHeight = math.max(1, (baseTextureRepeatWidth / imageAspectRatio) * heightScale)
	local textureRepeatHeight = math.max(baseTextureRepeatHeight, sanitizeNumber(requiredPlaneHeightRaw, 0, 0, 1000000))
	local textureRepeatWidth = math.max(baseTextureRepeatWidth, (textureRepeatHeight / heightScale) * imageAspectRatio)
	local horizontalBleed = math.max(visibleWidth * HORIZONTAL_PLANE_BLEED_FACTOR, MINIMUM_HORIZONTAL_PLANE_BLEED_STUDS)
	local planeWidth =
		math.max(textureRepeatWidth, visibleWidth + horizontalBleed, horizontalVisionStuds + horizontalBleed)

	return {
		planeWidth = planeWidth,
		textureRepeatWidth = textureRepeatWidth,
		textureRepeatHeight = textureRepeatHeight,
	}
end

function ParallaxServiceUtils.ResolveBiomeNameFromWorldSample(
	catalog: Catalog,
	biomeIdRaw: any,
	biomeTypeRaw: any,
	_depthLayerRaw: any
): string
	local biomeType = sanitizeInteger(biomeTypeRaw, WorldSimulationShared.BIOME_ID.FOREST, 0, 1024)
	local biomeId = sanitizeInteger(biomeIdRaw, WorldSimulationShared.BIOME_ID.FOREST, 0, 1024)

	if biomeId == WorldSimulationShared.BIOME_ID.CORRUPTION or biomeType == 2 then
		return ParallaxServiceUtils.ResolveBiomeName(catalog, "Corruption")
	end
	if biomeId == WorldSimulationShared.BIOME_ID.DESERT then
		return ParallaxServiceUtils.ResolveBiomeName(catalog, "Desert")
	end
	if biomeId == WorldSimulationShared.BIOME_ID.SNOW then
		return ParallaxServiceUtils.ResolveBiomeName(catalog, "Snow")
	end
	if biomeId == WorldSimulationShared.BIOME_ID.JUNGLE then
		return ParallaxServiceUtils.ResolveBiomeName(catalog, "Jungle")
	end
	return ParallaxServiceUtils.ResolveBiomeName(catalog, "Overworld")
end

ParallaxServiceUtils.normalizeCatalog = ParallaxServiceUtils.NormalizeCatalog
ParallaxServiceUtils.resolveBiomeName = ParallaxServiceUtils.ResolveBiomeName
ParallaxServiceUtils.resolveBiomeDefinition = ParallaxServiceUtils.ResolveBiomeDefinition
ParallaxServiceUtils.resolveVariantName = ParallaxServiceUtils.ResolveVariantName
ParallaxServiceUtils.resolveVariantDefinition = ParallaxServiceUtils.ResolveVariantDefinition
ParallaxServiceUtils.collectAssetIds = ParallaxServiceUtils.CollectAssetIds
ParallaxServiceUtils.createDefaultState = ParallaxServiceUtils.CreateDefaultState
ParallaxServiceUtils.cloneState = ParallaxServiceUtils.CloneState
ParallaxServiceUtils.computeHorizontalVisionStuds = ParallaxServiceUtils.ComputeHorizontalVisionStuds
ParallaxServiceUtils.resolveDeterministicPlaneSizing = ParallaxServiceUtils.ResolveDeterministicPlaneSizing
ParallaxServiceUtils.resolveBiomeNameFromWorldSample = ParallaxServiceUtils.ResolveBiomeNameFromWorldSample

return ParallaxServiceUtils
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="1313">
              <Properties>
                <string name="Name">PlatformServiceUtils</string>
                <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ImageIds = require(script:FindFirstAncestor("game").Client.UI.core.ImageIds)

local PlatformServiceUtils = {}

export type PlatformKind = "KeyboardMouse" | "Gamepad" | "Touch"
export type DeviceClass = "Phone" | "Tablet" | "Desktop" | "Console"

export type CapabilitySnapshot = {
	touchEnabled: boolean,
	keyboardEnabled: boolean,
	mouseEnabled: boolean,
	gamepadEnabled: boolean,
	basePrimaryInputType: string?,
}

export type PlatformState = CapabilitySnapshot & {
	platform: PlatformKind,
	deviceClass: DeviceClass,
	preferredInputName: string,
	lastInputTypeName: string,
	viewport: Vector2,
	isTenFootInterface: boolean,
}

export type ActionBinding = {
	keyCode: Enum.KeyCode?,
	inputType: Enum.UserInputType?,
	playerAction: Enum.PlayerActions?,
	axis: "X" | "Y"?,
	axisSign: number?,
	deadzone: number?,
	label: string?,
	icon: string?,
}

export type ActionDefinition = {
	actionName: string,
	displayName: string,
	description: string?,
	priority: number?,
	consume: boolean?,
	allowWhileTyping: boolean?,
	blockWhenPointerOverGui: boolean?,
	blockWhenGuiSelected: boolean?,
	bindingsByPlatform: { [string]: { ActionBinding } }?,
	promptBindingsByPlatform: { [string]: { ActionBinding } }?,
	touchPrompt: string?,
}

export type PromptBinding = {
	actionName: string,
	displayName: string,
	platform: PlatformKind,
	deviceClass: DeviceClass,
	text: string,
	icon: string?,
	keyCode: Enum.KeyCode?,
	inputType: Enum.UserInputType?,
	playerAction: Enum.PlayerActions?,
}

local KEYCODE_TEXT_OVERRIDES: { [Enum.KeyCode]: string } = {
	[Enum.KeyCode.MouseLeftButton] = "LMB",
	[Enum.KeyCode.MouseRightButton] = "RMB",
	[Enum.KeyCode.MouseMiddleButton] = "MMB",
	[Enum.KeyCode.Space] = "Space",
	[Enum.KeyCode.Return] = "Enter",
	[Enum.KeyCode.LeftControl] = "Ctrl",
	[Enum.KeyCode.RightControl] = "Ctrl",
	[Enum.KeyCode.LeftShift] = "Shift",
	[Enum.KeyCode.RightShift] = "Shift",
	[Enum.KeyCode.LeftAlt] = "Alt",
	[Enum.KeyCode.RightAlt] = "Alt",
	[Enum.KeyCode.ButtonA] = "A",
	[Enum.KeyCode.ButtonB] = "B",
	[Enum.KeyCode.ButtonX] = "X",
	[Enum.KeyCode.ButtonY] = "Y",
	[Enum.KeyCode.ButtonL1] = "LB",
	[Enum.KeyCode.ButtonR1] = "RB",
	[Enum.KeyCode.ButtonL2] = "LT",
	[Enum.KeyCode.ButtonR2] = "RT",
	[Enum.KeyCode.ButtonL3] = "L3",
	[Enum.KeyCode.ButtonR3] = "R3",
	[Enum.KeyCode.ButtonStart] = "Menu",
	[Enum.KeyCode.ButtonSelect] = "View",
	[Enum.KeyCode.DPadUp] = "D-Pad Up",
	[Enum.KeyCode.DPadDown] = "D-Pad Down",
	[Enum.KeyCode.DPadLeft] = "D-Pad Left",
	[Enum.KeyCode.DPadRight] = "D-Pad Right",
	[Enum.KeyCode.Thumbstick1] = "L Stick",
	[Enum.KeyCode.Thumbstick2] = "R Stick",
	[Enum.KeyCode.Zero] = "0",
	[Enum.KeyCode.One] = "1",
	[Enum.KeyCode.Two] = "2",
	[Enum.KeyCode.Three] = "3",
	[Enum.KeyCode.Four] = "4",
	[Enum.KeyCode.Five] = "5",
	[Enum.KeyCode.Six] = "6",
	[Enum.KeyCode.Seven] = "7",
	[Enum.KeyCode.Eight] = "8",
	[Enum.KeyCode.Nine] = "9",
}

local PLAYER_ACTION_TEXT_OVERRIDES: { [Enum.PlayerActions]: string } = {
	[Enum.PlayerActions.CharacterLeft] = "Move Left",
	[Enum.PlayerActions.CharacterRight] = "Move Right",
	[Enum.PlayerActions.CharacterForward] = "Move Up",
	[Enum.PlayerActions.CharacterBackward] = "Move Down",
}

local HINTS = if typeof((ImageIds :: any).hints) == "table" then (ImageIds :: any).hints else {}

local DEFAULT_GAMEPAD_FAMILY = "xbox"

local ACTIONS = {
	MOVE = "Player.Move",
	MOVE_LEFT = "Player.MoveLeft",
	MOVE_RIGHT = "Player.MoveRight",
	MOVE_VERTICAL = "Player.MoveVertical",
	MOVE_UP = "Player.MoveUp",
	MOVE_DOWN = "Player.MoveDown",
	JUMP = "Player.Jump",
	BUILD_PRIMARY = "BuildService.Primary",
	MELEE_ATTACK = "MeleeService.Attack",
	MAGIC_CAST = "MagicService.Cast",
	HOTBAR_SELECT = "Inventory.SelectHotbar",
	HOTBAR_CYCLE = "Inventory.CycleHotbar",
	OPEN_INVENTORY = "Inventory.Open",
	PLACE_DEPLOYABLE = "Inventory.PlaceDeployable",
}

PlatformServiceUtils.ACTIONS = ACTIONS

local function cloneBinding(binding: ActionBinding): ActionBinding
	return {
		keyCode = binding.keyCode,
		inputType = binding.inputType,
		playerAction = binding.playerAction,
		axis = binding.axis,
		axisSign = binding.axisSign,
		deadzone = binding.deadzone,
		label = binding.label,
		icon = binding.icon,
	}
end

local function cloneBindings(bindingsRaw: { ActionBinding }?): { ActionBinding }
	local output: { ActionBinding } = {}
	if typeof(bindingsRaw) ~= "table" then
		return output
	end
	for index = 1, #bindingsRaw do
		local binding = bindingsRaw[index]
		if typeof(binding) == "table" then
			output[#output + 1] = cloneBinding(binding)
		end
	end
	return output
end

local function cloneActionDefinition(definition: ActionDefinition): ActionDefinition
	local bindingsByPlatform = {}
	if typeof(definition.bindingsByPlatform) == "table" then
		for platform, bindings in definition.bindingsByPlatform do
			bindingsByPlatform[platform] = cloneBindings(bindings)
		end
	end
	local promptBindingsByPlatform = {}
	if typeof(definition.promptBindingsByPlatform) == "table" then
		for platform, bindings in definition.promptBindingsByPlatform do
			promptBindingsByPlatform[platform] = cloneBindings(bindings)
		end
	end
	return {
		actionName = definition.actionName,
		displayName = definition.displayName,
		description = definition.description,
		priority = definition.priority,
		consume = definition.consume,
		allowWhileTyping = definition.allowWhileTyping,
		blockWhenPointerOverGui = definition.blockWhenPointerOverGui,
		blockWhenGuiSelected = definition.blockWhenGuiSelected,
		bindingsByPlatform = bindingsByPlatform,
		promptBindingsByPlatform = promptBindingsByPlatform,
		touchPrompt = definition.touchPrompt,
	}
end

local function formatEnumName(name: string): string
	if #name <= 1 then
		return string.upper(name)
	end
	local withSpaces = string.gsub(name, "(%l)(%u)", "%1 %2")
	withSpaces = string.gsub(withSpaces, "(%u)(%u%l)", "%1 %2")
	return withSpaces
end

local function preferredInputName(preferredInputRaw: any): string
	if typeof(preferredInputRaw) == "EnumItem" then
		return preferredInputRaw.Name
	end
	return ""
end

local function lastInputTypeName(lastInputTypeRaw: any): string
	if typeof(lastInputTypeRaw) == "EnumItem" then
		return lastInputTypeRaw.Name
	end
	return ""
end

local function preferredLooksLikeGamepad(preferredInputRaw: any): boolean
	local name = preferredInputName(preferredInputRaw)
	return string.find(name, "Gamepad", 1, true) ~= nil
end

local function preferredLooksLikeTouch(preferredInputRaw: any): boolean
	local name = preferredInputName(preferredInputRaw)
	return string.find(name, "Touch", 1, true) ~= nil
end

local function preferredLooksLikeKeyboardMouse(preferredInputRaw: any): boolean
	local name = preferredInputName(preferredInputRaw)
	return string.find(name, "Keyboard", 1, true) ~= nil or string.find(name, "Mouse", 1, true) ~= nil
end

local function clampNumber(valueRaw: any, fallback: number, minValue: number, maxValue: number): number
	local value = if typeof(valueRaw) == "number" and valueRaw == valueRaw then valueRaw else fallback
	if value < minValue then
		return minValue
	end
	if value > maxValue then
		return maxValue
	end
	return value
end

local function sanitizeViewport(viewportRaw: any): Vector2
	if typeof(viewportRaw) == "Vector2" then
		return Vector2.new(math.max(1, viewportRaw.X), math.max(1, viewportRaw.Y))
	end
	return Vector2.new(1920, 1080)
end

function PlatformServiceUtils.IsGamepadInputType(inputTypeRaw: any): boolean
	if typeof(inputTypeRaw) ~= "EnumItem" then
		return false
	end
	return string.sub((inputTypeRaw :: Enum.UserInputType).Name, 1, 7) == "Gamepad"
end

function PlatformServiceUtils.IsTouchInputType(inputTypeRaw: any): boolean
	return inputTypeRaw == Enum.UserInputType.Touch
end

function PlatformServiceUtils.IsKeyboardInputType(inputTypeRaw: any): boolean
	return inputTypeRaw == Enum.UserInputType.Keyboard
end

function PlatformServiceUtils.IsMouseInputType(inputTypeRaw: any): boolean
	return inputTypeRaw == Enum.UserInputType.MouseButton1
		or inputTypeRaw == Enum.UserInputType.MouseButton2
		or inputTypeRaw == Enum.UserInputType.MouseButton3
		or inputTypeRaw == Enum.UserInputType.MouseMovement
		or inputTypeRaw == Enum.UserInputType.MouseWheel
end

function PlatformServiceUtils.IsPointerInputType(inputTypeRaw: any): boolean
	return PlatformServiceUtils.IsMouseInputType(inputTypeRaw) or PlatformServiceUtils.IsTouchInputType(inputTypeRaw)
end

function PlatformServiceUtils.ResolvePlatformKind(
	preferredInputRaw: any,
	lastInputTypeRaw: any,
	capabilitiesRaw: CapabilitySnapshot?
): PlatformKind
	local capabilities = if typeof(capabilitiesRaw) == "table"
		then capabilitiesRaw
		else {
			touchEnabled = false,
			keyboardEnabled = true,
			mouseEnabled = true,
			gamepadEnabled = false,
			basePrimaryInputType = nil,
		}

	if preferredLooksLikeGamepad(preferredInputRaw) then
		return "Gamepad"
	end
	if preferredLooksLikeTouch(preferredInputRaw) then
		return "Touch"
	end
	if preferredLooksLikeKeyboardMouse(preferredInputRaw) then
		return "KeyboardMouse"
	end

	if PlatformServiceUtils.IsGamepadInputType(lastInputTypeRaw) then
		return "Gamepad"
	end
	if PlatformServiceUtils.IsTouchInputType(lastInputTypeRaw) then
		return "Touch"
	end
	if
		PlatformServiceUtils.IsKeyboardInputType(lastInputTypeRaw)
		or PlatformServiceUtils.IsMouseInputType(lastInputTypeRaw)
	then
		return "KeyboardMouse"
	end

	if capabilities.basePrimaryInputType == "Gamepad" then
		return "Gamepad"
	end
	if capabilities.basePrimaryInputType == "Touch" then
		return "Touch"
	end
	if capabilities.touchEnabled and not capabilities.keyboardEnabled and not capabilities.mouseEnabled then
		return "Touch"
	end
	if capabilities.gamepadEnabled and not capabilities.keyboardEnabled and not capabilities.mouseEnabled then
		return "Gamepad"
	end

	return "KeyboardMouse"
end

function PlatformServiceUtils.ResolveDeviceClass(
	platformKindRaw: any,
	viewportRaw: any,
	capabilitiesRaw: CapabilitySnapshot?,
	isTenFootInterfaceRaw: any
): DeviceClass
	local platformKind = if platformKindRaw == "Touch" or platformKindRaw == "Gamepad"
		then platformKindRaw
		else "KeyboardMouse"
	local viewport = sanitizeViewport(viewportRaw)
	local capabilities = if typeof(capabilitiesRaw) == "table"
		then capabilitiesRaw
		else {
			touchEnabled = false,
			keyboardEnabled = true,
			mouseEnabled = true,
			gamepadEnabled = false,
			basePrimaryInputType = nil,
		}
	local isTenFootInterface = isTenFootInterfaceRaw == true

	if platformKind == "Gamepad" or (isTenFootInterface and capabilities.gamepadEnabled) then
		return "Console"
	end

	if platformKind == "Touch" then
		local minAxis = math.min(viewport.X, viewport.Y)
		local maxAxis = math.max(viewport.X, viewport.Y)
		if minAxis >= 700 or maxAxis >= 1280 then
			return "Tablet"
		end
		return "Phone"
	end

	return "Desktop"
end

function PlatformServiceUtils.CreatePlatformState(
	preferredInputRaw: any,
	lastInputTypeRaw: any,
	capabilitiesRaw: CapabilitySnapshot?,
	viewportRaw: any,
	isTenFootInterfaceRaw: any
): PlatformState
	local capabilities = if typeof(capabilitiesRaw) == "table"
		then capabilitiesRaw
		else {
			touchEnabled = false,
			keyboardEnabled = true,
			mouseEnabled = true,
			gamepadEnabled = false,
			basePrimaryInputType = nil,
		}
	local viewport = sanitizeViewport(viewportRaw)
	local platform = PlatformServiceUtils.ResolvePlatformKind(preferredInputRaw, lastInputTypeRaw, capabilities)
	local deviceClass = PlatformServiceUtils.ResolveDeviceClass(platform, viewport, capabilities, isTenFootInterfaceRaw)
	return {
		platform = platform,
		deviceClass = deviceClass,
		preferredInputName = preferredInputName(preferredInputRaw),
		lastInputTypeName = lastInputTypeName(lastInputTypeRaw),
		viewport = viewport,
		isTenFootInterface = isTenFootInterfaceRaw == true,
		touchEnabled = capabilities.touchEnabled == true,
		keyboardEnabled = capabilities.keyboardEnabled == true,
		mouseEnabled = capabilities.mouseEnabled == true,
		gamepadEnabled = capabilities.gamepadEnabled == true,
		basePrimaryInputType = capabilities.basePrimaryInputType,
	}
end

function PlatformServiceUtils.PlatformStatesEqual(a: PlatformState?, b: PlatformState?): boolean
	if a == nil or b == nil then
		return false
	end
	return a.platform == b.platform
		and a.deviceClass == b.deviceClass
		and a.preferredInputName == b.preferredInputName
		and a.lastInputTypeName == b.lastInputTypeName
		and a.viewport == b.viewport
		and a.isTenFootInterface == b.isTenFootInterface
		and a.touchEnabled == b.touchEnabled
		and a.keyboardEnabled == b.keyboardEnabled
		and a.mouseEnabled == b.mouseEnabled
		and a.gamepadEnabled == b.gamepadEnabled
		and a.basePrimaryInputType == b.basePrimaryInputType
end

function PlatformServiceUtils.ClonePlatformState(state: PlatformState): PlatformState
	return {
		platform = state.platform,
		deviceClass = state.deviceClass,
		preferredInputName = state.preferredInputName,
		lastInputTypeName = state.lastInputTypeName,
		viewport = state.viewport,
		isTenFootInterface = state.isTenFootInterface,
		touchEnabled = state.touchEnabled,
		keyboardEnabled = state.keyboardEnabled,
		mouseEnabled = state.mouseEnabled,
		gamepadEnabled = state.gamepadEnabled,
		basePrimaryInputType = state.basePrimaryInputType,
	}
end

function PlatformServiceUtils.ApplyThumbstickDeadzone(vectorRaw: any, deadzoneRaw: any): Vector2
	local vector = if typeof(vectorRaw) == "Vector2" then vectorRaw else Vector2.zero
	local deadzone = clampNumber(deadzoneRaw, 0.2, 0, 0.99)
	local magnitude = vector.Magnitude
	if magnitude <= deadzone then
		return Vector2.zero
	end
	if magnitude <= 0 then
		return Vector2.zero
	end
	local normalized = vector / magnitude
	local scaledMagnitude = (magnitude - deadzone) / (1 - deadzone)
	return normalized * math.clamp(scaledMagnitude, 0, 1)
end

function PlatformServiceUtils.HasThumbstickPassedDeadzone(vectorRaw: any, deadzoneRaw: any): boolean
	return PlatformServiceUtils.ApplyThumbstickDeadzone(vectorRaw, deadzoneRaw).Magnitude > 0
end

local function bindingKeyCodeForPrompt(binding: ActionBinding): Enum.KeyCode?
	if binding.keyCode ~= nil then
		return binding.keyCode
	end
	if binding.inputType == Enum.UserInputType.MouseButton1 then
		return Enum.KeyCode.MouseLeftButton
	end
	if binding.inputType == Enum.UserInputType.MouseButton2 then
		return Enum.KeyCode.MouseRightButton
	end
	if binding.inputType == Enum.UserInputType.MouseButton3 then
		return Enum.KeyCode.MouseMiddleButton
	end
	if binding.inputType == Enum.UserInputType.Touch then
		return Enum.KeyCode.Touch
	end
	return nil
end

local function resolvePromptText(binding: ActionBinding, touchPromptRaw: any): string
	if typeof(binding.label) == "string" and binding.label ~= "" then
		return binding.label
	end
	local keyCode = bindingKeyCodeForPrompt(binding)
	if keyCode ~= nil then
		local override = KEYCODE_TEXT_OVERRIDES[keyCode]
		if override ~= nil then
			return override
		end
		return formatEnumName(keyCode.Name)
	end
	if binding.playerAction ~= nil then
		local override = PLAYER_ACTION_TEXT_OVERRIDES[binding.playerAction]
		if override ~= nil then
			return override
		end
		return formatEnumName(binding.playerAction.Name)
	end
	if typeof(touchPromptRaw) == "string" and touchPromptRaw ~= "" then
		return touchPromptRaw
	end
	return "Action"
end

local function resolvePromptIcon(binding: ActionBinding, platformKind: PlatformKind, gamepadFamilyRaw: any): string?
	if typeof(binding.icon) == "string" and binding.icon ~= "" then
		return binding.icon
	end
	local keyCode = bindingKeyCodeForPrompt(binding)
	if keyCode == nil then
		return nil
	end
	if platformKind == "Gamepad" then
		local family = if gamepadFamilyRaw == "playstation" then "playstation" else DEFAULT_GAMEPAD_FAMILY
		local familyHints = if typeof(HINTS[family]) == "table" then HINTS[family] else HINTS[DEFAULT_GAMEPAD_FAMILY]
		if typeof(familyHints) == "table" then
			local icon = familyHints[keyCode]
			if typeof(icon) == "string" and icon ~= "" then
				return icon
			end
		end
		return nil
	end
	if platformKind == "Touch" then
		local mobileHints = HINTS.mobile
		if typeof(mobileHints) == "table" then
			local icon = mobileHints[keyCode]
			if typeof(icon) == "string" and icon ~= "" then
				return icon
			end
		end
		return nil
	end
	local keyboardHints = HINTS.keyboard
	if typeof(keyboardHints) == "table" then
		local icon = keyboardHints[keyCode]
		if typeof(icon) == "string" and icon ~= "" then
			return icon
		end
	end
	return nil
end

local function gameplayPointerBindings(
	mouseTouchLabel: string
): ({ [string]: { ActionBinding } }, { [string]: { ActionBinding } })
	return {
		KeyboardMouse = {
			{
				inputType = Enum.UserInputType.MouseButton1,
			},
		},
		Gamepad = {
			{
				keyCode = Enum.KeyCode.ButtonR2,
			},
		},
		Touch = {
			{
				inputType = Enum.UserInputType.Touch,
			},
		},
	}, {
		KeyboardMouse = {
			{
				keyCode = Enum.KeyCode.MouseLeftButton,
			},
		},
		Gamepad = {
			{
				keyCode = Enum.KeyCode.ButtonR2,
			},
		},
		Touch = {
			{
				inputType = Enum.UserInputType.Touch,
				label = mouseTouchLabel,
			},
		},
	}
end

