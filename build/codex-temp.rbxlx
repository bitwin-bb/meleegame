			bubbleProperties(workInProgress)
		end

		return nil
	end
	invariant(
		false,
[[Unknown unit of work tag (%s). This error is likely caused by a bug in React. Please file an issue.]]
,
		tostring(workInProgress.tag)
	)
	return nil
end

return {
	completeWork = completeWork,
}
