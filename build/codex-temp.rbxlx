                  <Properties>
                    <string name="Name">useTooltip</string>
                    <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local React = require(ReplicatedStorage.Packages.React)
local useStableCallback = require(script.Parent.internal.useStableCallback)

export type TooltipPayload = {
	id: string,
	text: string,
}

export type TooltipOptions = {
	id: string,
	text: string,
	enabled: boolean?,
	hovered: boolean?,
	show: (TooltipPayload) -> (),
	hide: (string?) -> (),
}

local function useTooltip(options: TooltipOptions)
	local show = useStableCallback(options.show)
	local hide = useStableCallback(options.hide)
	local enabled = options.enabled ~= false
	local hovered = options.hovered == true
	local id = options.id
	local text = options.text

	React.useEffect(function()
		if not enabled or not hovered then
			return
		end

		show({
			id = id,
			text = text,
		})
	end, { enabled, hovered, id, text, show })

	React.useEffect(function()
		if enabled and hovered then
			return
		end
		hide(id)
	end, { enabled, hovered, id, hide })

	React.useEffect(function()
		return function()
			hide(id)
		end
	end, { id, hide })
end

return useTooltip
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="812">
                  <Properties>
                    <string name="Name">useUiSound</string>
                    <string name="Source"><![CDATA[--!strict

local UiSound = require(script.Parent.Parent.utils.UiSound)
local useEvent = require(script:FindFirstAncestor("game").Client.UI.shared.useEvent)

export type UiSoundHook = {
	play: (soundAssetId: string?) -> (),
	playHover: () -> (),
	playPress: () -> (),
	playTrash: () -> (),
	playCraft: () -> (),
	playDrag: () -> (),
}

local function useUiSound(): UiSoundHook
	local play = useEvent(function(soundAssetId: string?)
		UiSound.play(soundAssetId)
	end) :: (string?) -> ()
	local playHover = useEvent(function()
		UiSound.playHover()
	end) :: () -> ()
	local playPress = useEvent(function()
		UiSound.playPress()
	end) :: () -> ()
	local playTrash = useEvent(function()
		UiSound.playTrash()
	end) :: () -> ()
	local playCraft = useEvent(function()
		UiSound.playCraft()
	end) :: () -> ()
	local playDrag = useEvent(function()
		UiSound.playDrag()
	end) :: () -> ()

	return {
		play = play,
		playHover = playHover,
		playPress = playPress,
		playTrash = playTrash,
		playCraft = playCraft,
		playDrag = playDrag,
	}
end

return useUiSound
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="813">
                  <Properties>
                    <string name="Name">useViewport</string>
                    <string name="Source"><![CDATA[--!strict
local GuiService = game:GetService("GuiService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Cleanup = require(script.Parent.internal.cleanup)
local PlatformServiceClient = require(script:FindFirstAncestor("game").Client.Services.PlatformServiceClient)
local PlatformServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.PlatformServiceUtils)
local React = require(ReplicatedStorage.Packages.React)

type PlatformState = PlatformServiceUtils.PlatformState

export type ViewportState = {
	viewport: Vector2,
	safeInsetTopLeft: Vector2,
	safeInsetBottomRight: Vector2,
	guiInsetTopLeft: Vector2,
	guiInsetBottomRight: Vector2,
	camera: Camera?,
	platformState: PlatformState?,
	uiScaleSnapshot: any?,
}

export type ViewportOptions = {
	usePlatformState: boolean?,
}

local FALLBACK_VIEWPORT = Vector2.new(1920, 1080)

local function resolveCurrentViewportSize(): Vector2
	local camera = Workspace.CurrentCamera
	if camera ~= nil then
		local viewportSize = camera.ViewportSize
		return Vector2.new(math.max(1, viewportSize.X), math.max(1, viewportSize.Y))
	end
	return FALLBACK_VIEWPORT
end

local function resolveViewportState(usePlatformState: boolean): ViewportState
	local camera = Workspace.CurrentCamera
	local guiInsetTopLeft, guiInsetBottomRight = GuiService:GetGuiInset()
	local platformState = nil :: PlatformState?
	if usePlatformState then
		local ok, resolvedState = pcall(function()
			return PlatformServiceClient:getState()
		end)
		if ok and typeof(resolvedState) == "table" then
			platformState = resolvedState :: PlatformState
		end
	end

	local uiScaleSnapshot = nil
	local okUIScale, uiScale = pcall(function()
		return PlatformServiceClient:getUIScale()
	end)
	if okUIScale and uiScale ~= nil and typeof((uiScale :: any).getSnapshot) == "function" then
		local okSnapshot, resolvedSnapshot = pcall(function()
			return (uiScale :: any):getSnapshot()
		end)
		if okSnapshot and typeof(resolvedSnapshot) == "table" then
			uiScaleSnapshot = resolvedSnapshot
		end
	end

	local safeInsetTopLeft = guiInsetTopLeft
	local safeInsetBottomRight = guiInsetBottomRight
	if uiScaleSnapshot ~= nil and typeof((uiScaleSnapshot :: any).safeTopLeft) == "Vector2" then
		safeInsetTopLeft = (uiScaleSnapshot :: any).safeTopLeft
	end
	if uiScaleSnapshot ~= nil and typeof((uiScaleSnapshot :: any).safeBottomRight) == "Vector2" then
		safeInsetBottomRight = (uiScaleSnapshot :: any).safeBottomRight
	end

	local viewport = if platformState ~= nil and typeof(platformState.viewport) == "Vector2"
		then platformState.viewport
		else resolveCurrentViewportSize()

	return {
		viewport = viewport,
		safeInsetTopLeft = safeInsetTopLeft,
		safeInsetBottomRight = safeInsetBottomRight,
		guiInsetTopLeft = guiInsetTopLeft,
		guiInsetBottomRight = guiInsetBottomRight,
		camera = camera,
		platformState = platformState,
		uiScaleSnapshot = uiScaleSnapshot,
	}
end

local function useViewport(options: ViewportOptions?): ViewportState
	local usePlatformState = if options ~= nil and options.usePlatformState ~= nil
		then options.usePlatformState == true
		else true
	local viewportState, setViewportState = React.useState(function(): ViewportState
		return resolveViewportState(usePlatformState)
	end)

	React.useEffect(function()
		local viewportConnection = nil

		local function refresh()
			setViewportState(resolveViewportState(usePlatformState))
		end

		local function bindViewportConnection()
			Cleanup.Call(viewportConnection)
			viewportConnection = nil

			local camera = Workspace.CurrentCamera
			if camera == nil then
				return
			end

			viewportConnection = camera:GetPropertyChangedSignal("ViewportSize"):Connect(refresh)
		end

		local stateSignal = PlatformServiceClient:getStateChangedSignal()
		local uiScaleSignal = PlatformServiceClient:getUIScaleChangedSignal()
		local stateConnection = if stateSignal ~= nil and typeof((stateSignal :: any).Connect) == "function"
			then (stateSignal :: any):Connect(refresh)
			else nil
		local uiScaleConnection = if uiScaleSignal ~= nil
				and typeof((uiScaleSignal :: any).Connect) == "function"
			then (uiScaleSignal :: any):Connect(refresh)
			else nil
		local cameraChangedConnection = Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
			bindViewportConnection()
			refresh()
		end)

		bindViewportConnection()
		refresh()

		return function()
			Cleanup.Call(viewportConnection)
			Cleanup.Call(stateConnection)
			Cleanup.Call(uiScaleConnection)
			cameraChangedConnection:Disconnect()
		end
	end, { usePlatformState })

	return viewportState
end

return useViewport
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="814">
                  <Properties>
                    <string name="Name">useViewportScale</string>
                    <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local React = require(ReplicatedStorage.Packages.React)
local UiScaleUtils = require(script:FindFirstAncestor("game").Client.UI.core.utils.UiScaleUtils)
local useViewport = require(script.Parent.useViewport)

export type ResponsiveMetrics = UiScaleUtils.ResponsiveMetrics

type ProviderProps = {
	children: { React.ReactNode }?,
	viewport: Vector2?,
}

local ResponsiveContext = React.createContext(nil :: ResponsiveMetrics?)

local function useViewportScale(viewportOverride: Vector2?): ResponsiveMetrics
	local viewportState = useViewport({
		usePlatformState = true,
	})

	return React.useMemo(function(): ResponsiveMetrics
		return UiScaleUtils.resolveMetrics(
			viewportOverride or viewportState.viewport,
			viewportState.safeInsetTopLeft,
			viewportState.safeInsetBottomRight
		)
	end, {
		viewportOverride,
		viewportState.viewport,
		viewportState.safeInsetTopLeft,
		viewportState.safeInsetBottomRight,
	})
end

local function useResponsiveMetrics(): ResponsiveMetrics
	local contextMetrics = React.useContext(ResponsiveContext)
	if contextMetrics ~= nil then
		return contextMetrics
	end
	return useViewportScale(nil)
end

local function Provider(props: ProviderProps): React.ReactNode
	local metrics = useViewportScale(props.viewport)

	return React.createElement(ResponsiveContext.Provider, {
		value = metrics,
	}, props.children)
end

return {
	Context = ResponsiveContext,
	Provider = Provider,
	useResponsiveMetrics = useResponsiveMetrics,
	useViewportScale = useViewportScale,
}
]]></string>
                  </Properties>
                </Item>
              </Item>
              <Item class="Folder" referent="815">
