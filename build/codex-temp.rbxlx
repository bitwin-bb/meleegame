	Constants.CHAR_AT, --[[ @ ]]
	Constants.CHAR_BACKWARD_SLASH, --[[ \ ]]
	Constants.CHAR_COMMA, --[[ , ]]
	Constants.CHAR_DOT, --[[ . ]]
