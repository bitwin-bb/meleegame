              <Item class="Folder" referent="1078">
                <Properties>
                  <string name="Name">PackageSpecs</string>
                </Properties>
                <Item class="ModuleScript" referent="1079">
                  <Properties>
                    <string name="Name">PackageIntegration.spec</string>
                    <string name="Source"><![CDATA[--!strict

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Matter = require(ReplicatedStorage.Packages.Matter)
local TestEZ = require(ReplicatedStorage.Packages.TestEZ)
local packageRoot = script:FindFirstAncestor("game").Parent
local loaderUtils = assert(packageRoot:FindFirstChild("LoaderUtils", true), "Missing LoaderUtils")
local loader = require(loaderUtils.Parent).load(script)

local Binder = loader("Binder")
local Brio = loader("Brio")
local Maid = loader("Maid")
local Octree = loader("Octree")
local Rx = loader("Rx")
local RxSignal = loader("RxSignal")

return function()
	describe("Package integrations", function()
		it("exposes TestEZ through the shared packages tree", function()
			expect(typeof(TestEZ.run)).to.equal("function")
			expect(typeof(TestEZ.TestBootstrap)).to.equal("table")
			expect(TestEZ.Reporters.TextReporter ~= nil).to.equal(true)
		end)

		it("allows Maid to clean Rx subscriptions deterministically", function()
			local bindable = Instance.new("BindableEvent")
			local values = {}
			local maid = Maid.new()

			maid:GiveTask(Rx.fromSignal(bindable.Event):Subscribe(function(value)
				values[#values + 1] = value
			end))

			bindable:Fire(2)
			task.wait()
			bindable:Fire(4)
			task.wait()
			expect(#values).to.equal(2)
			expect(values[1]).to.equal(2)
			expect(values[2]).to.equal(4)

			maid:Destroy()
			bindable:Fire(8)
			expect(#values).to.equal(2)
			bindable:Destroy()
		end)

		it("lets Matter worlds and loops run scheduled systems", function()
			local Position = Matter.component("PackageIntegrationPosition")
			local world = Matter.World.new()
			local loop = Matter.Loop.new(world)
			local tick = Instance.new("BindableEvent")
			local entityId = world:spawn(Position({
				x = 5,
			}))

			loop:scheduleSystem(function(activeWorld)
				for entityId, position in activeWorld:query(Position) do
					activeWorld:insert(
						entityId,
						Position({
							x = position.x + 1,
						})
					)
				end
			end)

			local connections = loop:begin({
				default = tick.Event,
			})

			tick:Fire()
			task.wait()
			tick:Fire()
			task.wait()

			local position = world:get(entityId, Position)
			expect(position.x).to.equal(7)

			connections.default:Disconnect()
			tick:Destroy()
		end)

		it("supports Brio lifetimes and RxSignal wrappers", function()
			local bindable = Instance.new("BindableEvent")
			local signal = RxSignal.new(Rx.fromSignal(bindable.Event))
			local brio = Brio.new("alive")
			local cleaned = 0
			local values = {}

			brio:ToMaid():GiveTask(function()
				cleaned += 1
			end)

			signal:Connect(function(value)
				values[#values + 1] = value
			end)

			bindable:Fire("hello")
			task.wait()
			brio:Kill()

			expect(values[1]).to.equal("hello")
			expect(cleaned).to.equal(1)
			bindable:Destroy()
		end)

		it("supports Octree spatial queries and Binder instance lifetimes", function()
			local octree = Octree.new()
			local nodeA = octree:CreateNode(Vector3.new(0, 0, 0), "A")
			local nodeB = octree:CreateNode(Vector3.new(20, 0, 0), "B")
			local nearby = octree:RadiusSearch(Vector3.zero, 10)
			expect(#nearby).to.equal(1)
			expect(nearby[1]).to.equal("A")

			local binder = Binder.new("PackageIntegrationBinderSpec", function(inst: Instance)
				return {
					instance = inst,
					Destroy = function(self: any)
						self.destroyed = true
					end,
				}
			end)
			binder:Start()

			local folder = Instance.new("Folder")
			folder.Name = "BoundFolder"
			folder.Parent = workspace
			CollectionService:AddTag(folder, "PackageIntegrationBinderSpec")
			task.wait()

			local bound = binder:Get(folder)
			expect(bound ~= nil).to.equal(true)
			CollectionService:RemoveTag(folder, "PackageIntegrationBinderSpec")
			task.wait()
			expect(binder:Get(folder)).to.equal(nil)

			nodeA:Destroy()
			nodeB:Destroy()
			folder:Destroy()
			binder:Destroy()
		end)
	end)
end
]]></string>
                  </Properties>
                </Item>
              </Item>
              <Item class="Folder" referent="1080">
                <Properties>
                  <string name="Name">Services</string>
                </Properties>
                <Item class="ModuleScript" referent="1081">
                  <Properties>
                    <string name="Name">BossReactive.spec</string>
                    <string name="Source"><![CDATA[--!strict

local packageRoot = script:FindFirstAncestor("game").Parent
local loaderUtils = assert(packageRoot:FindFirstChild("LoaderUtils", true), "Missing LoaderUtils")
local loader = require(loaderUtils.Parent).load(script)

local Maid = loader("Maid")
local BossBase = require(script:FindFirstAncestor("game").Shared.Classes.Boss)
local BossServiceServer = require(script:FindFirstAncestor("game").Server.Services.BossServiceServer)
local BossServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.BossServiceUtils)
local EyeOfCthulhuConfig = require(script:FindFirstAncestor("game").Shared.Classes.Boss.EyeOfCthulhu.Config)

local function createTestService()
	local service = setmetatable({
		maid = Maid.new(),
		networker = {
			fire = function()
				return
			end,
			destroy = function()
				return
			end,
		},
		hpService = nil,
		weatherService = nil,
		worldGenerationService = nil,
		controllersById = {},
		controllersByChannel = {},
		boundModelsById = {},
		state = BossServiceUtils.createDefaultState(),
		statePushInterval = 0,
		naturalSpawnCheckInterval = BossServiceUtils.DEFAULT_NATURAL_SPAWN_CHECK_INTERVAL,
		naturalSpawnAccumulator = 0,
		random = Random.new(1337),
		world = nil,
		pendingNaturalSpawn = nil,
		allowClientManualSummon = false,
		defaultConfigByBossId = {
			EyeOfCthulhu = EyeOfCthulhuConfig.getDefaults(),
		},
		previousClockTime = 12,
	}, {
		__index = BossServiceServer,
	})

	service:initReactiveState()
	return service
end

local function createTestBoss(service)
	local definition = assert(BossServiceUtils.getRegistryEntryById("EyeOfCthulhu"))
	return BossBase.new(service, definition, {
		bossId = "EyeOfCthulhu",
		spawnSource = "DebugCommand",
		encounterChannel = "spec.eye",
		spawnPosition = Vector3.new(0, 30, 0),
	}, {
		maxHp = 150,
		defense = 4,
		contactDamage = 8,
	})
end

return function()
	describe("Boss reactive lifecycle", function()
		it("exposes stateful Rx streams and promise waits on the boss base class", function()
			local service = createTestService()
			local boss = createTestBoss(service)
			local maid = Maid.new()
			local observedStates = {}
			local observedModelPresence = {}
			local snapshotStates = {}
			local modelBriosDied = 0

			maid:GiveTask(boss:observeState():Subscribe(function(state)
				table.insert(observedStates, state)
			end))
			maid:GiveTask(boss:observeModel():Subscribe(function(model)
				table.insert(observedModelPresence, model ~= nil)
			end))
			maid:GiveTask(boss:observeSnapshot():Subscribe(function(snapshot)
				table.insert(snapshotStates, snapshot.state)
			end))
			maid:GiveTask(boss:observeModelBrio():Subscribe(function(brio)
				maid:GiveTask(brio:GetDiedSignal():Connect(function()
					modelBriosDied += 1
				end))
			end))

			expect(observedStates[1]).to.equal("Dormant")
			expect(observedModelPresence[1]).to.equal(false)
			expect(snapshotStates[1]).to.equal("Dormant")

			local statePromise = boss:promiseState("Phase1Hover")
			boss:changeState("Phase1Hover", "spec_state")
			local stateOk, nextState = statePromise:Yield()
			expect(stateOk).to.equal(true)
			expect(nextState).to.equal("Phase1Hover")

			local spawnOk, model = boss:spawnPromise():Yield()
			expect(spawnOk).to.equal(true)
			expect(typeof(model)).to.equal("Instance")
			expect((model :: Instance):IsA("Model")).to.equal(true)
			expect(observedModelPresence[#observedModelPresence]).to.equal(true)

			boss:requestRemoval("spec_remove")
			local removedOk, removedReason = boss:promiseRemoved():Yield()
			expect(removedOk).to.equal(true)
			expect(removedReason).to.equal("spec_remove")

			boss:destroy()
			expect(modelBriosDied).to.equal(1)

			maid:Destroy()
			service:destroy()
		end)

		it("wires controller tracking through reactive service helpers", function()
			local service = createTestService()
			local boss = createTestBoss(service)
			local maid = Maid.new()
			local addedIds = {}
			local updatedIds = {}
			local removedIds = {}
			local observedStates = {}

			maid:GiveTask(service:observeControllerAdded():Subscribe(function(snapshot)
				table.insert(addedIds, snapshot.id)
			end))
			maid:GiveTask(service:observeControllerUpdated():Subscribe(function(snapshot)
				table.insert(updatedIds, snapshot.id)
			end))
			maid:GiveTask(service:observeControllerRemoved():Subscribe(function(payload)
				table.insert(removedIds, payload.id)
			end))
			maid:GiveTask(service:observeState():Subscribe(function(state)
				table.insert(observedStates, #state.orderedIds)
			end))

			local waitForTrackedBoss = service:waitForControllerPromise(boss.id)
			service:trackController(boss)
			local addedSnapshot = service:upsertControllerState(boss)
			service:emitControllerAdded(addedSnapshot, boss)

			local waitedOk, waitedBoss = waitForTrackedBoss:Yield()
			expect(waitedOk).to.equal(true)
			expect(waitedBoss).to.equal(boss)
			expect(addedIds[#addedIds]).to.equal(boss.id)
			expect(observedStates[#observedStates]).to.equal(1)

			boss:changeState("Phase1Hover", "service_update")
			expect(updatedIds[#updatedIds]).to.equal(boss.id)

			local removalPromise = service:waitForControllerRemovalPromise(boss.id)
			boss:requestRemoval("service_remove")
			local removedOk, removedPayload = removalPromise:Yield()
			expect(removedOk).to.equal(true)
			expect(removedPayload.id).to.equal(boss.id)
			expect(removedIds[#removedIds]).to.equal(boss.id)
			expect(service.controllersById[boss.id]).to.equal(nil)

			maid:Destroy()
			service:destroy()
		end)

		it("provides promise-based spawn helpers on the service", function()
			local service = createTestService()
			local spawnPromise = service:spawnBossPromise({
				bossId = "EyeOfCthulhu",
				spawnSource = "DebugCommand",
				encounterChannel = "spec.promise_spawn",
				spawnPosition = Vector3.new(0, 35, 18),
			})

			local ok, boss, reason = spawnPromise:Yield()
			expect(ok).to.equal(true)
			expect(boss ~= nil).to.equal(true)
			expect(reason).to.equal(nil)
			expect(service.controllersById[(boss :: any).id]).to.equal(boss)

			service:destroy()
		end)
	end)
end
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="1082">
                  <Properties>
                    <string name="Name">InventoryProfile.spec</string>
                    <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local InventoryProfile = require(script:FindFirstAncestor("game").Shared.Services.Profile)
local InventoryServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.InventoryServiceUtils)

local function createPlayer(): Player
	return {
		Name = "InventorySpec",
		UserId = 12345,
	} :: any
end

return function()
	describe("InventoryProfile", function()
		it("writes loaded inventory state back into the live profile data path without saving immediately", function()
			local saveCalls = 0
			local profile = {
				Data = {
					inventory = {
						capacity = 40,
						selectedSlot = nil,
						slots = {},
					},
				},
			}
			local playerDataService = {
				getProfile = function(_self: any, _player: Player)
					return profile
				end,
				savePlayerData = function(_self: any, _player: Player)
					saveCalls += 1
					return true
				end,
			}

			local adapter = InventoryProfile.new(playerDataService :: any)
			local state = InventoryServiceUtils.createDefaultState(InventoryServiceUtils.LOAD_STATE_LOADED)
			InventoryServiceUtils.addItem(state, "Stone", 3, 99, nil, "spec")
			InventoryServiceUtils.setSelectedSlot(state, 1)

			local didWrite, writeReason = adapter:writeState(createPlayer(), state)

			expect(didWrite).to.equal(true)
			expect(writeReason).to.equal("written:inventory")
			expect(saveCalls).to.equal(0)
			expect(profile.Data.inventory.selectedSlot).to.equal(1)
			expect(profile.Data.inventory.slots[1].itemId).to.equal("Stone")
			expect(profile.Data.inventory.slots[1].amount).to.equal(3)
		end)

		it("saves through the same live profile path after writing the serialized inventory snapshot", function()
			local saveCalls = 0
			local profile = {
				Data = {
					inventory = {
						capacity = 40,
						selectedSlot = nil,
						slots = {},
					},
				},
			}
			local playerDataService = {
				getProfile = function(_self: any, _player: Player)
					return profile
				end,
				savePlayerData = function(_self: any, _player: Player)
					saveCalls += 1
					return true
				end,
			}

			local adapter = InventoryProfile.new(playerDataService :: any)
			local state = InventoryServiceUtils.createDefaultState(InventoryServiceUtils.LOAD_STATE_LOADED)
			InventoryServiceUtils.addItem(state, "CopperOre", 2, 99, nil, "spec")

			local didSave, saveReason = adapter:saveState(createPlayer(), state)

			expect(didSave).to.equal(true)
			expect(saveReason).to.equal("saved:inventory")
			expect(saveCalls).to.equal(1)
			expect(profile.Data.inventory.slots[1].itemId).to.equal("CopperOre")
			expect(profile.Data.inventory.slots[1].amount).to.equal(2)
		end)

		it("refuses to touch the profile for unloaded inventory states", function()
			local didLookupProfile = false
			local playerDataService = {
				getProfile = function(_self: any, _player: Player)
					didLookupProfile = true
					return {
						Data = {},
					}
				end,
				savePlayerData = function(_self: any, _player: Player)
					return true
				end,
			}

			local adapter = InventoryProfile.new(playerDataService :: any)
			local state = InventoryServiceUtils.createDefaultState(InventoryServiceUtils.LOAD_STATE_LOADING)

			local didSave, saveReason = adapter:saveState(createPlayer(), state)

			expect(didSave).to.equal(false)
			expect(saveReason).to.equal("state_not_loaded")
			expect(didLookupProfile).to.equal(false)
		end)
	end)
end
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="1083">
                  <Properties>
                    <string name="Name">InventoryServiceUtils.spec</string>
                    <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local InventoryServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.InventoryServiceUtils)

return function()
	describe("InventoryServiceUtils", function()
		it("hydrates persisted data into the canonical state shape", function()
			local state = InventoryServiceUtils.createStateFromData(
				{
					capacity = 72,
					selectedSlot = 2,
					slots = {
						{
							index = 2,
							itemId = "CopperPickaxe",
							stackId = "tool_pickaxe",
							amount = 1,
							maxStack = 1,
							metadata = { itemType = "pickaxe" },
						},
					},
				},
				InventoryServiceUtils.createDefaultState(InventoryServiceUtils.LOAD_STATE_UNLOADED),
				InventoryServiceUtils.LOAD_STATE_LOADED
			)

			expect(state.loadState).to.equal(InventoryServiceUtils.LOAD_STATE_LOADED)
			expect(state.selectedSlot).to.equal(2)
			expect(state.occupiedSlotCount).to.equal(1)
			expect(state.totalItemCount).to.equal(1)
			expect(InventoryServiceUtils.getStack(state, 2).itemId).to.equal("CopperPickaxe")
		end)

		it("moves partial stacks into empty slots deterministically", function()
			local state = InventoryServiceUtils.createDefaultState(InventoryServiceUtils.LOAD_STATE_LOADED)
			InventoryServiceUtils.addItem(state, "Stone", 10, 99, nil, "test")

			local result = InventoryServiceUtils.moveSlot(state, 1, 3, 4)

			expect(result.changed).to.equal(true)
			expect(result.movedAmount).to.equal(4)
			expect(InventoryServiceUtils.getStack(state, 1).amount).to.equal(6)
			expect(InventoryServiceUtils.getStack(state, 3).amount).to.equal(4)
		end)

		it("splits stacks without mutating the selected slot contract", function()
			local state = InventoryServiceUtils.createDefaultState(InventoryServiceUtils.LOAD_STATE_LOADED)
			InventoryServiceUtils.addItem(state, "Stone", 9, 99, nil, "test")
			InventoryServiceUtils.setSelectedSlot(state, 1)

			local result = InventoryServiceUtils.splitSlot(state, 1, 2, 3)

			expect(result.changed).to.equal(true)
			expect(state.selectedSlot).to.equal(1)
			expect(InventoryServiceUtils.getStack(state, 1).amount).to.equal(6)
			expect(InventoryServiceUtils.getStack(state, 2).amount).to.equal(3)
		end)

		it("trashes the selected slot through the same pure mutation path the UI uses", function()
			local state = InventoryServiceUtils.createDefaultState(InventoryServiceUtils.LOAD_STATE_LOADED)
			InventoryServiceUtils.addItem(state, "Stone", 5, 99, nil, "test")
			InventoryServiceUtils.setSelectedSlot(state, 1)

			local result = InventoryServiceUtils.trashSelected(state, 2)

			expect(result.changed).to.equal(true)
			expect(result.removedAmount).to.equal(2)
			expect(InventoryServiceUtils.getStack(state, 1).amount).to.equal(3)
		end)
	end)
end
]]></string>
                  </Properties>
