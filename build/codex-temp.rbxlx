              </Properties>
            </Item>
            <Item class="ModuleScript" referent="1060">
              <Properties>
                <string name="Name">PlayerDataServiceServer</string>
                <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Networker = require(script:FindFirstAncestor("game").Shared.Modules.Networking.Networker)
local Signal = require(ReplicatedStorage.Packages.Signal)
local packageRoot = script:FindFirstAncestor("game").Parent
local loaderUtils = assert(packageRoot:FindFirstChild("LoaderUtils", true), "Missing LoaderUtils")
local DataTemplate = require(script:FindFirstAncestor("game").Shared.Modules.Core.DataTemplate)
local PlayerDataServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.PlayerDataServiceUtils)
local ProfileStore =
	require(game:GetService("ServerScriptService"):WaitForChild("ServerPackages"):WaitForChild("ProfileStore"))
local loader = require(loaderUtils.Parent).load(script)
local Promise = loader("Promise")

type PlayerData = PlayerDataServiceUtils.PlayerData
type LoadState = PlayerDataServiceUtils.LoadState
type Profile = ProfileStore.Profile<PlayerData>
type ProfileStoreObject = ProfileStore.ProfileStore<PlayerData>
type ProfileSignalConnection = {
	Disconnect: (self: ProfileSignalConnection) -> (),
}

type StateChangedSignal = {
	Connect: (self: StateChangedSignal, callback: () -> ()) -> any,
	Fire: (self: StateChangedSignal) -> (),
	DisconnectAll: (self: StateChangedSignal) -> (),
	Destroy: (self: StateChangedSignal) -> (),
}

type PlayerRuntime = {
	loadToken: number,
	loadState: LoadState,
	profile: Profile?,
	data: PlayerData?,
	isLoading: boolean,
	hasResolvedInitialLoad: boolean,
	lastFailureReason: string?,
	loadStartedAt: number,
	usingFallbackData: boolean,
	fallbackBaselineData: PlayerData?,
	fallbackDirty: boolean,
	profileEndedConnection: ProfileSignalConnection?,
	stateChangedSignal: StateChangedSignal,
	loadPromise: any?,
}

local PlayerDataServiceServer = {}

local DATA_SESSION_ENDED_KICK_MESSAGE = "Your data session ended. Please rejoin."
local PROFILE_FALLBACK_DATASTORE_TIMEOUT_SECONDS = 2
local PROFILE_SESSION_START_TIMEOUT_SECONDS = 5

local function promiseTry<T...>(callback: () -> T...): Promise.Promise<T...>
	return Promise.spawn(function(resolve, reject)
		local results = table.pack(pcall(callback))
		if results[1] then
			resolve(table.unpack(results, 2, results.n))
		else
			reject(table.unpack(results, 2, results.n))
		end
	end)
end

local function resolvePlayerDataTemplate(): PlayerData
	local templateRoot = if typeof(DataTemplate) == "table" then DataTemplate else {}
	local playerData = if typeof((templateRoot :: any).playerData) == "table"
		then (templateRoot :: any).playerData
		else {}
	return PlayerDataServiceUtils.createDefaultData(playerData)
end

local function runProtectedWithTimeout(timeoutSeconds: number, callback: () -> any): (string, boolean, any)
	local bindable = Instance.new("BindableEvent")
	local settled = false

	local function settle(status: string, success: boolean, result: any)
		if settled then
			return
		end
		settled = true
		bindable:Fire(status, success, result)
	end

	task.spawn(function()
		local success, result = pcall(callback)
		settle("completed", success, result)
	end)

	task.delay(math.max(0, timeoutSeconds), function()
		settle("timed_out", false, nil)
	end)

	local status, success, result = bindable.Event:Wait()
	bindable:Destroy()
	return status, success, result
end

local function sanitizeFailureReason(reasonRaw: any): string?
	if typeof(reasonRaw) ~= "string" then
		return nil
	end
	local trimmedReason = string.match(reasonRaw, "^%s*(.-)%s*$") or ""
	if trimmedReason == "" then
		return nil
	end
	return trimmedReason
end

local function stringifyLogValue(valueRaw: any): string
	if valueRaw == nil then
		return "nil"
	end
	local valueType = typeof(valueRaw)
	if valueType == "string" or valueType == "number" or valueType == "boolean" then
		return tostring(valueRaw)
	end
	return valueType
end

function PlayerDataServiceServer.Init(self: PlayerDataServiceServer)
	self.dataTemplate = resolvePlayerDataTemplate()
	self.profileStore = ProfileStore.New(PlayerDataServiceUtils.DEFAULT_PROFILE_STORE_NAME, self.dataTemplate)
	self.playerRuntimes = {}
	self.networker = Networker.server.new("PlayerDataService", self, {
		self.RequestSync,
	})

	for _, player in Players:GetPlayers() do
		self:trackPlayer(player)
	end

	self.playerAddedConnection = Players.PlayerAdded:Connect(function(player: Player)
		self:trackPlayer(player)
	end)

	self.playerRemovingConnection = Players.PlayerRemoving:Connect(function(player: Player)
		self:untrackPlayer(player)
	end)
end

function PlayerDataServiceServer.CreateRuntime(_self: PlayerDataServiceServer): PlayerRuntime
	return {
		loadToken = 0,
		loadState = PlayerDataServiceUtils.LOAD_STATE_UNLOADED,
		profile = nil,
		data = nil,
		isLoading = false,
		hasResolvedInitialLoad = false,
		lastFailureReason = nil,
		loadStartedAt = 0,
		usingFallbackData = false,
		fallbackBaselineData = nil,
		fallbackDirty = false,
		profileEndedConnection = nil,
		stateChangedSignal = Signal.new() :: StateChangedSignal,
		loadPromise = nil,
	}
end

function PlayerDataServiceServer.GetRuntime(self: PlayerDataServiceServer, player: Player): PlayerRuntime
	local runtime = self.playerRuntimes[player]
	if runtime then
		return runtime
	end

	local nextRuntime = self:createRuntime()
	self.playerRuntimes[player] = nextRuntime
	return nextRuntime
end

function PlayerDataServiceServer.GetRuntimeLoadElapsedSeconds(
	_self: PlayerDataServiceServer,
	runtime: PlayerRuntime
): number
	if runtime.loadStartedAt <= 0 then
		return 0
	end
	return math.max(0, os.clock() - runtime.loadStartedAt)
end

function PlayerDataServiceServer.GetRuntimeStateMetadata(
	self: PlayerDataServiceServer,
	runtime: PlayerRuntime
): { [string]: any }
	return {
		isLoading = runtime.isLoading,
		hasResolvedInitialLoad = runtime.hasResolvedInitialLoad,
		loadToken = runtime.loadToken,
		lastFailureReason = runtime.lastFailureReason,
		loadElapsedSeconds = self:getRuntimeLoadElapsedSeconds(runtime),
	}
end

function PlayerDataServiceServer.LogEvent(
	self: PlayerDataServiceServer,
	eventName: string,
	player: Player,
	runtime: PlayerRuntime?,
	extraFieldsRaw: any
)
	local fields = {
		("event=%s"):format(eventName),
		("player=%s"):format(player.Name),
		("userId=%d"):format(player.UserId),
	}
	if runtime ~= nil then
		fields[#fields + 1] = ("loadState=%s"):format(runtime.loadState)
		fields[#fields + 1] = ("isLoading=%s"):format(tostring(runtime.isLoading))
		fields[#fields + 1] = ("hasResolvedInitialLoad=%s"):format(tostring(runtime.hasResolvedInitialLoad))
		fields[#fields + 1] = ("loadToken=%d"):format(runtime.loadToken)
		fields[#fields + 1] = ("elapsed=%.3f"):format(self:getRuntimeLoadElapsedSeconds(runtime))
		if runtime.lastFailureReason ~= nil then
			fields[#fields + 1] = ("lastFailureReason=%s"):format(runtime.lastFailureReason)
		end
	end
	if typeof(extraFieldsRaw) == "table" then
		for key, value in extraFieldsRaw :: { [string]: any } do
			fields[#fields + 1] = ("%s=%s"):format(tostring(key), stringifyLogValue(value))
		end
	end
end

function PlayerDataServiceServer.DisconnectProfileEndedConnection(
	_self: PlayerDataServiceServer,
	runtime: PlayerRuntime
)
	local connection = runtime.profileEndedConnection
	if connection == nil then
		return
	end

	connection:Disconnect()
	runtime.profileEndedConnection = nil
end

function PlayerDataServiceServer.ReleaseProfile(self: PlayerDataServiceServer, runtime: PlayerRuntime)
	self:disconnectProfileEndedConnection(runtime)

	local profile = runtime.profile
	runtime.profile = nil
	runtime.data = nil
	runtime.usingFallbackData = false
	runtime.fallbackBaselineData = nil
	runtime.fallbackDirty = false

	if profile and profile:IsActive() then
		profile:EndSession()
	end
end

function PlayerDataServiceServer.EmitRuntimeStateChanged(_self: PlayerDataServiceServer, runtime: PlayerRuntime)
	runtime.stateChangedSignal:Fire()
end

function PlayerDataServiceServer.PushState(self: PlayerDataServiceServer, player: Player)
	local runtime = self.playerRuntimes[player]
	if self.networker == nil then
		if runtime ~= nil then
			self:emitRuntimeStateChanged(runtime)
		end
		return
	end

	if runtime == nil then
		self.networker:fire(player, "applyState", nil, PlayerDataServiceUtils.LOAD_STATE_UNLOADED, {
			isLoading = false,
			hasResolvedInitialLoad = false,
			loadToken = 0,
			lastFailureReason = nil,
			loadElapsedSeconds = 0,
		})
		return
	end

	local dataSnapshot = if runtime.data ~= nil then PlayerDataServiceUtils.cloneDeep(runtime.data) else nil
	self.networker:fire(player, "applyState", dataSnapshot, runtime.loadState, self:getRuntimeStateMetadata(runtime))
	self:emitRuntimeStateChanged(runtime)
end

function PlayerDataServiceServer.GetResolvedRuntime(self: PlayerDataServiceServer, player: Player): PlayerRuntime?
	local runtime = self.playerRuntimes[player]
	if runtime == nil then
		return nil
	end
	if runtime.loadState ~= PlayerDataServiceUtils.LOAD_STATE_LOADED then
		return nil
	end
	if runtime.data == nil then
		return nil
	end
	return runtime
end

function PlayerDataServiceServer.GetAvailableRuntime(self: PlayerDataServiceServer, player: Player): PlayerRuntime?
	local runtime = self.playerRuntimes[player]
	if runtime == nil or runtime.data == nil then
		return nil
	end
	if runtime.loadState == PlayerDataServiceUtils.LOAD_STATE_LOADED then
		return runtime
	end
	if runtime.hasResolvedInitialLoad then
		return runtime
	end
	return nil
end

function PlayerDataServiceServer.ResolvePersistedDataSnapshot(
	self: PlayerDataServiceServer,
	rawSnapshotRaw: any
): PlayerData
	local rawSnapshot = rawSnapshotRaw
	if typeof(rawSnapshot) == "table" and typeof((rawSnapshot :: { [string]: any }).Data) == "table" then
		rawSnapshot = (rawSnapshot :: { [string]: any }).Data
	end

	local resolved = if typeof(rawSnapshot) == "table"
		then PlayerDataServiceUtils.cloneDeep(rawSnapshot)
		else PlayerDataServiceUtils.createDefaultData(self.dataTemplate)
	PlayerDataServiceUtils.reconcileData(resolved, self.dataTemplate)
	return resolved
end

function PlayerDataServiceServer.ResolveFallbackLoadResult(
	self: PlayerDataServiceServer,
	player: Player
): (boolean, PlayerData?, string, string)
	local profileKey = PlayerDataServiceUtils.getProfileKey(player)
	if profileKey == nil then
		return false, nil, "default", "profile_key_invalid"
	end

	local profileStore = self.profileStore
	local rawDataStore = if typeof(profileStore) == "table" then (profileStore :: any).data_store else nil
	if rawDataStore == nil then
		return false, nil, "default", "datastore_unavailable"
	end

	local completionStatus, didLoad, rawSnapshot = runProtectedWithTimeout(
		PROFILE_FALLBACK_DATASTORE_TIMEOUT_SECONDS,
		function()
			return rawDataStore:GetAsync(profileKey)
		end
	)
	if completionStatus == "timed_out" then
		return false, nil, "default", "fallback_timeout"
	end
	if not didLoad then
		return false, nil, "default", "fallback_error:" .. tostring(rawSnapshot)
	end

	return true,
		self:resolvePersistedDataSnapshot(rawSnapshot),
		if rawSnapshot == nil then "default" else "datastore",
		if rawSnapshot == nil then "fallback_default_data" else "fallback_datastore"
end

function PlayerDataServiceServer.StartProfileLoad(self: PlayerDataServiceServer, player: Player, runtime: PlayerRuntime)
	local currentLoadToken = runtime.loadToken
	if runtime.loadPromise ~= nil then
		return
	end

	runtime.loadPromise = self:loadProfilePromise(player, currentLoadToken):Finally(function()
		local currentRuntime = self.playerRuntimes[player]
		if currentRuntime ~= nil and currentRuntime.loadToken == currentLoadToken then
			currentRuntime.loadPromise = nil
		end
	end)
end

function PlayerDataServiceServer.FinalizeLoadedRuntime(
	self: PlayerDataServiceServer,
	player: Player,
	runtime: PlayerRuntime,
	loadToken: number,
	dataRaw: any,
	sourceRaw: any,
	reasonRaw: any,
	profileRaw: Profile?
): boolean
	local currentRuntime = self.playerRuntimes[player]
	if currentRuntime == nil or currentRuntime ~= runtime or runtime.loadToken ~= loadToken then
		local profile = profileRaw
		if profile ~= nil and profile:IsActive() then
			profile:EndSession()
		end
		return false
	end

	local resolvedData = self:resolvePersistedDataSnapshot(dataRaw)
	self:disconnectProfileEndedConnection(runtime)
	runtime.profile = profileRaw
	runtime.data = resolvedData
	runtime.loadState = PlayerDataServiceUtils.LOAD_STATE_LOADED
	runtime.isLoading = false
	runtime.hasResolvedInitialLoad = true
	runtime.lastFailureReason = nil
	runtime.usingFallbackData = runtime.profile == nil
	runtime.fallbackBaselineData = if runtime.usingFallbackData
		then PlayerDataServiceUtils.cloneDeep(resolvedData)
		else nil
	runtime.fallbackDirty = false
	if runtime.profile ~= nil then
		local activeProfile = runtime.profile :: Profile
		runtime.profileEndedConnection = activeProfile.OnSessionEnd:Connect(function()
			self:onProfileSessionEnded(player, activeProfile)
		end)
	end
	self:pushState(player)
	self:logEvent("load_success", player, runtime, {
		source = sourceRaw,
		reason = reasonRaw,
	})
	return true
end

function PlayerDataServiceServer.FinalizeFailedRuntime(
	self: PlayerDataServiceServer,
	player: Player,
	runtime: PlayerRuntime,
	loadToken: number,
	reasonRaw: any
): boolean
	local currentRuntime = self.playerRuntimes[player]
	if currentRuntime == nil or currentRuntime ~= runtime or runtime.loadToken ~= loadToken then
		return false
	end

	self:disconnectProfileEndedConnection(runtime)
	runtime.profile = nil
	runtime.data = PlayerDataServiceUtils.createDefaultData(self.dataTemplate)
	runtime.loadState = PlayerDataServiceUtils.LOAD_STATE_FAILED
	runtime.isLoading = false
	runtime.hasResolvedInitialLoad = true
	runtime.lastFailureReason = sanitizeFailureReason(reasonRaw) or "unknown"
	runtime.usingFallbackData = false
	runtime.fallbackBaselineData = nil
	runtime.fallbackDirty = false
	self:pushState(player)
	self:logEvent("load_failed_terminal", player, runtime, {
		reason = runtime.lastFailureReason,
	})
	return true
end

function PlayerDataServiceServer.OnProfileSessionEnded(self: PlayerDataServiceServer, player: Player, profile: Profile)
	local runtime = self.playerRuntimes[player]
	if runtime == nil then
		return
	end
	if runtime.profile ~= profile then
		return
	end

	self:disconnectProfileEndedConnection(runtime)
	runtime.profile = nil
	runtime.data = PlayerDataServiceUtils.createDefaultData(self.dataTemplate)
	runtime.loadState = PlayerDataServiceUtils.LOAD_STATE_FAILED
	runtime.isLoading = false
	runtime.hasResolvedInitialLoad = true
	runtime.lastFailureReason = "session_ended"
	runtime.usingFallbackData = false
	runtime.fallbackBaselineData = nil
	runtime.fallbackDirty = false
	self:pushState(player)

	if player.Parent == Players and not ProfileStore.IsClosing then
		player:Kick(DATA_SESSION_ENDED_KICK_MESSAGE)
	end
end

function PlayerDataServiceServer.LoadProfilePromise(self: PlayerDataServiceServer, player: Player, loadToken: number)
	return promiseTry(function()
		local runtime = self.playerRuntimes[player]
		if runtime == nil or runtime.loadToken ~= loadToken then
			return nil
		end
		self:logEvent("load_begin", player, runtime, nil)

		local profileKey = PlayerDataServiceUtils.getProfileKey(player)
		if profileKey == nil then
			self:finalizeFailedRuntime(player, runtime, loadToken, "profile_key_invalid")
			return nil
		end

		local loadDeadline = os.clock() + PROFILE_SESSION_START_TIMEOUT_SECONDS
		local profile: Profile? = nil
		local success, resultOrError = pcall(function()
			return self.profileStore:StartSessionAsync(profileKey, {
				Cancel = function()
					local currentRuntime = self.playerRuntimes[player]
					if currentRuntime == nil then
						return true
					end
					if currentRuntime.loadToken ~= loadToken then
						return true
					end
					if player.Parent ~= Players then
						return true
					end
					return os.clock() >= loadDeadline
				end,
			})
		end)
		if success then
			profile = resultOrError :: Profile?
		end

		runtime = self.playerRuntimes[player]
		if runtime == nil or runtime.loadToken ~= loadToken then
			if profile and profile:IsActive() then
				profile:EndSession()
			end
			return nil
		end

		if profile == nil then
			local primaryFailureReason = if success
				then if os.clock() >= loadDeadline then "profile_timeout" else "profile_session_unavailable"
				else "profile_error:" .. tostring(resultOrError)
			local fallbackSuccess, fallbackData, fallbackSource, fallbackReason = self:resolveFallbackLoadResult(player)
			runtime = self.playerRuntimes[player]
			if runtime == nil or runtime.loadToken ~= loadToken then
				return nil
			end
			if fallbackSuccess and fallbackData ~= nil then
				self:finalizeLoadedRuntime(
					player,
					runtime,
					loadToken,
					fallbackData,
					fallbackSource,
					primaryFailureReason .. "|" .. fallbackReason,
					nil
				)
				return fallbackData
			end
			self:finalizeFailedRuntime(player, runtime, loadToken, primaryFailureReason .. "|" .. fallbackReason)
			return nil
		end

		profile:AddUserId(player.UserId)
		profile:Reconcile()

		local profileData = profile.Data
		if typeof(profileData) ~= "table" then
			profileData = PlayerDataServiceUtils.createDefaultData(self.dataTemplate)
			profile.Data = profileData
		end
		PlayerDataServiceUtils.reconcileData(profileData, self.dataTemplate)
		self:finalizeLoadedRuntime(player, runtime, loadToken, profileData, "profile", "profile_loaded", profile)
		return profileData
	end):Catch(function(err: any)
		local runtime = self.playerRuntimes[player]
		if runtime ~= nil and runtime.loadToken == loadToken then
			self:finalizeFailedRuntime(player, runtime, loadToken, "unexpected_error:" .. tostring(err))
		end
		return nil
	end)
end

function PlayerDataServiceServer.TrackPlayer(self: PlayerDataServiceServer, player: Player)
	local runtime = self:getRuntime(player)
	if runtime.isLoading or runtime.hasResolvedInitialLoad then
		self:pushState(player)
		return
	end
	runtime.loadToken += 1
	self:releaseProfile(runtime)
	runtime.data = nil
	runtime.loadState = PlayerDataServiceUtils.LOAD_STATE_LOADING
	runtime.isLoading = true
	runtime.hasResolvedInitialLoad = false
	runtime.lastFailureReason = nil
	runtime.loadStartedAt = os.clock()
	runtime.usingFallbackData = false
	runtime.fallbackBaselineData = nil
	runtime.fallbackDirty = false
	self:logEvent("trackPlayer_start", player, runtime, nil)
	self:pushState(player)
	self:startProfileLoad(player, runtime)
end

function PlayerDataServiceServer.UntrackPlayer(self: PlayerDataServiceServer, player: Player)
	local runtime = self.playerRuntimes[player]
	if runtime == nil then
		return
	end

	runtime.loadToken += 1
	if runtime.loadPromise ~= nil then
		runtime.loadPromise:Destroy()
		runtime.loadPromise = nil
	end
	runtime.loadState = PlayerDataServiceUtils.LOAD_STATE_UNLOADED
	runtime.isLoading = false
	runtime.hasResolvedInitialLoad = false
	runtime.lastFailureReason = nil
	runtime.loadStartedAt = 0
	self:emitRuntimeStateChanged(runtime)
	self.playerRuntimes[player] = nil
	self:releaseProfile(runtime)
	runtime.stateChangedSignal:Destroy()
end

function PlayerDataServiceServer.GetActiveRuntime(self: PlayerDataServiceServer, player: Player): PlayerRuntime?
	local runtime = self:getResolvedRuntime(player)
	if runtime == nil then
		return nil
	end
	local profile = runtime.profile
	if profile == nil or not profile:IsActive() then
		return nil
	end

	return runtime
end

function PlayerDataServiceServer.RequestSync(self: PlayerDataServiceServer, player: Player)
	local runtime = self.playerRuntimes[player]
	if runtime == nil then
		self:trackPlayer(player)
		return
	end

	self:pushState(player)
end

function PlayerDataServiceServer.GetLoadState(self: PlayerDataServiceServer, player: Player): LoadState
	local runtime = self.playerRuntimes[player]
	if runtime == nil then
		return PlayerDataServiceUtils.LOAD_STATE_UNLOADED
	end
	return runtime.loadState
end

function PlayerDataServiceServer.IsLoaded(self: PlayerDataServiceServer, player: Player): boolean
	return self:getResolvedRuntime(player) ~= nil
end

function PlayerDataServiceServer.WaitForData(
	self: PlayerDataServiceServer,
	player: Player,
	timeoutSecondsRaw: any
): PlayerData?
	local success, result = self:waitForDataPromise(player, timeoutSecondsRaw):Yield()
	if not success then
		return nil
	end
	return result :: PlayerData?
end

function PlayerDataServiceServer.WaitForDataPromise(
	self: PlayerDataServiceServer,
	player: Player,
	timeoutSecondsRaw: any
)
	local timeoutSeconds = if typeof(timeoutSecondsRaw) == "number" and timeoutSecondsRaw == timeoutSecondsRaw
		then math.max(0, timeoutSecondsRaw)
		else 15

	local function resolveIfReady(): PlayerData?
		local availableRuntime = self:getAvailableRuntime(player)
		if availableRuntime ~= nil and availableRuntime.data ~= nil then
			return availableRuntime.data
		end
		return nil
	end

	local immediateData = resolveIfReady()
	if immediateData ~= nil then
		return Promise.resolved(immediateData)
	end

	local trackedRuntime = self.playerRuntimes[player]
	if trackedRuntime == nil then
		return Promise.resolved(nil)
	end
	if trackedRuntime.hasResolvedInitialLoad then
		return Promise.resolved(resolveIfReady())
	end

	if timeoutSeconds <= 0 then
		return Promise.resolved(nil)
	end

	return Promise.new(function(resolve, _reject)
		local connection = nil
		local settled = false

		local function cleanup()
			if connection ~= nil then
				connection:Disconnect()
				connection = nil
			end
		end

		local function settle(result: PlayerData?)
			if settled then
				return
			end
			settled = true
			cleanup()
			resolve(result)
		end

		connection = trackedRuntime.stateChangedSignal:Connect(function()
			local currentRuntime = self.playerRuntimes[player]
			if currentRuntime == nil or currentRuntime.hasResolvedInitialLoad or resolveIfReady() ~= nil then
				settle(resolveIfReady())
			end
		end)

		local readyData = resolveIfReady()
		if readyData ~= nil or trackedRuntime.hasResolvedInitialLoad then
			settle(readyData)
			return
		end

		task.delay(timeoutSeconds, function()
			settle(nil)
		end)
	end)
end

function PlayerDataServiceServer.GetProfile(self: PlayerDataServiceServer, player: Player): Profile?
	local runtime = self:getActiveRuntime(player)
	if runtime == nil then
		return nil
	end
	return runtime.profile
end

function PlayerDataServiceServer.GetData(self: PlayerDataServiceServer, player: Player): PlayerData?
	local runtime = self:getAvailableRuntime(player)
	if runtime == nil then
		return nil
	end
	return runtime.data
end

function PlayerDataServiceServer.GetDataCopy(self: PlayerDataServiceServer, player: Player): PlayerData?
	local data = self:getData(player)
	if data == nil then
		return nil
	end
	return PlayerDataServiceUtils.cloneDeep(data)
end

function PlayerDataServiceServer.GetValue(
	self: PlayerDataServiceServer,
	player: Player,
	pathRaw: any,
	fallback: any
): any
	local data = self:getData(player)
	if data == nil then
		return fallback
	end
	return PlayerDataServiceUtils.getValueAtPath(data, pathRaw, fallback)
end

function PlayerDataServiceServer.GetHpData(self: PlayerDataServiceServer, player: Player, fallback: any): any
	return self:getValue(player, PlayerDataServiceUtils.getDefaultHpDataPath(), fallback)
end

function PlayerDataServiceServer.GetCoinsData(self: PlayerDataServiceServer, player: Player, fallback: any): any
	return self:getValue(player, PlayerDataServiceUtils.getDefaultCoinsDataPath(), fallback)
end

function PlayerDataServiceServer.SetValue(
	self: PlayerDataServiceServer,
	player: Player,
	pathRaw: any,
	value: any,
	replicateToClientRaw: any
): boolean
	local runtime = self:getResolvedRuntime(player)
	if runtime == nil or runtime.data == nil then
		return false
	end

	local didSet = PlayerDataServiceUtils.setValueAtPath(runtime.data, pathRaw, value)
	if didSet and runtime.usingFallbackData then
		runtime.fallbackDirty = true
	end
	if didSet and replicateToClientRaw ~= false then
		self:pushState(player)
	end
	return didSet
end

function PlayerDataServiceServer.SetHpData(
	self: PlayerDataServiceServer,
	player: Player,
	hpDataRaw: any,
	replicateToClientRaw: any
): boolean
	return self:setValue(player, PlayerDataServiceUtils.getDefaultHpDataPath(), hpDataRaw, replicateToClientRaw)
end

function PlayerDataServiceServer.SetCoinsData(
	self: PlayerDataServiceServer,
	player: Player,
	coinsDataRaw: any,
	replicateToClientRaw: any
): boolean
	return self:setValue(player, PlayerDataServiceUtils.getDefaultCoinsDataPath(), coinsDataRaw, replicateToClientRaw)
end

function PlayerDataServiceServer.RemoveValue(
	self: PlayerDataServiceServer,
	player: Player,
	pathRaw: any,
	replicateToClientRaw: any
): boolean
	local runtime = self:getResolvedRuntime(player)
	if runtime == nil or runtime.data == nil then
		return false
	end

	local didRemove = PlayerDataServiceUtils.removeValueAtPath(runtime.data, pathRaw)
	if didRemove and runtime.usingFallbackData then
		runtime.fallbackDirty = true
	end
	if didRemove and replicateToClientRaw ~= false then
		self:pushState(player)
	end
	return didRemove
end

function PlayerDataServiceServer.IncrementValue(
	self: PlayerDataServiceServer,
	player: Player,
	pathRaw: any,
	amountRaw: any,
	fallbackValueRaw: any,
	replicateToClientRaw: any
): number?
	local runtime = self:getResolvedRuntime(player)
	if runtime == nil or runtime.data == nil then
		return nil
	end

	local nextValue = PlayerDataServiceUtils.incrementValueAtPath(runtime.data, pathRaw, amountRaw, fallbackValueRaw)
	if nextValue ~= nil and runtime.usingFallbackData then
		runtime.fallbackDirty = true
	end
	if nextValue ~= nil and replicateToClientRaw ~= false then
		self:pushState(player)
	end
	return nextValue
end

function PlayerDataServiceServer.MergeData(
	self: PlayerDataServiceServer,
	player: Player,
	incomingDataRaw: any,
	replicateToClientRaw: any
): boolean
	local runtime = self:getResolvedRuntime(player)
	if runtime == nil or runtime.data == nil then
		return false
	end

	local didMerge = PlayerDataServiceUtils.mergeData(runtime.data, incomingDataRaw)
	if didMerge and runtime.usingFallbackData then
		runtime.fallbackDirty = true
	end
	if didMerge and replicateToClientRaw ~= false then
		self:pushState(player)
	end
	return didMerge
end

function PlayerDataServiceServer.SavePlayerData(self: PlayerDataServiceServer, player: Player): boolean
	local success, result = self:savePlayerDataPromise(player):Yield()
	if not success then
		return false
	end
	return result == true
end

function PlayerDataServiceServer.SavePlayerDataPromise(self: PlayerDataServiceServer, player: Player)
	return promiseTry(function()
		local runtime = self:getActiveRuntime(player)
		if runtime == nil then
			return false
		end

		local profile = runtime.profile
		if profile == nil or not profile:IsActive() then
			return false
		end

		local success, resultOrError = pcall(function()
			profile:Save()
		end)
		if not success then
			return false
		end

		return true
	end)
end

function PlayerDataServiceServer.SaveAllPlayerData(self: PlayerDataServiceServer)
	for player in self.playerRuntimes do
		self:savePlayerData(player)
	end
end

function PlayerDataServiceServer.Destroy(self: PlayerDataServiceServer)
	if self.playerAddedConnection then
		self.playerAddedConnection:Disconnect()
		self.playerAddedConnection = nil
	end

	if self.playerRemovingConnection then
		self.playerRemovingConnection:Disconnect()
		self.playerRemovingConnection = nil
	end

	for player, runtime in self.playerRuntimes do
		self.playerRuntimes[player] = nil
		runtime.loadToken += 1
		if runtime.loadPromise ~= nil then
			runtime.loadPromise:Destroy()
			runtime.loadPromise = nil
		end
		runtime.loadState = PlayerDataServiceUtils.LOAD_STATE_UNLOADED
		self:emitRuntimeStateChanged(runtime)
		self:releaseProfile(runtime)
		runtime.stateChangedSignal:Destroy()
	end

	if self.networker then
		self.networker:destroy()
	end
end

PlayerDataServiceServer.init = PlayerDataServiceServer.Init
PlayerDataServiceServer.createRuntime = PlayerDataServiceServer.CreateRuntime
PlayerDataServiceServer.getRuntime = PlayerDataServiceServer.GetRuntime
PlayerDataServiceServer.getRuntimeLoadElapsedSeconds = PlayerDataServiceServer.GetRuntimeLoadElapsedSeconds
PlayerDataServiceServer.getRuntimeStateMetadata = PlayerDataServiceServer.GetRuntimeStateMetadata
PlayerDataServiceServer.logEvent = PlayerDataServiceServer.LogEvent
PlayerDataServiceServer.disconnectProfileEndedConnection = PlayerDataServiceServer.DisconnectProfileEndedConnection
PlayerDataServiceServer.releaseProfile = PlayerDataServiceServer.ReleaseProfile
PlayerDataServiceServer.emitRuntimeStateChanged = PlayerDataServiceServer.EmitRuntimeStateChanged
PlayerDataServiceServer.pushState = PlayerDataServiceServer.PushState
PlayerDataServiceServer.getResolvedRuntime = PlayerDataServiceServer.GetResolvedRuntime
PlayerDataServiceServer.getAvailableRuntime = PlayerDataServiceServer.GetAvailableRuntime
PlayerDataServiceServer.resolvePersistedDataSnapshot = PlayerDataServiceServer.ResolvePersistedDataSnapshot
PlayerDataServiceServer.resolveFallbackLoadResult = PlayerDataServiceServer.ResolveFallbackLoadResult
PlayerDataServiceServer.startProfileLoad = PlayerDataServiceServer.StartProfileLoad
PlayerDataServiceServer.finalizeLoadedRuntime = PlayerDataServiceServer.FinalizeLoadedRuntime
PlayerDataServiceServer.finalizeFailedRuntime = PlayerDataServiceServer.FinalizeFailedRuntime
PlayerDataServiceServer.onProfileSessionEnded = PlayerDataServiceServer.OnProfileSessionEnded
PlayerDataServiceServer.loadProfilePromise = PlayerDataServiceServer.LoadProfilePromise
PlayerDataServiceServer.trackPlayer = PlayerDataServiceServer.TrackPlayer
PlayerDataServiceServer.untrackPlayer = PlayerDataServiceServer.UntrackPlayer
PlayerDataServiceServer.getActiveRuntime = PlayerDataServiceServer.GetActiveRuntime
PlayerDataServiceServer.requestSync = PlayerDataServiceServer.RequestSync
PlayerDataServiceServer.getLoadState = PlayerDataServiceServer.GetLoadState
PlayerDataServiceServer.isLoaded = PlayerDataServiceServer.IsLoaded
PlayerDataServiceServer.waitForData = PlayerDataServiceServer.WaitForData
PlayerDataServiceServer.waitForDataPromise = PlayerDataServiceServer.WaitForDataPromise
PlayerDataServiceServer.getProfile = PlayerDataServiceServer.GetProfile
PlayerDataServiceServer.getData = PlayerDataServiceServer.GetData
PlayerDataServiceServer.getDataCopy = PlayerDataServiceServer.GetDataCopy
PlayerDataServiceServer.getValue = PlayerDataServiceServer.GetValue
PlayerDataServiceServer.getHpData = PlayerDataServiceServer.GetHpData
PlayerDataServiceServer.getCoinsData = PlayerDataServiceServer.GetCoinsData
PlayerDataServiceServer.setValue = PlayerDataServiceServer.SetValue
PlayerDataServiceServer.setHpData = PlayerDataServiceServer.SetHpData
PlayerDataServiceServer.setCoinsData = PlayerDataServiceServer.SetCoinsData
PlayerDataServiceServer.removeValue = PlayerDataServiceServer.RemoveValue
PlayerDataServiceServer.incrementValue = PlayerDataServiceServer.IncrementValue
PlayerDataServiceServer.mergeData = PlayerDataServiceServer.MergeData
PlayerDataServiceServer.savePlayerData = PlayerDataServiceServer.SavePlayerData
PlayerDataServiceServer.savePlayerDataPromise = PlayerDataServiceServer.SavePlayerDataPromise
PlayerDataServiceServer.saveAllPlayerData = PlayerDataServiceServer.SaveAllPlayerData
PlayerDataServiceServer.destroy = PlayerDataServiceServer.Destroy

type PlayerDataServiceServer = typeof(PlayerDataServiceServer) & {
	networker: Networker.Server,
	profileStore: ProfileStoreObject,
	dataTemplate: PlayerData,
	playerRuntimes: { [Player]: PlayerRuntime },
	playerAddedConnection: RBXScriptConnection?,
	playerRemovingConnection: RBXScriptConnection?,
}

return PlayerDataServiceServer :: PlayerDataServiceServer
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="1061">
              <Properties>
                <string name="Name">PlayerServiceServer</string>
                <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local DataTemplate = require(script:FindFirstAncestor("game").Shared.Modules.Core.DataTemplate)
local GoreServiceServer = require(script:FindFirstAncestor("game").Server.Services.GoreServiceServer)
local Janitor = require(ReplicatedStorage.Packages.Janitor)
local Networker = require(script:FindFirstAncestor("game").Shared.Modules.Networking.Networker)
local NevermoreSupport = require(script:FindFirstAncestor("game").Shared.Modules.Core.NevermoreSupport)
local PlayerServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.PlayerServiceUtils)
local PlayerSpawnCooldown = require(script:FindFirstAncestor("game").Shared.Modules.Game.Player.PlayerSpawnCooldown)
local ServerBinderSupport = require(script:FindFirstAncestor("game").Server.Binders.ServerBinderSupport)
local TagBinder = require(script:FindFirstAncestor("game").Shared.Binders.TagBinder)

type FacingSign = PlayerServiceUtils.FacingSign
type InvincibilityFramesConfig = PlayerServiceUtils.InvincibilityFramesConfig

type PlayerState = {
	facingSign: FacingSign,
	nextSpawnHealth: number?,
	movementLocked: boolean,
	spawnWorldPosition: Vector3?,
}

type JanitorClass = {
	GiveChore: (self: JanitorClass, chore: any, ...any) -> (),
	Clean: (self: JanitorClass) -> (),
	Destroy: (self: JanitorClass) -> (),
}

type PlayerRuntime = {
	playerJanitor: JanitorClass,
	characterJanitor: JanitorClass,
	humanoid: Humanoid?,
	effectsJunkFolder: Folder?,
	invulnerableUntil: number,
	lastKnownHealth: number?,
	lastDamageFeedbackAt: number,
	isRestoringHealth: boolean,
	highlightToken: number,
	damageHighlight: Highlight?,
	movementLockAnchoredRoot: BasePart?,
	deathFeedbackLocked: boolean,
}

type GoreServiceServerObject = {
	registerPlayerCharacter: (self: GoreServiceServerObject, playerRaw: any, characterRaw: any) -> boolean,
	unregisterPlayer: (self: GoreServiceServerObject, playerRaw: any) -> boolean,
	onPlayerDamaged: (self: GoreServiceServerObject, playerRaw: any, originRaw: any, damageRaw: any?) -> boolean,
	onPlayerDied: (self: GoreServiceServerObject, playerRaw: any, originRaw: any) -> boolean,
}

type RagdollServiceServerObject = {
	setPlayerRagdoll: (
		self: RagdollServiceServerObject,
		player: Player,
		enabledRaw: any,
		reasonRaw: any,
		durationRaw: any,
		canRecoverRaw: any,
		impulseRaw: any
	) -> boolean,
}

local PlayerServiceServer = {}
local DAMAGE_HIGHLIGHT_NAME = "InvincibilityFramesHighlight"
local HP_SUPPRESS_DAMAGE_FEEDBACK_ATTRIBUTE = "HpService_SuppressDamageFeedback"
local WORLD_SURFACE_SNAP_MAX_WAIT_SECONDS = 20
local WORLD_SURFACE_SNAP_RETRY_INTERVAL_SECONDS = 0.06
local WORLD_SURFACE_SNAP_RAYCAST_HEIGHT = 2048
local WORLD_SURFACE_SNAP_RAYCAST_DEPTH = WORLD_SURFACE_SNAP_RAYCAST_HEIGHT * 2
local WORLD_SURFACE_MIN_NORMAL_Y = 0.5
local DAMAGE_FEEDBACK_MIN_INTERVAL = 0.12
local LOADING_SCREEN_READY_REMOTE_NAME = "AquariaLoadingScreenReady"

local function resolveInvincibilityFramesConfigFromTemplate(): InvincibilityFramesConfig
	local template = if typeof(DataTemplate) == "table" then DataTemplate else {}
	local playerData = if typeof((template :: any).playerData) == "table" then (template :: any).playerData else {}
	return PlayerServiceUtils.sanitizeInvincibilityFramesConfig((playerData :: any).invincibilityFrames)
end

local function resolveAllowMovementFreezeFromTemplate(): boolean
	local template = if typeof(DataTemplate) == "table" then DataTemplate else {}
	local playerData = if typeof((template :: any).playerData) == "table" then (template :: any).playerData else {}
	local allowMovementFreeze = (playerData :: any).allowMovementFreeze
	if typeof(allowMovementFreeze) == "boolean" then
		return allowMovementFreeze
	end
	return true
end

local function ensureRemoteEvent(parent: Instance, name: string): RemoteEvent
	local existing = parent:FindFirstChild(name)
	if existing ~= nil then
		if existing:IsA("RemoteEvent") then
			return existing
		end
		existing:Destroy()
	end

	local remote = Instance.new("RemoteEvent")
	remote.Name = name
	remote.Parent = parent
	return remote
end

function PlayerServiceServer.EmitPlayerGore(
	self: PlayerServiceServer,
	player: Player,
	humanoid: Humanoid,
	isDeathRaw: any,
	damageRaw: any?
)
	local goreService = self.goreService
	if goreService == nil then
		return
	end

	local character = humanoid.Parent
	if not character or not character:IsA("Model") then
		return
	end

	local rig = PlayerServiceUtils.resolveCharacterRig(character)
	local originPart = if rig then rig.rootPart else nil
	if isDeathRaw == true then
		goreService:onPlayerDied(player, originPart)
	else
		goreService:onPlayerDamaged(player, originPart, damageRaw)
	end
end

function PlayerServiceServer.FireDamageFeedback(self: PlayerServiceServer, player: Player, damageAmountRaw: any)
	local runtime = self:getRuntime(player)
	local damageAmount = if typeof(damageAmountRaw) == "number" and damageAmountRaw == damageAmountRaw
		then math.max(0, damageAmountRaw)
		else 0
	if damageAmount <= 0 then
		return
	end

	local now = os.clock()
	if now - runtime.lastDamageFeedbackAt < DAMAGE_FEEDBACK_MIN_INTERVAL then
		return
	end

	runtime.lastDamageFeedbackAt = now
	self.networker:fire(player, "onDamaged", damageAmount)
end

function PlayerServiceServer.Init(self: PlayerServiceServer)
	self.playerState = {}
	self.playerRuntimes = {}
	self.activeGameplayPlayers = {}
	self.loadingScreenReadyPlayers = {}
	self.invincibilityFramesConfig = resolveInvincibilityFramesConfigFromTemplate()
	self.allowMovementFreeze = resolveAllowMovementFreezeFromTemplate()
	Players.CharacterAutoLoads = false
	PlayerServiceUtils.getOrCreateWorkspaceGameFolder()
	PlayerSpawnCooldown.applyConfiguredRespawnDelay()
	self.goreService = GoreServiceServer :: GoreServiceServerObject
	self.ragdollService =
		require(script:FindFirstAncestor("game").Server.Services.RagdollServiceServer) :: RagdollServiceServerObject
	self.networker = Networker.server.new("PlayerService", self, {
		self.SetFacing,
		self.RequestState,
		self.SetWorldReadyForMovement,
	})
	self.loadingScreenReadyRemote = ensureRemoteEvent(ReplicatedStorage, LOADING_SCREEN_READY_REMOTE_NAME)
	self.loadingScreenReadyConnection = self.loadingScreenReadyRemote.OnServerEvent:Connect(function(player, statusRaw)
		self:onLoadingScreenReady(player, statusRaw)
	end)
	self.binders = NevermoreSupport.getService(ServerBinderSupport)

	for _, player in Players:GetPlayers() do
		self:trackPlayer(player)
	end

	self.playerAddedConnection = Players.PlayerAdded:Connect(function(player)
		self:trackPlayer(player)
	end)

	self.playerRemovingConnection = Players.PlayerRemoving:Connect(function(player)
		self:untrackPlayer(player)
	end)
end

function PlayerServiceServer.IsGameplayActiveForPlayer(self: PlayerServiceServer, player: Player): boolean
	return self.activeGameplayPlayers[player] == true
end

function PlayerServiceServer.OnLoadingScreenReady(self: PlayerServiceServer, player: Player, statusRaw: any): boolean
	if player.Parent ~= Players then
		return false
	end
	if self.loadingScreenReadyPlayers[player] == true then
		return true
	end

	local status = if typeof(statusRaw) == "string" then statusRaw else ""
	if status ~= "complete" and status ~= "failed" then
		return false
	end

	self.loadingScreenReadyPlayers[player] = true
	return self:enterGameplay(player)
end

function PlayerServiceServer.EnterGameplay(self: PlayerServiceServer, player: Player): boolean
	self.activeGameplayPlayers[player] = true
	self:setMovementLocked(player, true, true, true)

	local character = player.Character
	if character ~= nil then
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if humanoid ~= nil and humanoid.Health > 0 then
			self:applyGameplaySpawnToCharacter(player, character)
			if self:trySnapCharacterToWorldSurface(player, character, humanoid) then
				self:setMovementLocked(player, false, true)
			else
				self:queueSpawnSurfaceSnap(player, character, humanoid)
			end
			return true
		end
	end

	player:LoadCharacter()
	return true
end

function PlayerServiceServer.CreateRuntime(_self: PlayerServiceServer): PlayerRuntime
	return {
		playerJanitor = Janitor.new(),
		characterJanitor = Janitor.new(),
		humanoid = nil,
		effectsJunkFolder = nil,
		invulnerableUntil = 0,
		lastKnownHealth = nil,
		lastDamageFeedbackAt = -math.huge,
		isRestoringHealth = false,
		highlightToken = 0,
		damageHighlight = nil,
		movementLockAnchoredRoot = nil,
		deathFeedbackLocked = false,
	}
end

function PlayerServiceServer.GetRuntime(self: PlayerServiceServer, player: Player): PlayerRuntime
	local runtime = self.playerRuntimes[player]
	if runtime then
		return runtime
	end

	local nextRuntime = self:createRuntime()
	self.playerRuntimes[player] = nextRuntime
	return nextRuntime
end

function PlayerServiceServer.StopInvincibilityFrames(_self: PlayerServiceServer, runtime: PlayerRuntime)
	runtime.invulnerableUntil = 0
	runtime.highlightToken += 1
	if runtime.damageHighlight then
		runtime.damageHighlight.Enabled = false
	end
end

function PlayerServiceServer.ApplyMovementLockToRuntime(
	_self: PlayerServiceServer,
	runtime: PlayerRuntime,
	player: Player,
	movementLocked: boolean
)
	local character = player.Character
	local rootPart = PlayerServiceUtils.resolveCharacterRootPart(character)
	if rootPart == nil then
		runtime.movementLockAnchoredRoot = nil
		return
	end

	if movementLocked then
		if
			runtime.movementLockAnchoredRoot
			and runtime.movementLockAnchoredRoot ~= rootPart
			and runtime.movementLockAnchoredRoot.Parent ~= nil
		then
			runtime.movementLockAnchoredRoot.Anchored = false
		end
		if not rootPart.Anchored then
			runtime.movementLockAnchoredRoot = rootPart
			rootPart.Anchored = true
		end
		rootPart.AssemblyLinearVelocity = Vector3.zero
		rootPart.AssemblyAngularVelocity = Vector3.zero
		if runtime.humanoid then
			runtime.humanoid:Move(Vector3.zero, false)
		end
	else
		if runtime.movementLockAnchoredRoot == rootPart and rootPart.Parent ~= nil then
			rootPart.Anchored = false
		end
		runtime.movementLockAnchoredRoot = nil
	end
end

function PlayerServiceServer.SetMovementLocked(
	self: PlayerServiceServer,
	player: Player,
	movementLocked: boolean,
	replicateToClient: boolean?,
	forceLock: boolean?
)
	if movementLocked and not self.allowMovementFreeze and forceLock ~= true then
		movementLocked = false
	end

	local state = self:getState(player)
	state.movementLocked = movementLocked
	player:SetAttribute(PlayerServiceUtils.DEFAULT_MOVEMENT_LOCK_ATTRIBUTE, movementLocked)

	local runtime = self:getRuntime(player)
	self:applyMovementLockToRuntime(runtime, player, movementLocked)

	if replicateToClient ~= false and self.networker then
		self.networker:fire(player, PlayerServiceUtils.NETWORK_METHOD_APPLY_MOVEMENT_LOCK, movementLocked)
	end
end

function PlayerServiceServer.SetGameplaySpawnPosition(self: PlayerServiceServer, player: Player, worldPositionRaw: any)
	local state = self:getState(player)
	if typeof(worldPositionRaw) == "Vector3" then
		state.spawnWorldPosition = worldPositionRaw
	else
		state.spawnWorldPosition = nil
	end
end

function PlayerServiceServer.ApplyGameplaySpawnToCharacter(
	self: PlayerServiceServer,
	player: Player,
	character: Model
): boolean
	local state = self:getState(player)
	local spawnWorldPosition = state.spawnWorldPosition
	if typeof(spawnWorldPosition) ~= "Vector3" then
		return false
	end

	local rootPart = PlayerServiceUtils.resolveCharacterRootPart(character)
	if rootPart == nil then
		return false
	end

	local rootToPivot = CFrame.identity
	local pivotOk, currentPivot = pcall(function(): CFrame
		return character:GetPivot()
	end)
	if pivotOk then
		rootToPivot = rootPart.CFrame:ToObjectSpace(currentPivot :: CFrame)
	end

	local targetRootCFrame =
		CFrame.lookAt(spawnWorldPosition, spawnWorldPosition + Vector3.new(0, 0, -state.facingSign), Vector3.yAxis)
	local pivotTarget = targetRootCFrame * rootToPivot
	local pivotApplied = pcall(function()
		character:PivotTo(pivotTarget)
	end)
	if not pivotApplied then
		rootPart.CFrame = targetRootCFrame
	end

	rootPart.AssemblyLinearVelocity = Vector3.zero
	rootPart.AssemblyAngularVelocity = Vector3.zero
	PlayerServiceUtils.snapRootPartFacing(rootPart, state.facingSign)
	return true
end

function PlayerServiceServer.TrySnapCharacterToWorldSurface(
	self: PlayerServiceServer,
	player: Player,
	character: Model,
	humanoid: Humanoid
): boolean
	local rootPart = PlayerServiceUtils.resolveCharacterRootPart(character)
	if rootPart == nil then
		return false
	end

	local raycastParams = RaycastParams.new()
	raycastParams.FilterType = Enum.RaycastFilterType.Exclude
	raycastParams.FilterDescendantsInstances = { character }
	raycastParams.IgnoreWater = false

	local right = rootPart.CFrame.RightVector
	local forward = rootPart.CFrame.LookVector
	local horizontalRight = Vector3.new(right.X, 0, right.Z)
	if horizontalRight.Magnitude <= 1e-4 then
		horizontalRight = Vector3.new(1, 0, 0)
	else
		horizontalRight = horizontalRight.Unit
	end
	local horizontalForward = Vector3.new(forward.X, 0, forward.Z)
	if horizontalForward.Magnitude <= 1e-4 then
		horizontalForward = Vector3.new(0, 0, 1)
	else
		horizontalForward = horizontalForward.Unit
	end

	local footprintRadius = math.max(1.25, math.max(rootPart.Size.X, rootPart.Size.Z) * 0.4)
	local sampleOffsets = {
		Vector3.zero,
		horizontalRight * footprintRadius,
		-horizontalRight * footprintRadius,
		horizontalForward * footprintRadius,
		-horizontalForward * footprintRadius,
	}

	local bestHit: RaycastResult? = nil
	for _, offset in sampleOffsets do
		local origin = rootPart.Position + offset + Vector3.new(0, WORLD_SURFACE_SNAP_RAYCAST_HEIGHT, 0)
		local direction = Vector3.new(0, -WORLD_SURFACE_SNAP_RAYCAST_DEPTH, 0)
		local hit = Workspace:Raycast(origin, direction, raycastParams)
		if hit == nil then
			continue
		end

		local hitPart = hit.Instance
		if not hitPart:IsA("BasePart") then
			continue
		end
		if not PlayerServiceUtils.isSurfaceTerrainPart(hitPart) then
			continue
		end
		if hit.Normal.Y < WORLD_SURFACE_MIN_NORMAL_Y then
			continue
		end

		if bestHit == nil or hit.Position.Y > bestHit.Position.Y then
			bestHit = hit
		end
	end

	if bestHit == nil then
		return false
	end

	local state = self:getState(player)
	local position = rootPart.Position
	local rotation = rootPart.CFrame - position
	local targetY = bestHit.Position.Y + humanoid.HipHeight + rootPart.Size.Y * 0.5
	rootPart.CFrame = CFrame.new(position.X, targetY, position.Z) * rotation
	rootPart.AssemblyLinearVelocity = Vector3.zero
	rootPart.AssemblyAngularVelocity = Vector3.zero
	PlayerServiceUtils.snapRootPartFacing(rootPart, state.facingSign)
	return true
end

function PlayerServiceServer.QueueSpawnSurfaceSnap(
	self: PlayerServiceServer,
	player: Player,
	character: Model,
	humanoid: Humanoid
)
	local runtime = self:getRuntime(player)
	task.spawn(function()
		local deadline = os.clock() + WORLD_SURFACE_SNAP_MAX_WAIT_SECONDS
		while os.clock() < deadline do
			if runtime.humanoid ~= humanoid then
				return
			end
			if character.Parent == nil then
				return
			end
			if not self:getState(player).movementLocked then
				return
			end

			if self:trySnapCharacterToWorldSurface(player, character, humanoid) then
				if self:getState(player).movementLocked then
					self:setMovementLocked(player, false, true)
				end
				return
			end

			task.wait(WORLD_SURFACE_SNAP_RETRY_INTERVAL_SECONDS)
		end
	end)
end

function PlayerServiceServer.GetOrCreateDamageHighlight(
	self: PlayerServiceServer,
	runtime: PlayerRuntime,
	character: Model
): Highlight
	local effectsJunkFolder = runtime.effectsJunkFolder
	if effectsJunkFolder == nil or effectsJunkFolder.Parent ~= character then
		effectsJunkFolder = PlayerServiceUtils.getOrCreateEffectsJunkFolder(character)
		runtime.effectsJunkFolder = effectsJunkFolder
	end

	local existingHighlight = runtime.damageHighlight
	if existingHighlight and existingHighlight.Parent ~= nil then
		existingHighlight.Adornee = character
		existingHighlight.FillColor = Color3.new(1, 1, 1)
		existingHighlight.OutlineColor = Color3.new(1, 1, 1)
		existingHighlight.FillTransparency = self.invincibilityFramesConfig.highlightFillTransparency
		existingHighlight.OutlineTransparency = self.invincibilityFramesConfig.highlightOutlineTransparency
		existingHighlight.Parent = effectsJunkFolder
		return existingHighlight
	end

	local highlight = Instance.new("Highlight")
	highlight.Name = DAMAGE_HIGHLIGHT_NAME
	highlight.Adornee = character
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.FillColor = Color3.new(1, 1, 1)
	highlight.OutlineColor = Color3.new(1, 1, 1)
	highlight.FillTransparency = self.invincibilityFramesConfig.highlightFillTransparency
	highlight.OutlineTransparency = self.invincibilityFramesConfig.highlightOutlineTransparency
	highlight.Enabled = false
	highlight.Parent = effectsJunkFolder
	runtime.damageHighlight = highlight
	runtime.characterJanitor:GiveChore(highlight)
	return highlight
end

function PlayerServiceServer.PlayInvincibilityFlicker(
	self: PlayerServiceServer,
	runtime: PlayerRuntime,
	humanoid: Humanoid
)
	local character = humanoid.Parent
	if not character or not character:IsA("Model") then
		return
	end
	if self.invincibilityFramesConfig.duration <= 0 then
		return
	end

	local highlight = self:getOrCreateDamageHighlight(runtime, character)
	runtime.highlightToken += 1
	local token = runtime.highlightToken
	local flickerInterval = self.invincibilityFramesConfig.flickerInterval

	task.spawn(function()
		local isVisible = true
		while runtime.highlightToken == token do
			if runtime.humanoid ~= humanoid then
				break
			end
			if highlight.Parent == nil then
				break
			end
			if humanoid.Health <= 0 then
				break
			end
			if os.clock() >= runtime.invulnerableUntil then
				break
			end

			highlight.Enabled = isVisible
			isVisible = not isVisible
			task.wait(flickerInterval)
		end

		if runtime.highlightToken == token and highlight.Parent ~= nil then
			highlight.Enabled = false
		end
	end)
end

function PlayerServiceServer.OnHumanoidHealthChanged(
	self: PlayerServiceServer,
	player: Player,
	humanoid: Humanoid,
	nextHealthRaw: number
)
	local runtime = self:getRuntime(player)
	if runtime.humanoid ~= humanoid then
		return
	end

	local maxHealth = math.max(1, humanoid.MaxHealth)
	local nextHealth = math.clamp(
		if typeof(nextHealthRaw) == "number" and nextHealthRaw == nextHealthRaw then nextHealthRaw else humanoid.Health,
		0,
		maxHealth
	)

	if runtime.deathFeedbackLocked then
		runtime.lastKnownHealth = 0
		self:stopInvincibilityFrames(runtime)
		return
	end

	local previousHealthRaw = runtime.lastKnownHealth
	if nextHealth <= 0 then
		local previousHealth = if previousHealthRaw ~= nil then math.clamp(previousHealthRaw, 0, maxHealth) else 0
		local damageAmount = math.max(0, previousHealth - nextHealth)
		runtime.deathFeedbackLocked = true
		runtime.lastKnownHealth = 0
		self:emitPlayerGore(player, humanoid, true, damageAmount)
		self:fireDamageFeedback(player, damageAmount)
		self:stopInvincibilityFrames(runtime)
		return
	end

	if not PlayerServiceUtils.isHumanoidAlive(humanoid) then
		runtime.lastKnownHealth = nextHealth
		self:stopInvincibilityFrames(runtime)
		return
	end

	if previousHealthRaw == nil then
		runtime.lastKnownHealth = nextHealth
		return
	end
	if humanoid:GetAttribute(HP_SUPPRESS_DAMAGE_FEEDBACK_ATTRIBUTE) == true then
		runtime.lastKnownHealth = nextHealth
		return
	end

	local previousHealth = math.clamp(previousHealthRaw, 0, maxHealth)
	if runtime.isRestoringHealth then
		runtime.lastKnownHealth = nextHealth
		return
	end

	if nextHealth >= previousHealth then
		runtime.lastKnownHealth = nextHealth
		return
	end

	if previousHealth <= 0 then
		runtime.lastKnownHealth = nextHealth
		return
	end

	local now = os.clock()
	if now < runtime.invulnerableUntil then
		runtime.isRestoringHealth = true
		humanoid.Health = previousHealth
		runtime.isRestoringHealth = false
		runtime.lastKnownHealth = previousHealth
		return
	end

	runtime.lastKnownHealth = nextHealth
	local appliedDamage = previousHealth - nextHealth
	self:emitPlayerGore(player, humanoid, false, appliedDamage)
	self:fireDamageFeedback(player, appliedDamage)
	runtime.invulnerableUntil = now + self.invincibilityFramesConfig.duration
	self:playInvincibilityFlicker(runtime, humanoid)
end

function PlayerServiceServer.BindHumanoid(self: PlayerServiceServer, player: Player, humanoid: Humanoid)
	local runtime = self:getRuntime(player)
	local state = self:getState(player)
	runtime.humanoid = humanoid
	runtime.invulnerableUntil = 0
	runtime.lastDamageFeedbackAt = -math.huge
	runtime.isRestoringHealth = false
	runtime.deathFeedbackLocked = false

	local pendingHealth = state.nextSpawnHealth
	if pendingHealth ~= nil then
		humanoid.Health = math.clamp(pendingHealth, 0, math.max(1, humanoid.MaxHealth))
		state.nextSpawnHealth = nil
	end
	runtime.lastKnownHealth = math.clamp(humanoid.Health, 0, math.max(1, humanoid.MaxHealth))
	PlayerServiceUtils.applyCharacterSettings(humanoid)
	local character = humanoid.Parent
	if character and character:IsA("Model") then
		if self.goreService ~= nil then
			self.goreService:registerPlayerCharacter(player, character)
		end
		local appliedSpawn = self:applyGameplaySpawnToCharacter(player, character)
		if not appliedSpawn then
			local rig = PlayerServiceUtils.resolveCharacterRig(character)
			if rig then
				PlayerServiceUtils.snapRootPartFacing(rig.rootPart, state.facingSign)
			end
		end
	end
	self:applyMovementLockToRuntime(runtime, player, state.movementLocked)
	if character and character:IsA("Model") then
		if self:trySnapCharacterToWorldSurface(player, character, humanoid) then
			self:setMovementLocked(player, false, true)
		else
			self:queueSpawnSurfaceSnap(player, character, humanoid)
		end
	end

	runtime.characterJanitor:GiveChore(humanoid.HealthChanged:Connect(function(nextHealth: number)
		if runtime.humanoid ~= humanoid then
			return
		end

		self:onHumanoidHealthChanged(player, humanoid, nextHealth)
	end))

	runtime.characterJanitor:GiveChore(humanoid:GetPropertyChangedSignal("MaxHealth"):Connect(function()
		if runtime.humanoid ~= humanoid then
			return
		end

		runtime.lastKnownHealth = math.clamp(humanoid.Health, 0, math.max(1, humanoid.MaxHealth))
	end))

	runtime.characterJanitor:GiveChore(humanoid.Died:Connect(function()
		if runtime.humanoid ~= humanoid then
			return
		end

		runtime.deathFeedbackLocked = true
		self:stopInvincibilityFrames(runtime)
		state.nextSpawnHealth = PlayerServiceUtils.computeRespawnHealthFromDeath(
			humanoid.MaxHealth,
			PlayerServiceUtils.DEFAULT_DEATH_RESPAWN_HEALTH_SCALE
		)
		if self.ragdollService ~= nil then
			pcall(function()
				self.ragdollService:setPlayerRagdoll(player, true, "Death", nil, false, nil)
			end)
		end

		if self:isGameplayActiveForPlayer(player) then
			local respawnDelay = PlayerSpawnCooldown.getCurrentRespawnDelay()
			task.delay(respawnDelay, function()
				if player.Parent == nil then
					return
				end
				if not self:isGameplayActiveForPlayer(player) then
					return
				end
				local currentCharacter = player.Character
				if currentCharacter ~= nil then
					local currentHumanoid = currentCharacter:FindFirstChildOfClass("Humanoid")
					if currentHumanoid ~= nil and currentHumanoid.Health > 0 then
						return
					end
				end
				player:LoadCharacter()
			end)
		end
	end))

	runtime.characterJanitor:GiveChore(humanoid.Destroying:Connect(function()
		if runtime.humanoid == humanoid then
			if self.goreService ~= nil then
				self.goreService:unregisterPlayer(player)
			end
			self:stopInvincibilityFrames(runtime)
			runtime.humanoid = nil
			runtime.lastKnownHealth = nil
			runtime.deathFeedbackLocked = false
		end
	end))
end

function PlayerServiceServer.BindCharacter(self: PlayerServiceServer, player: Player, character: Model)
	local runtime = self:getRuntime(player)
	TagBinder.applyTag(character, TagBinder.Tags.Character)
	if self.goreService ~= nil then
		self.goreService:unregisterPlayer(player)
	end
	self:setMovementLocked(player, true, true, true)
	self:stopInvincibilityFrames(runtime)
	runtime.characterJanitor:Clean()
	runtime.humanoid = nil
	runtime.effectsJunkFolder = PlayerServiceUtils.getOrCreateEffectsJunkFolder(character)
	runtime.lastKnownHealth = nil
	runtime.lastDamageFeedbackAt = -math.huge
	runtime.isRestoringHealth = false
	runtime.damageHighlight = nil
	runtime.deathFeedbackLocked = false

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		self:bindHumanoid(player, humanoid)
	end

	runtime.characterJanitor:GiveChore(character.ChildAdded:Connect(function(child: Instance)
		if runtime.humanoid ~= nil then
			return
		end
		if child:IsA("Humanoid") then
			self:bindHumanoid(player, child)
		end
	end))

	runtime.characterJanitor:GiveChore(character.ChildRemoved:Connect(function(child: Instance)
		if runtime.effectsJunkFolder == child then
			runtime.effectsJunkFolder = nil
		end
		if runtime.humanoid == child then
			self:stopInvincibilityFrames(runtime)
			runtime.humanoid = nil
			runtime.lastKnownHealth = nil
		end
	end))
end

function PlayerServiceServer.TrackPlayer(self: PlayerServiceServer, player: Player)
	local loadingReady = self.loadingScreenReadyPlayers[player] == true
	self.activeGameplayPlayers[player] = loadingReady
	self.playerState[player] = {
		facingSign = PlayerServiceUtils.DEFAULT_FACING_SIGN,
		nextSpawnHealth = nil,
		movementLocked = true,
		spawnWorldPosition = nil,
	}
	player:SetAttribute(PlayerServiceUtils.DEFAULT_MOVEMENT_LOCK_ATTRIBUTE, true)

	local runtime = self:getRuntime(player)
	runtime.playerJanitor:Clean()
	self:stopInvincibilityFrames(runtime)
	runtime.characterJanitor:Clean()
	runtime.humanoid = nil
	runtime.effectsJunkFolder = nil
	runtime.lastKnownHealth = nil
	runtime.lastDamageFeedbackAt = -math.huge
	runtime.isRestoringHealth = false
	runtime.damageHighlight = nil
	runtime.deathFeedbackLocked = false

	runtime.playerJanitor:GiveChore(player.CharacterAdded:Connect(function(character: Model)
		if self.loadingScreenReadyPlayers[player] ~= true then
			character:Destroy()
			return
		end

		self:bindCharacter(player, character)
	end))

	if player.Character and loadingReady then
		self:bindCharacter(player, player.Character)
	elseif player.Character then
		player.Character:Destroy()
	end

	if loadingReady then
		self:enterGameplay(player)
	end
end

function PlayerServiceServer.UntrackPlayer(self: PlayerServiceServer, player: Player)
	self.activeGameplayPlayers[player] = nil
	self.loadingScreenReadyPlayers[player] = nil
	self.playerState[player] = nil
	player:SetAttribute(PlayerServiceUtils.DEFAULT_MOVEMENT_LOCK_ATTRIBUTE, nil)
	if self.goreService ~= nil then
		self.goreService:unregisterPlayer(player)
	end

	local runtime = self.playerRuntimes[player]
	if not runtime then
		return
	end

	if runtime.movementLockAnchoredRoot and runtime.movementLockAnchoredRoot.Parent ~= nil then
		runtime.movementLockAnchoredRoot.Anchored = false
	end
	runtime.movementLockAnchoredRoot = nil
	self:stopInvincibilityFrames(runtime)
	runtime.playerJanitor:Destroy()
	runtime.characterJanitor:Destroy()
	self.playerRuntimes[player] = nil
end

function PlayerServiceServer.GetState(self: PlayerServiceServer, player: Player): PlayerState
	local state = self.playerState[player]
	if state then
		return state
	end

	local defaultState: PlayerState = {
		facingSign = PlayerServiceUtils.DEFAULT_FACING_SIGN,
		nextSpawnHealth = nil,
		movementLocked = true,
		spawnWorldPosition = nil,
	}
	player:SetAttribute(PlayerServiceUtils.DEFAULT_MOVEMENT_LOCK_ATTRIBUTE, true)
	self.playerState[player] = defaultState
	return defaultState
end

function PlayerServiceServer.RequestState(self: PlayerServiceServer, player: Player)
	local state = self:getState(player)
	local runtime = self:getRuntime(player)
	local rig = PlayerServiceUtils.resolveCharacterRig(player.Character)
	if rig then
		PlayerServiceUtils.applyCharacterSettings(rig.humanoid)
		PlayerServiceUtils.snapRootPartFacing(rig.rootPart, state.facingSign)
	end
	self:applyMovementLockToRuntime(runtime, player, state.movementLocked)
	self.networker:fire(player, "applyFacing", state.facingSign)
	self.networker:fire(player, PlayerServiceUtils.NETWORK_METHOD_APPLY_MOVEMENT_LOCK, state.movementLocked)
end

function PlayerServiceServer.SetWorldReadyForMovement(self: PlayerServiceServer, player: Player, worldReadyRaw: any)
	if typeof(worldReadyRaw) ~= "boolean" then
		return
	end

	if worldReadyRaw then
		local state = self:getState(player)
		if not state.movementLocked then
			return
		end

		local character = player.Character
		if character == nil then
			return
		end
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if humanoid == nil or not PlayerServiceUtils.isHumanoidAlive(humanoid) then
			return
		end
		if not self:trySnapCharacterToWorldSurface(player, character, humanoid) then
			return
		end
		self:setMovementLocked(player, false, true)
	else
		self:setMovementLocked(player, true, true, true)
	end
end

function PlayerServiceServer.SetFacing(self: PlayerServiceServer, player: Player, facingSignRaw: any)
	local state = self:getState(player)
	local facingSign = PlayerServiceUtils.sanitizeFacingSign(facingSignRaw, state.facingSign)
	state.facingSign = facingSign

	local character = player.Character
	local rig = PlayerServiceUtils.resolveCharacterRig(character)
	if not rig then
		return
	end

	PlayerServiceUtils.applyCharacterSettings(rig.humanoid)
end

function PlayerServiceServer.Destroy(self: PlayerServiceServer)
	if self.playerAddedConnection then
		self.playerAddedConnection:Disconnect()
		self.playerAddedConnection = nil
	end

	if self.playerRemovingConnection then
		self.playerRemovingConnection:Disconnect()
		self.playerRemovingConnection = nil
	end
	if self.loadingScreenReadyConnection then
		self.loadingScreenReadyConnection:Disconnect()
		self.loadingScreenReadyConnection = nil
	end

	if self.networker then
		self.networker:destroy()
	end

	for player, runtime in self.playerRuntimes do
		if self.goreService ~= nil then
			self.goreService:unregisterPlayer(player)
		end
		if runtime.movementLockAnchoredRoot and runtime.movementLockAnchoredRoot.Parent ~= nil then
			runtime.movementLockAnchoredRoot.Anchored = false
		end
		runtime.movementLockAnchoredRoot = nil
		self:stopInvincibilityFrames(runtime)
		runtime.playerJanitor:Destroy()
		runtime.characterJanitor:Destroy()
		self.playerRuntimes[player] = nil
		player:SetAttribute(PlayerServiceUtils.DEFAULT_MOVEMENT_LOCK_ATTRIBUTE, nil)
	end
end

PlayerServiceServer.emitPlayerGore = PlayerServiceServer.EmitPlayerGore
PlayerServiceServer.fireDamageFeedback = PlayerServiceServer.FireDamageFeedback
PlayerServiceServer.init = PlayerServiceServer.Init
PlayerServiceServer.isGameplayActiveForPlayer = PlayerServiceServer.IsGameplayActiveForPlayer
PlayerServiceServer.onLoadingScreenReady = PlayerServiceServer.OnLoadingScreenReady
PlayerServiceServer.enterGameplay = PlayerServiceServer.EnterGameplay
PlayerServiceServer.createRuntime = PlayerServiceServer.CreateRuntime
PlayerServiceServer.getRuntime = PlayerServiceServer.GetRuntime
PlayerServiceServer.stopInvincibilityFrames = PlayerServiceServer.StopInvincibilityFrames
PlayerServiceServer.applyMovementLockToRuntime = PlayerServiceServer.ApplyMovementLockToRuntime
PlayerServiceServer.setMovementLocked = PlayerServiceServer.SetMovementLocked
PlayerServiceServer.setGameplaySpawnPosition = PlayerServiceServer.SetGameplaySpawnPosition
PlayerServiceServer.applyGameplaySpawnToCharacter = PlayerServiceServer.ApplyGameplaySpawnToCharacter
PlayerServiceServer.trySnapCharacterToWorldSurface = PlayerServiceServer.TrySnapCharacterToWorldSurface
PlayerServiceServer.queueSpawnSurfaceSnap = PlayerServiceServer.QueueSpawnSurfaceSnap
PlayerServiceServer.getOrCreateDamageHighlight = PlayerServiceServer.GetOrCreateDamageHighlight
PlayerServiceServer.playInvincibilityFlicker = PlayerServiceServer.PlayInvincibilityFlicker
PlayerServiceServer.onHumanoidHealthChanged = PlayerServiceServer.OnHumanoidHealthChanged
PlayerServiceServer.bindHumanoid = PlayerServiceServer.BindHumanoid
PlayerServiceServer.bindCharacter = PlayerServiceServer.BindCharacter
PlayerServiceServer.trackPlayer = PlayerServiceServer.TrackPlayer
PlayerServiceServer.untrackPlayer = PlayerServiceServer.UntrackPlayer
PlayerServiceServer.getState = PlayerServiceServer.GetState
PlayerServiceServer.requestState = PlayerServiceServer.RequestState
PlayerServiceServer.setWorldReadyForMovement = PlayerServiceServer.SetWorldReadyForMovement
PlayerServiceServer.setFacing = PlayerServiceServer.SetFacing
PlayerServiceServer.destroy = PlayerServiceServer.Destroy

type PlayerServiceServer = typeof(PlayerServiceServer) & {
	isGameplayActiveForPlayer: (self: PlayerServiceServer, player: Player) -> boolean,
	onLoadingScreenReady: (self: PlayerServiceServer, player: Player, statusRaw: any) -> boolean,
	EnterGameplay: (self: PlayerServiceServer, player: Player) -> boolean,
	enterGameplay: (self: PlayerServiceServer, player: Player) -> boolean,
	setMovementLocked: (
		self: PlayerServiceServer,
		player: Player,
		movementLocked: boolean,
		replicateToClient: boolean?,
		forceLock: boolean?
	) -> (),
	setGameplaySpawnPosition: (self: PlayerServiceServer, player: Player, worldPositionRaw: any) -> (),
	applyGameplaySpawnToCharacter: (self: PlayerServiceServer, player: Player, character: Model) -> boolean,
	emitPlayerGore: (
		self: PlayerServiceServer,
		player: Player,
		humanoid: Humanoid,
		isDeathRaw: any,
		damageRaw: any?
	) -> (),
	networker: Networker.Server,
	goreService: GoreServiceServerObject?,
	ragdollService: RagdollServiceServerObject?,
	invincibilityFramesConfig: InvincibilityFramesConfig,
	allowMovementFreeze: boolean,
	playerState: { [Player]: PlayerState },
	activeGameplayPlayers: { [Player]: boolean },
	loadingScreenReadyPlayers: { [Player]: boolean },
	playerRuntimes: { [Player]: PlayerRuntime },
	loadingScreenReadyRemote: RemoteEvent?,
	loadingScreenReadyConnection: RBXScriptConnection?,
	playerAddedConnection: RBXScriptConnection?,
	playerRemovingConnection: RBXScriptConnection?,
}

return PlayerServiceServer :: PlayerServiceServer
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="1062">
              <Properties>
                <string name="Name">RagdollServiceServer</string>
                <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Janitor = require(ReplicatedStorage.Packages.Janitor)
local Networker = require(script:FindFirstAncestor("game").Shared.Modules.Networking.Networker)
local NevermoreSupport = require(script:FindFirstAncestor("game").Shared.Modules.Core.NevermoreSupport)
local RagdollServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.RagdollServiceUtils)
local ServerBinderSupport = require(script:FindFirstAncestor("game").Server.Binders.ServerBinderSupport)

type CharacterRig = RagdollServiceUtils.CharacterRig
type RagdollContext = RagdollServiceUtils.RagdollContext
type RagdollServiceState = RagdollServiceUtils.RagdollServiceState

type JanitorClass = {
	GiveChore: (self: JanitorClass, chore: any, ...any) -> (),
	Clean: (self: JanitorClass) -> (),
	Destroy: (self: JanitorClass) -> (),
}

type PlayerRuntime = {
	playerJanitor: JanitorClass,
	characterJanitor: JanitorClass,
	character: Model?,
	humanoid: Humanoid?,
	ragdollContext: RagdollContext?,
	ragdollPlaneX: number?,
	state: RagdollServiceState,
	stateToken: number,
}

local RagdollServiceServer = {}

local SELF_REQUEST_REASON = "SelfRequest"
local SELF_RECOVER_REASON = "SelfRecover"
local TIMER_RECOVER_REASON = "TimerRecovery"
local SERVER_RECOVER_REASON = "ServerRecovery"

function RagdollServiceServer.Init(self: RagdollServiceServer)
	self.networker = Networker.server.new("RagdollService", self, {
		self.RequestSync,
		self.RequestSelfRagdoll,
		self.RequestSelfRecover,
	})
	self.playerRuntimes = {}
	self.binders = NevermoreSupport.getService(ServerBinderSupport)

	for _, player in Players:GetPlayers() do
		self:trackPlayer(player)
	end

	self.playerAddedConnection = Players.PlayerAdded:Connect(function(player: Player)
		self:trackPlayer(player)
	end)

	self.playerRemovingConnection = Players.PlayerRemoving:Connect(function(player: Player)
		self:untrackPlayer(player)
	end)

	self.heartbeatConnection = RunService.Heartbeat:Connect(function()
		self:stepRagdollPlaneConstraint()
	end)
end

function RagdollServiceServer.CreateRuntime(self: RagdollServiceServer): PlayerRuntime
	return {
		playerJanitor = Janitor.new(),
		characterJanitor = Janitor.new(),
		character = nil,
		humanoid = nil,
		ragdollContext = nil,
		ragdollPlaneX = nil,
		state = RagdollServiceUtils.createDefaultState(),
		stateToken = 0,
	}
end

function RagdollServiceServer.GetRuntime(self: RagdollServiceServer, player: Player): PlayerRuntime
	local runtime = self.playerRuntimes[player]
	if runtime then
		return runtime
	end

	local nextRuntime = self:createRuntime()
	self.playerRuntimes[player] = nextRuntime
	return nextRuntime
end

function RagdollServiceServer.PushState(self: RagdollServiceServer, player: Player)
	local runtime = self:getRuntime(player)
	self.networker:fire(player, "applyState", RagdollServiceUtils.cloneState(runtime.state))
end

function RagdollServiceServer.CommitState(
	self: RagdollServiceServer,
	player: Player,
	runtime: PlayerRuntime,
	isRagdolled: boolean,
	reasonRaw: any,
	durationSeconds: number?,
	canRecover: boolean
): number
	runtime.stateToken += 1
	local token = runtime.stateToken
	local now = RagdollServiceUtils.now()
	local sequence = runtime.state.sequence + 1
	local scheduledRecoveryAt = if isRagdolled
			and canRecover
			and durationSeconds ~= nil
		then now + durationSeconds
		else nil
	runtime.state = RagdollServiceUtils.createState(
		isRagdolled,
		reasonRaw,
		now,
		scheduledRecoveryAt,
		canRecover,
		sequence,
		runtime.state
	)
	self:pushState(player)
	return token
end

function RagdollServiceServer.ScheduleRecovery(
	self: RagdollServiceServer,
	player: Player,
	runtime: PlayerRuntime,
	token: number,
	durationSeconds: number
)
	task.delay(durationSeconds, function()
		local latestRuntime = self.playerRuntimes[player]
		if latestRuntime ~= runtime then
			return
		end
		if latestRuntime.stateToken ~= token then
			return
		end
		if not latestRuntime.state.isRagdolled then
			return
		end
		if latestRuntime.state.canRecover ~= true then
			return
		end

		self:recoverPlayer(player, TIMER_RECOVER_REASON)
	end)
end

function RagdollServiceServer.ClearActiveRagdoll(
	self: RagdollServiceServer,
	runtime: PlayerRuntime,
	restoreHumanoid: boolean?
)
	local context = runtime.ragdollContext
	if context == nil then
		runtime.ragdollPlaneX = nil
		return
	end

	RagdollServiceUtils.endRagdoll(context, {
		restoreHumanoid = if restoreHumanoid == nil then true else restoreHumanoid,
	})
	runtime.ragdollContext = nil
	runtime.ragdollPlaneX = nil
end

function RagdollServiceServer.StepRagdollPlaneConstraint(self: RagdollServiceServer)
	for _, runtime in self.playerRuntimes do
		local context = runtime.ragdollContext
		if context == nil then
			continue
		end

		local rootPart = context.rig.rootPart
		if rootPart.Parent == nil then
			continue
		end

		if runtime.ragdollPlaneX == nil then
			runtime.ragdollPlaneX = rootPart.Position.X
		end
		RagdollServiceUtils.enforceRagdoll2DPlane(context, runtime.ragdollPlaneX)
	end
end

function RagdollServiceServer.ResolvePlayerRig(
	self: RagdollServiceServer,
	player: Player,
	runtime: PlayerRuntime
): CharacterRig?
	local character = runtime.character
	if character == nil or character.Parent == nil then
		character = player.Character
		runtime.character = character
	end

	local rig = RagdollServiceUtils.resolveCharacterRig(character)
	if rig ~= nil then
		runtime.character = rig.character
		runtime.humanoid = rig.humanoid
	end
	return rig
end

function RagdollServiceServer.RagdollPlayer(
	self: RagdollServiceServer,
	player: Player,
	reasonRaw: any,
	durationRaw: any,
	canRecoverRaw: any,
	impulseRaw: any
): boolean
	local runtime = self:getRuntime(player)
	local rig = self:resolvePlayerRig(player, runtime)
	if rig == nil then
		return false
	end

	if runtime.ragdollContext == nil then
		local context = RagdollServiceUtils.beginRagdoll(rig, {
			reason = reasonRaw,
			impulse = if typeof(impulseRaw) == "Vector3" then impulseRaw else nil,
		})
		if context == nil then
			return false
		end
		runtime.ragdollContext = context
		RagdollServiceUtils.setCharacterNetworkOwner(rig.character, nil)
	elseif typeof(impulseRaw) == "Vector3" and impulseRaw.Magnitude > 0 then
		local mass = math.max(1, rig.rootPart.AssemblyMass)
		rig.rootPart:ApplyImpulse(impulseRaw * mass)
	end

	if runtime.ragdollPlaneX == nil then
		runtime.ragdollPlaneX = rig.rootPart.Position.X
	end
	if runtime.ragdollContext ~= nil then
		RagdollServiceUtils.enforceRagdoll2DPlane(runtime.ragdollContext, runtime.ragdollPlaneX)
	end

	local canRecover = canRecoverRaw ~= false
	local duration = if canRecover
		then RagdollServiceUtils.sanitizeDuration(
			durationRaw,
			nil,
			RagdollServiceUtils.MIN_DURATION,
			RagdollServiceUtils.MAX_DURATION
		)
		else nil

	local stateToken = self:commitState(player, runtime, true, reasonRaw, duration, canRecover)
	if duration ~= nil then
		self:scheduleRecovery(player, runtime, stateToken, duration)
	end

	return true
end

function RagdollServiceServer.RecoverPlayer(self: RagdollServiceServer, player: Player, reasonRaw: any): boolean
	local runtime = self:getRuntime(player)
	if runtime.ragdollContext == nil and not runtime.state.isRagdolled then
		return false
	end

	self:clearActiveRagdoll(runtime, true)
	self:commitState(player, runtime, false, reasonRaw, nil, true)

	local rig = self:resolvePlayerRig(player, runtime)
	if rig ~= nil then
		RagdollServiceUtils.setCharacterNetworkOwner(rig.character, player)
	end

	return true
end

function RagdollServiceServer.SetPlayerRagdoll(
	self: RagdollServiceServer,
	player: Player,
	enabledRaw: any,
	reasonRaw: any,
	durationRaw: any,
	canRecoverRaw: any,
	impulseRaw: any
): boolean
	if enabledRaw == true then
		return self:ragdollPlayer(player, reasonRaw, durationRaw, canRecoverRaw, impulseRaw)
	end

	return self:recoverPlayer(player, reasonRaw)
end

function RagdollServiceServer.GetState(self: RagdollServiceServer, player: Player): RagdollServiceState
	local runtime = self:getRuntime(player)
	return RagdollServiceUtils.cloneState(runtime.state)
end

function RagdollServiceServer.IsPlayerRagdolled(self: RagdollServiceServer, player: Player): boolean
	local runtime = self:getRuntime(player)
	return runtime.state.isRagdolled
end

function RagdollServiceServer.BindHumanoid(self: RagdollServiceServer, player: Player, humanoid: Humanoid)
	local runtime = self:getRuntime(player)
	runtime.humanoid = humanoid
	humanoid.BreakJointsOnDeath = false

	runtime.characterJanitor:GiveChore(humanoid.Died:Connect(function()
		if runtime.humanoid ~= humanoid then
			return
		end
		self:ragdollPlayer(player, RagdollServiceUtils.DEATH_REASON, nil, false, nil)
	end))

	runtime.characterJanitor:GiveChore(humanoid.Destroying:Connect(function()
		if runtime.humanoid == humanoid then
			runtime.humanoid = nil
		end
	end))
end

function RagdollServiceServer.BindCharacter(self: RagdollServiceServer, player: Player, character: Model)
	local runtime = self:getRuntime(player)
	runtime.characterJanitor:Clean()
	self:clearActiveRagdoll(runtime, false)
	runtime.character = character
	runtime.humanoid = nil
	runtime.ragdollPlaneX = nil
	self:commitState(player, runtime, false, RagdollServiceUtils.CHARACTER_RESET_REASON, nil, true)

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		self:bindHumanoid(player, humanoid)
	end

	runtime.characterJanitor:GiveChore(character.ChildAdded:Connect(function(child: Instance)
		if runtime.humanoid ~= nil then
			return
		end
		if child:IsA("Humanoid") then
			self:bindHumanoid(player, child)
		end
	end))

	runtime.characterJanitor:GiveChore(character.ChildRemoved:Connect(function(child: Instance)
		if runtime.humanoid == child then
			runtime.humanoid = nil
		end
	end))
end

function RagdollServiceServer.TrackPlayer(self: RagdollServiceServer, player: Player)
	local runtime = self:getRuntime(player)
	runtime.playerJanitor:Clean()
	runtime.characterJanitor:Clean()
	self:clearActiveRagdoll(runtime, false)
	runtime.character = nil
	runtime.humanoid = nil
	runtime.ragdollPlaneX = nil
	runtime.state = RagdollServiceUtils.createDefaultState()
	runtime.stateToken = 0

	runtime.playerJanitor:GiveChore(player.CharacterAdded:Connect(function(character: Model)
		self:bindCharacter(player, character)
	end))

	if player.Character then
		self:bindCharacter(player, player.Character)
	else
		self:pushState(player)
	end
end

function RagdollServiceServer.UntrackPlayer(self: RagdollServiceServer, player: Player)
	local runtime = self.playerRuntimes[player]
	if runtime == nil then
		return
	end

	self:clearActiveRagdoll(runtime, false)
	runtime.playerJanitor:Destroy()
	runtime.characterJanitor:Destroy()
	self.playerRuntimes[player] = nil
end

function RagdollServiceServer.RequestSync(self: RagdollServiceServer, player: Player)
	if self.playerRuntimes[player] == nil then
		self:trackPlayer(player)
		return
	end
	self:pushState(player)
end

function RagdollServiceServer.RequestSelfRagdoll(
	self: RagdollServiceServer,
	player: Player,
	durationRaw: any,
	reasonRaw: any,
	impulseRaw: any
)
	local duration = RagdollServiceUtils.sanitizeDuration(
		durationRaw,
		RagdollServiceUtils.DEFAULT_SELF_RAGDOLL_DURATION,
		RagdollServiceUtils.MIN_DURATION,
		RagdollServiceUtils.MAX_SELF_REQUEST_DURATION
	)
	self:ragdollPlayer(
		player,
		RagdollServiceUtils.sanitizeReason(reasonRaw, SELF_REQUEST_REASON),
		duration,
		true,
		impulseRaw
	)
end

function RagdollServiceServer.RequestSelfRecover(self: RagdollServiceServer, player: Player)
	local runtime = self:getRuntime(player)
	if not runtime.state.isRagdolled then
		return
	end
	if runtime.state.canRecover ~= true then
		return
	end

	self:recoverPlayer(player, SELF_RECOVER_REASON)
end

function RagdollServiceServer.ForceRecoverPlayer(self: RagdollServiceServer, player: Player): boolean
	return self:recoverPlayer(player, SERVER_RECOVER_REASON)
end

function RagdollServiceServer.Destroy(self: RagdollServiceServer)
	if self.playerAddedConnection then
		self.playerAddedConnection:Disconnect()
		self.playerAddedConnection = nil
	end

	if self.playerRemovingConnection then
		self.playerRemovingConnection:Disconnect()
		self.playerRemovingConnection = nil
	end

	if self.heartbeatConnection then
		self.heartbeatConnection:Disconnect()
		self.heartbeatConnection = nil
	end

	for player, runtime in self.playerRuntimes do
		self:clearActiveRagdoll(runtime, false)
		runtime.playerJanitor:Destroy()
		runtime.characterJanitor:Destroy()
		self.playerRuntimes[player] = nil
	end

	if self.networker then
		self.networker:destroy()
	end
end

RagdollServiceServer.init = RagdollServiceServer.Init
RagdollServiceServer.createRuntime = RagdollServiceServer.CreateRuntime
RagdollServiceServer.getRuntime = RagdollServiceServer.GetRuntime
RagdollServiceServer.pushState = RagdollServiceServer.PushState
RagdollServiceServer.commitState = RagdollServiceServer.CommitState
RagdollServiceServer.scheduleRecovery = RagdollServiceServer.ScheduleRecovery
RagdollServiceServer.clearActiveRagdoll = RagdollServiceServer.ClearActiveRagdoll
RagdollServiceServer.stepRagdollPlaneConstraint = RagdollServiceServer.StepRagdollPlaneConstraint
RagdollServiceServer.resolvePlayerRig = RagdollServiceServer.ResolvePlayerRig
RagdollServiceServer.ragdollPlayer = RagdollServiceServer.RagdollPlayer
RagdollServiceServer.recoverPlayer = RagdollServiceServer.RecoverPlayer
RagdollServiceServer.setPlayerRagdoll = RagdollServiceServer.SetPlayerRagdoll
RagdollServiceServer.getState = RagdollServiceServer.GetState
RagdollServiceServer.isPlayerRagdolled = RagdollServiceServer.IsPlayerRagdolled
RagdollServiceServer.bindHumanoid = RagdollServiceServer.BindHumanoid
RagdollServiceServer.bindCharacter = RagdollServiceServer.BindCharacter
RagdollServiceServer.trackPlayer = RagdollServiceServer.TrackPlayer
RagdollServiceServer.untrackPlayer = RagdollServiceServer.UntrackPlayer
RagdollServiceServer.requestSync = RagdollServiceServer.RequestSync
RagdollServiceServer.requestSelfRagdoll = RagdollServiceServer.RequestSelfRagdoll
RagdollServiceServer.requestSelfRecover = RagdollServiceServer.RequestSelfRecover
RagdollServiceServer.forceRecoverPlayer = RagdollServiceServer.ForceRecoverPlayer
RagdollServiceServer.destroy = RagdollServiceServer.Destroy

export type RagdollServiceServer = typeof(RagdollServiceServer) & {
	networker: Networker.Server,
	playerRuntimes: { [Player]: PlayerRuntime },
	playerAddedConnection: RBXScriptConnection?,
	playerRemovingConnection: RBXScriptConnection?,
	heartbeatConnection: RBXScriptConnection?,
}

return RagdollServiceServer :: RagdollServiceServer
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="1063">
              <Properties>
                <string name="Name">VFXServiceServer</string>
                <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Networker = require(script:FindFirstAncestor("game").Shared.Modules.Networking.Networker)
local VFXServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.VFXServiceUtils)

local VFXServiceServer = {}

local function sanitizePlayers(playersRaw: any): { Player }
	local players = {}
	if typeof(playersRaw) ~= "table" then
		return players
	end

	for _, player in playersRaw do
		if typeof(player) == "Instance" and player:IsA("Player") then
			table.insert(players, player)
		end
	end
	return players
end

local function fireForPlayers(networker: Networker.Server, players: { Player }, methodName: string, ...: any)
	for _, player in players do
		networker:fire(player, methodName, ...)
	end
end

function VFXServiceServer.Init(self: VFXServiceServer)
	self.networker = Networker.server.new("VFXService", self)
end

function VFXServiceServer.PlayForPlayer(
	self: VFXServiceServer,
	player: Player,
	effectSourceRaw: any,
	optionsRaw: any
): boolean
	if typeof(player) ~= "Instance" or not player:IsA("Player") then
		return false
	end

	local effectReference = VFXServiceUtils.sanitizeEffectReference(effectSourceRaw)
	if effectReference == nil then
		return false
	end

	local options = VFXServiceUtils.serializePlaybackOptions(optionsRaw)
	self.networker:fire(player, VFXServiceUtils.NETWORK_METHOD_PLAY, effectReference, options)
	return true
end

function VFXServiceServer.PlayForPlayers(
	self: VFXServiceServer,
	playersRaw: any,
	effectSourceRaw: any,
	optionsRaw: any
): number
	local players = sanitizePlayers(playersRaw)
	if #players <= 0 then
		return 0
	end

	local effectReference = VFXServiceUtils.sanitizeEffectReference(effectSourceRaw)
	if effectReference == nil then
		return 0
	end

	local options = VFXServiceUtils.serializePlaybackOptions(optionsRaw)
	fireForPlayers(self.networker, players, VFXServiceUtils.NETWORK_METHOD_PLAY, effectReference, options)
	return #players
end

function VFXServiceServer.PlayForAll(self: VFXServiceServer, effectSourceRaw: any, optionsRaw: any): number
	local players = Players:GetPlayers()
	if #players <= 0 then
		return 0
	end

	local effectReference = VFXServiceUtils.sanitizeEffectReference(effectSourceRaw)
	if effectReference == nil then
		return 0
	end

	local options = VFXServiceUtils.serializePlaybackOptions(optionsRaw)
	fireForPlayers(self.networker, players, VFXServiceUtils.NETWORK_METHOD_PLAY, effectReference, options)
	return #players
end

function VFXServiceServer.StopChannelForPlayer(self: VFXServiceServer, player: Player, channelNameRaw: any): boolean
	if typeof(player) ~= "Instance" or not player:IsA("Player") then
		return false
	end

	local channelName = VFXServiceUtils.sanitizeChannelName(channelNameRaw)
	if channelName == nil then
		return false
	end

	self.networker:fire(player, VFXServiceUtils.NETWORK_METHOD_STOP_CHANNEL, channelName)
	return true
end

function VFXServiceServer.StopChannelForPlayers(self: VFXServiceServer, playersRaw: any, channelNameRaw: any): number
	local players = sanitizePlayers(playersRaw)
	if #players <= 0 then
		return 0
	end

	local channelName = VFXServiceUtils.sanitizeChannelName(channelNameRaw)
	if channelName == nil then
		return 0
	end

	fireForPlayers(self.networker, players, VFXServiceUtils.NETWORK_METHOD_STOP_CHANNEL, channelName)
	return #players
end

function VFXServiceServer.StopChannelForAll(self: VFXServiceServer, channelNameRaw: any): number
	local players = Players:GetPlayers()
	if #players <= 0 then
		return 0
	end

	local channelName = VFXServiceUtils.sanitizeChannelName(channelNameRaw)
	if channelName == nil then
		return 0
	end

	fireForPlayers(self.networker, players, VFXServiceUtils.NETWORK_METHOD_STOP_CHANNEL, channelName)
	return #players
end

function VFXServiceServer.StopAllForPlayer(self: VFXServiceServer, player: Player): boolean
	if typeof(player) ~= "Instance" or not player:IsA("Player") then
		return false
	end

	self.networker:fire(player, VFXServiceUtils.NETWORK_METHOD_STOP_ALL)
	return true
end

function VFXServiceServer.StopAllForPlayers(self: VFXServiceServer, playersRaw: any): number
	local players = sanitizePlayers(playersRaw)
	if #players <= 0 then
		return 0
	end

	fireForPlayers(self.networker, players, VFXServiceUtils.NETWORK_METHOD_STOP_ALL)
	return #players
end

function VFXServiceServer.StopAllForAll(self: VFXServiceServer): number
	local players = Players:GetPlayers()
	if #players <= 0 then
		return 0
	end

	fireForPlayers(self.networker, players, VFXServiceUtils.NETWORK_METHOD_STOP_ALL)
	return #players
end

function VFXServiceServer.Destroy(self: VFXServiceServer)
	if self.networker ~= nil then
		self.networker:destroy()
	end
end

VFXServiceServer.init = VFXServiceServer.Init
VFXServiceServer.playForPlayer = VFXServiceServer.PlayForPlayer
VFXServiceServer.playForPlayers = VFXServiceServer.PlayForPlayers
VFXServiceServer.playForAll = VFXServiceServer.PlayForAll
VFXServiceServer.stopChannelForPlayer = VFXServiceServer.StopChannelForPlayer
VFXServiceServer.stopChannelForPlayers = VFXServiceServer.StopChannelForPlayers
VFXServiceServer.stopChannelForAll = VFXServiceServer.StopChannelForAll
VFXServiceServer.stopAllForPlayer = VFXServiceServer.StopAllForPlayer
VFXServiceServer.stopAllForPlayers = VFXServiceServer.StopAllForPlayers
VFXServiceServer.stopAllForAll = VFXServiceServer.StopAllForAll
VFXServiceServer.destroy = VFXServiceServer.Destroy

type VFXServiceServer = typeof(VFXServiceServer) & {
	playForPlayer: (self: VFXServiceServer, player: Player, effectSourceRaw: any, optionsRaw: any) -> boolean,
	playForPlayers: (self: VFXServiceServer, playersRaw: any, effectSourceRaw: any, optionsRaw: any) -> number,
	playForAll: (self: VFXServiceServer, effectSourceRaw: any, optionsRaw: any) -> number,
	stopChannelForPlayer: (self: VFXServiceServer, player: Player, channelNameRaw: any) -> boolean,
	stopChannelForPlayers: (self: VFXServiceServer, playersRaw: any, channelNameRaw: any) -> number,
	stopChannelForAll: (self: VFXServiceServer, channelNameRaw: any) -> number,
	stopAllForPlayer: (self: VFXServiceServer, player: Player) -> boolean,
	stopAllForPlayers: (self: VFXServiceServer, playersRaw: any) -> number,
	stopAllForAll: (self: VFXServiceServer) -> number,
	networker: Networker.Server,
}

return VFXServiceServer :: VFXServiceServer
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="1064">
              <Properties>
                <string name="Name">WeatherServiceServer</string>
                <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerScriptService = game:GetService("ServerScriptService")
local Workspace = game:GetService("Workspace")

local Configs = require(script:FindFirstAncestor("game").Shared.Modules.Core.Configs)
local Networker = require(script:FindFirstAncestor("game").Shared.Modules.Networking.Networker)
local PlayerServiceServer = require(script:FindFirstAncestor("game").Server.Services.PlayerServiceServer)
local WeatherServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.WeatherServiceUtils)

type WeatherType = WeatherServiceUtils.WeatherType
type WeatherServiceConfig = WeatherServiceUtils.WeatherServiceConfig
type WeatherServiceState = WeatherServiceUtils.WeatherServiceState

local WeatherServiceServer = {}

local function sanitizeDeltaTime(dtRaw: any): number
	return WeatherServiceUtils.sanitizeNumber(dtRaw, 0, 0, 1)
end

function WeatherServiceServer.RollNextWeatherDurationSeconds(self: WeatherServiceServer): number
	local minimum = self.config.weatherDurationMinSeconds
	local maximum = self.config.weatherDurationMaxSeconds
	if maximum <= minimum then
		return minimum
	end
	return self.random:NextNumber(minimum, maximum)
end

function WeatherServiceServer.CreateStateSnapshot(self: WeatherServiceServer): WeatherServiceState
	local snapshot = WeatherServiceUtils.cloneState(self.state)
	snapshot.ready = self.config.enabled
	snapshot.snapshotServerTime = Workspace:GetServerTimeNow()
	snapshot.updatedAt = os.clock()
	return snapshot
end

function WeatherServiceServer.PushState(self: WeatherServiceServer, playerRaw: any?, forceRaw: any?)
	if self.networker == nil then
		return
	end

	local force = forceRaw == true
	local now = os.clock()
	if not force and now - self.lastStatePushAt < self.config.statePushIntervalSeconds then
		return
	end
	self.lastStatePushAt = now

	local snapshot = self:createStateSnapshot()
	local player = playerRaw
	if player ~= nil then
		if typeof(player) == "Instance" and player:IsA("Player") then
			self.networker:fire(player, WeatherServiceUtils.CLIENT_METHOD_APPLY_STATE, snapshot)
		end
		return
	end

	for _, listedPlayer in Players:GetPlayers() do
		if PlayerServiceServer:isGameplayActiveForPlayer(listedPlayer) then
			self.networker:fire(listedPlayer, WeatherServiceUtils.CLIENT_METHOD_APPLY_STATE, snapshot)
		end
	end
	self.stateDirty = false
end

function WeatherServiceServer.SetClockTime(
	self: WeatherServiceServer,
	clockTimeRaw: any,
	forceReplicateRaw: any?
): number
	local nextClockTime = WeatherServiceUtils.sanitizeState({
		clockTime = clockTimeRaw,
	}, self.state).clockTime
	self.state.clockTime = nextClockTime
	self.stateDirty = true
	if forceReplicateRaw == true then
		self:pushState(nil, true)
	end
	return self.state.clockTime
end

function WeatherServiceServer.SetDayNightCycleEnabled(
	self: WeatherServiceServer,
	enabledRaw: any,
	forceReplicateRaw: any?
): boolean
	local enabled = WeatherServiceUtils.sanitizeBoolean(enabledRaw, self.state.dayNightCycleEnabled)
	self.state.dayNightCycleEnabled = enabled
	self.state.clockSpeed = if enabled then 24 / self.config.dayDurationSeconds else 0
	self.stateDirty = true
	if forceReplicateRaw == true then
		self:pushState(nil, true)
	end
	return self.state.dayNightCycleEnabled
end

function WeatherServiceServer.SetWeather(
	self: WeatherServiceServer,
	weatherTypeRaw: any,
	transitionSecondsRaw: any?,
	forceReplicateRaw: any?
): WeatherType
	local nextWeatherType = WeatherServiceUtils.sanitizeWeatherType(weatherTypeRaw, self.state.weatherType)
	local transitionSeconds =
		WeatherServiceUtils.sanitizeNumber(transitionSecondsRaw, self.config.weatherTransitionSeconds, 0, 60)

	self.state.weatherType = nextWeatherType
	self.state.weatherTransitionSeconds = transitionSeconds
	self.state.rainIntensity = WeatherServiceUtils.getRainIntensityForWeather(nextWeatherType)
	self.weatherSecondsRemaining = self:rollNextWeatherDurationSeconds()
	self.stateDirty = true

	if forceReplicateRaw == true then
		self:pushState(nil, true)
	end

	return self.state.weatherType
end

function WeatherServiceServer.StepDayNight(self: WeatherServiceServer, dt: number)
	if not self.config.enabled then
		return
	end
	if not self.state.dayNightCycleEnabled then
		return
	end
	if self.state.clockSpeed == 0 then
		return
	end

	self.state.clockTime = WeatherServiceUtils.advanceClockTime(self.state.clockTime, dt, self.state.clockSpeed)
	self.stateDirty = true
end

function WeatherServiceServer.StepWeatherCycle(self: WeatherServiceServer, dt: number)
	if not self.config.enabled then
		return
	end
	if not self.config.weatherCycleEnabled then
		return
	end

	self.weatherSecondsRemaining -= dt
	if self.weatherSecondsRemaining > 0 then
		return
	end

	local nextWeatherType =
		WeatherServiceUtils.chooseWeightedWeatherType(self.random, self.config, self.state.weatherType)
	self:setWeather(nextWeatherType, self.config.weatherTransitionSeconds, false)
end

function WeatherServiceServer.OnHeartbeat(self: WeatherServiceServer, dtRaw: any)
	local dt = sanitizeDeltaTime(dtRaw)
	if dt <= 0 then
		return
	end

	self:stepDayNight(dt)
	self:stepWeatherCycle(dt)

	local now = os.clock()
	if self.stateDirty or (now - self.lastStatePushAt) >= self.config.statePushIntervalSeconds then
		self:pushState(nil, false)
	end
end

function WeatherServiceServer.TrackPlayer(self: WeatherServiceServer, player: Player)
	if self.networker == nil then
		return
	end
	self:pushState(player, true)
end

function WeatherServiceServer.UntrackPlayer(self: WeatherServiceServer, _player: Player)
	return
end

function WeatherServiceServer.RequestSync(self: WeatherServiceServer, player: Player)
	self:pushState(player, true)
end

function WeatherServiceServer.GetState(self: WeatherServiceServer): WeatherServiceState
	return WeatherServiceUtils.cloneState(self.state)
end

function WeatherServiceServer.Init(self: WeatherServiceServer)
	local configSource = if typeof(Configs) == "table" then (Configs :: any).weather else nil
	self.config = WeatherServiceUtils.resolveConfig(configSource, nil)
	self.state = WeatherServiceUtils.createStateFromConfig(self.config)
	self.random = Random.new()
	self.stateDirty = true
	self.lastStatePushAt = 0
	self.weatherSecondsRemaining = self:rollNextWeatherDurationSeconds()

	self.networker = Networker.server.new("WeatherService", self, {
		self.RequestSync,
	})

	for _, player in Players:GetPlayers() do
		if PlayerServiceServer:isGameplayActiveForPlayer(player) then
			self:trackPlayer(player)
		end
	end

	self.playerAddedConnection = Players.PlayerAdded:Connect(function(player: Player)
		if PlayerServiceServer:isGameplayActiveForPlayer(player) then
			self:trackPlayer(player)
		end
	end)

	self.playerRemovingConnection = Players.PlayerRemoving:Connect(function(player: Player)
		self:untrackPlayer(player)
	end)

	self.heartbeatConnection = RunService.Heartbeat:Connect(function(dt: number)
		self:onHeartbeat(dt)
	end)

	self:pushState(nil, true)
end

function WeatherServiceServer.Destroy(self: WeatherServiceServer)
	if self.playerAddedConnection ~= nil then
		self.playerAddedConnection:Disconnect()
		self.playerAddedConnection = nil
	end
	if self.playerRemovingConnection ~= nil then
		self.playerRemovingConnection:Disconnect()
		self.playerRemovingConnection = nil
	end
	if self.heartbeatConnection ~= nil then
		self.heartbeatConnection:Disconnect()
		self.heartbeatConnection = nil
	end

	if self.networker ~= nil then
		self.networker:destroy()
	end
end

WeatherServiceServer.rollNextWeatherDurationSeconds = WeatherServiceServer.RollNextWeatherDurationSeconds
WeatherServiceServer.createStateSnapshot = WeatherServiceServer.CreateStateSnapshot
WeatherServiceServer.pushState = WeatherServiceServer.PushState
WeatherServiceServer.setClockTime = WeatherServiceServer.SetClockTime
WeatherServiceServer.setDayNightCycleEnabled = WeatherServiceServer.SetDayNightCycleEnabled
WeatherServiceServer.setWeather = WeatherServiceServer.SetWeather
WeatherServiceServer.stepDayNight = WeatherServiceServer.StepDayNight
WeatherServiceServer.stepWeatherCycle = WeatherServiceServer.StepWeatherCycle
WeatherServiceServer.onHeartbeat = WeatherServiceServer.OnHeartbeat
WeatherServiceServer.trackPlayer = WeatherServiceServer.TrackPlayer
WeatherServiceServer.untrackPlayer = WeatherServiceServer.UntrackPlayer
WeatherServiceServer.requestSync = WeatherServiceServer.RequestSync
WeatherServiceServer.getState = WeatherServiceServer.GetState
WeatherServiceServer.init = WeatherServiceServer.Init
WeatherServiceServer.destroy = WeatherServiceServer.Destroy

export type WeatherServiceServer = typeof(WeatherServiceServer) & {
	networker: Networker.Server,
	config: WeatherServiceConfig,
	state: WeatherServiceState,
	random: Random,
	stateDirty: boolean,
	lastStatePushAt: number,
	weatherSecondsRemaining: number,
	playerAddedConnection: RBXScriptConnection?,
	playerRemovingConnection: RBXScriptConnection?,
	heartbeatConnection: RBXScriptConnection?,
}

return WeatherServiceServer :: WeatherServiceServer
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="1065">
              <Properties>
                <string name="Name">WorldGenerationServiceServer</string>
                <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local packageRoot = script:FindFirstAncestor("game").Parent
local loaderUtils = assert(packageRoot:FindFirstChild("LoaderUtils", true), "Missing LoaderUtils")
local loader = require(loaderUtils.Parent).load(script)

local Maid = loader("Maid")
local Rx = loader("Rx")
local RxSignal = loader("RxSignal")
local Signal = loader("Signal")

local Configs = require(script:FindFirstAncestor("game").Shared.Modules.Core.Configs)
local Networker = require(script:FindFirstAncestor("game").Shared.Modules.Networking.Networker)
local NevermoreSupport = require(script:FindFirstAncestor("game").Shared.Modules.Core.NevermoreSupport)
local ServerBinderSupport = require(script:FindFirstAncestor("game").Server.Binders.ServerBinderSupport)
local TagBinder = require(script:FindFirstAncestor("game").Shared.Binders.TagBinder)
local WorldGeneration = require(script:FindFirstAncestor("game").Shared.Classes.WorldGeneration)
local WorldGenerationServiceUtils =
	require(script:FindFirstAncestor("game").Shared.Services.WorldGenerationServiceUtils)
local WorldSimulationServiceServer =
	require(script:FindFirstAncestor("game").Server.Services.WorldSimulationServiceServer)

type WorldGenerationClass = WorldGeneration.WorldGeneration
type WorldGenerationConfig = WorldGenerationServiceUtils.WorldGenerationConfig
type WorldGenerationServiceState = WorldGenerationServiceUtils.WorldGenerationServiceState
type MaidClass = {
	Add: <T>(self: MaidClass, task: T) -> T,
	GiveTask: (self: MaidClass, task: any) -> number,
	DoCleaning: (self: MaidClass) -> (),
	Destroy: (self: MaidClass) -> (),
}
type SignalObject = {
	Connect: (self: SignalObject, callback: (...any) -> ()) -> RBXScriptConnection,
	Fire: (self: SignalObject, ...any) -> (),
	Destroy: (self: SignalObject) -> (),
}
type ObservableObject = {
	Subscribe: (
		self: ObservableObject,
		fireCallback: ((...any) -> ())?,
		failCallback: ((...any) -> ())?,
		completeCallback: ((...any) -> ())?
	) -> any,
	Pipe: (self: ObservableObject, transformers: { any }) -> ObservableObject,
}
type RxSignalObject = {
	Connect: (self: RxSignalObject, callback: (...any) -> ()) -> any,
}

type PlayerRenderSettings = {
	renderDistanceChunks: number,
	verticalRenderDistanceChunks: number,
}

type ChunkSendQueue = {
	sendQueue: { string },
	sendQueueHead: number,
	sendQueueTail: number,
	queuedLookup: { [string]: boolean },
}

type PlayerChunkStream = ChunkSendQueue & {
	interestKeys: { [string]: boolean },
	sentRevisions: { [string]: number },
}

type PlayerInterestChangedEvent = {
	player: Player,
	interestKeys: { [string]: boolean },
}

type ChunkLifecycleEvent = {
	chunkKey: string,
	chunkX: number,
	chunkY: number,
	context: { [string]: any },
}

local MIN_INT32_SEED = -2147483648
local MAX_INT32_SEED = 2147483647
local CHUNK_STREAM_SYNC_INTERVAL = 0.03
local CHUNK_STREAM_GLOBAL_BUDGET_PER_TICK = 64
local CHUNK_STREAM_PER_PLAYER_BUDGET_PER_TICK = 16
local CHUNK_STREAM_SIMULATION_BUDGET_PER_TICK = 24
local CHUNK_STREAM_MAX_QUEUE_PER_PLAYER = 4096

local function resolveConfigSource(): any
	if typeof(Configs) ~= "table" then
		return nil
	end
	return (Configs :: any).worldGeneration
end

local function cloneTableShallow(sourceRaw: any): { [any]: any }
	local source = if typeof(sourceRaw) == "table" then sourceRaw else {}
	local clone = {}
	for key, value in source do
		clone[key] = value
	end
	return clone
end

local function cloneBooleanLookup(sourceRaw: any): { [string]: boolean }
	local clone = {}
	if typeof(sourceRaw) ~= "table" then
		return clone
	end

	for key, value in sourceRaw do
		if typeof(key) == "string" and value == true then
			clone[key] = true
		end
	end

	return clone
end

local function countLookupEntries(lookup: { [any]: any }): number
	local count = 0
	for _ in lookup do
		count += 1
	end
	return count
end

local function isFiniteNumber(value: any): boolean
	return typeof(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

local function hasExplicitSeed(configSource: any): boolean
	if typeof(configSource) ~= "table" then
		return false
	end
	return isFiniteNumber((configSource :: any).seed)
end

local function resolveRuntimeSeed(configSource: any, sanitizedConfig: WorldGenerationConfig): number
	if hasExplicitSeed(configSource) then
		return sanitizedConfig.seed
	end
	return Random.new():NextInteger(MIN_INT32_SEED, MAX_INT32_SEED)
end

local function resolveStudioPreviewEnabled(configSource: any): boolean
	if typeof(configSource) ~= "table" then
		return false
	end
	local previewEnabled = (configSource :: any).studioPreviewEnabled
	if typeof(previewEnabled) == "boolean" then
		return previewEnabled
	end
	return false
end

local function packChunkKey(chunkX: number, chunkY: number): string
	return `{chunkX}:{chunkY}`
end

local function unpackChunkKey(chunkKey: string): (number?, number?)
	local xRaw, yRaw = string.match(chunkKey, "^(-?%d+):(-?%d+)$")
	if xRaw == nil or yRaw == nil then
		return nil, nil
	end
	return tonumber(xRaw), tonumber(yRaw)
end

local function toTileCoordinate(worldAxis: number, tileSize: number): number
	return math.floor(worldAxis / tileSize)
end

local function toChunkCoordinate(tile: number, chunkSize: number): number
	return math.floor(tile / chunkSize)
end

local function collectSortedInterestKeys(
	world: WorldGenerationClass,
	player: Player,
	interestKeys: { [string]: boolean }
): { string }
	local centerChunkX = 0
	local centerChunkY = 0
	local focusPosition = world:getPlayerFocusPosition(player)
	if typeof(focusPosition) == "Vector3" then
		local tileX = toTileCoordinate(focusPosition.Z - world.worldOrigin.Z, world.tileSize)
		local tileY = toTileCoordinate(focusPosition.Y - world.worldOrigin.Y, world.tileSize)
		centerChunkX = toChunkCoordinate(tileX, world.chunkSize)
		centerChunkY = toChunkCoordinate(tileY, world.chunkSize)
	end

	local entries = {}
	for chunkKey in interestKeys do
		local chunkX, chunkY = unpackChunkKey(chunkKey)
		local distanceSquared = math.huge
		if chunkX ~= nil and chunkY ~= nil then
			local deltaX = chunkX - centerChunkX
			local deltaY = chunkY - centerChunkY
			distanceSquared = deltaX * deltaX + deltaY * deltaY
		end
		entries[#entries + 1] = {
			key = chunkKey,
			distanceSquared = distanceSquared,
		}
	end

	table.sort(entries, function(left, right)
		if left.distanceSquared ~= right.distanceSquared then
			return left.distanceSquared < right.distanceSquared
		end
		return left.key < right.key
	end)

	local sortedKeys = table.create(#entries)
	for index, entry in entries do
		sortedKeys[index] = entry.key
	end
	return sortedKeys
end

local function isChunkYWithinBounds(config: WorldGenerationConfig, chunkY: number): boolean
	local chunkTileMinY = chunkY * config.chunkSize
	local chunkTileMaxY = chunkTileMinY + config.chunkSize - 1
	if chunkTileMaxY < config.minTileY then
		return false
	end
	if chunkTileMinY > config.maxTileY then
		return false
	end
	return true
end

local function enqueueChunkForStream(sendQueue: ChunkSendQueue, chunkKey: string)
	if sendQueue.queuedLookup[chunkKey] then
		return
	end
	if sendQueue.sendQueueTail - sendQueue.sendQueueHead + 1 >= CHUNK_STREAM_MAX_QUEUE_PER_PLAYER then
		return
	end
	sendQueue.queuedLookup[chunkKey] = true
	sendQueue.sendQueueTail += 1
	sendQueue.sendQueue[sendQueue.sendQueueTail] = chunkKey
end

local function dequeueChunkForStream(sendQueue: ChunkSendQueue): string?
	if sendQueue.sendQueueHead > sendQueue.sendQueueTail then
		if sendQueue.sendQueueHead ~= 1 or sendQueue.sendQueueTail ~= 0 then
			table.clear(sendQueue.sendQueue)
			sendQueue.sendQueueHead = 1
			sendQueue.sendQueueTail = 0
		end
		return nil
	end

	local chunkKey = sendQueue.sendQueue[sendQueue.sendQueueHead]
	if chunkKey == nil then
		return nil
	end

	sendQueue.sendQueue[sendQueue.sendQueueHead] = nil
	sendQueue.sendQueueHead += 1
	if sendQueue.sendQueueHead > sendQueue.sendQueueTail then
		table.clear(sendQueue.sendQueue)
		sendQueue.sendQueueHead = 1
		sendQueue.sendQueueTail = 0
	end

	sendQueue.queuedLookup[chunkKey] = nil
	return chunkKey
end

local WorldGenerationServiceServer = {}

function WorldGenerationServiceServer.Init(self: WorldGenerationServiceServer)
	self.maid = Maid.new() :: MaidClass
	local configSource = resolveConfigSource()
	self.config = WorldGenerationServiceUtils.sanitizeConfig(configSource, nil)
	self.config.seed = resolveRuntimeSeed(configSource, self.config)
	self.world = WorldGeneration.new(self.config)
	self.world:init()
	self.latestWorldStats = self.world:getStats()
	self:pushSeedToWorldSimulation()
	self.studioPreviewEnabled = RunService:IsStudio() and resolveStudioPreviewEnabled(configSource)
	self.studioPreviewInterestKeys = {}
	self.studioPreviewActive = false
	self.worldBootstrapPlayerUserId = nil

	self.binders = NevermoreSupport.getService(ServerBinderSupport)
	self.chunkBinder = self.binders:Get(TagBinder.Tags.Chunk)
	self.playerRenderSettings = {}
	self.playerChunkStreams = {}
	self.playersPendingSync = {} :: { [Player]: boolean }
	self.pendingPlayerInterest = {} :: { [Player]: { [string]: boolean } }
	self.worldSimulationChunkQueue = self:createChunkSendQueue()
	self.worldSimulationSentRevisions = {}
	self.chunkRuntimeByKey = {} :: { [string]: any }
	self.boundChunkRuntimeCount = 0
	self.chunkStreamAccumulator = CHUNK_STREAM_SYNC_INTERVAL
	self.worldObserverMaid = Maid.new() :: MaidClass
	self.maid:GiveTask(self.worldObserverMaid)
	self._stateChangedSignal = Signal.new() :: SignalObject
	self.stateChangedSignal = RxSignal.new(function(): ObservableObject
		return self:observeStateChanged()
	end) :: RxSignalObject
	self.maid:GiveTask(self._stateChangedSignal)
	self.networker = Networker.server.new("WorldGenerationService", self, {
		self.RequestSync,
		self.SetRenderDistance,
	})
	self.maid:GiveTask(function()
		if self.networker ~= nil then
			self.networker:destroy()
			self.networker = nil
		end
	end)
	self:connectReactiveWorldObservers()
	self:connectChunkBinderObservers()

	self.heartbeatConnection = RunService.Heartbeat:Connect(function(deltaTime: number)
		self:onHeartbeat(deltaTime)
	end)
	self.maid:GiveTask(self.heartbeatConnection)

	if
		self.studioPreviewEnabled
		and self.worldBootstrapPlayerUserId == nil
		and next(self.playerRenderSettings) == nil
	then
		self:enableStudioPreview()
	end

	for _, player in Players:GetPlayers() do
		self:trackPlayer(player)
	end

	self.playerAddedConnection = Players.PlayerAdded:Connect(function(player: Player)
		self:trackPlayer(player)
	end)
	self.maid:GiveTask(self.playerAddedConnection)

	self.playerRemovingConnection = Players.PlayerRemoving:Connect(function(player: Player)
		self:untrackPlayer(player)
		if
			self.studioPreviewEnabled
			and self.worldBootstrapPlayerUserId == nil
			and next(self.playerRenderSettings) == nil
		then
			self:enableStudioPreview()
		end
	end)
	self.maid:GiveTask(self.playerRemovingConnection)
end

function WorldGenerationServiceServer.ResetStreamingState(self: WorldGenerationServiceServer)
	for player, stream in self.playerChunkStreams do
		if self.networker ~= nil then
			for chunkKey in stream.interestKeys do
				self.networker:fire(player, "onChunkUnloaded", chunkKey)
			end
		end

		table.clear(stream.interestKeys)
		table.clear(stream.sentRevisions)
		table.clear(stream.queuedLookup)
		table.clear(stream.sendQueue)
		stream.sendQueueHead = 1
		stream.sendQueueTail = 0
		self.playersPendingSync[player] = nil
		self.pendingPlayerInterest[player] = nil
		self:pushPlayerInterestToWorldSimulation(player, {})
	end

	table.clear(self.worldSimulationSentRevisions)
	table.clear(self.worldSimulationChunkQueue.sendQueue)
	table.clear(self.worldSimulationChunkQueue.queuedLookup)
	self.worldSimulationChunkQueue.sendQueueHead = 1
	self.worldSimulationChunkQueue.sendQueueTail = 0
	table.clear(self.playersPendingSync)
	table.clear(self.pendingPlayerInterest)
end

function WorldGenerationServiceServer.LoadWorld(self: WorldGenerationServiceServer, worldRaw: any)
	local worldSource = if typeof(worldRaw) == "table" then worldRaw else {}
	local configSource = cloneTableShallow(resolveConfigSource())
	for key, value in worldSource do
		if
			key == "seed"
			or key == "worldOrigin"
			or key == "minTileY"
			or key == "maxTileY"
			or key == "bedrockThickness"
		then
			configSource[key] = value
		end
	end

	local nextConfig = WorldGenerationServiceUtils.sanitizeConfig(configSource, nil)
	nextConfig.seed = resolveRuntimeSeed(configSource, nextConfig)

	self:disableStudioPreview()
	self:resetStreamingState()
	if self.worldObserverMaid ~= nil then
		self.worldObserverMaid:DoCleaning()
	end

	if self.world ~= nil then
		self.world:destroy()
	end
	table.clear(self.chunkRuntimeByKey)
	self.boundChunkRuntimeCount = 0

	self.config = nextConfig
	self.world = WorldGeneration.new(self.config)
	self.world:init()
	self.latestWorldStats = self.world:getStats()
	self:connectReactiveWorldObservers()
	self:pushSeedToWorldSimulation()

	for _, player in Players:GetPlayers() do
		self:trackPlayer(player)
	end

	if
		self.studioPreviewEnabled
		and self.worldBootstrapPlayerUserId == nil
		and next(self.playerRenderSettings) == nil
	then
		self:enableStudioPreview()
	end
end

function WorldGenerationServiceServer.BuildStudioPreviewInterest(
	self: WorldGenerationServiceServer
): { [string]: boolean }
	local renderDistance = self.config.defaultRenderDistanceChunks
	local verticalRenderDistance = self.config.defaultVerticalRenderDistanceChunks
	local centerChunkX = 0
	local centerChunkY = 0
	local radiusSquared = renderDistance * renderDistance
	local nextInterest: { [string]: boolean } = {}

	for offsetY = -verticalRenderDistance, verticalRenderDistance do
		local chunkY = centerChunkY + offsetY
		if not isChunkYWithinBounds(self.config, chunkY) then
			continue
		end

		for offsetX = -renderDistance, renderDistance do
			if offsetX * offsetX + offsetY * offsetY > radiusSquared then
				continue
			end
			local chunkX = centerChunkX + offsetX
			nextInterest[packChunkKey(chunkX, chunkY)] = true
		end
	end

	return nextInterest
end

function WorldGenerationServiceServer.ApplyStudioPreviewInterest(
	self: WorldGenerationServiceServer,
	nextInterest: { [string]: boolean }
)
	for chunkKey in nextInterest do
		if self.studioPreviewInterestKeys[chunkKey] then
			continue
		end
		self.world:adjustChunkDemand(chunkKey, 1)
	end

	for chunkKey in self.studioPreviewInterestKeys do
		if nextInterest[chunkKey] then
			continue
		end
		self.world:adjustChunkDemand(chunkKey, -1)
	end

	self.studioPreviewInterestKeys = nextInterest
end

function WorldGenerationServiceServer.EnableStudioPreview(self: WorldGenerationServiceServer)
	if not self.studioPreviewEnabled then
		return
	end
	if self.studioPreviewActive then
		return
	end
	self.studioPreviewActive = true
	self:applyStudioPreviewInterest(self:buildStudioPreviewInterest())
end

function WorldGenerationServiceServer.DisableStudioPreview(self: WorldGenerationServiceServer)
	if not self.studioPreviewActive then
		return
	end
	self.studioPreviewActive = false
	self:applyStudioPreviewInterest({})
end

function WorldGenerationServiceServer.GetOrCreatePlayerRenderSettings(
	self: WorldGenerationServiceServer,
	player: Player
): PlayerRenderSettings
	local existing = self.playerRenderSettings[player]
	if existing then
		return existing
	end

	local settings: PlayerRenderSettings = {
		renderDistanceChunks = self.config.defaultRenderDistanceChunks,
		verticalRenderDistanceChunks = self.config.defaultVerticalRenderDistanceChunks,
	}
	self.playerRenderSettings[player] = settings
	return settings
end

function WorldGenerationServiceServer.CreateStateSnapshot(
	self: WorldGenerationServiceServer,
	player: Player
): WorldGenerationServiceState
	local renderSettings = self:getOrCreatePlayerRenderSettings(player)
	local stats = cloneTableShallow(self.latestWorldStats or self.world:getStats())
	stats.boundCollisionChunkModels = self.boundChunkRuntimeCount
	local snapshot = WorldGenerationServiceUtils.createState({
		seed = self.config.seed,
		chunkSize = self.config.chunkSize,
		tileSize = self.world.tileSize,
		tileDepth = self.world.tileDepth,
		renderDistanceChunks = renderSettings.renderDistanceChunks,
		verticalRenderDistanceChunks = renderSettings.verticalRenderDistanceChunks,
		minTileY = self.config.minTileY,
		maxTileY = self.config.maxTileY,
		ready = true,
		stats = stats,
	}, nil)
	return snapshot
end

function WorldGenerationServiceServer.PushState(self: WorldGenerationServiceServer, player: Player)
	if self.networker == nil then
		return
	end

	local snapshot = self:createStateSnapshot(player)
	self.networker:fire(player, "applyState", snapshot)
	self:emitStateChanged(player, snapshot)
end

function WorldGenerationServiceServer.CreateChunkSendQueue(self: WorldGenerationServiceServer): ChunkSendQueue
	return {
		sendQueue = {},
		sendQueueHead = 1,
		sendQueueTail = 0,
		queuedLookup = {},
	}
end

function WorldGenerationServiceServer.CreateChunkStream(self: WorldGenerationServiceServer): PlayerChunkStream
	local sendQueue = self:createChunkSendQueue()
	return {
		interestKeys = {},
		sentRevisions = {},
		sendQueue = sendQueue.sendQueue,
		sendQueueHead = sendQueue.sendQueueHead,
		sendQueueTail = sendQueue.sendQueueTail,
		queuedLookup = sendQueue.queuedLookup,
	}
end

function WorldGenerationServiceServer.ObserveStateChanged(
	self: WorldGenerationServiceServer,
	playerRaw: any?
): ObservableObject
	local targetPlayer = if typeof(playerRaw) == "Instance" and playerRaw:IsA("Player") then playerRaw else nil
	return Rx.fromSignal(self._stateChangedSignal):Pipe({
		Rx.where(function(player: Player)
			return targetPlayer == nil or player == targetPlayer
		end),
	}) :: ObservableObject
end

function WorldGenerationServiceServer.EmitStateChanged(
	self: WorldGenerationServiceServer,
	player: Player,
	snapshot: WorldGenerationServiceState
)
	self._stateChangedSignal:Fire(player, snapshot)
end

function WorldGenerationServiceServer.MarkPlayerStreamDirty(
	self: WorldGenerationServiceServer,
	player: Player,
	interestOverrideRaw: any?
)
	if self.playerRenderSettings[player] == nil then
		return
	end

	self.playersPendingSync[player] = true
	if typeof(interestOverrideRaw) == "table" then
		self.pendingPlayerInterest[player] = cloneBooleanLookup(interestOverrideRaw)
	end
end

function WorldGenerationServiceServer.QueueChunkForInterestedPlayers(
	self: WorldGenerationServiceServer,
	chunkKeyRaw: any,
	revisionRaw: number?
)
	if typeof(chunkKeyRaw) ~= "string" or chunkKeyRaw == "" then
		return
	end

	local revision = revisionRaw
	if revision == nil then
		revision = self.world:getChunkRevisionByKey(chunkKeyRaw)
	end

	for _, player in self.world:getPlayersInterestedInChunk(chunkKeyRaw) do
		local stream = self:getOrCreateChunkStream(player)
		if stream.interestKeys[chunkKeyRaw] == true then
			enqueueChunkForStream(stream, chunkKeyRaw)
		end
	end

	self:enqueueChunkForWorldSimulation(chunkKeyRaw, revision)
end

function WorldGenerationServiceServer.ConnectReactiveWorldObservers(self: WorldGenerationServiceServer)
	local observerMaid = self.worldObserverMaid
	observerMaid:DoCleaning()

	observerMaid:GiveTask(self.world:observeStats():Subscribe(function(stats)
		if typeof(stats) == "table" then
			self.latestWorldStats = stats
		end
	end))

	observerMaid:GiveTask(self.world:observePlayerInterest():Subscribe(function(event: PlayerInterestChangedEvent)
		if typeof(event) ~= "table" then
			return
		end
		if typeof(event.player) ~= "Instance" or not event.player:IsA("Player") then
			return
		end
		self:markPlayerStreamDirty(event.player, event.interestKeys)
	end))

	observerMaid:GiveTask(self.world:observeChunkCollisionReady():Subscribe(function(event: ChunkLifecycleEvent)
		if typeof(event) ~= "table" then
			return
		end
		self:queueChunkForInterestedPlayers(event.chunkKey)
	end))

	observerMaid:GiveTask(self.world:observeChunkTerrainChanged():Subscribe(function(event: ChunkLifecycleEvent)
		if typeof(event) ~= "table" then
			return
		end
		self:queueChunkForInterestedPlayers(event.chunkKey)
	end))

	observerMaid:GiveTask(self.world:observeChunkCollisionUnloaded():Subscribe(function(event: ChunkLifecycleEvent)
		if typeof(event) ~= "table" or typeof(event.chunkKey) ~= "string" then
			return
		end
		self.worldSimulationSentRevisions[event.chunkKey] = nil
	end))
end

function WorldGenerationServiceServer.ConnectChunkBinderObservers(self: WorldGenerationServiceServer)
	if self.chunkBinder == nil then
		return
	end

	self.maid:GiveTask(self.chunkBinder:ObserveAllBrio():Subscribe(function(brio)
		if brio == nil or typeof(brio) ~= "table" or typeof((brio :: any).GetValue) ~= "function" then
			return
		end

		local runtime = brio:GetValue()
		if runtime == nil then
			return
		end

		local chunkKey = if typeof((runtime :: any).GetChunkKey) == "function"
			then (runtime :: any):GetChunkKey()
			else ((runtime :: any).chunkKey or "")
		if typeof(chunkKey) ~= "string" or chunkKey == "" then
			return
		end

		local brioMaid = brio:ToMaid()
		self.chunkRuntimeByKey[chunkKey] = runtime
		self.boundChunkRuntimeCount = countLookupEntries(self.chunkRuntimeByKey)
		brioMaid:GiveTask(function()
			if self.chunkRuntimeByKey[chunkKey] == runtime then
				self.chunkRuntimeByKey[chunkKey] = nil
			end
			self.boundChunkRuntimeCount = countLookupEntries(self.chunkRuntimeByKey)
		end)
	end))
end

function WorldGenerationServiceServer.PushSeedToWorldSimulation(self: WorldGenerationServiceServer)
	local setAuthoritativeSeedMethod = (WorldSimulationServiceServer :: any).setAuthoritativeSeed
	if typeof(setAuthoritativeSeedMethod) ~= "function" then
		return
	end
	pcall(function()
		local worldSimulationServiceAny = WorldSimulationServiceServer :: any
		worldSimulationServiceAny:setAuthoritativeSeed(self.config.seed)
	end)
end

function WorldGenerationServiceServer.PushPlayerInterestToWorldSimulation(
	self: WorldGenerationServiceServer,
	player: Player,
	interestKeys: { [string]: boolean }
)
	local hasAnyInterest = false
	for _ in interestKeys do
		hasAnyInterest = true
		break
	end

	if not hasAnyInterest then
		local clearInterestMethod = (WorldSimulationServiceServer :: any).clearGeneratedPlayerInterest
		if typeof(clearInterestMethod) == "function" then
			pcall(function()
				local worldSimulationServiceAny = WorldSimulationServiceServer :: any
				worldSimulationServiceAny:clearGeneratedPlayerInterest(player)
			end)
			return
		end
	end

	local pushInterestMethod = (WorldSimulationServiceServer :: any).pushGeneratedPlayerInterest
	if typeof(pushInterestMethod) ~= "function" then
		return
	end
	pcall(function()
		local worldSimulationServiceAny = WorldSimulationServiceServer :: any
		worldSimulationServiceAny:pushGeneratedPlayerInterest(player, interestKeys)
	end)
end

function WorldGenerationServiceServer.PushChunkSnapshotToWorldSimulation(
	self: WorldGenerationServiceServer,
	snapshotRaw: any
): boolean
	local registerChunkMethod = (WorldSimulationServiceServer :: any).registerGeneratedChunkSnapshot
	if typeof(registerChunkMethod) ~= "function" then
		return false
	end
	local ok = pcall(function()
		local worldSimulationServiceAny = WorldSimulationServiceServer :: any
		worldSimulationServiceAny:registerGeneratedChunkSnapshot(snapshotRaw)
	end)
	return ok
end

function WorldGenerationServiceServer.PushPlayerRenderDistanceToWorldSimulation(
	self: WorldGenerationServiceServer,
	player: Player,
	renderDistance: number,
	verticalRenderDistance: number
)
	local setStreamRadiusMethod = (WorldSimulationServiceServer :: any).setStreamRadius
	if typeof(setStreamRadiusMethod) ~= "function" then
		return
	end
	pcall(function()
		local worldSimulationServiceAny = WorldSimulationServiceServer :: any
		worldSimulationServiceAny:setStreamRadius(player, renderDistance, verticalRenderDistance)
	end)
end

function WorldGenerationServiceServer.GetOrCreateChunkStream(
	self: WorldGenerationServiceServer,
	player: Player
): PlayerChunkStream
	local existing = self.playerChunkStreams[player]
	if existing ~= nil then
		return existing
	end

	local stream = self:createChunkStream()
	self.playerChunkStreams[player] = stream
	return stream
end

function WorldGenerationServiceServer.ResetChunkStream(self: WorldGenerationServiceServer, player: Player)
	local stream = self:getOrCreateChunkStream(player)
	table.clear(stream.sentRevisions)
	table.clear(stream.queuedLookup)
	table.clear(stream.sendQueue)
	stream.sendQueueHead = 1
	stream.sendQueueTail = 0
	self.pendingPlayerInterest[player] = nil
end

function WorldGenerationServiceServer.EnqueueChunkForWorldSimulation(
	self: WorldGenerationServiceServer,
	chunkKey: string,
	revisionRaw: number?
)
	local revision = revisionRaw
	if revision == nil then
		revision = self.world:getChunkRevisionByKey(chunkKey)
	end
	if self.worldSimulationSentRevisions[chunkKey] == revision then
		return
	end
	enqueueChunkForStream(self.worldSimulationChunkQueue, chunkKey)
end

function WorldGenerationServiceServer.EnqueueAffectedWorldSimulationChunkKeysForTile(
	self: WorldGenerationServiceServer,
	tileX: number,
	tileY: number
)
	local chunkSize = self.config.chunkSize
	local chunkX = math.floor(tileX / chunkSize)
	local chunkY = math.floor(tileY / chunkSize)
	if not isChunkYWithinBounds(self.config, chunkY) then
		return
	end

	local localTileX = tileX - chunkX * chunkSize
	local localTileY = tileY - chunkY * chunkSize
	self:enqueueChunkForWorldSimulation(packChunkKey(chunkX, chunkY))

	if localTileX == 0 then
		self:enqueueChunkForWorldSimulation(packChunkKey(chunkX - 1, chunkY))
	elseif localTileX == chunkSize - 1 then
		self:enqueueChunkForWorldSimulation(packChunkKey(chunkX + 1, chunkY))
	end

	if localTileY == 0 then
		local belowChunkY = chunkY - 1
		if isChunkYWithinBounds(self.config, belowChunkY) then
			self:enqueueChunkForWorldSimulation(packChunkKey(chunkX, belowChunkY))
		end
	elseif localTileY == chunkSize - 1 then
		local aboveChunkY = chunkY + 1
		if isChunkYWithinBounds(self.config, aboveChunkY) then
			self:enqueueChunkForWorldSimulation(packChunkKey(chunkX, aboveChunkY))
		end
	end
end

function WorldGenerationServiceServer.SyncPlayerChunkStream(
	self: WorldGenerationServiceServer,
	player: Player,
	stream: PlayerChunkStream,
	nextInterestRaw: { [string]: boolean }?
)
	local world = self.world
	local nextInterest = if typeof(nextInterestRaw) == "table"
		then cloneBooleanLookup(nextInterestRaw)
		else world:getPlayerInterestKeys(player)
	self:pushPlayerInterestToWorldSimulation(player, nextInterest)

	for _, chunkKey in collectSortedInterestKeys(world, player, nextInterest) do
		local revision = world:getChunkRevisionByKey(chunkKey)
		self:enqueueChunkForWorldSimulation(chunkKey, revision)
		if not world:isChunkCollisionReadyByKey(chunkKey) then
			continue
		end
		if stream.sentRevisions[chunkKey] ~= revision then
			enqueueChunkForStream(stream, chunkKey)
		elseif stream.interestKeys[chunkKey] == nil then
			enqueueChunkForStream(stream, chunkKey)
		end
	end

	for chunkKey in stream.interestKeys do
		if nextInterest[chunkKey] then
			continue
		end
		stream.sentRevisions[chunkKey] = nil
		if self.networker then
			self.networker:fire(player, "onChunkUnloaded", chunkKey)
		end
	end

	stream.interestKeys = nextInterest
end

function WorldGenerationServiceServer.ProcessChunkStreamQueues(self: WorldGenerationServiceServer)
	local totalProcessed = 0

	for player, stream in self.playerChunkStreams do
		if totalProcessed >= CHUNK_STREAM_GLOBAL_BUDGET_PER_TICK then
			break
		end

		local perPlayerProcessed = 0
		while
			perPlayerProcessed < CHUNK_STREAM_PER_PLAYER_BUDGET_PER_TICK
			and totalProcessed < CHUNK_STREAM_GLOBAL_BUDGET_PER_TICK
		do
			local chunkKey = dequeueChunkForStream(stream)
			if chunkKey == nil then
				break
			end
			if stream.interestKeys[chunkKey] == nil then
				continue
			end

			local revision = self.world:getChunkRevisionByKey(chunkKey)
			if stream.sentRevisions[chunkKey] == revision then
				continue
			end
			if not self.world:isChunkCollisionReadyByKey(chunkKey) then
				continue
			end

			local snapshot = self.world:getChunkSnapshotByKey(chunkKey)
			if snapshot == nil then
				continue
			end

			if self.networker then
				self.networker:fire(player, "onChunkSnapshot", snapshot)
			end
			stream.sentRevisions[chunkKey] = revision
			perPlayerProcessed += 1
			totalProcessed += 1
		end
	end
end

function WorldGenerationServiceServer.ProcessWorldSimulationChunkQueue(self: WorldGenerationServiceServer)
	local processed = 0
	local maxProcessed = CHUNK_STREAM_SIMULATION_BUDGET_PER_TICK
	local world = self.world

	while processed < maxProcessed do
		local chunkKey = dequeueChunkForStream(self.worldSimulationChunkQueue)
		if chunkKey == nil then
			break
		end

		local revision = world:getChunkRevisionByKey(chunkKey)
		if self.worldSimulationSentRevisions[chunkKey] == revision then
			continue
		end

		local snapshot = world:getChunkSnapshotByKey(chunkKey)
		if snapshot == nil then
			continue
		end

		if not self:pushChunkSnapshotToWorldSimulation(snapshot) then
			enqueueChunkForStream(self.worldSimulationChunkQueue, chunkKey)
			break
		end

		self.worldSimulationSentRevisions[chunkKey] = revision
		processed += 1
	end
end

function WorldGenerationServiceServer.OnHeartbeat(self: WorldGenerationServiceServer, deltaTime: number)
	self.chunkStreamAccumulator += deltaTime
	if self.chunkStreamAccumulator < CHUNK_STREAM_SYNC_INTERVAL then
		return
	end
	self.chunkStreamAccumulator = 0

	for player in self.playersPendingSync do
		local stream = self:getOrCreateChunkStream(player)
		self:syncPlayerChunkStream(player, stream, self.pendingPlayerInterest[player])
		self.playersPendingSync[player] = nil
		self.pendingPlayerInterest[player] = nil
	end

	self:processChunkStreamQueues()
	self:processWorldSimulationChunkQueue()
end

function WorldGenerationServiceServer.TrackPlayer(self: WorldGenerationServiceServer, player: Player)
	if self.worldBootstrapPlayerUserId == nil then
		self.worldBootstrapPlayerUserId = player.UserId
		if self.studioPreviewActive then
			self:disableStudioPreview()
		end
	end

	local renderSettings = self:getOrCreatePlayerRenderSettings(player)
	self.world:trackPlayer(player, renderSettings.renderDistanceChunks, renderSettings.verticalRenderDistanceChunks)
	self:pushPlayerRenderDistanceToWorldSimulation(
		player,
		renderSettings.renderDistanceChunks,
		renderSettings.verticalRenderDistanceChunks
	)
	self:resetChunkStream(player)
	self:markPlayerStreamDirty(player, self.world:getPlayerInterestKeys(player))
	self:pushState(player)
end

function WorldGenerationServiceServer.UntrackPlayer(self: WorldGenerationServiceServer, player: Player)
	self.playerRenderSettings[player] = nil
	self.playerChunkStreams[player] = nil
	self.playersPendingSync[player] = nil
	self.pendingPlayerInterest[player] = nil
	self.world:untrackPlayer(player)
	self:pushPlayerInterestToWorldSimulation(player, {})
end

function WorldGenerationServiceServer.RequestSync(self: WorldGenerationServiceServer, player: Player)
	if self.playerRenderSettings[player] == nil then
		self:trackPlayer(player)
		return
	end
	self:resetChunkStream(player)
	self:markPlayerStreamDirty(player, self.world:getPlayerInterestKeys(player))
	self:pushState(player)
end

function WorldGenerationServiceServer.SetRenderDistance(
	self: WorldGenerationServiceServer,
	player: Player,
	renderDistanceRaw: any,
	verticalRenderDistanceRaw: any?
)
	local renderSettings = self:getOrCreatePlayerRenderSettings(player)
	local nextRenderDistance =
		WorldGenerationServiceUtils.sanitizeRenderDistance(renderDistanceRaw, renderSettings.renderDistanceChunks)
	local nextVerticalRenderDistance = WorldGenerationServiceUtils.sanitizeVerticalRenderDistance(
		verticalRenderDistanceRaw,
		renderSettings.verticalRenderDistanceChunks
	)

	renderSettings.renderDistanceChunks = nextRenderDistance
	renderSettings.verticalRenderDistanceChunks = nextVerticalRenderDistance
	self.world:setPlayerRenderDistance(player, nextRenderDistance, nextVerticalRenderDistance)
	self:pushPlayerRenderDistanceToWorldSimulation(player, nextRenderDistance, nextVerticalRenderDistance)
	self:resetChunkStream(player)
	self:markPlayerStreamDirty(player, self.world:getPlayerInterestKeys(player))
	self:pushState(player)
end

function WorldGenerationServiceServer.GetWorld(self: WorldGenerationServiceServer): WorldGenerationClass
	return self.world
end

function WorldGenerationServiceServer.SetTileAt(
	self: WorldGenerationServiceServer,
	tileXRaw: any,
	tileYRaw: any,
	tileIdRaw: any
): (boolean, number, number)
	local changed, previousTileId, nextTileId = self.world:setTileAt(tileXRaw, tileYRaw, tileIdRaw)
	if changed and isFiniteNumber(tileXRaw) and isFiniteNumber(tileYRaw) then
		self:enqueueAffectedWorldSimulationChunkKeysForTile(math.floor(tileXRaw), math.floor(tileYRaw))
	end
	return changed, previousTileId, nextTileId
end

function WorldGenerationServiceServer.GetBiomeTypeAt(
	self: WorldGenerationServiceServer,
	tileXRaw: any,
	tileYRaw: any
): number
	return self.world:getBiomeTypeAt(tileXRaw, tileYRaw)
end

function WorldGenerationServiceServer.GetBiomeTypeAtWorldPosition(
	self: WorldGenerationServiceServer,
	worldPosition: Vector3
): number
	return self.world:getBiomeTypeAtWorldPosition(worldPosition)
end

function WorldGenerationServiceServer.SetBiomeTypeAt(
	self: WorldGenerationServiceServer,
	tileXRaw: any,
	tileYRaw: any,
	biomeTypeRaw: any
): (boolean, number, number)
	local changed, previousBiomeType, nextBiomeType = self.world:setBiomeTypeAt(tileXRaw, tileYRaw, biomeTypeRaw)
	if changed and isFiniteNumber(tileXRaw) and isFiniteNumber(tileYRaw) then
		self:enqueueAffectedWorldSimulationChunkKeysForTile(math.floor(tileXRaw), math.floor(tileYRaw))
	end
	return changed, previousBiomeType, nextBiomeType
end

function WorldGenerationServiceServer.SetTileAtWorldPosition(
	self: WorldGenerationServiceServer,
	worldPosition: Vector3,
	tileIdRaw: any
): (boolean, number, number)
	local tileX = toTileCoordinate(worldPosition.Z - self.world.worldOrigin.Z, self.world.tileSize)
	local tileY = toTileCoordinate(worldPosition.Y - self.world.worldOrigin.Y, self.world.tileSize)
	return self:setTileAt(tileX, tileY, tileIdRaw)
end

function WorldGenerationServiceServer.SetBiomeTypeAtWorldPosition(
	self: WorldGenerationServiceServer,
	worldPosition: Vector3,
	biomeTypeRaw: any
): (boolean, number, number)
	local tileX = toTileCoordinate(worldPosition.Z - self.world.worldOrigin.Z, self.world.tileSize)
	local tileY = toTileCoordinate(worldPosition.Y - self.world.worldOrigin.Y, self.world.tileSize)
	return self:setBiomeTypeAt(tileX, tileY, biomeTypeRaw)
end

function WorldGenerationServiceServer.GetConfig(self: WorldGenerationServiceServer): WorldGenerationConfig
	return self.config
end

function WorldGenerationServiceServer.Destroy(self: WorldGenerationServiceServer)
	self:disableStudioPreview()
	if self.worldObserverMaid ~= nil then
		self.worldObserverMaid:DoCleaning()
	end

	local playersToUntrack = {}
	for player in self.playerRenderSettings do
		table.insert(playersToUntrack, player)
	end
	for _, player in playersToUntrack do
		self:untrackPlayer(player)
	end
	table.clear(self.playerChunkStreams)
	table.clear(self.playersPendingSync)
	table.clear(self.pendingPlayerInterest)
	table.clear(self.chunkRuntimeByKey)

	if self.world then
		self.world:destroy()
	end

	if self.maid ~= nil then
		self.maid:Destroy()
	end
	self.heartbeatConnection = nil
	self.playerAddedConnection = nil
	self.playerRemovingConnection = nil
end

WorldGenerationServiceServer.init = WorldGenerationServiceServer.Init
WorldGenerationServiceServer.resetStreamingState = WorldGenerationServiceServer.ResetStreamingState
WorldGenerationServiceServer.loadWorld = WorldGenerationServiceServer.LoadWorld
WorldGenerationServiceServer.buildStudioPreviewInterest = WorldGenerationServiceServer.BuildStudioPreviewInterest
WorldGenerationServiceServer.applyStudioPreviewInterest = WorldGenerationServiceServer.ApplyStudioPreviewInterest
WorldGenerationServiceServer.enableStudioPreview = WorldGenerationServiceServer.EnableStudioPreview
WorldGenerationServiceServer.disableStudioPreview = WorldGenerationServiceServer.DisableStudioPreview
WorldGenerationServiceServer.getOrCreatePlayerRenderSettings =
	WorldGenerationServiceServer.GetOrCreatePlayerRenderSettings
WorldGenerationServiceServer.createStateSnapshot = WorldGenerationServiceServer.CreateStateSnapshot
WorldGenerationServiceServer.pushState = WorldGenerationServiceServer.PushState
WorldGenerationServiceServer.createChunkSendQueue = WorldGenerationServiceServer.CreateChunkSendQueue
WorldGenerationServiceServer.createChunkStream = WorldGenerationServiceServer.CreateChunkStream
WorldGenerationServiceServer.observeStateChanged = WorldGenerationServiceServer.ObserveStateChanged
WorldGenerationServiceServer.emitStateChanged = WorldGenerationServiceServer.EmitStateChanged
WorldGenerationServiceServer.markPlayerStreamDirty = WorldGenerationServiceServer.MarkPlayerStreamDirty
WorldGenerationServiceServer.queueChunkForInterestedPlayers =
	WorldGenerationServiceServer.QueueChunkForInterestedPlayers
WorldGenerationServiceServer.connectReactiveWorldObservers = WorldGenerationServiceServer.ConnectReactiveWorldObservers
WorldGenerationServiceServer.connectChunkBinderObservers = WorldGenerationServiceServer.ConnectChunkBinderObservers
WorldGenerationServiceServer.pushSeedToWorldSimulation = WorldGenerationServiceServer.PushSeedToWorldSimulation
WorldGenerationServiceServer.pushPlayerInterestToWorldSimulation =
	WorldGenerationServiceServer.PushPlayerInterestToWorldSimulation
WorldGenerationServiceServer.pushChunkSnapshotToWorldSimulation =
	WorldGenerationServiceServer.PushChunkSnapshotToWorldSimulation
WorldGenerationServiceServer.pushPlayerRenderDistanceToWorldSimulation =
	WorldGenerationServiceServer.PushPlayerRenderDistanceToWorldSimulation
WorldGenerationServiceServer.getOrCreateChunkStream = WorldGenerationServiceServer.GetOrCreateChunkStream
WorldGenerationServiceServer.resetChunkStream = WorldGenerationServiceServer.ResetChunkStream
WorldGenerationServiceServer.enqueueChunkForWorldSimulation =
	WorldGenerationServiceServer.EnqueueChunkForWorldSimulation
WorldGenerationServiceServer.enqueueAffectedWorldSimulationChunkKeysForTile =
	WorldGenerationServiceServer.EnqueueAffectedWorldSimulationChunkKeysForTile
WorldGenerationServiceServer.syncPlayerChunkStream = WorldGenerationServiceServer.SyncPlayerChunkStream
WorldGenerationServiceServer.processChunkStreamQueues = WorldGenerationServiceServer.ProcessChunkStreamQueues
WorldGenerationServiceServer.processWorldSimulationChunkQueue =
	WorldGenerationServiceServer.ProcessWorldSimulationChunkQueue
WorldGenerationServiceServer.onHeartbeat = WorldGenerationServiceServer.OnHeartbeat
WorldGenerationServiceServer.trackPlayer = WorldGenerationServiceServer.TrackPlayer
WorldGenerationServiceServer.untrackPlayer = WorldGenerationServiceServer.UntrackPlayer
WorldGenerationServiceServer.requestSync = WorldGenerationServiceServer.RequestSync
WorldGenerationServiceServer.setRenderDistance = WorldGenerationServiceServer.SetRenderDistance
WorldGenerationServiceServer.getWorld = WorldGenerationServiceServer.GetWorld
WorldGenerationServiceServer.setTileAt = WorldGenerationServiceServer.SetTileAt
WorldGenerationServiceServer.getBiomeTypeAt = WorldGenerationServiceServer.GetBiomeTypeAt
WorldGenerationServiceServer.getBiomeTypeAtWorldPosition = WorldGenerationServiceServer.GetBiomeTypeAtWorldPosition
WorldGenerationServiceServer.setBiomeTypeAt = WorldGenerationServiceServer.SetBiomeTypeAt
WorldGenerationServiceServer.setTileAtWorldPosition = WorldGenerationServiceServer.SetTileAtWorldPosition
WorldGenerationServiceServer.setBiomeTypeAtWorldPosition = WorldGenerationServiceServer.SetBiomeTypeAtWorldPosition
WorldGenerationServiceServer.getConfig = WorldGenerationServiceServer.GetConfig
WorldGenerationServiceServer.destroy = WorldGenerationServiceServer.Destroy

type WorldGenerationServiceServer = typeof(WorldGenerationServiceServer) & {
	maid: MaidClass,
	networker: Networker.Server,
	world: WorldGenerationClass,
	config: WorldGenerationConfig,
	binders: any,
	chunkBinder: any,
	playerRenderSettings: { [Player]: PlayerRenderSettings },
	playersPendingSync: { [Player]: boolean },
	pendingPlayerInterest: { [Player]: { [string]: boolean } },
	studioPreviewEnabled: boolean,
	studioPreviewActive: boolean,
	studioPreviewInterestKeys: { [string]: boolean },
	worldBootstrapPlayerUserId: number?,
	playerChunkStreams: { [Player]: PlayerChunkStream },
	worldSimulationChunkQueue: ChunkSendQueue,
	worldSimulationSentRevisions: { [string]: number },
	chunkRuntimeByKey: { [string]: any },
	boundChunkRuntimeCount: number,
	latestWorldStats: { [string]: any },
	chunkStreamAccumulator: number,
	worldObserverMaid: MaidClass,
	_stateChangedSignal: SignalObject,
	stateChangedSignal: RxSignalObject,
	heartbeatConnection: RBXScriptConnection?,
	playerAddedConnection: RBXScriptConnection?,
	playerRemovingConnection: RBXScriptConnection?,
}

return WorldGenerationServiceServer :: WorldGenerationServiceServer
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="1066">
              <Properties>
                <string name="Name">WorldSimulationServiceServer</string>
                <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerScriptService = game:GetService("ServerScriptService")

local CmdrUtils = require(script:FindFirstAncestor("game").Shared.Cmdr.CmdrUtils)
local CoreConfigs = require(script:FindFirstAncestor("game").Shared.Modules.Core.Configs)
local CoreRuntime = require(script:FindFirstAncestor("game").Shared.Modules.Core.Runtime)
local Matter = require(ReplicatedStorage.Packages.Matter)
local Networker = require(script:FindFirstAncestor("game").Shared.Modules.Networking.Networker)
local Plasma = require(ReplicatedStorage.Packages.Plasma)
local PlayerServiceServer = require(script:FindFirstAncestor("game").Server.Services.PlayerServiceServer)

local Cache = require(script:FindFirstAncestor("game").Shared.Services.SimulationCache)
local Config = require(script:FindFirstAncestor("game").Shared.Services.SimulationConfig)
local Data = require(script:FindFirstAncestor("game").Shared.Services.SimulationData)
local Debug = require(script:FindFirstAncestor("game").Shared.Services.Debug)
local Net = require(script:FindFirstAncestor("game").Shared.Services.Net)
local Runtime = require(script:FindFirstAncestor("game").Shared.Services.SimulationRuntime)
local Shared = require(script:FindFirstAncestor("game").Shared.Services.Shared)
local State = require(script:FindFirstAncestor("game").Shared.Services.SimulationState)
local Stream = require(script:FindFirstAncestor("game").Shared.Services.Stream)

type SimulationConfig = Config.SimulationConfig
type WorldData = Data.WorldData
type RuntimeObject = Runtime.Runtime
type ServerStreamState = Stream.ServerStreamState
type PlayerStreamState = Stream.PlayerStreamState
type GeneratedPlayerInterest = { [string]: number }

type PlayerSettings = {
	streamRadius: number,
	streamVerticalRadius: number,
}

local WorldSimulationServiceServer = {}

local DEBUG_COUNTER_PUSH_INTERVAL = 0.5
local SIMULATION_CHUNK_Z = 0
local WORLD_GENERATION_CHUNK_KEY_PATTERN = "^(-?%d+):(-?%d+)$"

local function isFiniteNumber(value: any): boolean
	return typeof(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

local function resolvePlayerRootPart(player: Player): BasePart?
	local character = player.Character
	if character == nil then
		return nil
	end
	local hrp = character:FindFirstChild("HumanoidRootPart")
	if hrp ~= nil and hrp:IsA("BasePart") then
		return hrp
	end
	if character.PrimaryPart ~= nil then
		return character.PrimaryPart
	end
	for _, descendant in character:GetDescendants() do
		if descendant:IsA("BasePart") then
			return descendant
		end
	end
	return nil
end

local function resolveSourceConfig(): any
	if typeof(CoreConfigs) ~= "table" then
		return nil
	end
	return (CoreConfigs :: any).worldSimulation
end

local function defaultPlayerSettings(config: SimulationConfig): PlayerSettings
	return {
		streamRadius = config.streamRadiusChunks,
		streamVerticalRadius = config.streamVerticalRadiusChunks,
	}
end

local function parseWorldGenerationChunkKey(chunkKeyRaw: any): (number?, number?)
	if typeof(chunkKeyRaw) ~= "string" then
		return nil, nil
	end
	local xRaw, yRaw = string.match(chunkKeyRaw, WORLD_GENERATION_CHUNK_KEY_PATTERN)
	if xRaw == nil or yRaw == nil then
		return nil, nil
	end
	local chunkX = tonumber(xRaw)
	local chunkY = tonumber(yRaw)
	if chunkX == nil or chunkY == nil then
		return nil, nil
	end
	return chunkX, chunkY
end

local function getPlayerCenterChunkForWorldGeneration(config: SimulationConfig, player: Player): (number, number)
	local rootPart = resolvePlayerRootPart(player)
	if rootPart == nil then
		return 0, 0
	end
	local tileX = Shared.toTileCoordinate(rootPart.Position.Z, config.tileSize)
	local tileY = Shared.toTileCoordinate(rootPart.Position.Y, config.tileSize)
	return Shared.toChunkCoordinate(tileX, config.chunkSize), Shared.toChunkCoordinate(tileY, config.chunkHeight)
end

function WorldSimulationServiceServer:CreateStateSnapshot(player: Player): { [string]: any }
	local settings = self.playerSettings[player] or defaultPlayerSettings(self.config)
	return {
		seed = self.config.seed,
		tileSize = self.config.tileSize,
		chunkSize = self.config.chunkSize,
		chunkHeight = self.config.chunkHeight,
		chunkDepth = self.config.chunkDepth,
		clusterSize = self.config.clusterSize,
		streamRadiusChunks = settings.streamRadius,
		streamVerticalRadiusChunks = settings.streamVerticalRadius,
		renderRadiusChunks = self.config.renderRadiusChunks,
		renderVerticalRadiusChunks = self.config.renderVerticalRadiusChunks,
		nearSurfaceDepth = self.config.nearSurfaceDepth,
		biomeTransitionWidth = self.config.biomeTransitionWidth,
		lodNearDistance = self.config.lodNearDistance,
		lodFarDistance = self.config.lodFarDistance,
		enableDebug = self.config.enableDebug,
	}
end

function WorldSimulationServiceServer:PushState(player: Player)
	if self.networker == nil then
		return
	end
	self.networker:fire(player, Net.CLIENT_METHOD_APPLY_STATE, self:createStateSnapshot(player))
end

function WorldSimulationServiceServer:SetAuthoritativeSeed(seedRaw: any)
	if not isFiniteNumber(seedRaw) then
		return
	end
	local seed = math.floor(seedRaw)
	self.pendingAuthoritativeSeed = seed
	if self.config ~= nil then
		self.config.seed = seed
	end
	if self.world ~= nil then
		self.world.seed = seed
		self.world.config.seed = seed
	end
end

function WorldSimulationServiceServer:ToSimulationChunkKey(rawChunkKey: any): (string?, number?, number?, number?)
	local chunkX, chunkY, chunkZ = Shared.unpackChunkKey(rawChunkKey)
	if chunkX ~= nil and chunkY ~= nil and chunkZ ~= nil then
		return Shared.packChunkKey(chunkX, chunkY, chunkZ), chunkX, chunkY, chunkZ
	end
	local generationChunkX, generationChunkY = parseWorldGenerationChunkKey(rawChunkKey)
	if generationChunkX == nil or generationChunkY == nil then
		return nil, nil, nil, nil
	end
	return Shared.packChunkKey(generationChunkX, generationChunkY, SIMULATION_CHUNK_Z),
		generationChunkX,
		generationChunkY,
		SIMULATION_CHUNK_Z
end

function WorldSimulationServiceServer:PushGeneratedPlayerInterest(player: Player, interestRaw: any)
	if self.config == nil or self.generatedInterestByPlayer == nil then
		if self.pendingGeneratedInterestRawByPlayer == nil then
			self.pendingGeneratedInterestRawByPlayer = {}
		end
		self.pendingGeneratedInterestRawByPlayer[player] = interestRaw
		return
	end

	local nextInterest = {} :: GeneratedPlayerInterest
	local centerChunkX, centerChunkY = getPlayerCenterChunkForWorldGeneration(self.config, player)
	if typeof(interestRaw) == "table" then
		for rawChunkKey, rawPriority in interestRaw do
			if rawPriority == false or rawPriority == nil then
				continue
			end
			local simulationKey, chunkX, chunkY, chunkZ = self:toSimulationChunkKey(rawChunkKey)
			if simulationKey == nil or chunkX == nil or chunkY == nil or chunkZ == nil then
				continue
			end
			local priority = if isFiniteNumber(rawPriority)
				then math.max(0, math.floor(rawPriority))
				else Net.chunkPriorityFromCenter(
					chunkX,
					chunkY,
					chunkZ,
					centerChunkX,
					centerChunkY,
					SIMULATION_CHUNK_Z
				)
			nextInterest[simulationKey] = priority
		end
	end
	self.generatedInterestByPlayer[player] = nextInterest
end

function WorldSimulationServiceServer:ClearGeneratedPlayerInterest(player: Player)
	if self.generatedInterestByPlayer == nil then
		if self.pendingGeneratedInterestRawByPlayer == nil then
			self.pendingGeneratedInterestRawByPlayer = {}
		end
		self.pendingGeneratedInterestRawByPlayer[player] = {}
		return
	end
	self.generatedInterestByPlayer[player] = {}
end

function WorldSimulationServiceServer:RegisterGeneratedChunkSnapshot(chunkSnapshotRaw: any): boolean
	if self.world == nil then
		if self.pendingChunkSnapshots == nil then
			self.pendingChunkSnapshots = {}
		end
		self.pendingChunkSnapshots[#self.pendingChunkSnapshots + 1] = chunkSnapshotRaw
		return false
	end

	local chunk = Data.ingestWorldGenerationChunkSnapshot(self.world, chunkSnapshotRaw, SIMULATION_CHUNK_Z)
	if chunk == nil then
		return false
	end

	local chunkKey = chunk.key
	for player, stream in self.streamState.players do
		local playerInterest = self.generatedInterestByPlayer[player]
		if playerInterest == nil then
			continue
		end
		local priority = playerInterest[chunkKey]
		if priority ~= nil then
			Stream.enqueueChunk(stream, chunkKey, priority)
		end
	end

	if self.debug ~= nil then
		self.debug:incrementCounter("wg_chunks_registered")
	end
	return true
end

function WorldSimulationServiceServer:TrackPlayer(player: Player)
	local settings = self.playerSettings[player]
	if settings == nil then
		settings = defaultPlayerSettings(self.config)
		self.playerSettings[player] = settings
	else
		settings.streamRadius = Net.sanitizeStreamRadius(settings.streamRadius, self.config.streamRadiusChunks)
		settings.streamVerticalRadius =
			Net.sanitizeStreamRadius(settings.streamVerticalRadius, self.config.streamVerticalRadiusChunks)
	end
	self.generatedInterestByPlayer[player] = {}
	local stream = Stream.getOrCreatePlayerStream(self.streamState, player)
	for chunkKey in stream.interestLookup do
		Data.setChunkDemandByKey(self.world, chunkKey, -1)
	end
	table.clear(stream.interestLookup)
	table.clear(stream.sentRevisions)
	table.clear(stream.queuedLookup)
	table.clear(stream.queueKeys)
	self:pushState(player)
end

function WorldSimulationServiceServer:UntrackPlayer(player: Player)
	local stream = self.streamState.players[player]
	if stream ~= nil then
		for chunkKey in stream.interestLookup do
			Data.setChunkDemandByKey(self.world, chunkKey, -1)
		end
	end
	Stream.removePlayerStream(self.streamState, player)
	self.playerSettings[player] = nil
	self.generatedInterestByPlayer[player] = nil
end

function WorldSimulationServiceServer:RequestSync(player: Player)
	self:trackPlayer(player)
end

function WorldSimulationServiceServer:SetStreamRadius(player: Player, streamRadiusRaw: any, verticalRadiusRaw: any)
	local fallbackConfig = if self.config ~= nil then self.config else Config.createDefault()
	if self.playerSettings == nil then
		self.playerSettings = {} :: { [Player]: PlayerSettings }
	end

	local settings = self.playerSettings[player]
	if settings == nil then
		settings = defaultPlayerSettings(fallbackConfig)
		self.playerSettings[player] = settings
	end
	settings.streamRadius = Net.sanitizeStreamRadius(streamRadiusRaw, settings.streamRadius)
	settings.streamVerticalRadius = Net.sanitizeStreamRadius(verticalRadiusRaw, settings.streamVerticalRadius)
	if self.config == nil then
		return
	end
	self:pushState(player)
end

function WorldSimulationServiceServer:SubmitInput(player: Player, inputRaw: any)
	local ok, reason = Net.validateClientInput(inputRaw)
	if not ok then
		if self.debug ~= nil then
			self.debug:incrementCounter("invalid_input")
		end
		return
	end

	local input = inputRaw :: { [string]: any }
	local targetEntityId = math.floor(input.entityId)
	local moveX = math.clamp(input.moveX, -1, 1)
	local moveZ = math.clamp(input.moveZ, -1, 1)

	for _, chunkKey in self.world.activeChunkKeys do
		local chunk = self.world.chunksByKey[chunkKey]
		if chunk == nil then
			continue
		end
		local entities = chunk.entities
		for slot = 1, entities.count do
			if entities.ids[slot] ~= targetEntityId then
				continue
			end
			entities.flags[slot] = State.setFlag(entities.flags[slot], State.ENTITY_FLAGS.PREDICTED, true)
			entities.velX[slot] = entities.velX[slot] * 0.4 + moveX * 8
			entities.velZ[slot] = entities.velZ[slot] * 0.4 + moveZ * 8
			Data.bumpChunkRevision(chunk)
			if self.debug ~= nil then
				self.debug:incrementCounter("input_applied")
			end
			return
		end
	end
end

function WorldSimulationServiceServer:SyncPlayerStream(player: Player)
	local stream = Stream.getOrCreatePlayerStream(self.streamState, player)
	local nextInterest = self.generatedInterestByPlayer[player] or {}

	Stream.reconcilePlayerInterest(stream, nextInterest, function(chunkKey: string, priority: number)
		Data.setChunkDemandByKey(self.world, chunkKey, 1)
		Stream.enqueueChunk(stream, chunkKey, priority)
	end, function(chunkKey: string)
		Data.setChunkDemandByKey(self.world, chunkKey, -1)
		if self.networker ~= nil then
			self.networker:fire(player, Net.CLIENT_METHOD_CHUNK_UNLOADED, chunkKey)
		end
	end)

	if self.networker == nil then
		return
	end

	for chunkKey, priority in nextInterest do
		local chunk = self.world.chunksByKey[chunkKey]
		if chunk == nil then
			Stream.enqueueChunk(stream, chunkKey, priority)
		elseif Stream.isRevisionOutOfDate(stream, chunkKey, chunk.revision) then
			Stream.enqueueChunk(stream, chunkKey, priority)
		end
	end

	local sendBudget = self.config.maxStreamSendsPerPlayerPerTick
	for _ = 1, sendBudget do
		local nextChunkKey = Stream.popNextChunk(stream)
		if nextChunkKey == nil then
			break
		end

		local chunk = self.world.chunksByKey[nextChunkKey]
		if chunk == nil then
			local retryPriority = stream.interestLookup[nextChunkKey]
			if retryPriority ~= nil then
				Stream.enqueueChunk(stream, nextChunkKey, retryPriority)
			end
			continue
		end
		local delta = Net.buildChunkDelta(chunk, stream.sentRevisions[nextChunkKey])
		if delta ~= nil and self.networker ~= nil then
			self.networker:fire(player, Net.CLIENT_METHOD_CHUNK_DELTA, delta)
			Stream.markRevisionSent(stream, nextChunkKey, chunk.revision)
		end
	end
end

function WorldSimulationServiceServer:OnHeartbeat(dt: number)
	self.runtime:tick(dt)
	for player in self.playerSettings do
		self:syncPlayerStream(player)
	end

	if self.debug ~= nil then
		self.debugCounterAccumulator += dt
		if self.debugCounterAccumulator >= DEBUG_COUNTER_PUSH_INTERVAL then
			self.debugCounterAccumulator = 0
			local counters = self.debug:getCounters()
			if self.networker ~= nil and next(counters) ~= nil then
				for player in self.playerSettings do
					self.networker:fire(player, Net.CLIENT_METHOD_DEBUG_COUNTERS, counters)
				end
			end
			self.debug:resetFrameCounters()
		end
	end
end

function WorldSimulationServiceServer:GetWorldData(): WorldData
	return self.world
end

function WorldSimulationServiceServer:GetConfig(): SimulationConfig
	return self.config
end

function WorldSimulationServiceServer:Init()
	if self.heartbeatConnection ~= nil or self.heartbeatToken ~= nil then
		return
	end

	self.runtimeContext = CoreRuntime.getServerRuntime()
	if self.runtimeContext ~= nil and typeof((self.runtimeContext :: any).init) == "function" then
		local runtimeContextAny = self.runtimeContext :: any
		runtimeContextAny:init()
	end
	local sourceConfig = resolveSourceConfig()
	self.config = Config.sanitize(sourceConfig, nil)
	if self.pendingAuthoritativeSeed ~= nil then
		self.config.seed = self.pendingAuthoritativeSeed
	end
	self.cache = Cache.new({
		tablePoolSize = self.config.cacheTablePoolSize,
		arrayPoolSize = self.config.cacheArrayPoolSize,
		vectorPoolSize = math.max(16, math.floor(self.config.cacheArrayPoolSize * 0.5)),
	})
	self.debug = Debug.new({
		enabled = self.config.enableDebug,
		profilingEnabled = self.config.enableProfiling,
	})
	self.world = Data.createWorldData(self.config)
	self.runtime = Runtime.new(self.world, self.debug)
	local diagnostics = if self.runtime ~= nil then (self.runtime :: any).diagnostics else nil
	if diagnostics ~= nil and typeof((diagnostics :: any).attachDebugger) == "function" then
		self.matterDebugger = Matter.Debugger.new(Plasma)
		self.matterDebugger.authorize = function(player: Player): boolean
			return player:GetAttribute(CmdrUtils.MATTER_DEBUG_MENU_ENABLED_ATTRIBUTE) == true
		end
		(diagnostics :: any):attachDebugger(self.matterDebugger)
	end
	self.streamState = Stream.createServerStreamState()
	if typeof(self.playerSettings) ~= "table" then
		self.playerSettings = {} :: { [Player]: PlayerSettings }
	end
	self.generatedInterestByPlayer = {} :: { [Player]: GeneratedPlayerInterest }
	self.debugCounterAccumulator = 0

	if self.config.enableClientReplication then
		self.networker = Networker.server.new("WorldSimulationService", self, {
			self.RequestSync,
			self.SetStreamRadius,
			self.SubmitInput,
		})
	else
		self.networker = nil
	end

	for _, player in Players:GetPlayers() do
		if PlayerServiceServer:isGameplayActiveForPlayer(player) then
			self:trackPlayer(player)
		end
	end

	if self.pendingGeneratedInterestRawByPlayer ~= nil then
		for player, interestRaw in self.pendingGeneratedInterestRawByPlayer do
			self:pushGeneratedPlayerInterest(player, interestRaw)
		end
		table.clear(self.pendingGeneratedInterestRawByPlayer)
	end
	if self.pendingChunkSnapshots ~= nil then
		for _, chunkSnapshot in self.pendingChunkSnapshots do
			self:registerGeneratedChunkSnapshot(chunkSnapshot)
		end
		table.clear(self.pendingChunkSnapshots)
	end

	self.playerAddedConnection = Players.PlayerAdded:Connect(function(player: Player)
		if PlayerServiceServer:isGameplayActiveForPlayer(player) then
			self:trackPlayer(player)
		end
	end)
	self.playerRemovingConnection = Players.PlayerRemoving:Connect(function(player: Player)
		self:untrackPlayer(player)
	end)

	local tickScheduler = if self.runtimeContext ~= nil then (self.runtimeContext :: any).tickScheduler else nil
	if tickScheduler ~= nil and typeof((tickScheduler :: any).scheduleEvery) == "function" then
		self.heartbeatToken = (tickScheduler :: any):scheduleEvery(
			function(dt: number)
				self:onHeartbeat(dt)
			end,
			1 / 60,
			{
				group = "service.worldSimulation.server",
				priority = 120,
				catchUp = false,
			}
		)
	else
		self.heartbeatConnection = RunService.Heartbeat:Connect(function(dt: number)
			self:onHeartbeat(dt)
		end)
	end
end

function WorldSimulationServiceServer:Destroy()
	if self.heartbeatToken ~= nil then
		if typeof((self.heartbeatToken :: any).cancel) == "function" then
			local heartbeatTokenAny = self.heartbeatToken :: any
			heartbeatTokenAny:cancel()
		else
			local runtimeContext = self.runtimeContext
			local scheduler = if runtimeContext ~= nil then (runtimeContext :: any).tickScheduler else nil
			if scheduler ~= nil and typeof((scheduler :: any).cancel) == "function" then
				local schedulerAny = scheduler :: any
				schedulerAny:cancel(self.heartbeatToken)
			end
		end
		self.heartbeatToken = nil
	end
	if self.heartbeatConnection ~= nil then
		self.heartbeatConnection:Disconnect()
		self.heartbeatConnection = nil
	end
	if self.playerAddedConnection ~= nil then
		self.playerAddedConnection:Disconnect()
		self.playerAddedConnection = nil
	end
	if self.playerRemovingConnection ~= nil then
		self.playerRemovingConnection:Disconnect()
		self.playerRemovingConnection = nil
	end

	local trackedPlayers = {}
	for player in self.playerSettings do
		trackedPlayers[#trackedPlayers + 1] = player
	end
	for _, player in trackedPlayers do
		self:untrackPlayer(player)
	end

	if self.networker ~= nil then
		self.networker:destroy()
		self.networker = nil
	end
	if self.runtime ~= nil and typeof((self.runtime :: any).Destroy) == "function" then
		local runtimeAny = self.runtime :: any
		runtimeAny:Destroy()
	end
	self.matterDebugger = nil
	if self.debug ~= nil then
		self.debug:destroy()
		self.debug = nil
	end
	if self.cache ~= nil then
		self.cache:destroy()
		self.cache = nil
	end
	self.generatedInterestByPlayer = {}
	if self.pendingGeneratedInterestRawByPlayer ~= nil then
		table.clear(self.pendingGeneratedInterestRawByPlayer)
	end
	if self.pendingChunkSnapshots ~= nil then
		table.clear(self.pendingChunkSnapshots)
	end
end

WorldSimulationServiceServer.createStateSnapshot = WorldSimulationServiceServer.CreateStateSnapshot
WorldSimulationServiceServer.pushState = WorldSimulationServiceServer.PushState
WorldSimulationServiceServer.setAuthoritativeSeed = WorldSimulationServiceServer.SetAuthoritativeSeed
WorldSimulationServiceServer.toSimulationChunkKey = WorldSimulationServiceServer.ToSimulationChunkKey
WorldSimulationServiceServer.pushGeneratedPlayerInterest = WorldSimulationServiceServer.PushGeneratedPlayerInterest
WorldSimulationServiceServer.clearGeneratedPlayerInterest = WorldSimulationServiceServer.ClearGeneratedPlayerInterest
WorldSimulationServiceServer.registerGeneratedChunkSnapshot =
	WorldSimulationServiceServer.RegisterGeneratedChunkSnapshot
WorldSimulationServiceServer.trackPlayer = WorldSimulationServiceServer.TrackPlayer
WorldSimulationServiceServer.untrackPlayer = WorldSimulationServiceServer.UntrackPlayer
WorldSimulationServiceServer.requestSync = WorldSimulationServiceServer.RequestSync
WorldSimulationServiceServer.setStreamRadius = WorldSimulationServiceServer.SetStreamRadius
WorldSimulationServiceServer.submitInput = WorldSimulationServiceServer.SubmitInput
WorldSimulationServiceServer.syncPlayerStream = WorldSimulationServiceServer.SyncPlayerStream
WorldSimulationServiceServer.onHeartbeat = WorldSimulationServiceServer.OnHeartbeat
WorldSimulationServiceServer.getWorldData = WorldSimulationServiceServer.GetWorldData
WorldSimulationServiceServer.getConfig = WorldSimulationServiceServer.GetConfig
WorldSimulationServiceServer.init = WorldSimulationServiceServer.Init
WorldSimulationServiceServer.destroy = WorldSimulationServiceServer.Destroy

type WorldSimulationServiceServer = typeof(WorldSimulationServiceServer) & {
	runtimeContext: any?,
	heartbeatToken: any?,
	config: SimulationConfig,
	cache: Cache.Cache,
	debug: Debug.Debug,
	world: WorldData,
	runtime: RuntimeObject,
	streamState: ServerStreamState,
	networker: Networker.Server?,
	playerSettings: { [Player]: PlayerSettings },
	generatedInterestByPlayer: { [Player]: GeneratedPlayerInterest },
	pendingAuthoritativeSeed: number?,
	pendingGeneratedInterestRawByPlayer: { [Player]: any }?,
	pendingChunkSnapshots: { any }?,
	debugCounterAccumulator: number,
	matterDebugger: any?,
	heartbeatConnection: RBXScriptConnection?,
	playerAddedConnection: RBXScriptConnection?,
	playerRemovingConnection: RBXScriptConnection?,
}

return WorldSimulationServiceServer :: WorldSimulationServiceServer
]]></string>
