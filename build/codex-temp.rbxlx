BuildServiceServer.setTileAtAuthoritative = BuildServiceServer.SetTileAtAuthoritative
BuildServiceServer.resolveBreakFootprint = BuildServiceServer.ResolveBreakFootprint
BuildServiceServer.resolveUnsupportedCascadeAround = BuildServiceServer.ResolveUnsupportedCascadeAround
BuildServiceServer.flushTileDeltas = BuildServiceServer.FlushTileDeltas
BuildServiceServer.canPlaceAt = BuildServiceServer.CanPlaceAt
BuildServiceServer.requestPlaceTile = BuildServiceServer.RequestPlaceTile
BuildServiceServer.processBreakCompletion = BuildServiceServer.ProcessBreakCompletion
BuildServiceServer.processTreeBreakCompletion = BuildServiceServer.ProcessTreeBreakCompletion
BuildServiceServer.stopBreaking = BuildServiceServer.StopBreaking
BuildServiceServer.requestBreakTile = BuildServiceServer.RequestBreakTile
BuildServiceServer.processBreakIntents = BuildServiceServer.ProcessBreakIntents
BuildServiceServer.pruneTileDamage = BuildServiceServer.PruneTileDamage
BuildServiceServer.onHeartbeat = BuildServiceServer.OnHeartbeat
BuildServiceServer.init = BuildServiceServer.Init
BuildServiceServer.destroy = BuildServiceServer.Destroy

type BuildServiceServer = typeof(BuildServiceServer) & {
	networker: Networker.Server,
	config: BuildServiceConfig,
	state: BuildServiceState,
	worldGenerationService: WorldGenerationServiceServerObject,
	inventoryService: InventoryServiceServerObject?,
	lootService: LootServiceServerObject?,
	world: any,
	pendingTileDeltas: { TileDelta },
	pendingTileDeltaLookup: { [string]: number },
	tileDamage: { [string]: TileDamageRuntime },
	treeDamage: { [string]: TileDamageRuntime },
	treeStates: { [string]: TreeState },
	playerBreakIntents: { [Player]: PlayerBreakIntent },
	multiTileAnchors: { [string]: MultiTileAnchorRuntime },
	multiTileMembers: { [string]: string },
	damagePruneAccumulator: number,
	heartbeatConnection: RBXScriptConnection?,
	playerAddedConnection: RBXScriptConnection?,
	playerRemovingConnection: RBXScriptConnection?,
}

return BuildServiceServer :: BuildServiceServer
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="1048">
              <Properties>
                <string name="Name">CameraServiceServer</string>
                <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CameraServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.CameraServiceUtils)
local Networker = require(script:FindFirstAncestor("game").Shared.Modules.Networking.Networker)

type CameraState = CameraServiceUtils.CameraState

local CameraServiceServer = {}

function CameraServiceServer.Init(self: CameraServiceServer)
	self.playerStates = {}
	self.networker = Networker.server.new("CameraService", self, {
		self.RequestSync,
		self.SetMode,
	})

	for _, player in Players:GetPlayers() do
		self.playerStates[player] = CameraServiceUtils.createDefaultState()
	end

	self.playerAddedConnection = Players.PlayerAdded:Connect(function(player)
		self.playerStates[player] = CameraServiceUtils.createDefaultState()
	end)

	self.playerRemovingConnection = Players.PlayerRemoving:Connect(function(player)
		self.playerStates[player] = nil
	end)
end

function CameraServiceServer.GetState(self: CameraServiceServer, player: Player): CameraState
	local state = self.playerStates[player]
	if state then
		return state
	end

	local defaultState = CameraServiceUtils.createDefaultState()
	self.playerStates[player] = defaultState
	return defaultState
end

function CameraServiceServer.RequestSync(self: CameraServiceServer, player: Player)
	local state = self:getState(player)
	self.networker:fire(player, "applyMode", state.mode, state.sideViewConfig)
end

function CameraServiceServer.SetMode(self: CameraServiceServer, player: Player, mode: any, sideViewConfig: any)
	local state = self:getState(player)
	local mergedSideViewConfig = CameraServiceUtils.mergeSideViewConfig(state.sideViewConfig, sideViewConfig)
	local nextState = CameraServiceUtils.createCameraState(mode, mergedSideViewConfig)

	self.playerStates[player] = nextState
	self.networker:fire(player, "applyMode", nextState.mode, nextState.sideViewConfig)
end

function CameraServiceServer.Destroy(self: CameraServiceServer)
	if self.playerAddedConnection then
		self.playerAddedConnection:Disconnect()
		self.playerAddedConnection = nil
	end

	if self.playerRemovingConnection then
		self.playerRemovingConnection:Disconnect()
		self.playerRemovingConnection = nil
	end

	if self.networker then
		self.networker:destroy()
	end
end

CameraServiceServer.init = CameraServiceServer.Init
CameraServiceServer.getState = CameraServiceServer.GetState
CameraServiceServer.requestSync = CameraServiceServer.RequestSync
CameraServiceServer.setMode = CameraServiceServer.SetMode
CameraServiceServer.destroy = CameraServiceServer.Destroy

type CameraServiceServer = typeof(CameraServiceServer) & {
	networker: Networker.Server,
	playerStates: { [Player]: CameraState },
	playerAddedConnection: RBXScriptConnection?,
	playerRemovingConnection: RBXScriptConnection?,
}

return CameraServiceServer :: CameraServiceServer
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="1049">
              <Properties>
                <string name="Name">CraftingServiceServer</string>
                <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerScriptService = game:GetService("ServerScriptService")

local Configs = require(script:FindFirstAncestor("game").Shared.Modules.Core.Configs)
local CraftingServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.CraftingServiceUtils)
local InventoryServiceServer = require(script:FindFirstAncestor("game").Server.Services.InventoryServiceServer)
local InventoryServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.InventoryServiceUtils)
local Networker = require(script:FindFirstAncestor("game").Shared.Modules.Networking.Networker)
local PlayerDataServiceServer = require(script:FindFirstAncestor("game").Server.Services.PlayerDataServiceServer)
local PlayerServiceServer = require(script:FindFirstAncestor("game").Server.Services.PlayerServiceServer)
local WorldGenerationServiceServer =
	require(script:FindFirstAncestor("game").Server.Services.WorldGenerationServiceServer)

type RecipeRegistry = CraftingServiceUtils.RecipeRegistry
type CraftingServiceConfig = CraftingServiceUtils.CraftingServiceConfig
type CraftingPersistentState = CraftingServiceUtils.CraftingPersistentState
type CraftingServiceStateSnapshot = CraftingServiceUtils.CraftingServiceStateSnapshot
type InventoryProvider = CraftingServiceUtils.InventoryProvider
type CraftTransactionResult = CraftingServiceUtils.CraftTransactionResult

type PlayerDataServiceServerObject = {
	waitForData: (self: PlayerDataServiceServerObject, player: Player, timeoutSecondsRaw: any) -> any,
	getValue: (self: PlayerDataServiceServerObject, player: Player, pathRaw: any, fallback: any) -> any,
	setValue: (
		self: PlayerDataServiceServerObject,
		player: Player,
		pathRaw: any,
		value: any,
		replicateToClientRaw: any
	) -> boolean,
	savePlayerData: (self: PlayerDataServiceServerObject, player: Player) -> boolean,
}

type InventoryServiceServerObject = {
	getState: (self: InventoryServiceServerObject, player: Player) -> any,
}

type WorldGenerationServiceServerObject = {
	getBiomeTypeAtWorldPosition: (self: WorldGenerationServiceServerObject, worldPosition: Vector3) -> number?,
}

type PlayerRuntime = {
	loadToken: number,
	hasResolvedPersistedLoad: boolean,
	knownRecipeIds: { [string]: boolean },
	discoveredItemIds: { [string]: boolean },
	progressionFlags: { [string]: boolean },
	dirty: boolean,
	lastPersistAt: number,
	lastStatePushAt: number,
	lastCraftRequestAt: number,
	lastObservedInventoryUpdatedAt: number,
	transactionLocked: boolean,
}

local CraftingServiceServer = {}

local function trim(textRaw: any): string
	if typeof(textRaw) ~= "string" then
		return ""
	end
	return string.match(textRaw, "^%s*(.-)%s*$") or ""
end

local function sanitizeFlagId(flagRaw: any): string?
	local flagId = trim(flagRaw)
	if flagId == "" then
		return nil
	end
	return flagId
end

local function mapToOrderedRecipeIds(registry: RecipeRegistry, recipeIdSet: { [string]: boolean }): { string }
	local orderedRecipeIds = {}
	for _, recipeId in registry.recipeIdsOrdered do
		if recipeIdSet[recipeId] == true then
			table.insert(orderedRecipeIds, recipeId)
		end
	end
	return orderedRecipeIds
end

function CraftingServiceServer.CreateRuntime(self: CraftingServiceServer): PlayerRuntime
	return {
		loadToken = 0,
		hasResolvedPersistedLoad = false,
		knownRecipeIds = {},
		discoveredItemIds = {},
		progressionFlags = {},
		dirty = false,
		lastPersistAt = 0,
		lastStatePushAt = -math.huge,
		lastCraftRequestAt = -math.huge,
		lastObservedInventoryUpdatedAt = -math.huge,
		transactionLocked = false,
	}
end

function CraftingServiceServer.GetRuntime(self: CraftingServiceServer, player: Player): PlayerRuntime
	local runtime = self.playerRuntimes[player]
	if runtime ~= nil then
		return runtime
	end
	local nextRuntime = self:createRuntime()
	self.playerRuntimes[player] = nextRuntime
	return nextRuntime
end

function CraftingServiceServer.IsRuntimeReady(self: CraftingServiceServer, runtime: PlayerRuntime): boolean
	return runtime.hasResolvedPersistedLoad
end

function CraftingServiceServer.CreateStateSnapshot(
	self: CraftingServiceServer,
	runtime: PlayerRuntime
): CraftingServiceStateSnapshot
	return {
		knownRecipeIds = CraftingServiceUtils.cloneStringSet(runtime.knownRecipeIds),
		discoveredItemIds = CraftingServiceUtils.cloneStringSet(runtime.discoveredItemIds),
		progressionFlags = CraftingServiceUtils.cloneStringSet(runtime.progressionFlags),
		updatedAt = os.clock(),
	}
end

function CraftingServiceServer.PushState(
	self: CraftingServiceServer,
	player: Player,
	runtime: PlayerRuntime,
	forceRaw: any?
)
	local force = forceRaw == true
	local now = os.clock()
	if not force and now - runtime.lastStatePushAt < self.config.statePushIntervalSeconds then
		return
	end

	runtime.lastStatePushAt = now
	self.networker:fire(player, CraftingServiceUtils.CLIENT_METHOD_APPLY_STATE, self:createStateSnapshot(runtime))
end

function CraftingServiceServer.PushCraftResult(
	self: CraftingServiceServer,
	player: Player,
	transactionResult: CraftTransactionResult,
	reasonRaw: any?
)
	local reason = if typeof(reasonRaw) == "string" then reasonRaw else transactionResult.reason
	self.networker:fire(player, CraftingServiceUtils.CLIENT_METHOD_CRAFT_RESULT, {
		success = transactionResult.success == true,
		reason = reason,
		recipeId = transactionResult.recipeId,
		quantity = transactionResult.quantity,
		updatedAt = os.clock(),
	})
end

function CraftingServiceServer.MarkRuntimeDirty(self: CraftingServiceServer, runtime: PlayerRuntime)
	runtime.dirty = true
end

function CraftingServiceServer.PersistRuntime(
	self: CraftingServiceServer,
	player: Player,
	runtime: PlayerRuntime
): boolean
	if not runtime.dirty then
		return false
	end
	if not runtime.hasResolvedPersistedLoad then
		return false
	end

	local playerDataService = self.playerDataService
	if playerDataService == nil then
		return false
	end

	local payload: CraftingPersistentState = {
		knownRecipeIds = runtime.knownRecipeIds,
		discoveredItemIds = runtime.discoveredItemIds,
		progressionFlags = runtime.progressionFlags,
		updatedAt = os.time(),
	}
	local serializedState = CraftingServiceUtils.serializePersistentState(payload)
	local success, didSet = pcall(function()
		return playerDataService:setValue(player, self.config.dataPath, serializedState, false)
	end)
	if not success or didSet ~= true then
		return false
	end

	runtime.dirty = false
	runtime.lastPersistAt = os.clock()
	return true
end

function CraftingServiceServer.UnlockRecipesByIds(
	self: CraftingServiceServer,
	runtime: PlayerRuntime,
	recipeIdsRaw: { string }
): boolean
	local didUnlockAny = false
	for _, recipeId in recipeIdsRaw do
		if runtime.knownRecipeIds[recipeId] == true then
			continue
		end
		local recipe = self.registry.recipesById[recipeId]
		if recipe == nil then
			continue
		end
		if
			CraftingServiceUtils.RecipeValidator.areUnlockConditionsSatisfied(
				recipe,
				runtime.discoveredItemIds,
				runtime.progressionFlags
			)
		then
			runtime.knownRecipeIds[recipeId] = true
			didUnlockAny = true
		end
	end

	if didUnlockAny then
		self:markRuntimeDirty(runtime)
	end
	return didUnlockAny
end

function CraftingServiceServer.UnlockAllEligibleRecipes(self: CraftingServiceServer, runtime: PlayerRuntime): boolean
	return self:unlockRecipesByIds(runtime, self.registry.recipeIdsOrdered)
end

function CraftingServiceServer.RefreshDiscoveriesFromInventory(
	self: CraftingServiceServer,
	runtime: PlayerRuntime,
	inventoryStateRaw: any,
	forceUnlockScanRaw: any?
): boolean
	local inventoryState = if typeof(inventoryStateRaw) == "table" then inventoryStateRaw else nil
	if inventoryState == nil then
		return false
	end
	if not InventoryServiceUtils.isLoadedState((inventoryState :: any).loadState) then
		return false
	end

	local didChange = false
	local discoveredRecipeCandidates: { [string]: boolean } = {}
	local inventoryCounts = CraftingServiceUtils.buildInventoryItemCountMap(inventoryState)
	for itemId, amount in inventoryCounts do
		if amount <= 0 then
			continue
		end
		if runtime.discoveredItemIds[itemId] ~= true then
			runtime.discoveredItemIds[itemId] = true
			didChange = true
		end

		local candidateRecipeIds = self.registry.recipeIdsByUnlockItem[itemId]
		if candidateRecipeIds ~= nil then
			for _, recipeId in candidateRecipeIds do
				discoveredRecipeCandidates[recipeId] = true
			end
		end
	end

	if didChange then
		self:markRuntimeDirty(runtime)
	end

	local shouldForceUnlockScan = forceUnlockScanRaw == true
	if shouldForceUnlockScan then
		if self:unlockAllEligibleRecipes(runtime) then
			didChange = true
		end
		return didChange
	end

	local candidateRecipeIds = mapToOrderedRecipeIds(self.registry, discoveredRecipeCandidates)
	if #candidateRecipeIds > 0 and self:unlockRecipesByIds(runtime, candidateRecipeIds) then
		didChange = true
	end

	return didChange
end

function CraftingServiceServer.ApplyPersistedStateToRuntime(
	self: CraftingServiceServer,
	runtime: PlayerRuntime,
	persistedStateRaw: any
)
	local sanitized = CraftingServiceUtils.sanitizePersistentState(persistedStateRaw, self.registry)
	runtime.knownRecipeIds = sanitized.knownRecipeIds
	runtime.discoveredItemIds = sanitized.discoveredItemIds
	runtime.progressionFlags = sanitized.progressionFlags
	for recipeId, enabled in self.registry.defaultKnownRecipeIds do
		if enabled then
			runtime.knownRecipeIds[recipeId] = true
		end
	end
	runtime.hasResolvedPersistedLoad = true
end

function CraftingServiceServer.LoadPlayerState(self: CraftingServiceServer, player: Player, loadToken: number)
	local runtime = self.playerRuntimes[player]
	if runtime == nil or runtime.loadToken ~= loadToken then
		return
	end

	local persistedStateRaw = nil
	local playerDataService = self.playerDataService
	if playerDataService ~= nil then
		pcall(function()
			playerDataService:waitForData(player, self.config.dataLoadTimeoutSeconds)
		end)
		local readSuccess, readResult = pcall(function()
			return playerDataService:getValue(player, self.config.dataPath, nil)
		end)
		if readSuccess then
			persistedStateRaw = readResult
		end
	end

	runtime = self.playerRuntimes[player]
	if runtime == nil or runtime.loadToken ~= loadToken then
		return
	end

	self:applyPersistedStateToRuntime(runtime, persistedStateRaw)

	local inventoryState = self.inventoryService:getState(player)
	self:refreshDiscoveriesFromInventory(runtime, inventoryState, true)
	self:pushState(player, runtime, true)
	self:persistRuntime(player, runtime)
end

function CraftingServiceServer.TrackPlayer(self: CraftingServiceServer, player: Player)
	local runtime = self:getRuntime(player)
	runtime.loadToken += 1
	runtime.hasResolvedPersistedLoad = false
	runtime.knownRecipeIds = {}
	runtime.discoveredItemIds = {}
	runtime.progressionFlags = {}
	runtime.dirty = false
	runtime.lastPersistAt = 0
	runtime.lastStatePushAt = -math.huge
	runtime.lastCraftRequestAt = -math.huge
	runtime.lastObservedInventoryUpdatedAt = -math.huge
	runtime.transactionLocked = false

	local loadToken = runtime.loadToken
	task.spawn(function()
		self:loadPlayerState(player, loadToken)
	end)
end

function CraftingServiceServer.UntrackPlayer(self: CraftingServiceServer, player: Player)
	local runtime = self.playerRuntimes[player]
	if runtime == nil then
		return
	end

	self:persistRuntime(player, runtime)
	pcall(function()
		self.playerDataService:savePlayerData(player)
	end)
	runtime.loadToken += 1
	self.playerRuntimes[player] = nil
end

function CraftingServiceServer.ResolvePlayerBiomeTokens(
	self: CraftingServiceServer,
	player: Player
): { [string]: boolean }
	local rootPosition = CraftingServiceUtils.resolvePlayerRootPosition(player)
	if rootPosition == nil then
		return {}
	end
	return CraftingServiceUtils.resolveBiomeTokensFromWorldService(self.worldGenerationService, rootPosition)
end

function CraftingServiceServer.RequestSync(self: CraftingServiceServer, player: Player)
	local runtime = self.playerRuntimes[player]
	if runtime == nil then
		self:trackPlayer(player)
		return
	end
	self:pushState(player, runtime, true)
end

function CraftingServiceServer.RequestCraft(
	self: CraftingServiceServer,
	player: Player,
	recipeIdRaw: any,
	quantityRaw: any
)
	local runtime = self.playerRuntimes[player]
	if runtime == nil or not self:isRuntimeReady(runtime) then
		self:pushCraftResult(player, {
			success = false,
			reason = "not_ready",
			recipeId = "",
			quantity = 0,
			consumed = {},
			granted = {},
		}, "not_ready")
		return
	end

	local now = os.clock()
	if now - runtime.lastCraftRequestAt < self.config.serverRequestRateLimitSeconds then
		self:pushCraftResult(player, {
			success = false,
			reason = "rate_limited",
			recipeId = "",
			quantity = 0,
			consumed = {},
			granted = {},
		}, "rate_limited")
		return
	end
	runtime.lastCraftRequestAt = now

	local recipeId, quantity = CraftingServiceUtils.RecipeValidator.sanitizeCraftRequest(
		recipeIdRaw,
		quantityRaw,
		self.config.maxCraftQuantityPerRequest
	)
	if recipeId == nil or quantity <= 0 then
		self:pushCraftResult(player, {
			success = false,
			reason = "invalid_request",
			recipeId = "",
			quantity = 0,
			consumed = {},
			granted = {},
		}, "invalid_request")
		return
	end

	local recipe = self.registry.recipesById[recipeId]
	if recipe == nil then
		self:pushCraftResult(player, {
			success = false,
			reason = "invalid_recipe",
			recipeId = recipeId,
			quantity = quantity,
			consumed = {},
			granted = {},
		}, "invalid_recipe")
		return
	end
	if runtime.knownRecipeIds[recipeId] ~= true then
		self:pushCraftResult(player, {
			success = false,
			reason = "recipe_locked",
			recipeId = recipeId,
			quantity = quantity,
			consumed = {},
			granted = {},
		}, "recipe_locked")
		return
	end

	if runtime.transactionLocked then
		self:pushCraftResult(player, {
			success = false,
			reason = "busy",
			recipeId = recipeId,
			quantity = quantity,
			consumed = {},
			granted = {},
		}, "busy")
		return
	end

	local stationsNearPlayer = CraftingServiceUtils.StationDetector.getStationsNearPlayer(
		player,
		self.registry.stationTagById,
		self.config.stationValidationRadius,
		recipe.requiredStations
	)
	if not CraftingServiceUtils.RecipeValidator.areStationsSatisfied(recipe, stationsNearPlayer) then
		self:pushCraftResult(player, {
			success = false,
			reason = "missing_station",
			recipeId = recipeId,
			quantity = quantity,
			consumed = {},
			granted = {},
		}, "missing_station")
		return
	end

	local biomeTokens = self:resolvePlayerBiomeTokens(player)
	if not CraftingServiceUtils.RecipeValidator.isBiomeSatisfied(recipe, biomeTokens) then
		self:pushCraftResult(player, {
			success = false,
			reason = "wrong_biome",
			recipeId = recipeId,
			quantity = quantity,
			consumed = {},
			granted = {},
		}, "wrong_biome")
		return
	end

	runtime.transactionLocked = true
	local transactionSuccess, transactionResultOrError = pcall(function()
		return CraftingServiceUtils.CraftTransaction.execute(self.inventoryProvider, player, recipe, quantity)
	end)
	runtime.transactionLocked = false

	if not transactionSuccess then
		self:pushCraftResult(player, {
			success = false,
			reason = "transaction_error",
			recipeId = recipeId,
			quantity = quantity,
			consumed = {},
			granted = {},
		}, "transaction_error")
		return
	end

	local transactionResult = transactionResultOrError :: CraftTransactionResult

	if not transactionResult.success then
		self:pushCraftResult(player, transactionResult, transactionResult.reason)
		return
	end

	local candidateRecipeIdSet: { [string]: boolean } = {}
	for _, grantedItem in transactionResult.granted do
		if runtime.discoveredItemIds[grantedItem.itemId] ~= true then
			runtime.discoveredItemIds[grantedItem.itemId] = true
			self:markRuntimeDirty(runtime)
		end
		local candidates = self.registry.recipeIdsByUnlockItem[grantedItem.itemId]
		if candidates ~= nil then
			for _, candidateRecipeId in candidates do
				candidateRecipeIdSet[candidateRecipeId] = true
			end
		end
	end

	local didUnlock = false
	local candidateRecipeIds = mapToOrderedRecipeIds(self.registry, candidateRecipeIdSet)
	if #candidateRecipeIds > 0 and self:unlockRecipesByIds(runtime, candidateRecipeIds) then
		didUnlock = true
	end

	self:pushState(player, runtime, didUnlock)
	self:pushCraftResult(player, transactionResult, nil)
end

function CraftingServiceServer.OnHeartbeat(self: CraftingServiceServer, dtRaw: any)
	local dt = if typeof(dtRaw) == "number" and dtRaw == dtRaw then math.max(0, dtRaw) else 0
	if dt <= 0 then
		return
	end

	self.inventoryWatchAccumulator += dt
	local shouldWatchInventory = self.inventoryWatchAccumulator >= self.config.inventoryWatchIntervalSeconds
	if shouldWatchInventory then
		self.inventoryWatchAccumulator = 0
	end

	local now = os.clock()
	for player, runtime in self.playerRuntimes do
		if runtime.hasResolvedPersistedLoad and shouldWatchInventory then
			local inventoryState = self.inventoryService:getState(player)
			local updatedAt = if typeof(inventoryState) == "table"
					and typeof((inventoryState :: any).updatedAt) == "number"
				then (inventoryState :: any).updatedAt
				else -math.huge
			if updatedAt ~= runtime.lastObservedInventoryUpdatedAt then
				runtime.lastObservedInventoryUpdatedAt = updatedAt
				if self:refreshDiscoveriesFromInventory(runtime, inventoryState, false) then
					self:pushState(player, runtime, true)
				end
			end
		end

		if runtime.dirty and runtime.hasResolvedPersistedLoad then
			if now - runtime.lastPersistAt >= self.config.persistIntervalSeconds then
				self:persistRuntime(player, runtime)
			end
		end
	end
end

function CraftingServiceServer.SetInventoryProvider(self: CraftingServiceServer, providerRaw: any)
	if typeof(providerRaw) == "table" then
		local provider = providerRaw :: { [string]: any }
		if
			typeof(provider.IsReady) == "function"
			and typeof(provider.CountItem) == "function"
			and typeof(provider.HasItems) == "function"
			and typeof(provider.ConsumeItems) == "function"
			and typeof(provider.GrantItems) == "function"
			and typeof(provider.RestoreItems) == "function"
			and typeof(provider.RevokeItems) == "function"
		then
			self.inventoryProvider = providerRaw
			return
		end
	end
	self.inventoryProvider =
		CraftingServiceUtils.CraftTransaction.createInventoryProvider(self.inventoryService, self.playerDataService)
end

function CraftingServiceServer.SetProgressionFlag(
	self: CraftingServiceServer,
	player: Player,
	flagIdRaw: any,
	enabledRaw: any
): boolean
	local runtime = self.playerRuntimes[player]
	if runtime == nil or not runtime.hasResolvedPersistedLoad then
		return false
	end

	local flagId = sanitizeFlagId(flagIdRaw)
	if flagId == nil then
		return false
	end

	local enabled = enabledRaw == true
	if enabled then
		if runtime.progressionFlags[flagId] == true then
			return false
		end
		runtime.progressionFlags[flagId] = true
	else
		if runtime.progressionFlags[flagId] == nil then
			return false
		end
		runtime.progressionFlags[flagId] = nil
	end

	self:markRuntimeDirty(runtime)
	local candidateRecipeIds = self.registry.recipeIdsByUnlockFlag[flagId]
	if candidateRecipeIds ~= nil then
		self:unlockRecipesByIds(runtime, candidateRecipeIds)
	end
	self:pushState(player, runtime, true)
	return true
end

function CraftingServiceServer.Init(self: CraftingServiceServer)
	self.config = CraftingServiceUtils.resolveEffectiveConfig((Configs :: any).crafting)
	self.registry = CraftingServiceUtils.getRegistry(self.config)
	self.playerRuntimes = {}
	self.inventoryWatchAccumulator = 0
	self.inventoryService = InventoryServiceServer :: InventoryServiceServerObject
	self.playerDataService = PlayerDataServiceServer :: PlayerDataServiceServerObject
	self.worldGenerationService = WorldGenerationServiceServer :: WorldGenerationServiceServerObject
	self.inventoryProvider =
		CraftingServiceUtils.CraftTransaction.createInventoryProvider(self.inventoryService, self.playerDataService)

	self.networker = Networker.server.new("CraftingService", self, {
		self.RequestSync,
		self.RequestCraft,
	})

	for _, player in Players:GetPlayers() do
		if PlayerServiceServer:isGameplayActiveForPlayer(player) then
			self:trackPlayer(player)
		end
	end

	self.playerAddedConnection = Players.PlayerAdded:Connect(function(player: Player)
		if PlayerServiceServer:isGameplayActiveForPlayer(player) then
			self:trackPlayer(player)
		end
	end)

	self.playerRemovingConnection = Players.PlayerRemoving:Connect(function(player: Player)
		self:untrackPlayer(player)
	end)

	self.heartbeatConnection = RunService.Heartbeat:Connect(function(dt: number)
		self:onHeartbeat(dt)
	end)
end

function CraftingServiceServer.Destroy(self: CraftingServiceServer)
	if self.playerAddedConnection ~= nil then
		self.playerAddedConnection:Disconnect()
		self.playerAddedConnection = nil
	end
	if self.playerRemovingConnection ~= nil then
		self.playerRemovingConnection:Disconnect()
		self.playerRemovingConnection = nil
	end
	if self.heartbeatConnection ~= nil then
		self.heartbeatConnection:Disconnect()
		self.heartbeatConnection = nil
	end

	for player, runtime in self.playerRuntimes do
		self:persistRuntime(player, runtime)
		self.playerRuntimes[player] = nil
	end

	if self.networker ~= nil then
		self.networker:destroy()
	end
end

CraftingServiceServer.createRuntime = CraftingServiceServer.CreateRuntime
CraftingServiceServer.getRuntime = CraftingServiceServer.GetRuntime
CraftingServiceServer.isRuntimeReady = CraftingServiceServer.IsRuntimeReady
CraftingServiceServer.createStateSnapshot = CraftingServiceServer.CreateStateSnapshot
CraftingServiceServer.pushState = CraftingServiceServer.PushState
CraftingServiceServer.pushCraftResult = CraftingServiceServer.PushCraftResult
CraftingServiceServer.markRuntimeDirty = CraftingServiceServer.MarkRuntimeDirty
CraftingServiceServer.persistRuntime = CraftingServiceServer.PersistRuntime
CraftingServiceServer.unlockRecipesByIds = CraftingServiceServer.UnlockRecipesByIds
CraftingServiceServer.unlockAllEligibleRecipes = CraftingServiceServer.UnlockAllEligibleRecipes
CraftingServiceServer.refreshDiscoveriesFromInventory = CraftingServiceServer.RefreshDiscoveriesFromInventory
CraftingServiceServer.applyPersistedStateToRuntime = CraftingServiceServer.ApplyPersistedStateToRuntime
CraftingServiceServer.loadPlayerState = CraftingServiceServer.LoadPlayerState
CraftingServiceServer.trackPlayer = CraftingServiceServer.TrackPlayer
CraftingServiceServer.untrackPlayer = CraftingServiceServer.UntrackPlayer
CraftingServiceServer.resolvePlayerBiomeTokens = CraftingServiceServer.ResolvePlayerBiomeTokens
CraftingServiceServer.requestSync = CraftingServiceServer.RequestSync
CraftingServiceServer.requestCraft = CraftingServiceServer.RequestCraft
CraftingServiceServer.onHeartbeat = CraftingServiceServer.OnHeartbeat
CraftingServiceServer.setInventoryProvider = CraftingServiceServer.SetInventoryProvider
CraftingServiceServer.setProgressionFlag = CraftingServiceServer.SetProgressionFlag
CraftingServiceServer.init = CraftingServiceServer.Init
CraftingServiceServer.destroy = CraftingServiceServer.Destroy

type CraftingServiceServer = typeof(CraftingServiceServer) & {
	networker: Networker.Server,
	config: CraftingServiceConfig,
	registry: RecipeRegistry,
	playerRuntimes: { [Player]: PlayerRuntime },
	inventoryWatchAccumulator: number,
	inventoryService: InventoryServiceServerObject,
	inventoryProvider: InventoryProvider,
	playerDataService: PlayerDataServiceServerObject,
	worldGenerationService: WorldGenerationServiceServerObject,
	playerAddedConnection: RBXScriptConnection?,
	playerRemovingConnection: RBXScriptConnection?,
	heartbeatConnection: RBXScriptConnection?,
}

return CraftingServiceServer :: CraftingServiceServer
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="1050">
              <Properties>
                <string name="Name">GoreServiceServer</string>
                <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GoreServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.GoreServiceUtils)
local Networker = require(script:FindFirstAncestor("game").Shared.Modules.Networking.Networker)
local NevermoreSupport = require(script:FindFirstAncestor("game").Shared.Modules.Core.NevermoreSupport)
local ServerBinderSupport = require(script:FindFirstAncestor("game").Server.Binders.ServerBinderSupport)

local GoreServiceServer = {}
local SHARED_LARGE_BLOOD_POOL_SIZE = NumberRange.new(0.95, 1.7)
local SHARED_LARGE_BLOOD_POOL_SIZE_Y = NumberRange.new(0.16, 0.28)
local SHARED_LARGE_BLOOD_POOL_STARTING_SIZE = Vector3.new(0.2, 0.42, 0.2)
local SHARED_LARGE_BLOOD_POOL_MAX_SIZE = 1.8
local SHARED_LARGE_BLOOD_POOL_EXPANSE_DIVIDER = 2
local DEFAULT_SLIME_BLOOD_EMIT_COUNT = 22
local DEFAULT_SLIME_BLOOD_FOLLOW_DURATION = 0.1
local DEFAULT_SLIME_BLOOD_DROPLET_AMOUNT = 8

type EntityRuntime = {
	entityId: string,
	model: Model,
	bloodColor: Color3,
	damageBloodAmount: number,
	deathBloodAmount: number,
	deathGibCount: number,
	emitDeathGibs: boolean,
	controllerConfig: { [string]: any },
}

local function sanitizeEntityId(entityIdRaw: any): string?
	return GoreServiceUtils.sanitizeEntityId(entityIdRaw)
end

local function cloneDictionary(sourceRaw: any): { [string]: any }
	return GoreServiceUtils.cloneDictionary(sourceRaw)
end

local function isModel(value: any): boolean
	return typeof(value) == "Instance" and value:IsA("Model")
end

local function buildRuntimeFromConfig(entityId: string, model: Model, configRaw: any): EntityRuntime
	local source = if typeof(configRaw) == "table" then configRaw else {}
	local isPlayerEntity = GoreServiceUtils.sanitizeBoolean((source :: any).isPlayerEntity, false)

	local defaultBloodColor = if isPlayerEntity
		then GoreServiceUtils.DEFAULT_PLAYER_BLOOD_COLOR
		else GoreServiceUtils.DEFAULT_NPC_BLOOD_COLOR
	local defaultDamageBloodAmount = if isPlayerEntity
		then GoreServiceUtils.DEFAULT_PLAYER_DAMAGE_BLOOD_AMOUNT
		else GoreServiceUtils.DEFAULT_NPC_DAMAGE_BLOOD_AMOUNT
	local defaultDeathBloodAmount = if isPlayerEntity
		then GoreServiceUtils.DEFAULT_PLAYER_DEATH_BLOOD_AMOUNT
		else GoreServiceUtils.DEFAULT_NPC_DEATH_BLOOD_AMOUNT
	local defaultDeathGibCount = if isPlayerEntity then 0 else GoreServiceUtils.DEFAULT_NPC_DEATH_GIB_COUNT
	local defaultEmitDeathGibs = not isPlayerEntity

	local bloodColor = GoreServiceUtils.sanitizeColor((source :: any).bloodColor, defaultBloodColor)
	local damageBloodAmount =
		GoreServiceUtils.sanitizeBloodAmount((source :: any).damageBloodAmount, defaultDamageBloodAmount)
	local deathBloodAmount =
		GoreServiceUtils.sanitizeBloodAmount((source :: any).deathBloodAmount, defaultDeathBloodAmount)
	local deathGibCount = GoreServiceUtils.sanitizeGibCount((source :: any).deathGibCount, defaultDeathGibCount)
	local emitDeathGibs = GoreServiceUtils.sanitizeBoolean((source :: any).emitDeathGibs, defaultEmitDeathGibs)

	local controllerConfig = cloneDictionary(source)
	controllerConfig.isPlayerEntity = nil
	controllerConfig.damageBloodAmount = nil
	controllerConfig.deathBloodAmount = nil
	controllerConfig.deathGibCount = nil
	controllerConfig.emitDeathGibs = nil
	controllerConfig.model = nil
	controllerConfig.bloodColor = bloodColor

	return {
		entityId = entityId,
		model = model,
		bloodColor = bloodColor,
		damageBloodAmount = damageBloodAmount,
		deathBloodAmount = deathBloodAmount,
		deathGibCount = deathGibCount,
		emitDeathGibs = emitDeathGibs and deathGibCount > 0,
		controllerConfig = controllerConfig,
	}
end

function GoreServiceServer.FireClient(self: GoreServiceServer, player: Player, methodName: string, ...: any)
	if self.networker == nil then
		return
	end
	self.networker:fire(player, methodName, ...)
end

function GoreServiceServer.Broadcast(self: GoreServiceServer, methodName: string, ...: any)
	for _, player in Players:GetPlayers() do
		self:fireClient(player, methodName, ...)
	end
end

function GoreServiceServer.PushEntityToPlayer(self: GoreServiceServer, player: Player, runtime: EntityRuntime)
	if runtime.model.Parent == nil then
		return
	end
	self:fireClient(
		player,
		GoreServiceUtils.NETWORK_METHOD_REGISTER_ENTITY,
		runtime.entityId,
		runtime.model,
		runtime.controllerConfig
	)
end

function GoreServiceServer.RequestSync(self: GoreServiceServer, player: Player)
	if self.entitiesById == nil then
		return
	end
	for _, runtime in self.entitiesById do
		self:pushEntityToPlayer(player, runtime)
	end
end

function GoreServiceServer.GetEntityRuntime(self: GoreServiceServer, entityIdRaw: any): EntityRuntime?
	if self.entitiesById == nil then
		return nil
	end
	local entityId = sanitizeEntityId(entityIdRaw)
	if entityId == nil then
		return nil
	end
	return self.entitiesById[entityId]
end

function GoreServiceServer.RegisterEntity(
	self: GoreServiceServer,
	entityIdRaw: any,
	modelRaw: any,
	configRaw: any?
): boolean
	local entityId = sanitizeEntityId(entityIdRaw)
	if entityId == nil then
		return false
	end
	if not isModel(modelRaw) then
		return false
	end

	if self.entitiesById == nil then
		self.entitiesById = {}
	end

	local model = modelRaw :: Model
	local runtime = buildRuntimeFromConfig(entityId, model, configRaw)
	self.entitiesById[entityId] = runtime
	self:broadcast(
		GoreServiceUtils.NETWORK_METHOD_REGISTER_ENTITY,
		runtime.entityId,
		runtime.model,
		runtime.controllerConfig
	)
	return true
end

function GoreServiceServer.UnregisterEntity(self: GoreServiceServer, entityIdRaw: any): boolean
	local entityId = sanitizeEntityId(entityIdRaw)
	if entityId == nil then
		return false
	end
	if self.entitiesById[entityId] == nil then
		return false
	end

	self.entitiesById[entityId] = nil
	self:broadcast(GoreServiceUtils.NETWORK_METHOD_REMOVE_ENTITY, entityId)
	return true
end

function GoreServiceServer.SetEntityBloodColor(self: GoreServiceServer, entityIdRaw: any, bloodColorRaw: any): boolean
	local runtime = self:getEntityRuntime(entityIdRaw)
	if runtime == nil then
		return false
	end

	local bloodColor = GoreServiceUtils.sanitizeColor(bloodColorRaw, runtime.bloodColor)
	runtime.bloodColor = bloodColor
	runtime.controllerConfig.bloodColor = bloodColor
	self:broadcast(GoreServiceUtils.NETWORK_METHOD_SET_BLOOD_COLOR, runtime.entityId, bloodColor)
	return true
end

function GoreServiceServer.EmitEntityBlood(
	self: GoreServiceServer,
	entityIdRaw: any,
	originRaw: any,
	amountRaw: any?,
	settingsRaw: any?
): boolean
	local runtime = self:getEntityRuntime(entityIdRaw)
	if runtime == nil then
		return false
	end

	local origin = GoreServiceUtils.resolveBloodOrigin(runtime.model, originRaw)
	if origin == nil then
		return false
	end

	local amount = GoreServiceUtils.sanitizeBloodAmount(amountRaw, runtime.damageBloodAmount)
	local settings = cloneDictionary(settingsRaw)
	if typeof(settings.DropletColor) ~= "Color3" then
		settings.DropletColor = runtime.bloodColor
	end

	self:broadcast(GoreServiceUtils.NETWORK_METHOD_EMIT_BLOOD, runtime.entityId, origin, nil, amount, settings)
	return true
end

function GoreServiceServer.EmitEntityDamage(
	self: GoreServiceServer,
	entityIdRaw: any,
	originRaw: any,
	damageRaw: any?
): boolean
	local runtime = self:getEntityRuntime(entityIdRaw)
	if runtime == nil then
		return false
	end

	local damageAmount = if typeof(damageRaw) == "number" and damageRaw == damageRaw then math.max(0, damageRaw) else 0
	local scaledAmount = if damageAmount > 0
		then runtime.damageBloodAmount + math.floor(damageAmount * 0.25 + 0.5)
		else runtime.damageBloodAmount
	return self:emitEntityBlood(entityIdRaw, originRaw, scaledAmount, nil)
end

function GoreServiceServer.EmitEntityDeath(self: GoreServiceServer, entityIdRaw: any, originRaw: any): boolean
	local runtime = self:getEntityRuntime(entityIdRaw)
	if runtime == nil then
		return false
	end

	local didEmitBlood = self:emitEntityBlood(runtime.entityId, originRaw, runtime.deathBloodAmount, nil)
	if runtime.emitDeathGibs then
		local sourcePart = GoreServiceUtils.resolveOriginPart(runtime.model, originRaw)
		self:broadcast(
			GoreServiceUtils.NETWORK_METHOD_SPAWN_GIBS,
			runtime.entityId,
			runtime.deathGibCount,
			sourcePart,
			nil
		)
	end
	return didEmitBlood
end

function GoreServiceServer.RegisterPlayerCharacter(self: GoreServiceServer, playerRaw: any, characterRaw: any): boolean
	local entityId = GoreServiceUtils.makePlayerEntityId(playerRaw)
	if entityId == nil then
		return false
	end
	if not isModel(characterRaw) then
		return false
	end

	return self:registerEntity(entityId, characterRaw, {
		isPlayerEntity = true,
		bloodColor = GoreServiceUtils.DEFAULT_PLAYER_BLOOD_COLOR,
		damageBloodAmount = GoreServiceUtils.DEFAULT_PLAYER_DAMAGE_BLOOD_AMOUNT,
		deathBloodAmount = GoreServiceUtils.DEFAULT_PLAYER_DEATH_BLOOD_AMOUNT,
		deathGibCount = 0,
		emitDeathGibs = false,
		bloodSettings = {
			DefaultSize = SHARED_LARGE_BLOOD_POOL_SIZE,
			SizeY = SHARED_LARGE_BLOOD_POOL_SIZE_Y,
			StartingSize = SHARED_LARGE_BLOOD_POOL_STARTING_SIZE,
			MaximumSize = SHARED_LARGE_BLOOD_POOL_MAX_SIZE,
			ExpanseDivider = SHARED_LARGE_BLOOD_POOL_EXPANSE_DIVIDER,
		},
	})
end

function GoreServiceServer.UnregisterPlayer(self: GoreServiceServer, playerRaw: any): boolean
	local entityId = GoreServiceUtils.makePlayerEntityId(playerRaw)
	if entityId == nil then
		return false
	end
	return self:unregisterEntity(entityId)
end

function GoreServiceServer.OnPlayerDamaged(
	self: GoreServiceServer,
	playerRaw: any,
	originRaw: any,
	damageRaw: any?
): boolean
	local entityId = GoreServiceUtils.makePlayerEntityId(playerRaw)
	if entityId == nil then
		return false
	end
	return self:emitEntityDamage(entityId, originRaw, damageRaw)
end

function GoreServiceServer.OnPlayerDied(self: GoreServiceServer, playerRaw: any, originRaw: any): boolean
	local entityId = GoreServiceUtils.makePlayerEntityId(playerRaw)
	if entityId == nil then
		return false
	end
	return self:emitEntityDeath(entityId, originRaw)
end

function GoreServiceServer.RegisterNpcEntity(
	self: GoreServiceServer,
	runtimeIdRaw: any,
	modelRaw: any,
	configRaw: any?
): boolean
	local entityId = GoreServiceUtils.makeNpcEntityId(runtimeIdRaw)
	if entityId == nil then
		return false
	end

	local config = cloneDictionary(configRaw)
	config.isPlayerEntity = false
	if typeof(config.bloodColor) ~= "Color3" then
		config.bloodColor = GoreServiceUtils.DEFAULT_NPC_BLOOD_COLOR
	end
	if config.damageBloodAmount == nil then
		config.damageBloodAmount = GoreServiceUtils.DEFAULT_NPC_DAMAGE_BLOOD_AMOUNT
	end
	if config.deathBloodAmount == nil then
		config.deathBloodAmount = GoreServiceUtils.DEFAULT_NPC_DEATH_BLOOD_AMOUNT
	end
	if config.deathGibCount == nil then
		config.deathGibCount = GoreServiceUtils.DEFAULT_NPC_DEATH_GIB_COUNT
	end
	if config.emitDeathGibs == nil then
		config.emitDeathGibs = true
	end

	return self:registerEntity(entityId, modelRaw, config)
end

function GoreServiceServer.UnregisterNpcEntity(self: GoreServiceServer, runtimeIdRaw: any): boolean
	local entityId = GoreServiceUtils.makeNpcEntityId(runtimeIdRaw)
	if entityId == nil then
		return false
	end
	return self:unregisterEntity(entityId)
end

function GoreServiceServer.OnNpcDamaged(
	self: GoreServiceServer,
	runtimeIdRaw: any,
	originRaw: any,
	damageRaw: any?
): boolean
	local entityId = GoreServiceUtils.makeNpcEntityId(runtimeIdRaw)
	if entityId == nil then
		return false
	end
	return self:emitEntityDamage(entityId, originRaw, damageRaw)
end

function GoreServiceServer.OnNpcDied(self: GoreServiceServer, runtimeIdRaw: any, originRaw: any): boolean
	local entityId = GoreServiceUtils.makeNpcEntityId(runtimeIdRaw)
	if entityId == nil then
		return false
	end
	return self:emitEntityDeath(entityId, originRaw)
end

function GoreServiceServer.EmitNpcSlimeBlood(
	self: GoreServiceServer,
	runtimeIdRaw: any,
	originRaw: any,
	emitCountRaw: any?,
	followDurationRaw: any?,
	dropletAmountRaw: any?
): boolean
	local entityId = GoreServiceUtils.makeNpcEntityId(runtimeIdRaw)
	if entityId == nil then
		return false
	end

	local runtime = self:getEntityRuntime(entityId)
	if runtime == nil then
		return false
	end

	local origin = GoreServiceUtils.resolveBloodOrigin(runtime.model, originRaw)
	if origin == nil then
		return false
	end

	local emitCount = GoreServiceUtils.sanitizeBloodAmount(emitCountRaw, DEFAULT_SLIME_BLOOD_EMIT_COUNT)
	local followDuration =
		GoreServiceUtils.sanitizeEffectDuration(followDurationRaw, DEFAULT_SLIME_BLOOD_FOLLOW_DURATION)
	local dropletAmount = GoreServiceUtils.sanitizeBloodAmount(dropletAmountRaw, DEFAULT_SLIME_BLOOD_DROPLET_AMOUNT)
	local originPosition = if typeof(origin) == "Vector3" then origin else (origin :: BasePart).Position

	self:broadcast(
		GoreServiceUtils.NETWORK_METHOD_EMIT_SLIME_BLOOD,
		entityId,
		originPosition,
		emitCount,
		followDuration,
		dropletAmount
	)
	return true
end

function GoreServiceServer.Init(self: GoreServiceServer)
	self.networker = Networker.server.new("GoreService", self, {
		self.RequestSync,
	})
	self.entitiesById = {} :: { [string]: EntityRuntime }
	self.binders = NevermoreSupport.getService(ServerBinderSupport)
end

function GoreServiceServer.Destroy(self: GoreServiceServer)
	if self.entitiesById ~= nil then
		table.clear(self.entitiesById)
	end
	if self.networker ~= nil then
		self.networker:destroy()
	end
end

GoreServiceServer.fireClient = GoreServiceServer.FireClient
GoreServiceServer.broadcast = GoreServiceServer.Broadcast
GoreServiceServer.pushEntityToPlayer = GoreServiceServer.PushEntityToPlayer
GoreServiceServer.requestSync = GoreServiceServer.RequestSync
GoreServiceServer.getEntityRuntime = GoreServiceServer.GetEntityRuntime
GoreServiceServer.registerEntity = GoreServiceServer.RegisterEntity
GoreServiceServer.unregisterEntity = GoreServiceServer.UnregisterEntity
GoreServiceServer.setEntityBloodColor = GoreServiceServer.SetEntityBloodColor
GoreServiceServer.emitEntityBlood = GoreServiceServer.EmitEntityBlood
GoreServiceServer.emitEntityDamage = GoreServiceServer.EmitEntityDamage
GoreServiceServer.emitEntityDeath = GoreServiceServer.EmitEntityDeath
GoreServiceServer.registerPlayerCharacter = GoreServiceServer.RegisterPlayerCharacter
GoreServiceServer.unregisterPlayer = GoreServiceServer.UnregisterPlayer
GoreServiceServer.onPlayerDamaged = GoreServiceServer.OnPlayerDamaged
GoreServiceServer.onPlayerDied = GoreServiceServer.OnPlayerDied
GoreServiceServer.registerNpcEntity = GoreServiceServer.RegisterNpcEntity
GoreServiceServer.unregisterNpcEntity = GoreServiceServer.UnregisterNpcEntity
GoreServiceServer.onNpcDamaged = GoreServiceServer.OnNpcDamaged
GoreServiceServer.onNpcDied = GoreServiceServer.OnNpcDied
GoreServiceServer.emitNpcSlimeBlood = GoreServiceServer.EmitNpcSlimeBlood
GoreServiceServer.init = GoreServiceServer.Init
GoreServiceServer.destroy = GoreServiceServer.Destroy

type GoreServiceServer = typeof(GoreServiceServer) & {
	networker: Networker.Server,
	entitiesById: { [string]: EntityRuntime },
}

return GoreServiceServer :: GoreServiceServer
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="1051">
              <Properties>
                <string name="Name">HpServiceServer</string>
                <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local CmdrUtils = require(script:FindFirstAncestor("game").Shared.Cmdr.CmdrUtils)
local HpServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.HpServiceUtils)
local Janitor = require(ReplicatedStorage.Packages.Janitor)
local Networker = require(script:FindFirstAncestor("game").Shared.Modules.Networking.Networker)
local PlayerDataServiceServer = require(script:FindFirstAncestor("game").Server.Services.PlayerDataServiceServer)
local PlayerServiceServer = require(script:FindFirstAncestor("game").Server.Services.PlayerServiceServer)

type HpServiceState = HpServiceUtils.HpServiceState

type JanitorClass = {
	GiveChore: (self: JanitorClass, chore: any, ...any) -> (),
	Clean: (self: JanitorClass) -> (),
	Destroy: (self: JanitorClass) -> (),
}

type PlayerRuntime = {
	state: HpServiceState,
	playerJanitor: JanitorClass,
	characterJanitor: JanitorClass,
	humanoid: Humanoid?,
	loadToken: number,
	pendingPersistedHealth: number?,
	pendingPersistedMaxHealth: number?,
	hasResolvedPersistedLoad: boolean,
	healthChangedBeforePersistedLoad: boolean,
	isApplyingPersistedHealth: boolean,
	suppressDamageFeedbackDepth: number,
	isDeathLocked: boolean,
}

type PlayerDataServiceServerObject = {
	getLoadState: (self: PlayerDataServiceServerObject, player: Player) -> string,
	requestSync: (self: PlayerDataServiceServerObject, player: Player) -> (),
	waitForData: (self: PlayerDataServiceServerObject, player: Player, timeoutSecondsRaw: any) -> any,
	waitForDataPromise: (self: PlayerDataServiceServerObject, player: Player, timeoutSecondsRaw: any) -> any,
	isLoaded: (self: PlayerDataServiceServerObject, player: Player) -> boolean,
	getHpData: (self: PlayerDataServiceServerObject, player: Player, fallback: any) -> any,
	setHpData: (
		self: PlayerDataServiceServerObject,
		player: Player,
		hpDataRaw: any,
		replicateToClientRaw: any
	) -> boolean,
	savePlayerData: (self: PlayerDataServiceServerObject, player: Player) -> boolean,
}

local HpServiceServer = {}
local DEFAULT_DATA_LOAD_TIMEOUT_SECONDS = 20
local DEFAULT_DATA_LOAD_RETRY_DELAY_SECONDS = 1
local SUPPRESS_DAMAGE_FEEDBACK_ATTRIBUTE = "HpService_SuppressDamageFeedback"

local function isGodmodeEnabled(playerRaw: any): boolean
	if typeof(playerRaw) ~= "Instance" or not playerRaw:IsA("Player") then
		return false
	end

	return playerRaw:GetAttribute(CmdrUtils.GODMODE_ENABLED_ATTRIBUTE) == true
end

local function isHumanoidDead(humanoid: Humanoid): boolean
	if humanoid.Health <= 0 then
		return true
	end
	return humanoid:GetState() == Enum.HumanoidStateType.Dead
end

local function applyHumanoidPresentationSettings(humanoid: Humanoid)
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	humanoid.HealthDisplayDistance = 0
end

function HpServiceServer.Init(self: HpServiceServer)
	self.networker = Networker.server.new("HpService", self, {
		self.RequestSync,
	})
	self.playerRuntimes = {}
	self.heartValue = HpServiceUtils.DEFAULT_HEART_VALUE
	self.playerDataService = PlayerDataServiceServer :: PlayerDataServiceServerObject
	self.dataPath = HpServiceUtils.getDefaultDataPath()
	self.dataLoadTimeoutSeconds = DEFAULT_DATA_LOAD_TIMEOUT_SECONDS
	self.dataLoadRetryDelaySeconds = DEFAULT_DATA_LOAD_RETRY_DELAY_SECONDS

	for _, player in Players:GetPlayers() do
		if PlayerServiceServer:isGameplayActiveForPlayer(player) then
			self:trackPlayer(player)
		end
	end

	self.playerAddedConnection = Players.PlayerAdded:Connect(function(player: Player)
		if PlayerServiceServer:isGameplayActiveForPlayer(player) then
			self:trackPlayer(player)
		end
	end)

	self.playerRemovingConnection = Players.PlayerRemoving:Connect(function(player: Player)
		self:untrackPlayer(player)
	end)
end

function HpServiceServer.CreateRuntime(_self: HpServiceServer): PlayerRuntime
	return {
		state = HpServiceUtils.createDefaultState(),
		playerJanitor = Janitor.new(),
		characterJanitor = Janitor.new(),
		humanoid = nil,
		loadToken = 0,
		pendingPersistedHealth = nil,
		pendingPersistedMaxHealth = nil,
		hasResolvedPersistedLoad = false,
		healthChangedBeforePersistedLoad = false,
		isApplyingPersistedHealth = false,
		suppressDamageFeedbackDepth = 0,
		isDeathLocked = false,
	}
end

function HpServiceServer.SetHumanoidHealthWithoutDamageFeedback(
	_self: HpServiceServer,
	runtime: PlayerRuntime,
	humanoid: Humanoid,
	nextHealth: number
)
	runtime.suppressDamageFeedbackDepth += 1
	humanoid:SetAttribute(SUPPRESS_DAMAGE_FEEDBACK_ATTRIBUTE, true)
	humanoid.Health = nextHealth

	task.defer(function()
		runtime.suppressDamageFeedbackDepth = math.max(0, runtime.suppressDamageFeedbackDepth - 1)
		if runtime.suppressDamageFeedbackDepth <= 0 then
			humanoid:SetAttribute(SUPPRESS_DAMAGE_FEEDBACK_ATTRIBUTE, false)
		end
	end)
end

function HpServiceServer.RestoreGodmodeHealth(
	self: HpServiceServer,
	player: Player,
	runtime: PlayerRuntime,
	humanoid: Humanoid
): number
	runtime.isDeathLocked = false
	local targetHealth = math.max(1, humanoid.MaxHealth)
	if math.abs(humanoid.Health - targetHealth) > 1e-3 then
		self:setHumanoidHealthWithoutDamageFeedback(runtime, humanoid, targetHealth)
	end

	self:refreshStateFromHumanoid(player, humanoid)
	return humanoid.Health
end

function HpServiceServer.GetRuntime(self: HpServiceServer, player: Player): PlayerRuntime
	local runtime = self.playerRuntimes[player]
	if runtime then
		return runtime
	end

	local nextRuntime = self:createRuntime()
	self.playerRuntimes[player] = nextRuntime
	return nextRuntime
end

function HpServiceServer.PushState(self: HpServiceServer, player: Player)
	local runtime = self:getRuntime(player)
	self.networker:fire(player, "applyState", HpServiceUtils.cloneState(runtime.state))
end

function HpServiceServer.PersistRuntime(self: HpServiceServer, player: Player, runtime: PlayerRuntime): boolean
	local playerDataService = self.playerDataService
	if playerDataService == nil then
		return false
	end
	if not playerDataService:isLoaded(player) then
		return false
	end

	local serializedState = HpServiceUtils.serializeStateForData(runtime.state)
	local success, didSet = pcall(function()
		return playerDataService:setHpData(player, serializedState, false)
	end)
	if not success then
		return false
	end

	return didSet == true
end

function HpServiceServer.ApplyPendingPersistedState(
	self: HpServiceServer,
	player: Player,
	runtime: PlayerRuntime,
	humanoid: Humanoid
): boolean
	if runtime.isDeathLocked then
		return false
	end

	local pendingHealth = runtime.pendingPersistedHealth
	local pendingMaxHealth = runtime.pendingPersistedMaxHealth
	if pendingHealth == nil and pendingMaxHealth == nil then
		return false
	end

	local nextMaxHealth = math.max(
		1,
		if typeof(pendingMaxHealth) == "number" and pendingMaxHealth == pendingMaxHealth
			then pendingMaxHealth
			else humanoid.MaxHealth
	)
	local nextHealth = math.clamp(
		if typeof(pendingHealth) == "number" and pendingHealth == pendingHealth then pendingHealth else humanoid.Health,
		0,
		nextMaxHealth
	)
	runtime.pendingPersistedHealth = nil
	runtime.pendingPersistedMaxHealth = nil
	humanoid.MaxHealth = nextMaxHealth
	runtime.isApplyingPersistedHealth = true
	self:setHumanoidHealthWithoutDamageFeedback(runtime, humanoid, nextHealth)
	runtime.isApplyingPersistedHealth = false
	self:refreshStateFromHumanoid(player, humanoid)

	for _, delaySeconds in { 0.05, 0.2, 0.5, 1 } do
		task.delay(delaySeconds, function()
			if runtime.humanoid ~= humanoid then
				return
			end
			if humanoid.Parent == nil then
				return
			end
			if runtime.isDeathLocked then
				return
			end

			local clampedMaxHealth = math.max(1, nextMaxHealth)
			local clampedTarget = math.clamp(nextHealth, 0, clampedMaxHealth)
			if math.abs(humanoid.MaxHealth - clampedMaxHealth) > 1e-3 then
				humanoid.MaxHealth = clampedMaxHealth
			end
			if math.abs(humanoid.Health - clampedTarget) > 1e-3 then
				self:setHumanoidHealthWithoutDamageFeedback(runtime, humanoid, clampedTarget)
			end
			self:refreshStateFromHumanoid(player, humanoid)
		end)
	end

	return true
end

function HpServiceServer.RefreshStateFromHumanoid(self: HpServiceServer, player: Player, humanoid: Humanoid)
	local runtime = self:getRuntime(player)
	if runtime.humanoid == humanoid and runtime.isDeathLocked and humanoid.Health > 0 then
		self:setHumanoidHealthWithoutDamageFeedback(runtime, humanoid, 0)
	end

	runtime.state = HpServiceUtils.createStateFromHumanoid(humanoid, self.heartValue, runtime.state)
	if runtime.hasResolvedPersistedLoad then
		self:persistRuntime(player, runtime)
	end
	self:pushState(player)
end

function HpServiceServer.RetryLoadPersistedHealthLater(self: HpServiceServer, player: Player, loadToken: number)
	task.delay(self.dataLoadRetryDelaySeconds, function()
		local runtime = self.playerRuntimes[player]
		if runtime == nil or runtime.loadToken ~= loadToken then
			return
		end
		if runtime.hasResolvedPersistedLoad then
			return
		end
		self:loadPersistedHealth(player, loadToken)
	end)
end

function HpServiceServer.LoadPersistedHealth(self: HpServiceServer, player: Player, loadToken: number)
	local runtime = self.playerRuntimes[player]
	if runtime == nil or runtime.loadToken ~= loadToken then
		return
	end

	local playerDataService = self.playerDataService
	if playerDataService == nil then
		return
	end

	pcall(function()
		playerDataService:requestSync(player)
	end)

	local waitSuccess, nextPlayerData = pcall(function()
		local waitPromise = playerDataService:waitForDataPromise(player, self.dataLoadTimeoutSeconds)
		return select(2, waitPromise:Yield())
	end)
	runtime = self.playerRuntimes[player]
	if runtime == nil or runtime.loadToken ~= loadToken then
		return
	end
	if not waitSuccess then
		self:retryLoadPersistedHealthLater(player, loadToken)
		return
	end
	if nextPlayerData == nil then
		local loadStateSuccess, playerDataLoadState = pcall(function()
			return playerDataService:getLoadState(player)
		end)
		if loadStateSuccess and playerDataLoadState == "Loaded" then
			runtime.hasResolvedPersistedLoad = true
			self:persistRuntime(player, runtime)
			self:pushState(player)
			return
		end
		if loadStateSuccess and playerDataLoadState == "Failed" then
			return
		end
		self:retryLoadPersistedHealthLater(player, loadToken)
		return
	end

	local readSuccess, persistedHpRaw = pcall(function()
		return playerDataService:getHpData(player, nil)
	end)
	if not readSuccess then
		runtime.hasResolvedPersistedLoad = true
		self:pushState(player)
		return
	end

	runtime.hasResolvedPersistedLoad = true
	local persistedHealth, persistedMaxHealth =
		HpServiceUtils.resolvePersistedHealthAndMaxHealth(persistedHpRaw, runtime.state.maxHealth)
	if runtime.healthChangedBeforePersistedLoad then
		self:persistRuntime(player, runtime)
		runtime.pendingPersistedHealth = nil
		runtime.pendingPersistedMaxHealth = nil
		self:pushState(player)
		return
	end
	if persistedHealth == nil then
		self:persistRuntime(player, runtime)
		self:pushState(player)
		return
	end

	runtime.pendingPersistedHealth = persistedHealth
	runtime.pendingPersistedMaxHealth = persistedMaxHealth
	runtime.state = HpServiceUtils.createState(persistedHealth, persistedMaxHealth, self.heartValue, runtime.state)
	local humanoid = runtime.humanoid
	if humanoid ~= nil and humanoid.Parent ~= nil then
		self:applyPendingPersistedState(player, runtime, humanoid)
	else
		self:pushState(player)
	end
end

function HpServiceServer.BindHumanoid(self: HpServiceServer, player: Player, humanoid: Humanoid)
	local runtime = self:getRuntime(player)
	runtime.humanoid = humanoid
	runtime.isDeathLocked = isHumanoidDead(humanoid)
	applyHumanoidPresentationSettings(humanoid)
	local didApplyPendingHealth = self:applyPendingPersistedState(player, runtime, humanoid)
	if not didApplyPendingHealth then
		self:refreshStateFromHumanoid(player, humanoid)
	end
	if isGodmodeEnabled(player) then
		self:restoreGodmodeHealth(player, runtime, humanoid)
	end

	runtime.characterJanitor:GiveChore(humanoid.HealthChanged:Connect(function()
		if runtime.humanoid ~= humanoid then
			return
		end
		if isGodmodeEnabled(player) then
			local targetHealth = math.max(1, humanoid.MaxHealth)
			if humanoid.Health + 1e-3 < targetHealth then
				self:restoreGodmodeHealth(player, runtime, humanoid)
				return
			end
		end
		if humanoid.Health <= 0 then
			runtime.isDeathLocked = true
		elseif runtime.isDeathLocked and humanoid.Health > 0 then
			self:setHumanoidHealthWithoutDamageFeedback(runtime, humanoid, 0)
			self:refreshStateFromHumanoid(player, humanoid)
			return
		end

		if not runtime.hasResolvedPersistedLoad and not runtime.isApplyingPersistedHealth then
			if math.abs(humanoid.Health - runtime.state.health) > 1e-3 then
				runtime.healthChangedBeforePersistedLoad = true
			end
		end
		self:refreshStateFromHumanoid(player, humanoid)
	end))

	runtime.characterJanitor:GiveChore(humanoid:GetPropertyChangedSignal("MaxHealth"):Connect(function()
		if runtime.humanoid ~= humanoid then
			return
		end
		if isGodmodeEnabled(player) then
			self:restoreGodmodeHealth(player, runtime, humanoid)
			return
		end
		self:refreshStateFromHumanoid(player, humanoid)
	end))

	runtime.characterJanitor:GiveChore(humanoid.Destroying:Connect(function()
		if runtime.humanoid == humanoid then
			runtime.humanoid = nil
		end
	end))

	runtime.characterJanitor:GiveChore(humanoid.Died:Connect(function()
		if runtime.humanoid ~= humanoid then
			return
		end
		runtime.isDeathLocked = true
		self:refreshStateFromHumanoid(player, humanoid)
	end))
end

function HpServiceServer.BindCharacter(self: HpServiceServer, player: Player, character: Model)
	local runtime = self:getRuntime(player)
	runtime.characterJanitor:Clean()
	runtime.humanoid = nil
	runtime.isDeathLocked = false

	local currentHumanoid = character:FindFirstChildOfClass("Humanoid")
	if currentHumanoid then
		self:bindHumanoid(player, currentHumanoid)
	end

	runtime.characterJanitor:GiveChore(character.ChildAdded:Connect(function(child: Instance)
		if runtime.humanoid ~= nil then
			return
		end
		if child:IsA("Humanoid") then
			self:bindHumanoid(player, child)
		end
	end))

	runtime.characterJanitor:GiveChore(character.ChildRemoved:Connect(function(child: Instance)
		if runtime.humanoid == child then
			runtime.humanoid = nil
		end
	end))
end

function HpServiceServer.TrackPlayer(self: HpServiceServer, player: Player)
	local runtime = self:getRuntime(player)
	runtime.loadToken += 1
	runtime.state = HpServiceUtils.createDefaultState()
	runtime.playerJanitor:Clean()
	runtime.characterJanitor:Clean()
	runtime.humanoid = nil
	runtime.pendingPersistedHealth = nil
	runtime.pendingPersistedMaxHealth = nil
	runtime.hasResolvedPersistedLoad = false
	runtime.healthChangedBeforePersistedLoad = false
	runtime.isApplyingPersistedHealth = false
	runtime.suppressDamageFeedbackDepth = 0
	runtime.isDeathLocked = false

	runtime.playerJanitor:GiveChore(player.CharacterAdded:Connect(function(character: Model)
		self:bindCharacter(player, character)
	end))

	if player.Character then
		self:bindCharacter(player, player.Character)
	end
	self:pushState(player)

	local loadToken = runtime.loadToken
	task.spawn(function()
		self:loadPersistedHealth(player, loadToken)
	end)
end

function HpServiceServer.UntrackPlayer(self: HpServiceServer, player: Player)
	local runtime = self.playerRuntimes[player]
	if not runtime then
		return
	end
	self:persistRuntime(player, runtime)
	if self.playerDataService ~= nil then
		pcall(function()
			self.playerDataService:savePlayerData(player)
		end)
	end

	runtime.loadToken += 1
	runtime.playerJanitor:Destroy()
	runtime.characterJanitor:Destroy()
	self.playerRuntimes[player] = nil
end

function HpServiceServer.GetHumanoid(self: HpServiceServer, player: Player): Humanoid?
	local runtime = self:getRuntime(player)
	local cachedHumanoid = runtime.humanoid
	if cachedHumanoid and cachedHumanoid.Parent ~= nil then
		return cachedHumanoid
	end

	local character = player.Character
	if not character then
		return nil
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		runtime.humanoid = humanoid
		applyHumanoidPresentationSettings(humanoid)
	end

	return humanoid
end

function HpServiceServer.RequestSync(self: HpServiceServer, player: Player)
	local runtime = self.playerRuntimes[player]
	if runtime == nil then
		self:trackPlayer(player)
		return
	end

	if not runtime.hasResolvedPersistedLoad then
		local loadToken = runtime.loadToken
		task.spawn(function()
			self:loadPersistedHealth(player, loadToken)
		end)
	end

	self:pushState(player)
end

function HpServiceServer.GetState(self: HpServiceServer, player: Player): HpServiceState
	local runtime = self:getRuntime(player)
	return HpServiceUtils.cloneState(runtime.state)
end

function HpServiceServer.SetPlayerMaxHealth(
	self: HpServiceServer,
	player: Player,
	nextMaxHealthRaw: any,
	fillToMaxRaw: any
): number?
	local runtime = self:getRuntime(player)
	local nextMaxHealth = math.max(
		1,
		if typeof(nextMaxHealthRaw) == "number" and nextMaxHealthRaw == nextMaxHealthRaw
			then nextMaxHealthRaw
			else runtime.state.maxHealth
	)
	local fillToMax = fillToMaxRaw ~= false
	local appliedHealth = if fillToMax then nextMaxHealth else math.clamp(runtime.state.health, 0, nextMaxHealth)
	local stateHealth = if runtime.isDeathLocked then 0 else appliedHealth

	runtime.pendingPersistedMaxHealth = nextMaxHealth
	runtime.pendingPersistedHealth = appliedHealth
	if not runtime.hasResolvedPersistedLoad then
		runtime.healthChangedBeforePersistedLoad = true
	end

	runtime.state = HpServiceUtils.createState(stateHealth, nextMaxHealth, self.heartValue, runtime.state)

	local humanoid = self:getHumanoid(player)
	if humanoid ~= nil and humanoid.Parent ~= nil and not runtime.isDeathLocked then
		self:applyPendingPersistedState(player, runtime, humanoid)
		if not runtime.hasResolvedPersistedLoad then
			self:pushState(player)
		end
	else
		if runtime.hasResolvedPersistedLoad then
			self:persistRuntime(player, runtime)
		end
		self:pushState(player)
	end

	return nextMaxHealth
end

function HpServiceServer.SetPlayerHealth(self: HpServiceServer, player: Player, nextHealthRaw: any): number?
	local runtime = self:getRuntime(player)
	local humanoid = self:getHumanoid(player)
	if not humanoid then
		return nil
	end
	if runtime.isDeathLocked then
		if humanoid.Health > 0 then
			self:setHumanoidHealthWithoutDamageFeedback(runtime, humanoid, 0)
		end
		self:refreshStateFromHumanoid(player, humanoid)
		return humanoid.Health
	end

	local nextHealth = math.clamp(
		if typeof(nextHealthRaw) == "number" then nextHealthRaw else humanoid.Health,
		0,
		math.max(1, humanoid.MaxHealth)
	)
	humanoid.Health = nextHealth
	self:refreshStateFromHumanoid(player, humanoid)
	return nextHealth
end

function HpServiceServer.DamagePlayer(self: HpServiceServer, player: Player, damageRaw: any): number?
	local runtime = self:getRuntime(player)
	local humanoid = self:getHumanoid(player)
	if not humanoid then
		return nil
	end
	if isGodmodeEnabled(player) then
		return self:restoreGodmodeHealth(player, runtime, humanoid)
	end
	if runtime.isDeathLocked then
		self:refreshStateFromHumanoid(player, humanoid)
		return humanoid.Health
	end

	local amount = math.max(0, if typeof(damageRaw) == "number" then damageRaw else 0)
	humanoid:TakeDamage(amount)
	self:refreshStateFromHumanoid(player, humanoid)
	return humanoid.Health
end

function HpServiceServer.HealPlayer(self: HpServiceServer, player: Player, amountRaw: any): number?
	local runtime = self:getRuntime(player)
	local humanoid = self:getHumanoid(player)
	if not humanoid then
		return nil
	end
	if runtime.isDeathLocked then
		if humanoid.Health > 0 then
			self:setHumanoidHealthWithoutDamageFeedback(runtime, humanoid, 0)
		end
		self:refreshStateFromHumanoid(player, humanoid)
		return humanoid.Health
	end

	local amount = math.max(0, if typeof(amountRaw) == "number" then amountRaw else 0)
	local nextHealth = math.clamp(humanoid.Health + amount, 0, math.max(1, humanoid.MaxHealth))
	humanoid.Health = nextHealth
	self:refreshStateFromHumanoid(player, humanoid)
	return nextHealth
end

function HpServiceServer.Destroy(self: HpServiceServer)
	if self.playerAddedConnection then
		self.playerAddedConnection:Disconnect()
		self.playerAddedConnection = nil
	end

	if self.playerRemovingConnection then
		self.playerRemovingConnection:Disconnect()
		self.playerRemovingConnection = nil
	end

	for player, runtime in self.playerRuntimes do
		self:persistRuntime(player, runtime)
		runtime.playerJanitor:Destroy()
		runtime.characterJanitor:Destroy()
		self.playerRuntimes[player] = nil
	end

	if self.networker then
		self.networker:destroy()
	end
end

HpServiceServer.init = HpServiceServer.Init
HpServiceServer.createRuntime = HpServiceServer.CreateRuntime
HpServiceServer.setHumanoidHealthWithoutDamageFeedback = HpServiceServer.SetHumanoidHealthWithoutDamageFeedback
HpServiceServer.restoreGodmodeHealth = HpServiceServer.RestoreGodmodeHealth
HpServiceServer.getRuntime = HpServiceServer.GetRuntime
HpServiceServer.pushState = HpServiceServer.PushState
HpServiceServer.persistRuntime = HpServiceServer.PersistRuntime
HpServiceServer.applyPendingPersistedState = HpServiceServer.ApplyPendingPersistedState
HpServiceServer.refreshStateFromHumanoid = HpServiceServer.RefreshStateFromHumanoid
HpServiceServer.retryLoadPersistedHealthLater = HpServiceServer.RetryLoadPersistedHealthLater
HpServiceServer.loadPersistedHealth = HpServiceServer.LoadPersistedHealth
HpServiceServer.bindHumanoid = HpServiceServer.BindHumanoid
HpServiceServer.bindCharacter = HpServiceServer.BindCharacter
HpServiceServer.trackPlayer = HpServiceServer.TrackPlayer
HpServiceServer.untrackPlayer = HpServiceServer.UntrackPlayer
HpServiceServer.getHumanoid = HpServiceServer.GetHumanoid
HpServiceServer.requestSync = HpServiceServer.RequestSync
HpServiceServer.getState = HpServiceServer.GetState
HpServiceServer.setPlayerMaxHealth = HpServiceServer.SetPlayerMaxHealth
HpServiceServer.setPlayerHealth = HpServiceServer.SetPlayerHealth
HpServiceServer.damagePlayer = HpServiceServer.DamagePlayer
HpServiceServer.healPlayer = HpServiceServer.HealPlayer
HpServiceServer.destroy = HpServiceServer.Destroy

export type HpServiceServer = typeof(HpServiceServer) & {
	networker: Networker.Server,
	playerRuntimes: { [Player]: PlayerRuntime },
	heartValue: number,
	playerDataService: PlayerDataServiceServerObject,
	dataPath: { string },
	dataLoadTimeoutSeconds: number,
	dataLoadRetryDelaySeconds: number,
	playerAddedConnection: RBXScriptConnection?,
	playerRemovingConnection: RBXScriptConnection?,
}

return HpServiceServer :: HpServiceServer
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="1052">
              <Properties>
                <string name="Name">InventoryServiceServer</string>
                <string name="Source"><![CDATA[--!strict
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local Workspace = game:GetService("Workspace")

local BuildServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.BuildServiceUtils)
local InventoryProfile = require(script:FindFirstAncestor("game").Shared.Services.Profile)
local InventoryServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.InventoryServiceUtils)
local ItemRegistry = require(script:FindFirstAncestor("game").Shared.Modules.Items.Registry)
local Janitor = require(ReplicatedStorage.Packages.Janitor)
local MiningPower = require(script:FindFirstAncestor("game").Shared.Modules.Math.MiningPower)
local Networker = require(script:FindFirstAncestor("game").Shared.Modules.Networking.Networker)
local PlayerDataServiceServer = require(script:FindFirstAncestor("game").Server.Services.PlayerDataServiceServer)
local PlayerDataServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.PlayerDataServiceUtils)
local ResolveItem = require(script:FindFirstAncestor("game").Shared.Modules.Game.Format.ResolveItem)
local ResolveToolInstance = require(script:FindFirstAncestor("game").Shared.Modules.Game.Format.ResolveToolInstance)
local TagBinder = require(script:FindFirstAncestor("game").Shared.Binders.TagBinder)
local ToolBinder = require(script:FindFirstAncestor("game").Shared.Binders.ToolBinder)
local TorchTilt = require(script:FindFirstAncestor("game").Shared.Modules.Math.TorchTilt)
local WorldGenerationServiceServer =
	require(script:FindFirstAncestor("game").Server.Services.WorldGenerationServiceServer)

type InventoryState = InventoryServiceUtils.InventoryState
type AddItemResult = InventoryServiceUtils.AddItemResult
type RemoveItemResult = InventoryServiceUtils.RemoveItemResult
type SlotMutationResult = InventoryServiceUtils.SlotMutationResult

type JanitorClass = {
	GiveChore: (self: JanitorClass, chore: any, ...any) -> (),
	Clean: (self: JanitorClass) -> (),
	Destroy: (self: JanitorClass) -> (),
}

type PlayerDataServiceServerObject = {
	getValue: (self: PlayerDataServiceServerObject, player: Player, pathRaw: any, fallback: any) -> any,
	getLoadState: (self: PlayerDataServiceServerObject, player: Player) -> string,
	getProfile: (self: PlayerDataServiceServerObject, player: Player) -> any,
	isLoaded: (self: PlayerDataServiceServerObject, player: Player) -> boolean,
	requestSync: (self: PlayerDataServiceServerObject, player: Player) -> (),
	waitForData: (self: PlayerDataServiceServerObject, player: Player, timeoutSecondsRaw: any) -> any,
	setValue: (
		self: PlayerDataServiceServerObject,
		player: Player,
		pathRaw: any,
		value: any,
		replicateToClientRaw: any
	) -> boolean,
}

type InventoryProfileObject = {
	cloneDefaultInventoryData: (self: InventoryProfileObject) -> { [string]: any },
	getDataPath: (self: InventoryProfileObject) -> { string },
	getDataPathString: (self: InventoryProfileObject) -> string,
	hasAuthoritativeProfile: (self: InventoryProfileObject, player: Player) -> boolean,
	saveProfile: (self: InventoryProfileObject, player: Player) -> (boolean, string),
	saveState: (self: InventoryProfileObject, player: Player, stateRaw: any) -> (boolean, string),
	writeState: (self: InventoryProfileObject, player: Player, stateRaw: any) -> (boolean, string),
}

type PendingToolImport = { itemId: string, itemType: string, amount: number }
type PlayerRuntime = {
	userId: number,
	player: Player,
	state: InventoryState,
	isLoading: boolean,
	isLoaded: boolean,
	isDirty: boolean,
	isSaving: boolean,
	saveQueued: boolean,
	loadState: string,
	lastReplicatedStateHash: string?,
	selectedSlot: number?,
	toolSyncJanitor: JanitorClass,
	playerJanitor: JanitorClass,
	characterJanitor: JanitorClass,
	pendingToolImports: { [string]: PendingToolImport },
	suppressedToolImports: { [string]: number },
	resolvedSource: string,
	joinToken: number,
	loadToken: number,
	hasResolvedInitialLoad: boolean,
	lastFailureReason: string?,
	loadStartedAt: number,
	saveDebounceToken: number,
	lastSavedRevision: number,
	lastStagedRevision: number,
	revision: number,
}

local InventoryServiceServer = {}

local PRIMARY_PERSISTENCE_TIMEOUT_SECONDS = 3
local FALLBACK_PERSISTENCE_TIMEOUT_SECONDS = 4
local PLAYER_DATA_SETTLE_TIMEOUT_SECONDS = 8
local SAVE_DEBOUNCE_SECONDS = 0.25
local SAVE_RETRY_SECONDS = 5
local TOOL_IMPORT_ATTRIBUTE_NAME = "itemId"
local TOOL_IMPORT_TYPE_ATTRIBUTE_NAME = "itemType"
local TOOL_IMPORT_METADATA_TYPE_KEY = "itemType"
local TOOL_IMPORT_STACK_ID_PREFIX = "tool"
local STACK_ID_ATTRIBUTE_NAME = "InventoryStackId"
local SELECTED_SLOT_ATTRIBUTE_NAME = "InventorySelectedSlot"
local MANAGED_TOOL_ATTRIBUTE_NAME = "InventoryManagedTool"
local GENERATED_TOOL_WELD_ATTRIBUTE_NAME = "InventoryManagedToolWeld"
local DEPLOYABLE_PLACED_ATTRIBUTE_NAME = "PlacedItemId"
local DEPLOYABLE_TILE_X_ATTRIBUTE_NAME = "DeployableTileX"
local DEPLOYABLE_TILE_Y_ATTRIBUTE_NAME = "DeployableTileY"
local DEPLOYABLE_SUPPORT_KIND_ATTRIBUTE_NAME = "DeployableSupportKind"
local TORCH_DEPLOYABLE_TAG = TagBinder.Tags.Light_Torch
local TORCH_GROUND_NORMAL = Vector3.new(0, 1, 0)
local TORCH_LEFT_WALL_NORMAL = Vector3.new(0, 0, 1)
local TORCH_RIGHT_WALL_NORMAL = Vector3.new(0, 0, -1)

local function createEmptyAddItemResult(): AddItemResult
	return { requested = 0, added = 0, leftover = 0, changed = false, touchedSlots = {} }
end

local function createEmptyRemoveItemResult(): RemoveItemResult
	return { requested = 0, removed = 0, leftover = 0, changed = false, touchedSlots = {} }
end

local function createEmptySlotMutationResult(): SlotMutationResult
	return {
		changed = false,
		touchedSlots = {},
		fromSlot = nil,
		toSlot = nil,
		movedAmount = 0,
		removedAmount = 0,
		swapped = false,
	}
end

local function trim(valueRaw: any): string
	if typeof(valueRaw) ~= "string" then
		return ""
	end
	return string.match(valueRaw, "^%s*(.-)%s*$") or ""
end

local function sanitizeItemId(itemIdRaw: any): string?
	local itemId = trim(itemIdRaw)
	if itemId == "" then
		return nil
	end
	return itemId
end

local function normalizeImportAmount(amountRaw: any): number
	if typeof(amountRaw) ~= "number" or amountRaw ~= amountRaw then
		return 1
	end
	return math.max(1, math.floor(amountRaw))
end

local function sanitizeNumber(valueRaw: any, fallback: number, minimum: number): number
	if typeof(valueRaw) ~= "number" or valueRaw ~= valueRaw then
		return fallback
	end
	return math.max(minimum, valueRaw)
end

local function sanitizeFailureReason(reasonRaw: any): string?
	local reason = trim(reasonRaw)
	if reason == "" then
		return nil
	end
	return reason
end

local function stringifyLogValue(valueRaw: any): string
	if valueRaw == nil then
		return "nil"
	end
	local valueType = typeof(valueRaw)
	if valueType == "string" or valueType == "number" or valueType == "boolean" then
		return tostring(valueRaw)
	end
	return valueType
end

local function resolveItemTypeForStack(stackRaw: any): string?
	if typeof(stackRaw) ~= "table" then
		return nil
	end
	local stack = stackRaw :: { [string]: any }
	local metadata = if typeof(stack.metadata) == "table" then stack.metadata else nil
	local metadataItemType = if metadata ~= nil
		then sanitizeItemId((metadata :: { [string]: any })[TOOL_IMPORT_METADATA_TYPE_KEY])
		else nil
	if metadataItemType ~= nil then
		return metadataItemType
	end
	local definition = ItemRegistry.resolveDefinition(stack.itemId)
	if typeof(definition) == "table" then
		local definitionTable = definition :: { [string]: any }
		local itemType = sanitizeItemId(definitionTable.itemType) or sanitizeItemId(definitionTable.type)
		if itemType ~= nil then
			return itemType
		end
	end
	return sanitizeItemId(stack.itemId)
end

local function resolveToolImportData(tool: Tool): (string?, string?)
	local itemId = ResolveToolInstance.resolveToolItemId(tool)
	if itemId == nil then
		return nil, nil
	end
	local itemType = sanitizeItemId(ResolveToolInstance.resolveToolItemType(tool)) or sanitizeItemId(tool.Name)
	if itemType == nil then
		return nil, nil
	end
	return itemId, itemType
end

local function isManagedInventoryTool(tool: Tool): boolean
	return tool:GetAttribute(MANAGED_TOOL_ATTRIBUTE_NAME) == true
end

local function applyToolHandleProperties(part: BasePart)
	part.Name = "Handle"
	part.Anchored = false
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Massless = true
end

local function applyToolVisualProperties(part: BasePart)
	part.Anchored = false
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Massless = true
end

local function createFallbackToolHandle(tool: Tool, itemIdRaw: any): BasePart
	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.45, 2.2, 0.45)
	handle.Material = Enum.Material.Metal
	handle.Color = if string.find(string.lower(sanitizeItemId(itemIdRaw) or tool.Name), "copper", 1, true) ~= nil
		then Color3.fromRGB(184, 115, 51)
		else Color3.fromRGB(163, 162, 165)
	handle.Parent = tool
	applyToolHandleProperties(handle)
	return handle
end

local function clearGeneratedToolWelds(tool: Tool)
	for _, descendant in tool:GetDescendants() do
		if descendant:IsA("WeldConstraint") and descendant:GetAttribute(GENERATED_TOOL_WELD_ATTRIBUTE_NAME) == true then
			descendant:Destroy()
		end
	end
end

local function collectOwnedToolParts(tool: Tool): { BasePart }
	local parts = {}
	for _, descendant in tool:GetDescendants() do
		if descendant:IsA("BasePart") and descendant:FindFirstAncestorWhichIsA("Tool") == tool then
			parts[#parts + 1] = descendant
		end
	end
	return parts
end

local function bindToolDescendantsToHandle(tool: Tool, handle: BasePart)
	clearGeneratedToolWelds(tool)
	for _, part in collectOwnedToolParts(tool) do
		applyToolVisualProperties(part)
		if part ~= handle then
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = handle
			weld.Part1 = part
			weld:SetAttribute(GENERATED_TOOL_WELD_ATTRIBUTE_NAME, true)
			weld.Parent = handle
		end
	end
end

local function ensureToolHasVisibleHandle(tool: Tool, itemIdRaw: any): BasePart
	tool.RequiresHandle = true
	local existingHandle = tool:FindFirstChild("Handle")
	if existingHandle ~= nil and existingHandle:IsA("BasePart") then
		applyToolHandleProperties(existingHandle)
		bindToolDescendantsToHandle(tool, existingHandle)
		return existingHandle
	end
	local directPart = tool:FindFirstChildWhichIsA("BasePart")
	if directPart ~= nil then
		applyToolHandleProperties(directPart)
		bindToolDescendantsToHandle(tool, directPart)
		return directPart
	end
	local descendantPart = tool:FindFirstChildWhichIsA("BasePart", true)
	if descendantPart ~= nil then
		local clonedHandle = descendantPart:Clone()
		clonedHandle.Parent = tool
		clonedHandle.Transparency = 1
		applyToolHandleProperties(clonedHandle)
		bindToolDescendantsToHandle(tool, clonedHandle)
		return clonedHandle
	end
	local fallback = createFallbackToolHandle(tool, itemIdRaw)
	bindToolDescendantsToHandle(tool, fallback)
	return fallback
end

local function createFallbackManagedTool(itemIdRaw: any): Tool?
	local itemId = sanitizeItemId(itemIdRaw)
	if itemId == nil then
		return nil
	end

	local tool = Instance.new("Tool")
	tool.Name = itemId
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	return tool
end

local function configureManagedToolForInventoryStack(tool: Tool, itemIdRaw: any, stackRaw: any, selectedSlotRaw: any)
	local itemId = sanitizeItemId(itemIdRaw)
	if itemId == nil then
		return
	end
	tool:SetAttribute(MANAGED_TOOL_ATTRIBUTE_NAME, true)
	tool:SetAttribute(TOOL_IMPORT_ATTRIBUTE_NAME, itemId)
	tool:SetAttribute("ItemId", itemId)
	tool:SetAttribute(STACK_ID_ATTRIBUTE_NAME, if typeof(stackRaw) == "table" then (stackRaw :: any).stackId else nil)
	tool:SetAttribute(
		SELECTED_SLOT_ATTRIBUTE_NAME,
		if typeof(selectedSlotRaw) == "number" then math.floor(selectedSlotRaw) else nil
	)
	local itemType = resolveItemTypeForStack(stackRaw)
	tool:SetAttribute(TOOL_IMPORT_TYPE_ATTRIBUTE_NAME, itemType)
	tool:SetAttribute("ItemType", itemType)
	local definition = ItemRegistry.resolveDefinition(itemId)
	local toolAttributes = MiningPower.toToolAttributeBundle(definition, itemType, nil)
	for attributeName, attributeValue in toolAttributes do
		tool:SetAttribute(attributeName, attributeValue)
	end
	ensureToolHasVisibleHandle(tool, itemId)
	ToolBinder.applyTags(tool)
end

local function cloneToolForInventoryStack(itemIdRaw: any, stackRaw: any, selectedSlotRaw: any): Tool?
	local itemId = sanitizeItemId(itemIdRaw)
	if itemId == nil then
		return nil
	end
	local clone = ResolveItem.cloneToolTemplate(itemId)
	if clone == nil then
		clone = createFallbackManagedTool(itemId)
	end
	if clone == nil then
		return nil
	end
	configureManagedToolForInventoryStack(clone, itemId, stackRaw, selectedSlotRaw)
	return clone
end

local function destroyManagedToolsExcept(player: Player, preserveToolRaw: any)
	local preserveTool = if typeof(preserveToolRaw) == "Instance" and preserveToolRaw:IsA("Tool")
		then preserveToolRaw :: Tool
		else nil
	for _, container in { player.Character, player:FindFirstChildOfClass("Backpack") } do
		if typeof(container) ~= "Instance" then
			continue
		end
		for _, child in container:GetChildren() do
			if child:IsA("Tool") and child ~= preserveTool and isManagedInventoryTool(child) then
				child:Destroy()
			end
		end
	end
end

local function destroyMatchingToolsInContainer(container: Instance?, itemId: string, amountRaw: any): number
	if container == nil or typeof(amountRaw) ~= "number" or amountRaw ~= amountRaw then
		return 0
	end
	local remaining = math.max(0, math.floor(amountRaw))
	if remaining <= 0 then
		return 0
	end
	local destroyed = 0
	for _, child in container:GetChildren() do
		if destroyed >= remaining then
			break
		end
		if not child:IsA("Tool") then
			continue
		end
		local toolItemId = select(1, resolveToolImportData(child))
		if toolItemId ~= itemId then
			continue
		end
		child:Destroy()
		destroyed += 1
	end
	return destroyed
end

local function queuePendingToolImport(runtime: PlayerRuntime, itemId: string, itemType: string, amountRaw: any)
	local amount = normalizeImportAmount(amountRaw)
	local key = ("%s::%s"):format(itemId, itemType)
	local existing = runtime.pendingToolImports[key]
	if existing == nil then
		runtime.pendingToolImports[key] = { itemId = itemId, itemType = itemType, amount = amount }
	else
		existing.amount += amount
	end
end

local function queueSuppressedToolImport(runtime: PlayerRuntime, itemIdRaw: any, amountRaw: any)
	local itemId = sanitizeItemId(itemIdRaw)
	if itemId == nil then
		return
	end
	local amount = normalizeImportAmount(amountRaw)
	runtime.suppressedToolImports[itemId] = (runtime.suppressedToolImports[itemId] or 0) + amount
end

local function consumeSuppressedToolImport(runtime: PlayerRuntime, itemIdRaw: any, amountRaw: any): boolean
	local itemId = sanitizeItemId(itemIdRaw)
	if itemId == nil then
		return false
	end
	local amount = normalizeImportAmount(amountRaw)
	local current = runtime.suppressedToolImports[itemId] or 0
	if current <= 0 then
		return false
	end
	local remaining = current - amount
	runtime.suppressedToolImports[itemId] = if remaining > 0 then remaining else nil
	return true
end

local function resolveHorizontalLookVector(rootPart: BasePart): Vector3
	local flat = Vector3.new(rootPart.CFrame.LookVector.X, 0, rootPart.CFrame.LookVector.Z)
	if flat.Magnitude <= 0.001 then
		return Vector3.new(0, 0, -1)
	end
	return flat.Unit
end

local function resolveDeployableConfig(itemIdRaw: any): { [string]: any }?
	local itemId = sanitizeItemId(itemIdRaw)
	if itemId == nil then
		return nil
	end
	local definition = ItemRegistry.resolveDefinition(itemId)
	if typeof(definition) ~= "table" then
		return nil
	end
	local deployable = (definition :: { [string]: any }).deployable
	if typeof(deployable) ~= "table" then
		return nil
	end
	if sanitizeItemId((deployable :: { [string]: any }).stationTag) == nil then
		return nil
	end
	return deployable :: { [string]: any }
end

local function resolveDeployablePrimaryPart(instance: Instance): BasePart?
	if instance:IsA("BasePart") then
		return instance
	end
	if instance:IsA("Model") then
		if instance.PrimaryPart ~= nil then
			return instance.PrimaryPart
		end
		local descendant = instance:FindFirstChildWhichIsA("BasePart", true)
		if descendant ~= nil then
			instance.PrimaryPart = descendant
			return descendant
		end
	end
	return nil
end

local function resolveWorldGridConfig(): (any, Vector3?, number?, number?)
	local getWorldMethod = (WorldGenerationServiceServer :: any).getWorld
	if typeof(getWorldMethod) ~= "function" then
		return nil, nil, nil, nil
	end

	local ok, world = pcall(function()
		return (WorldGenerationServiceServer :: any):getWorld()
	end)
	if not ok or typeof(world) ~= "table" then
		return nil, nil, nil, nil
	end

	local worldOrigin = if typeof((world :: any).worldOrigin) == "Vector3" then (world :: any).worldOrigin else nil
	local tileSize = if typeof((world :: any).tileSize) == "number"
			and (world :: any).tileSize == (world :: any).tileSize
		then (world :: any).tileSize
		else nil
	local basePlaneX = if typeof((world :: any).basePlaneX) == "number"
			and (world :: any).basePlaneX == (world :: any).basePlaneX
		then (world :: any).basePlaneX
		else nil
	return world, worldOrigin, tileSize, basePlaneX
end

local function getWorldTileId(worldRaw: any, tileX: number, tileY: number): number
	if typeof(worldRaw) ~= "table" then
		return BuildServiceUtils.AIR_TILE_ID
	end

	local getTileAtMethod = (worldRaw :: any).getTileAt
	if typeof(getTileAtMethod) ~= "function" then
		return BuildServiceUtils.AIR_TILE_ID
	end

	local ok, tileIdOrError = pcall(function()
		return (worldRaw :: any):getTileAt(tileX, tileY)
	end)
	if not ok then
		return BuildServiceUtils.AIR_TILE_ID
	end

	local tileId = BuildServiceUtils.sanitizeTileId(tileIdOrError)
	if tileId == nil then
		return BuildServiceUtils.AIR_TILE_ID
	end
	return tileId
end

local function findTorchDeployableAtTile(tileX: number, tileY: number, excludeInstance: Instance?): Instance?
	for _, tagged in TagBinder.getTagged(TORCH_DEPLOYABLE_TAG, CollectionService) do
		if tagged == excludeInstance then
			continue
		end
		local taggedTileX = tagged:GetAttribute(DEPLOYABLE_TILE_X_ATTRIBUTE_NAME)
		local taggedTileY = tagged:GetAttribute(DEPLOYABLE_TILE_Y_ATTRIBUTE_NAME)
		if typeof(taggedTileX) == "number" and typeof(taggedTileY) == "number" then
			if math.floor(taggedTileX) == tileX and math.floor(taggedTileY) == tileY then
				return tagged
			end
		end
	end
	return nil
end

local function canOccupyTorchTile(worldRaw: any, tileX: number, tileY: number, excludeInstance: Instance?): boolean
	local tileId = getWorldTileId(worldRaw, tileX, tileY)
	if not BuildServiceUtils.isReplaceableTile(tileId) then
		return false
	end
	return findTorchDeployableAtTile(tileX, tileY, excludeInstance) == nil
end

local function isTorchGroundSupported(worldRaw: any, tileX: number, tileY: number): boolean
	local belowTileId = getWorldTileId(worldRaw, tileX, tileY - 1)
	return not BuildServiceUtils.isReplaceableTile(belowTileId)
end

local function isSolidTorchSupportTile(worldRaw: any, tileX: number, tileY: number): boolean
	return BuildServiceUtils.isSolidTile(getWorldTileId(worldRaw, tileX, tileY))
end

local function isTorchPlacementInRange(
	rootPosition: Vector3,
	placement: TorchTilt.TilePlacement,
	maxPlacementDistance: number,
	tileSize: number
): boolean
	return BuildServiceUtils.WorldDistance2D(rootPosition, placement.cframe.Position)
		<= (maxPlacementDistance + tileSize)
end

local function buildTorchTilePlacement(
	tileX: number,
	tileY: number,
	supportNormal: Vector3,
	boundingRotation: CFrame,
	worldOrigin: Vector3,
	tileSize: number,
	basePlaneX: number,
	lookVector: Vector3
): TorchTilt.TilePlacement?
	local tileCenter = BuildServiceUtils.TileToWorldCenter(tileX, tileY, worldOrigin, tileSize, basePlaneX)
	local supportCFrame, supportKind = TorchTilt.resolveTileAlignedCFrame(tileCenter, supportNormal, lookVector)
	if supportCFrame == nil or supportKind == nil then
		return nil
	end

	local finalCFrame = supportCFrame * boundingRotation
	return {
		tileX = tileX,
		tileY = tileY,
		supportKind = supportKind,
		cframe = CFrame.new(tileCenter) * finalCFrame.Rotation,
	}
end

local function resolveTorchPlacementAtTargetTile(
	worldRaw: any,
	tileX: number,
	tileY: number,
	boundingRotation: CFrame,
	worldOrigin: Vector3,
	tileSize: number,
	basePlaneX: number,
	lookVector: Vector3
): TorchTilt.TilePlacement?
	if not canOccupyTorchTile(worldRaw, tileX, tileY, nil) then
		return nil
	end

	if isSolidTorchSupportTile(worldRaw, tileX, tileY - 1) then
		return buildTorchTilePlacement(
			tileX,
			tileY,
			TORCH_GROUND_NORMAL,
			boundingRotation,
			worldOrigin,
			tileSize,
			basePlaneX,
			lookVector
		)
	end

	local hasLeftWall = isSolidTorchSupportTile(worldRaw, tileX - 1, tileY)
	local hasRightWall = isSolidTorchSupportTile(worldRaw, tileX + 1, tileY)
	if hasLeftWall and hasRightWall then
		return buildTorchTilePlacement(
			tileX,
			tileY,
			if lookVector.Z >= 0 then TORCH_LEFT_WALL_NORMAL else TORCH_RIGHT_WALL_NORMAL,
			boundingRotation,
			worldOrigin,
			tileSize,
			basePlaneX,
			lookVector
		)
	end
	if hasLeftWall then
		return buildTorchTilePlacement(
			tileX,
			tileY,
			TORCH_LEFT_WALL_NORMAL,
			boundingRotation,
			worldOrigin,
			tileSize,
			basePlaneX,
			lookVector
		)
	end
	if hasRightWall then
		return buildTorchTilePlacement(
			tileX,
			tileY,
			TORCH_RIGHT_WALL_NORMAL,
			boundingRotation,
			worldOrigin,
			tileSize,
			basePlaneX,
			lookVector
		)
	end

	return nil
end

local function resolveTorchPlacementFromRequestedTile(
	worldRaw: any,
	requestedTileX: number,
	requestedTileY: number,
	rootPart: BasePart,
	lookVector: Vector3,
	boundingRotation: CFrame,
	worldOrigin: Vector3,
	tileSize: number,
	basePlaneX: number,
	maxPlacementDistance: number
): TorchTilt.TilePlacement?
	local candidates = {} :: { { tileX: number, tileY: number } }
	local seen = {} :: { [string]: boolean }

	local function appendCandidate(tileX: number, tileY: number)
		local key = ("%d:%d"):format(tileX, tileY)
		if seen[key] == true then
			return
		end
		seen[key] = true
		candidates[#candidates + 1] = {
			tileX = tileX,
			tileY = tileY,
		}
	end

	appendCandidate(requestedTileX, requestedTileY)

	local requestedTileId = getWorldTileId(worldRaw, requestedTileX, requestedTileY)
	if not BuildServiceUtils.isReplaceableTile(requestedTileId) then
		appendCandidate(requestedTileX, requestedTileY + 1)
		if lookVector.Z >= 0 then
			appendCandidate(requestedTileX + 1, requestedTileY)
			appendCandidate(requestedTileX - 1, requestedTileY)
		else
			appendCandidate(requestedTileX - 1, requestedTileY)
			appendCandidate(requestedTileX + 1, requestedTileY)
		end
	end

	for _, candidate in candidates do
		local placement = resolveTorchPlacementAtTargetTile(
			worldRaw,
			candidate.tileX,
			candidate.tileY,
			boundingRotation,
			worldOrigin,
			tileSize,
			basePlaneX,
			lookVector
		)
		if
			placement ~= nil and isTorchPlacementInRange(rootPart.Position, placement, maxPlacementDistance, tileSize)
		then
			return placement
		end
	end

	return nil
end

local function chooseTorchPlacement(
	worldRaw: any,
	groundPlacement: TorchTilt.TilePlacement?,
	wallPlacement: TorchTilt.TilePlacement?
): TorchTilt.TilePlacement?
	local validGround = if groundPlacement ~= nil
		then canOccupyTorchTile(worldRaw, groundPlacement.tileX, groundPlacement.tileY, nil)
		else false
	local validWall = if wallPlacement ~= nil
		then canOccupyTorchTile(worldRaw, wallPlacement.tileX, wallPlacement.tileY, nil)
		else false

	if validGround and validWall and groundPlacement ~= nil and wallPlacement ~= nil then
		if groundPlacement.tileX == wallPlacement.tileX and groundPlacement.tileY == wallPlacement.tileY then
			return groundPlacement
		end
		if isTorchGroundSupported(worldRaw, wallPlacement.tileX, wallPlacement.tileY) then
			return groundPlacement
		end
	end

	if validWall then
		return wallPlacement
	end
	if validGround then
		return groundPlacement
	end
	return nil
end

local function resolveTorchDeployablePlacement(
	player: Player,
	deployableConfig: { [string]: any },
	placedInstance: Instance,
	requestedTileXRaw: any?,
	requestedTileYRaw: any?
): TorchTilt.TilePlacement?
	local character = player.Character
	if character == nil then
		return nil
	end
	local rootPart = character.PrimaryPart or (character:FindFirstChild("HumanoidRootPart") :: BasePart?)
	if rootPart == nil then
		return nil
	end

	local world, worldOrigin, tileSize, basePlaneX = resolveWorldGridConfig()
	if world == nil or worldOrigin == nil or tileSize == nil or basePlaneX == nil then
		return nil
	end

	local lookVector = resolveHorizontalLookVector(rootPart)
	local placementDistance = sanitizeNumber(deployableConfig.placementDistance, 6, 2)
	local maxPlacementDistance =
		sanitizeNumber(deployableConfig.maxPlacementDistance, placementDistance + 4, placementDistance)
	local supportDistance = math.min(placementDistance, maxPlacementDistance)
	local boundingCFrame: CFrame
	local boundingSize: Vector3
	local boundingRotation: CFrame
	if placedInstance:IsA("Model") then
		boundingCFrame, boundingSize = placedInstance:GetBoundingBox()
	else
		local placedPart = placedInstance :: BasePart
		boundingCFrame = placedPart.CFrame
		boundingSize = placedPart.Size
	end
	boundingRotation = boundingCFrame.Rotation

	local requestedTileX = BuildServiceUtils.sanitizeTileCoordinate(requestedTileXRaw)
	local requestedTileY = BuildServiceUtils.sanitizeTileCoordinate(requestedTileYRaw)
	if requestedTileX ~= nil and requestedTileY ~= nil then
		local requestedPlacement = resolveTorchPlacementFromRequestedTile(
			world,
			requestedTileX,
			requestedTileY,
			rootPart,
			lookVector,
			boundingRotation,
			worldOrigin,
			tileSize,
			basePlaneX,
			maxPlacementDistance
		)
		if requestedPlacement ~= nil then
			return requestedPlacement
		end
	end

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character, placedInstance }

	local function buildPlacementFromSupport(hitPosition: Vector3, hitNormal: Vector3): TorchTilt.TilePlacement?
		local supportCFrame, supportKind =
			TorchTilt.resolvePlacementCFrame(hitPosition, hitNormal, boundingSize, lookVector)
		if supportCFrame == nil or supportKind == nil then
			return nil
		end

		local finalCFrame = supportCFrame * boundingRotation
		local tileX, tileY = BuildServiceUtils.WorldPositionToTile(finalCFrame.Position, worldOrigin, tileSize)
		local hitNormalUnit = hitNormal.Unit
		if not BuildServiceUtils.isReplaceableTile(getWorldTileId(world, tileX, tileY)) then
			if supportKind == "Ground" then
				tileY += 1
			else
				tileX += if hitNormalUnit.Z >= 0 then 1 else -1
			end
		end
		local tileCenter = BuildServiceUtils.TileToWorldCenter(tileX, tileY, worldOrigin, tileSize, basePlaneX)

		return {
			tileX = tileX,
			tileY = tileY,
			supportKind = supportKind,
			cframe = CFrame.new(tileCenter) * finalCFrame.Rotation,
		}
	end

	local wallPlacement = nil :: TorchTilt.TilePlacement?
	local wallOrigin = rootPart.Position + Vector3.new(0, 2, 0)
	local wallResult = Workspace:Raycast(wallOrigin, lookVector * supportDistance, params)
	if
		wallResult ~= nil
		and TorchTilt.isSolidSurface(wallResult.Instance)
		and TorchTilt.isWallNormal(wallResult.Normal)
	then
		wallPlacement = buildPlacementFromSupport(wallResult.Position, wallResult.Normal)
	end

	local groundPlacement = nil :: TorchTilt.TilePlacement?
	local desiredPosition = rootPart.Position + Vector3.new(0, 4, 0) + (lookVector * supportDistance)
	local groundResult = Workspace:Raycast(desiredPosition + Vector3.new(0, 12, 0), Vector3.new(0, -32, 0), params)
	if
		groundResult ~= nil
		and TorchTilt.isSolidSurface(groundResult.Instance)
		and TorchTilt.isGroundNormal(groundResult.Normal)
	then
		groundPlacement = buildPlacementFromSupport(groundResult.Position, groundResult.Normal)
	end

	return chooseTorchPlacement(world, groundPlacement, wallPlacement)
end

local function setModelAnchored(instance: Instance, anchored: boolean)
	if instance:IsA("BasePart") then
		instance.Anchored = anchored
		return
	end
	for _, descendant in instance:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.Anchored = anchored
		end
	end
end

local function resolveDeployablePlacementCFrame(
	player: Player,
	deployableConfig: { [string]: any },
	placedInstance: Instance
): CFrame?
	local character = player.Character
	if character == nil then
		return nil
	end
	local rootPart = character.PrimaryPart or (character:FindFirstChild("HumanoidRootPart") :: BasePart?)
	if rootPart == nil then
		return nil
	end
	local lookVector = resolveHorizontalLookVector(rootPart)
	local placementDistance = sanitizeNumber(deployableConfig.placementDistance, 6, 2)
	local maxPlacementDistance =
		sanitizeNumber(deployableConfig.maxPlacementDistance, placementDistance + 4, placementDistance)
	local placementProfile = sanitizeItemId((deployableConfig :: { [string]: any }).placementProfile)
	local boundingCFrame: CFrame
	local boundingSize: Vector3
	if placedInstance:IsA("Model") then
		boundingCFrame, boundingSize = placedInstance:GetBoundingBox()
	else
		local placedPart = placedInstance :: BasePart
		boundingCFrame = placedPart.CFrame
		boundingSize = placedPart.Size
	end

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character, placedInstance }

	if placementProfile == "Torch" then
		local supportDistance = math.min(placementDistance, maxPlacementDistance)
		local wallOrigin = rootPart.Position + Vector3.new(0, 2, 0)
		local wallResult = Workspace:Raycast(wallOrigin, lookVector * supportDistance, params)
		if
			wallResult ~= nil
			and TorchTilt.isSolidSurface(wallResult.Instance)
			and TorchTilt.isWallNormal(wallResult.Normal)
		then
			local supportCFrame =
				TorchTilt.resolvePlacementCFrame(wallResult.Position, wallResult.Normal, boundingSize, lookVector)
			if supportCFrame ~= nil then
				return supportCFrame * boundingCFrame.Rotation
			end
		end

		local desiredPosition = rootPart.Position + Vector3.new(0, 4, 0) + (lookVector * supportDistance)
		local groundResult = Workspace:Raycast(desiredPosition + Vector3.new(0, 12, 0), Vector3.new(0, -32, 0), params)
		if groundResult == nil then
			return nil
		end
		if not TorchTilt.isSolidSurface(groundResult.Instance) or not TorchTilt.isGroundNormal(groundResult.Normal) then
			return nil
		end

		local supportCFrame =
			TorchTilt.resolvePlacementCFrame(groundResult.Position, groundResult.Normal, boundingSize, lookVector)
		if supportCFrame == nil then
			return nil
		end
		return supportCFrame * boundingCFrame.Rotation
	end

	local desiredPosition = rootPart.Position
		+ Vector3.new(0, 4, 0)
		+ (lookVector * math.min(placementDistance, maxPlacementDistance))
	local groundResult = Workspace:Raycast(desiredPosition + Vector3.new(0, 12, 0), Vector3.new(0, -32, 0), params)
	local groundPosition = if groundResult ~= nil then groundResult.Position else desiredPosition
	local yaw = math.atan2(-lookVector.X, -lookVector.Z)
	local targetPosition =
		Vector3.new(groundPosition.X, groundPosition.Y + math.max(0, boundingSize.Y * 0.5), groundPosition.Z)
	return CFrame.new(targetPosition) * CFrame.Angles(0, yaw, 0) * boundingCFrame.Rotation
end

local function applyRuntimeState(runtime: PlayerRuntime, nextStateRaw: any)
	runtime.state = InventoryServiceUtils.sanitizeState(nextStateRaw, runtime.state)
	runtime.loadState = runtime.state.loadState
	runtime.selectedSlot = runtime.state.selectedSlot
	runtime.isLoaded = InventoryServiceUtils.isLoadedState(runtime.state.loadState)
	if runtime.state.loadState ~= InventoryServiceUtils.LOAD_STATE_LOADING then
		runtime.isLoading = false
	end
end

local function getRuntimeLoadElapsedSeconds(runtime: PlayerRuntime): number
	if runtime.loadStartedAt <= 0 then
		return 0
	end
	return math.max(0, os.clock() - runtime.loadStartedAt)
end

function InventoryServiceServer.LogEvent(
	_self: InventoryServiceServer,
	eventName: string,
	player: Player,
	runtime: PlayerRuntime?,
	extraFieldsRaw: any
)
	local fields = {
		("event=%s"):format(eventName),
		("player=%s"):format(player.Name),
		("userId=%d"):format(player.UserId),
	}
	if runtime ~= nil then
		fields[#fields + 1] = ("loadState=%s"):format(runtime.loadState)
		fields[#fields + 1] = ("isLoading=%s"):format(tostring(runtime.isLoading))
		fields[#fields + 1] = ("isLoaded=%s"):format(tostring(runtime.isLoaded))
		fields[#fields + 1] = ("isDirty=%s"):format(tostring(runtime.isDirty))
		fields[#fields + 1] = ("isSaving=%s"):format(tostring(runtime.isSaving))
		fields[#fields + 1] = ("saveQueued=%s"):format(tostring(runtime.saveQueued))
		fields[#fields + 1] = ("revision=%d"):format(runtime.revision)
		fields[#fields + 1] = ("lastSavedRevision=%d"):format(runtime.lastSavedRevision)
		fields[#fields + 1] = ("lastStagedRevision=%d"):format(runtime.lastStagedRevision)
		fields[#fields + 1] = ("selectedSlot=%s"):format(stringifyLogValue(runtime.selectedSlot))
		fields[#fields + 1] = ("joinToken=%d"):format(runtime.joinToken)
		fields[#fields + 1] = ("loadToken=%d"):format(runtime.loadToken)
		fields[#fields + 1] = ("hasResolvedInitialLoad=%s"):format(tostring(runtime.hasResolvedInitialLoad))
		fields[#fields + 1] = ("elapsed=%.3f"):format(getRuntimeLoadElapsedSeconds(runtime))
		if runtime.lastFailureReason ~= nil then
			fields[#fields + 1] = ("lastFailureReason=%s"):format(runtime.lastFailureReason)
		end
	end
	if typeof(extraFieldsRaw) == "table" then
		for key, value in extraFieldsRaw :: { [string]: any } do
			fields[#fields + 1] = ("%s=%s"):format(tostring(key), stringifyLogValue(value))
		end
	end
end

function InventoryServiceServer.GetInventoryDataPath(self: InventoryServiceServer): { string }
	local persistence = self.persistence
	if persistence ~= nil then
		return persistence:getDataPath()
	end
	return InventoryServiceUtils.getDefaultDataPath()
end

function InventoryServiceServer.GetInventoryDataPathString(self: InventoryServiceServer): string
	local persistence = self.persistence
	if persistence ~= nil then
		return persistence:getDataPathString()
	end
	return table.concat(InventoryServiceUtils.getDefaultDataPath(), ".")
end

function InventoryServiceServer.MarkRuntimeDirty(
	self: InventoryServiceServer,
	player: Player,
	runtime: PlayerRuntime,
	reasonRaw: any
)
	runtime.revision += 1
	runtime.isDirty = true
	self:logEvent("inventory_mutation_applied", player, runtime, {
		trigger = reasonRaw,
		path = self:getInventoryDataPathString(),
		occupiedSlots = runtime.state.occupiedSlotCount,
		totalItems = runtime.state.totalItemCount,
		updatedAt = runtime.state.updatedAt,
	})
	self:logEvent("runtime_marked_dirty", player, runtime, {
		trigger = reasonRaw,
		path = self:getInventoryDataPathString(),
	})
end

function InventoryServiceServer.StagePersistedState(
	self: InventoryServiceServer,
	player: Player,
	runtime: PlayerRuntime,
	reasonRaw: any
): boolean
	if not runtime.isLoaded then
		return false
	end

	local stageSuccess, didStage, stageReason = pcall(function()
		return self.persistence:writeState(player, runtime.state)
	end)
	if stageSuccess and didStage == true then
		runtime.lastStagedRevision = runtime.revision
		return true
	end

	self:logEvent("profile_writeback_failed", player, runtime, {
		trigger = reasonRaw,
		path = self:getInventoryDataPathString(),
		reason = if stageSuccess then stageReason else tostring(didStage),
	})
	return false
end

function InventoryServiceServer.CreateRuntime(self: InventoryServiceServer, player: Player): PlayerRuntime
	local state = InventoryServiceUtils.createDefaultState(InventoryServiceUtils.LOAD_STATE_LOADING)
	local runtime: PlayerRuntime = {
		userId = player.UserId,
		player = player,
		state = state,
		isLoading = true,
		isLoaded = false,
		isDirty = false,
		isSaving = false,
		saveQueued = false,
		loadState = state.loadState,
		lastReplicatedStateHash = nil,
		selectedSlot = state.selectedSlot,
		toolSyncJanitor = Janitor.new(),
		playerJanitor = Janitor.new(),
		characterJanitor = Janitor.new(),
		pendingToolImports = {},
		suppressedToolImports = {},
		resolvedSource = "loading",
		joinToken = 0,
		loadToken = 0,
		hasResolvedInitialLoad = false,
		lastFailureReason = nil,
		loadStartedAt = 0,
		saveDebounceToken = 0,
		lastSavedRevision = 0,
		lastStagedRevision = 0,
		revision = 0,
	}
	self:logEvent("runtime_created", player, runtime, nil)
	return runtime
end

function InventoryServiceServer.GetRuntime(self: InventoryServiceServer, player: Player): PlayerRuntime?
	return self.playerRuntimesByUserId[player.UserId]
end

function InventoryServiceServer.GetOrCreateRuntime(self: InventoryServiceServer, player: Player): PlayerRuntime
	local runtime = self.playerRuntimesByUserId[player.UserId]
	if runtime ~= nil then
		runtime.player = player
		return runtime
	end
	runtime = self:createRuntime(player)
	self.playerRuntimesByUserId[player.UserId] = runtime
	return runtime
end

function InventoryServiceServer.GetLoadedRuntime(self: InventoryServiceServer, player: Player): PlayerRuntime?
	local runtime = self.playerRuntimesByUserId[player.UserId]
	if runtime == nil or not runtime.isLoaded then
		return nil
	end
	return runtime
end

function InventoryServiceServer.ReplicateRuntimeState(
	self: InventoryServiceServer,
	player: Player,
	runtime: PlayerRuntime,
	reasonRaw: any,
	forceRaw: any?
): boolean
	applyRuntimeState(runtime, runtime.state)
	local stateHash = InventoryServiceUtils.hashState(runtime.state)
	if forceRaw ~= true and runtime.lastReplicatedStateHash == stateHash then
		return false
	end
	runtime.lastReplicatedStateHash = stateHash
	if self.networker ~= nil then
		self.networker:fire(player, "applyState", InventoryServiceUtils.cloneState(runtime.state))
	end
	self:logEvent("state_replicated", player, runtime, {
		reason = reasonRaw,
		hash = stateHash,
		occupiedSlots = runtime.state.occupiedSlotCount,
		totalItems = runtime.state.totalItemCount,
	})
	return true
end

function InventoryServiceServer.ScheduleSaveAttempt(
	self: InventoryServiceServer,
	userId: number,
	token: number,
	reasonRaw: any,
	delaySeconds: number
)
	task.delay(delaySeconds, function()
		local runtime = self.playerRuntimesByUserId[userId]
		if runtime == nil or runtime.saveDebounceToken ~= token or not runtime.isDirty then
			return
		end
		local player = runtime.player
		if player == nil then
			return
		end
		self:performSave(player, runtime, token, reasonRaw)
	end)
end

function InventoryServiceServer.RunQueuedSaveRerun(
	self: InventoryServiceServer,
	player: Player,
	runtime: PlayerRuntime,
	reasonRaw: any
)
	task.spawn(function()
		local currentRuntime = self.playerRuntimesByUserId[player.UserId]
		if currentRuntime == nil or currentRuntime ~= runtime or not runtime.isDirty then
			return
		end
		self:performSave(player, runtime, runtime.saveDebounceToken, reasonRaw)
	end)
end

function InventoryServiceServer.CanPersistRuntime(self: InventoryServiceServer, player: Player): (boolean, string)
	local playerDataService = self.playerDataService
	if playerDataService == nil then
		return false, "player_data_service_missing"
	end

	local loadStateSuccess, loadState = pcall(function()
		return playerDataService:getLoadState(player)
	end)
	if not loadStateSuccess then
		return false, "player_data_load_state_error:" .. tostring(loadState)
	end
	if loadState ~= PlayerDataServiceUtils.LOAD_STATE_LOADED then
		return false, "player_data_not_active:" .. tostring(loadState)
	end

	local profileSuccess, hasProfile = pcall(function()
		return self.persistence:hasAuthoritativeProfile(player)
	end)
	if not profileSuccess then
		return false, "profile_check_error:" .. tostring(hasProfile)
	end
	if hasProfile ~= true then
		return false, "profile_unavailable"
	end

	return true, "ready"
end

function InventoryServiceServer.PerformSave(
	self: InventoryServiceServer,
	player: Player,
	runtime: PlayerRuntime,
	token: number,
	reasonRaw: any
): boolean
	if self.playerRuntimesByUserId[player.UserId] ~= runtime then
		return false
	end
	if not runtime.isLoaded then
		self:logEvent("save_skipped_not_loaded", player, runtime, {
			trigger = reasonRaw,
			token = token,
			path = self:getInventoryDataPathString(),
		})
		return false
	end
	if not runtime.isDirty then
		return false
	end
	if runtime.isSaving then
		runtime.saveQueued = true
		self:logEvent("save_queued_rerun", player, runtime, {
			trigger = reasonRaw,
			token = token,
			path = self:getInventoryDataPathString(),
			reason = "save_in_progress",
		})
		return false
	end

	local snapshotRevision = runtime.revision
	local snapshotState = InventoryServiceUtils.cloneState(runtime.state)
	local dataPath = self:getInventoryDataPathString()
	local canPersist, persistReason = self:canPersistRuntime(player)
	if not canPersist then
		self:logEvent("save_failed", player, runtime, {
			reason = persistReason,
			trigger = reasonRaw,
			token = token,
			snapshotRevision = snapshotRevision,
			path = dataPath,
		})
		self:scheduleSaveAttempt(
			runtime.userId,
			runtime.saveDebounceToken,
			"retry_" .. tostring(reasonRaw),
			SAVE_RETRY_SECONDS
		)
		return false
	end

	runtime.isSaving = true
	runtime.saveQueued = false
	self:logEvent("save_begin", player, runtime, {
		trigger = reasonRaw,
		token = token,
		snapshotRevision = snapshotRevision,
		path = dataPath,
	})

	local saveUsesStagedProfileData = runtime.lastStagedRevision >= snapshotRevision
	local okSave, didSave, saveReason = pcall(function()
		if saveUsesStagedProfileData then
			return self.persistence:saveProfile(player)
		end
		return self.persistence:saveState(player, snapshotState)
	end)

	runtime.isSaving = false

	if okSave and didSave == true then
		runtime.lastSavedRevision = math.max(runtime.lastSavedRevision, snapshotRevision)
		local newerRevisionExists = runtime.revision > snapshotRevision
		if not newerRevisionExists and not runtime.saveQueued then
			runtime.isDirty = false
		end
		self:logEvent("save_success", player, runtime, {
			trigger = reasonRaw,
			token = token,
			snapshotRevision = snapshotRevision,
			saveReason = saveReason,
			usedStagedProfileData = saveUsesStagedProfileData,
			path = dataPath,
			dirtyCleared = not runtime.isDirty,
		})
		if runtime.saveQueued or newerRevisionExists then
			runtime.saveQueued = false
			self:logEvent("save_queued_rerun", player, runtime, {
				trigger = reasonRaw,
				token = token,
				path = dataPath,
				reason = "newer_revision_waiting",
			})
			self:runQueuedSaveRerun(player, runtime, "queued_rerun")
		end
		return true
	end

	local failureReason = if okSave then tostring(saveReason) else tostring(didSave)
	self:logEvent("save_failed", player, runtime, {
		reason = failureReason,
		trigger = reasonRaw,
		token = token,
		snapshotRevision = snapshotRevision,
		usedStagedProfileData = saveUsesStagedProfileData,
		path = dataPath,
	})
	if runtime.saveQueued or runtime.revision > snapshotRevision then
		runtime.saveQueued = false
		self:logEvent("save_queued_rerun", player, runtime, {
			trigger = reasonRaw,
			token = token,
			path = dataPath,
			reason = "newer_revision_after_failure",
		})
		self:runQueuedSaveRerun(player, runtime, "queued_rerun_after_failure")
		return false
	end
	self:scheduleSaveAttempt(
		runtime.userId,
		runtime.saveDebounceToken,
		"retry_" .. tostring(reasonRaw),
		SAVE_RETRY_SECONDS
	)
	return false
end

function InventoryServiceServer.QueueSave(
	self: InventoryServiceServer,
	player: Player,
	runtime: PlayerRuntime,
	reasonRaw: any
)
	if not runtime.isLoaded then
		self:logEvent("save_skipped_not_loaded", player, runtime, {
			trigger = reasonRaw,
			path = self:getInventoryDataPathString(),
		})
		return
	end
	runtime.saveDebounceToken += 1
	local token = runtime.saveDebounceToken
	if runtime.isSaving then
		runtime.saveQueued = true
		self:logEvent("save_queued_rerun", player, runtime, {
			trigger = reasonRaw,
			token = token,
			path = self:getInventoryDataPathString(),
			reason = "save_in_progress",
		})
		return
	end
	self:logEvent("save_scheduled", player, runtime, {
		trigger = reasonRaw,
		token = token,
		path = self:getInventoryDataPathString(),
	})
	self:scheduleSaveAttempt(runtime.userId, token, reasonRaw, SAVE_DEBOUNCE_SECONDS)
end

function InventoryServiceServer.CommitState(
	self: InventoryServiceServer,
	player: Player,
	runtime: PlayerRuntime,
	nextStateRaw: any,
	reasonRaw: any,
	beforeCommitRaw: any?
)
	applyRuntimeState(runtime, nextStateRaw)
	if typeof(beforeCommitRaw) == "function" then
		local ok, err = pcall(beforeCommitRaw)
		if not ok then
			self:logEvent("before_commit_fail", player, runtime, { reason = tostring(err), trigger = reasonRaw })
		end
	end
	self:markRuntimeDirty(player, runtime, reasonRaw)
	self:stagePersistedState(player, runtime, reasonRaw)
	self:queueSave(player, runtime, reasonRaw)
	local syncOk, syncErr = pcall(function()
		self:syncSelectedTool(player, runtime, reasonRaw)
	end)
	if not syncOk then
		self:logEvent("tool_sync_fail", player, runtime, { trigger = reasonRaw, reason = tostring(syncErr) })
	end
	self:replicateRuntimeState(player, runtime, reasonRaw, true)
end

function InventoryServiceServer.FindMatchingTool(_self: InventoryServiceServer, player: Player, stackRaw: any): Tool?
	if typeof(stackRaw) ~= "table" then
		return nil
	end
	local stack = stackRaw :: { [string]: any }
	local itemId = sanitizeItemId(stack.itemId)
	if itemId == nil then
		return nil
	end
	local desiredStackId = sanitizeItemId(stack.stackId)
	local fallback = nil :: Tool?
	for _, container in { player.Character, player:FindFirstChildOfClass("Backpack") } do
		if typeof(container) ~= "Instance" then
			continue
		end
		for _, child in container:GetChildren() do
			if not child:IsA("Tool") then
				continue
			end
			local toolItemId = select(1, resolveToolImportData(child))
			if toolItemId ~= itemId then
				continue
			end
			if desiredStackId ~= nil and child:GetAttribute(STACK_ID_ATTRIBUTE_NAME) == desiredStackId then
				return child
			end
			fallback = fallback or child
		end
	end
	return fallback
end

function InventoryServiceServer.SyncSelectedTool(
	self: InventoryServiceServer,
	player: Player,
	runtime: PlayerRuntime,
	reasonRaw: any?
)
	runtime.toolSyncJanitor:Clean()
	if not runtime.isLoaded then
		destroyManagedToolsExcept(player, nil)
		return
	end
	local character = player.Character
	local humanoid = if character ~= nil then character:FindFirstChildOfClass("Humanoid") else nil
	local backpack = player:FindFirstChildOfClass("Backpack")
	local selectedSlot = runtime.selectedSlot
	local selectedStack = if selectedSlot ~= nil
		then InventoryServiceUtils.getStack(runtime.state, selectedSlot)
		else nil
	local selectedItemId = if selectedStack ~= nil then sanitizeItemId(selectedStack.itemId) else nil
	if selectedItemId == nil then
		destroyManagedToolsExcept(player, nil)
		if humanoid ~= nil then
			pcall(function()
				humanoid:UnequipTools()
			end)
		end
		self:logEvent("tool_sync_applied", player, runtime, { trigger = reasonRaw, outcome = "cleared" })
		return
	end
	local desiredTool = self:findMatchingTool(player, selectedStack)
	if desiredTool == nil and selectedStack ~= nil then
		desiredTool = cloneToolForInventoryStack(selectedItemId, selectedStack, selectedSlot)
		if desiredTool ~= nil then
			local targetParent = if backpack ~= nil then backpack else character
			if targetParent ~= nil then
				desiredTool.Parent = targetParent
			else
				desiredTool:Destroy()
				desiredTool = nil
			end
		end
	end
	if desiredTool == nil then
		destroyManagedToolsExcept(player, nil)
		self:logEvent(
			"tool_sync_applied",
			player,
			runtime,
			{ trigger = reasonRaw, outcome = "missing_template", itemId = selectedItemId }
		)
		return
	end
	configureManagedToolForInventoryStack(desiredTool, selectedItemId, selectedStack, selectedSlot)
	destroyManagedToolsExcept(player, desiredTool)
	local deployableConfig = resolveDeployableConfig(selectedItemId)
	if deployableConfig ~= nil then
		local placementProfile = sanitizeItemId((deployableConfig :: { [string]: any }).placementProfile)
		if placementProfile ~= "Torch" then
			runtime.toolSyncJanitor:GiveChore(desiredTool.Activated:Connect(function()
				self:tryPlaceDeployableFromTool(player, runtime, desiredTool)
			end))
		end
	end
	runtime.toolSyncJanitor:GiveChore(desiredTool.Destroying:Connect(function()
		task.defer(function()
			local currentRuntime = self:getRuntime(player)
			if currentRuntime ~= nil and currentRuntime == runtime then
				self:syncSelectedTool(player, runtime, "tool_destroyed")
			end
		end)
	end))
	if humanoid ~= nil and desiredTool.Parent ~= character then
		pcall(function()
			humanoid:EquipTool(desiredTool)
		end)
	end
	self:logEvent("tool_sync_applied", player, runtime, {
		trigger = reasonRaw,
		outcome = "equipped",
		itemId = selectedItemId,
		stackId = if selectedStack ~= nil then selectedStack.stackId else nil,
	})
end

function InventoryServiceServer.SuppressAndPurgePlayerTools(
	_self: InventoryServiceServer,
	runtime: PlayerRuntime,
	player: Player,
	itemIdRaw: any,
	amountRaw: any
)
	local itemId = sanitizeItemId(itemIdRaw)
	if itemId == nil or typeof(amountRaw) ~= "number" or amountRaw ~= amountRaw then
		return
	end
	local remaining = math.max(0, math.floor(amountRaw))
	if remaining <= 0 then
		return
	end
	local afterCharacter = remaining - destroyMatchingToolsInContainer(player.Character, itemId, remaining)
	local afterBackpack = afterCharacter
		- destroyMatchingToolsInContainer(player:FindFirstChildOfClass("Backpack"), itemId, afterCharacter)
	if afterBackpack > 0 then
		queueSuppressedToolImport(runtime, itemId, afterBackpack)
	end
end

function InventoryServiceServer.FlushPendingToolImports(_self: InventoryServiceServer, runtime: PlayerRuntime): boolean
	if not runtime.isLoaded then
		for key in runtime.pendingToolImports do
			runtime.pendingToolImports[key] = nil
		end
		return false
	end
	local changed = false
	for key, pending in runtime.pendingToolImports do
		if InventoryServiceUtils.countItem(runtime.state, pending.itemId, nil, false) <= 0 then
			local addResult = InventoryServiceUtils.addItem(runtime.state, pending.itemId, pending.amount, 1, {
				[TOOL_IMPORT_METADATA_TYPE_KEY] = pending.itemType,
			}, TOOL_IMPORT_STACK_ID_PREFIX)
			changed = changed or addResult.changed
		end
		runtime.pendingToolImports[key] = nil
	end
	return changed
end

function InventoryServiceServer.OnObservedTool(
	self: InventoryServiceServer,
	player: Player,
	runtime: PlayerRuntime,
	tool: Tool
)
	ToolBinder.applyTags(tool)
	if isManagedInventoryTool(tool) then
		return
	end
	local itemId, itemType = resolveToolImportData(tool)
	if itemId == nil or itemType == nil then
		return
	end
	if consumeSuppressedToolImport(runtime, itemId, 1) then
		tool:Destroy()
		return
	end
	if runtime.isLoading or not runtime.hasResolvedInitialLoad then
		queuePendingToolImport(runtime, itemId, itemType, 1)
		tool:Destroy()
		return
	end
	if not runtime.isLoaded then
		tool:Destroy()
		return
	end
	if InventoryServiceUtils.countItem(runtime.state, itemId, nil, false) <= 0 then
		local addResult = self:addItem(player, itemId, 1, {
			maxStack = 1,
			metadata = { [TOOL_IMPORT_METADATA_TYPE_KEY] = itemType },
			stackIdPrefix = TOOL_IMPORT_STACK_ID_PREFIX,
		})
		if addResult.added <= 0 then
			tool:Destroy()
		end
		return
	end
	self:syncSelectedTool(player, runtime, "observed_tool")
end

function InventoryServiceServer.ObserveToolContainer(
	self: InventoryServiceServer,
	player: Player,
	runtime: PlayerRuntime,
	janitor: JanitorClass,
	container: Instance
)
	for _, child in container:GetChildren() do
		if child:IsA("Tool") then
			self:onObservedTool(player, runtime, child)
		end
	end
	janitor:GiveChore(container.ChildAdded:Connect(function(child: Instance)
		if child:IsA("Tool") then
			self:onObservedTool(player, runtime, child)
		end
	end))
end

function InventoryServiceServer.BindCharacter(
	self: InventoryServiceServer,
	player: Player,
	runtime: PlayerRuntime,
	character: Model
)
	runtime.characterJanitor:Clean()
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid ~= nil then
		humanoid:UnequipTools()
	end
	self:observeToolContainer(player, runtime, runtime.characterJanitor, character)
	runtime.characterJanitor:GiveChore(character.ChildAdded:Connect(function(child: Instance)
		if child:IsA("Humanoid") then
			child:UnequipTools()
			self:syncSelectedTool(player, runtime, "humanoid_added")
		end
	end))
	self:syncSelectedTool(player, runtime, "character_bound")
end

function InventoryServiceServer.BindBackpack(
	self: InventoryServiceServer,
	player: Player,
	runtime: PlayerRuntime,
	backpack: Backpack
)
	self:observeToolContainer(player, runtime, runtime.playerJanitor, backpack)
	self:syncSelectedTool(player, runtime, "backpack_bound")
end

function InventoryServiceServer.TryPlaceDeployableFromTool(
	self: InventoryServiceServer,
	player: Player,
	runtime: PlayerRuntime,
	tool: Tool,
	requestedTileXRaw: any?,
	requestedTileYRaw: any?
): boolean
	local itemId = select(1, resolveToolImportData(tool))
	if itemId == nil then
		return false
	end
	return self:tryPlaceSelectedDeployable(player, runtime, itemId, requestedTileXRaw, requestedTileYRaw)
end

function InventoryServiceServer.TryPlaceSelectedDeployable(
	self: InventoryServiceServer,
	player: Player,
	runtime: PlayerRuntime,
	itemIdRaw: any,
	requestedTileXRaw: any?,
	requestedTileYRaw: any?
): boolean
	local itemId = sanitizeItemId(itemIdRaw)
	if itemId == nil then
		return false
	end
	local deployableConfig = resolveDeployableConfig(itemId)
	if deployableConfig == nil then
		return false
	end
	local selectedSlot = runtime.selectedSlot
	local selectedStack = if selectedSlot ~= nil
		then InventoryServiceUtils.getStack(runtime.state, selectedSlot)
		else nil
	if selectedSlot == nil or selectedStack == nil or sanitizeItemId(selectedStack.itemId) ~= itemId then
		return false
	end
	local primaryTemplate = ResolveItem.resolvePrimaryTemplate(itemId)
	if primaryTemplate == nil or primaryTemplate:IsA("Tool") then
		return false
	end
	local placedInstance = primaryTemplate:Clone()
	local primaryPart = resolveDeployablePrimaryPart(placedInstance)
	if primaryPart == nil then
		placedInstance:Destroy()
		return false
	end
	local placementProfile = sanitizeItemId((deployableConfig :: { [string]: any }).placementProfile)
	local placementCFrame = nil :: CFrame?
	local placedTileX = nil :: number?
	local placedTileY = nil :: number?
	local placedSupportKind = nil :: string?
	if placementProfile == "Torch" then
		local torchPlacement = resolveTorchDeployablePlacement(
			player,
			deployableConfig,
			placedInstance,
			requestedTileXRaw,
			requestedTileYRaw
		)
		if torchPlacement ~= nil then
			placementCFrame = torchPlacement.cframe
			placedTileX = torchPlacement.tileX
			placedTileY = torchPlacement.tileY
			placedSupportKind = torchPlacement.supportKind
		end
	else
		placementCFrame = resolveDeployablePlacementCFrame(player, deployableConfig, placedInstance)
	end
	if placementCFrame == nil then
		placedInstance:Destroy()
		return false
	end
	local removeResult = self:removeFromSlot(player, selectedSlot, 1)
	if removeResult.removedAmount <= 0 then
		placedInstance:Destroy()
		return false
	end
	setModelAnchored(placedInstance, true)
	if placedInstance:IsA("Model") then
		placedInstance:PivotTo(placementCFrame)
	else
		(placedInstance :: BasePart).CFrame = placementCFrame
	end
	local stationTag = sanitizeItemId((deployableConfig :: { [string]: any }).stationTag)
	if stationTag ~= nil then
		TagBinder.applyTag(placedInstance, stationTag, CollectionService)
	end
	if itemId == "Torch" then
		TagBinder.applyTag(placedInstance, TagBinder.Tags.Placeable_Torch, CollectionService)
	elseif itemId == "Workbench" then
		TagBinder.applyTag(placedInstance, TagBinder.Tags.Placeable_Workbench, CollectionService)
	else
		TagBinder.applyTag(placedInstance, TagBinder.Tags.Placeable, CollectionService)
	end
	placedInstance:SetAttribute(DEPLOYABLE_PLACED_ATTRIBUTE_NAME, itemId)
	if placedTileX ~= nil and placedTileY ~= nil then
		placedInstance:SetAttribute(DEPLOYABLE_TILE_X_ATTRIBUTE_NAME, placedTileX)
		placedInstance:SetAttribute(DEPLOYABLE_TILE_Y_ATTRIBUTE_NAME, placedTileY)
	end
	if placedSupportKind ~= nil then
		placedInstance:SetAttribute(DEPLOYABLE_SUPPORT_KIND_ATTRIBUTE_NAME, placedSupportKind)
	end
	placedInstance.Parent = Workspace
	return true
end

function InventoryServiceServer.Init(self: InventoryServiceServer)
	self.networker = Networker.server.new("InventoryService", self, {
		self.RequestSync,
		self.RequestSetSelectedSlot,
		self.RequestMoveSlot,
		self.RequestSplitSlot,
		self.RequestDropFromSlot,
		self.RequestTrashSlot,
		self.RequestTrashSelectedSlot,
		self.RequestUseSelectedSlot,
		self.RequestPlaceSelectedDeployable,
	})
	self.playerDataService = PlayerDataServiceServer :: PlayerDataServiceServerObject
	self.persistence = InventoryProfile.new(self.playerDataService, {
		dataPath = InventoryServiceUtils.getDefaultDataPath(),
		primaryTimeoutSeconds = PRIMARY_PERSISTENCE_TIMEOUT_SECONDS,
		fallbackTimeoutSeconds = FALLBACK_PERSISTENCE_TIMEOUT_SECONDS,
	}) :: InventoryProfileObject
	self.playerRuntimesByUserId = {}
	self.didWarnMissingDropHandler = false
	self.dropFromSlotHandler = nil

	for _, player in Players:GetPlayers() do
		self:trackPlayer(player)
	end
	self.playerAddedConnection = Players.PlayerAdded:Connect(function(player: Player)
		self:trackPlayer(player)
	end)
	self.playerRemovingConnection = Players.PlayerRemoving:Connect(function(player: Player)
		self:untrackPlayer(player)
	end)
end

function InventoryServiceServer.ReadInventoryDataFromPlayerData(
	self: InventoryServiceServer,
	player: Player
): (any, string)
	local defaultInventoryData = self.persistence:cloneDefaultInventoryData()
	local playerDataService = self.playerDataService
	if playerDataService == nil then
		return defaultInventoryData, "player_data_service_missing"
	end

	local readSuccess, readResult = pcall(function()
		return playerDataService:getValue(player, self:getInventoryDataPath(), defaultInventoryData)
	end)
	if not readSuccess then
		return defaultInventoryData, "player_data_read_error:" .. tostring(readResult)
	end
	if typeof(readResult) ~= "table" then
		return defaultInventoryData, "player_data_inventory_not_table"
	end
	return readResult, "player_data_value"
end

function InventoryServiceServer.FinalizeInitialLoad(
	self: InventoryServiceServer,
	player: Player,
	runtime: PlayerRuntime,
	loadToken: number,
	nextStateRaw: any,
	resolvedSourceRaw: any,
	failureReasonRaw: any?
): boolean
	if runtime.loadToken ~= loadToken or self.playerRuntimesByUserId[player.UserId] ~= runtime then
		return false
	end

	applyRuntimeState(runtime, nextStateRaw)
	runtime.isLoading = false
	runtime.hasResolvedInitialLoad = true
	runtime.lastFailureReason = sanitizeFailureReason(failureReasonRaw)
	runtime.resolvedSource = if typeof(resolvedSourceRaw) == "string" then resolvedSourceRaw else runtime.resolvedSource
	local importedPending = self:flushPendingToolImports(runtime)
	if importedPending and runtime.isLoaded then
		self:markRuntimeDirty(player, runtime, "pending_tool_imports")
		self:stagePersistedState(player, runtime, "pending_tool_imports")
	end
	local syncOk, syncErr = pcall(function()
		self:syncSelectedTool(player, runtime, "initial_load")
	end)
	if not syncOk then
		self:logEvent("tool_sync_fail", player, runtime, { trigger = "initial_load", reason = tostring(syncErr) })
	end
	self:replicateRuntimeState(player, runtime, "initial_load", true)
	if importedPending and runtime.isLoaded then
		self:queueSave(player, runtime, "pending_tool_imports")
	end
	return true
end

function InventoryServiceServer.LoadPlayerInventory(
	self: InventoryServiceServer,
	player: Player,
	runtime: PlayerRuntime,
	loadToken: number
)
	local playerDataService = self.playerDataService
	if playerDataService == nil then
		local failedState = InventoryServiceUtils.createStateFromData(
			self.persistence:cloneDefaultInventoryData(),
			runtime.state,
			InventoryServiceUtils.LOAD_STATE_FAILED
		)
		if
			self:finalizeInitialLoad(player, runtime, loadToken, failedState, "default", "player_data_service_missing")
		then
			self:logEvent("load_resolved_default_failure", player, runtime, {
				reason = "player_data_service_missing",
			})
		end
		return
	end

	local function resolveLoadedState(resolveReasonRaw: any, playerDataLoadStateRaw: any)
		local inventoryData, inventoryReason = self:readInventoryDataFromPlayerData(player)
		local nextState = InventoryServiceUtils.createStateFromData(
			inventoryData,
			runtime.state,
			InventoryServiceUtils.LOAD_STATE_LOADED
		)
		if self:finalizeInitialLoad(player, runtime, loadToken, nextState, "player_data", nil) then
			self:logEvent("load_resolved_from_player_data", player, runtime, {
				playerDataLoadState = playerDataLoadStateRaw,
				reason = resolveReasonRaw,
				readReason = inventoryReason,
			})
		end
	end

	local loadStateSuccess, loadStateResult = pcall(function()
		return playerDataService:getLoadState(player)
	end)
	local playerDataLoadState = if loadStateSuccess
		then loadStateResult
		else "load_state_error:" .. tostring(loadStateResult)
	if loadStateSuccess and loadStateResult == PlayerDataServiceUtils.LOAD_STATE_LOADED then
		resolveLoadedState("player_data_already_loaded", loadStateResult)
		return
	end
	if loadStateSuccess and loadStateResult == PlayerDataServiceUtils.LOAD_STATE_FAILED then
		local failedState = InventoryServiceUtils.createStateFromData(
			self.persistence:cloneDefaultInventoryData(),
			runtime.state,
			InventoryServiceUtils.LOAD_STATE_FAILED
		)
		if self:finalizeInitialLoad(player, runtime, loadToken, failedState, "default", "player_data_failed") then
			self:logEvent("load_resolved_default_failure", player, runtime, {
				reason = "player_data_failed",
				playerDataLoadState = loadStateResult,
			})
		end
		return
	end

	pcall(function()
		playerDataService:requestSync(player)
	end)
	self:logEvent("load_waiting_for_player_data", player, runtime, {
		playerDataLoadState = playerDataLoadState,
		timeoutSeconds = PLAYER_DATA_SETTLE_TIMEOUT_SECONDS,
	})
	local waitSuccess, waitResult = pcall(function()
		return playerDataService:waitForData(player, PLAYER_DATA_SETTLE_TIMEOUT_SECONDS)
	end)
	if runtime.loadToken ~= loadToken or self.playerRuntimesByUserId[player.UserId] ~= runtime then
		return
	end

	loadStateSuccess, loadStateResult = pcall(function()
		return playerDataService:getLoadState(player)
	end)
	playerDataLoadState = if loadStateSuccess then loadStateResult else "load_state_error:" .. tostring(loadStateResult)
	if loadStateSuccess and loadStateResult == PlayerDataServiceUtils.LOAD_STATE_LOADED then
		resolveLoadedState(
			if waitSuccess then "player_data_wait_resolved" else "player_data_wait_error_resolved",
			loadStateResult
		)
		return
	end

	local failureReason = if waitSuccess
		then "player_data_timeout:" .. tostring(playerDataLoadState)
		else "player_data_wait_error:" .. tostring(waitResult)
	if loadStateSuccess and loadStateResult == PlayerDataServiceUtils.LOAD_STATE_FAILED then
		failureReason = "player_data_failed"
	end
	local failedState = InventoryServiceUtils.createStateFromData(
		self.persistence:cloneDefaultInventoryData(),
		runtime.state,
		InventoryServiceUtils.LOAD_STATE_FAILED
	)
	if self:finalizeInitialLoad(player, runtime, loadToken, failedState, "default", failureReason) then
		self:logEvent("load_resolved_default_failure", player, runtime, {
			reason = failureReason,
			playerDataLoadState = playerDataLoadState,
		})
		if not waitSuccess then
			self:logEvent("load_wait_error", player, runtime, { reason = tostring(waitResult) })
		end
	end
end

function InventoryServiceServer.TrackPlayer(self: InventoryServiceServer, player: Player)
	local runtime = self:getRuntime(player)
	if runtime ~= nil then
		runtime.player = player
		self:logEvent("trackPlayer_start", player, runtime, { reusedRuntime = true })
		self:replicateRuntimeState(player, runtime, "track_player_reused", true)
		return
	end

	runtime = self:createRuntime(player)
	self.playerRuntimesByUserId[player.UserId] = runtime
	runtime.joinToken += 1
	runtime.loadToken += 1
	runtime.isLoading = true
	runtime.hasResolvedInitialLoad = false
	runtime.isLoaded = false
	runtime.isDirty = false
	runtime.isSaving = false
	runtime.saveQueued = false
	runtime.resolvedSource = "loading"
	runtime.lastFailureReason = nil
	runtime.loadStartedAt = os.clock()
	runtime.lastReplicatedStateHash = nil
	runtime.saveDebounceToken += 1
	runtime.lastSavedRevision = 0
	runtime.lastStagedRevision = 0
	runtime.revision = 0
	runtime.pendingToolImports = {}
	runtime.suppressedToolImports = {}
	runtime.playerJanitor:Clean()
	runtime.characterJanitor:Clean()
	runtime.toolSyncJanitor:Clean()
	applyRuntimeState(
		runtime,
		InventoryServiceUtils.createStateFromData(
			self.persistence:cloneDefaultInventoryData(),
			runtime.state,
			InventoryServiceUtils.LOAD_STATE_LOADING
		)
	)
	self:logEvent("trackPlayer_start", player, runtime, nil)
	self:replicateRuntimeState(player, runtime, "track_player", true)
	runtime.playerJanitor:GiveChore(player.CharacterAdded:Connect(function(character: Model)
		self:bindCharacter(player, runtime, character)
	end))
	runtime.playerJanitor:GiveChore(player.ChildAdded:Connect(function(child: Instance)
		if child:IsA("Backpack") then
			self:bindBackpack(player, runtime, child)
		end
	end))
	if player.Character ~= nil then
		self:bindCharacter(player, runtime, player.Character)
	end
	local backpack = player:FindFirstChildOfClass("Backpack")
	if backpack ~= nil then
		self:bindBackpack(player, runtime, backpack)
	end
	local loadToken = runtime.loadToken
	task.spawn(function()
		self:loadPlayerInventory(player, runtime, loadToken)
	end)
end

function InventoryServiceServer.UntrackPlayer(self: InventoryServiceServer, player: Player)
	local runtime = self.playerRuntimesByUserId[player.UserId]
	if runtime == nil then
		return
	end
	runtime.player = player
	if runtime.isDirty then
		self:stagePersistedState(player, runtime, "player_removing")
	end
	self:performSave(player, runtime, runtime.saveDebounceToken, "player_removing")
	runtime.playerJanitor:Destroy()
	runtime.characterJanitor:Destroy()
	runtime.toolSyncJanitor:Destroy()
	self.playerRuntimesByUserId[player.UserId] = nil
end

function InventoryServiceServer.RequestSync(self: InventoryServiceServer, player: Player)
	local runtime = self:getRuntime(player)
	if runtime == nil then
		self:trackPlayer(player)
		return
	end
	runtime.player = player
	self:logEvent("requestSync_reused_runtime", player, runtime, { runtimeExists = true })
	self:replicateRuntimeState(player, runtime, "request_sync", true)
end
function InventoryServiceServer.RequestSetSelectedSlot(self: InventoryServiceServer, player: Player, slotIndexRaw: any)
	self:setSelectedSlot(player, slotIndexRaw)
end
function InventoryServiceServer.RequestMoveSlot(
	self: InventoryServiceServer,
	player: Player,
	fromSlotRaw: any,
	toSlotRaw: any,
	amountRaw: any
)
	self:moveSlot(player, fromSlotRaw, toSlotRaw, amountRaw)
end
function InventoryServiceServer.RequestSplitSlot(
	self: InventoryServiceServer,
	player: Player,
	fromSlotRaw: any,
	toSlotRaw: any,
	amountRaw: any
)
	self:splitSlot(player, fromSlotRaw, toSlotRaw, amountRaw)
end
function InventoryServiceServer.RequestDropFromSlot(
	self: InventoryServiceServer,
	player: Player,
	slotIndexRaw: any,
	amountRaw: any,
	throwDirectionRaw: any
)
	self:dropFromSlot(player, slotIndexRaw, amountRaw, throwDirectionRaw)
end
function InventoryServiceServer.RequestTrashSlot(
	self: InventoryServiceServer,
	player: Player,
	slotIndexRaw: any,
	amountRaw: any
)
	self:trashSlot(player, slotIndexRaw, amountRaw)
end
function InventoryServiceServer.RequestTrashSelectedSlot(self: InventoryServiceServer, player: Player, amountRaw: any)
	self:trashSelectedSlot(player, amountRaw)
end
function InventoryServiceServer.RequestUseSelectedSlot(self: InventoryServiceServer, player: Player, amountRaw: any)
	self:useSelectedSlot(player, amountRaw)
end

function InventoryServiceServer.RequestPlaceSelectedDeployable(
	self: InventoryServiceServer,
	player: Player,
	tileXRaw: any,
	tileYRaw: any
)
	local runtime = self:getLoadedRuntime(player)
	if runtime == nil then
		return
	end
	local selectedSlot = runtime.selectedSlot
	local selectedStack = if selectedSlot ~= nil
		then InventoryServiceUtils.getStack(runtime.state, selectedSlot)
		else nil
	if selectedSlot == nil or selectedStack == nil then
		return
	end

	local itemId = sanitizeItemId(selectedStack.itemId)
	if itemId == nil or resolveDeployableConfig(itemId) == nil then
		return
	end

	self:tryPlaceSelectedDeployable(player, runtime, itemId, tileXRaw, tileYRaw)
end

function InventoryServiceServer.SetDropFromSlotHandler(self: InventoryServiceServer, handlerRaw: any)
	self.dropFromSlotHandler = if typeof(handlerRaw) == "function" then handlerRaw else nil
	self.didWarnMissingDropHandler = false
end

function InventoryServiceServer.GetState(self: InventoryServiceServer, player: Player): InventoryState
	local runtime = self.playerRuntimesByUserId[player.UserId]
	if runtime ~= nil then
		return runtime.state
	end
	return InventoryServiceUtils.createDefaultState(InventoryServiceUtils.LOAD_STATE_UNLOADED)
end

function InventoryServiceServer.GetStateCopy(self: InventoryServiceServer, player: Player): InventoryState
	return InventoryServiceUtils.cloneState(self:getState(player))
end

function InventoryServiceServer.SetSelectedSlot(
	self: InventoryServiceServer,
	player: Player,
	slotIndexRaw: any
): boolean
	local runtime = self:getLoadedRuntime(player)
	if runtime == nil then
		return false
	end
	local nextState = InventoryServiceUtils.cloneState(runtime.state)
	local changed = InventoryServiceUtils.setSelectedSlot(nextState, slotIndexRaw)
	if changed then
		self:commitState(player, runtime, nextState, "set_selected_slot", nil)
	else
		self:syncSelectedTool(player, runtime, "set_selected_slot_unchanged")
	end
	return changed
end

function InventoryServiceServer.AddItem(
	self: InventoryServiceServer,
	player: Player,
	itemIdRaw: any,
	amountRaw: any,
	optionsRaw: any
): AddItemResult
	local runtime = self:getLoadedRuntime(player)
	if runtime == nil then
		return createEmptyAddItemResult()
	end
	local options = if typeof(optionsRaw) == "table" then optionsRaw else {}
	local nextState = InventoryServiceUtils.cloneState(runtime.state)
	local result = InventoryServiceUtils.addItem(
		nextState,
		itemIdRaw,
		amountRaw,
		options.maxStack,
		options.metadata,
		options.stackIdPrefix
	)
	if result.changed then
		self:commitState(player, runtime, nextState, "add_item", nil)
	end
	return result
end

function InventoryServiceServer.RemoveItem(
	self: InventoryServiceServer,
	player: Player,
	itemIdRaw: any,
	amountRaw: any,
	optionsRaw: any
): RemoveItemResult
	local runtime = self:getLoadedRuntime(player)
	if runtime == nil then
		return createEmptyRemoveItemResult()
	end
	local options = if typeof(optionsRaw) == "table" then optionsRaw else {}
	local nextState = InventoryServiceUtils.cloneState(runtime.state)
	local result = InventoryServiceUtils.removeItem(
		nextState,
		itemIdRaw,
		amountRaw,
		options.metadata,
		options.requireExactMetadata
	)
	if result.changed then
		self:commitState(player, runtime, nextState, "remove_item", function()
			self:suppressAndPurgePlayerTools(runtime, player, itemIdRaw, result.removed)
		end)
	end
	return result
end

function InventoryServiceServer.RemoveFromSlot(
	self: InventoryServiceServer,
	player: Player,
	slotIndexRaw: any,
	amountRaw: any
): SlotMutationResult
	local runtime = self:getLoadedRuntime(player)
	if runtime == nil then
		return createEmptySlotMutationResult()
	end
	local existingStack = InventoryServiceUtils.getStack(runtime.state, slotIndexRaw)
	local itemId = if existingStack ~= nil then existingStack.itemId else nil
	local nextState = InventoryServiceUtils.cloneState(runtime.state)
	local result = InventoryServiceUtils.removeFromSlot(nextState, slotIndexRaw, amountRaw)
	if result.changed then
		self:commitState(player, runtime, nextState, "remove_from_slot", function()
			if itemId ~= nil then
				self:suppressAndPurgePlayerTools(runtime, player, itemId, result.removedAmount)
			end
		end)
	end
	return result
end

function InventoryServiceServer.MoveSlot(
	self: InventoryServiceServer,
	player: Player,
	fromSlotRaw: any,
	toSlotRaw: any,
	amountRaw: any
): SlotMutationResult
	local runtime = self:getLoadedRuntime(player)
	if runtime == nil then
		return createEmptySlotMutationResult()
	end
	local nextState = InventoryServiceUtils.cloneState(runtime.state)
	local result = InventoryServiceUtils.moveSlot(nextState, fromSlotRaw, toSlotRaw, amountRaw)
	if result.changed then
		self:commitState(player, runtime, nextState, "move_slot", nil)
	end
	return result
end

function InventoryServiceServer.SplitSlot(
	self: InventoryServiceServer,
	player: Player,
	fromSlotRaw: any,
	toSlotRaw: any,
	amountRaw: any
): SlotMutationResult
	local runtime = self:getLoadedRuntime(player)
	if runtime == nil then
		return createEmptySlotMutationResult()
	end
	local nextState = InventoryServiceUtils.cloneState(runtime.state)
	local result = InventoryServiceUtils.splitSlot(nextState, fromSlotRaw, toSlotRaw, amountRaw)
	if result.changed then
		self:commitState(player, runtime, nextState, "split_slot", nil)
	end
	return result
end

function InventoryServiceServer.UseSelectedSlot(
	self: InventoryServiceServer,
	player: Player,
	amountRaw: any
): SlotMutationResult
	local runtime = self:getLoadedRuntime(player)
	if runtime == nil then
		return createEmptySlotMutationResult()
	end
	local selectedStack = if runtime.selectedSlot ~= nil
		then InventoryServiceUtils.getStack(runtime.state, runtime.selectedSlot)
		else nil
	local itemId = if selectedStack ~= nil then selectedStack.itemId else nil
	local nextState = InventoryServiceUtils.cloneState(runtime.state)
	local result = InventoryServiceUtils.consumeSelected(nextState, amountRaw)
	if result.changed then
		self:commitState(player, runtime, nextState, "use_selected_slot", function()
			if itemId ~= nil then
				self:suppressAndPurgePlayerTools(runtime, player, itemId, result.removedAmount)
			end
		end)
	end
	return result
end

function InventoryServiceServer.DropFromSlot(
	self: InventoryServiceServer,
	player: Player,
	slotIndexRaw: any,
	amountRaw: any,
	throwDirectionRaw: any
): SlotMutationResult
	local unchanged = createEmptySlotMutationResult()
	local handler = self.dropFromSlotHandler
	if handler ~= nil then
		local ok, handled = pcall(handler, player, slotIndexRaw, amountRaw, throwDirectionRaw)
		if ok and handled ~= false and handled ~= nil then
			return {
				changed = true,
				touchedSlots = {},
				fromSlot = nil,
				toSlot = nil,
				movedAmount = 0,
				removedAmount = 0,
				swapped = false,
			}
		end
		return unchanged
	end
	if self.didWarnMissingDropHandler ~= true then
		self.didWarnMissingDropHandler = true
	end
	return unchanged
end

function InventoryServiceServer.ReleaseSuppressedToolImport(
	self: InventoryServiceServer,
	player: Player,
	itemIdRaw: any,
	amountRaw: any
): number
	local runtime = self:getRuntime(player)
	if runtime == nil then
		return 0
	end
	local itemId = sanitizeItemId(itemIdRaw)
	if itemId == nil then
		return 0
	end
	local amount = normalizeImportAmount(amountRaw)
	local current = runtime.suppressedToolImports[itemId] or 0
	if current <= 0 then
		return 0
	end
	local released = math.min(current, amount)
	local remaining = current - released
	runtime.suppressedToolImports[itemId] = if remaining > 0 then remaining else nil
	return released
end

function InventoryServiceServer.TrashSlot(
	self: InventoryServiceServer,
	player: Player,
	slotIndexRaw: any,
	amountRaw: any
): SlotMutationResult
	local runtime = self:getLoadedRuntime(player)
	if runtime == nil then
		return createEmptySlotMutationResult()
	end
	local existingStack = InventoryServiceUtils.getStack(runtime.state, slotIndexRaw)
	local itemId = if existingStack ~= nil then existingStack.itemId else nil
	local nextState = InventoryServiceUtils.cloneState(runtime.state)
	local result = InventoryServiceUtils.trashSlot(nextState, slotIndexRaw, amountRaw)
	if result.changed then
		self:commitState(player, runtime, nextState, "trash_slot", function()
			if itemId ~= nil then
				self:suppressAndPurgePlayerTools(runtime, player, itemId, result.removedAmount)
			end
		end)
	end
	return result
end

function InventoryServiceServer.TrashSelectedSlot(
	self: InventoryServiceServer,
	player: Player,
	amountRaw: any
): SlotMutationResult
	local runtime = self:getLoadedRuntime(player)
	if runtime == nil then
		return createEmptySlotMutationResult()
	end
	local selectedStack = if runtime.selectedSlot ~= nil
		then InventoryServiceUtils.getStack(runtime.state, runtime.selectedSlot)
		else nil
	local itemId = if selectedStack ~= nil then selectedStack.itemId else nil
	local nextState = InventoryServiceUtils.cloneState(runtime.state)
	local result = InventoryServiceUtils.trashSelected(nextState, amountRaw)
	if result.changed then
		self:commitState(player, runtime, nextState, "trash_selected_slot", function()
			if itemId ~= nil then
				self:suppressAndPurgePlayerTools(runtime, player, itemId, result.removedAmount)
			end
		end)
	end
	return result
end

function InventoryServiceServer.CountItem(
	self: InventoryServiceServer,
	player: Player,
	itemIdRaw: any,
	metadataRaw: any,
	requireExactMetadataRaw: any
): number
	local runtime = self:getLoadedRuntime(player)
	if runtime == nil then
		return 0
	end
	return InventoryServiceUtils.countItem(runtime.state, itemIdRaw, metadataRaw, requireExactMetadataRaw)
end

function InventoryServiceServer.ClearInventory(self: InventoryServiceServer, player: Player): boolean
	local runtime = self:getLoadedRuntime(player)
	if runtime == nil then
		return false
	end
	local nextState = InventoryServiceUtils.cloneState(runtime.state)
	local changed = InventoryServiceUtils.clear(nextState)
	if changed then
		self:commitState(player, runtime, nextState, "clear_inventory", nil)
	end
	return changed
end

function InventoryServiceServer.Destroy(self: InventoryServiceServer)
	if self.playerAddedConnection ~= nil then
		self.playerAddedConnection:Disconnect()
		self.playerAddedConnection = nil
	end
	if self.playerRemovingConnection ~= nil then
		self.playerRemovingConnection:Disconnect()
		self.playerRemovingConnection = nil
	end
	for userId, runtime in self.playerRuntimesByUserId do
		local player = runtime.player
		if player ~= nil then
			if runtime.isDirty then
				self:stagePersistedState(player, runtime, "destroy")
			end
			self:performSave(player, runtime, runtime.saveDebounceToken, "destroy")
		end
		runtime.playerJanitor:Destroy()
		runtime.characterJanitor:Destroy()
		runtime.toolSyncJanitor:Destroy()
		self.playerRuntimesByUserId[userId] = nil
	end
	if self.networker ~= nil then
		self.networker:destroy()
	end
end

