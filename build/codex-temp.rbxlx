            <Item class="Folder" referent="1274">
              <Properties>
                <string name="Name">UI</string>
              </Properties>
              <Item class="ModuleScript" referent="1275">
                <Properties>
                  <string name="Name">AbbreviationFormatter</string>
                  <string name="Source"><![CDATA[--!strict

local AbbreviationFormatter = {}

export type AbbreviationRule = {
	suffix: string,
	threshold: number,
	divisor: number,
	precision: number,
}

export type NumberFormatOptions = {
	precision: number?,
	trimTrailingZeros: boolean?,
	minThreshold: number?,
	forceSign: boolean?,
}

local DEFAULT_RULES: { AbbreviationRule } = {
	{ suffix = "T", threshold = 1e12, divisor = 1e12, precision = 2 },
	{ suffix = "B", threshold = 1e9, divisor = 1e9, precision = 2 },
	{ suffix = "M", threshold = 1e6, divisor = 1e6, precision = 2 },
	{ suffix = "K", threshold = 1e3, divisor = 1e3, precision = 1 },
}

local function normalizePrecision(precisionRaw: any, fallback: number): number
	local precision = if typeof(precisionRaw) == "number" then math.floor(precisionRaw) else fallback
	if precision < 0 then
		return 0
	end
	if precision > 8 then
		return 8
	end
	return precision
end

local function roundTo(value: number, precision: number): number
	local multiplier = 10 ^ precision
	if value >= 0 then
		return math.floor(value * multiplier + 0.5) / multiplier
	end
	return math.ceil(value * multiplier - 0.5) / multiplier
end

local function trimZeros(text: string): string
	if not string.find(text, ".", 1, true) then
		return text
	end
	text = string.gsub(text, "0+$", "")
	text = string.gsub(text, "%.$", "")
	return text
end

local function formatFixed(value: number, precision: number, trimTrailing: boolean): string
	local rounded = roundTo(value, precision)
	local raw = string.format("%.*f", precision, rounded)
	if trimTrailing then
		return trimZeros(raw)
	end
	return raw
end

local function signPrefix(value: number, forceSign: boolean): string
	if value < 0 then
		return "-"
	end
	if forceSign and value > 0 then
		return "+"
	end
	return ""
end

function AbbreviationFormatter.FormatNumber(valueRaw: any, optionsRaw: NumberFormatOptions?): string
	if typeof(valueRaw) ~= "number" then
		return "0"
	end
	local value = valueRaw :: number
	if value ~= value then
		return "0"
	end
	if value == math.huge then
		return "inf"
	end
	if value == -math.huge then
		return "-inf"
	end

	local options = if typeof(optionsRaw) == "table" then optionsRaw else {}
	local trimTrailing = if options.trimTrailingZeros == nil then true else options.trimTrailingZeros == true
	local minThreshold = if typeof(options.minThreshold) == "number" then math.max(0, options.minThreshold) else 0
	local forceSign = options.forceSign == true

	local magnitude = math.abs(value)
	for _, rule in DEFAULT_RULES do
		if magnitude >= math.max(rule.threshold, minThreshold) then
			local precision = normalizePrecision(options.precision, rule.precision)
			local scaled = magnitude / rule.divisor
			return signPrefix(value, forceSign) .. formatFixed(scaled, precision, trimTrailing) .. rule.suffix
		end
	end

	local precision = normalizePrecision(options.precision, if magnitude >= 100 then 0 else 2)
	return signPrefix(value, forceSign) .. formatFixed(magnitude, precision, trimTrailing)
end

function AbbreviationFormatter.FormatPercent(valueRaw: any, precisionRaw: any?, forceSignRaw: any?): string
	if typeof(valueRaw) ~= "number" then
		return "0%"
	end
	local precision = normalizePrecision(precisionRaw, 1)
	local value = valueRaw :: number
	local scaled = value * 100
	local text = formatFixed(math.abs(scaled), precision, true)
	return signPrefix(scaled, forceSignRaw == true) .. text .. "%"
end

function AbbreviationFormatter.FormatDps(valueRaw: any, precisionRaw: any?): string
	if typeof(valueRaw) ~= "number" then
		return "0 DPS"
	end
	local text = AbbreviationFormatter.FormatNumber(valueRaw, {
		precision = normalizePrecision(precisionRaw, 1),
		trimTrailingZeros = true,
	})
	return text .. " DPS"
end

function AbbreviationFormatter.FormatTime(valueRaw: any): string
	if typeof(valueRaw) ~= "number" then
		return "0s"
	end
	local seconds = math.max(0, math.floor(valueRaw))
	if seconds < 60 then
		return string.format("%ds", seconds)
	end
	local minutes = math.floor(seconds / 60)
	seconds %= 60
	if minutes < 60 then
		return string.format("%dm %02ds", minutes, seconds)
	end
	local hours = math.floor(minutes / 60)
	minutes %= 60
	return string.format("%dh %02dm %02ds", hours, minutes, seconds)
end

function AbbreviationFormatter.FormatTimeMMSS(valueRaw: any): string
	if typeof(valueRaw) ~= "number" then
		return "00:00"
	end
	local totalSeconds = math.max(0, math.floor(valueRaw))
	local minutes = math.floor(totalSeconds / 60)
	local seconds = totalSeconds % 60
	return string.format("%02d:%02d", minutes, seconds)
end

function AbbreviationFormatter.FormatValue(valueRaw: any, formatKindRaw: any, precisionRaw: any?): string
	local formatKind = if typeof(formatKindRaw) == "string" then formatKindRaw else "number"
	if formatKind == "percent" then
		return AbbreviationFormatter.FormatPercent(valueRaw, precisionRaw)
	end
	if formatKind == "dps" then
		return AbbreviationFormatter.FormatDps(valueRaw, precisionRaw)
	end
	if formatKind == "time" then
		return AbbreviationFormatter.FormatTime(valueRaw)
	end
	if formatKind == "mmss" then
		return AbbreviationFormatter.FormatTimeMMSS(valueRaw)
	end
	return AbbreviationFormatter.FormatNumber(valueRaw, {
		precision = precisionRaw,
	})
end

AbbreviationFormatter.formatNumber = AbbreviationFormatter.FormatNumber
AbbreviationFormatter.formatPercent = AbbreviationFormatter.FormatPercent
AbbreviationFormatter.formatDps = AbbreviationFormatter.FormatDps
AbbreviationFormatter.formatTime = AbbreviationFormatter.FormatTime
AbbreviationFormatter.formatTimeMMSS = AbbreviationFormatter.FormatTimeMMSS
AbbreviationFormatter.formatValue = AbbreviationFormatter.FormatValue

return AbbreviationFormatter
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="1276">
                <Properties>
                  <string name="Name">DynamicTextResolver</string>
                  <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local AbbreviationFormatter = require(script.Parent.AbbreviationFormatter)

local DynamicTextResolver = {}
DynamicTextResolver.__index = DynamicTextResolver

export type ResolverConfig = {
	maxDepth: number?,
	keepUnknownPlaceholders: boolean?,
	missingValue: string?,
	warnOnMissing: boolean?,
	onMissing: ((key: string, template: string) -> ())?,
}

export type ResolveOptions = {
	keepUnknownPlaceholders: boolean?,
	missingValue: string?,
	maxDepth: number?,
}

export type DynamicTextResolver = typeof(setmetatable({} :: any, DynamicTextResolver))

local function clampInteger(valueRaw: any, fallback: number, minValue: number, maxValue: number): number
	local value = if typeof(valueRaw) == "number" then math.floor(valueRaw) else fallback
	if value < minValue then
		return minValue
	end
	if value > maxValue then
		return maxValue
	end
	return value
end

local function splitPath(path: string): { string }
	local out = {}
	local startIndex = 1
	while startIndex <= #path do
		local dotIndex = string.find(path, ".", startIndex, true)
		if dotIndex == nil then
			out[#out + 1] = string.sub(path, startIndex)
			break
		end
		out[#out + 1] = string.sub(path, startIndex, dotIndex - 1)
		startIndex = dotIndex + 1
	end
	return out
end

local function resolvePath(context: any, keyPath: string): any
	if typeof(context) ~= "table" then
		return nil
	end
	if keyPath == "" then
		return nil
	end
	local cursor = context
	for _, segment in splitPath(keyPath) do
		if typeof(cursor) ~= "table" then
			return nil
		end
		cursor = cursor[segment]
		if cursor == nil then
			return nil
		end
	end
	return cursor
end

local function isTruthy(value: any): boolean
	if value == nil then
		return false
	end
	if typeof(value) == "boolean" then
		return value
	end
	return true
end

local function toStringValue(value: any): string
	local kind = typeof(value)
	if kind == "string" then
		return value
	end
	if kind == "number" then
		return AbbreviationFormatter.formatNumber(value)
	end
	if kind == "boolean" then
		return if value then "true" else "false"
	end
	return tostring(value)
end

function DynamicTextResolver.New(configRaw: ResolverConfig?): DynamicTextResolver
	local config = if typeof(configRaw) == "table" then configRaw else {}
	local self = setmetatable({
		maxDepth = clampInteger(config.maxDepth, 4, 1, 20),
		keepUnknownPlaceholders = if config.keepUnknownPlaceholders == nil then true else config.keepUnknownPlaceholders == true,
		missingValue = if typeof(config.missingValue) == "string" then config.missingValue else "",
		warnOnMissing = config.warnOnMissing == true,
		onMissing = config.onMissing,
	}, DynamicTextResolver)
	return self
end

function DynamicTextResolver._missing(self: DynamicTextResolver, key: string, template: string, keepUnknown: boolean, missingValue: string): string
	if self.onMissing ~= nil then
		self.onMissing(key, template)
	end
	if keepUnknown then
		return "{" .. key .. "}"
	end
	return missingValue
end

function DynamicTextResolver._applyModifier(self: DynamicTextResolver, value: any, modifierRaw: string): string
	if modifierRaw == "" then
		return toStringValue(value)
	end

	local modifier = modifierRaw
	local arg = ""
	local separator = string.find(modifierRaw, ",", 1, true)
	if separator ~= nil then
		modifier = string.sub(modifierRaw, 1, separator - 1)
		arg = string.sub(modifierRaw, separator + 1)
	end

	if modifier == "abbr" or modifier == "number" then
		return AbbreviationFormatter.formatNumber(value)
	end
	if modifier == "percent" then
		return AbbreviationFormatter.formatPercent(value)
	end
	if modifier == "dps" then
		return AbbreviationFormatter.formatDps(value)
	end
	if modifier == "time" then
		return AbbreviationFormatter.formatTime(value)
	end
	if modifier == "mmss" then
		return AbbreviationFormatter.formatTimeMMSS(value)
	end
	if modifier == "upper" then
		return string.upper(toStringValue(value))
	end
	if modifier == "lower" then
		return string.lower(toStringValue(value))
	end
	if modifier == "fixed" then
		local precision = tonumber(arg) or 2
		if typeof(value) ~= "number" then
			return toStringValue(value)
		end
		return string.format("%.*f", math.max(0, math.floor(precision)), value)
	end

	local fixedDigits = string.match(modifier, "^fixed(%d+)$")
	if fixedDigits ~= nil then
		if typeof(value) ~= "number" then
			return toStringValue(value)
		end
		local precision = math.max(0, math.floor(tonumber(fixedDigits) or 0))
		return string.format("%.*f", precision, value)
	end

	return toStringValue(value)
end

function DynamicTextResolver._resolveConditionals(
	self: DynamicTextResolver,
	template: string,
	context: { [string]: any },
	depth: number,
	options: ResolveOptions
): string
	local resolved = template
	local changed = true
	local guard = 0
	while changed do
		changed = false
		guard += 1
		if guard > 32 then
			break
		end

		local nextText = string.gsub(resolved, "%[if:([%w_%.]+)%](.-)%[/if%]", function(key: string, body: string)
			changed = true
			local value = resolvePath(context, key)
			if isTruthy(value) then
				return self:_resolveInternal(body, context, depth + 1, options)
			end
			return ""
		end)
		resolved = nextText

		nextText = string.gsub(resolved, "%[ifnot:([%w_%.]+)%](.-)%[/ifnot%]", function(key: string, body: string)
			changed = true
			local value = resolvePath(context, key)
			if not isTruthy(value) then
				return self:_resolveInternal(body, context, depth + 1, options)
			end
			return ""
		end)
		resolved = nextText
	end

	return resolved
end

function DynamicTextResolver._resolveInternal(
	self: DynamicTextResolver,
	templateRaw: string,
	contextRaw: { [string]: any }?,
	depth: number,
	optionsRaw: ResolveOptions?
): string
	if typeof(templateRaw) ~= "string" then
		return ""
	end
	local context = if typeof(contextRaw) == "table" then contextRaw else {}
	local options = if typeof(optionsRaw) == "table" then optionsRaw else {}
	local maxDepth = clampInteger(options.maxDepth, self.maxDepth, 1, 20)
	if depth >= maxDepth then
		return templateRaw
	end

	local keepUnknown = if options.keepUnknownPlaceholders == nil then self.keepUnknownPlaceholders else options.keepUnknownPlaceholders == true
	local missingValue = if typeof(options.missingValue) == "string" then options.missingValue else self.missingValue

	local conditioned = self:_resolveConditionals(templateRaw, context, depth, options)
	local didReplace = false
	local resolved = string.gsub(conditioned, "{([^{}]+)}", function(token: string)
		local key = token
		local modifier = ""
		local separator = string.find(token, ":", 1, true)
		if separator ~= nil then
			key = string.sub(token, 1, separator - 1)
			modifier = string.sub(token, separator + 1)
		end
		if key == "" then
			return ""
		end
		local value = resolvePath(context, key)
		if value == nil then
			return self:_missing(key, templateRaw, keepUnknown, missingValue)
		end
		didReplace = true
		return self:_applyModifier(value, modifier)
	end)

	if didReplace and string.find(resolved, "{", 1, true) ~= nil then
		return self:_resolveInternal(resolved, context, depth + 1, options)
	end
	return resolved
end

function DynamicTextResolver.Resolve(self: DynamicTextResolver, templateRaw: any, contextRaw: any, optionsRaw: ResolveOptions?): string
	if typeof(templateRaw) ~= "string" then
		return ""
	end
	local context = if typeof(contextRaw) == "table" then contextRaw else {}
	return self:_resolveInternal(templateRaw, context, 0, optionsRaw)
end

function DynamicTextResolver.ResolveMany(self: DynamicTextResolver, templatesRaw: any, contextRaw: any, outRaw: { string }?): { string }
	local out = if outRaw ~= nil then outRaw else {}
	if typeof(templatesRaw) ~= "table" then
		table.clear(out)
		return out
	end
	local context = if typeof(contextRaw) == "table" then contextRaw else {}
	table.clear(out)
	for index = 1, #templatesRaw do
		out[index] = self:resolve(templatesRaw[index], context)
	end
	for index = #out, #templatesRaw + 1, -1 do
		out[index] = nil
	end
	return out
end

DynamicTextResolver.new = DynamicTextResolver.New
DynamicTextResolver.resolve = DynamicTextResolver.Resolve
DynamicTextResolver.resolveMany = DynamicTextResolver.ResolveMany

return DynamicTextResolver
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="1277">
                <Properties>
                  <string name="Name">HUDLayoutEngine</string>
                  <string name="Source"><![CDATA[--!strict
local GuiService = game:GetService("GuiService")

local HUDLayoutEngine = {}
HUDLayoutEngine.__index = HUDLayoutEngine

export type LayoutDefinition = {
	id: string,
	frame: GuiObject,
	dock: string?,
	order: number?,
	offset: Vector2?,
	spacing: number?,
	visible: boolean?,
	baseSize: Vector2?,
	sizeScale: boolean?,
	constraints: {
		avoid: { string }?,
		pushDirection: "down" | "up" | "left" | "right"?,
	}?,
}

export type EngineConfig = {
	referenceHeight: number?,
	baseSpacing: number?,
	gamepadSpacingMultiplier: number?,
}

export type HUDLayoutEngine = typeof(setmetatable({} :: any, HUDLayoutEngine))

local PRESET_ANCHOR = {
	TopLeft = Vector2.new(0, 0),
	TopCenter = Vector2.new(0.5, 0),
	TopRight = Vector2.new(1, 0),
	LeftCenter = Vector2.new(0, 0.5),
	Center = Vector2.new(0.5, 0.5),
	RightCenter = Vector2.new(1, 0.5),
	BottomLeft = Vector2.new(0, 1),
	BottomCenter = Vector2.new(0.5, 1),
	BottomRight = Vector2.new(1, 1),
}

local function clampNumber(valueRaw: any, fallback: number, minValue: number, maxValue: number): number
	local value = if typeof(valueRaw) == "number" then valueRaw else fallback
	if value < minValue then
		return minValue
	end
	if value > maxValue then
		return maxValue
	end
	return value
end

local function clearArray(array: { any })
	for index = #array, 1, -1 do
		array[index] = nil
	end
end

local function estimateSize(frame: GuiObject, viewport: Vector2): Vector2
	local absSize = frame.AbsoluteSize
	if absSize.X > 0 and absSize.Y > 0 then
		return absSize
	end
	local size = frame.Size
	local x = size.X.Offset + size.X.Scale * viewport.X
	local y = size.Y.Offset + size.Y.Scale * viewport.Y
	return Vector2.new(math.max(1, x), math.max(1, y))
end

local function computeRect(position: Vector2, anchor: Vector2, size: Vector2): { minX: number, minY: number, maxX: number, maxY: number }
	local minX = position.X - anchor.X * size.X
	local minY = position.Y - anchor.Y * size.Y
	return {
		minX = minX,
		minY = minY,
		maxX = minX + size.X,
		maxY = minY + size.Y,
	}
end

local function overlaps(a: any, b: any): boolean
	if a.maxX <= b.minX then
		return false
	end
	if b.maxX <= a.minX then
		return false
	end
	if a.maxY <= b.minY then
		return false
	end
	if b.maxY <= a.minY then
		return false
	end
	return true
end

local function sortDefinitions(a: any, b: any): boolean
	local orderA = a.order or 0
	local orderB = b.order or 0
	if orderA ~= orderB then
		return orderA < orderB
	end
	return a.id < b.id
end

function HUDLayoutEngine.New(configRaw: EngineConfig?): HUDLayoutEngine
	local config = if typeof(configRaw) == "table" then configRaw else {}
	local self = setmetatable({
		definitions = {} :: { [string]: any },
		dockBuckets = {} :: { [string]: { any } },
		ordered = {} :: { any },
		placedRects = {} :: { [string]: any },
		viewport = Vector2.new(1920, 1080),
		safeTopLeft = Vector2.zero,
		safeBottomRight = Vector2.zero,
		referenceHeight = clampNumber(config.referenceHeight, 1080, 1, 10000),
		baseSpacing = clampNumber(config.baseSpacing, 10, 0, 500),
		gamepadSpacingMultiplier = clampNumber(config.gamepadSpacingMultiplier, 1.2, 1, 3),
		gamepadMode = false,
	}, HUDLayoutEngine)
	self:updateSafeZone()
	return self
end

function HUDLayoutEngine.UpdateSafeZone(self: HUDLayoutEngine)
	local topLeft, bottomRight = GuiService:GetGuiInset()
	self.safeTopLeft = topLeft
	self.safeBottomRight = bottomRight
end

function HUDLayoutEngine.SetViewport(self: HUDLayoutEngine, viewportRaw: any)
	if typeof(viewportRaw) == "Vector2" then
		self.viewport = Vector2.new(math.max(1, viewportRaw.X), math.max(1, viewportRaw.Y))
	end
end

function HUDLayoutEngine.SetGamepadMode(self: HUDLayoutEngine, enabledRaw: any)
	self.gamepadMode = enabledRaw == true
end

function HUDLayoutEngine.Register(self: HUDLayoutEngine, definitionRaw: any): boolean
	if typeof(definitionRaw) ~= "table" then
		return false
	end
	if typeof(definitionRaw.id) ~= "string" or definitionRaw.id == "" then
		return false
	end
	if typeof(definitionRaw.frame) ~= "Instance" or not definitionRaw.frame:IsA("GuiObject") then
		return false
	end
	local id = definitionRaw.id
	self.definitions[id] = {
		id = id,
		frame = definitionRaw.frame,
		dock = if typeof(definitionRaw.dock) == "string" and PRESET_ANCHOR[definitionRaw.dock] ~= nil then definitionRaw.dock else "TopLeft",
		order = if typeof(definitionRaw.order) == "number" then definitionRaw.order else 0,
		offset = if typeof(definitionRaw.offset) == "Vector2" then definitionRaw.offset else Vector2.zero,
		spacing = if typeof(definitionRaw.spacing) == "number" then definitionRaw.spacing else nil,
		visible = if definitionRaw.visible == nil then true else definitionRaw.visible == true,
		baseSize = if typeof(definitionRaw.baseSize) == "Vector2" then definitionRaw.baseSize else nil,
		sizeScale = definitionRaw.sizeScale == true,
		constraints = if typeof(definitionRaw.constraints) == "table" then definitionRaw.constraints else {},
	}
	return true
end

function HUDLayoutEngine.Unregister(self: HUDLayoutEngine, idRaw: any)
	if typeof(idRaw) ~= "string" then
		return
	end
	self.definitions[idRaw] = nil
	self.placedRects[idRaw] = nil
end

function HUDLayoutEngine.SetVisible(self: HUDLayoutEngine, idRaw: any, visibleRaw: any)
	if typeof(idRaw) ~= "string" then
		return
	end
	local definition = self.definitions[idRaw]
	if definition == nil then
		return
	end
	definition.visible = visibleRaw == true
	pcall(function()
		definition.frame.Visible = definition.visible
	end)
end

function HUDLayoutEngine.SetOrder(self: HUDLayoutEngine, idRaw: any, orderRaw: any)
	if typeof(idRaw) ~= "string" then
		return
	end
	local definition = self.definitions[idRaw]
	if definition == nil then
		return
	end
	if typeof(orderRaw) == "number" then
		definition.order = orderRaw
	end
end

function HUDLayoutEngine._buildBuckets(self: HUDLayoutEngine)
	table.clear(self.dockBuckets)
	clearArray(self.ordered)
	for _, definition in self.definitions do
		if definition.visible then
			local bucket = self.dockBuckets[definition.dock]
			if bucket == nil then
				bucket = {}
				self.dockBuckets[definition.dock] = bucket
			end
			bucket[#bucket + 1] = definition
			self.ordered[#self.ordered + 1] = definition
		end
	end
	for _, bucket in self.dockBuckets do
		table.sort(bucket, sortDefinitions)
	end
	table.sort(self.ordered, sortDefinitions)
end

function HUDLayoutEngine._basePosition(self: HUDLayoutEngine, dock: string): Vector2
	local viewport = self.viewport
	local safeTL = self.safeTopLeft
	local safeBR = self.safeBottomRight
	local left = safeTL.X
	local top = safeTL.Y
	local right = viewport.X - safeBR.X
	local bottom = viewport.Y - safeBR.Y
	if dock == "TopLeft" then
		return Vector2.new(left, top)
	end
	if dock == "TopCenter" then
		return Vector2.new((left + right) * 0.5, top)
	end
	if dock == "TopRight" then
		return Vector2.new(right, top)
	end
	if dock == "BottomLeft" then
		return Vector2.new(left, bottom)
	end
	if dock == "BottomCenter" then
		return Vector2.new((left + right) * 0.5, bottom)
	end
	if dock == "BottomRight" then
		return Vector2.new(right, bottom)
	end
	if dock == "LeftCenter" then
		return Vector2.new(left, (top + bottom) * 0.5)
	end
	if dock == "RightCenter" then
		return Vector2.new(right, (top + bottom) * 0.5)
	end
	return Vector2.new((left + right) * 0.5, (top + bottom) * 0.5)
end

function HUDLayoutEngine._flowDirection(self: HUDLayoutEngine, dock: string): Vector2
	if dock == "BottomLeft" or dock == "BottomCenter" or dock == "BottomRight" then
		return Vector2.new(0, -1)
	end
	if dock == "LeftCenter" then
		return Vector2.new(0, 1)
	end
	if dock == "RightCenter" then
		return Vector2.new(0, 1)
	end
	if dock == "Center" then
		return Vector2.new(0, 1)
	end
	return Vector2.new(0, 1)
end

function HUDLayoutEngine._resolveConstraint(self: HUDLayoutEngine, definition: any, position: Vector2, anchor: Vector2, size: Vector2, spacing: number): Vector2
	local constraints = definition.constraints
	if typeof(constraints) ~= "table" then
		return position
	end
	local avoid = constraints.avoid
	if typeof(avoid) ~= "table" or #avoid == 0 then
		return position
	end

	local direction = if constraints.pushDirection == "up" then Vector2.new(0, -1) elseif constraints.pushDirection == "left" then Vector2.new(-1, 0) elseif constraints.pushDirection == "right" then Vector2.new(1, 0) else Vector2.new(0, 1)
	local rect = computeRect(position, anchor, size)
	for _, avoidId in avoid do
		local otherRect = self.placedRects[avoidId]
		if otherRect ~= nil and overlaps(rect, otherRect) then
			if direction.Y ~= 0 then
				if direction.Y > 0 then
					position = Vector2.new(position.X, otherRect.maxY + spacing + anchor.Y * size.Y)
				else
					position = Vector2.new(position.X, otherRect.minY - spacing - (1 - anchor.Y) * size.Y)
				end
			else
				if direction.X > 0 then
					position = Vector2.new(otherRect.maxX + spacing + anchor.X * size.X, position.Y)
				else
					position = Vector2.new(otherRect.minX - spacing - (1 - anchor.X) * size.X, position.Y)
				end
			end
			rect = computeRect(position, anchor, size)
		end
	end

	return position
end

function HUDLayoutEngine.Reflow(self: HUDLayoutEngine)
	self:updateSafeZone()
	self:_buildBuckets()
	table.clear(self.placedRects)

	local scale = self.viewport.Y / self.referenceHeight
	local spacingScale = if self.gamepadMode then self.gamepadSpacingMultiplier else 1

	for dock, bucket in self.dockBuckets do
		local cursor = self:_basePosition(dock)
		local direction = self:_flowDirection(dock)
		local anchor = PRESET_ANCHOR[dock] or Vector2.zero
		for index = 1, #bucket do
			local definition = bucket[index]
			local frame = definition.frame :: GuiObject
			local spacing = (if definition.spacing ~= nil then definition.spacing else self.baseSpacing) * scale * spacingScale
			if definition.baseSize ~= nil and definition.sizeScale then
				local size = definition.baseSize
				frame.Size = UDim2.fromOffset(math.floor(size.X * scale + 0.5), math.floor(size.Y * scale + 0.5))
			end

			local size = estimateSize(frame, self.viewport)
			local position = cursor + definition.offset * scale
			position = self:_resolveConstraint(definition, position, anchor, size, spacing)
			frame.AnchorPoint = anchor
			frame.Position = UDim2.fromOffset(math.floor(position.X + 0.5), math.floor(position.Y + 0.5))

			self.placedRects[definition.id] = computeRect(position, anchor, size)
			cursor = cursor + Vector2.new(direction.X * (size.X + spacing), direction.Y * (size.Y + spacing))
		end
	end
end

function HUDLayoutEngine.GetDefinition(self: HUDLayoutEngine, idRaw: any): LayoutDefinition?
	if typeof(idRaw) ~= "string" then
		return nil
	end
	return self.definitions[idRaw]
end

function HUDLayoutEngine.Destroy(self: HUDLayoutEngine)
	table.clear(self.definitions)
	table.clear(self.dockBuckets)
	table.clear(self.placedRects)
	clearArray(self.ordered)
end

HUDLayoutEngine.new = HUDLayoutEngine.New
HUDLayoutEngine.updateSafeZone = HUDLayoutEngine.UpdateSafeZone
HUDLayoutEngine.setViewport = HUDLayoutEngine.SetViewport
HUDLayoutEngine.setGamepadMode = HUDLayoutEngine.SetGamepadMode
HUDLayoutEngine.register = HUDLayoutEngine.Register
HUDLayoutEngine.unregister = HUDLayoutEngine.Unregister
HUDLayoutEngine.setVisible = HUDLayoutEngine.SetVisible
HUDLayoutEngine.setOrder = HUDLayoutEngine.SetOrder
HUDLayoutEngine.reflow = HUDLayoutEngine.Reflow
HUDLayoutEngine.getDefinition = HUDLayoutEngine.GetDefinition
HUDLayoutEngine.destroy = HUDLayoutEngine.Destroy

return HUDLayoutEngine
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="1278">
                <Properties>
                  <string name="Name">LocalizationEngine</string>
                  <string name="Source"><![CDATA[--!strict
local DynamicTextResolver = require(script.Parent.DynamicTextResolver)

local LocalizationEngine = {}
LocalizationEngine.__index = LocalizationEngine

export type TranslationValue = string | { [string]: string }
export type LanguageTable = { [string]: TranslationValue }

export type LocalizationConfig = {
	defaultLanguage: string?,
	fallbackLanguage: string?,
	warnOnMissing: boolean?,
	resolver: any?,
}

export type TranslateOptions = {
	language: string?,
	fallbackLanguage: string?,
	count: number?,
}

export type LocalizationEngine = typeof(setmetatable({} :: any, LocalizationEngine))

local DEFAULT_PLURAL_RULE = function(count: number): string
	if count == 1 then
		return "one"
	end
	return "other"
end

local function isValidLanguageCode(codeRaw: any): boolean
	return typeof(codeRaw) == "string" and codeRaw ~= ""
end

local function normalizeCount(countRaw: any): number
	if typeof(countRaw) ~= "number" then
		return 0
	end
	return math.floor(countRaw)
end

function LocalizationEngine.New(configRaw: LocalizationConfig?): LocalizationEngine
	local config = if typeof(configRaw) == "table" then configRaw else {}
	local defaultLanguage = if isValidLanguageCode(config.defaultLanguage) then config.defaultLanguage else "en"
	local fallbackLanguage = if isValidLanguageCode(config.fallbackLanguage) then config.fallbackLanguage else defaultLanguage
	local resolver = if config.resolver ~= nil then config.resolver else DynamicTextResolver.new({
		warnOnMissing = false,
		keepUnknownPlaceholders = true,
	})

	local self = setmetatable({
		languages = {} :: { [string]: LanguageTable },
		pluralRules = {} :: { [string]: (count: number) -> string },
		currentLanguage = defaultLanguage,
		defaultLanguage = defaultLanguage,
		fallbackLanguage = fallbackLanguage,
		warnOnMissing = config.warnOnMissing == true,
		resolver = resolver,
	}, LocalizationEngine)
	return self
end

function LocalizationEngine.RegisterLanguage(self: LocalizationEngine, languageRaw: any, tableRaw: any): boolean
	if not isValidLanguageCode(languageRaw) then
		return false
	end
	if typeof(tableRaw) ~= "table" then
		return false
	end
	local language = languageRaw :: string
	local copy = {}
	for key, value in tableRaw do
		if typeof(key) ~= "string" then
			continue
		end
		if typeof(value) == "string" then
			copy[key] = value
		elseif typeof(value) == "table" then
			local forms = {}
			for form, text in value do
				if typeof(form) == "string" and typeof(text) == "string" then
					forms[form] = text
				end
			end
			copy[key] = forms
		end
	end
	self.languages[language] = copy
	if self.pluralRules[language] == nil then
		self.pluralRules[language] = DEFAULT_PLURAL_RULE
	end
	return true
end

function LocalizationEngine.RegisterLanguages(self: LocalizationEngine, tablesRaw: any)
	if typeof(tablesRaw) ~= "table" then
		return
	end
	for language, languageTable in tablesRaw do
		if typeof(language) == "string" then
			self:registerLanguage(language, languageTable)
		end
	end
end

function LocalizationEngine.SetPluralRule(self: LocalizationEngine, languageRaw: any, callbackRaw: any): boolean
	if not isValidLanguageCode(languageRaw) then
		return false
	end
	if typeof(callbackRaw) ~= "function" then
		return false
	end
	self.pluralRules[languageRaw] = callbackRaw
	return true
end

function LocalizationEngine.SetLanguage(self: LocalizationEngine, languageRaw: any): boolean
	if not isValidLanguageCode(languageRaw) then
		return false
	end
	if self.languages[languageRaw] == nil then
		return false
	end
	self.currentLanguage = languageRaw
	return true
end

function LocalizationEngine.GetLanguage(self: LocalizationEngine): string
	return self.currentLanguage
end

function LocalizationEngine.GetAvailableLanguages(self: LocalizationEngine): { string }
	local out = {}
	for language in self.languages do
		out[#out + 1] = language
	end
	table.sort(out)
	return out
end

function LocalizationEngine._resolvePlural(self: LocalizationEngine, language: string, value: { [string]: string }, countRaw: any): string?
	local count = normalizeCount(countRaw)
	local rule = self.pluralRules[language] or DEFAULT_PLURAL_RULE
	local form = rule(count)
	local selected = value[form]
	if selected ~= nil then
		return selected
	end
	if count == 0 and value.zero ~= nil then
		return value.zero
	end
	if count == 1 and value.one ~= nil then
		return value.one
	end
	return value.other
end

function LocalizationEngine._lookup(self: LocalizationEngine, language: string, key: string, countRaw: any): string?
	local languageTable = self.languages[language]
	if languageTable == nil then
		return nil
	end
	local entry = languageTable[key]
	if entry == nil then
		return nil
	end
	if typeof(entry) == "string" then
		return entry
	end
	if typeof(entry) == "table" then
		return self:_resolvePlural(language, entry :: { [string]: string }, countRaw)
	end
	return nil
end

function LocalizationEngine.Translate(self: LocalizationEngine, keyRaw: any, paramsRaw: any?, optionsRaw: TranslateOptions?): string
	if typeof(keyRaw) ~= "string" or keyRaw == "" then
		return ""
	end
	local options = if typeof(optionsRaw) == "table" then optionsRaw else {}
	local params = if typeof(paramsRaw) == "table" then paramsRaw else {}
	local language = if isValidLanguageCode(options.language) then options.language else self.currentLanguage
	local fallbackLanguage = if isValidLanguageCode(options.fallbackLanguage) then options.fallbackLanguage else self.fallbackLanguage

	local count = if options.count ~= nil then options.count else params.count
	local template = self:_lookup(language, keyRaw, count)
	if template == nil and fallbackLanguage ~= language then
		template = self:_lookup(fallbackLanguage, keyRaw, count)
	end
	if template == nil and self.defaultLanguage ~= language and self.defaultLanguage ~= fallbackLanguage then
		template = self:_lookup(self.defaultLanguage, keyRaw, count)
	end
	if template == nil then
		return keyRaw
	end

	return self.resolver:resolve(template, params)
end

function LocalizationEngine.ValidateLanguage(self: LocalizationEngine, languageRaw: any): { string }
	local errors = {}
	if not isValidLanguageCode(languageRaw) then
		errors[#errors + 1] = "Language code is invalid"
		return errors
	end
	local languageTable = self.languages[languageRaw]
	if languageTable == nil then
		errors[#errors + 1] = string.format("Language '%s' is not registered", languageRaw)
		return errors
	end
	for key, value in languageTable do
		if typeof(key) ~= "string" then
			errors[#errors + 1] = "Found non-string translation key"
			continue
		end
		if typeof(value) == "string" then
			continue
		end
		if typeof(value) ~= "table" then
			errors[#errors + 1] = string.format("Key '%s' has invalid value type", key)
			continue
		end
		if value.other == nil and value.one == nil then
			errors[#errors + 1] = string.format("Key '%s' missing plural forms (expected 'other' or 'one')", key)
		end
	end
	return errors
end

function LocalizationEngine.HasKey(self: LocalizationEngine, keyRaw: any, languageRaw: any?): boolean
	if typeof(keyRaw) ~= "string" then
		return false
	end
	local language = if isValidLanguageCode(languageRaw) then languageRaw else self.currentLanguage
	local languageTable = self.languages[language]
	if languageTable == nil then
		return false
	end
	return languageTable[keyRaw] ~= nil
end

LocalizationEngine.new = LocalizationEngine.New
LocalizationEngine.registerLanguage = LocalizationEngine.RegisterLanguage
LocalizationEngine.registerLanguages = LocalizationEngine.RegisterLanguages
LocalizationEngine.setPluralRule = LocalizationEngine.SetPluralRule
LocalizationEngine.setLanguage = LocalizationEngine.SetLanguage
LocalizationEngine.getLanguage = LocalizationEngine.GetLanguage
LocalizationEngine.getAvailableLanguages = LocalizationEngine.GetAvailableLanguages
LocalizationEngine.translate = LocalizationEngine.Translate
LocalizationEngine.validateLanguage = LocalizationEngine.ValidateLanguage
LocalizationEngine.hasKey = LocalizationEngine.HasKey

return LocalizationEngine
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="1279">
                <Properties>
                  <string name="Name">NotificationBus</string>
                  <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Sift = require(ReplicatedStorage.Packages.Sift)

local RunService = game:GetService("RunService")

local NotificationBus = {}
NotificationBus.__index = NotificationBus

export type NotificationConfig = {
	container: GuiObject,
	eventBus: any?,
	springAnimator: any?,
	tickScheduler: any?,
	maxVisible: number?,
	maxQueue: number?,
	maxPoolSize: number?,
	rateLimitPerSecond: number?,
	defaultDuration: number?,
	mergeWindow: number?,
	layoutDirection: "Down" | "Up"?,
	sanitizePayload: ((payload: any) -> any)?,
	formatPayload: ((key: string, payload: any, count: number) -> string)?,
	createItem: (() -> GuiObject)?,
	resetItem: ((item: GuiObject) -> ())?,
	subscriptions: { { channel: string, event: string?, map: ((payload: any) -> { key: string, payload: any, config: any? }?)? } }?,
}

export type NotificationBus = typeof(setmetatable({} :: any, NotificationBus))

local function clampInteger(valueRaw: any, fallback: number, minValue: number, maxValue: number): number
	local value = if typeof(valueRaw) == "number" then math.floor(valueRaw) else fallback
	if value < minValue then
		return minValue
	end
	if value > maxValue then
		return maxValue
	end
	return value
end

local function clampNumber(valueRaw: any, fallback: number, minValue: number, maxValue: number): number
	local value = if typeof(valueRaw) == "number" then valueRaw else fallback
	if value < minValue then
		return minValue
	end
	if value > maxValue then
		return maxValue
	end
	return value
end

local function safeDisconnect(connection: any?)
	if connection == nil then
		return
	end
	pcall(function()
		connection:Disconnect()
	end)
end

local function defaultCreateItem(): GuiObject
	local frame = Instance.new("Frame")
	frame.Name = "NotificationItem"
	frame.Size = UDim2.new(1, 0, 0, 28)
	frame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
	frame.BackgroundTransparency = 0.2
	frame.BorderSizePixel = 0

	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.BackgroundTransparency = 1
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Size = UDim2.new(1, -12, 1, 0)
	label.Position = UDim2.fromOffset(6, 0)
	label.Font = Enum.Font.GothamMedium
	label.TextSize = 14
	label.TextColor3 = Color3.fromRGB(240, 240, 240)
	label.RichText = true
	label.Text = ""
	label.Parent = frame

	return frame
end

local function defaultResetItem(item: GuiObject)
	item.Visible = false
	item.Parent = nil
	local label = item:FindFirstChild("Label")
	if label ~= nil and label:IsA("TextLabel") then
		label.Text = ""
		label.TextTransparency = 0
	end
	item.BackgroundTransparency = 0.2
end

local function defaultSanitizePayload(payload: any): any
	if typeof(payload) == "table" then
		return Sift.Dictionary.copy(payload)
	end
	return payload
end

local function defaultFormatPayload(key: string, payload: any, count: number): string
	if typeof(payload) == "string" then
		if count > 1 then
			return string.format("%s x%d", payload, count)
		end
		return payload
	end
	if typeof(payload) == "table" then
		if typeof(payload.text) == "string" then
			if count > 1 then
				return string.format("%s x%d", payload.text, count)
			end
			return payload.text
		end
		if typeof(payload.amount) == "number" then
			local amountText = tostring(payload.amount * count)
			if typeof(payload.label) == "string" then
				return string.format("+%s %s", amountText, payload.label)
			end
		end
	end
	if count > 1 then
		return string.format("%s x%d", key, count)
	end
	return key
end

local function compareQueued(a: any, b: any): boolean
	if a.priority ~= b.priority then
		return a.priority > b.priority
	end
	return a.order < b.order
end

function NotificationBus.New(configRaw: NotificationConfig): NotificationBus
	if typeof(configRaw) ~= "table" or typeof(configRaw.container) ~= "Instance" then
		error("NotificationBus.New expects config.container")
	end
	local self = setmetatable({
		container = configRaw.container,
		eventBus = configRaw.eventBus,
		springAnimator = configRaw.springAnimator,
		tickScheduler = configRaw.tickScheduler,
		maxVisible = clampInteger(configRaw.maxVisible, 6, 1, 100),
		maxQueue = clampInteger(configRaw.maxQueue, 200, 1, 10000),
		maxPoolSize = clampInteger(configRaw.maxPoolSize, 32, 1, 1000),
		rateLimitPerSecond = clampNumber(configRaw.rateLimitPerSecond, 20, 1, 500),
		defaultDuration = clampNumber(configRaw.defaultDuration, 2.5, 0.1, 30),
		mergeWindow = clampNumber(configRaw.mergeWindow, 0.6, 0, 10),
		layoutDirection = if configRaw.layoutDirection == "Up" then "Up" else "Down",
		sanitizePayload = if typeof(configRaw.sanitizePayload) == "function" then configRaw.sanitizePayload else defaultSanitizePayload,
		formatPayload = if typeof(configRaw.formatPayload) == "function" then configRaw.formatPayload else defaultFormatPayload,
		createItem = if typeof(configRaw.createItem) == "function" then configRaw.createItem else defaultCreateItem,
		resetItem = if typeof(configRaw.resetItem) == "function" then configRaw.resetItem else defaultResetItem,
		subscriptions = if typeof(configRaw.subscriptions) == "table" then configRaw.subscriptions else {},
		active = {} :: { any },
		activeByMergeKey = {} :: { [string]: any },
		queue = {} :: { any },
		pool = {} :: { GuiObject },
		pendingRelease = {} :: { any },
		recentTimestamps = {} :: { number },
		now = 0,
		orderCounter = 0,
		isInitialized = false,
		loopToken = nil,
		heartbeatConnection = nil,
		connections = {} :: { any },
	}, NotificationBus)
	return self
end

function NotificationBus._ensureLoop(self: NotificationBus)
	if self.loopToken ~= nil or self.heartbeatConnection ~= nil then
		return
	end
	if self.tickScheduler ~= nil and typeof((self.tickScheduler :: any).scheduleEvery) == "function" then
		self.loopToken = (self.tickScheduler :: any):scheduleEvery(function(dt: number)
			self:update(dt)
		end, 1 / 30, {
			group = "ui.notifications",
			priority = 100,
			catchUp = false,
		})
		return
	end
	self.heartbeatConnection = RunService.Heartbeat:Connect(function(dt)
		self:update(dt)
	end)
end

function NotificationBus._acquireItem(self: NotificationBus): GuiObject
	local item = table.remove(self.pool)
	if item ~= nil then
		return item
	end
	return self.createItem()
end

function NotificationBus._releaseItem(self: NotificationBus, item: GuiObject)
	self.resetItem(item)
	self.pool[#self.pool + 1] = item
	if #self.pool > self.maxPoolSize then
		local old = table.remove(self.pool, 1)
		if old ~= nil then
			old:Destroy()
		end
	end
end

function NotificationBus._setItemText(self: NotificationBus, item: GuiObject, text: string)
	local label = item:FindFirstChild("Label")
	if label ~= nil and label:IsA("TextLabel") then
		label.Text = text
	end
end

function NotificationBus._animateIn(self: NotificationBus, entry: any)
	local item = entry.item
	item.Visible = true
	item.Parent = self.container
	item.BackgroundTransparency = 1
	local label = item:FindFirstChild("Label")
	if label ~= nil and label:IsA("TextLabel") then
		label.TextTransparency = 1
	end
	if self.springAnimator ~= nil and typeof((self.springAnimator :: any).animate) == "function" then
		local springAnimatorAny = self.springAnimator :: any
		springAnimatorAny:animate(item, "BackgroundTransparency", 0.2, {
			frequency = 7,
			dampingRatio = 1,
		})
		if label ~= nil and label:IsA("TextLabel") then
			springAnimatorAny:animate(label, "TextTransparency", 0, {
				frequency = 7,
				dampingRatio = 1,
			})
		end
	else
		item.BackgroundTransparency = 0.2
		if label ~= nil and label:IsA("TextLabel") then
			label.TextTransparency = 0
		end
	end
end

function NotificationBus._animateOut(self: NotificationBus, entry: any)
	local item = entry.item
	local label = item:FindFirstChild("Label")
	if self.springAnimator ~= nil and typeof((self.springAnimator :: any).animate) == "function" then
		local springAnimatorAny = self.springAnimator :: any
		springAnimatorAny:animate(item, "BackgroundTransparency", 1, {
			frequency = 7,
			dampingRatio = 1,
		})
		if label ~= nil and label:IsA("TextLabel") then
			springAnimatorAny:animate(label, "TextTransparency", 1, {
				frequency = 7,
				dampingRatio = 1,
			})
		end
	else
		item.BackgroundTransparency = 1
		if label ~= nil and label:IsA("TextLabel") then
			label.TextTransparency = 1
		end
	end
	self.pendingRelease[#self.pendingRelease + 1] = {
		item = item,
		releaseAt = self.now + 0.25,
	}
end

function NotificationBus._layout(self: NotificationBus)
	local count = #self.active
	for index = 1, count do
		local entry = self.active[index]
		if self.layoutDirection == "Up" then
			entry.item.LayoutOrder = count - index + 1
		else
			entry.item.LayoutOrder = index
		end
	end
end

function NotificationBus._consumeRateSlots(self: NotificationBus)
	local cutoff = self.now - 1
	for index = #self.recentTimestamps, 1, -1 do
		if self.recentTimestamps[index] >= cutoff then
			continue
		end
		table.remove(self.recentTimestamps, index)
	end
end

function NotificationBus._canEmitNow(self: NotificationBus): boolean
	self:_consumeRateSlots()
	return #self.recentTimestamps < self.rateLimitPerSecond
end

function NotificationBus._emitFromQueue(self: NotificationBus)
	if #self.queue == 0 then
		return
	end
	if not self:_canEmitNow() then
		return
	end
	local entry = table.remove(self.queue, 1)
	if entry == nil then
		return
	end
	entry.item = self:_acquireItem()
	entry.expireAt = self.now + entry.duration
	entry.isHiding = false
	self:_setItemText(entry.item, entry.text)
	self.active[#self.active + 1] = entry
	self.activeByMergeKey[entry.mergeKey] = entry
	self.recentTimestamps[#self.recentTimestamps + 1] = self.now
	self:_animateIn(entry)
	self:_layout()

	while #self.active > self.maxVisible do
		self:_beginHide(self.active[1])
	end
end

function NotificationBus._beginHide(self: NotificationBus, entry: any)
	if entry == nil or entry.isHiding then
		return
	end
	entry.isHiding = true
	self.activeByMergeKey[entry.mergeKey] = nil
	for index = #self.active, 1, -1 do
		if self.active[index] == entry then
			table.remove(self.active, index)
			break
		end
	end
	self:_animateOut(entry)
	self:_layout()
end

function NotificationBus._findMergeCandidate(self: NotificationBus, mergeKey: string): any
	local active = self.activeByMergeKey[mergeKey]
	if active ~= nil and (self.now - active.lastUpdatedAt) <= self.mergeWindow then
		return active
	end
	for _, queued in self.queue do
		if queued.mergeKey == mergeKey and (self.now - queued.lastUpdatedAt) <= self.mergeWindow then
			return queued
		end
	end
	return nil
end

function NotificationBus.Notify(self: NotificationBus, keyRaw: any, payloadRaw: any, configRaw: any?): boolean
	if typeof(keyRaw) ~= "string" or keyRaw == "" then
		return false
	end
	local config = if typeof(configRaw) == "table" then configRaw else {}
	local payload = self.sanitizePayload(payloadRaw)
	local priority = clampInteger(config.priority, 0, -1000000, 1000000)
	local duration = clampNumber(config.duration, self.defaultDuration, 0.1, 60)
	local mergeKey = if typeof(config.mergeKey) == "string" and config.mergeKey ~= "" then config.mergeKey else keyRaw

	local candidate = self:_findMergeCandidate(mergeKey)
	if candidate ~= nil then
		candidate.count += if typeof(config.incrementBy) == "number" then math.max(1, math.floor(config.incrementBy)) else 1
		candidate.payload = payload
		candidate.lastUpdatedAt = self.now
		candidate.expireAt = self.now + duration
		candidate.text = self.formatPayload(keyRaw, payload, candidate.count)
		if candidate.item ~= nil then
			self:_setItemText(candidate.item, candidate.text)
		end
		return true
	end

	self.orderCounter += 1
	local entry = {
		key = keyRaw,
		mergeKey = mergeKey,
		payload = payload,
		priority = priority,
		duration = duration,
		count = 1,
		text = self.formatPayload(keyRaw, payload, 1),
		order = self.orderCounter,
		receivedAt = self.now,
		lastUpdatedAt = self.now,
		item = nil,
		isHiding = false,
	}

	self.queue[#self.queue + 1] = entry
	table.sort(self.queue, compareQueued)
	while #self.queue > self.maxQueue do
		table.remove(self.queue)
	end
	return true
end

function NotificationBus.NotifyDamageResult(self: NotificationBus, resultRaw: any, configRaw: any?): boolean
	if typeof(resultRaw) ~= "table" then
		return false
	end
	local damageValue = if typeof(resultRaw.finalDamage) == "number" then resultRaw.finalDamage else if typeof(resultRaw.damage) == "number" then resultRaw.damage else nil
	if damageValue == nil then
		return false
	end
	local rounded = math.floor(math.max(0, damageValue) + 0.5)
	local text = string.format("-%d HP", rounded)
	if resultRaw.wasCrit == true then
		text = string.format("<b>%s</b> <font color=\"#FFD35A\">CRIT</font>", text)
	end
	local payload = {
		text = text,
	}
	local key = "damage"
	if typeof(configRaw) == "table" and typeof(configRaw.key) == "string" and configRaw.key ~= "" then
		key = configRaw.key
	end
	return self:notify(key, payload, configRaw)
end

function NotificationBus.Update(self: NotificationBus, dtRaw: any)
	local dt = clampNumber(dtRaw, 0, 0, 1)
	if dt <= 0 then
		return
	end
	self.now += dt

	for index = #self.active, 1, -1 do
		local entry = self.active[index]
		if self.now >= entry.expireAt then
			self:_beginHide(entry)
		end
	end

	for index = #self.pendingRelease, 1, -1 do
		local pending = self.pendingRelease[index]
		if self.now < pending.releaseAt then
			continue
		end
		self:_releaseItem(pending.item)
		table.remove(self.pendingRelease, index)
	end

	self:_emitFromQueue()
end

function NotificationBus.Init(self: NotificationBus)
	if self.isInitialized then
		return
	end
	self.isInitialized = true
	self:_ensureLoop()

	if self.eventBus ~= nil and typeof((self.eventBus :: any).subscribe) == "function" then
		for _, sub in self.subscriptions do
			if typeof(sub) ~= "table" or typeof(sub.channel) ~= "string" then
				continue
			end
			local eventName = if typeof(sub.event) == "string" then sub.event else "*"
			local disconnect = (self.eventBus :: any):subscribe(sub.channel, eventName, function(payload: any)
				local mapped = nil
				if typeof(sub.map) == "function" then
					mapped = sub.map(payload)
				end
				if mapped ~= nil and typeof(mapped) == "table" and typeof(mapped.key) == "string" then
					self:notify(mapped.key, mapped.payload, mapped.config)
					return
				end
				self:notify(eventName, payload, nil)
			end)
			self.connections[#self.connections + 1] = {
				disconnect = disconnect,
			}
		end
	end
end

function NotificationBus.Destroy(self: NotificationBus)
	if self.loopToken ~= nil then
		if typeof(self.loopToken.cancel) == "function" then
			self.loopToken:cancel()
		elseif self.tickScheduler ~= nil and typeof((self.tickScheduler :: any).cancel) == "function" then
			local schedulerAny = self.tickScheduler :: any
			schedulerAny:cancel(self.loopToken)
		end
		self.loopToken = nil
	end
	if self.heartbeatConnection ~= nil then
		safeDisconnect(self.heartbeatConnection)
		self.heartbeatConnection = nil
	end

	for index = #self.connections, 1, -1 do
		local connection = self.connections[index]
		if typeof(connection) == "table" and typeof(connection.disconnect) == "function" then
			connection.disconnect()
		end
		self.connections[index] = nil
	end

	for index = #self.active, 1, -1 do
		local entry = self.active[index]
		if entry.item ~= nil then
			self:_releaseItem(entry.item)
		end
		self.active[index] = nil
	end
	for index = #self.pendingRelease, 1, -1 do
		self:_releaseItem(self.pendingRelease[index].item)
		self.pendingRelease[index] = nil
	end
	for index = #self.pool, 1, -1 do
		self.pool[index]:Destroy()
		self.pool[index] = nil
	end
	table.clear(self.activeByMergeKey)
	table.clear(self.queue)
	table.clear(self.recentTimestamps)
	self.isInitialized = false
end

NotificationBus.Notify = NotificationBus.Notify
NotificationBus.NotifyDamageResult = NotificationBus.NotifyDamageResult
NotificationBus.Init = NotificationBus.Init
NotificationBus.Update = NotificationBus.Update

NotificationBus.new = NotificationBus.New
NotificationBus.notify = NotificationBus.Notify
NotificationBus.notifyDamageResult = NotificationBus.NotifyDamageResult
NotificationBus.update = NotificationBus.Update
NotificationBus.init = NotificationBus.Init
NotificationBus.destroy = NotificationBus.Destroy

return NotificationBus
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="1280">
                <Properties>
                  <string name="Name">ReactiveState</string>
                  <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Sift = require(ReplicatedStorage.Packages.Sift)

local ReactiveState = {}

local BaseValue = {}
BaseValue.__index = BaseValue

local MutableState = {}
MutableState.__index = MutableState
setmetatable(MutableState, BaseValue)

local ComputedState = {}
ComputedState.__index = ComputedState
setmetatable(ComputedState, BaseValue)

export type Subscription = () -> ()

export type BaseValue<T> = {
	kind: string,
	id: number,
	destroyed: boolean,
	get: (self: BaseValue<T>) -> T,
	subscribe: (self: BaseValue<T>, callback: (nextValue: T, prevValue: T) -> ()) -> Subscription,
	destroy: (self: BaseValue<T>) -> (),
}

export type MutableState<T> = BaseValue<T> & {
	set: (self: MutableState<T>, nextValue: T) -> boolean,
	update: (self: MutableState<T>, updater: (prevValue: T) -> T) -> boolean,
}

export type ComputedState<T> = BaseValue<T>

local nextValueId = 0
local nextSubscriberId = 0
local activeCollector: any? = nil

local function clearArray(array: { any })
	for index = #array, 1, -1 do
		array[index] = nil
	end
end

local function noop()
end

local function safeDisconnect(connection: any?)
	if connection == nil then
		return
	end
	pcall(function()
		connection:Disconnect()
	end)
end

function BaseValue._subscribeInternal(self: any, callback: any): Subscription
	if self.destroyed or typeof(callback) ~= "function" then
		return noop
	end
	nextSubscriberId += 1
	local subscriberId = nextSubscriberId
	self.subscribers[subscriberId] = callback
	return function()
		self.subscribers[subscriberId] = nil
	end
end

function BaseValue._emit(self: any, nextValue: any, prevValue: any)
	for _, callback in self.subscribers do
		callback(nextValue, prevValue)
	end
end

function BaseValue.Subscribe(self: any, callback: any): Subscription
	return self:_subscribeInternal(callback)
end

function BaseValue.Destroy(self: any)
	if self.destroyed then
		return
	end
	self.destroyed = true
	table.clear(self.subscribers)
end

function MutableState.new<T>(initialValue: T): MutableState<T>
	nextValueId += 1
	local self = setmetatable({
		kind = "state",
		id = nextValueId,
		value = initialValue,
		destroyed = false,
		subscribers = {} :: { [number]: (nextValue: T, prevValue: T) -> () },
	}, MutableState)
	return self :: any
end

function MutableState.get<T>(self: MutableState<T>): T
	if activeCollector ~= nil then
		activeCollector:_collectDependency(self)
	end
	return self.value
end

function MutableState.set<T>(self: MutableState<T>, nextValue: T): boolean
	if self.destroyed then
		return false
	end
	if self.value == nextValue then
		return false
	end
	local prevValue = self.value
	self.value = nextValue
	self:_emit(nextValue, prevValue)
	return true
end

function MutableState.update<T>(self: MutableState<T>, updater: (prevValue: T) -> T): boolean
	if self.destroyed then
		return false
	end
	if typeof(updater) ~= "function" then
		return false
	end
	return self:set(updater(self.value))
end

MutableState.subscribe = BaseValue.Subscribe
MutableState.destroy = BaseValue.Destroy

function ComputedState.new<T>(compute: () -> T): ComputedState<T>
	nextValueId += 1
	local self = setmetatable({
		kind = "computed",
		id = nextValueId,
		compute = compute,
		value = nil :: any,
		hasValue = false,
		dirty = true,
		destroyed = false,
		subscribers = {} :: { [number]: (nextValue: T, prevValue: T) -> () },
		dependencies = {} :: { [any]: true },
		dependencySubscriptions = {} :: { [any]: Subscription },
	}, ComputedState)
	self:_recompute()
	return self :: any
end

function ComputedState._collectDependency(self: any, dependency: any)
	if self.dependencies[dependency] ~= nil then
		return
	end
	self.dependencies[dependency] = true
end

function ComputedState._clearDependencies(self: any)
	for dependency, disconnect in self.dependencySubscriptions do
		disconnect()
		self.dependencySubscriptions[dependency] = nil
	end
	table.clear(self.dependencies)
end

function ComputedState._recompute(self: any)
	if self.destroyed then
		return
	end
	local previousCollector = activeCollector
	self:_clearDependencies()
	activeCollector = self
	local ok, result = pcall(self.compute)
	activeCollector = previousCollector
	if not ok then
		return
	end

	for dependency in self.dependencies do
		self.dependencySubscriptions[dependency] = dependency:subscribe(function()
			self:_markDirty()
		end)
	end

	local prevValue = self.value
	local changed = (not self.hasValue) or prevValue ~= result
	self.value = result
	self.hasValue = true
	self.dirty = false
	if changed then
		self:_emit(self.value, prevValue)
	end
end

function ComputedState._markDirty(self: any)
	if self.destroyed then
		return
	end
	if self.dirty then
		return
	end
	self.dirty = true
	self:_recompute()
end

function ComputedState.get<T>(self: ComputedState<T>): T
	if activeCollector ~= nil then
		activeCollector:_collectDependency(self)
	end
	if self.dirty then
		local selfAny = self :: any
		selfAny:_recompute()
	end
	return (self :: any).value
end

function ComputedState.destroy<T>(self: ComputedState<T>)
	if self.destroyed then
		return
	end
	local selfAny = self :: any
	selfAny:_clearDependencies()
	BaseValue.Destroy(self :: any)
end

ComputedState.subscribe = BaseValue.Subscribe

function ReactiveState.CreateState<T>(initialValue: T): MutableState<T>
	return MutableState.new(initialValue)
end

function ReactiveState.Computed<T>(compute: () -> T): ComputedState<T>
	if typeof(compute) ~= "function" then
		error("ReactiveState.Computed expects a callback")
	end
	return ComputedState.new(compute)
end

function ReactiveState.Bind(instanceRaw: any, propertyRaw: any, sourceRaw: any, transformRaw: any?): Subscription
	if typeof(instanceRaw) ~= "Instance" then
		return noop
	end
	if typeof(propertyRaw) ~= "string" or propertyRaw == "" then
		return noop
	end
	if typeof(sourceRaw) ~= "table" or typeof(sourceRaw.get) ~= "function" or typeof(sourceRaw.subscribe) ~= "function" then
		return noop
	end

	local instance = instanceRaw :: Instance
	local source = sourceRaw :: any
	local property = propertyRaw :: string
	local transform = if typeof(transformRaw) == "function" then transformRaw else nil

	local alive = true
	local function apply(value: any)
		if not alive then
			return
		end
		local nextValue = if transform ~= nil then transform(value) else value
		pcall(function()
			(instance :: any)[property] = nextValue
		end)
	end

	apply(source:get())
	local disconnectSource = source:subscribe(function(nextValue: any)
		apply(nextValue)
	end)

	local destroyingConnection = nil
	local ancestryConnection = nil
	if typeof((instance :: any).Destroying) == "RBXScriptSignal" then
		destroyingConnection = (instance :: any).Destroying:Connect(function()
			alive = false
			disconnectSource()
			safeDisconnect(ancestryConnection)
		end)
	end
	ancestryConnection = instance.AncestryChanged:Connect(function(_, parent)
		if parent == nil then
			alive = false
			disconnectSource()
			safeDisconnect(destroyingConnection)
			safeDisconnect(ancestryConnection)
		end
	end)

	return function()
		if not alive then
			return
		end
		alive = false
		disconnectSource()
		safeDisconnect(destroyingConnection)
		safeDisconnect(ancestryConnection)
	end
end

function ReactiveState.Combine(sourceListRaw: any, compute: (...any) -> any): ComputedState<any>
	if typeof(sourceListRaw) ~= "table" then
		error("ReactiveState.Combine expects a source list")
	end
	if typeof(compute) ~= "function" then
		error("ReactiveState.Combine expects a compute callback")
	end
	local sourceList = sourceListRaw :: { any }
	return ReactiveState.Computed(function()
		local values = Sift.Array.create(#sourceList)
		for index = 1, #sourceList do
			values[index] = sourceList[index]:get()
		end
		return compute(table.unpack(values, 1, #values))
	end)
end

function ReactiveState.FromAttributeCache(
	attributeCacheRaw: any,
	instanceRaw: any,
	attributeRaw: any,
	defaultValue: any?
): MutableState<any>
	local initialValue = defaultValue
	if typeof(instanceRaw) == "Instance" then
		if attributeCacheRaw ~= nil and typeof(attributeCacheRaw.get) == "function" then
			initialValue = attributeCacheRaw:get(instanceRaw, attributeRaw, defaultValue)
		elseif typeof(attributeRaw) == "string" then
			initialValue = instanceRaw:GetAttribute(attributeRaw)
			if initialValue == nil then
				initialValue = defaultValue
			end
		end
	end
	local state = ReactiveState.CreateState(initialValue)
	local disconnect: Subscription? = nil
	local connection: RBXScriptConnection? = nil

	if attributeCacheRaw ~= nil and typeof(attributeCacheRaw.onChanged) == "function" then
		disconnect = attributeCacheRaw:onChanged(instanceRaw, attributeRaw, function(_, _, nextValue)
			state:set(nextValue)
		end)
	elseif typeof(instanceRaw) == "Instance" and typeof(attributeRaw) == "string" then
		connection = instanceRaw:GetAttributeChangedSignal(attributeRaw):Connect(function()
			local value = instanceRaw:GetAttribute(attributeRaw)
			if value == nil then
				value = defaultValue
			end
			state:set(value)
		end)
	end

	local baseDestroy = state.Destroy
	function state.Destroy(selfState)
		if disconnect ~= nil then
			disconnect()
			disconnect = nil
		end
		safeDisconnect(connection)
		connection = nil
		baseDestroy(selfState)
	end

	state.destroy = state.Destroy

	return state
end

BaseValue.subscribe = BaseValue.Subscribe
BaseValue.destroy = BaseValue.Destroy

return ReactiveState
]]></string>
