                  <Item class="ModuleScript" referent="948">
                    <Properties>
                      <string name="Name">miningProgressScreen</string>
                      <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local BillboardCard = require(script:FindFirstAncestor("game").Client.UI.core.components.BillboardCard)
local ImageIds = require(script:FindFirstAncestor("game").Client.UI.core.ImageIds)
local MiningProgressBar =
	require(script:FindFirstAncestor("game").Client.UI.features.mining.components.MiningProgressBar)
local React = require(ReplicatedStorage.Packages.React)
local miningProgressSlice =
	require(script:FindFirstAncestor("game").Client.UI.features.mining.state.miningProgressSlice)
local miningProgressThunks =
	require(script:FindFirstAncestor("game").Client.UI.features.mining.state.miningProgressThunks)
local useProgressBarSmoothing =
	require(script:FindFirstAncestor("game").Client.UI.features.mining.hooks.useProgressBarSmoothing)
local useStore = require(script:FindFirstAncestor("game").Client.UI.core.hooks.useStore)

type MiningProgressState = miningProgressSlice.MiningProgressState

type MiningProgressScreenProps = {
	layoutOrder: number?,
	zIndex: number?,
	visible: boolean?,
}

local e: typeof(React.createElement) = React.createElement

local FRAME_IMAGE_ID = if typeof(ImageIds.miningProgressFrame) == "string" then ImageIds.miningProgressFrame else ""
local BAR_IMAGE_ID = if typeof(ImageIds.miningProgressBar) == "string" then ImageIds.miningProgressBar else ""
local DISPLAY_SCALE = 0.2
local BASE_FRAME_WIDTH = 270
local BASE_FRAME_HEIGHT = 30
local BASE_INSET_X = 3
local BASE_INSET_Y = 3

local function scalePixels(value: number): number
	return math.max(1, math.floor((value * DISPLAY_SCALE) + 0.5))
end

local FRAME_WIDTH = scalePixels(BASE_FRAME_WIDTH)
local FRAME_HEIGHT = scalePixels(BASE_FRAME_HEIGHT)
local BAR_INSET_X = scalePixels(BASE_INSET_X)
local BAR_INSET_Y = scalePixels(BASE_INSET_Y)
local BAR_WIDTH = math.max(1, FRAME_WIDTH - (BAR_INSET_X * 2))
local BAR_HEIGHT = math.max(1, FRAME_HEIGHT - (BAR_INSET_Y * 2))

return function(props: MiningProgressScreenProps?): React.ReactNode
	local resolvedProps: MiningProgressScreenProps = if props ~= nil then props else {}
	local miningProgressState = (useStore(miningProgressSlice.miningProgressStateAtom) :: MiningProgressState?)
		or miningProgressSlice.miningProgressStateAtom()
	local billboardRef = React.useRef(nil :: BillboardGui?)

	React.useEffect(function()
		local stop = miningProgressThunks.start()

		return function()
			stop()
		end
	end, {})

	React.useEffect(function()
		miningProgressThunks.bindBillboardGui(billboardRef.current)
		return function()
			miningProgressThunks.bindBillboardGui(nil)
		end
	end, {})

	if resolvedProps.visible == false then
		return nil
	end

	local zIndex = resolvedProps.zIndex or 170
	local isVisible = miningProgressState.visible == true
	local progressScale = useProgressBarSmoothing({
		progress = miningProgressState.progress,
		visible = isVisible,
		gainRate = 28,
		depletionRate = 7,
	})

	return e(BillboardCard, {
		enabled = isVisible,
		alwaysOnTop = true,
		lightInfluence = 0,
		maxDistance = 140,
		size = UDim2.fromOffset(FRAME_WIDTH, FRAME_HEIGHT),
		studsOffset = Vector3.zero,
		studsOffsetWorldSpace = Vector3.zero,
		zIndexBehavior = Enum.ZIndexBehavior.Sibling,
		cardVisible = false,
		nativeBillboard = {
			ref = billboardRef,
			ResetOnSpawn = false,
		},
	}, {
		e(MiningProgressBar, {
			progress = progressScale,
			frameImage = FRAME_IMAGE_ID,
			barImage = BAR_IMAGE_ID,
			frameWidth = FRAME_WIDTH,
			frameHeight = FRAME_HEIGHT,
			barWidth = BAR_WIDTH,
			barHeight = BAR_HEIGHT,
			barInsetX = BAR_INSET_X,
			barInsetY = BAR_INSET_Y,
			zIndex = zIndex,
		}),
	})
end
]]></string>
                    </Properties>
                  </Item>
                </Item>
                <Item class="Folder" referent="949">
                  <Properties>
                    <string name="Name">state</string>
                  </Properties>
                  <Item class="ModuleScript" referent="950">
                    <Properties>
                      <string name="Name">miningProgressSlice</string>
                      <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Charm = require(ReplicatedStorage.Packages.Charm)

export type MiningProgressState = {
	visible: boolean,
	progress: number,
	tileX: number?,
	tileY: number?,
	worldPosition: Vector3?,
	updatedAt: number,
}

local DEFAULT_STATE: MiningProgressState = {
	visible = false,
	progress = 0,
	tileX = nil,
	tileY = nil,
	worldPosition = nil,
	updatedAt = os.clock(),
}

local miningProgressStateAtom: Charm.Atom<MiningProgressState> = Charm.atom(DEFAULT_STATE)

local function sanitizeProgress(valueRaw: any, fallback: number): number
	if typeof(valueRaw) ~= "number" or valueRaw ~= valueRaw then
		return math.clamp(fallback, 0, 1)
	end
	return math.clamp(valueRaw, 0, 1)
end

local function sanitizeTileCoordinate(valueRaw: any): number?
	if typeof(valueRaw) ~= "number" or valueRaw ~= valueRaw then
		return nil
	end
	return math.floor(valueRaw)
end

local function sanitizeWorldPosition(valueRaw: any): Vector3?
	if typeof(valueRaw) == "Vector3" then
		return valueRaw
	end
	return nil
end

local function getMiningProgressState(): MiningProgressState
	return miningProgressStateAtom()
end

local function setMiningProgressState(stateRaw: any): MiningProgressState
	local current = miningProgressStateAtom()
	local source = if typeof(stateRaw) == "table" then stateRaw else {}
	local isVisible = (source :: any).visible == true
	local nextState: MiningProgressState = {
		visible = isVisible,
		progress = sanitizeProgress((source :: any).progress, current.progress),
		tileX = sanitizeTileCoordinate((source :: any).tileX),
		tileY = sanitizeTileCoordinate((source :: any).tileY),
		worldPosition = sanitizeWorldPosition((source :: any).worldPosition),
		updatedAt = os.clock(),
	}

	if not isVisible then
		nextState.progress = 0
		nextState.tileX = nil
		nextState.tileY = nil
		nextState.worldPosition = nil
	end

	miningProgressStateAtom(nextState)
	return nextState
end

local function showMiningProgress(payloadRaw: any): MiningProgressState
	local payload = if typeof(payloadRaw) == "table" then payloadRaw else {}
	local nextState: MiningProgressState = {
		visible = true,
		progress = sanitizeProgress((payload :: any).progress, 0),
		tileX = sanitizeTileCoordinate((payload :: any).tileX),
		tileY = sanitizeTileCoordinate((payload :: any).tileY),
		worldPosition = sanitizeWorldPosition((payload :: any).worldPosition),
		updatedAt = os.clock(),
	}

	if nextState.worldPosition == nil then
		nextState.visible = false
		nextState.progress = 0
		nextState.tileX = nil
		nextState.tileY = nil
	end

	miningProgressStateAtom(nextState)
	return nextState
end

local function hideMiningProgress(): MiningProgressState
	local nextState: MiningProgressState = {
		visible = false,
		progress = 0,
		tileX = nil,
		tileY = nil,
		worldPosition = nil,
		updatedAt = os.clock(),
	}
	miningProgressStateAtom(nextState)
	return nextState
end

local function resetMiningProgressState(): MiningProgressState
	local nextState = {
		visible = false,
		progress = 0,
		tileX = nil,
		tileY = nil,
		worldPosition = nil,
		updatedAt = os.clock(),
	} :: MiningProgressState
	miningProgressStateAtom(nextState)
	return nextState
end

return {
	miningProgressStateAtom = miningProgressStateAtom,
	getMiningProgressState = getMiningProgressState,
	setMiningProgressState = setMiningProgressState,
	showMiningProgress = showMiningProgress,
	hideMiningProgress = hideMiningProgress,
	resetMiningProgressState = resetMiningProgressState,
}
]]></string>
                    </Properties>
                  </Item>
                  <Item class="ModuleScript" referent="951">
                    <Properties>
                      <string name="Name">miningProgressThunks</string>
                      <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local ConnectionUtils = require(script:FindFirstAncestor("game").Client.UI.core.utils.ConnectionUtils)
local BuildServiceClient = require(script:FindFirstAncestor("game").Client.Services.BuildServiceClient)
local BuildServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.BuildServiceUtils)
local WorkspaceFolders = require(script:FindFirstAncestor("game").Shared.Modules.Core.WorkspaceFolders)
local miningProgressSlice = require(script:FindFirstAncestor("game").Client.UI.features.mining.state.miningProgressSlice)

type BuildServiceState = BuildServiceUtils.BuildServiceState
type MiningProgressState = miningProgressSlice.MiningProgressState

type BuildProgressPayload = {
	isActive: boolean,
	tileX: number,
	tileY: number,
	progress: number,
	breakDuration: number,
	progressMode: string?,
	progressUnits: number?,
	progressTotal: number?,
	updatedAt: number,
}

local miningProgressThunks = {}

local ANCHOR_PART_NAME = "MiningProgressAnchor"

local runtime = {
	started = false,
	breakProgressConnection = nil :: RBXScriptConnection?,
	billboardGui = nil :: BillboardGui?,
	anchorPart = nil :: Part?,
}

local function sanitizeBuildState(stateRaw: any): BuildServiceState?
	if typeof(stateRaw) ~= "table" then
		return nil
	end
	local stateAny = stateRaw :: any
	if typeof(stateAny.worldOrigin) ~= "Vector3" then
		return nil
	end
	if typeof(stateAny.tileSize) ~= "number" or stateAny.tileSize <= 0 then
		return nil
	end
	if typeof(stateAny.basePlaneX) ~= "number" then
		return nil
	end
	return stateRaw :: BuildServiceState
end

local function ensureAnchorPart(): Part
	local current = runtime.anchorPart
	if current ~= nil and current.Parent ~= nil then
		return current
	end

	local gameFolder = WorkspaceFolders.getOrCreateGameFolder()
	local existing = gameFolder:FindFirstChild(ANCHOR_PART_NAME)
	if existing ~= nil then
		if existing:IsA("Part") then
			runtime.anchorPart = existing
			return existing
		end
		existing:Destroy()
	end

	local legacy = Workspace:FindFirstChild(ANCHOR_PART_NAME)
	if legacy ~= nil then
		if legacy:IsA("Part") then
			legacy.Parent = gameFolder
			runtime.anchorPart = legacy
			return legacy
		end
		legacy:Destroy()
	end

	local part = Instance.new("Part")
	part.Name = ANCHOR_PART_NAME
	part.Size = Vector3.new(0.05, 0.05, 0.05)
	part.Transparency = 1
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Locked = true
	part.CastShadow = false
	part.CFrame = CFrame.new(0, -10000, 0)
	part.Parent = gameFolder
	runtime.anchorPart = part
	return part
end

local function hideAnchorPart()
	local anchorPart = runtime.anchorPart
	if anchorPart == nil then
		return
	end
	anchorPart.CFrame = CFrame.new(0, -10000, 0)
end

local function applyToBillboard(state: MiningProgressState)
	local billboardGui = runtime.billboardGui
	if billboardGui == nil then
		return
	end

	if state.visible ~= true or state.worldPosition == nil then
		billboardGui.Enabled = false
		billboardGui.Adornee = nil
		hideAnchorPart()
		return
	end

	local anchorPart = ensureAnchorPart()
	anchorPart.CFrame = CFrame.new(state.worldPosition)
	billboardGui.Adornee = anchorPart
	billboardGui.Enabled = true
end

local function hideMiningProgressVisual()
	local nextState = miningProgressSlice.hideMiningProgress()
	applyToBillboard(nextState)
end

local function resolveBreakWorldPosition(tileX: number, tileY: number): Vector3?
	local state = sanitizeBuildState((BuildServiceClient :: any).state)
	if state == nil then
		return nil
	end
	local worldCenter = BuildServiceUtils.tileToWorldCenter(
		tileX,
		tileY,
		state.worldOrigin,
		state.tileSize,
		state.basePlaneX
	)
	return worldCenter + Vector3.new(0, state.tileSize * 0.92, 0)
end

local function applyBuildBreakProgress(payloadRaw: any): MiningProgressState
	if typeof(payloadRaw) ~= "table" then
		hideMiningProgressVisual()
		return miningProgressSlice.getMiningProgressState()
	end

	local payload = payloadRaw :: { [string]: any }
	if payload.isActive ~= true then
		hideMiningProgressVisual()
		return miningProgressSlice.getMiningProgressState()
	end

	local tileX = BuildServiceUtils.sanitizeTileCoordinate(payload.tileX)
	local tileY = BuildServiceUtils.sanitizeTileCoordinate(payload.tileY)
	if tileX == nil or tileY == nil then
		hideMiningProgressVisual()
		return miningProgressSlice.getMiningProgressState()
	end

	local worldPosition = resolveBreakWorldPosition(tileX, tileY)
	if worldPosition == nil then
		hideMiningProgressVisual()
		return miningProgressSlice.getMiningProgressState()
	end

	local progressRaw = payload.progress
	local progress = if typeof(progressRaw) == "number" and progressRaw == progressRaw then math.clamp(progressRaw, 0, 1) else 0
	local nextState = miningProgressSlice.showMiningProgress({
		progress = progress,
		tileX = tileX,
		tileY = tileY,
		worldPosition = worldPosition,
	})
	applyToBillboard(nextState)
	return nextState
end

function miningProgressThunks.Start(): () -> ()
	if runtime.started then
		return miningProgressThunks.Stop
	end

	runtime.started = true
	local breakProgressSignal = (BuildServiceClient :: any).breakProgressChanged
	if breakProgressSignal ~= nil then
		runtime.breakProgressConnection = breakProgressSignal:Connect(function(payload: BuildProgressPayload?)
			applyBuildBreakProgress(payload)
		end)
	end

	local currentProgress = (BuildServiceClient :: any).currentBreakProgress
	applyBuildBreakProgress(currentProgress)

	return miningProgressThunks.Stop
end

function miningProgressThunks.Stop()
	ConnectionUtils.disconnect(runtime.breakProgressConnection)
	runtime.breakProgressConnection = nil
	runtime.started = false
	hideMiningProgressVisual()
	if runtime.anchorPart ~= nil then
		runtime.anchorPart:Destroy()
		runtime.anchorPart = nil
	end
end

function miningProgressThunks.BindBillboardGui(guiRaw: any)
	local billboardGui = if typeof(guiRaw) == "Instance" and guiRaw:IsA("BillboardGui")
		then guiRaw
		else nil
	runtime.billboardGui = billboardGui
	if billboardGui == nil then
		return
	end
	applyToBillboard(miningProgressSlice.getMiningProgressState())
end

function miningProgressThunks.GetState(): MiningProgressState
	return miningProgressSlice.getMiningProgressState()
end

miningProgressThunks.start = miningProgressThunks.Start
miningProgressThunks.stop = miningProgressThunks.Stop
miningProgressThunks.bindBillboardGui = miningProgressThunks.BindBillboardGui
miningProgressThunks.getState = miningProgressThunks.GetState

return miningProgressThunks
]]></string>
