			if Events.Reliable[2] ~= nil then
				task.spawn(Events.Reliable[2], Player, Value1, Value2, Value3, InvocationIdentifier)
			else
				if #Queue.Reliable[2] > 256 then
					warn('[Blink]: Event queue of "ClientFetch" exceeded 256, did you forget to implement a listener?')
				end
				table.insert(Queue.Reliable[2], { Player, Value1, Value2, Value3, InvocationIdentifier } :: { any })
			end
		end
	end
end)
Unreliable.OnServerEvent:Connect(function(Player: Player, Buffer: buffer, Instances: { Instance })
	RecieveCursor = 0
	RecieveBuffer = Buffer
	RecieveInstances = Instances
	RecieveInstanceCursor = 0
	local Size = buffer.len(RecieveBuffer)
	if SerdesThread and coroutine.status(SerdesThread) == "suspended" then
		warn(
			`[Blink]: Yielded in a Sync call. Event "{SerdesEvent}" uses a Sync call, consider using an Async call instead.`
		)
		coroutine.close(SerdesThread)
	end
	SerdesThread = coroutine.running()
	while RecieveCursor < Size do
		-- Read BLOCK: 1 bytes
		local BLOCK_START = Read(1)
		local Index = buffer.readu8(RecieveBuffer, BLOCK_START + 0)
	end
end)

local Returns = table.freeze({
	StepReplication = StepReplication,

	ServerToClient = {
		Fire = function(
			Player: Player,
			Value1: string,
			Value2: string,
			Value3: { Count: number, NilIndices: { number }, Values: { any } }
		): ()
			Load(PlayersMap[Player])
			SerdesFunctions.WriteEVENT_ServerToClient(Value1, Value2, Value3)
			PlayersMap[Player] = Save()
		end,
		FireAll = function(
			Value1: string,
			Value2: string,
			Value3: { Count: number, NilIndices: { number }, Values: { any } }
		): ()
			Load()
			SerdesFunctions.WriteEVENT_ServerToClient(Value1, Value2, Value3)
			local Buffer, Size, Instances = SendBuffer, SendCursor, SendInstances
			for _, Player in Players:GetPlayers() do
				Load(PlayersMap[Player])
				local Position = Allocate(Size)
				buffer.copy(SendBuffer, Position, Buffer, 0, Size)
				table.move(Instances, 1, #Instances, #SendInstances + 1, SendInstances)
				PlayersMap[Player] = Save()
			end
		end,
		FireList = function(
			List: { Player },
			Value1: string,
			Value2: string,
			Value3: { Count: number, NilIndices: { number }, Values: { any } }
		): ()
			Load()
			SerdesFunctions.WriteEVENT_ServerToClient(Value1, Value2, Value3)
			local Buffer, Size, Instances = SendBuffer, SendCursor, SendInstances
			for _, Player in List do
				Load(PlayersMap[Player])
				local Position = Allocate(Size)
				buffer.copy(SendBuffer, Position, Buffer, 0, Size)
				table.move(Instances, 1, #Instances, #SendInstances + 1, SendInstances)
				PlayersMap[Player] = Save()
			end
		end,
		FireExcept = function(
			Except: Player,
			Value1: string,
			Value2: string,
			Value3: { Count: number, NilIndices: { number }, Values: { any } }
		): ()
			Load()
			SerdesFunctions.WriteEVENT_ServerToClient(Value1, Value2, Value3)
			local Buffer, Size, Instances = SendBuffer, SendCursor, SendInstances
			for _, Player in Players:GetPlayers() do
				if Player == Except then
					continue
				end
				Load(PlayersMap[Player])
				local Position = Allocate(Size)
				buffer.copy(SendBuffer, Position, Buffer, 0, Size)
				table.move(Instances, 1, #Instances, #SendInstances + 1, SendInstances)
				PlayersMap[Player] = Save()
			end
		end,
	},
	ClientToServer = {
		On = function(Listener: (
			Player: Player,
			Value1: string,
			Value2: string,
			Value3: { Count: number, NilIndices: { number }, Values: { any } }
		) -> ()): () -> ()
			Events.Reliable[1] = Listener
			for Index, Arguments in Queue.Reliable[1] do
				task.spawn(Listener, table.unpack(Arguments))
			end
			Queue.Reliable[1] = {}
			return function(): ()
				if Events.Reliable[1] == Listener then
					Events.Reliable[1] = nil
				end
			end
		end,
	},
	ClientFetch = {
		On = function(Listener: (
			Player,
			string,
			string,
			{ Count: number, NilIndices: { number }, Values: { any } }
		) -> { Count: number, NilIndices: { number }, Values: { any } }): ()
			Events.Reliable[2] = function(
				Player: Player,
				Value1: string,
				Value2: string,
				Value3: { Count: number, NilIndices: { number }, Values: { any } },
				InvocationIdentifier: number
			): ()
				local ReturnValue: { Count: number, NilIndices: { number }, Values: { any } }
				local Success, Error = pcall(function()
					ReturnValue = Listener(Player, Value1, Value2, Value3)
				end)
				Load(PlayersMap[Player])
				if Success ~= true then
					local Position = Allocate(3)
					buffer.writeu8(SendBuffer, Position, 2)
					buffer.writeu8(SendBuffer, Position + 1, InvocationIdentifier)
					buffer.writeu8(SendBuffer, Position + 2, 0)
					warn(`"ClientFetch" encountered an error, {Error}`)
				else
					SerdesFunctions.WriteFUNCTION_RETURN_ClientFetch(ReturnValue, InvocationIdentifier)
				end
				PlayersMap[Player] = Save()
			end
			task.spawn(function(): ()
				local EventQueue = Queue.Reliable[2] or {}
				Queue.Reliable[2] = nil
				for Index, Arguments in EventQueue do
					Events.Reliable[2](table.unpack(Arguments))
				end
			end)
		end,
	},
})
type BLINK_EVENTS_SYMBOL = typeof(Returns)
return Returns :: BLINK_EVENTS_SYMBOL
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="1262">
                <Properties>
                  <string name="Name">Networker</string>
                  <string name="Source"><![CDATA[--!strict

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Signal = require(ReplicatedStorage.Packages.Signal)
local networkingFolder = script.Parent

local BlinkClient = if RunService:IsClient() or not RunService:IsServer()
	then require(networkingFolder.BlinkClient)
	else nil
local BlinkServer = if RunService:IsServer() then require(networkingFolder.BlinkServer) else nil

local SET_TAG = "__set"
local INSTANCE_ATTRIBUTE = "__networkTag"
local INSTANCE_TAG = "__instance"
type PackedArguments = {
	Count: number,
	NilIndices: { number },
	Values: { any },
}
type PlayerGroup = Player | { Player }

export type ClientAccess = { (...any) -> any }
export type NetworkTag = string | Instance

local NetworkerClient = {}
NetworkerClient.__index = NetworkerClient

export type Client = typeof(setmetatable(
	{} :: {
		networkTag: string,
		module: { [string]: any },
		disconnect: (() -> ())?,
		changedSignals: { [string]: Signal.Signal<any> },
		destroyed: boolean,
	},
	NetworkerClient
))

local NetworkerServer = {}
NetworkerServer.__index = NetworkerServer

export type Server = typeof(setmetatable(
	{} :: {
		networkTag: string,
		module: { [string]: any }?,
		clientAccess: ClientAccess?,
		instance: Instance?,
		instanceConn: RBXScriptConnection?,
		recipients: { Player }?,
		destroyed: boolean,
	},
	NetworkerServer
))

local serverRegistry: { [string]: Server } = {}
local serverListenersBound = false

local function emptyPackedArguments(): PackedArguments
	return {
		Count = 0,
		NilIndices = {},
		Values = {},
	}
end

local function packValues(...: any): PackedArguments
	local count = select("#", ...)
	local nilIndices: { number } = {}
	local values: { any } = {}
	local valueIndex = 1

	for index = 1, count do
		local value = select(index, ...)
		if value == nil then
			table.insert(nilIndices, index)
		else
			values[valueIndex] = value
			valueIndex += 1
		end
	end

	return {
		Count = count,
		NilIndices = nilIndices,
		Values = values,
	}
end

local function unpackValues(packed: PackedArguments): (number, { any })
	local count = packed.Count
	local unpacked: { any } = table.create(count)
	local nilCursor = 1
	local valueCursor = 1

	for index = 1, count do
		if packed.NilIndices[nilCursor] == index then
			nilCursor += 1
			unpacked[index] = nil
		else
			unpacked[index] = packed.Values[valueCursor]
			valueCursor += 1
		end
	end

	return count, unpacked
end

local function resolveNetworkTag(networkTag: NetworkTag): string
	if typeof(networkTag) == "Instance" then
		local instance = networkTag :: Instance
		local attributeTag = instance:GetAttribute(INSTANCE_ATTRIBUTE)
		if typeof(attributeTag) ~= "string" then
			instance:GetAttributeChangedSignal(INSTANCE_ATTRIBUTE):Wait()
			attributeTag = instance:GetAttribute(INSTANCE_ATTRIBUTE)
		end

		assert(typeof(attributeTag) == "string", "NetworkerClient instance does not have a networkTag attribute")
		return attributeTag
	end

	return networkTag
end

function NetworkerClient.new(networkTag: NetworkTag, module: { [string]: any }): Client
	assert(RunService:IsClient(), "NetworkerClient can only be created on the client")

	local self = setmetatable({
		networkTag = if typeof(networkTag) == "string" then networkTag else "",
		module = module,
		changedSignals = {},
		destroyed = false,
	}, NetworkerClient)

	if not RunService:IsRunning() then
		return self
	end

	self.networkTag = resolveNetworkTag(networkTag)

	assert(BlinkClient ~= nil, "Blink client transport is unavailable")
	self.disconnect = BlinkClient.ServerToClient.On(
		function(serviceTag: string, method: string, packedArgs: PackedArguments)
			if self.destroyed or serviceTag ~= self.networkTag then
				return
			end

			local argumentCount, arguments = unpackValues(packedArgs)
			if method == SET_TAG then
				local key = arguments[1]
				if typeof(key) ~= "string" then
					return
				end

				self.module[key] = arguments[2]
				local changedSignal = self.changedSignals[key]
				if changedSignal then
					changedSignal:Fire(self.module[key])
				end
				return
			end

			local moduleFunc = self.module[method]
			assert(moduleFunc, "Method " .. method .. " does not exist on networkTag " .. self.networkTag)
			task.defer(moduleFunc, self.module, table.unpack(arguments, 1, argumentCount))
		end
	)

	return self
end

function NetworkerClient.getServerChangedSignal<T>(self: Client, key: string): Signal.Signal<T>
	if not self.changedSignals[key] then
		self.changedSignals[key] = Signal.new()
	end

	return self.changedSignals[key]
end

function NetworkerClient.fire(self: Client, method: string, ...: any): ()
	if not RunService:IsRunning() then
		return
	end

	assert(BlinkClient ~= nil, "Blink client transport is unavailable")
	BlinkClient.ClientToServer.Fire(self.networkTag, method, packValues(...))
end

function NetworkerClient.fetch(self: Client, method: string, ...: any): any?
	if not RunService:IsRunning() then
		return nil
	end

	assert(BlinkClient ~= nil, "Blink client transport is unavailable")
	local packedReturns = BlinkClient.ClientFetch.Invoke(self.networkTag, method, packValues(...))
	local returnCount, returns = unpackValues(packedReturns)
	return table.unpack(returns, 1, returnCount)
end

function NetworkerClient.destroy(self: Client): ()
	if self.destroyed then
		return
	end

	self.destroyed = true
	if self.disconnect then
		self.disconnect()
		self.disconnect = nil
	end

	for _, signal in self.changedSignals do
		signal:Destroy()
	end
	table.clear(self.changedSignals)
end

function NetworkerServer:_invokeClientMethod(
	player: Player,
	method: string,
	packedArgs: PackedArguments
): PackedArguments
	local module = self.module
	if not module then
		return emptyPackedArguments()
	end

	local moduleFunc = module[method]
	if not moduleFunc then
		warn("Method " .. method .. " does not exist on module", self.networkTag)
		return emptyPackedArguments()
	end

	if self.clientAccess and not table.find(self.clientAccess, moduleFunc) then
		warn(player.Name .. " attempted to call restricted method " .. method .. " on service", self.networkTag)
		return emptyPackedArguments()
	end

	local argumentCount, arguments = unpackValues(packedArgs)
	local results = table.pack(moduleFunc(module, player, table.unpack(arguments, 1, argumentCount)))
	return packValues(table.unpack(results, 1, results.n))
end

local function ensureServerListeners()
	if serverListenersBound or not RunService:IsServer() then
		return
	end

	serverListenersBound = true
	assert(BlinkServer ~= nil, "Blink server transport is unavailable")

	BlinkServer.ClientToServer.On(
		function(player: Player, serviceTag: string, method: string, packedArgs: PackedArguments)
			local networker = serverRegistry[serviceTag]
			if not networker or networker.destroyed then
				return
			end

			networker:_invokeClientMethod(player, method, packedArgs)
		end
	)

	BlinkServer.ClientFetch.On(function(player: Player, serviceTag: string, method: string, packedArgs: PackedArguments)
		local networker = serverRegistry[serviceTag]
		if not networker or networker.destroyed then
			return emptyPackedArguments()
		end

		return networker:_invokeClientMethod(player, method, packedArgs)
	end)
end

function NetworkerServer.new(networkTag: NetworkTag, module: { [string]: any }?, clientAccess: ClientAccess?): Server
	assert(RunService:IsServer(), "NetworkerServer can only be created on the server")
	if clientAccess then
		assert(module, "Module must be provided when clientAccess is set")
	end

	ensureServerListeners()

	local resolvedTag = if typeof(networkTag) == "string" then networkTag else ""
	local instance: Instance? = nil
	local instanceConn: RBXScriptConnection? = nil

	if typeof(networkTag) == "Instance" then
		instance = networkTag :: Instance
		assert(
			instance:GetAttribute(INSTANCE_ATTRIBUTE) == nil,
			"NetworkerServer instance already has a networkTag attribute"
		)

		resolvedTag = HttpService:GenerateGUID(false):sub(1, 13)
		instance:SetAttribute(INSTANCE_ATTRIBUTE, resolvedTag)
	end

	assert(serverRegistry[resolvedTag] == nil, "NetworkerServer with the same name already exists")

	local self = setmetatable({
		networkTag = resolvedTag,
		module = module,
		clientAccess = clientAccess,
		instance = instance,
		instanceConn = instanceConn,
		recipients = nil,
		destroyed = false,
	}, NetworkerServer)

	serverRegistry[resolvedTag] = self

	if instance then
		self.instanceConn = instance.Destroying:Once(function()
			self:destroy()
		end)
	end

	return self
end

function NetworkerServer.addRecipient(self: Server, player: Player): ()
	if not self.recipients then
		self.recipients = {}
	end

	assert(self.recipients, "Recipients list is nil")
	table.insert(self.recipients, player)
end

function NetworkerServer.removeRecipient(self: Server, player: Player): ()
	if not self.recipients then
		return
	end

	local index = table.find(self.recipients, player)
	if index then
		table.remove(self.recipients, index)
	end
end

function NetworkerServer.clearRecipients(self: Server): ()
	self.recipients = nil
end

function NetworkerServer.fire(self: Server, players: PlayerGroup, method: string, ...: any): ()
	assert(BlinkServer ~= nil, "Blink server transport is unavailable")

	local packedArgs = packValues(...)
	if typeof(players) == "Instance" then
		BlinkServer.ServerToClient.Fire(players :: Player, self.networkTag, method, packedArgs)
		return
	end

	BlinkServer.ServerToClient.FireList(players :: { Player }, self.networkTag, method, packedArgs)
end

function NetworkerServer.fireAll(self: Server, method: string, ...: any): ()
	assert(BlinkServer ~= nil, "Blink server transport is unavailable")
	BlinkServer.ServerToClient.FireAll(self.networkTag, method, packValues(...))
end

function NetworkerServer.fireAllExcept(self: Server, players: PlayerGroup, method: string, ...: any): ()
	assert(BlinkServer ~= nil, "Blink server transport is unavailable")

	local packedArgs = packValues(...)
	if typeof(players) == "Instance" then
		BlinkServer.ServerToClient.FireExcept(players :: Player, self.networkTag, method, packedArgs)
		return
	end

	local excludedPlayers = players :: { Player }
	for _, player in Players:GetPlayers() do
		if table.find(excludedPlayers, player) then
			continue
		end

		BlinkServer.ServerToClient.Fire(player, self.networkTag, method, packedArgs)
	end
end

function NetworkerServer.fireRecipients(self: Server, method: string, ...: any): ()
	if not self.recipients then
		warn("No recipients set for service ", self.networkTag)
		return
	end

	self:fire(self.recipients, method, ...)
end

function NetworkerServer.set(self: Server, players: PlayerGroup, index: string, value: any)
	self:fire(players, SET_TAG, index, value)
end

function NetworkerServer.setAll(self: Server, index: string, value: any)
	self:fireAll(SET_TAG, index, value)
end

function NetworkerServer.setAllExcept(self: Server, players: PlayerGroup, index: string, value: any)
	self:fireAllExcept(players, SET_TAG, index, value)
end

function NetworkerServer.setRecipients(self: Server, index: string, value: any): ()
	self:fireRecipients(SET_TAG, index, value)
end

function NetworkerServer.destroy(self: Server): ()
	if self.destroyed then
		return
	end

	self.destroyed = true
	serverRegistry[self.networkTag] = nil
	self:clearRecipients()

	if self.instanceConn then
		self.instanceConn:Disconnect()
		self.instanceConn = nil
	end

	if self.instance then
		self.instance:SetAttribute(INSTANCE_ATTRIBUTE, nil)
		self.instance = nil
	end
end

return {
	client = NetworkerClient,
	server = NetworkerServer,
	SET_TAG = SET_TAG,
	INSTANCE_ATTRIBUTE = INSTANCE_ATTRIBUTE,
	INSTANCE_TAG = INSTANCE_TAG,
}
]]></string>
                </Properties>
              </Item>
            </Item>
            <Item class="Folder" referent="1263">
              <Properties>
                <string name="Name">Platform</string>
              </Properties>
              <Item class="ModuleScript" referent="1264">
                <Properties>
                  <string name="Name">Cursor</string>
                  <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local GuiService = game:GetService("GuiService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Signal = require(ReplicatedStorage.Packages.Signal)

local Cursor = {}
Cursor.__index = Cursor

local GAMEPAD_CURSOR_SPEED = 900
local GAMEPAD_CURSOR_DEADZONE = 0.18
local GAMEPAD_CURSOR_THUMBSTICK = Enum.KeyCode.Thumbstick2
local GAMEPAD_CURSOR_ACTIVE_ATTRIBUTE = "CustomCursorGamepadActive"

export type CursorState = {
	enabled: boolean,
	visible: boolean,
	mouseDown: boolean,
	screenPosition: Vector2,
	guiPosition: Vector2,
	isHoveringGui: boolean,
	hoveredGuiPath: string?,
}

export type CursorConfig = {
	input: any?,
	eventBus: any?,
	eventChannel: string?,
	changeEvent: string?,
	tickScheduler: any?,
	useCustomIcon: boolean?,
}

export type Cursor = typeof(setmetatable({} :: any, Cursor))

type SignalConnection = {
	Disconnect: (self: SignalConnection) -> (),
}

type CursorChangedSignal = {
	Connect: (self: CursorChangedSignal, callback: (state: CursorState) -> ()) -> SignalConnection,
	Fire: (self: CursorChangedSignal, state: CursorState) -> (),
	DisconnectAll: (self: CursorChangedSignal) -> (),
	Destroy: (self: CursorChangedSignal) -> (),
}

local function normalizeEventName(valueRaw: any, fallback: string): string
	if typeof(valueRaw) == "string" and valueRaw ~= "" then
		return valueRaw
	end
	return fallback
end

local function safeDisconnect(connection: RBXScriptConnection?)
	if connection == nil then
		return
	end
	connection:Disconnect()
end

local function isMouseButtonInput(inputType: Enum.UserInputType): boolean
	return inputType == Enum.UserInputType.MouseButton1
		or inputType == Enum.UserInputType.MouseButton2
		or inputType == Enum.UserInputType.MouseButton3
end

local function isGamepadInput(inputType: Enum.UserInputType): boolean
	return string.sub(inputType.Name, 1, 7) == "Gamepad"
end

local function isPointerMoveInput(inputType: Enum.UserInputType): boolean
	return inputType == Enum.UserInputType.MouseMovement or inputType == Enum.UserInputType.Touch
end

local function getViewportSize(): Vector2
	local camera = Workspace.CurrentCamera
	if camera ~= nil then
		return Vector2.new(math.max(1, camera.ViewportSize.X), math.max(1, camera.ViewportSize.Y))
	end
	return Vector2.new(1920, 1080)
end

local function clampScreenPosition(screenPosition: Vector2): Vector2
	local viewport = getViewportSize()
	return Vector2.new(
		math.clamp(screenPosition.X, 0, math.max(0, viewport.X - 1)),
		math.clamp(screenPosition.Y, 0, math.max(0, viewport.Y - 1))
	)
end

local function getCenteredScreenPosition(): Vector2
	local viewport = getViewportSize()
	return Vector2.new(viewport.X * 0.5, viewport.Y * 0.5)
end

local function normalizeGamepadCursorVector(vector: Vector2): Vector2
	local magnitude = vector.Magnitude
	if magnitude <= GAMEPAD_CURSOR_DEADZONE or magnitude <= 1e-4 then
		return Vector2.zero
	end
	local scaledMagnitude = math.clamp((magnitude - GAMEPAD_CURSOR_DEADZONE) / math.max(1e-4, 1 - GAMEPAD_CURSOR_DEADZONE), 0, 1)
	return vector.Unit * scaledMagnitude
end

local function resolveLastInputType(inputTypeRaw: any): Enum.UserInputType?
	if typeof(inputTypeRaw) == "EnumItem" and inputTypeRaw.EnumType == Enum.UserInputType then
		return inputTypeRaw :: Enum.UserInputType
	end

	local ok, inputType = pcall(function()
		return UserInputService:GetLastInputType()
	end)
	if ok and typeof(inputType) == "EnumItem" and inputType.EnumType == Enum.UserInputType then
		return inputType :: Enum.UserInputType
	end

	return nil
end

local function toGuiPosition(screenPosition: Vector2): Vector2
	local topLeftInset, _ = GuiService:GetGuiInset()
	if topLeftInset.X == 0 and topLeftInset.Y == 0 then
		return screenPosition
	end
	return screenPosition
end

local function getPlayerGui(): PlayerGui?
	local localPlayer = Players.LocalPlayer
	if localPlayer == nil then
		return nil
	end
	local playerGui = localPlayer:FindFirstChildOfClass("PlayerGui")
	if playerGui ~= nil and playerGui:IsA("PlayerGui") then
		return playerGui
	end
	return nil
end

local function isCustomCursorGui(guiObject: GuiObject): boolean
	local current: Instance? = guiObject
	while current do
		if current:GetAttribute("IsCustomMouseCursor") == true then
			return true
		end
		if CollectionService:HasTag(current, "IsCustomMouseCursor") then
			return true
		end
		current = current.Parent
	end
	return false
end

local function isHoverTarget(guiObject: GuiObject): boolean
	if not guiObject.Visible then
		return false
	end
	if isCustomCursorGui(guiObject) then
		return false
	end
	if guiObject:IsA("GuiButton") then
		return true
	end
	if guiObject:IsA("TextBox") then
		return true
	end
	if guiObject.Active then
		return true
	end
	if guiObject.Selectable then
		return true
	end
	return false
end

local function resolveHoveredGuiObject(guiPosition: Vector2): GuiObject?
	local playerGui = getPlayerGui()
	if playerGui == nil then
		return nil
	end
	local ok, objects = pcall(function()
		return playerGui:GetGuiObjectsAtPosition(math.floor(guiPosition.X), math.floor(guiPosition.Y))
	end)
	if not ok or type(objects) ~= "table" then
		return nil
	end
	for _, guiObject in objects do
		if guiObject:IsA("GuiObject") and isHoverTarget(guiObject) then
			return guiObject
		end
	end
	return nil
end

local function cloneState(state: CursorState): CursorState
	return {
		enabled = state.enabled,
		visible = state.visible,
		mouseDown = state.mouseDown,
		screenPosition = state.screenPosition,
		guiPosition = state.guiPosition,
		isHoveringGui = state.isHoveringGui,
		hoveredGuiPath = state.hoveredGuiPath,
	}
end

local function statesEqual(a: CursorState, b: CursorState): boolean
	return a.enabled == b.enabled
		and a.visible == b.visible
		and a.mouseDown == b.mouseDown
		and a.screenPosition == b.screenPosition
		and a.guiPosition == b.guiPosition
		and a.isHoveringGui == b.isHoveringGui
		and a.hoveredGuiPath == b.hoveredGuiPath
end

function Cursor.New(configRaw: CursorConfig?): Cursor
	local config = if typeof(configRaw) == "table" then configRaw else {}
	local defaultScreenPosition = Vector2.zero
	local ok, mouseLocation = pcall(function()
		return UserInputService:GetMouseLocation()
	end)
	if ok and typeof(mouseLocation) == "Vector2" then
		defaultScreenPosition = mouseLocation
	elseif UserInputService.GamepadEnabled and not UserInputService.MouseEnabled then
		defaultScreenPosition = getCenteredScreenPosition()
	end
	local state = {
		enabled = true,
		visible = UserInputService.MouseEnabled or (UserInputService.GamepadEnabled and not UserInputService.MouseEnabled),
		mouseDown = false,
		screenPosition = defaultScreenPosition,
		guiPosition = toGuiPosition(defaultScreenPosition),
		isHoveringGui = false,
		hoveredGuiPath = nil,
	} :: CursorState
	local self = setmetatable({
		input = config.input,
		eventBus = config.eventBus,
		eventChannel = normalizeEventName(config.eventChannel, "cursor"),
		changeEvent = normalizeEventName(config.changeEvent, "changed"),
		tickScheduler = config.tickScheduler,
		useCustomIcon = if config.useCustomIcon == nil then true else config.useCustomIcon == true,
		defaultMouseIconEnabled = nil :: boolean?,
		state = state,
		changedSignal = Signal.new() :: CursorChangedSignal,
		inputChangedConnection = nil :: RBXScriptConnection?,
		inputBeganConnection = nil :: RBXScriptConnection?,
		inputEndedConnection = nil :: RBXScriptConnection?,
		lastInputTypeChangedConnection = nil :: RBXScriptConnection?,
		stepConnection = nil :: RBXScriptConnection?,
		pollToken = nil,
		boundWithInputModule = false,
		gamepadThumbstickConnection = nil :: RBXScriptConnection?,
		gamepadInputBeganConnection = nil :: RBXScriptConnection?,
		gamepadInputEndedConnection = nil :: RBXScriptConnection?,
		gamepadMoveVector = Vector2.zero,
		lastInputWasGamepad = UserInputService.GamepadEnabled and not UserInputService.MouseEnabled,
		isInitialized = false,
	}, Cursor)
	return self
end

function Cursor._emitChanged(self: Cursor, state: CursorState)
	self.changedSignal:Fire(state)
	if self.eventBus ~= nil and typeof((self.eventBus :: any).publish) == "function" then
		local eventBusAny = self.eventBus :: any
		eventBusAny:publish(self.eventChannel, self.changeEvent, state)
	end
end

function Cursor._setState(self: Cursor, partial: { [string]: any })
	local current = self.state
	local nextState: CursorState = {
		enabled = if partial.enabled ~= nil then partial.enabled == true else current.enabled,
		visible = if partial.visible ~= nil then partial.visible == true else current.visible,
		mouseDown = if partial.mouseDown ~= nil then partial.mouseDown == true else current.mouseDown,
		screenPosition = if typeof(partial.screenPosition) == "Vector2" then partial.screenPosition else current.screenPosition,
		guiPosition = if typeof(partial.guiPosition) == "Vector2" then partial.guiPosition else current.guiPosition,
		isHoveringGui = if partial.isHoveringGui ~= nil then partial.isHoveringGui == true else current.isHoveringGui,
		hoveredGuiPath = if typeof(partial.hoveredGuiPath) == "string" and partial.hoveredGuiPath ~= ""
			then partial.hoveredGuiPath
			else if partial.hoveredGuiPath == false
				then nil
				else current.hoveredGuiPath,
	}
	if statesEqual(current, nextState) then
		return
	end
	self.state = nextState
	self:_emitChanged(cloneState(nextState))
end

function Cursor._applyMouseIcon(self: Cursor)
	if self.defaultMouseIconEnabled == nil then
		self.defaultMouseIconEnabled = UserInputService.MouseIconEnabled
	end
	if self.useCustomIcon and self.state.enabled then
		UserInputService.MouseIconEnabled = false
	else
		UserInputService.MouseIconEnabled = if self.defaultMouseIconEnabled ~= nil then self.defaultMouseIconEnabled else true
	end
end

function Cursor._updateVisibility(self: Cursor)
	self:_setState({
		visible = self.state.enabled and (self.lastInputWasGamepad or UserInputService.MouseEnabled),
	})
	GuiService:SetAttribute(GAMEPAD_CURSOR_ACTIVE_ATTRIBUTE, self.state.enabled and self.lastInputWasGamepad)
end

function Cursor._syncSelectedObject(self: Cursor, hoveredGui: GuiObject?)
	if not self.lastInputWasGamepad then
		return
	end

	local nextSelected = nil :: GuiObject?
	if hoveredGui ~= nil and (hoveredGui.Selectable or hoveredGui:IsA("GuiButton") or hoveredGui:IsA("TextBox")) then
		nextSelected = hoveredGui
	end

	if GuiService.SelectedObject ~= nextSelected then
		GuiService.SelectedObject = nextSelected
	end
end

function Cursor._applyFromScreenPosition(self: Cursor, screenPosition: Vector2)
	local clampedScreenPosition = clampScreenPosition(screenPosition)
	local guiPosition = toGuiPosition(clampedScreenPosition)
	local hoveredGui = resolveHoveredGuiObject(guiPosition)
	self:_syncSelectedObject(hoveredGui)
	self:_setState({
		screenPosition = clampedScreenPosition,
		guiPosition = guiPosition,
		isHoveringGui = hoveredGui ~= nil,
		hoveredGuiPath = if hoveredGui ~= nil then hoveredGui:GetFullName() else false,
	})
end

function Cursor._syncFromMouseLocation(self: Cursor)
	if not UserInputService.MouseEnabled then
		return
	end
	local ok, mouseLocation = pcall(function()
		return UserInputService:GetMouseLocation()
	end)
	if ok and typeof(mouseLocation) == "Vector2" then
		self:_applyFromScreenPosition(mouseLocation)
	end
end

function Cursor._activateHoveredGui(self: Cursor)
	local hoveredGui = resolveHoveredGuiObject(self.state.guiPosition)
	if hoveredGui ~= nil then
		self:_syncSelectedObject(hoveredGui)
		if hoveredGui:IsA("GuiButton") then
			hoveredGui:Activate()
			return
		end
	end

	local selectedObject = GuiService.SelectedObject
	if selectedObject ~= nil and selectedObject:IsA("GuiButton") then
		selectedObject:Activate()
	end
end

function Cursor._updateGamepadVector(self: Cursor, inputObject: InputObject)
	if inputObject.KeyCode ~= GAMEPAD_CURSOR_THUMBSTICK then
		return
	end
	local position = inputObject.Position
	if typeof(position) ~= "Vector3" then
		return
	end

	self.lastInputWasGamepad = true
	self.gamepadMoveVector = normalizeGamepadCursorVector(Vector2.new(position.X, -position.Y))
	self:_updateVisibility()
end

function Cursor._stepGamepadCursor(self: Cursor, dt: number)
	if not self.state.enabled or not self.lastInputWasGamepad then
		return
	end
	if self.gamepadMoveVector.Magnitude <= 1e-4 then
		return
	end

	local basePosition = self.state.screenPosition
	if basePosition.Magnitude <= 1e-4 and not UserInputService.MouseEnabled then
		basePosition = getCenteredScreenPosition()
	end
	self:_applyFromScreenPosition(basePosition + self.gamepadMoveVector * GAMEPAD_CURSOR_SPEED * math.max(dt, 1 / 240))
end

function Cursor._bindGamepadConnections(self: Cursor)
	self.gamepadThumbstickConnection = UserInputService.InputChanged:Connect(function(inputObject: InputObject)
		if not self.state.enabled or not isGamepadInput(inputObject.UserInputType) then
			return
		end
		self:_updateGamepadVector(inputObject)
	end)

	self.gamepadInputBeganConnection = UserInputService.InputBegan:Connect(function(inputObject: InputObject, gameProcessed: boolean)
		if gameProcessed or not self.state.enabled or not isGamepadInput(inputObject.UserInputType) then
			return
		end

		self.lastInputWasGamepad = true
		self:_updateVisibility()

		if inputObject.KeyCode == Enum.KeyCode.ButtonA then
			self:_setState({
				mouseDown = true,
			})
			self:_activateHoveredGui()
		end
	end)

	self.gamepadInputEndedConnection = UserInputService.InputEnded:Connect(function(inputObject: InputObject)
		if not self.state.enabled or not isGamepadInput(inputObject.UserInputType) then
			return
		end

		if inputObject.KeyCode == GAMEPAD_CURSOR_THUMBSTICK then
			self.gamepadMoveVector = Vector2.zero
		elseif inputObject.KeyCode == Enum.KeyCode.ButtonA then
			self:_setState({
				mouseDown = false,
			})
		end
	end)
end

function Cursor._bindWithInputModule(self: Cursor): boolean
	local input = self.input
	if input == nil or typeof((input :: any).bindAction) ~= "function" then
		return false
	end

	local moveBound = (input :: any):bindAction("Cursor.PointerMove", function(phase: string, context: any)
		if not self.state.enabled then
			return false
		end
		if phase ~= "Changed" and phase ~= "Began" then
			return false
		end
		local inputObject = if typeof(context) == "table" then context.input else nil
		if typeof(inputObject) == "InputObject" and isPointerMoveInput((inputObject :: InputObject).UserInputType) then
			self:_applyFromScreenPosition((inputObject :: InputObject).Position)
		end
		return false
	end, {
		layer = "UI",
		consume = false,
		allowGameProcessed = true,
		allowWhileTyping = true,
		bindings = {
			{ inputType = Enum.UserInputType.MouseMovement },
			{ inputType = Enum.UserInputType.Touch },
		},
	})

	local downBound = (input :: any):bindAction("Cursor.PointerDown", function(phase: string)
		if not self.state.enabled then
			return false
		end
		if phase == "Began" then
			self:_setState({
				mouseDown = true,
			})
		elseif phase == "Ended" then
			self:_setState({
				mouseDown = false,
			})
		end
		return false
	end, {
		layer = "UI",
		consume = false,
		allowGameProcessed = true,
		allowWhileTyping = true,
		bindings = {
			{ inputType = Enum.UserInputType.MouseButton1 },
			{ inputType = Enum.UserInputType.MouseButton2 },
			{ inputType = Enum.UserInputType.MouseButton3 },
		},
	})

	return moveBound == true and downBound == true
end

function Cursor._unbindInputModule(self: Cursor)
	if not self.boundWithInputModule then
		return
	end
	local input = self.input
	if input ~= nil and typeof((input :: any).unbindAction) == "function" then
		local inputAny = input :: any
		inputAny:unbindAction("Cursor.PointerMove")
		inputAny:unbindAction("Cursor.PointerDown")
	end
	self.boundWithInputModule = false
end

function Cursor._bindFallbackConnections(self: Cursor)
	self.inputChangedConnection = UserInputService.InputChanged:Connect(function(inputObject: InputObject)
		if not self.state.enabled then
			return
		end
		if isPointerMoveInput(inputObject.UserInputType) then
			self.lastInputWasGamepad = false
			self:_updateVisibility()
			self:_applyFromScreenPosition(inputObject.Position)
		end
	end)

	self.inputBeganConnection = UserInputService.InputBegan:Connect(function(inputObject: InputObject)
		if not self.state.enabled then
			return
		end
		if isMouseButtonInput(inputObject.UserInputType) then
			self.lastInputWasGamepad = false
			self:_updateVisibility()
			self:_setState({
				mouseDown = true,
			})
			self:_syncFromMouseLocation()
		end
	end)

	self.inputEndedConnection = UserInputService.InputEnded:Connect(function(inputObject: InputObject)
		if not self.state.enabled then
			return
		end
		if isMouseButtonInput(inputObject.UserInputType) then
			self:_setState({
				mouseDown = false,
			})
			self:_syncFromMouseLocation()
		end
	end)
end

function Cursor._startPolling(self: Cursor)
	if self.tickScheduler ~= nil and typeof((self.tickScheduler :: any).scheduleEvery) == "function" then
		self.pollToken = (self.tickScheduler :: any):scheduleEvery(function()
			if self.state.enabled then
				if UserInputService.MouseEnabled and not self.lastInputWasGamepad then
					self:_syncFromMouseLocation()
				end
				self:_stepGamepadCursor(1 / 60)
			end
		end, 1 / 60, {
			group = "cursor.poll",
			priority = 250,
			catchUp = false,
		})
		return
	end
	self.stepConnection = RunService.RenderStepped:Connect(function(dt: number)
		if not self.state.enabled then
			return
		end
		if UserInputService.MouseEnabled and not self.lastInputWasGamepad then
			self:_syncFromMouseLocation()
		end
		self:_stepGamepadCursor(dt)
	end)
end

function Cursor._stopPolling(self: Cursor)
	if self.pollToken ~= nil then
		if typeof(self.pollToken.cancel) == "function" then
			self.pollToken:cancel()
		elseif self.tickScheduler ~= nil and typeof((self.tickScheduler :: any).cancel) == "function" then
			local schedulerAny = self.tickScheduler :: any
			schedulerAny:cancel(self.pollToken)
		end
		self.pollToken = nil
	end
	safeDisconnect(self.stepConnection)
	self.stepConnection = nil
end

function Cursor.Init(self: Cursor)
	if self.isInitialized then
		return
	end
	self.isInitialized = true
	self:_applyMouseIcon()
	self:_syncFromMouseLocation()

	if self.input ~= nil and typeof((self.input :: any).init) == "function" then
		local inputAny = self.input :: any
		pcall(function()
			inputAny:init()
		end)
	end

	self.boundWithInputModule = self:_bindWithInputModule()
	if not self.boundWithInputModule then
		self:_bindFallbackConnections()
	end
	self:_bindGamepadConnections()

	self.lastInputTypeChangedConnection = UserInputService.LastInputTypeChanged:Connect(function(inputType: Enum.UserInputType)
		local lastInputType = resolveLastInputType(inputType)
		self.lastInputWasGamepad = if lastInputType ~= nil then isGamepadInput(lastInputType) else self.lastInputWasGamepad
		if not self.lastInputWasGamepad then
			self.gamepadMoveVector = Vector2.zero
		end
		self:_setState({
			mouseDown = false,
		})
		self:_updateVisibility()
		if self.lastInputWasGamepad then
			if self.state.screenPosition.Magnitude <= 1e-4 then
				self:_applyFromScreenPosition(getCenteredScreenPosition())
			end
		else
			self:_syncFromMouseLocation()
		end
	end)

	self:_startPolling()
end

function Cursor.OnChanged(self: Cursor, callbackRaw: any): () -> ()
	if typeof(callbackRaw) ~= "function" then
		return function() end
	end
	local connection = self.changedSignal:Connect(callbackRaw :: (state: CursorState) -> ())
	return function()
		connection:Disconnect()
	end
end

function Cursor.GetState(self: Cursor): CursorState
	return cloneState(self.state)
end

function Cursor.GetScreenPosition(self: Cursor): Vector2
	return self.state.screenPosition
end

function Cursor.GetGuiPosition(self: Cursor): Vector2
	return self.state.guiPosition
end

function Cursor.IsHoveringGui(self: Cursor): boolean
	return self.state.isHoveringGui
end

function Cursor.GetHoveredGuiPath(self: Cursor): string?
	return self.state.hoveredGuiPath
end

function Cursor.SetMouseDown(self: Cursor, isDownRaw: any)
	self:_setState({
		mouseDown = isDownRaw == true,
	})
end

function Cursor.SetEnabled(self: Cursor, enabledRaw: any)
	local isEnabled = enabledRaw == true
	self:_setState({
		enabled = isEnabled,
		mouseDown = if isEnabled then self.state.mouseDown else false,
		visible = if isEnabled then self.state.visible else false,
	})
	if isEnabled then
		self:_updateVisibility()
		if self.lastInputWasGamepad then
			if self.state.screenPosition.Magnitude <= 1e-4 then
				self:_applyFromScreenPosition(getCenteredScreenPosition())
			end
		else
			self:_syncFromMouseLocation()
		end
	else
		GuiService:SetAttribute(GAMEPAD_CURSOR_ACTIVE_ATTRIBUTE, false)
	end
	self:_applyMouseIcon()
end

function Cursor.SetUseCustomIcon(self: Cursor, useCustomIconRaw: any)
	self.useCustomIcon = useCustomIconRaw == true
	self:_applyMouseIcon()
end

function Cursor.Sync(self: Cursor)
	if self.lastInputWasGamepad then
		self:_updateVisibility()
		if self.state.screenPosition.Magnitude <= 1e-4 then
			self:_applyFromScreenPosition(getCenteredScreenPosition())
		end
		return
	end
	self:_syncFromMouseLocation()
end

function Cursor.UpdateFromScreenPosition(self: Cursor, screenPositionRaw: any)
	if typeof(screenPositionRaw) ~= "Vector2" then
		return
	end
	self:_applyFromScreenPosition(screenPositionRaw)
end

function Cursor.Destroy(self: Cursor)
	self:_stopPolling()
	self:_unbindInputModule()
	safeDisconnect(self.inputChangedConnection)
	safeDisconnect(self.inputBeganConnection)
	safeDisconnect(self.inputEndedConnection)
	safeDisconnect(self.gamepadThumbstickConnection)
	safeDisconnect(self.gamepadInputBeganConnection)
	safeDisconnect(self.gamepadInputEndedConnection)
	safeDisconnect(self.lastInputTypeChangedConnection)
	self.inputChangedConnection = nil
	self.inputBeganConnection = nil
	self.inputEndedConnection = nil
	self.gamepadThumbstickConnection = nil
	self.gamepadInputBeganConnection = nil
	self.gamepadInputEndedConnection = nil
	self.lastInputTypeChangedConnection = nil
	if self.defaultMouseIconEnabled ~= nil then
		UserInputService.MouseIconEnabled = self.defaultMouseIconEnabled
	else
		UserInputService.MouseIconEnabled = true
	end
	GuiService:SetAttribute(GAMEPAD_CURSOR_ACTIVE_ATTRIBUTE, false)
	self.defaultMouseIconEnabled = nil
	self.changedSignal:DisconnectAll()
	self.changedSignal:Destroy()
	self.isInitialized = false
end

Cursor.OnChanged = Cursor.OnChanged
Cursor.GetState = Cursor.GetState
Cursor.GetScreenPosition = Cursor.GetScreenPosition
Cursor.GetGuiPosition = Cursor.GetGuiPosition
Cursor.SetMouseDown = Cursor.SetMouseDown
Cursor.SetEnabled = Cursor.SetEnabled
Cursor.SetUseCustomIcon = Cursor.SetUseCustomIcon
Cursor.Sync = Cursor.Sync
Cursor.UpdateFromScreenPosition = Cursor.UpdateFromScreenPosition
Cursor.Init = Cursor.Init
Cursor.Destroy = Cursor.Destroy

Cursor.new = Cursor.New
Cursor.init = Cursor.Init
Cursor.onChanged = Cursor.OnChanged
Cursor.getState = Cursor.GetState
Cursor.getScreenPosition = Cursor.GetScreenPosition
Cursor.getGuiPosition = Cursor.GetGuiPosition
Cursor.isHoveringGui = Cursor.IsHoveringGui
Cursor.getHoveredGuiPath = Cursor.GetHoveredGuiPath
Cursor.setMouseDown = Cursor.SetMouseDown
Cursor.setEnabled = Cursor.SetEnabled
Cursor.setUseCustomIcon = Cursor.SetUseCustomIcon
Cursor.sync = Cursor.Sync
Cursor.updateFromScreenPosition = Cursor.UpdateFromScreenPosition
Cursor.destroy = Cursor.Destroy

return Cursor
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="1265">
                <Properties>
                  <string name="Name">GamepadNav</string>
                  <string name="Source"><![CDATA[--!strict
local GuiService = game:GetService("GuiService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Sift = require(ReplicatedStorage.Packages.Sift)
local UserInputService = game:GetService("UserInputService")

local Signal = require(ReplicatedStorage.Packages.Signal)

local GamepadNav = {}
GamepadNav.__index = GamepadNav

local GAMEPAD_CURSOR_ACTIVE_ATTRIBUTE = "CustomCursorGamepadActive"
local THUMBSTICK_ACTIVE_EPSILON = 1e-4
local DEFAULT_MOVE_REPEAT_COOLDOWN = 0.12
local DEFAULT_STICK_DEADZONE = 0.12
local DEFAULT_NAVIGATION_DEADZONE = 0.35

GamepadNav.THUMBSTICK_ACTIVE_EPSILON = THUMBSTICK_ACTIVE_EPSILON
GamepadNav.DEFAULT_MOVE_REPEAT_COOLDOWN = DEFAULT_MOVE_REPEAT_COOLDOWN
GamepadNav.DEFAULT_STICK_DEADZONE = DEFAULT_STICK_DEADZONE
GamepadNav.DEFAULT_NAVIGATION_DEADZONE = DEFAULT_NAVIGATION_DEADZONE

export type NavDirection = "Up" | "Down" | "Left" | "Right"
export type ThumbstickKey = "Left" | "Right"

export type ThumbstickState = {
	key: ThumbstickKey,
	raw: Vector2,
	screen: Vector2,
	magnitude: number,
	active: boolean,
}

export type ThumbstickSnapshot = {
	left: ThumbstickState,
	right: ThumbstickState,
	dominant: ThumbstickKey?,
	lastUpdatedAt: number,
	stickDeadzone: number,
	navigationDeadzone: number,
}

export type LayoutConfig = {
	mode: "Linear" | "Grid"?,
	columns: number?,
	wrap: boolean?,
}

export type FocusCallback = (nextFocused: GuiObject?, prevFocused: GuiObject?) -> ()

export type GamepadNavConfig = {
	eventBus: any?,
	eventChannel: string?,
	focusEvent: string?,
	thumbstickEvent: string?,
	tooltipManager: any?,
	onActivate: ((focused: GuiObject?) -> ())?,
	onBack: (() -> ())?,
	onFocusChanged: FocusCallback?,
	moveRepeatCooldown: number?,
	stickDeadzone: number?,
	navigationDeadzone: number?,
	navigationStickKeyCode: Enum.KeyCode?,
}

type LayoutRecord = {
	key: string,
	elements: { GuiObject },
	mode: "Linear" | "Grid",
	columns: number,
	wrap: boolean,
}

export type GamepadNav = typeof(setmetatable({} :: any, GamepadNav))

type SignalConnection = {
	Disconnect: (self: SignalConnection) -> (),
}

type FocusChangedSignal = {
	Connect: (self: FocusChangedSignal, callback: FocusCallback) -> SignalConnection,
	Fire: (self: FocusChangedSignal, nextFocused: GuiObject?, prevFocused: GuiObject?) -> (),
	DisconnectAll: (self: FocusChangedSignal) -> (),
	Destroy: (self: FocusChangedSignal) -> (),
}

type ThumbstickChangedCallback = (snapshot: ThumbstickSnapshot) -> ()

type ThumbstickChangedSignal = {
	Connect: (self: ThumbstickChangedSignal, callback: ThumbstickChangedCallback) -> SignalConnection,
	Fire: (self: ThumbstickChangedSignal, snapshot: ThumbstickSnapshot) -> (),
	DisconnectAll: (self: ThumbstickChangedSignal) -> (),
	Destroy: (self: ThumbstickChangedSignal) -> (),
}

local function clampInteger(valueRaw: any, fallback: number, minValue: number, maxValue: number): number
	local value = if typeof(valueRaw) == "number" then math.floor(valueRaw) else fallback
	if value < minValue then
		return minValue
	end
	if value > maxValue then
		return maxValue
	end
	return value
end

local function clampNumber(valueRaw: any, fallback: number, minValue: number, maxValue: number): number
	local value = if typeof(valueRaw) == "number" then valueRaw else fallback
	if value < minValue then
		return minValue
	end
	if value > maxValue then
		return maxValue
	end
	return value
end

local function safeDisconnect(connection: RBXScriptConnection?)
	if connection == nil then
		return
	end
	connection:Disconnect()
end

local function normalizeEventName(valueRaw: any, fallback: string): string
	if typeof(valueRaw) == "string" and valueRaw ~= "" then
		return valueRaw
	end
	return fallback
end

local function isGamepadInput(inputType: Enum.UserInputType): boolean
	return string.sub(inputType.Name, 1, 7) == "Gamepad"
end

local function isSelectable(gui: GuiObject): boolean
	return gui.Visible and gui.Active and gui.Selectable
end

local function createThumbstickState(key: ThumbstickKey): ThumbstickState
	return {
		key = key,
		raw = Vector2.zero,
		screen = Vector2.zero,
		magnitude = 0,
		active = false,
	}
end

local function cloneThumbstickState(state: ThumbstickState): ThumbstickState
	return {
		key = state.key,
		raw = state.raw,
		screen = state.screen,
		magnitude = state.magnitude,
		active = state.active,
	}
end

local function cloneThumbstickSnapshot(snapshot: ThumbstickSnapshot): ThumbstickSnapshot
	return {
		left = cloneThumbstickState(snapshot.left),
		right = cloneThumbstickState(snapshot.right),
		dominant = snapshot.dominant,
		lastUpdatedAt = snapshot.lastUpdatedAt,
		stickDeadzone = snapshot.stickDeadzone,
		navigationDeadzone = snapshot.navigationDeadzone,
	}
end

local function normalizeThumbstickVector(vector: Vector2, deadzone: number): Vector2
	local magnitude = vector.Magnitude
	if magnitude <= deadzone or magnitude <= THUMBSTICK_ACTIVE_EPSILON then
		return Vector2.zero
	end
	local remappedMagnitude =
		math.clamp((magnitude - deadzone) / math.max(THUMBSTICK_ACTIVE_EPSILON, 1 - deadzone), 0, 1)
	return vector.Unit * remappedMagnitude
end

function GamepadNav.ResolveRemappedDeadzoneMagnitude(sourceDeadzoneRaw: any, targetDeadzoneRaw: any): number
	local sourceDeadzone = clampNumber(sourceDeadzoneRaw, DEFAULT_STICK_DEADZONE, 0, 1)
	local targetDeadzone = clampNumber(targetDeadzoneRaw, DEFAULT_NAVIGATION_DEADZONE, 0, 1)
	return math.clamp((targetDeadzone - sourceDeadzone) / math.max(THUMBSTICK_ACTIVE_EPSILON, 1 - sourceDeadzone), 0, 1)
end

local function resolveInputThumbstickVector(input: InputObject, deadzone: number): Vector2?
	local position = input.Position
	if typeof(position) ~= "Vector3" then
		return nil
	end
	return normalizeThumbstickVector(Vector2.new(position.X, position.Y), deadzone)
end

local function createThumbstickStateFromInput(
	key: ThumbstickKey,
	input: InputObject,
	deadzone: number
): ThumbstickState?
	local nextRaw = resolveInputThumbstickVector(input, deadzone)
	if nextRaw == nil then
		return nil
	end

	return {
		key = key,
		raw = nextRaw,
		screen = Vector2.new(nextRaw.X, -nextRaw.Y),
		magnitude = nextRaw.Magnitude,
		active = nextRaw.Magnitude > THUMBSTICK_ACTIVE_EPSILON,
	}
end

local function resolveDominantThumbstick(left: ThumbstickState, right: ThumbstickState): ThumbstickKey?
	if right.active then
		return "Right"
	end
	if left.active then
		return "Left"
	end
	return nil
end

local function thumbstickStatesEqual(a: ThumbstickState, b: ThumbstickState): boolean
	return a.key == b.key
		and a.active == b.active
		and math.abs(a.raw.X - b.raw.X) <= THUMBSTICK_ACTIVE_EPSILON
		and math.abs(a.raw.Y - b.raw.Y) <= THUMBSTICK_ACTIVE_EPSILON
		and math.abs(a.screen.X - b.screen.X) <= THUMBSTICK_ACTIVE_EPSILON
		and math.abs(a.screen.Y - b.screen.Y) <= THUMBSTICK_ACTIVE_EPSILON
		and math.abs(a.magnitude - b.magnitude) <= THUMBSTICK_ACTIVE_EPSILON
end

function GamepadNav.New(configRaw: GamepadNavConfig?): GamepadNav
	local config = if typeof(configRaw) == "table" then configRaw else {}
	local stickDeadzone = clampNumber(config.stickDeadzone, DEFAULT_STICK_DEADZONE, 0, 1)
	local navigationDeadzone = clampNumber(config.navigationDeadzone, DEFAULT_NAVIGATION_DEADZONE, 0, 1)
	local thumbstickSnapshot: ThumbstickSnapshot = {
		left = createThumbstickState("Left"),
		right = createThumbstickState("Right"),
		dominant = nil,
		lastUpdatedAt = 0,
		stickDeadzone = stickDeadzone,
		navigationDeadzone = navigationDeadzone,
	}
	local self = setmetatable({
		eventBus = config.eventBus,
		eventChannel = normalizeEventName(config.eventChannel, "gamepad.nav"),
		focusEvent = normalizeEventName(config.focusEvent, "focusChanged"),
		thumbstickEvent = normalizeEventName(config.thumbstickEvent, "thumbsticksChanged"),
		tooltipManager = config.tooltipManager,
		onActivate = if typeof(config.onActivate) == "function" then config.onActivate else nil,
		onBack = if typeof(config.onBack) == "function" then config.onBack else nil,
		externalFocusChanged = if typeof(config.onFocusChanged) == "function" then config.onFocusChanged else nil,
		moveRepeatCooldown = clampNumber(config.moveRepeatCooldown, DEFAULT_MOVE_REPEAT_COOLDOWN, 0.02, 1),
		stickDeadzone = stickDeadzone,
		navigationDeadzone = navigationDeadzone,
		navigationStickKeyCode = if typeof(config.navigationStickKeyCode) == "EnumItem"
				and config.navigationStickKeyCode.EnumType == Enum.KeyCode
			then config.navigationStickKeyCode
			else Enum.KeyCode.Thumbstick1,
		layouts = {} :: { [string]: LayoutRecord },
		layoutOrder = {} :: { string },
		activeLayoutKey = nil :: string?,
		activeIndex = 0,
		lastFocusedByLayout = {} :: { [string]: number },
		focusChangedSignal = Signal.new() :: FocusChangedSignal,
		thumbstickChangedSignal = Signal.new() :: ThumbstickChangedSignal,
		thumbstickSnapshot = thumbstickSnapshot,
		connections = {} :: { RBXScriptConnection? },
		isInitialized = false,
		isEnabled = true,
		lastMoveAt = 0,
		lastStickDirX = 0,
		lastStickDirY = 0,
	}, GamepadNav)
	return self
end

function GamepadNav._getActiveLayout(self: GamepadNav): LayoutRecord?
	local key = self.activeLayoutKey
	if key == nil then
		return nil
	end
	return self.layouts[key]
end

function GamepadNav._emitFocusChanged(self: GamepadNav, nextFocused: GuiObject?, prevFocused: GuiObject?)
	if self.externalFocusChanged ~= nil then
		self.externalFocusChanged(nextFocused, prevFocused)
	end
	self.focusChangedSignal:Fire(nextFocused, prevFocused)
	if
		self.tooltipManager ~= nil
		and typeof((self.tooltipManager :: any).hide) == "function"
		and nextFocused == nil
	then
		local tooltipManagerAny = self.tooltipManager :: any
		tooltipManagerAny:hide()
	end
	if self.eventBus ~= nil and typeof((self.eventBus :: any).publish) == "function" then
		local eventBusAny = self.eventBus :: any
		eventBusAny:publish(self.eventChannel, self.focusEvent, {
			layout = self.activeLayoutKey,
			index = self.activeIndex,
			focused = nextFocused,
			previous = prevFocused,
		})
	end
end

function GamepadNav._emitThumbstickChanged(self: GamepadNav)
	local snapshot = cloneThumbstickSnapshot(self.thumbstickSnapshot)
	self.thumbstickChangedSignal:Fire(snapshot)
	if self.eventBus ~= nil and typeof((self.eventBus :: any).publish) == "function" then
		local eventBusAny = self.eventBus :: any
		eventBusAny:publish(self.eventChannel, self.thumbstickEvent, snapshot)
	end
end

function GamepadNav._ensureVisibleInScroll(_self: GamepadNav, focused: GuiObject?)
	if focused == nil then
		return
	end
	local ancestor = focused.Parent
	while ancestor ~= nil do
		if ancestor:IsA("ScrollingFrame") then
			local scrollingFrame = ancestor
			local frameTop = scrollingFrame.AbsolutePosition.Y
			local frameBottom = frameTop + scrollingFrame.AbsoluteWindowSize.Y
			local focusedTop = focused.AbsolutePosition.Y
			local focusedBottom = focusedTop + focused.AbsoluteSize.Y
			local canvasY = scrollingFrame.CanvasPosition.Y

			if focusedTop < frameTop then
				canvasY -= (frameTop - focusedTop) + 4
			elseif focusedBottom > frameBottom then
				canvasY += (focusedBottom - frameBottom) + 4
			end

			scrollingFrame.CanvasPosition = Vector2.new(scrollingFrame.CanvasPosition.X, math.max(0, canvasY))
			return
		end
		ancestor = ancestor.Parent
	end
end

function GamepadNav._focusIndex(self: GamepadNav, indexRaw: any): boolean
	local layout = self:_getActiveLayout()
	if layout == nil then
		return false
	end
	local count = #layout.elements
	if count <= 0 then
		return false
	end
	local index = clampInteger(indexRaw, 1, 1, count)

	local candidate = layout.elements[index]
	if candidate == nil or not isSelectable(candidate) then
		local found = nil
		for step = 0, count - 1 do
			local probe = ((index + step - 1) % count) + 1
			local probeGui = layout.elements[probe]
			if probeGui ~= nil and isSelectable(probeGui) then
				found = probe
				break
			end
		end
		if found == nil then
			return false
		end
		index = found
		candidate = layout.elements[index]
	end

	local previous = GuiService.SelectedObject
	GuiService.SelectedObject = candidate
	self.activeIndex = index
	self.lastFocusedByLayout[layout.key] = index
	self:_ensureVisibleInScroll(candidate)
	self:_emitFocusChanged(candidate, previous)
	return true
end

function GamepadNav._moveLinear(self: GamepadNav, direction: NavDirection): boolean
	local layout = self:_getActiveLayout()
	if layout == nil then
		return false
	end
	local count = #layout.elements
	if count <= 0 then
		return false
	end
	local step = if direction == "Left" or direction == "Up" then -1 else 1
	local nextIndex = self.activeIndex + step
	if nextIndex < 1 then
		nextIndex = if layout.wrap then count else 1
	elseif nextIndex > count then
		nextIndex = if layout.wrap then 1 else count
	end
	return self:_focusIndex(nextIndex)
end

function GamepadNav._moveGrid(self: GamepadNav, direction: NavDirection): boolean
	local layout = self:_getActiveLayout()
	if layout == nil then
		return false
	end
	local count = #layout.elements
	if count <= 0 then
		return false
	end
	local columns = math.max(1, layout.columns)
	local index = if self.activeIndex > 0 then self.activeIndex else 1
	local row = math.floor((index - 1) / columns)
	local col = (index - 1) % columns

	if direction == "Left" then
		col -= 1
	elseif direction == "Right" then
		col += 1
	elseif direction == "Up" then
		row -= 1
	else
		row += 1
	end

	local maxRow = math.floor((count - 1) / columns)
	if layout.wrap then
		if col < 0 then
			col = columns - 1
		elseif col >= columns then
			col = 0
		end
		if row < 0 then
			row = maxRow
		elseif row > maxRow then
			row = 0
		end
	else
		col = math.clamp(col, 0, columns - 1)
		row = math.clamp(row, 0, maxRow)
	end

	local nextIndex = row * columns + col + 1
	if nextIndex > count then
		nextIndex = count
	end
	return self:_focusIndex(nextIndex)
end

function GamepadNav._move(self: GamepadNav, direction: NavDirection): boolean
	local now = os.clock()
	if now - self.lastMoveAt < self.moveRepeatCooldown then
		return false
	end
	self.lastMoveAt = now
	local layout = self:_getActiveLayout()
	if layout == nil then
		return false
	end
	if layout.mode == "Grid" then
		return self:_moveGrid(direction)
	end
	return self:_moveLinear(direction)
end

function GamepadNav._handleThumbstick(self: GamepadNav, vector: Vector2)
	local x = vector.X
	local y = vector.Y
	local absX = math.abs(x)
	local absY = math.abs(y)
	if absX <= 1e-4 and absY <= 1e-4 then
		self.lastStickDirX = 0
		self.lastStickDirY = 0
		return
	end

	if absX >= absY then
		local dir = if x > 0 then 1 else -1
		if self.lastStickDirX ~= dir then
			self.lastStickDirX = dir
			self.lastStickDirY = 0
			self:_move(if dir > 0 then "Right" else "Left")
		end
	else
		local dir = if y > 0 then 1 else -1
		if self.lastStickDirY ~= dir then
			self.lastStickDirY = dir
			self.lastStickDirX = 0
			self:_move(if dir > 0 then "Down" else "Up")
		end
	end
end

function GamepadNav._setThumbstickSnapshot(
	self: GamepadNav,
	nextLeft: ThumbstickState,
	nextRight: ThumbstickState
): boolean
	local nextDominant = resolveDominantThumbstick(nextLeft, nextRight)
	if
		thumbstickStatesEqual(self.thumbstickSnapshot.left, nextLeft)
		and thumbstickStatesEqual(self.thumbstickSnapshot.right, nextRight)
		and self.thumbstickSnapshot.dominant == nextDominant
	then
		return false
	end

	self.thumbstickSnapshot.left = nextLeft
	self.thumbstickSnapshot.right = nextRight
	self.thumbstickSnapshot.dominant = nextDominant
	self.thumbstickSnapshot.lastUpdatedAt = os.clock()
	self.thumbstickSnapshot.stickDeadzone = self.stickDeadzone
	self.thumbstickSnapshot.navigationDeadzone = self.navigationDeadzone
	self:_emitThumbstickChanged()
	return true
end

function GamepadNav._setThumbstickState(self: GamepadNav, key: ThumbstickKey, nextState: ThumbstickState): boolean
	local currentLeft = self.thumbstickSnapshot.left
	local currentRight = self.thumbstickSnapshot.right
	local nextLeft = if key == "Left" then nextState else currentLeft
	local nextRight = if key == "Right" then nextState else currentRight
	return self:_setThumbstickSnapshot(nextLeft, nextRight)
end

function GamepadNav._updateThumbstick(self: GamepadNav, key: ThumbstickKey, input: InputObject)
	local nextState = createThumbstickStateFromInput(key, input, self.stickDeadzone)
	if nextState == nil then
		return
	end

	self:_setThumbstickState(key, nextState)
end

function GamepadNav._refreshThumbsticks(self: GamepadNav, gamepadType: Enum.UserInputType): boolean
	local ok, gamepadState = pcall(function()
		return UserInputService:GetGamepadState(gamepadType)
	end)
	if not ok or typeof(gamepadState) ~= "table" then
		return false
	end

	local nextLeft = createThumbstickState("Left")
	local nextRight = createThumbstickState("Right")
	local foundThumbstick = false
	for _, inputRaw in gamepadState do
		local input = if typeof(inputRaw) == "InputObject" then inputRaw :: InputObject else nil
		if input == nil then
			continue
		end
		if input.KeyCode == Enum.KeyCode.Thumbstick1 then
			local nextState = createThumbstickStateFromInput("Left", input, self.stickDeadzone)
			if nextState ~= nil then
				nextLeft = nextState
				foundThumbstick = true
			end
		elseif input.KeyCode == Enum.KeyCode.Thumbstick2 then
			local nextState = createThumbstickStateFromInput("Right", input, self.stickDeadzone)
			if nextState ~= nil then
				nextRight = nextState
				foundThumbstick = true
			end
		end
	end

	if not foundThumbstick then
		return false
	end
	self:_setThumbstickSnapshot(nextLeft, nextRight)
	return true
end

function GamepadNav._getNavigationVector(self: GamepadNav, input: InputObject): Vector2
	return resolveInputThumbstickVector(input, self.navigationDeadzone) or Vector2.zero
end

function GamepadNav._resetThumbstick(self: GamepadNav, key: ThumbstickKey)
	self:_setThumbstickState(key, createThumbstickState(key))
end

function GamepadNav._onInputBegan(self: GamepadNav, input: InputObject, gameProcessed: boolean)
	if gameProcessed or not self.isEnabled then
		return
	end
	if not isGamepadInput(input.UserInputType) then
		return
	end

	if input.KeyCode == Enum.KeyCode.DPadUp then
		self:_move("Up")
	elseif input.KeyCode == Enum.KeyCode.DPadDown then
		self:_move("Down")
	elseif input.KeyCode == Enum.KeyCode.DPadLeft then
		self:_move("Left")
	elseif input.KeyCode == Enum.KeyCode.DPadRight then
		self:_move("Right")
	elseif input.KeyCode == Enum.KeyCode.ButtonA then
		if GuiService:GetAttribute(GAMEPAD_CURSOR_ACTIVE_ATTRIBUTE) == true then
			return
		end
		local focused = GuiService.SelectedObject
		if focused ~= nil and focused:IsA("GuiButton") then
			focused:Activate()
		elseif self.onActivate ~= nil then
			self.onActivate(focused)
		end
	elseif input.KeyCode == Enum.KeyCode.ButtonB then
		if self.onBack ~= nil then
			self.onBack()
		end
	end
end

function GamepadNav._onInputChanged(self: GamepadNav, input: InputObject)
	if not self.isEnabled then
		return
	end
	if not isGamepadInput(input.UserInputType) then
		return
	end
	if input.KeyCode == Enum.KeyCode.Thumbstick1 then
		if not self:_refreshThumbsticks(input.UserInputType) then
			self:_updateThumbstick("Left", input)
		end
		if self.navigationStickKeyCode == Enum.KeyCode.Thumbstick1 then
			self:_handleThumbstick(self:_getNavigationVector(input))
		end
	elseif input.KeyCode == Enum.KeyCode.Thumbstick2 then
		if not self:_refreshThumbsticks(input.UserInputType) then
			self:_updateThumbstick("Right", input)
		end
		if self.navigationStickKeyCode == Enum.KeyCode.Thumbstick2 then
			self:_handleThumbstick(self:_getNavigationVector(input))
		end
	end
end

function GamepadNav._onInputEnded(self: GamepadNav, input: InputObject)
	if not self.isEnabled then
		return
	end
	if not isGamepadInput(input.UserInputType) then
		return
	end
	if input.KeyCode == Enum.KeyCode.Thumbstick1 then
		if not self:_refreshThumbsticks(input.UserInputType) then
			self:_resetThumbstick("Left")
		end
		if self.navigationStickKeyCode == Enum.KeyCode.Thumbstick1 then
			self:_handleThumbstick(Vector2.zero)
		end
	elseif input.KeyCode == Enum.KeyCode.Thumbstick2 then
		if not self:_refreshThumbsticks(input.UserInputType) then
			self:_resetThumbstick("Right")
		end
		if self.navigationStickKeyCode == Enum.KeyCode.Thumbstick2 then
			self:_handleThumbstick(Vector2.zero)
		end
	end
end

function GamepadNav.Init(self: GamepadNav)
	if self.isInitialized then
		return
	end
	self.isInitialized = true
	self.connections[#self.connections + 1] = UserInputService.InputBegan:Connect(
		function(input: InputObject, gameProcessed: boolean)
			self:_onInputBegan(input, gameProcessed)
		end
	)
	self.connections[#self.connections + 1] = UserInputService.InputChanged:Connect(function(input: InputObject)
		self:_onInputChanged(input)
	end)
	self.connections[#self.connections + 1] = UserInputService.InputEnded:Connect(function(input: InputObject)
		self:_onInputEnded(input)
	end)
end

function GamepadNav.RegisterLayout(self: GamepadNav, keyRaw: any, elementsRaw: any, configRaw: LayoutConfig?): boolean
	if typeof(keyRaw) ~= "string" or keyRaw == "" then
		return false
	end
	if typeof(elementsRaw) ~= "table" then
		return false
	end
	local elements = {}
	for index = 1, #elementsRaw do
		local item = elementsRaw[index]
		if typeof(item) == "Instance" and item:IsA("GuiObject") then
			elements[#elements + 1] = item
		end
	end
	if #elements == 0 then
		return false
	end
	local config = if typeof(configRaw) == "table" then configRaw else {}
	local record: LayoutRecord = {
		key = keyRaw,
		elements = elements,
		mode = if config.mode == "Grid" then "Grid" else "Linear",
		columns = clampInteger(config.columns, 1, 1, 32),
		wrap = if config.wrap == nil then true else config.wrap == true,
	}
	if self.layouts[keyRaw] == nil then
		self.layoutOrder[#self.layoutOrder + 1] = keyRaw
	end
	self.layouts[keyRaw] = record
	return true
end

function GamepadNav.UnregisterLayout(self: GamepadNav, keyRaw: any): boolean
	if typeof(keyRaw) ~= "string" then
		return false
	end
	if self.layouts[keyRaw] == nil then
		return false
	end
	self.layouts[keyRaw] = nil
	for index = #self.layoutOrder, 1, -1 do
		if self.layoutOrder[index] == keyRaw then
			table.remove(self.layoutOrder, index)
			break
		end
	end
	if self.activeLayoutKey == keyRaw then
		self.activeLayoutKey = nil
		self.activeIndex = 0
		GuiService.SelectedObject = nil
	end
	return true
end

function GamepadNav.SetLayout(self: GamepadNav, keyRaw: any, restoreRaw: any?): boolean
	if typeof(keyRaw) ~= "string" then
		return false
	end
	local layout = self.layouts[keyRaw]
	if layout == nil then
		return false
	end
	self.activeLayoutKey = keyRaw
	local restore = if restoreRaw == nil then true else restoreRaw == true
	local startIndex = if restore then (self.lastFocusedByLayout[keyRaw] or 1) else 1
	return self:_focusIndex(startIndex)
end

function GamepadNav.GetActiveElements(self: GamepadNav): { GuiObject }
	local layout = self:_getActiveLayout()
	if layout == nil then
		return {}
	end
	return Sift.Dictionary.copy(layout.elements)
end

function GamepadNav.GetFocused(_self: GamepadNav): GuiObject?
	return GuiService.SelectedObject
end

function GamepadNav.Move(self: GamepadNav, directionRaw: any): boolean
	if typeof(directionRaw) ~= "string" then
		return false
	end
	local direction = directionRaw :: NavDirection
	if direction ~= "Up" and direction ~= "Down" and direction ~= "Left" and direction ~= "Right" then
		return false
	end
	return self:_move(direction)
end

function GamepadNav.FocusIndex(self: GamepadNav, indexRaw: any): boolean
	return self:_focusIndex(indexRaw)
end

function GamepadNav.OnFocusChanged(self: GamepadNav, callbackRaw: any): () -> ()
	if typeof(callbackRaw) ~= "function" then
		return function() end
	end
	local connection = self.focusChangedSignal:Connect(callbackRaw :: FocusCallback)
	return function()
		connection:Disconnect()
	end
end

function GamepadNav.GetThumbstickState(self: GamepadNav): ThumbstickSnapshot
	return cloneThumbstickSnapshot(self.thumbstickSnapshot)
end

function GamepadNav.OnThumbstickChanged(self: GamepadNav, callbackRaw: any): () -> ()
	if typeof(callbackRaw) ~= "function" then
		return function() end
	end
	local connection = self.thumbstickChangedSignal:Connect(callbackRaw :: ThumbstickChangedCallback)
	return function()
		connection:Disconnect()
	end
end

function GamepadNav.SetEnabled(self: GamepadNav, enabledRaw: any)
	self.isEnabled = enabledRaw == true
	if not self.isEnabled then
		GuiService.SelectedObject = nil
	end
end

function GamepadNav.Destroy(self: GamepadNav)
	for index = #self.connections, 1, -1 do
		safeDisconnect(self.connections[index])
		self.connections[index] = nil
	end
	table.clear(self.layouts)
	table.clear(self.layoutOrder)
	table.clear(self.lastFocusedByLayout)
	self.focusChangedSignal:DisconnectAll()
	self.focusChangedSignal:Destroy()
	self.thumbstickChangedSignal:DisconnectAll()
	self.thumbstickChangedSignal:Destroy()
	self.activeLayoutKey = nil
	self.activeIndex = 0
	self.isInitialized = false
end

GamepadNav.RegisterLayout = GamepadNav.RegisterLayout
GamepadNav.UnregisterLayout = GamepadNav.UnregisterLayout
GamepadNav.SetLayout = GamepadNav.SetLayout
GamepadNav.GetActiveElements = GamepadNav.GetActiveElements
GamepadNav.GetFocused = GamepadNav.GetFocused
GamepadNav.Move = GamepadNav.Move
GamepadNav.FocusIndex = GamepadNav.FocusIndex
GamepadNav.OnFocusChanged = GamepadNav.OnFocusChanged
GamepadNav.GetThumbstickState = GamepadNav.GetThumbstickState
GamepadNav.OnThumbstickChanged = GamepadNav.OnThumbstickChanged
GamepadNav.ResolveRemappedDeadzoneMagnitude = GamepadNav.ResolveRemappedDeadzoneMagnitude
GamepadNav.SetEnabled = GamepadNav.SetEnabled
GamepadNav.Init = GamepadNav.Init
GamepadNav.Destroy = GamepadNav.Destroy

GamepadNav.new = GamepadNav.New
GamepadNav.init = GamepadNav.Init
GamepadNav.registerLayout = GamepadNav.RegisterLayout
GamepadNav.unregisterLayout = GamepadNav.UnregisterLayout
GamepadNav.setLayout = GamepadNav.SetLayout
GamepadNav.getActiveElements = GamepadNav.GetActiveElements
GamepadNav.getFocused = GamepadNav.GetFocused
GamepadNav.move = GamepadNav.Move
GamepadNav.focusIndex = GamepadNav.FocusIndex
GamepadNav.onFocusChanged = GamepadNav.OnFocusChanged
GamepadNav.getThumbstickState = GamepadNav.GetThumbstickState
GamepadNav.onThumbstickChanged = GamepadNav.OnThumbstickChanged
GamepadNav.resolveRemappedDeadzoneMagnitude = GamepadNav.ResolveRemappedDeadzoneMagnitude
GamepadNav.setEnabled = GamepadNav.SetEnabled
GamepadNav.destroy = GamepadNav.Destroy

return GamepadNav
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="1266">
                <Properties>
                  <string name="Name">GamepadPointer</string>
                  <string name="Source"><![CDATA[--!strict
local Workspace = game:GetService("Workspace")

local GamepadPointer = {}

GamepadPointer.DEFAULT_TILE_SIZE_STUDS = 2
GamepadPointer.WORLD_REACH_TILES = 5

export type PointerOwner = "Left" | "Right"

local WORLD_PLANE_EPSILON = 1e-4

local function sanitizeTileSizeStuds(tileSizeStudsRaw: any): number
	local tileSizeStuds = if typeof(tileSizeStudsRaw) == "number" and tileSizeStudsRaw == tileSizeStudsRaw
		then tileSizeStudsRaw
		else GamepadPointer.DEFAULT_TILE_SIZE_STUDS
	return math.max(0.25, tileSizeStuds)
end

local function resolveViewportOffset(camera: Camera, origin: Vector3, worldOffset: Vector3): Vector2
	local originViewportPosition = camera:WorldToViewportPoint(origin)
	local targetViewportPosition = camera:WorldToViewportPoint(origin + worldOffset)
	return Vector2.new(
		targetViewportPosition.X - originViewportPosition.X,
		targetViewportPosition.Y - originViewportPosition.Y
	)
end

local function resolveRootPart(rootPartRaw: any): BasePart?
	return if typeof(rootPartRaw) == "Instance" and rootPartRaw:IsA("BasePart") then rootPartRaw :: BasePart else nil
end

local function resolveStickVector(snapshot: any, key: PointerOwner): (Vector2?, boolean)
	if typeof(snapshot) ~= "table" then
		return nil, false
	end

	local source = if key == "Right" then (snapshot :: any).right else (snapshot :: any).left
	if typeof(source) ~= "table" then
		return nil, false
	end

	local screenVector = nil :: Vector2?
	if typeof((source :: any).screen) == "Vector2" then
		screenVector = (source :: any).screen
	elseif typeof((source :: any).raw) == "Vector2" then
		local rawVector = (source :: any).raw :: Vector2
		screenVector = Vector2.new(rawVector.X, -rawVector.Y)
	end

	if screenVector == nil then
		return nil, false
	end

	local isActive = (source :: any).active == true and screenVector.Magnitude > WORLD_PLANE_EPSILON
	return screenVector, isActive
end

function GamepadPointer.ResolveOwnedVector(snapshotRaw: any): (Vector2?, PointerOwner?)
	local rightVector, rightActive = resolveStickVector(snapshotRaw, "Right")
	if rightActive and rightVector ~= nil then
		return rightVector, "Right"
	end

	local leftVector, leftActive = resolveStickVector(snapshotRaw, "Left")
	if leftActive and leftVector ~= nil then
		return leftVector, "Left"
	end

	return nil, nil
end

function GamepadPointer.ResolveReachStuds(tileSizeStudsRaw: any): number
	return sanitizeTileSizeStuds(tileSizeStudsRaw) * GamepadPointer.WORLD_REACH_TILES
end

function GamepadPointer.ResolveWorldOffset(vectorRaw: any, tileSizeStudsRaw: any): Vector3?
	if typeof(vectorRaw) ~= "Vector2" then
		return nil
	end
	local vector = vectorRaw :: Vector2
	if vector.Magnitude <= WORLD_PLANE_EPSILON then
		return nil
	end

	local reachStuds = GamepadPointer.ResolveReachStuds(tileSizeStudsRaw)
	return Vector3.new(0, -vector.Y * reachStuds, -vector.X * reachStuds)
end

function GamepadPointer.ResolveWorldOffsetForScreenVector(
	vectorRaw: any,
	tileSizeStudsRaw: any,
	rootPartRaw: any?
): Vector3?
	if typeof(vectorRaw) ~= "Vector2" then
		return nil
	end

	local vector = vectorRaw :: Vector2
	local magnitude = vector.Magnitude
	if magnitude <= WORLD_PLANE_EPSILON then
		return nil
	end

	local rootPart = resolveRootPart(rootPartRaw)
	local camera = Workspace.CurrentCamera
	if rootPart == nil or camera == nil then
		return GamepadPointer.ResolveWorldOffset(vector, tileSizeStudsRaw)
	end

	local origin = rootPart.Position
	local zScreenAxis = resolveViewportOffset(camera, origin, Vector3.zAxis)
	local yScreenAxis = resolveViewportOffset(camera, origin, Vector3.yAxis)
	local determinant = zScreenAxis.X * yScreenAxis.Y - yScreenAxis.X * zScreenAxis.Y
	if math.abs(determinant) <= WORLD_PLANE_EPSILON then
		return GamepadPointer.ResolveWorldOffset(vector, tileSizeStudsRaw)
	end

	local desiredScreenDirection = vector.Unit
	local zCoefficient = (desiredScreenDirection.X * yScreenAxis.Y - yScreenAxis.X * desiredScreenDirection.Y)
		/ determinant
	local yCoefficient = (zScreenAxis.X * desiredScreenDirection.Y - desiredScreenDirection.X * zScreenAxis.Y)
		/ determinant
	local worldDirection = Vector3.new(0, yCoefficient, zCoefficient)
	if worldDirection.Magnitude <= WORLD_PLANE_EPSILON then
		return GamepadPointer.ResolveWorldOffset(vector, tileSizeStudsRaw)
	end

	return worldDirection.Unit * GamepadPointer.ResolveReachStuds(tileSizeStudsRaw) * math.clamp(magnitude, 0, 1)
end

GamepadPointer.resolveOwnedVector = GamepadPointer.ResolveOwnedVector
GamepadPointer.resolveReachStuds = GamepadPointer.ResolveReachStuds
GamepadPointer.resolveWorldOffset = GamepadPointer.ResolveWorldOffset
GamepadPointer.resolveWorldOffsetForScreenVector = GamepadPointer.ResolveWorldOffsetForScreenVector

return GamepadPointer
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="1267">
                <Properties>
                  <string name="Name">Gestures</string>
                  <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Signal = require(ReplicatedStorage.Packages.Signal)

local Gestures = {}
Gestures.__index = Gestures

export type GestureType =
	"Tap"
	| "DoubleTap"
	| "LongPress"
	| "DragStart"
	| "Drag"
	| "DragEnd"
	| "Swipe"
	| "PinchStart"
	| "Pinch"
	| "PinchEnd"

export type GesturePayload = {
	gesture: GestureType,
	position: Vector2?,
	startPosition: Vector2?,
	delta: Vector2?,
	duration: number?,
	target: GuiObject?,
	direction: string?,
	scale: number?,
	center: Vector2?,
}

export type GestureCallback = (payload: GesturePayload) -> ()

export type GesturesConfig = {
	eventBus: any?,
	eventChannel: string?,
	tickScheduler: any?,
	tapMaxDuration: number?,
	doubleTapWindow: number?,
	longPressTime: number?,
	dragThreshold: number?,
	swipeMinDistance: number?,
	swipeMaxDuration: number?,
	pinchThreshold: number?,
}

type TouchState = {
	input: InputObject?,
	startPos: Vector2,
	lastPos: Vector2,
	startTime: number,
	lastTime: number,
	movedDistance: number,
	dragging: boolean,
	longPressTriggered: boolean,
	pinchLocked: boolean,
	longPressCancel: (() -> ())?,
	target: GuiObject?,
}

export type Gestures = typeof(setmetatable({} :: any, Gestures))

type SignalConnection = {
	Disconnect: (self: SignalConnection) -> (),
}

type GestureSignal = {
	Connect: (self: GestureSignal, callback: GestureCallback) -> SignalConnection,
	Fire: (self: GestureSignal, payload: GesturePayload) -> (),
	DisconnectAll: (self: GestureSignal) -> (),
	Destroy: (self: GestureSignal) -> (),
}

local function clampNumber(valueRaw: any, fallback: number, minValue: number, maxValue: number): number
	local value = if typeof(valueRaw) == "number" then valueRaw else fallback
	if value < minValue then
		return minValue
	end
	if value > maxValue then
		return maxValue
	end
	return value
end

local function normalizeEventName(valueRaw: any, fallback: string): string
	if typeof(valueRaw) == "string" and valueRaw ~= "" then
		return valueRaw
	end
	return fallback
end

local function safeDisconnect(connection: RBXScriptConnection?)
	if connection == nil then
		return
	end
	connection:Disconnect()
end

local function vectorDistance(a: Vector2, b: Vector2): number
	local dx = a.X - b.X
	local dy = a.Y - b.Y
	return math.sqrt(dx * dx + dy * dy)
end

local function getSwipeDirection(delta: Vector2): string
	local absX = math.abs(delta.X)
	local absY = math.abs(delta.Y)
	if absX >= absY then
		return if delta.X >= 0 then "Right" else "Left"
	end
	return if delta.Y >= 0 then "Down" else "Up"
end

local function resolveInputTarget(input: InputObject): GuiObject?
	local ok, targetRaw = pcall(function()
		return (input :: any).Target
	end)
	if not ok or typeof(targetRaw) ~= "Instance" then
		return nil
	end
	local target = targetRaw :: Instance
	if not target:IsA("GuiObject") then
		return nil
	end
	return target :: GuiObject
end

local function clearTouchState(state: TouchState)
	state.input = nil
	state.startPos = Vector2.zero
	state.lastPos = Vector2.zero
	state.startTime = 0
	state.lastTime = 0
	state.movedDistance = 0
	state.dragging = false
	state.longPressTriggered = false
	state.pinchLocked = false
	state.longPressCancel = nil
	state.target = nil
end

function Gestures.New(configRaw: GesturesConfig?): Gestures
	local config = if typeof(configRaw) == "table" then configRaw else {}
	local self = setmetatable({
		eventBus = config.eventBus,
		eventChannel = normalizeEventName(config.eventChannel, "gestures"),
		tickScheduler = config.tickScheduler,
		tapMaxDuration = clampNumber(config.tapMaxDuration, 0.24, 0.05, 2),
		doubleTapWindow = clampNumber(config.doubleTapWindow, 0.28, 0.05, 2),
		longPressTime = clampNumber(config.longPressTime, 0.45, 0.1, 5),
		dragThreshold = clampNumber(config.dragThreshold, 10, 1, 250),
		swipeMinDistance = clampNumber(config.swipeMinDistance, 64, 8, 1000),
		swipeMaxDuration = clampNumber(config.swipeMaxDuration, 0.45, 0.05, 2),
		pinchThreshold = clampNumber(config.pinchThreshold, 0.02, 0.001, 1),
		touches = {} :: { [InputObject]: TouchState },
		activeTouchCount = 0,
		touchPool = {} :: { TouchState },
		signalsByGesture = {} :: { [string]: GestureSignal },
		connections = {} :: { RBXScriptConnection? },
		isInitialized = false,
		isEnabled = true,
		lastTapTime = 0,
		lastTapPos = Vector2.zero,
		pendingTapToken = nil :: (() -> ())?,
		pinchTouchA = nil :: InputObject?,
		pinchTouchB = nil :: InputObject?,
		pinchInitialDistance = 0,
		pinchActive = false,
	}, Gestures)
	return self
end

function Gestures._getSignal(self: Gestures, gesture: string): GestureSignal
	local signal = self.signalsByGesture[gesture]
	if signal ~= nil then
		return signal
	end
	signal = Signal.new() :: GestureSignal
	self.signalsByGesture[gesture] = signal
	return signal
end

function Gestures._acquireTouchState(self: Gestures): TouchState
	local pooled = table.remove(self.touchPool)
	if pooled ~= nil then
		return pooled
	end
	return {
		input = nil,
		startPos = Vector2.zero,
		lastPos = Vector2.zero,
		startTime = 0,
		lastTime = 0,
		movedDistance = 0,
		dragging = false,
		longPressTriggered = false,
		pinchLocked = false,
		longPressCancel = nil,
		target = nil,
	}
end

function Gestures._releaseTouchState(self: Gestures, state: TouchState)
	clearTouchState(state)
	if #self.touchPool < 32 then
		self.touchPool[#self.touchPool + 1] = state
	end
end

function Gestures._emit(self: Gestures, gesture: GestureType, payload: GesturePayload)
	local signal = self.signalsByGesture[gesture]
	if signal ~= nil then
		signal:Fire(payload)
	end
	if self.eventBus ~= nil and typeof((self.eventBus :: any).publish) == "function" then
		local eventBusAny = self.eventBus :: any
		eventBusAny:publish(self.eventChannel, gesture, payload)
	end
end

function Gestures._scheduleLongPress(self: Gestures, input: InputObject, state: TouchState)
	local function fireLongPress()
		local runtimeState = self.touches[input]
		if runtimeState == nil then
			return
		end
		if runtimeState.longPressTriggered then
			return
		end
		if runtimeState.pinchLocked then
			return
		end
		if runtimeState.movedDistance > self.dragThreshold then
			return
		end
		runtimeState.longPressTriggered = true
		self:_emit("LongPress", {
			gesture = "LongPress",
			position = runtimeState.lastPos,
			startPosition = runtimeState.startPos,
			duration = os.clock() - runtimeState.startTime,
			target = runtimeState.target,
		})
	end

	if self.tickScheduler ~= nil and typeof((self.tickScheduler :: any).schedule) == "function" then
		local token = (self.tickScheduler :: any):schedule(
			function()
				fireLongPress()
			end,
			self.longPressTime,
			{
				group = "gestures.longpress",
				priority = 200,
			}
		)
		state.longPressCancel = function()
			if typeof(token.cancel) == "function" then
				token:cancel()
			elseif typeof((self.tickScheduler :: any).cancel) == "function" then
				local schedulerAny = self.tickScheduler :: any
				schedulerAny:cancel(token)
			end
		end
		return
	end

	local cancelled = false
	state.longPressCancel = function()
		cancelled = true
	end
	task.delay(self.longPressTime, function()
		if cancelled then
			return
		end
		fireLongPress()
	end)
end

function Gestures._activeTouches(self: Gestures): (InputObject?, InputObject?)
	local first: InputObject? = nil
	local second: InputObject? = nil
	for input in self.touches do
		if first == nil then
			first = input
		elseif second == nil then
			second = input
			break
		end
	end
	return first, second
end

function Gestures._enterPinch(self: Gestures, inputA: InputObject, inputB: InputObject)
	local stateA = self.touches[inputA]
	local stateB = self.touches[inputB]
	if stateA == nil or stateB == nil then
		return
	end
	stateA.pinchLocked = true
	stateB.pinchLocked = true
	self.pinchTouchA = inputA
	self.pinchTouchB = inputB
	self.pinchInitialDistance = vectorDistance(stateA.lastPos, stateB.lastPos)
	self.pinchActive = true
	self:_emit("PinchStart", {
		gesture = "PinchStart",
		center = (stateA.lastPos + stateB.lastPos) * 0.5,
		scale = 1,
	})
end

function Gestures._updatePinch(self: Gestures)
	if not self.pinchActive then
		return
	end
	local inputA = self.pinchTouchA
	local inputB = self.pinchTouchB
	if inputA == nil or inputB == nil then
		return
	end
	local stateA = self.touches[inputA]
	local stateB = self.touches[inputB]
	if stateA == nil or stateB == nil then
		return
	end
	local currentDistance = vectorDistance(stateA.lastPos, stateB.lastPos)
	if self.pinchInitialDistance <= 0 then
		self.pinchInitialDistance = currentDistance
		return
	end
	local scale = currentDistance / self.pinchInitialDistance
	if math.abs(scale - 1) < self.pinchThreshold then
		return
	end
	self:_emit("Pinch", {
		gesture = "Pinch",
		center = (stateA.lastPos + stateB.lastPos) * 0.5,
		scale = scale,
	})
end

function Gestures._exitPinch(self: Gestures)
	if not self.pinchActive then
		return
	end
	self.pinchActive = false
	self.pinchTouchA = nil
	self.pinchTouchB = nil
	self.pinchInitialDistance = 0
	self:_emit("PinchEnd", {
		gesture = "PinchEnd",
	})
end

function Gestures._beginTouch(self: Gestures, input: InputObject)
	local state = self:_acquireTouchState()
	state.input = input
	state.startPos = input.Position
	state.lastPos = input.Position
	state.startTime = os.clock()
	state.lastTime = state.startTime
	state.target = resolveInputTarget(input)

	self.touches[input] = state
	self.activeTouchCount += 1
	self:_scheduleLongPress(input, state)

	if self.activeTouchCount == 2 then
		local a, b = self:_activeTouches()
		if a ~= nil and b ~= nil then
			self:_enterPinch(a, b)
		end
	end
end

function Gestures._changeTouch(self: Gestures, input: InputObject)
	local state = self.touches[input]
	if state == nil then
		return
	end
	local current = input.Position
	local delta = current - state.lastPos
	state.movedDistance += delta.Magnitude
	state.lastPos = current
	state.lastTime = os.clock()

	if self.pinchActive then
		self:_updatePinch()
		return
	end
	if state.pinchLocked then
		return
	end

	if not state.dragging and vectorDistance(state.startPos, current) >= self.dragThreshold then
		state.dragging = true
		self:_emit("DragStart", {
			gesture = "DragStart",
			position = current,
			startPosition = state.startPos,
			delta = delta,
			target = state.target,
		})
	end
	if state.dragging then
		self:_emit("Drag", {
			gesture = "Drag",
			position = current,
			startPosition = state.startPos,
			delta = delta,
			duration = state.lastTime - state.startTime,
			target = state.target,
		})
	end
end

function Gestures._scheduleTapEmit(self: Gestures, payload: GesturePayload)
	if self.pendingTapToken ~= nil then
		self.pendingTapToken()
		self.pendingTapToken = nil
	end
	if self.tickScheduler ~= nil and typeof((self.tickScheduler :: any).schedule) == "function" then
		local cancelled = false
		local token = (self.tickScheduler :: any):schedule(
			function()
				if cancelled then
					return
				end
				self:_emit("Tap", payload)
			end,
			self.doubleTapWindow,
			{
				group = "gestures.tap",
				priority = 150,
			}
		)
		self.pendingTapToken = function()
			cancelled = true
			if typeof(token.cancel) == "function" then
				token:cancel()
			elseif typeof((self.tickScheduler :: any).cancel) == "function" then
				local schedulerAny = self.tickScheduler :: any
				schedulerAny:cancel(token)
			end
		end
		return
	end
	local cancelled = false
	self.pendingTapToken = function()
		cancelled = true
	end
	task.delay(self.doubleTapWindow, function()
		if cancelled then
			return
		end
		self:_emit("Tap", payload)
	end)
end

function Gestures._endTouch(self: Gestures, input: InputObject)
	local state = self.touches[input]
	if state == nil then
		return
	end
	local now = os.clock()
	local duration = now - state.startTime
	local delta = state.lastPos - state.startPos
	local distance = delta.Magnitude

	if state.longPressCancel ~= nil then
		state.longPressCancel()
	end

	if self.pinchActive and (input == self.pinchTouchA or input == self.pinchTouchB) then
		self:_exitPinch()
	end

	if state.dragging then
		self:_emit("DragEnd", {
			gesture = "DragEnd",
			position = state.lastPos,
			startPosition = state.startPos,
			delta = delta,
			duration = duration,
			target = state.target,
		})
	end

	if (not state.pinchLocked) and not state.longPressTriggered then
		if duration <= self.swipeMaxDuration and distance >= self.swipeMinDistance then
			self:_emit("Swipe", {
				gesture = "Swipe",
				position = state.lastPos,
				startPosition = state.startPos,
				delta = delta,
				duration = duration,
				direction = getSwipeDirection(delta),
				target = state.target,
			})
		elseif duration <= self.tapMaxDuration and distance <= self.dragThreshold then
			local isDoubleTap = (now - self.lastTapTime) <= self.doubleTapWindow
				and vectorDistance(self.lastTapPos, state.lastPos) <= (self.dragThreshold * 1.5)
			if isDoubleTap then
				if self.pendingTapToken ~= nil then
					self.pendingTapToken()
					self.pendingTapToken = nil
				end
				self:_emit("DoubleTap", {
					gesture = "DoubleTap",
					position = state.lastPos,
					startPosition = state.startPos,
					duration = duration,
					target = state.target,
				})
				self.lastTapTime = 0
			else
				self.lastTapTime = now
				self.lastTapPos = state.lastPos
				self:_scheduleTapEmit({
					gesture = "Tap",
					position = state.lastPos,
					startPosition = state.startPos,
					duration = duration,
					target = state.target,
				})
			end
		end
	end

	self.touches[input] = nil
	self.activeTouchCount -= 1
	self:_releaseTouchState(state)
end

function Gestures._onInputBegan(self: Gestures, input: InputObject)
	if not self.isEnabled then
		return
	end
	if input.UserInputType ~= Enum.UserInputType.Touch then
		return
	end
	self:_beginTouch(input)
end

function Gestures._onInputChanged(self: Gestures, input: InputObject)
	if not self.isEnabled then
		return
	end
	if input.UserInputType ~= Enum.UserInputType.Touch then
		return
	end
	self:_changeTouch(input)
end

function Gestures._onInputEnded(self: Gestures, input: InputObject)
	if input.UserInputType ~= Enum.UserInputType.Touch then
		return
	end
	self:_endTouch(input)
end

function Gestures.Init(self: Gestures)
	if self.isInitialized then
		return
	end
	self.isInitialized = true
	self.connections[#self.connections + 1] = UserInputService.InputBegan:Connect(function(input: InputObject)
		self:_onInputBegan(input)
	end)
	self.connections[#self.connections + 1] = UserInputService.InputChanged:Connect(function(input: InputObject)
		self:_onInputChanged(input)
	end)
	self.connections[#self.connections + 1] = UserInputService.InputEnded:Connect(function(input: InputObject)
		self:_onInputEnded(input)
	end)
end

function Gestures.Bind(self: Gestures, gestureRaw: any, callbackRaw: any): () -> ()
	if typeof(gestureRaw) ~= "string" or gestureRaw == "" then
		return function() end
	end
	if typeof(callbackRaw) ~= "function" then
		return function() end
	end
	local gesture = gestureRaw :: string
	local connection = self:_getSignal(gesture):Connect(callbackRaw :: GestureCallback)
	return function()
		connection:Disconnect()
	end
end

function Gestures.SetEnabled(self: Gestures, enabledRaw: any)
	self.isEnabled = enabledRaw == true
end

function Gestures.Destroy(self: Gestures)
	if self.pendingTapToken ~= nil then
		self.pendingTapToken()
		self.pendingTapToken = nil
	end
	for index = #self.connections, 1, -1 do
		safeDisconnect(self.connections[index])
		self.connections[index] = nil
	end
	for input, state in self.touches do
		if state.longPressCancel ~= nil then
			state.longPressCancel()
		end
		self.touches[input] = nil
		self:_releaseTouchState(state)
	end
	for _, signal in self.signalsByGesture do
		signal:DisconnectAll()
		signal:Destroy()
	end
	table.clear(self.signalsByGesture)
	self:_exitPinch()
	self.isInitialized = false
end

Gestures.Bind = Gestures.Bind
Gestures.SetEnabled = Gestures.SetEnabled
Gestures.Init = Gestures.Init
Gestures.Destroy = Gestures.Destroy

Gestures.new = Gestures.New
Gestures.init = Gestures.Init
Gestures.bind = Gestures.Bind
Gestures.setEnabled = Gestures.SetEnabled
Gestures.destroy = Gestures.Destroy

return Gestures
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="1268">
                <Properties>
                  <string name="Name">HUDScaler</string>
                  <string name="Source"><![CDATA[--!strict
local GuiService = game:GetService("GuiService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local HUDScaler = {}
HUDScaler.__index = HUDScaler

export type ScalePreset = {
	scale: number?,
	offsetScale: number?,
	safePadding: Vector2?,
}

export type ElementConfig = {
	id: string?,
	gui: GuiObject,
	scaleSizeOffsets: boolean?,
	scalePositionOffsets: boolean?,
	minScale: number?,
	maxScale: number?,
	onApply: ((gui: GuiObject, scale: number, deviceType: string) -> ())?,
}

export type HUDScalerConfig = {
	platform: any?,
	layoutEngine: any?,
	eventBus: any?,
	eventChannel: string?,
	scaleEvent: string?,
	referenceHeight: number?,
	minScale: number?,
	maxScale: number?,
	presets: { [string]: ScalePreset }?,
}

type ElementRecord = {
	id: string,
	gui: GuiObject,
	baseSize: UDim2,
	basePosition: UDim2,
	scaleSizeOffsets: boolean,
	scalePositionOffsets: boolean,
	minScale: number,
	maxScale: number,
	onApply: ((gui: GuiObject, scale: number, deviceType: string) -> ())?,
}

export type HUDScaler = typeof(setmetatable({} :: any, HUDScaler))

local function clampNumber(valueRaw: any, fallback: number, minValue: number, maxValue: number): number
	local value = if typeof(valueRaw) == "number" then valueRaw else fallback
	if value < minValue then
		return minValue
	end
	if value > maxValue then
		return maxValue
	end
	return value
end

local function normalizeEventName(valueRaw: any, fallback: string): string
	if typeof(valueRaw) == "string" and valueRaw ~= "" then
		return valueRaw
	end
	return fallback
end

local function safeDisconnect(connection: RBXScriptConnection?)
	if connection == nil then
		return
	end
	connection:Disconnect()
end

local function round(value: number): number
	if value >= 0 then
		return math.floor(value + 0.5)
	end
	return math.ceil(value - 0.5)
end

local function detectDeviceType(platform: any?): string
	if platform ~= nil and typeof(platform.getPrimaryInputType) == "function" then
		local primaryInputType = platform:getPrimaryInputType()
		if primaryInputType == "Touch" then
			return "Mobile"
		end
		if primaryInputType == "Gamepad" then
			return "Console"
		end
		return "Desktop"
	end
	if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
		return "Mobile"
	end
	if UserInputService.GamepadEnabled and not UserInputService.KeyboardEnabled then
		return "Console"
	end
	return "Desktop"
end

function HUDScaler.New(configRaw: HUDScalerConfig?): HUDScaler
	local config = if typeof(configRaw) == "table" then configRaw else {}
	local self = setmetatable({
		platform = config.platform,
		layoutEngine = config.layoutEngine,
		eventBus = config.eventBus,
		eventChannel = normalizeEventName(config.eventChannel, "hud.scaler"),
		scaleEvent = normalizeEventName(config.scaleEvent, "applied"),
		referenceHeight = clampNumber(config.referenceHeight, 1080, 100, 10000),
		minScale = clampNumber(config.minScale, 0.75, 0.1, 5),
		maxScale = clampNumber(config.maxScale, 1.5, 0.1, 5),
		presets = {
			Desktop = {
				scale = 1,
				offsetScale = 1,
				safePadding = Vector2.new(8, 8),
			},
			Mobile = {
				scale = 1.12,
				offsetScale = 1.08,
				safePadding = Vector2.new(12, 12),
			},
			Console = {
				scale = 1.04,
				offsetScale = 1,
				safePadding = Vector2.new(16, 16),
			},
		} :: { [string]: ScalePreset },
		elements = {} :: { [string]: ElementRecord },
		orderedIds = {} :: { string },
		nextElementId = 0,
		connections = {} :: { RBXScriptConnection? },
		platformDisconnect = nil :: (() -> ())?,
		isInitialized = false,
		lastScale = 1,
		lastDeviceType = "Desktop",
		lastViewport = Vector2.zero,
	}, HUDScaler)

	if typeof(config.presets) == "table" then
		for key, value in config.presets do
			if typeof(key) == "string" and typeof(value) == "table" then
				self.presets[key] = value
			end
		end
	end

	return self
end

function HUDScaler._getViewport(self: HUDScaler): Vector2
	local camera = Workspace.CurrentCamera
	if camera == nil then
		return Vector2.new(1920, 1080)
	end
	local size = camera.ViewportSize
	return Vector2.new(math.max(1, size.X), math.max(1, size.Y))
end

function HUDScaler._computeScale(self: HUDScaler): (number, string, ScalePreset, Vector2, Vector2)
	local viewport = self:_getViewport()
	local deviceType = detectDeviceType(self.platform)
	local preset = self.presets[deviceType] or self.presets.Desktop
	local baseScale = viewport.Y / self.referenceHeight
	local presetScale = clampNumber(preset.scale, 1, 0.1, 10)
	local scale = clampNumber(baseScale * presetScale, 1, self.minScale, self.maxScale)
	local safeTopLeft, safeBottomRight = GuiService:GetGuiInset()
	return scale, deviceType, preset, safeTopLeft, safeBottomRight
end

function HUDScaler._applyRecord(self: HUDScaler, record: ElementRecord, scale: number, preset: ScalePreset, safeTopLeft: Vector2, safeBottomRight: Vector2, viewport: Vector2)
	local gui = record.gui
	if gui.Parent == nil then
		return
	end

	local offsetScale = clampNumber(preset.offsetScale, 1, 0.1, 10)
	local finalScale = clampNumber(scale, scale, record.minScale, record.maxScale)
	local safePadding = if typeof(preset.safePadding) == "Vector2" then preset.safePadding else Vector2.new(0, 0)

	local size = record.baseSize
	if record.scaleSizeOffsets then
		size = UDim2.new(
			size.X.Scale,
			round(size.X.Offset * finalScale),
			size.Y.Scale,
			round(size.Y.Offset * finalScale)
		)
	end
	gui.Size = size

	local position = record.basePosition
	if record.scalePositionOffsets then
		position = UDim2.new(
			position.X.Scale,
			round(position.X.Offset * finalScale * offsetScale),
			position.Y.Scale,
			round(position.Y.Offset * finalScale * offsetScale)
		)
	end

	local anchor = gui.AnchorPoint
	local safeOffsetX = 0
	local safeOffsetY = 0
	if anchor.X <= 0.5 then
		safeOffsetX = safeTopLeft.X + safePadding.X
	else
		safeOffsetX = -(safeBottomRight.X + safePadding.X)
	end
	if anchor.Y <= 0.5 then
		safeOffsetY = safeTopLeft.Y + safePadding.Y
	else
		safeOffsetY = -(safeBottomRight.Y + safePadding.Y)
	end

	gui.Position = UDim2.new(
		position.X.Scale,
		position.X.Offset + safeOffsetX,
		position.Y.Scale,
		position.Y.Offset + safeOffsetY
	)

	if record.onApply ~= nil then
		record.onApply(gui, finalScale, self.lastDeviceType)
	end
end

function HUDScaler._syncLayoutEngine(self: HUDScaler, viewport: Vector2, deviceType: string)
	local layoutEngine = self.layoutEngine
	if layoutEngine == nil then
		return
	end
	local layoutEngineAny = layoutEngine :: any
	if typeof((layoutEngine :: any).setViewport) == "function" then
		layoutEngineAny:setViewport(viewport)
	end
	if typeof((layoutEngine :: any).setGamepadMode) == "function" then
		layoutEngineAny:setGamepadMode(deviceType == "Console")
	end
	if typeof((layoutEngine :: any).reflow) == "function" then
		layoutEngineAny:reflow()
	end
end

function HUDScaler.Apply(self: HUDScaler)
	local scale, deviceType, preset, safeTopLeft, safeBottomRight = self:_computeScale()
	local viewport = self:_getViewport()
	self.lastScale = scale
	self.lastDeviceType = deviceType
	self.lastViewport = viewport

	for index = 1, #self.orderedIds do
		local id = self.orderedIds[index]
		local record = self.elements[id]
		if record ~= nil then
			self:_applyRecord(record, scale, preset, safeTopLeft, safeBottomRight, viewport)
		end
	end

	self:_syncLayoutEngine(viewport, deviceType)

	if self.eventBus ~= nil and typeof((self.eventBus :: any).publish) == "function" then
		local eventBusAny = self.eventBus :: any
		eventBusAny:publish(self.eventChannel, self.scaleEvent, {
			scale = scale,
			deviceType = deviceType,
			viewport = viewport,
		})
	end
end

function HUDScaler.Init(self: HUDScaler)
	if self.isInitialized then
		return
	end
	self.isInitialized = true

	local camera = Workspace.CurrentCamera
	if camera ~= nil then
		self.connections[#self.connections + 1] = camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
			self:apply()
		end)
	end
	self.connections[#self.connections + 1] = Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
		self:apply()
	end)

	if self.platform ~= nil and typeof((self.platform :: any).onChanged) == "function" then
		self.platformDisconnect = (self.platform :: any):onChanged(function()
			self:apply()
		end)
	end

	self:apply()
end

function HUDScaler.Register(self: HUDScaler, configRaw: ElementConfig): string?
	if typeof(configRaw) ~= "table" then
		return nil
	end
	if typeof(configRaw.gui) ~= "Instance" or not configRaw.gui:IsA("GuiObject") then
		return nil
	end
	local gui = configRaw.gui :: GuiObject
	local id = if typeof(configRaw.id) == "string" and configRaw.id ~= "" then configRaw.id else nil
	if id == nil then
		self.nextElementId += 1
		id = string.format("element_%d", self.nextElementId)
	end

	local record: ElementRecord = {
		id = id,
		gui = gui,
		baseSize = gui.Size,
		basePosition = gui.Position,
		scaleSizeOffsets = if configRaw.scaleSizeOffsets == nil then true else configRaw.scaleSizeOffsets == true,
		scalePositionOffsets = if configRaw.scalePositionOffsets == nil then true else configRaw.scalePositionOffsets == true,
		minScale = clampNumber(configRaw.minScale, self.minScale, 0.1, 5),
		maxScale = clampNumber(configRaw.maxScale, self.maxScale, 0.1, 5),
		onApply = if typeof(configRaw.onApply) == "function" then configRaw.onApply else nil,
	}

	if self.elements[id] == nil then
		self.orderedIds[#self.orderedIds + 1] = id
	end
	self.elements[id] = record
	return id
end

function HUDScaler.Unregister(self: HUDScaler, idRaw: any): boolean
	if typeof(idRaw) ~= "string" then
		return false
	end
	if self.elements[idRaw] == nil then
		return false
	end
	self.elements[idRaw] = nil
	for index = #self.orderedIds, 1, -1 do
		if self.orderedIds[index] == idRaw then
			table.remove(self.orderedIds, index)
			break
		end
	end
	return true
end

function HUDScaler.SetPreset(self: HUDScaler, deviceTypeRaw: any, presetRaw: any): boolean
	if typeof(deviceTypeRaw) ~= "string" or deviceTypeRaw == "" then
		return false
	end
	if typeof(presetRaw) ~= "table" then
		return false
	end
	self.presets[deviceTypeRaw] = presetRaw
	return true
end

function HUDScaler.GetScale(self: HUDScaler): number
	return self.lastScale
end

function HUDScaler.GetDeviceType(self: HUDScaler): string
	return self.lastDeviceType
end

function HUDScaler.Destroy(self: HUDScaler)
	for index = #self.connections, 1, -1 do
		safeDisconnect(self.connections[index])
		self.connections[index] = nil
	end
	if self.platformDisconnect ~= nil then
		self.platformDisconnect()
		self.platformDisconnect = nil
	end
	table.clear(self.elements)
	table.clear(self.orderedIds)
	self.isInitialized = false
end

HUDScaler.Register = HUDScaler.Register
HUDScaler.Unregister = HUDScaler.Unregister
HUDScaler.SetPreset = HUDScaler.SetPreset
HUDScaler.GetScale = HUDScaler.GetScale
HUDScaler.GetDeviceType = HUDScaler.GetDeviceType
HUDScaler.Apply = HUDScaler.Apply
HUDScaler.Init = HUDScaler.Init
HUDScaler.Destroy = HUDScaler.Destroy

HUDScaler.new = HUDScaler.New
HUDScaler.apply = HUDScaler.Apply
HUDScaler.init = HUDScaler.Init
HUDScaler.register = HUDScaler.Register
HUDScaler.unregister = HUDScaler.Unregister
HUDScaler.setPreset = HUDScaler.SetPreset
HUDScaler.getScale = HUDScaler.GetScale
HUDScaler.getDeviceType = HUDScaler.GetDeviceType
HUDScaler.destroy = HUDScaler.Destroy

return HUDScaler
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="1269">
                <Properties>
                  <string name="Name">Haptics</string>
                  <string name="Source"><![CDATA[--!strict

local HapticService = game:GetService("HapticService")
local UserInputService = game:GetService("UserInputService")

local Haptics = {}
Haptics.__index = Haptics

export type PulseConfig = {
	inputType: Enum.UserInputType?,
	large: number?,
	small: number?,
	duration: number?,
	intensityScale: number?,
	durationScale: number?,
}

export type HapticsConfig = {
	eventBus: any?,
	eventChannel: string?,
	tickScheduler: any?,
	enabled: boolean?,
}

export type Haptics = typeof(setmetatable({} :: any, Haptics))

local PATTERN_BY_KEY = {
	selection = {
		large = 0.12,
		small = 0.18,
		duration = 0.045,
	},
	confirm = {
		large = 0.22,
		small = 0.3,
		duration = 0.08,
	},
	warning = {
		large = 0.38,
		small = 0.18,
		duration = 0.1,
	},
	["error"] = {
		large = 0.5,
		small = 0.35,
		duration = 0.12,
	},
	impactLight = {
		large = 0.25,
		small = 0.14,
		duration = 0.06,
	},
	impactHeavy = {
		large = 0.55,
		small = 0.28,
		duration = 0.1,
	},
}

local function clampNumber(valueRaw: any, fallback: number, minValue: number, maxValue: number): number
	local value = if typeof(valueRaw) == "number" then valueRaw else fallback
	if value < minValue then
		return minValue
	end
	if value > maxValue then
		return maxValue
	end
	return value
end

local function normalizeEventName(valueRaw: any, fallback: string): string
	if typeof(valueRaw) == "string" and valueRaw ~= "" then
		return valueRaw
	end
	return fallback
end

local function resolveInputType(inputTypeRaw: any): Enum.UserInputType
	if typeof(inputTypeRaw) == "EnumItem" and string.sub((inputTypeRaw :: Enum.UserInputType).Name, 1, 7) == "Gamepad" then
		return inputTypeRaw
	end

	local ok, connected = pcall(function()
		return UserInputService:GetConnectedGamepads()
	end)
	if ok and typeof(connected) == "table" then
		for _, gamepadInputType in connected do
			if typeof(gamepadInputType) == "EnumItem" then
				return gamepadInputType :: Enum.UserInputType
			end
		end
	end
	return Enum.UserInputType.Gamepad1
end

function Haptics.New(configRaw: HapticsConfig?): Haptics
	local config = if typeof(configRaw) == "table" then configRaw else {}
	local self = setmetatable({
		eventBus = config.eventBus,
		eventChannel = normalizeEventName(config.eventChannel, "haptics"),
		tickScheduler = config.tickScheduler,
		enabled = if config.enabled == nil then true else config.enabled == true,
		activeStopByInput = {} :: { [string]: () -> () },
		isInitialized = false,
	}, Haptics)
	return self
end

function Haptics._setMotor(self: Haptics, inputType: Enum.UserInputType, motor: Enum.VibrationMotor, valueRaw: any)
	local value = clampNumber(valueRaw, 0, 0, 1)
	local okSupport, supported = pcall(function()
		return HapticService:IsVibrationSupported(inputType) and HapticService:IsMotorSupported(inputType, motor)
	end)
	if not okSupport or not supported then
		return
	end
	pcall(function()
		HapticService:SetMotor(inputType, motor, value)
	end)
end

function Haptics._stop(self: Haptics, inputType: Enum.UserInputType)
	self:_setMotor(inputType, Enum.VibrationMotor.Large, 0)
	self:_setMotor(inputType, Enum.VibrationMotor.Small, 0)
end

function Haptics._cancelPending(self: Haptics, inputType: Enum.UserInputType)
	local key = inputType.Name
	local cancel = self.activeStopByInput[key]
	if cancel ~= nil then
		cancel()
		self.activeStopByInput[key] = nil
	end
end

function Haptics.Pulse(self: Haptics, patternRaw: any, configRaw: PulseConfig?): boolean
	if not self.enabled then
		return false
	end

	local config = if typeof(configRaw) == "table" then configRaw else {}
	local pattern = if typeof(patternRaw) == "table" then patternRaw else PATTERN_BY_KEY[if typeof(patternRaw) == "string" then patternRaw else "selection"]
	if typeof(pattern) ~= "table" then
		return false
	end

	local inputType = resolveInputType(config.inputType)
	local intensityScale = clampNumber(config.intensityScale, 1, 0, 4)
	local durationScale = clampNumber(config.durationScale, 1, 0, 4)
	local large = clampNumber(config.large, if typeof(pattern.large) == "number" then pattern.large else 0.2, 0, 1) * intensityScale
	local small = clampNumber(config.small, if typeof(pattern.small) == "number" then pattern.small else 0.2, 0, 1) * intensityScale
	local duration = clampNumber(config.duration, if typeof(pattern.duration) == "number" then pattern.duration else 0.06, 0.01, 2) * durationScale

	self:_cancelPending(inputType)
	self:_setMotor(inputType, Enum.VibrationMotor.Large, large)
	self:_setMotor(inputType, Enum.VibrationMotor.Small, small)

	local cancelled = false
	local function stopPulse()
		if cancelled then
			return
		end
		cancelled = true
		self:_stop(inputType)
		self.activeStopByInput[inputType.Name] = nil
	end

	if self.tickScheduler ~= nil and typeof((self.tickScheduler :: any).schedule) == "function" then
		local token = (self.tickScheduler :: any):schedule(function()
			stopPulse()
		end, duration, {
			group = "haptics.stop",
			priority = 250,
		})
		self.activeStopByInput[inputType.Name] = function()
			cancelled = true
			if typeof(token.cancel) == "function" then
				token:cancel()
			elseif typeof((self.tickScheduler :: any).cancel) == "function" then
				local schedulerAny = self.tickScheduler :: any
				schedulerAny:cancel(token)
			end
			self:_stop(inputType)
		end
	else
		self.activeStopByInput[inputType.Name] = function()
			cancelled = true
			self:_stop(inputType)
		end
		task.delay(duration, function()
			stopPulse()
		end)
	end

	if self.eventBus ~= nil and typeof((self.eventBus :: any).publish) == "function" then
		local eventBusAny = self.eventBus :: any
		eventBusAny:publish(self.eventChannel, "pulse", {
			inputType = inputType,
			large = large,
			small = small,
			duration = duration,
		})
	end

	return true
end

function Haptics.Selection(self: Haptics): boolean
	return self:pulse("selection")
end

function Haptics.Confirm(self: Haptics): boolean
	return self:pulse("confirm")
end

function Haptics.Warning(self: Haptics): boolean
	return self:pulse("warning")
end

function Haptics.Error(self: Haptics): boolean
	return self:pulse("error")
end

function Haptics.ImpactLight(self: Haptics): boolean
	return self:pulse("impactLight")
end

function Haptics.ImpactHeavy(self: Haptics): boolean
	return self:pulse("impactHeavy")
end

function Haptics.SetEnabled(self: Haptics, enabledRaw: any)
	self.enabled = enabledRaw == true
	if not self.enabled then
		for inputName, cancel in self.activeStopByInput do
			cancel()
			self.activeStopByInput[inputName] = nil
		end
	end
end

function Haptics.Init(self: Haptics)
	self.isInitialized = true
end

function Haptics.Destroy(self: Haptics)
	for inputName, cancel in self.activeStopByInput do
		cancel()
		self.activeStopByInput[inputName] = nil
	end
	self.isInitialized = false
end

Haptics.Pulse = Haptics.Pulse
Haptics.Selection = Haptics.Selection
Haptics.Confirm = Haptics.Confirm
Haptics.Warning = Haptics.Warning
Haptics.Error = Haptics.Error
Haptics.ImpactLight = Haptics.ImpactLight
Haptics.ImpactHeavy = Haptics.ImpactHeavy
Haptics.SetEnabled = Haptics.SetEnabled
Haptics.Init = Haptics.Init
Haptics.Destroy = Haptics.Destroy

Haptics.new = Haptics.New
Haptics.pulse = Haptics.Pulse
Haptics.selection = Haptics.Selection
Haptics.confirm = Haptics.Confirm
Haptics.warning = Haptics.Warning
Haptics.error = Haptics.Error
Haptics.impactLight = Haptics.ImpactLight
Haptics.impactHeavy = Haptics.ImpactHeavy
Haptics.setEnabled = Haptics.SetEnabled
Haptics.init = Haptics.Init
Haptics.destroy = Haptics.Destroy

return Haptics
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="1270">
                <Properties>
                  <string name="Name">Input</string>
                  <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Sift = require(ReplicatedStorage.Packages.Sift)

local UserInputService = game:GetService("UserInputService")

local Input = {}
Input.__index = Input

export type InputPhase = "Began" | "Changed" | "Ended" | "LongPress" | "DoubleTap"

export type InputBinding = {
	keyCode: Enum.KeyCode?,
	inputType: Enum.UserInputType?,
	deadzone: number?,
}

export type InputContext = {
	phase: InputPhase,
	actionName: string,
	input: InputObject,
	inputKey: string,
	timestamp: number,
	duration: number,
	position: any,
	delta: any,
	deadzonePassed: boolean,
	layer: string,
}

export type InputActionCallback = (phase: InputPhase, context: InputContext) -> boolean?

export type ActionOptions = {
	layer: string?,
	priority: number?,
	consume: boolean?,
	enabled: boolean?,
	allowGameProcessed: boolean?,
	allowWhileTyping: boolean?,
	bindings: { InputBinding }?,
	longPressTime: number?,
	doubleTapWindow: number?,
	deadzone: number?,
}

export type LayerConfig = {
	enabled: boolean?,
	priority: number?,
}

export type InputConfig = {
	eventBus: any?,
	eventChannel: string?,
	actionEvent: string?,
	tickScheduler: any?,
	defaultLongPressTime: number?,
	defaultDoubleTapWindow: number?,
	defaultDeadzone: number?,
	layers: { [string]: LayerConfig }?,
}

type CompiledBinding = {
	inputKey: string,
	keyCode: Enum.KeyCode?,
	inputType: Enum.UserInputType?,
	deadzone: number,
}

type ActionRecord = {
	name: string,
	callback: InputActionCallback,
	layer: string,
	priority: number,
	consume: boolean,
	enabled: boolean,
	allowGameProcessed: boolean,
	allowWhileTyping: boolean,
	longPressTime: number,
	doubleTapWindow: number,
	deadzone: number,
	bindings: { CompiledBinding },
}

type BindingEntry = {
	action: ActionRecord,
	binding: CompiledBinding,
}

type ActivePress = {
	actionName: string,
	inputKey: string,
	startTime: number,
	longPressTriggered: boolean,
	longPressCancel: (() -> ())?,
}

export type Input = typeof(setmetatable({} :: any, Input))

local function clampNumber(valueRaw: any, fallback: number, minValue: number, maxValue: number): number
	local value = if typeof(valueRaw) == "number" then valueRaw else fallback
	if value < minValue then
		return minValue
	end
	if value > maxValue then
		return maxValue
	end
	return value
end

local function clampPriority(valueRaw: any, fallback: number): number
	if typeof(valueRaw) ~= "number" then
		return fallback
	end
	local value = math.floor(valueRaw)
	if value < -1000000 then
		return -1000000
	end
	if value > 1000000 then
		return 1000000
	end
	return value
end

local function normalizeLayer(layerRaw: any): string
	if typeof(layerRaw) == "string" and layerRaw ~= "" then
		return layerRaw
	end
	return "Gameplay"
end

local function normalizeEventName(valueRaw: any, fallback: string): string
	if typeof(valueRaw) == "string" and valueRaw ~= "" then
		return valueRaw
	end
	return fallback
end

local function safeDisconnect(connection: RBXScriptConnection?)
	if connection == nil then
		return
	end
	connection:Disconnect()
end

local function deriveInputKey(input: InputObject): string
	if input.KeyCode ~= Enum.KeyCode.Unknown then
		return "K:" .. input.KeyCode.Name
	end
	return "U:" .. input.UserInputType.Name
end

local function normalizeBindings(bindingsRaw: any): { InputBinding }
	local out = {}
	if typeof(bindingsRaw) ~= "table" then
		return out
	end
	for _, bindingRaw in bindingsRaw do
		if typeof(bindingRaw) ~= "table" then
			continue
		end
		local keyCode = if typeof(bindingRaw.keyCode) == "EnumItem" then bindingRaw.keyCode else nil
		local inputType = if typeof(bindingRaw.inputType) == "EnumItem" then bindingRaw.inputType else nil
		if keyCode == nil and inputType == nil then
			continue
		end
		out[#out + 1] = {
			keyCode = keyCode,
			inputType = inputType,
			deadzone = bindingRaw.deadzone,
		}
	end
	return out
end

local function sortBindingEntries(self: Input, entries: { BindingEntry })
	table.sort(entries, function(a, b)
		local layerAPriority = self.layerPriorities[a.action.layer] or 0
		local layerBPriority = self.layerPriorities[b.action.layer] or 0
		if layerAPriority ~= layerBPriority then
			return layerAPriority > layerBPriority
		end
		if a.action.priority ~= b.action.priority then
			return a.action.priority > b.action.priority
		end
		return a.action.name < b.action.name
	end)
end

local function hasDeadzonePassed(input: InputObject, deadzone: number): boolean
	if deadzone <= 0 then
		return true
	end
	local position = input.Position
	if typeof(position) ~= "Vector3" then
		return true
	end
	local magnitude = math.sqrt(position.X * position.X + position.Y * position.Y)
	return magnitude >= deadzone
end

function Input.New(configRaw: InputConfig?): Input
	local config = if typeof(configRaw) == "table" then configRaw else {}
	local self = setmetatable({
		eventBus = config.eventBus,
		eventChannel = normalizeEventName(config.eventChannel, "input"),
		actionEvent = normalizeEventName(config.actionEvent, "action"),
		tickScheduler = config.tickScheduler,
		defaultLongPressTime = clampNumber(config.defaultLongPressTime, 0.45, 0.1, 5),
		defaultDoubleTapWindow = clampNumber(config.defaultDoubleTapWindow, 0.3, 0.05, 2),
		defaultDeadzone = clampNumber(config.defaultDeadzone, 0.15, 0, 1),
		actions = {} :: { [string]: ActionRecord },
		bindingIndex = {} :: { [string]: { BindingEntry } },
		layerEnabled = {
			Gameplay = true,
			UI = true,
		} :: { [string]: boolean },
		layerPriorities = {
			Gameplay = 0,
			UI = 100,
		} :: { [string]: number },
		activePresses = {} :: { [InputObject]: { [string]: ActivePress } },
		lastTapByActionInput = {} :: { [string]: number },
		connections = {} :: { RBXScriptConnection? },
		isInitialized = false,
	}, Input)

	if typeof(config.layers) == "table" then
		for layerName, layerConfig in config.layers do
			if typeof(layerName) == "string" and typeof(layerConfig) == "table" then
				if layerConfig.enabled ~= nil then
					self.layerEnabled[layerName] = layerConfig.enabled == true
				end
				if layerConfig.priority ~= nil then
					self.layerPriorities[layerName] = clampPriority(layerConfig.priority, self.layerPriorities[layerName] or 0)
				end
			end
		end
	end

	return self
end

function Input._compileBindings(self: Input, action: ActionRecord, bindingsRaw: any): { CompiledBinding }
	local normalized = normalizeBindings(bindingsRaw)
	local compiled = Sift.Array.create(#normalized)
	for index = 1, #normalized do
		local binding = normalized[index]
		local keyCode = binding.keyCode
		local inputType = binding.inputType
		local inputKey = if keyCode ~= nil then "K:" .. keyCode.Name else "U:" .. (inputType :: Enum.UserInputType).Name
		compiled[index] = {
			inputKey = inputKey,
			keyCode = keyCode,
			inputType = inputType,
			deadzone = clampNumber(binding.deadzone, action.deadzone, 0, 1),
		}
	end
	return compiled
end

function Input._rebuildBindingIndex(self: Input)
	table.clear(self.bindingIndex)
	for _, action in self.actions do
		if not action.enabled then
			continue
		end
		for index = 1, #action.bindings do
			local binding = action.bindings[index]
			local entries = self.bindingIndex[binding.inputKey]
			if entries == nil then
				entries = {}
				self.bindingIndex[binding.inputKey] = entries
			end
			entries[#entries + 1] = {
				action = action,
				binding = binding,
			}
		end
	end
	for _, entries in self.bindingIndex do
		sortBindingEntries(self, entries)
	end
end

function Input._scheduleLongPress(self: Input, inputObject: InputObject, action: ActionRecord, press: ActivePress)
	if action.longPressTime <= 0 then
		return
	end
	if self.tickScheduler ~= nil and typeof((self.tickScheduler :: any).schedule) == "function" then
		local token = (self.tickScheduler :: any):schedule(function()
			local inputPresses = self.activePresses[inputObject]
			if inputPresses == nil then
				return
			end
			local runtimePress = inputPresses[action.name]
			if runtimePress == nil or runtimePress.longPressTriggered then
				return
			end
			runtimePress.longPressTriggered = true
			self:_dispatchAction(action, press.inputKey, inputObject, "LongPress", false, runtimePress.startTime)
		end, action.longPressTime, {
			group = "input.longpress",
			priority = 200,
		})
		press.longPressCancel = function()
			if typeof(token.cancel) == "function" then
				token:cancel()
			elseif typeof((self.tickScheduler :: any).cancel) == "function" then
				local schedulerAny = self.tickScheduler :: any
				schedulerAny:cancel(token)
			end
		end
		return
	end
	local cancelled = false
	press.longPressCancel = function()
		cancelled = true
	end
	task.delay(action.longPressTime, function()
		if cancelled then
			return
		end
		local inputPresses = self.activePresses[inputObject]
		if inputPresses == nil then
			return
		end
		local runtimePress = inputPresses[action.name]
		if runtimePress == nil or runtimePress.longPressTriggered then
			return
		end
		runtimePress.longPressTriggered = true
		self:_dispatchAction(action, press.inputKey, inputObject, "LongPress", false, runtimePress.startTime)
	end)
end

function Input._dispatchAction(
	self: Input,
	action: ActionRecord,
	inputKey: string,
	inputObject: InputObject,
	phase: InputPhase,
	gameProcessed: boolean,
	startTime: number?
): boolean
	if not action.enabled then
		return false
	end
	if not (self.layerEnabled[action.layer] == true) then
		return false
	end
	if gameProcessed and not action.allowGameProcessed then
		return false
	end
	if UserInputService:GetFocusedTextBox() ~= nil and not action.allowWhileTyping then
		return false
	end

	local timestamp = os.clock()
	local beginTimestamp = if startTime ~= nil then startTime else timestamp
	local duration = math.max(0, timestamp - beginTimestamp)
	local context: InputContext = {
		phase = phase,
		actionName = action.name,
		input = inputObject,
		inputKey = inputKey,
		timestamp = timestamp,
		duration = duration,
		position = inputObject.Position,
		delta = inputObject.Delta,
		deadzonePassed = true,
		layer = action.layer,
	}

	local ok, consumedOrErr = pcall(action.callback, phase, context)
	if not ok then
		return false
	end

	if self.eventBus ~= nil and typeof((self.eventBus :: any).publish) == "function" then
		local eventBusAny = self.eventBus :: any
		eventBusAny:publish(self.eventChannel, self.actionEvent, {
			actionName = action.name,
			phase = phase,
			layer = action.layer,
			inputKey = inputKey,
			duration = duration,
		})
	end

	if action.consume then
		return consumedOrErr ~= false
	end
	return false
end

function Input._getEntriesForInput(self: Input, input: InputObject): { BindingEntry }?
	return self.bindingIndex[deriveInputKey(input)]
end

function Input._handleInput(self: Input, input: InputObject, phase: InputPhase, gameProcessed: boolean)
	local entries = self:_getEntriesForInput(input)
	if entries == nil then
		return
	end

	local inputKey = deriveInputKey(input)
	local consumed = false
	local now = os.clock()

	for index = 1, #entries do
		if consumed then
			break
		end
		local entry = entries[index]
		local action = entry.action
		local binding = entry.binding
		if not hasDeadzonePassed(input, binding.deadzone) then
			continue
		end

		if phase == "Began" then
			local perInput = self.activePresses[input]
			if perInput == nil then
				perInput = {}
				self.activePresses[input] = perInput
			end
			local press: ActivePress = {
				actionName = action.name,
				inputKey = inputKey,
				startTime = now,
				longPressTriggered = false,
				longPressCancel = nil,
			}
			perInput[action.name] = press
			self:_scheduleLongPress(input, action, press)
		end

		local activePress = if self.activePresses[input] ~= nil then self.activePresses[input][action.name] else nil
		local startTime = if activePress ~= nil then activePress.startTime else nil
		local didConsume = self:_dispatchAction(action, inputKey, input, phase, gameProcessed, startTime)
		if didConsume then
			consumed = true
		end

		if phase == "Ended" then
			local perInput = self.activePresses[input]
			local press = if perInput ~= nil then perInput[action.name] else nil
			if press ~= nil then
				if press.longPressCancel ~= nil then
					press.longPressCancel()
				end
				local shouldCheckDoubleTap = (not press.longPressTriggered) and action.doubleTapWindow > 0
				if shouldCheckDoubleTap then
					local tapKey = action.name .. "|" .. inputKey
					local previousTap = self.lastTapByActionInput[tapKey]
					if previousTap ~= nil and (now - previousTap) <= action.doubleTapWindow then
						self.lastTapByActionInput[tapKey] = nil
						self:_dispatchAction(action, inputKey, input, "DoubleTap", gameProcessed, press.startTime)
					else
						self.lastTapByActionInput[tapKey] = now
					end
				end
				perInput[action.name] = nil
				if next(perInput) == nil then
					self.activePresses[input] = nil
				end
			end
		end
	end
end

function Input.Init(self: Input)
	if self.isInitialized then
		return
	end
	self.isInitialized = true
	self.connections[#self.connections + 1] = UserInputService.InputBegan:Connect(function(input: InputObject, gameProcessed: boolean)
		self:_handleInput(input, "Began", gameProcessed)
	end)
	self.connections[#self.connections + 1] = UserInputService.InputChanged:Connect(function(input: InputObject, gameProcessed: boolean)
		self:_handleInput(input, "Changed", gameProcessed)
	end)
	self.connections[#self.connections + 1] = UserInputService.InputEnded:Connect(function(input: InputObject, gameProcessed: boolean)
		self:_handleInput(input, "Ended", gameProcessed)
	end)
end

function Input.BindAction(self: Input, actionNameRaw: any, callbackRaw: any, optionsRaw: ActionOptions?): boolean
	if typeof(actionNameRaw) ~= "string" or actionNameRaw == "" then
		return false
	end
	if typeof(callbackRaw) ~= "function" then
		return false
	end

	local options = if typeof(optionsRaw) == "table" then optionsRaw else {}
	local actionName = actionNameRaw :: string
	local layer = normalizeLayer(options.layer)
	local action: ActionRecord = {
		name = actionName,
		callback = callbackRaw,
		layer = layer,
		priority = clampPriority(options.priority, 0),
		consume = options.consume == true,
		enabled = if options.enabled == nil then true else options.enabled == true,
		allowGameProcessed = options.allowGameProcessed == true,
		allowWhileTyping = options.allowWhileTyping == true,
		longPressTime = clampNumber(options.longPressTime, self.defaultLongPressTime, 0, 5),
		doubleTapWindow = clampNumber(options.doubleTapWindow, self.defaultDoubleTapWindow, 0, 2),
		deadzone = clampNumber(options.deadzone, self.defaultDeadzone, 0, 1),
		bindings = {},
	}

	action.bindings = self:_compileBindings(action, options.bindings)
	if #action.bindings == 0 then
		return false
	end

	self.actions[actionName] = action
	if self.layerEnabled[layer] == nil then
		self.layerEnabled[layer] = true
	end
	if self.layerPriorities[layer] == nil then
		self.layerPriorities[layer] = 0
	end
	self:_rebuildBindingIndex()
	return true
end

function Input.RebindAction(self: Input, actionNameRaw: any, bindingsRaw: any): boolean
	if typeof(actionNameRaw) ~= "string" then
		return false
	end
	local action = self.actions[actionNameRaw]
	if action == nil then
		return false
	end
	local compiled = self:_compileBindings(action, bindingsRaw)
	if #compiled == 0 then
		return false
	end
	action.bindings = compiled
	self:_rebuildBindingIndex()
	return true
end

function Input.SetActionEnabled(self: Input, actionNameRaw: any, enabledRaw: any): boolean
	if typeof(actionNameRaw) ~= "string" then
		return false
	end
	local action = self.actions[actionNameRaw]
	if action == nil then
		return false
	end
	action.enabled = enabledRaw == true
	self:_rebuildBindingIndex()
	return true
end

function Input.UnbindAction(self: Input, actionNameRaw: any): boolean
	if typeof(actionNameRaw) ~= "string" then
		return false
	end
	if self.actions[actionNameRaw] == nil then
		return false
	end
	self.actions[actionNameRaw] = nil
	self:_rebuildBindingIndex()
	return true
end

function Input.SetLayerEnabled(self: Input, layerRaw: any, enabledRaw: any)
	local layer = normalizeLayer(layerRaw)
	self.layerEnabled[layer] = enabledRaw == true
end

function Input.SetLayerPriority(self: Input, layerRaw: any, priorityRaw: any)
	local layer = normalizeLayer(layerRaw)
	self.layerPriorities[layer] = clampPriority(priorityRaw, self.layerPriorities[layer] or 0)
	self:_rebuildBindingIndex()
end

function Input.GetLayerEnabled(self: Input, layerRaw: any): boolean
	local layer = normalizeLayer(layerRaw)
	return self.layerEnabled[layer] == true
end

function Input.Clear(self: Input)
	table.clear(self.actions)
	table.clear(self.bindingIndex)
	table.clear(self.activePresses)
	table.clear(self.lastTapByActionInput)
end

function Input.Destroy(self: Input)
	self:clear()
	for index = #self.connections, 1, -1 do
		safeDisconnect(self.connections[index])
		self.connections[index] = nil
	end
	self.isInitialized = false
end

Input.BindAction = Input.BindAction
Input.RebindAction = Input.RebindAction
Input.UnbindAction = Input.UnbindAction
Input.SetActionEnabled = Input.SetActionEnabled
Input.SetLayerEnabled = Input.SetLayerEnabled
Input.SetLayerPriority = Input.SetLayerPriority
Input.GetLayerEnabled = Input.GetLayerEnabled
Input.Init = Input.Init
Input.Destroy = Input.Destroy

Input.new = Input.New
Input.init = Input.Init
Input.bindAction = Input.BindAction
Input.rebindAction = Input.RebindAction
Input.setActionEnabled = Input.SetActionEnabled
Input.unbindAction = Input.UnbindAction
Input.setLayerEnabled = Input.SetLayerEnabled
Input.setLayerPriority = Input.SetLayerPriority
Input.getLayerEnabled = Input.GetLayerEnabled
Input.clear = Input.Clear
Input.destroy = Input.Destroy

return Input
]]></string>
                </Properties>
