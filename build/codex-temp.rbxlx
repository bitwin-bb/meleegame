            <Item class="ModuleScript" referent="690">
              <Properties>
                <string name="Name">useSelector</string>
                <string name="Source"><![CDATA[local Context = require(script.Parent.Context)
local createSelectorHook = require(script.Parent.createSelectorHook)

--[=[
	@within ReactRodux
	@function useSelector
	@param context ReactContext<Store>
	@return Selection

	This is the primary way to get data from a Rodux store with React Rodux. 
	Multiple useSelector hooks can be used in the same component.

	By default, useSelector will directly compare the previous value returned 
	by selector to the most recent one. When the old and new values are not
	equal, the component will be re-rendered with the updated state. You can 
	optionally pass a function to equalityFn for finer control over this.

	```lua
	local function ExampleLabel(props)
		local money = ReactRodux.useSelector(function(state)
			return state.money
		end)

		return e(MoneyLabel, {
			amount = money,
		})
	end
	```
]=]
return createSelectorHook(Context)
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="691">
              <Properties>
                <string name="Name">useStore</string>
                <string name="Source"><![CDATA[local Context = require(script.Parent.Context)
local createStoreHook = require(script.Parent.createStoreHook)

--[=[
	@within ReactRodux
	@function useStore
	@param context ReactContext<Store>
	@return Store

	Returns the Rodux store that was passed into the Provider. This might be
	useful if you need to use the store for something other than getting state
	or dispatching an action, otherwise `useSelector` and `useDispatch` are
	better options.

	```lua
	local function App(props)
		local store = useStore()

		return e(Button, {
			onClick = function()
				store:destruct()
			end,
		})
	end
	```
]=]
return createStoreHook(Context)
]]></string>
