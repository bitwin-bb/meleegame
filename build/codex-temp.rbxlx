local LIQUID_DEFINITIONS: { [number]: LiquidColorDefinition } = {
	[1] = {
		baseColor = Color3.fromRGB(51, 90, 163),
		surfaceColor = Color3.fromRGB(38, 69, 128),
	},
	[2] = {
