                <Properties>
                  <string name="Name">FlyServer</string>
                  <string name="Source"><![CDATA[--!strict
local gameRoot = script:FindFirstAncestor("game")
assert(gameRoot ~= nil, "Missing Nevermore game root for FlyServer.")

local CmdrUtils = require(gameRoot.Shared.Cmdr.CmdrUtils)
local PlayerServiceServer = require(gameRoot.Server.Services.PlayerServiceServer)

local function setFlyEnabled(player: Player, enabledRaw: any, speedRaw: any): number
	local enabled = enabledRaw == true
	local speed = CmdrUtils.sanitizeFlySpeed(speedRaw, CmdrUtils.DEFAULT_FLY_SPEED)

	player:SetAttribute(CmdrUtils.FLY_ENABLED_ATTRIBUTE, enabled)
	if enabled then
		player:SetAttribute(CmdrUtils.FLY_SPEED_ATTRIBUTE, speed)
		PlayerServiceServer:setMovementLocked(player, false, true)
	else
		player:SetAttribute(CmdrUtils.FLY_SPEED_ATTRIBUTE, nil)
	end

	return speed
end

return function(_context, players: { Player }, speedRaw: number)
	local updated = {}
	local speed = 0

	for index, player in players do
		speed = setFlyEnabled(player, true, speedRaw)
		updated[index] = player.Name
	end

	return `Enabled fly for {table.concat(updated, ", ")} at speed {speed}.`
end
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="1032">
                <Properties>
                  <string name="Name">GiveServer</string>
                  <string name="Source"><![CDATA[--!strict
local gameRoot = script:FindFirstAncestor("game")
assert(gameRoot ~= nil, "Missing Nevermore game root for GiveServer.")

local InventoryServiceServer = require(gameRoot.Server.Services.InventoryServiceServer)
local ItemRegistry = require(gameRoot.Shared.Modules.Items.Registry)

local function joinNames(names: { string }): string
	return table.concat(names, ", ")
end

return function(_context, itemIdRaw: string, players: { Player }, amountRaw: number)
	local itemId = ItemRegistry.resolveCanonicalItemId(itemIdRaw)
	if itemId == nil then
		return `Unknown item "{itemIdRaw}".`
	end

	local definition = ItemRegistry.resolveDefinition(itemId)
	local itemName = if typeof(definition) == "table" and typeof((definition :: any).name) == "string"
		then (definition :: any).name
		else itemId
	local amount = math.max(1, math.floor(amountRaw))

	local delivered = {}
	local partial = {}
	local failed = {}

	for _, player in players do
		local result = InventoryServiceServer:addItem(player, itemId, amount, nil)
		if result.added >= amount and result.leftover <= 0 then
			delivered[#delivered + 1] = player.Name
		elseif result.added > 0 then
			partial[#partial + 1] = `{player.Name} (+{result.added}, {result.leftover} leftover)`
		else
			failed[#failed + 1] = player.Name
		end
	end

	local responseParts = {}
	if #delivered > 0 then
		responseParts[#responseParts + 1] = `Gave {itemName} x{amount} to {joinNames(delivered)}.`
	end
	if #partial > 0 then
		responseParts[#responseParts + 1] = `Partially added for {joinNames(partial)}.`
	end
	if #failed > 0 then
		responseParts[#responseParts + 1] = `Failed for {joinNames(failed)} because their inventory was unavailable or full.`
	end

	return table.concat(responseParts, " ")
end
]]></string>
                </Properties>
              </Item>
