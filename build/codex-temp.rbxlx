                <Item class="ModuleScript" referent="1099">
                  <Properties>
                    <string name="Name">Motion</string>
                    <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local BossServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.BossServiceUtils)
local Damp = require(script:FindFirstAncestor("game").Shared.Modules.Math.Damp)
local Vec = require(script:FindFirstAncestor("game").Shared.Modules.Math.Vec)

type BossMotionState = BossServiceUtils.BossMotionState

export type MotionTargetSnapshot = {
	position: Vector3?,
	velocity: Vector3,
}

export type ChargeLock = {
	direction: Vector3,
	speed: number,
	duration: number,
	destination: Vector3,
	targetPosition: Vector3?,
}

export type MotionRuntimeState = {
	state: string,
	stateTime: number,
	position: Vector3,
	velocity: Vector3,
	facing: Vector3,
	planeX: number?,
	sideSign: number,
	transformBaseFacing: Vector3?,
	lockedCharge: ChargeLock?,
}

export type MotionSolveResult = {
	velocity: Vector3,
	facing: Vector3,
	finished: boolean,
	nextSuggestedState: string?,
	hoverAnchor: Vector3?,
	localPresentationOffset: Vector3?,
	lockedChargeDirection: Vector3?,
	chargeTimeRemaining: number?,
	motionOwner: string,
	debug: BossMotionState,
}

local EyeOfCthulhuMotion = {}

local DEFAULT_CHARGE_DIRECTION = Vector3.new(0, -0.15, 1)
local ZERO_VECTOR = Vector3.zero

local function sanitizeNumber(valueRaw: any, fallback: number, minimum: number?, maximum: number?): number
	return BossServiceUtils.sanitizeNumber(valueRaw, fallback, minimum, maximum)
end

local function sanitizeDuration(valueRaw: any, fallback: number): number
	return sanitizeNumber(valueRaw, fallback, 0.01, 60)
end

local function safeUnit(vector: Vector3, fallbackRaw: Vector3?): Vector3
	local fallback = if typeof(fallbackRaw) == "Vector3" then fallbackRaw else Vector3.zAxis
	local fallbackUnit = Vec.unit(fallback, Vector3.zAxis)
	if vector.Magnitude <= 1e-4 then
		return fallbackUnit
	end
	return Vec.unit(vector, fallbackUnit)
end

local function projectPosition(position: Vector3, planeXRaw: any): Vector3
	return BossServiceUtils.projectPositionToPlaneX(position, planeXRaw)
end

local function projectVector(vector: Vector3, planeXRaw: any): Vector3
	return BossServiceUtils.projectVectorToPlaneX(vector, planeXRaw)
end

local function resolveTargetVelocity(targetSnapshot: MotionTargetSnapshot?): Vector3
	if targetSnapshot == nil then
		return ZERO_VECTOR
	end
	return targetSnapshot.velocity
end

local function resolveFacingTowardTarget(
	currentPosition: Vector3,
	targetSnapshot: MotionTargetSnapshot?,
	fallbackRaw: Vector3?
): Vector3
	local fallback = if typeof(fallbackRaw) == "Vector3" then fallbackRaw else Vector3.zAxis
	if targetSnapshot ~= nil and targetSnapshot.position ~= nil then
		return safeUnit(targetSnapshot.position - currentPosition, fallback)
	end
	return safeUnit(fallback, Vector3.zAxis)
end

local function resolvePlaneFallback(sideSignRaw: any): Vector3
	local sideSign = if sideSignRaw == -1 then -1 else 1
	return safeUnit(Vector3.new(0, -0.15, sideSign), DEFAULT_CHARGE_DIRECTION)
end

local function dampVelocity(velocity: Vector3, dampingRaw: any, dt: number): Vector3
	local damping = sanitizeNumber(dampingRaw, 0, 0, 1000)
	if damping <= 0 then
		return velocity
	end
	return Damp.value(velocity, ZERO_VECTOR, damping, dt)
end

local function solveAnchoredVelocity(
	currentPosition: Vector3,
	currentVelocity: Vector3,
	targetAnchor: Vector3,
	planeXRaw: any,
	maxSpeedRaw: any,
	accelerationRaw: any,
	dampingRaw: any,
	dt: number
): (Vector3, number)
	local maxSpeed = sanitizeNumber(maxSpeedRaw, 0, 0, 10 ^ 5)
	local acceleration = sanitizeNumber(accelerationRaw, 0, 0, 10 ^ 5)
	local anchor = projectPosition(targetAnchor, planeXRaw)
	local offset = projectVector(anchor - currentPosition, planeXRaw)
	local distance = offset.Magnitude

	local desiredVelocity = ZERO_VECTOR
	if distance > 1e-4 and maxSpeed > 0 then
		local arrivalGain = math.max(1.25, acceleration / math.max(maxSpeed, 1))
		local desiredSpeed = math.min(maxSpeed, distance * arrivalGain)
		desiredVelocity = offset.Unit * desiredSpeed
	end

	local nextVelocity = BossServiceUtils.moveTowardsVector(currentVelocity, desiredVelocity, acceleration * dt)
	nextVelocity = dampVelocity(projectVector(nextVelocity, planeXRaw), dampingRaw, dt)
	if nextVelocity.Magnitude > maxSpeed and maxSpeed > 0 then
		nextVelocity = nextVelocity.Unit * maxSpeed
	end

	return nextVelocity, distance
end

local function buildDebugState(
	context: MotionRuntimeState,
	owner: string,
	velocity: Vector3,
	hoverAnchor: Vector3?,
	distanceToAnchor: number?,
	lockedChargeDirection: Vector3?,
	chargeTimeRemaining: number?,
	localPresentationOffset: Vector3?
): BossMotionState
	return {
		state = context.state,
		position = context.position,
		velocity = velocity,
		hoverAnchor = hoverAnchor,
		distanceToAnchor = distanceToAnchor,
		lockedChargeDirection = lockedChargeDirection,
		chargeTimeRemaining = chargeTimeRemaining,
		motionOwner = owner,
		localPresentationOffset = localPresentationOffset,
	}
end

local function createResult(
	context: MotionRuntimeState,
	owner: string,
	velocity: Vector3,
	facing: Vector3,
	finished: boolean,
	nextSuggestedState: string?,
	hoverAnchor: Vector3?,
	distanceToAnchor: number?,
	lockedChargeDirection: Vector3?,
	chargeTimeRemaining: number?,
	localPresentationOffset: Vector3?
): MotionSolveResult
	return {
		velocity = velocity,
		facing = facing,
		finished = finished,
		nextSuggestedState = nextSuggestedState,
		hoverAnchor = hoverAnchor,
		localPresentationOffset = localPresentationOffset,
		lockedChargeDirection = lockedChargeDirection,
		chargeTimeRemaining = chargeTimeRemaining,
		motionOwner = owner,
		debug = buildDebugState(
			context,
			owner,
			velocity,
			hoverAnchor,
			distanceToAnchor,
			lockedChargeDirection,
			chargeTimeRemaining,
			localPresentationOffset
		),
	}
end

local function computeHoverAnchor(
	targetPosition: Vector3,
	targetVelocity: Vector3,
	planeXRaw: any,
	sideSignRaw: any,
	heightRaw: any,
	sideOffsetRaw: any,
	leadMultiplierRaw: any,
	bobAmplitudeRaw: any,
	bobSpeedRaw: any,
	timeRaw: any,
	lateralBobScaleRaw: any?
): Vector3
	local sideSign = if sideSignRaw == -1 then -1 else 1
	local height = sanitizeNumber(heightRaw, 24, 0, 512)
	local sideOffset = sanitizeNumber(sideOffsetRaw, 14, 0, 256)
	local leadMultiplier = sanitizeNumber(leadMultiplierRaw, 0.32, 0, 4)
	local bobAmplitude = sanitizeNumber(bobAmplitudeRaw, 3, 0, 64)
	local bobSpeed = sanitizeNumber(bobSpeedRaw, 4, 0, 50)
	local time = sanitizeNumber(timeRaw, 0, 0, 10 ^ 6)
	local lateralBobScale = sanitizeNumber(lateralBobScaleRaw, 0.22, 0, 2)
	local maxLead = math.max(6, sideOffset * 1.15)
	local leadZ = math.clamp(targetVelocity.Z * leadMultiplier, -maxLead, maxLead)
	local bob = Vector3.new(
		0,
		math.sin(time * bobSpeed) * bobAmplitude,
		math.cos(time * bobSpeed * 0.5) * bobAmplitude * lateralBobScale
	)

	return projectPosition(targetPosition + Vector3.new(0, height, sideOffset * sideSign + leadZ) + bob, planeXRaw)
end

local function rotateFacingOnPlane(baseFacingRaw: any, sideSignRaw: any, angleRadians: number): Vector3
	local sideSign = if sideSignRaw == -1 then -1 else 1
	local baseFacing = if typeof(baseFacingRaw) == "Vector3" then baseFacingRaw else Vector3.new(0, 0, sideSign)
	local yzMagnitude = math.sqrt(baseFacing.Y * baseFacing.Y + baseFacing.Z * baseFacing.Z)
	local normalizedY = 0
	local normalizedZ = sideSign
	if yzMagnitude > 1e-4 then
		normalizedY = baseFacing.Y / yzMagnitude
		normalizedZ = baseFacing.Z / yzMagnitude
	end

	local cosine = math.cos(angleRadians)
	local sine = math.sin(angleRadians)
	return safeUnit(
		Vector3.new(0, normalizedY * cosine - normalizedZ * sine, normalizedY * sine + normalizedZ * cosine),
		Vector3.new(0, 0, sideSign)
	)
end

local function solveHoverMotion(
	context: MotionRuntimeState,
	targetSnapshot: MotionTargetSnapshot?,
	heightRaw: any,
	sideOffsetRaw: any,
	leadMultiplierRaw: any,
	bobAmplitudeRaw: any,
	bobSpeedRaw: any,
	maxSpeedRaw: any,
	accelerationRaw: any,
	dampingRaw: any,
	dt: number,
	owner: string,
	lateralBobScaleRaw: any?
): MotionSolveResult
	local targetPosition = if targetSnapshot ~= nil then targetSnapshot.position else nil
	if targetPosition == nil then
		return createResult(
			context,
			owner,
			dampVelocity(context.velocity, dampingRaw, dt),
			context.facing,
			false,
			nil,
			nil,
			nil,
			nil,
			nil,
			nil
		)
	end

	local hoverAnchor = computeHoverAnchor(
		targetPosition,
		resolveTargetVelocity(targetSnapshot),
		context.planeX,
		context.sideSign,
		heightRaw,
		sideOffsetRaw,
		leadMultiplierRaw,
		bobAmplitudeRaw,
		bobSpeedRaw,
		context.stateTime,
		lateralBobScaleRaw
	)
	local velocity, distanceToAnchor = solveAnchoredVelocity(
		context.position,
		context.velocity,
		hoverAnchor,
		context.planeX,
		maxSpeedRaw,
		accelerationRaw,
		dampingRaw,
		dt
	)
	local facing = resolveFacingTowardTarget(context.position, targetSnapshot, context.facing)
	local localPresentationOffset = Vector3.new(0, math.sin(context.stateTime * 2.8) * 0.12, 0)

	return createResult(
		context,
		owner,
		velocity,
		facing,
		false,
		nil,
		hoverAnchor,
		distanceToAnchor,
		nil,
		nil,
		localPresentationOffset
	)
end

local function solveLockedChargeMotion(
	context: MotionRuntimeState,
	targetSnapshot: MotionTargetSnapshot?,
	owner: string
): MotionSolveResult
	local chargeLock = context.lockedCharge
	local fallbackDirection = resolvePlaneFallback(context.sideSign)
	local lockedDirection = if chargeLock ~= nil then chargeLock.direction else fallbackDirection
	local lockedSpeed = if chargeLock ~= nil then chargeLock.speed else 0
	local lockedDuration = if chargeLock ~= nil then chargeLock.duration else 0
	local chargeTimeRemaining = math.max(0, lockedDuration - context.stateTime)
	local velocity = projectVector(lockedDirection * lockedSpeed, context.planeX)
	local facing =
		safeUnit(lockedDirection, resolveFacingTowardTarget(context.position, targetSnapshot, fallbackDirection))

	return createResult(
		context,
		owner,
		velocity,
		facing,
		context.stateTime >= lockedDuration,
		nil,
		nil,
		nil,
		lockedDirection,
		chargeTimeRemaining,
		nil
	)
end

function EyeOfCthulhuMotion.ComputeIntroSpawnPosition(
	targetPosition: Vector3,
	planeXRaw: any,
	sideSignRaw: any,
	heightRaw: any,
	distanceRaw: any
): Vector3
	local sideSign = if sideSignRaw == -1 then -1 else 1
	local height = sanitizeNumber(heightRaw, 50, 0, 512)
	local distance = sanitizeNumber(distanceRaw, 70, 8, 512)

	return projectPosition(targetPosition + Vector3.new(0, height, distance * sideSign), planeXRaw)
end

function EyeOfCthulhuMotion.CreateChargeLock(
	fromPosition: Vector3,
	targetPosition: Vector3?,
	targetVelocity: Vector3,
	planeXRaw: any,
	predictionTimeRaw: any,
	verticalBiasRaw: any,
	speedRaw: any,
	durationRaw: any,
	fallbackDirectionRaw: any?
): ChargeLock
	local fallbackDirection =
		resolvePlaneFallback(if typeof(fallbackDirectionRaw) == "number" then fallbackDirectionRaw else 1)
	local predictionTime = sanitizeNumber(predictionTimeRaw, 0.16, 0, 4)
	local verticalBias = sanitizeNumber(verticalBiasRaw, 0, -128, 128)
	local speed = sanitizeNumber(speedRaw, 0, 0, 10 ^ 5)
	local duration = sanitizeDuration(durationRaw, 0.5)

	local predictedPosition = nil :: Vector3?
	if targetPosition ~= nil then
		predictedPosition = projectPosition(
			targetPosition + targetVelocity * predictionTime + Vector3.new(0, verticalBias, 0),
			planeXRaw
		)
	end

	local direction = if predictedPosition ~= nil
		then safeUnit(projectVector(predictedPosition - fromPosition, planeXRaw), fallbackDirection)
		else fallbackDirection
	local destination = projectPosition(fromPosition + direction * speed * duration, planeXRaw)

	return {
		direction = direction,
		speed = speed,
		duration = duration,
		destination = destination,
		targetPosition = predictedPosition,
	}
end

function EyeOfCthulhuMotion.SolveSpawnIntroMotion(
	context: MotionRuntimeState,
	targetSnapshot: MotionTargetSnapshot?,
	config: any,
	dt: number
): MotionSolveResult
	local targetPosition = if targetSnapshot ~= nil then targetSnapshot.position else nil
	if targetPosition == nil then
		return createResult(
			context,
			"SpawnIntro",
			dampVelocity(context.velocity, config.phase1HoverDamping, dt),
			context.facing,
			true,
			nil,
			nil,
			nil,
			nil,
			nil,
			nil
		)
	end

	local introDuration = sanitizeDuration(config.introDuration, 2.4)
	local introProgress = math.clamp(context.stateTime / introDuration, 0, 1)
	local descentAlpha = 1 - (1 - introProgress) ^ 3
	local highAnchor = projectPosition(
		targetPosition + Vector3.new(0, config.introHeight * 0.82, config.introDistance * context.sideSign * 0.38),
		context.planeX
	)
	local hoverAnchor = computeHoverAnchor(
		targetPosition,
		resolveTargetVelocity(targetSnapshot),
		context.planeX,
		context.sideSign,
		config.phase1HoverHeight,
		config.phase1SideOffset,
		config.phase1LeadMultiplier,
		config.phase1BobAmplitude * 0.45,
		config.phase1BobSpeed * 0.72,
		context.stateTime,
		0.18
	)
	local desiredAnchor = highAnchor:Lerp(hoverAnchor, descentAlpha)
	local velocity, distanceToAnchor = solveAnchoredVelocity(
		context.position,
		context.velocity,
		desiredAnchor,
		context.planeX,
		config.phase1HoverSpeed * 1.05,
		config.phase1HoverAcceleration,
		config.phase1HoverDamping,
		dt
	)
	local facing = resolveFacingTowardTarget(context.position, targetSnapshot, context.facing)
	local localPresentationOffset = Vector3.new(0, (1 - descentAlpha) * 0.9, 0)

	return createResult(
		context,
		"SpawnIntro",
		velocity,
		facing,
		context.stateTime >= introDuration,
		"Phase1Hover",
		desiredAnchor,
		distanceToAnchor,
		nil,
		nil,
		localPresentationOffset
	)
end

function EyeOfCthulhuMotion.SolvePhase1HoverMotion(
	context: MotionRuntimeState,
	targetSnapshot: MotionTargetSnapshot?,
	config: any,
	dt: number
): MotionSolveResult
	return solveHoverMotion(
		context,
		targetSnapshot,
		config.phase1HoverHeight,
		config.phase1SideOffset,
		config.phase1LeadMultiplier,
		config.phase1BobAmplitude,
		config.phase1BobSpeed,
		config.phase1HoverSpeed,
		config.phase1HoverAcceleration,
		config.phase1HoverDamping,
		dt,
		"Phase1Hover",
		0.18
	)
end

function EyeOfCthulhuMotion.SolveServantBurstMotion(
	context: MotionRuntimeState,
	targetSnapshot: MotionTargetSnapshot?,
	config: any,
	dt: number
): MotionSolveResult
	return solveHoverMotion(
		context,
		targetSnapshot,
		config.phase1HoverHeight,
		config.phase1SideOffset * 0.92,
		config.phase1LeadMultiplier * 0.6,
		config.phase1BobAmplitude * 0.35,
		config.phase1BobSpeed * 0.75,
		config.phase1HoverSpeed * 0.6,
		config.phase1HoverAcceleration * 0.72,
		config.phase1HoverDamping + 0.65,
		dt,
		"Phase1ServantBurst",
		0.08
	)
end

function EyeOfCthulhuMotion.SolveChargeWindupMotion(
	context: MotionRuntimeState,
	targetSnapshot: MotionTargetSnapshot?,
	config: any,
	dt: number
): MotionSolveResult
	local chargeLock = context.lockedCharge
	local lockedDirection = if chargeLock ~= nil then chargeLock.direction else resolvePlaneFallback(context.sideSign)
	local velocity = BossServiceUtils.moveTowardsVector(
		context.velocity,
		ZERO_VECTOR,
		sanitizeNumber(config.brakeAcceleration, 160, 0, 10 ^ 5) * dt
	)
	velocity = dampVelocity(velocity, config.brakeDamping, dt)
	local facing = resolveFacingTowardTarget(context.position, targetSnapshot, lockedDirection)
	local windupDuration = sanitizeDuration(config.duration, 0.35)
	local anticipationAlpha = math.clamp(context.stateTime / windupDuration, 0, 1)
	local localPresentationOffset = lockedDirection * (-0.65 * anticipationAlpha)

	return createResult(
		context,
		"ChargeWindup",
		velocity,
		facing,
		context.stateTime >= windupDuration,
		if context.state == "Phase2ChargeWindup" then "Phase2Charge" else "Phase1Charge",
		nil,
		nil,
		lockedDirection,
		if chargeLock ~= nil then chargeLock.duration else nil,
		localPresentationOffset
	)
end

function EyeOfCthulhuMotion.SolveCommittedChargeMotion(
	context: MotionRuntimeState,
	targetSnapshot: MotionTargetSnapshot?,
	_config: any,
	_dt: number
): MotionSolveResult
	return solveLockedChargeMotion(context, targetSnapshot, "CommittedCharge")
end

function EyeOfCthulhuMotion.SolveRecoveryMotion(
	context: MotionRuntimeState,
	targetSnapshot: MotionTargetSnapshot?,
	config: any,
	dt: number
): MotionSolveResult
	local chargeLock = context.lockedCharge
	local recoverySpeed = sanitizeNumber(config.speed, 0, 0, 10 ^ 5)
	local recoveryAcceleration = sanitizeNumber(config.acceleration, 0, 0, 10 ^ 5)
	local recoveryDamping = sanitizeNumber(config.damping, 0.9, 0, 50)
	local lockedDirection = if chargeLock ~= nil then chargeLock.direction else resolvePlaneFallback(context.sideSign)
	local desiredVelocity = lockedDirection * recoverySpeed
	local velocity = BossServiceUtils.moveTowardsVector(context.velocity, desiredVelocity, recoveryAcceleration * dt)
	velocity = dampVelocity(velocity, recoveryDamping, dt)
	local facing = resolveFacingTowardTarget(context.position, targetSnapshot, lockedDirection)
	local recoveryDuration = sanitizeDuration(config.duration, 0.2)
	local localPresentationOffset = lockedDirection * math.max(0, 0.28 - context.stateTime * 0.4)

	return createResult(
		context,
		"Recovery",
		velocity,
		facing,
		context.stateTime >= recoveryDuration,
		nil,
		nil,
		nil,
		if chargeLock ~= nil then chargeLock.direction else nil,
		nil,
		localPresentationOffset
	)
end

function EyeOfCthulhuMotion.SolveTransformMotion(
	context: MotionRuntimeState,
	targetSnapshot: MotionTargetSnapshot?,
	config: any,
	_dt: number
): MotionSolveResult
	local transformDuration = sanitizeDuration(config.transformDuration, 2.25)
	local progress = math.clamp(context.stateTime / transformDuration, 0, 1)
	local spinAngle = progress * math.pi * 2 * sanitizeNumber(config.transformSpinTurns, 8, 0, 64)
	local facing = rotateFacingOnPlane(context.transformBaseFacing, context.sideSign, spinAngle)
	local localPresentationOffset =
		Vector3.new(0, math.sin(progress * math.pi) * sanitizeNumber(config.transformPauseLift, 8, 0, 128) * 0.35, 0)

	if targetSnapshot ~= nil and targetSnapshot.position ~= nil and progress <= 0.08 then
		facing = resolveFacingTowardTarget(context.position, targetSnapshot, facing)
	end

	return createResult(
		context,
		"Transform",
		ZERO_VECTOR,
		facing,
		context.stateTime >= transformDuration,
		"Phase2HoverIdle",
		nil,
		nil,
		nil,
		nil,
		localPresentationOffset
	)
end

function EyeOfCthulhuMotion.SolvePhase2HoverIdleMotion(
	context: MotionRuntimeState,
	targetSnapshot: MotionTargetSnapshot?,
	config: any,
	dt: number
): MotionSolveResult
	return solveHoverMotion(
		context,
		targetSnapshot,
		config.phase2HoverHeight,
		config.phase2SideOffset,
		config.phase2LeadMultiplier,
		config.phase2BobAmplitude,
		config.phase2BobSpeed,
		config.phase2HoverSpeed,
		config.phase2HoverAcceleration,
		config.phase2HoverDamping,
		dt,
		"Phase2HoverIdle",
		0.12
	)
end

function EyeOfCthulhuMotion.SolvePhase2HoverMotion(
	context: MotionRuntimeState,
	targetSnapshot: MotionTargetSnapshot?,
	config: any,
	dt: number
): MotionSolveResult
	return EyeOfCthulhuMotion.SolvePhase2HoverIdleMotion(context, targetSnapshot, config, dt)
end

function EyeOfCthulhuMotion.SolvePhase2ChargeMotion(
	context: MotionRuntimeState,
	targetSnapshot: MotionTargetSnapshot?,
	_config: any,
	_dt: number
): MotionSolveResult
	return solveLockedChargeMotion(context, targetSnapshot, "Phase2Charge")
end

function EyeOfCthulhuMotion.SolveDespawnMotion(
	context: MotionRuntimeState,
	targetSnapshot: MotionTargetSnapshot?,
	config: any,
	dt: number
): MotionSolveResult
	local riseSpeed = sanitizeNumber(config.despawnRiseSpeed, 120, 0, 10 ^ 5)
	local forwardSpeed = sanitizeNumber(config.despawnForwardSpeed, 42, 0, 10 ^ 5)
	local acceleration = sanitizeNumber(config.despawnAcceleration, 240, 0, 10 ^ 5)
	local awayDirection = Vector3.new(0, 0, if context.sideSign >= 0 then 1 else -1)
	if targetSnapshot ~= nil and targetSnapshot.position ~= nil then
		local planarAway = projectVector(context.position - targetSnapshot.position, context.planeX)
		awayDirection = safeUnit(Vector3.new(0, 0, planarAway.Z), awayDirection)
	end

	local desiredVelocity = Vector3.new(0, riseSpeed, awayDirection.Z * forwardSpeed)
	local velocity = BossServiceUtils.moveTowardsVector(context.velocity, desiredVelocity, acceleration * dt)
	local facing = safeUnit(if velocity.Magnitude > 1e-4 then velocity else desiredVelocity, awayDirection)

	return createResult(
		context,
		"Despawn",
		velocity,
		facing,
		context.stateTime >= 2.8,
		nil,
		nil,
		nil,
		nil,
		nil,
		Vector3.new(0, math.min(context.stateTime * 0.35, 1.5), 0)
	)
end

function EyeOfCthulhuMotion.ComputeRapidChainSpeed(healthRatioRaw: any, baseSpeedRaw: any, topSpeedRaw: any): number
	local healthRatio = math.clamp(sanitizeNumber(healthRatioRaw, 1, 0, 1), 0, 1)
	local baseSpeed = sanitizeNumber(baseSpeedRaw, 110, 0, 10 ^ 5)
	local topSpeed = sanitizeNumber(topSpeedRaw, 154, baseSpeed, 10 ^ 5)
	local pressureAlpha = 1 - healthRatio
	return baseSpeed + (topSpeed - baseSpeed) * pressureAlpha
end

function EyeOfCthulhuMotion.ComputePupilOffset(
	rootPosition: Vector3,
	targetPosition: Vector3?,
	maxOffsetStudsRaw: any
): Vector3
	local maxOffsetStuds = sanitizeNumber(maxOffsetStudsRaw, 0.85, 0, 8)
	if targetPosition == nil then
		return ZERO_VECTOR
	end

	local lookDelta = targetPosition - rootPosition
	local planar = Vector3.new(0, lookDelta.Y, lookDelta.Z)
	if planar.Magnitude <= 1e-4 then
		return ZERO_VECTOR
	end

	local lookUnit = planar.Unit
	return Vector3.new(0, lookUnit.Y * maxOffsetStuds, lookUnit.Z * maxOffsetStuds)
end

function EyeOfCthulhuMotion.ResolveAggressiveDuration(durationRaw: any, aggressivenessRaw: any): number
	local duration = sanitizeDuration(durationRaw, 0.5)
	local aggressiveness = sanitizeNumber(aggressivenessRaw, 1, 0.1, 3)
	return duration / aggressiveness
end

function EyeOfCthulhuMotion.ResolveAggressiveSpeed(speedRaw: any, aggressivenessRaw: any): number
	local speed = sanitizeNumber(speedRaw, 0, 0, 10 ^ 5)
	local aggressiveness = sanitizeNumber(aggressivenessRaw, 1, 0.1, 3)
	return speed * aggressiveness
end

EyeOfCthulhuMotion.computeIntroSpawnPosition = EyeOfCthulhuMotion.ComputeIntroSpawnPosition
EyeOfCthulhuMotion.createChargeLock = EyeOfCthulhuMotion.CreateChargeLock
EyeOfCthulhuMotion.solveSpawnIntroMotion = EyeOfCthulhuMotion.SolveSpawnIntroMotion
EyeOfCthulhuMotion.solvePhase1HoverMotion = EyeOfCthulhuMotion.SolvePhase1HoverMotion
EyeOfCthulhuMotion.solveServantBurstMotion = EyeOfCthulhuMotion.SolveServantBurstMotion
EyeOfCthulhuMotion.solveChargeWindupMotion = EyeOfCthulhuMotion.SolveChargeWindupMotion
EyeOfCthulhuMotion.solveCommittedChargeMotion = EyeOfCthulhuMotion.SolveCommittedChargeMotion
EyeOfCthulhuMotion.solveRecoveryMotion = EyeOfCthulhuMotion.SolveRecoveryMotion
EyeOfCthulhuMotion.solveTransformMotion = EyeOfCthulhuMotion.SolveTransformMotion
EyeOfCthulhuMotion.solvePhase2HoverIdleMotion = EyeOfCthulhuMotion.SolvePhase2HoverIdleMotion
EyeOfCthulhuMotion.solvePhase2HoverMotion = EyeOfCthulhuMotion.SolvePhase2HoverMotion
EyeOfCthulhuMotion.solvePhase2ChargeMotion = EyeOfCthulhuMotion.SolvePhase2ChargeMotion
EyeOfCthulhuMotion.solveDespawnMotion = EyeOfCthulhuMotion.SolveDespawnMotion
EyeOfCthulhuMotion.computeRapidChainSpeed = EyeOfCthulhuMotion.ComputeRapidChainSpeed
EyeOfCthulhuMotion.computePupilOffset = EyeOfCthulhuMotion.ComputePupilOffset
EyeOfCthulhuMotion.resolveAggressiveDuration = EyeOfCthulhuMotion.ResolveAggressiveDuration
EyeOfCthulhuMotion.resolveAggressiveSpeed = EyeOfCthulhuMotion.ResolveAggressiveSpeed

return EyeOfCthulhuMotion
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="1100">
                  <Properties>
                    <string name="Name">Presentation</string>
                    <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")

local AudioRegistry = require(script:FindFirstAncestor("game").Shared.Modules.Items.Audio)
local AudioServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.AudioServiceUtils)
local BossServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.BossServiceUtils)
local EyeOfCthulhuMotion = require(script.Parent.Motion)
local Ripple = require(ReplicatedStorage.Packages.Ripple)

type BossSnapshot = BossServiceUtils.BossSnapshot
type Motion<T> = Ripple.Motion<T>
type SpringOptions = Ripple.SpringOptions

type CameraShakerObject = {
	ShakeOnce: (
		self: CameraShakerObject,
		magnitude: number,
		roughness: number,
		fadeInTime: number?,
		fadeOutTime: number?,
		posInfluence: Vector3?,
		rotInfluence: Vector3?
	) -> (),
}

type PresentationRuntime = {
	model: Model?,
	rootPart: BasePart?,
	snapshot: BossSnapshot,
	cameraShaker: CameraShakerObject?,
	shellMotion: Motion<CFrame>,
	anticipationMotion: Motion<number>,
	recoilMotion: Motion<number>,
	damageMotion: Motion<number>,
	roarMotion: Motion<number>,
	deathMotion: Motion<number>,
	transformMotion: Motion<number>,
	startedAt: number,
	lastDashPulseToken: number,
	lastDamagePulseToken: number,
	lastRoarPulseToken: number,
	lastTransformPulseToken: number,
	lastDeathPulseToken: number,
	lastServantPulseToken: number,
	partRefs: {
		iris: BasePart?,
		pupil: BasePart?,
		jaw: BasePart?,
	},
	soundRefs: {
		roar: Sound?,
	},
	createdRuntimeSounds: { [Sound]: boolean },
	deformParts: { BasePart },
	baseLocalCFrames: { [BasePart]: CFrame },
}

local EyeOfCthulhuPresentation = {}
local EYE_ROAR_SOUND_ID =
	AudioServiceUtils.resolveSoundAssetId((((AudioRegistry :: any).Npcs :: any).Bosses :: any).EyeOfCthulhu.roar)

local SHELL_SPRING: SpringOptions = {
	frequency = 5.2,
	damping = 0.82,
}

local IMPULSE_SPRING: SpringOptions = {
	frequency = 6.4,
	damping = 0.76,
}

local function resolvePartRefs(
	model: Model?
): ({ [string]: BasePart? }, { BasePart }, { [BasePart]: CFrame }, BasePart?)
	local refs = {
		iris = nil :: BasePart?,
		pupil = nil :: BasePart?,
		jaw = nil :: BasePart?,
	}
	local deformParts = {}
	local baseLocalCFrames: { [BasePart]: CFrame } = {}
	if model == nil then
		return refs, deformParts, baseLocalCFrames, nil
	end

	local rootPart = BossServiceUtils.resolveRootPart(model)
	if rootPart == nil then
		return refs, deformParts, baseLocalCFrames, nil
	end

	local iris = BossServiceUtils.findFirstDescendantByNormalizedName(model, { "Iris", "Eye", "PupilSocket" })
	if iris ~= nil and iris:IsA("BasePart") then
		refs.iris = iris
	end
	local pupil = BossServiceUtils.findFirstDescendantByNormalizedName(model, { "Pupil", "PupilCore", "EyePupil" })
	if pupil ~= nil and pupil:IsA("BasePart") then
		refs.pupil = pupil
	end
	local jaw = BossServiceUtils.findFirstDescendantByNormalizedName(model, { "Jaw", "Mouth", "Teeth" })
	if jaw ~= nil and jaw:IsA("BasePart") then
		refs.jaw = jaw
	end

	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") and descendant ~= rootPart then
			baseLocalCFrames[descendant] = rootPart.CFrame:ToObjectSpace(descendant.CFrame)
			table.insert(deformParts, descendant)
		end
	end

	return refs, deformParts, baseLocalCFrames, rootPart
end

local function resolveTargetPosition(snapshot: BossSnapshot): Vector3?
	local targetUserId = snapshot.targetUserId
	if targetUserId == nil then
		return nil
	end

	local player = Players:GetPlayerByUserId(targetUserId)
	if player == nil then
		return nil
	end

	local rootPart = BossServiceUtils.resolveCharacterRootPart(player)
	if rootPart == nil then
		return nil
	end
	return rootPart.Position
end

local function restartSound(sound: Sound)
	pcall(function()
		sound:Stop()
		sound.TimePosition = 0
		sound:Play()
	end)
end

local function playModelSound(runtime: PresentationRuntime, candidateNames: { string })
	local model = runtime.model
	if model == nil then
		return
	end

	local sound = BossServiceUtils.findFirstDescendantByNormalizedName(model, candidateNames)
	if sound ~= nil and sound:IsA("Sound") then
		restartSound(sound :: Sound)
	end
end

local function ensureRoarSound(runtime: PresentationRuntime): Sound?
	local roarSound = runtime.soundRefs.roar
	if roarSound ~= nil and roarSound.Parent ~= nil then
		return roarSound
	end

	local model = runtime.model
	if model == nil then
		return nil
	end

	local existingSound = BossServiceUtils.findFirstDescendantByNormalizedName(model, { "Roar" })
	if existingSound ~= nil and existingSound:IsA("Sound") then
		runtime.soundRefs.roar = existingSound :: Sound
		return runtime.soundRefs.roar
	end

	local rootPart = runtime.rootPart
	if rootPart == nil or EYE_ROAR_SOUND_ID == nil then
		return nil
	end

	local categoryGroups = AudioServiceUtils.ensureCategoryGroups(SoundService)
	local createdSound = AudioServiceUtils.createSoundInstance(EYE_ROAR_SOUND_ID, {
		category = "SFX",
		volume = 1,
		rollOffMaxDistance = 120,
		emitterSize = 10,
		autoDestroy = false,
		parent = rootPart,
	}, rootPart, categoryGroups.SFX)
	if createdSound == nil then
		return nil
	end

	createdSound.Name = "Roar"
	runtime.soundRefs.roar = createdSound
	runtime.createdRuntimeSounds[createdSound] = true
	return createdSound
end

local function playRoarSound(runtime: PresentationRuntime)
	local roarSound = ensureRoarSound(runtime)
	if roarSound ~= nil then
		restartSound(roarSound)
		return
	end

	playModelSound(runtime, { "Roar", "Scream", "Transform" })
end

local function shake(runtime: PresentationRuntime, magnitude: number, roughness: number, fadeOut: number)
	local cameraShaker = runtime.cameraShaker
	if cameraShaker == nil then
		return
	end
	pcall(function()
		cameraShaker:ShakeOnce(
			magnitude,
			roughness,
			0.03,
			fadeOut,
			Vector3.new(0.14, 0.14, 0.14),
			Vector3.new(0.8, 0.4, 0.4)
		)
	end)
end

local function getSuggestedOffset(snapshot: BossSnapshot): Vector3
	local motion = snapshot.motion
	if motion.localPresentationOffset ~= nil then
		return motion.localPresentationOffset
	end
	return Vector3.zero
end

local function computeShellTarget(
	snapshot: BossSnapshot,
	anticipation: number,
	recoil: number,
	damage: number,
	roar: number,
	transform: number,
	death: number
): CFrame
	local stateTime = snapshot.stateTime
	local hoverLift = if snapshot.state == "SpawnIntro"
		then math.sin(stateTime * 2.1) * 0.55
		else if snapshot.state == "Phase1Hover" or snapshot.state == "Phase1ServantBurst"
			then math.sin(stateTime * 3.9) * 0.22
			else if snapshot.state == "Phase2HoverIdle" or snapshot.state == "Phase2Hover"
				then math.sin(stateTime * 5.1) * 0.14
				else 0
	local suggestedOffset = getSuggestedOffset(snapshot)
	local forwardOffset = anticipation * -1.1 + recoil * 1.45
	local verticalOffset = hoverLift + roar * 0.95 + transform * 1.25 - death * 1.55 + damage * 0.22
	local shellOffset = suggestedOffset + Vector3.new(0, verticalOffset, forwardOffset)
	local shellTilt = CFrame.Angles(
		math.rad((recoil - anticipation * 0.7 + roar * 0.35) * 10),
		0,
		math.rad(damage * math.sin(os.clock() * 28) * 3.2)
	)

	return CFrame.new(shellOffset) * shellTilt
end

function EyeOfCthulhuPresentation.CreateRuntime(
	modelRaw: any,
	snapshot: BossSnapshot,
	cameraShaker: CameraShakerObject?
): PresentationRuntime
	local model = if typeof(modelRaw) == "Instance" and modelRaw:IsA("Model") then modelRaw else nil
	local partRefs, deformParts, baseLocalCFrames, rootPart = resolvePartRefs(model)
	local soundRefs: { roar: Sound? } = {
		roar = nil :: Sound?,
	}
	local createdRuntimeSounds: { [Sound]: boolean } = {}

	local runtime: PresentationRuntime = {
		model = model,
		rootPart = rootPart,
		snapshot = snapshot,
		cameraShaker = cameraShaker,
		shellMotion = Ripple.createMotion(CFrame.new()),
		anticipationMotion = Ripple.createMotion(0),
		recoilMotion = Ripple.createMotion(0),
		damageMotion = Ripple.createMotion(0),
		roarMotion = Ripple.createMotion(0),
		deathMotion = Ripple.createMotion(0),
		transformMotion = Ripple.createMotion(0),
		startedAt = os.clock(),
		lastDashPulseToken = snapshot.presentation.dashPulseToken,
		lastDamagePulseToken = snapshot.presentation.damagePulseToken,
		lastRoarPulseToken = snapshot.presentation.roarPulseToken,
		lastTransformPulseToken = snapshot.presentation.transformPulseToken,
		lastDeathPulseToken = snapshot.presentation.deathPulseToken,
		lastServantPulseToken = snapshot.presentation.servantPulseToken,
		partRefs = partRefs,
		soundRefs = soundRefs,
		createdRuntimeSounds = createdRuntimeSounds,
		deformParts = deformParts,
		baseLocalCFrames = baseLocalCFrames,
	}

	ensureRoarSound(runtime)
	return runtime
end

function EyeOfCthulhuPresentation.ApplySnapshot(runtime: PresentationRuntime, snapshot: BossSnapshot)
	runtime.snapshot = snapshot

	if snapshot.presentation.dashPulseToken ~= runtime.lastDashPulseToken then
		runtime.lastDashPulseToken = snapshot.presentation.dashPulseToken
		runtime.anticipationMotion:immediate(1)
		runtime.recoilMotion:immediate(0.95)
		playModelSound(runtime, { "Charge", "Dash" })
		shake(runtime, 1.25, 12, 0.18)
	end

	if snapshot.presentation.damagePulseToken ~= runtime.lastDamagePulseToken then
		runtime.lastDamagePulseToken = snapshot.presentation.damagePulseToken
		runtime.damageMotion:immediate(1)
	end

	if snapshot.presentation.roarPulseToken ~= runtime.lastRoarPulseToken then
		runtime.lastRoarPulseToken = snapshot.presentation.roarPulseToken
		runtime.roarMotion:immediate(1)
		playRoarSound(runtime)
		shake(runtime, 1.8, 10, 0.3)
	end

	if snapshot.presentation.transformPulseToken ~= runtime.lastTransformPulseToken then
		runtime.lastTransformPulseToken = snapshot.presentation.transformPulseToken
		runtime.transformMotion:immediate(1)
		shake(runtime, 2.25, 8, 0.45)
	end

	if snapshot.presentation.deathPulseToken ~= runtime.lastDeathPulseToken then
		runtime.lastDeathPulseToken = snapshot.presentation.deathPulseToken
		runtime.deathMotion:immediate(1)
		playModelSound(runtime, { "Death", "Roar", "Impact" })
		shake(runtime, 2.75, 7.5, 0.55)
	end

	if snapshot.presentation.servantPulseToken ~= runtime.lastServantPulseToken then
		runtime.lastServantPulseToken = snapshot.presentation.servantPulseToken
		shake(runtime, 0.7, 14, 0.08)
	end
end

function EyeOfCthulhuPresentation.Step(runtime: PresentationRuntime, dtRaw: any)
	local model = runtime.model
	if model == nil or model.Parent == nil then
		return
	end

	local dt = BossServiceUtils.sanitizeNumber(dtRaw, 1 / 60, 0, 1)
	local snapshot = runtime.snapshot
	local rootPart = BossServiceUtils.resolveRootPart(model)
	if rootPart ~= nil then
		runtime.rootPart = rootPart
	else
		rootPart = runtime.rootPart
	end
	if rootPart == nil then
		return
	end
	ensureRoarSound(runtime)

	runtime.anticipationMotion:spring(0, IMPULSE_SPRING)
	runtime.recoilMotion:spring(0, IMPULSE_SPRING)
	runtime.damageMotion:spring(0, IMPULSE_SPRING)
	runtime.roarMotion:spring(0, IMPULSE_SPRING)
	runtime.deathMotion:spring(0, {
		frequency = 2.5,
		damping = 0.9,
	})
	runtime.transformMotion:spring(0, {
		frequency = 3.3,
		damping = 0.78,
	})

	local anticipation = runtime.anticipationMotion:step(dt)
	local recoil = runtime.recoilMotion:step(dt)
	local damage = math.min(runtime.damageMotion:step(dt), 1.1)
	local roar = runtime.roarMotion:step(dt)
	local death = runtime.deathMotion:step(dt)
	local transform = runtime.transformMotion:step(dt)
	local desiredShell = computeShellTarget(snapshot, anticipation, recoil, damage, roar, transform, death)
	runtime.shellMotion:spring(desiredShell, SHELL_SPRING)
	local shellCFrame = runtime.shellMotion:step(dt)

	for _, part in runtime.deformParts do
		if part.Parent == nil then
			continue
		end

		local base = runtime.baseLocalCFrames[part]
		if base ~= nil then
			part.CFrame = rootPart.CFrame * shellCFrame * base
		end
	end

	local targetPosition = resolveTargetPosition(snapshot)
	local pupilOffset = EyeOfCthulhuMotion.computePupilOffset(rootPart.Position, targetPosition, 0.85)

	local iris = runtime.partRefs.iris
	if iris ~= nil and iris.Parent ~= nil then
		local base = runtime.baseLocalCFrames[iris]
		if base ~= nil then
			iris.CFrame = rootPart.CFrame
				* shellCFrame
				* base
				* CFrame.new(Vector3.new(0, pupilOffset.Y * 0.35, pupilOffset.Z * 0.35))
		end
	end

	local pupil = runtime.partRefs.pupil
	if pupil ~= nil and pupil.Parent ~= nil then
		local base = runtime.baseLocalCFrames[pupil]
		if base ~= nil then
			pupil.CFrame = rootPart.CFrame * shellCFrame * base * CFrame.new(pupilOffset)
		end
	end

	local jaw = runtime.partRefs.jaw
	if jaw ~= nil and jaw.Parent ~= nil then
		local base = runtime.baseLocalCFrames[jaw]
		if base ~= nil then
			local jawOpenAlpha = if snapshot.phase <= 1
				then roar * 0.3 + transform * 0.45
				else roar * 0.85 + transform * 0.72 + anticipation * 0.15
			jaw.CFrame = rootPart.CFrame
				* shellCFrame
				* base
				* CFrame.new(0, -jawOpenAlpha * 0.4, -jawOpenAlpha * 0.18)
				* CFrame.Angles(math.rad(jawOpenAlpha * 14), 0, 0)
		end
	end
end

function EyeOfCthulhuPresentation.Destroy(runtime: PresentationRuntime)
	local model = runtime.model
	local rootPart = runtime.rootPart
	if model ~= nil and model.Parent ~= nil and rootPart ~= nil and rootPart.Parent ~= nil then
		for part, localCFrame in runtime.baseLocalCFrames do
			if part.Parent ~= nil then
				part.CFrame = rootPart.CFrame * localCFrame
			end
		end
	end

	for sound in runtime.createdRuntimeSounds do
		if sound.Parent ~= nil then
			sound:Destroy()
		end
		runtime.createdRuntimeSounds[sound] = nil
	end

	runtime.shellMotion:destroy()
	runtime.anticipationMotion:destroy()
	runtime.recoilMotion:destroy()
	runtime.damageMotion:destroy()
	runtime.roarMotion:destroy()
	runtime.deathMotion:destroy()
	runtime.transformMotion:destroy()
end

EyeOfCthulhuPresentation.createRuntime = EyeOfCthulhuPresentation.CreateRuntime
EyeOfCthulhuPresentation.applySnapshot = EyeOfCthulhuPresentation.ApplySnapshot
EyeOfCthulhuPresentation.step = EyeOfCthulhuPresentation.Step
EyeOfCthulhuPresentation.destroy = EyeOfCthulhuPresentation.Destroy

return EyeOfCthulhuPresentation
]]></string>
                  </Properties>
                </Item>
              </Item>
            </Item>
            <Item class="ModuleScript" referent="1101">
              <Properties>
                <string name="Name">Camera</string>
                <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Configs = require(script:FindFirstAncestor("game").Shared.Modules.Core.Configs)
local SideView = require(script.SideView)

local Camera = {}
Camera.__index = Camera

export type SideViewNewConfig = {
	config: SideView.SideViewConfig?,
	target: any?,
	character: Model?,
	autoEnable: boolean?,
	snapToTargetOnInit: boolean?,
}

export type CameraNewConfig = {
	SideView: SideViewNewConfig?,
}

export type Camera = typeof(setmetatable(
	{} :: {
		SideView: SideView.SideView,
	},
	Camera
))

local function mergeNestedTable(
	merged: SideView.SideViewConfig,
	base: SideView.SideViewConfig?,
	override: SideView.SideViewConfig?,
	key: string
)
	local baseValue = if base then (base :: any)[key] else nil
	local overrideValue = if override then (override :: any)[key] else nil
	if typeof(baseValue) ~= "table" and typeof(overrideValue) ~= "table" then
		return
	end

	(merged :: any)[key] = {}
	if typeof(baseValue) == "table" then
		for nestedKey, nestedValue in baseValue do
			((merged :: any)[key] :: any)[nestedKey] = nestedValue
		end
	end
	if typeof(overrideValue) == "table" then
		for nestedKey, nestedValue in overrideValue do
			((merged :: any)[key] :: any)[nestedKey] = nestedValue
		end
	end
end

local function mergeSideViewConfig(
	base: SideView.SideViewConfig?,
	override: SideView.SideViewConfig?
): SideView.SideViewConfig
	local merged: SideView.SideViewConfig = {}

	if base then
		for key, value in base do
			(merged :: any)[key] = value
		end
	end

	if override then
		for key, value in override do
			(merged :: any)[key] = value
		end
	end

	if base and base.cameraSpring then
		merged.cameraSpring = {}
		for key, value in base.cameraSpring do
			(merged.cameraSpring :: any)[key] = value
		end
	end
	if override and override.cameraSpring then
		if not merged.cameraSpring then
			merged.cameraSpring = {}
		end
		for key, value in override.cameraSpring do
			(merged.cameraSpring :: any)[key] = value
		end
	end

	if base and base.fovSpring then
		merged.fovSpring = {}
		for key, value in base.fovSpring do
			(merged.fovSpring :: any)[key] = value
		end
	end
	if override and override.fovSpring then
		if not merged.fovSpring then
			merged.fovSpring = {}
		end
		for key, value in override.fovSpring do
			(merged.fovSpring :: any)[key] = value
		end
	end

	mergeNestedTable(merged, base, override, "room")
	mergeNestedTable(merged, base, override, "catchUpPlayer")
	mergeNestedTable(merged, base, override, "predict")

	return merged
end

function Camera.New(config: CameraNewConfig?): Camera
	local sideViewNewConfig = if config then config.SideView else nil
	local sideViewBaseConfig = Configs.cameraData :: SideView.SideViewConfig
	local sideViewConfig =
		mergeSideViewConfig(sideViewBaseConfig, if sideViewNewConfig then sideViewNewConfig.config else nil)
	local sideView = SideView.new(sideViewConfig)

	if sideViewNewConfig and sideViewNewConfig.character then
		sideView:setCharacter(sideViewNewConfig.character)
	end

	if sideViewNewConfig and sideViewNewConfig.target ~= nil then
		if sideViewNewConfig.autoEnable == false then
			sideView:setTarget(sideViewNewConfig.target)
		else
			sideView:init(sideViewNewConfig.target, nil, {
				snapToTarget = if sideViewNewConfig.snapToTargetOnInit ~= nil
					then sideViewNewConfig.snapToTargetOnInit
					else true,
			})
		end
	end

	return setmetatable({
		SideView = sideView,
	}, Camera)
end

function Camera.Init(self: Camera) end

function Camera.UseSideView(
	self: Camera,
	target: any?,
	config: SideView.SideViewConfig?,
	snapToTarget: boolean?
): SideView.SideView
	self.SideView:init(target, config, {
		snapToTarget = if snapToTarget ~= nil then snapToTarget else not self.SideView.enabled,
	})
	return self.SideView
end

function Camera.ConfigureSideView(self: Camera, config: SideView.SideViewConfig): SideView.SideView
	self.SideView:applyConfig(config)
	return self.SideView
end

function Camera.SetSideViewCharacter(self: Camera, character: Model?)
	self.SideView:setCharacter(character)
	return self.SideView
end

function Camera.PushSideViewOverride(self: Camera, overrideRaw: any): number
	return self.SideView:pushOverride(overrideRaw)
end

function Camera.UpdateSideViewOverride(self: Camera, idRaw: any, patchRaw: any): boolean
	return self.SideView:updateOverride(idRaw, patchRaw)
end

function Camera.RemoveSideViewOverride(self: Camera, idRaw: any): boolean
	return self.SideView:removeOverride(idRaw)
end

function Camera.ClearSideViewOverrides(self: Camera)
	self.SideView:clearOverrides()
	return self.SideView
end

function Camera.SetTemporarySideViewTarget(self: Camera, targetRaw: any?, durationSecondsRaw: any?)
	self.SideView:setTemporaryTargetOverride(targetRaw, durationSecondsRaw)
	return self.SideView
end

function Camera.ClearTemporarySideViewTarget(self: Camera)
	self.SideView:clearTemporaryTargetOverride()
	return self.SideView
end

function Camera.GetSideViewBackendState(self: Camera): { [string]: any }
	return self.SideView:getBackendState()
end

function Camera.DisableSideView(self: Camera)
	self.SideView:disable()
end

function Camera.Destroy(self: Camera)
	self.SideView:destroy()
end

Camera.new = Camera.New
Camera.init = Camera.Init
Camera.useSideView = Camera.UseSideView
Camera.configureSideView = Camera.ConfigureSideView
Camera.setSideViewCharacter = Camera.SetSideViewCharacter
Camera.pushSideViewOverride = Camera.PushSideViewOverride
Camera.updateSideViewOverride = Camera.UpdateSideViewOverride
Camera.removeSideViewOverride = Camera.RemoveSideViewOverride
Camera.clearSideViewOverrides = Camera.ClearSideViewOverrides
Camera.setTemporarySideViewTarget = Camera.SetTemporarySideViewTarget
Camera.clearTemporarySideViewTarget = Camera.ClearTemporarySideViewTarget
Camera.getSideViewBackendState = Camera.GetSideViewBackendState
Camera.disableSideView = Camera.DisableSideView
Camera.destroy = Camera.Destroy

return Camera
]]></string>
              </Properties>
              <Item class="Folder" referent="1102">
                <Properties>
                  <string name="Name">Behavior</string>
                </Properties>
                <Item class="ModuleScript" referent="1103">
                  <Properties>
                    <string name="Name">bossSubject</string>
                    <string name="Source"><![CDATA[--!strict

local Target = require(script.Parent.Parent.Target)

local BossSubject = {}

export type BossSubjectOptions = {
	runtimeId: string?,
	bossId: string?,
	encounterChannel: string?,
	target: any?,
}

function BossSubject.Resolve(optionsRaw: BossSubjectOptions?): Target.ResolvedTarget?
	local resolver = Target.new({
		target = optionsRaw,
	})
	return resolver:resolveAny(optionsRaw, "Boss")
end

function BossSubject.New(optionsRaw: BossSubjectOptions?): BossSubjectOptions
	return optionsRaw or {}
end

BossSubject.resolve = BossSubject.Resolve
BossSubject.new = BossSubject.New

return BossSubject
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="1104">
                  <Properties>
                    <string name="Name">catchUpPlayer</string>
                    <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Configs = require(script:FindFirstAncestor("game").Shared.Modules.Core.Configs)

local CatchUpPlayer = {}
CatchUpPlayer.__index = CatchUpPlayer

export type SpringOptions = {
	damping: number?,
	frequency: number?,
	mass: number?,
	tension: number?,
	friction: number?,
	position: number?,
	velocity: number?,
	impulse: number?,
	restingVelocity: number?,
	restingPosition: number?,
}

export type CatchUpPlayerConfig = {
	enabled: boolean?,
	startDistance: number?,
	maxDistance: number?,
	accelerationSeconds: number?,
	minFrequencyDivisor: number?,
	maxFrequencyDivisor: number?,
	minFrequencyMultiplier: number?,
	maxFrequencyMultiplier: number?,
}

export type CatchUpPlayer = typeof(setmetatable(
	{} :: {
		enabled: boolean,
		startDistance: number,
		maxDistance: number,
		accelerationSeconds: number,
		minFrequencyDivisor: number,
		maxFrequencyDivisor: number,
		activeDuration: number,
		peakGapDistance: number,
	},
	CatchUpPlayer
))

local DEFAULT_CONFIG = ((Configs.cameraData :: any).catchUpPlayer or {}) :: CatchUpPlayerConfig
local ACCELERATION_DISTANCE_DURATION_MULTIPLIER = 2

local function clampNumber(value: any, min: number, max: number, fallback: number): number
	if typeof(value) ~= "number" then
		return fallback
	end
	if value ~= value then
		return fallback
	end

	return math.clamp(value, min, max)
end

local function resolveConfiguredNumber(
	source: any,
	primaryKey: string,
	legacyKey: string?,
	min: number,
	max: number,
	fallback: number
): number
	local sourceAny = source :: any
	local value = sourceAny[primaryKey]
	if legacyKey and typeof(value) ~= "number" then
		value = sourceAny[legacyKey]
	end

	return clampNumber(value, min, max, fallback)
end

local function sanitizeConfig(config: any, fallbackConfig: CatchUpPlayerConfig?): CatchUpPlayerConfig
	local source = if typeof(config) == "table" then config else {}
	local fallback = if typeof(fallbackConfig) == "table" then fallbackConfig else {}

	local defaultEnabled = if typeof((fallback :: any).enabled) == "boolean" then (fallback :: any).enabled else true
	local startDistance =
		clampNumber((source :: any).startDistance, 0, 500, clampNumber((fallback :: any).startDistance, 0, 500, 24))
	local maxDistance =
		clampNumber((source :: any).maxDistance, 1, 2000, clampNumber((fallback :: any).maxDistance, 1, 2000, 140))
	local accelerationSeconds = clampNumber(
		(source :: any).accelerationSeconds,
		0.05,
		10,
		clampNumber((fallback :: any).accelerationSeconds, 0.05, 10, 0.9)
	)
	local minFrequencyDivisor = resolveConfiguredNumber(
		source,
		"minFrequencyDivisor",
		"minFrequencyMultiplier",
		1,
		50,
		resolveConfiguredNumber(fallback, "minFrequencyDivisor", "minFrequencyMultiplier", 1, 50, 2.2)
	)
	local maxFrequencyDivisor = resolveConfiguredNumber(
		source,
		"maxFrequencyDivisor",
		"maxFrequencyMultiplier",
		minFrequencyDivisor,
		50,
		resolveConfiguredNumber(fallback, "maxFrequencyDivisor", "maxFrequencyMultiplier", minFrequencyDivisor, 50, 6)
	)

	return {
		enabled = if typeof((source :: any).enabled) == "boolean" then (source :: any).enabled else defaultEnabled,
		startDistance = startDistance,
		maxDistance = math.max(maxDistance, startDistance + 1),
		accelerationSeconds = accelerationSeconds,
		minFrequencyDivisor = minFrequencyDivisor,
		maxFrequencyDivisor = maxFrequencyDivisor,
	}
end

local function cloneSpringOptions(baseSpring: SpringOptions): SpringOptions
	local clone: SpringOptions = {}
	for key, value in baseSpring do
		(clone :: any)[key] = value
	end

	return clone
end

local function resolveBaseFrequency(baseSpring: SpringOptions): number?
	local frequency = baseSpring.frequency
	if typeof(frequency) ~= "number" then
		return nil
	end
	if frequency ~= frequency or frequency <= 0 then
		return nil
	end

	return frequency
end

function CatchUpPlayer.New(config: CatchUpPlayerConfig?): CatchUpPlayer
	local resolvedConfig = sanitizeConfig(config, DEFAULT_CONFIG)

	return setmetatable({
		enabled = resolvedConfig.enabled == true,
		startDistance = resolvedConfig.startDistance :: number,
		maxDistance = resolvedConfig.maxDistance :: number,
		accelerationSeconds = resolvedConfig.accelerationSeconds :: number,
		minFrequencyDivisor = resolvedConfig.minFrequencyDivisor :: number,
		maxFrequencyDivisor = resolvedConfig.maxFrequencyDivisor :: number,
		activeDuration = 0,
		peakGapDistance = 0,
	}, CatchUpPlayer)
end

function CatchUpPlayer.Reset(self: CatchUpPlayer)
	self.activeDuration = 0
	self.peakGapDistance = 0
end

function CatchUpPlayer.ApplyConfig(self: CatchUpPlayer, config: CatchUpPlayerConfig?)
	local currentConfig: CatchUpPlayerConfig = {
		enabled = self.enabled,
		startDistance = self.startDistance,
		maxDistance = self.maxDistance,
		accelerationSeconds = self.accelerationSeconds,
		minFrequencyDivisor = self.minFrequencyDivisor,
		maxFrequencyDivisor = self.maxFrequencyDivisor,
	}
	local resolvedConfig = sanitizeConfig(config, currentConfig)

	self.enabled = resolvedConfig.enabled == true
	self.startDistance = resolvedConfig.startDistance :: number
	self.maxDistance = resolvedConfig.maxDistance :: number
	self.accelerationSeconds = resolvedConfig.accelerationSeconds :: number
	self.minFrequencyDivisor = resolvedConfig.minFrequencyDivisor :: number
	self.maxFrequencyDivisor = resolvedConfig.maxFrequencyDivisor :: number
	self:reset()
end

function CatchUpPlayer.ResolveSpring(
	self: CatchUpPlayer,
	baseSpring: SpringOptions,
	currentCFrame: CFrame,
	targetCFrame: CFrame,
	deltaTime: number?
): SpringOptions
	if not self.enabled then
		self:reset()
		return baseSpring
	end

	local baseFrequency = resolveBaseFrequency(baseSpring)
	if not baseFrequency then
		self:reset()
		return baseSpring
	end

	local gapDistance = (currentCFrame.Position - targetCFrame.Position).Magnitude
	if gapDistance <= self.startDistance then
		self:reset()
		return baseSpring
	end

	local dt = if typeof(deltaTime) == "number" and deltaTime > 0 then deltaTime else (1 / 60)
	self.activeDuration += dt
	self.peakGapDistance = math.max(self.peakGapDistance, gapDistance)

	local distanceAlpha =
		math.clamp((gapDistance - self.startDistance) / math.max(self.maxDistance - self.startDistance, 0.001), 0, 1)
	local peakDistanceAlpha = math.clamp(
		(self.peakGapDistance - self.startDistance) / math.max(self.maxDistance - self.startDistance, 0.001),
		0,
		1
	)
	local accelerationDuration = self.accelerationSeconds
		* (1 + (peakDistanceAlpha * ACCELERATION_DISTANCE_DURATION_MULTIPLIER))
	local durationAlpha = math.clamp(self.activeDuration / math.max(accelerationDuration, 0.001), 0, 1)
	local minimumDivisor = 1 + ((self.minFrequencyDivisor - 1) * distanceAlpha)
	local maximumDivisor = 1 + ((self.maxFrequencyDivisor - 1) * distanceAlpha)
	local frequencyDivisor = minimumDivisor + ((maximumDivisor - minimumDivisor) * durationAlpha)

	local catchUpSpring = cloneSpringOptions(baseSpring)
	catchUpSpring.frequency = math.max(baseFrequency / math.max(frequencyDivisor, 1), 0.001)
	catchUpSpring.tension = nil
	catchUpSpring.friction = nil

	return catchUpSpring
end

CatchUpPlayer.new = CatchUpPlayer.New
CatchUpPlayer.reset = CatchUpPlayer.Reset
CatchUpPlayer.applyConfig = CatchUpPlayer.ApplyConfig
CatchUpPlayer.resolveSpring = CatchUpPlayer.ResolveSpring

return CatchUpPlayer
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="1105">
                  <Properties>
                    <string name="Name">cutsceneSubject</string>
                    <string name="Source"><![CDATA[--!strict

local Target = require(script.Parent.Parent.Target)

local CutsceneSubject = {}

export type CutsceneSubjectOptions = {
	target: any?,
	position: Vector3?,
	lookPosition: Vector3?,
	durationSeconds: number?,
	expiresAt: number?,
}

function CutsceneSubject.Resolve(optionsRaw: CutsceneSubjectOptions?): Target.ResolvedTarget?
	local resolver = Target.new({
		target = optionsRaw,
	})
	return resolver:resolveAny(optionsRaw, "Cutscene")
end

function CutsceneSubject.New(optionsRaw: CutsceneSubjectOptions?): CutsceneSubjectOptions
	return optionsRaw or {}
end

CutsceneSubject.resolve = CutsceneSubject.Resolve
CutsceneSubject.new = CutsceneSubject.New

return CutsceneSubject
