                      <string name="Name">markerSlice</string>
                      <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Sift = require(ReplicatedStorage.Packages.Sift)

local BossServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.BossServiceUtils)
local Charm = require(ReplicatedStorage.Packages.Charm)

export type MarkerState = BossServiceUtils.BossServiceState
type BossSnapshot = BossServiceUtils.BossSnapshot

local markerStateAtom: Charm.Atom<MarkerState> = Charm.atom(BossServiceUtils.createDefaultState())
local markerReadyAtom: Charm.Atom<boolean> = Charm.atom(false)

local aliveBossesAtom: Charm.Selector<{ BossSnapshot }> = Charm.computed(function(): { BossSnapshot }
	local state = markerStateAtom()
	local aliveBosses = Sift.Array.create(#state.orderedIds)

	for _, runtimeId in state.orderedIds do
		local snapshot = state.byId[runtimeId]
		if snapshot ~= nil and snapshot.isAlive == true then
			aliveBosses = Sift.Array.append(aliveBosses, snapshot)
		end
	end

	return aliveBosses
end)

local activeBossCountAtom: Charm.Selector<number> = Charm.computed(function(): number
	return #aliveBossesAtom()
end)

local function getMarkerState(): MarkerState
	return markerStateAtom()
end

local function setMarkerState(stateRaw: any): MarkerState
	local nextState = BossServiceUtils.sanitizeState(stateRaw, markerStateAtom())
	markerStateAtom(nextState)
	return nextState
end

local function resetMarkerState(): MarkerState
	local nextState = BossServiceUtils.createDefaultState()
	markerStateAtom(nextState)
	return nextState
end

local function isMarkerReady(): boolean
	return markerReadyAtom()
end

local function setMarkerReady(isReadyRaw: any): boolean
	local nextReady = isReadyRaw == true
	markerReadyAtom(nextReady)
	return nextReady
end

return {
	markerStateAtom = markerStateAtom,
	markerReadyAtom = markerReadyAtom,
	aliveBossesAtom = aliveBossesAtom,
	activeBossCountAtom = activeBossCountAtom,
	getMarkerState = getMarkerState,
	setMarkerState = setMarkerState,
	resetMarkerState = resetMarkerState,
	isMarkerReady = isMarkerReady,
	setMarkerReady = setMarkerReady,
}
]]></string>
                    </Properties>
                  </Item>
                  <Item class="ModuleScript" referent="857">
                    <Properties>
                      <string name="Name">markerThunks</string>
                      <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local BossServiceClient = require(script:FindFirstAncestor("game").Client.Services.BossServiceClient)
local BossServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.BossServiceUtils)
local ConnectionUtils = require(script:FindFirstAncestor("game").Client.UI.core.utils.ConnectionUtils)
local ServiceSync = require(script:FindFirstAncestor("game").Client.UI.core.utils.ServiceSync)
local markerSlice = require(script:FindFirstAncestor("game").Client.UI.features.boss.state.markerSlice)

type MarkerState = BossServiceUtils.BossServiceState

local markerThunks = {}

local runtime = {
	started = false,
	stateChangedConnection = nil :: RBXScriptConnection?,
}

local function applyState(nextStateRaw: any): MarkerState
	return markerSlice.setMarkerState(nextStateRaw)
end

local function syncFromService(): MarkerState
	return ServiceSync.syncFromService(BossServiceClient, markerSlice.getMarkerState, applyState)
end

function markerThunks.Start(): () -> ()
	if runtime.started then
		return markerThunks.Stop
	end

	runtime.started = true
	local isReady = ServiceSync.readReady(BossServiceClient, false)
	markerSlice.setMarkerReady(isReady)
	if isReady then
		syncFromService()
	end

	runtime.stateChangedConnection = ServiceSync.connectStateChanged(BossServiceClient, function(nextState: MarkerState)
		applyState(nextState)
		markerSlice.setMarkerReady(true)
	end)
	ServiceSync.requestSync(BossServiceClient)

	return markerThunks.Stop
end

function markerThunks.Stop()
	ConnectionUtils.disconnect(runtime.stateChangedConnection)
	runtime.stateChangedConnection = nil

	runtime.started = false
	markerSlice.setMarkerReady(false)
end

function markerThunks.SyncFromService(): MarkerState
	return syncFromService()
end

function markerThunks.ApplyState(nextStateRaw: any): MarkerState
	return applyState(nextStateRaw)
end

markerThunks.start = markerThunks.Start
markerThunks.stop = markerThunks.Stop
markerThunks.syncFromService = markerThunks.SyncFromService
markerThunks.applyState = markerThunks.ApplyState

return markerThunks
]]></string>
                    </Properties>
                  </Item>
