                      <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local React = require(ReplicatedStorage.Packages.React)

export type SearchBoxProps = {
	text: string,
	image: string,
	panelTransparency: number,
	zIndex: number,
	size: UDim2?,
	position: UDim2?,
	textSize: number?,
	onTextChanged: (string) -> (),
	onFocusLost: () -> (),
}

local e: typeof(React.createElement) = React.createElement

return function(props: SearchBoxProps): React.ReactNode
	return e("ImageLabel", {
		Size = props.size or UDim2.new(1, -20, 0, 28),
		Position = props.position or UDim2.fromOffset(10, 38),
		BackgroundColor3 = Color3.fromRGB(16, 23, 32),
		BackgroundTransparency = if props.image ~= "" then 1 else props.panelTransparency * 0.2,
		BorderSizePixel = 0,
		Image = props.image,
		ImageColor3 = Color3.fromRGB(255, 255, 255),
		ImageTransparency = props.panelTransparency * 0.2,
		ZIndex = props.zIndex,
	}, {
		e("TextBox", {
			Size = UDim2.new(1, -14, 1, -6),
			Position = UDim2.fromOffset(7, 3),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Text = props.text,
			PlaceholderText = "Search recipes...",
			Font = Enum.Font.Gotham,
			TextSize = props.textSize or 13,
			TextColor3 = Color3.fromRGB(235, 242, 250),
			PlaceholderColor3 = Color3.fromRGB(134, 152, 171),
			ClearTextOnFocus = false,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = props.zIndex + 1,
			[React.Change.Text] = function(rbx: TextBox)
				props.onTextChanged(rbx.Text)
			end,
			[React.Event.FocusLost] = props.onFocusLost,
		}),
	})
end
]]></string>
                    </Properties>
                  </Item>
                  <Item class="ModuleScript" referent="878">
                    <Properties>
                      <string name="Name">craftingButton</string>
                      <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ImageIds = require(script:FindFirstAncestor("game").Client.UI.core.ImageIds)
local React = require(ReplicatedStorage.Packages.React)

type CraftingButtonProps = {
	layoutOrder: number?,
	visible: boolean?,
	zIndex: number?,
	size: UDim2?,
	position: UDim2?,
	anchorPoint: Vector2?,
	disabled: boolean?,
	selected: boolean?,
	text: string?,
	textOffset: Vector2?,
	icon: string?,
	iconPressed: string?,
	onActivated: (() -> ())?,
	onHoldBegan: (() -> ())?,
	onHoldEnded: (() -> ())?,
}

local e: typeof(React.createElement) = React.createElement

local function isPrimaryInput(inputObject: InputObject): boolean
	return inputObject.UserInputType == Enum.UserInputType.MouseButton1
		or inputObject.UserInputType == Enum.UserInputType.Touch
end

return function(props: CraftingButtonProps): React.ReactNode
	local isPressed, setIsPressed = React.useState(false)
	local isDisabled = props.disabled == true
	local isSelected = props.selected == true
	local zIndex = props.zIndex or 20
	local baseIcon = if typeof(props.icon) == "string" and props.icon ~= "" then props.icon else ImageIds.craftButton
	local pressedIcon = if typeof(props.iconPressed) == "string" and props.iconPressed ~= ""
		then props.iconPressed
		else (ImageIds.craftButtonPressed or ImageIds.craftingIconPress or baseIcon)
	local image = if isPressed or isSelected then pressedIcon else baseIcon
	local text = if typeof(props.text) == "string" then props.text else nil
	local textOffset = if typeof(props.textOffset) == "Vector2" then props.textOffset else Vector2.zero

	return e("ImageButton", {
		Size = props.size or UDim2.fromOffset(58, 58),
		Position = props.position,
		AnchorPoint = props.anchorPoint,
		LayoutOrder = props.layoutOrder,
		Visible = props.visible ~= false,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Active = not isDisabled,
		Selectable = not isDisabled,
		Image = image,
		ImageTransparency = if isDisabled then 0.5 else 0,
		ZIndex = zIndex,
		[React.Event.InputBegan] = function(_rbx: GuiObject, inputObject: InputObject)
			if isDisabled or not isPrimaryInput(inputObject) then
				return
			end
			setIsPressed(true)
			if props.onHoldBegan ~= nil then
				props.onHoldBegan()
			end
		end,
		[React.Event.InputEnded] = function(_rbx: GuiObject, inputObject: InputObject)
			if not isPrimaryInput(inputObject) then
				return
			end
			setIsPressed(false)
			if props.onHoldEnded ~= nil then
				props.onHoldEnded()
			end
		end,
		[React.Event.MouseLeave] = function()
			if isPressed and props.onHoldEnded ~= nil then
				props.onHoldEnded()
			end
			setIsPressed(false)
		end,
		[React.Event.Activated] = function()
			if isDisabled or props.onActivated == nil then
				return
			end
			props.onActivated()
		end,
	}, {
		if text ~= nil and text ~= ""
			then e("TextLabel", {
				Size = UDim2.new(1, -6, 1, -6),
				Position = UDim2.new(0.5, textOffset.X, 0.5, textOffset.Y),
				AnchorPoint = Vector2.new(0.5, 0.5),
				BackgroundTransparency = 1,
				Text = text,
				Font = Enum.Font.GothamBold,
				TextSize = 13,
				TextXAlignment = Enum.TextXAlignment.Center,
				TextYAlignment = Enum.TextYAlignment.Center,
				TextColor3 = Color3.fromRGB(255, 255, 255),
				TextStrokeTransparency = 0.25,
				ZIndex = zIndex + 1,
			})
			else nil,
	})
end
]]></string>
                    </Properties>
                  </Item>
                  <Item class="ModuleScript" referent="879">
                    <Properties>
                      <string name="Name">craftingSlot</string>
                      <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CoinSprites = require(script:FindFirstAncestor("game").Client.UI.core.utils.CoinSprites)
local Gif = require(script:FindFirstAncestor("game").Client.UI.shared.Gif)
local ImageIds = require(script:FindFirstAncestor("game").Client.UI.core.ImageIds)
local React = require(ReplicatedStorage.Packages.React)
local craftingSlice = require(script:FindFirstAncestor("game").Client.UI.features.crafting.state.craftingSlice)
local itemThunks = require(script:FindFirstAncestor("game").Client.UI.features.item.state.itemThunks)

type CraftingRecipeEntry = craftingSlice.CraftingRecipeEntry

type CraftingSlotProps = {
	layoutOrder: number?,
	zIndex: number?,
	size: UDim2?,
	recipe: CraftingRecipeEntry,
	selected: boolean?,
	onActivated: ((recipeId: string) -> ())?,
}

local e: typeof(React.createElement) = React.createElement

return function(props: CraftingSlotProps): React.ReactNode
	local recipe = props.recipe
	local canCraft = recipe.canCraft == true
	local zIndex = props.zIndex or 30
	local preview = if typeof(recipe.preview) == "table" then recipe.preview else nil
	local previewResults = if preview ~= nil and typeof((preview :: any).results) == "table"
		then (preview :: any).results :: { [any]: any }
		else nil
	local firstResult = if previewResults ~= nil then previewResults[1] else nil
	local firstResultAmount = if typeof(firstResult) == "table" then (firstResult :: any).amount else nil
	local resultAmountPerCraft = if typeof(firstResult) == "table"
			and typeof(firstResultAmount) == "number"
			and firstResultAmount == firstResultAmount
		then math.max(1, math.floor(firstResultAmount))
		else 1
	local coinSpriteSheet = CoinSprites.resolveSpriteSheet(recipe.resultItemId)
	local resolvedIcon = itemThunks.resolveItemIconByType(nil, recipe.resultItemId)
	local icon = if typeof(resolvedIcon) == "string" and resolvedIcon ~= "" then resolvedIcon else ImageIds.questionMark
	local maxDisplayAmount = if recipe.category == "Currency"
		then math.max(0, recipe.maxCraftableQuantity * resultAmountPerCraft)
		else math.max(0, recipe.maxCraftableQuantity)
	local maxCraftText = if canCraft then ("x%d"):format(math.max(1, maxDisplayAmount)) else "Missing"

	return e("ImageButton", {
		Size = props.size or UDim2.fromOffset(64, 64),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Image = ImageIds.craftItemSlot,
		ImageTransparency = if canCraft then 0 else 0.2,
		ImageColor3 = if canCraft then Color3.fromRGB(255, 255, 255) else Color3.fromRGB(190, 190, 190),
		LayoutOrder = props.layoutOrder,
		ZIndex = zIndex,
		AutoButtonColor = false,
		[React.Event.Activated] = function()
			if props.onActivated ~= nil then
				props.onActivated(recipe.recipeId)
			end
		end,
	}, {
		if coinSpriteSheet ~= nil
			then e(Gif, {
				image = coinSpriteSheet,
				frameSize = CoinSprites.frameSize,
				frameCount = CoinSprites.frameCount,
				columns = CoinSprites.columns,
				startFrameIndex = 0,
				fps = CoinSprites.fps,
				size = UDim2.fromOffset(40, 40),
				position = UDim2.fromScale(0.5, 0.5),
				anchorPoint = Vector2.new(0.5, 0.5),
				backgroundTransparency = 1,
				imageTransparency = if canCraft then 0 else 0.25,
				zIndex = zIndex + 1,
				resampleMode = Enum.ResamplerMode.Pixelated,
			})
			else e("ImageLabel", {
				Size = UDim2.fromOffset(40, 40),
				Position = UDim2.fromScale(0.5, 0.5),
				AnchorPoint = Vector2.new(0.5, 0.5),
				BackgroundTransparency = 1,
				Image = if typeof(icon) == "string" then icon else ImageIds.questionMark,
				ScaleType = Enum.ScaleType.Fit,
				ImageTransparency = if canCraft then 0 else 0.25,
				ZIndex = zIndex + 1,
			}),
		e("TextLabel", {
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.fromOffset(0, 14),
			Position = UDim2.new(1, -5, 1, -5),
			AnchorPoint = Vector2.new(1, 1),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Text = maxCraftText,
			Font = Enum.Font.GothamBold,
			TextSize = 10,
			TextXAlignment = Enum.TextXAlignment.Right,
			TextYAlignment = Enum.TextYAlignment.Center,
			TextColor3 = if canCraft then Color3.fromRGB(153, 243, 184) else Color3.fromRGB(245, 171, 171),
			TextStrokeTransparency = 0.45,
			ZIndex = zIndex + 1,
		}),
	})
end
]]></string>
                    </Properties>
                  </Item>
                </Item>
                <Item class="Folder" referent="880">
                  <Properties>
                    <string name="Name">hooks</string>
                  </Properties>
                  <Item class="ModuleScript" referent="881">
                    <Properties>
                      <string name="Name">useCraftMenuDrag</string>
                      <string name="Source"><![CDATA[--!strict
local GuiService = game:GetService("GuiService")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local React = require(ReplicatedStorage.Packages.React)
local Damp = require(script:FindFirstAncestor("game").Shared.Modules.Math.Damp)
local useEvent = require(script:FindFirstAncestor("game").Client.UI.shared.useEvent)
local useToggle = require(script:FindFirstAncestor("game").Client.UI.shared.useToggle)

export type CraftMenuDragOptions = {
	enabled: boolean?,
	dragSmoothness: number?,
}

export type CraftMenuDragResult = {
	offset: Vector2,
	isDragging: boolean,
	onDragInputBegan: (rbx: GuiObject, inputObject: InputObject) -> (),
	onDragInputEnded: (rbx: GuiObject, inputObject: InputObject) -> (),
}

local DEFAULT_DRAG_SMOOTHNESS = 5
local SNAP_EPSILON = 0.025

local function toGuiPosition(inputObject: InputObject): Vector2
	local inset = GuiService:GetGuiInset()
	local inputPosition = inputObject.Position
	return Vector2.new(inputPosition.X - inset.X, inputPosition.Y - inset.Y)
end

local function isPrimaryDragInput(inputObject: InputObject): boolean
	return inputObject.UserInputType == Enum.UserInputType.MouseButton1
		or inputObject.UserInputType == Enum.UserInputType.Touch
end

local function useCraftMenuDrag(options: CraftMenuDragOptions?): CraftMenuDragResult
	local enabled = if options and options.enabled ~= nil then options.enabled else false
	local dragSmoothness = math.clamp(
		if options and typeof(options.dragSmoothness) == "number" and options.dragSmoothness == options.dragSmoothness
			then options.dragSmoothness
			else DEFAULT_DRAG_SMOOTHNESS,
		1,
		120
	)

	local dragging = useToggle(false)
	local offset, setOffset = React.useState(Vector2.zero)
	local offsetRef = React.useRef(Vector2.zero)
	local targetOffsetRef = React.useRef(Vector2.zero)
	local dragInputRef = React.useRef(nil :: InputObject?)
	local dragStartPointerRef = React.useRef(Vector2.zero)
	local dragStartOffsetRef = React.useRef(Vector2.zero)
	local wasEnabledRef = React.useRef(enabled)

	React.useEffect(function()
		offsetRef.current = offset
	end, { offset })

	React.useEffect(function()
		local wasEnabled = wasEnabledRef.current
		wasEnabledRef.current = enabled

		if wasEnabled and not enabled then
			dragInputRef.current = nil
			dragging.disable()
			targetOffsetRef.current = offsetRef.current
		end
	end, { enabled, dragging.disable })

	local onDragInputBegan = useEvent(function(_rbx: GuiObject, inputObject: InputObject)
		if not enabled or not isPrimaryDragInput(inputObject) then
			return
		end
		dragInputRef.current = inputObject
		dragStartPointerRef.current = toGuiPosition(inputObject)
		dragStartOffsetRef.current = targetOffsetRef.current
		dragging.enable()
	end)

	local onDragInputEnded = useEvent(function(_rbx: GuiObject, inputObject: InputObject)
		local dragInput = dragInputRef.current
		if dragInput == nil then
			return
		end
		local isMatchingTouch = dragInput.UserInputType == Enum.UserInputType.Touch and inputObject == dragInput
		local isMatchingMouse = dragInput.UserInputType == Enum.UserInputType.MouseButton1
			and inputObject.UserInputType == Enum.UserInputType.MouseButton1
		if not isMatchingTouch and not isMatchingMouse then
			return
		end
		dragInputRef.current = nil
		dragging.disable()
	end)

	React.useEffect(function()
		local changedConnection = UserInputService.InputChanged:Connect(function(inputObject: InputObject)
			if not enabled or not dragging.value then
				return
			end

			local dragInput = dragInputRef.current
			if dragInput == nil then
				return
			end

			local isMatchingTouch = dragInput.UserInputType == Enum.UserInputType.Touch and inputObject == dragInput
			local isMouseMoveForDrag = dragInput.UserInputType == Enum.UserInputType.MouseButton1
				and inputObject.UserInputType == Enum.UserInputType.MouseMovement
			if not isMatchingTouch and not isMouseMoveForDrag then
				return
			end

			local pointerPosition = toGuiPosition(inputObject)
			local pointerDelta = pointerPosition - dragStartPointerRef.current
			targetOffsetRef.current = dragStartOffsetRef.current + pointerDelta
		end)

		local endedConnection = UserInputService.InputEnded:Connect(function(inputObject: InputObject)
			local dragInput = dragInputRef.current
			if dragInput == nil then
				return
			end

			local isMatchingTouch = dragInput.UserInputType == Enum.UserInputType.Touch and inputObject == dragInput
			local isMatchingMouse = dragInput.UserInputType == Enum.UserInputType.MouseButton1
				and inputObject.UserInputType == Enum.UserInputType.MouseButton1
			if not isMatchingTouch and not isMatchingMouse then
				return
			end

			dragInputRef.current = nil
			dragging.disable()
		end)

		return function()
			changedConnection:Disconnect()
			endedConnection:Disconnect()
		end
	end, { enabled, dragging.value, dragging.disable })

	React.useEffect(function()
		local connection = RunService.RenderStepped:Connect(function(deltaTime: number)
			local currentOffset = offsetRef.current
			local targetOffset = targetOffsetRef.current
			local alpha = Damp.factor(dragSmoothness, deltaTime)
			local nextOffset = currentOffset:Lerp(targetOffset, alpha)

			if (targetOffset - nextOffset).Magnitude <= SNAP_EPSILON then
				nextOffset = targetOffset
			end
			if (nextOffset - currentOffset).Magnitude <= SNAP_EPSILON then
				return
			end

			offsetRef.current = nextOffset
			setOffset(nextOffset)
		end)

		return function()
			connection:Disconnect()
		end
	end, { dragSmoothness })

	return {
		offset = offset,
		isDragging = dragging.value,
		onDragInputBegan = onDragInputBegan,
		onDragInputEnded = onDragInputEnded,
	}
end

return useCraftMenuDrag
]]></string>
                    </Properties>
                  </Item>
                  <Item class="ModuleScript" referent="882">
                    <Properties>
                      <string name="Name">useCraftSlide</string>
                      <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local React = require(ReplicatedStorage.Packages.React)
local Ripple = require(ReplicatedStorage.Packages.Ripple)

type NumberMotion = Ripple.Motion<number>
type SpringOptions = Ripple.SpringOptions

export type CraftSlideOptions = {
	enabled: boolean?,
	spring: SpringOptions?,
}

local DEFAULT_SPRING: SpringOptions = {
	frequency = 1,
	damping = 1,
}

local function useCraftSlide(options: CraftSlideOptions?): number
	local enabled = if options and options.enabled ~= nil then options.enabled else false
	local spring = if options and options.spring ~= nil then options.spring else DEFAULT_SPRING
	local targetRef = React.useRef(if enabled then 1 else 0)
	local progress, setProgress = React.useState(targetRef.current)

	React.useEffect(function()
		targetRef.current = if enabled then 1 else 0
	end, { enabled })

	React.useEffect(function()
		local motion: NumberMotion = Ripple.createMotion(progress)
		local connection = RunService.RenderStepped:Connect(function(deltaTime: number)
			motion:spring(targetRef.current, spring)
			local nextProgress = math.clamp(motion:step(deltaTime), 0, 1)
			setProgress(nextProgress)
		end)

		return function()
			connection:Disconnect()
			motion:destroy()
		end
	end, { spring })

	return progress
end

return useCraftSlide
]]></string>
                    </Properties>
                  </Item>
                </Item>
                <Item class="Folder" referent="883">
                  <Properties>
                    <string name="Name">hud</string>
                  </Properties>
                  <Item class="ModuleScript" referent="884">
                    <Properties>
                      <string name="Name">craftButton</string>
                      <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CraftingButton = require(script:FindFirstAncestor("game").Client.UI.features.crafting.components.craftingButton)
local React = require(ReplicatedStorage.Packages.React)
local craftingSlice = require(script:FindFirstAncestor("game").Client.UI.features.crafting.state.craftingSlice)
local craftingThunks = require(script:FindFirstAncestor("game").Client.UI.features.crafting.state.craftingThunks)
local useStore = require(script:FindFirstAncestor("game").Client.UI.core.hooks.useStore)

type CraftingState = craftingSlice.CraftingState

type CraftButtonProps = {
	layoutOrder: number?,
	visible: boolean?,
	zIndex: number?,
	size: UDim2?,
	position: UDim2?,
	anchorPoint: Vector2?,
}

local e: typeof(React.createElement) = React.createElement

return function(props: CraftButtonProps): React.ReactNode
	local craftingState = (useStore(craftingSlice.craftingStateAtom) :: CraftingState?)
		or craftingSlice.getCraftingState()

	React.useEffect(function()
		local stop = craftingThunks.start()

		return function()
			stop()
		end
	end, {})

	return e(CraftingButton, {
		layoutOrder = props.layoutOrder,
		visible = props.visible,
		zIndex = props.zIndex,
		size = props.size,
		position = props.position,
		anchorPoint = props.anchorPoint,
		selected = craftingState.visible,
		onActivated = function()
			craftingThunks.toggleVisible()
		end,
	})
end
]]></string>
                    </Properties>
                  </Item>
                </Item>
                <Item class="Folder" referent="885">
                  <Properties>
                    <string name="Name">screens</string>
                  </Properties>
                  <Item class="ModuleScript" referent="886">
                    <Properties>
                      <string name="Name">craftingSlots</string>
                      <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Sift = require(ReplicatedStorage.Packages.Sift)

local CategoryTabs = require(script:FindFirstAncestor("game").Client.UI.features.crafting.components.CategoryTabs)
local CraftingButton = require(script:FindFirstAncestor("game").Client.UI.features.crafting.components.craftingButton)
local CraftingPanel = require(script:FindFirstAncestor("game").Client.UI.features.crafting.components.CraftingPanel)
local ImageIds = require(script:FindFirstAncestor("game").Client.UI.core.ImageIds)
local IngredientSlot = require(script:FindFirstAncestor("game").Client.UI.features.crafting.components.IngredientSlot)
local Layer = require(script:FindFirstAncestor("game").Client.UI.shared.Layer)
local React = require(ReplicatedStorage.Packages.React)
local RecipeDetails = require(script:FindFirstAncestor("game").Client.UI.features.crafting.components.RecipeDetails)
local RecipeGrid = require(script:FindFirstAncestor("game").Client.UI.features.crafting.components.RecipeGrid)
local RecipeSlot = require(script:FindFirstAncestor("game").Client.UI.features.crafting.components.RecipeSlot)
local Responsive = require(script:FindFirstAncestor("game").Client.UI.core.hooks.useViewportScale)
local SearchBox = require(script:FindFirstAncestor("game").Client.UI.features.crafting.components.SearchBox)
local UiScaleUtils = require(script:FindFirstAncestor("game").Client.UI.core.utils.UiScaleUtils)
local UiSound = require(script:FindFirstAncestor("game").Client.UI.core.utils.UiSound)
local craftingSlice = require(script:FindFirstAncestor("game").Client.UI.features.crafting.state.craftingSlice)
local craftingThunks = require(script:FindFirstAncestor("game").Client.UI.features.crafting.state.craftingThunks)
local itemThunks = require(script:FindFirstAncestor("game").Client.UI.features.item.state.itemThunks)
local resolveImageId = require(script:FindFirstAncestor("game").Client.UI.core.utils.resolveImageId)
local useCraftMenuDrag = require(script:FindFirstAncestor("game").Client.UI.features.crafting.hooks.useCraftMenuDrag)
local useCraftSlide = require(script:FindFirstAncestor("game").Client.UI.features.crafting.hooks.useCraftSlide)
local useDebounceValue = require(script:FindFirstAncestor("game").Client.UI.shared.useDebounceValue)
local useStore = require(script:FindFirstAncestor("game").Client.UI.core.hooks.useStore)

type CraftingState = craftingSlice.CraftingState
type CraftingRecipeEntry = craftingSlice.CraftingRecipeEntry

type CraftingSlotsProps = {
	layoutOrder: number?,
	visible: boolean?,
	zIndex: number?,
}

local e: typeof(React.createElement) = React.createElement

local PANEL_OPEN_START_OFFSET = Vector2.new(0, 96)
local PANEL_MIN_SCALE = 0.2
local RECIPE_SLOT_PADDING = 8
local RECIPE_REQUIREMENT_SLOT_PADDING = 8
local SEARCH_DEBOUNCE_SECONDS = 0.15
local MENU_OPEN_SPRING = {
	frequency = 0.2,
	damping = 1,
}

local function playUiSound(soundAssetId: string?)
	UiSound.play(soundAssetId)
end

local CRAFTING_MENU_IMAGE_ID = resolveImageId(ImageIds.craftingMenu, "")
local CRAFTING_MENU_INNER_IMAGE_ID = resolveImageId(ImageIds.craftingMenuInner, CRAFTING_MENU_IMAGE_ID)
local CRAFTING_MENU_TEXTBOX_IMAGE_ID = resolveImageId(ImageIds.craftingMenuTextBox, CRAFTING_MENU_INNER_IMAGE_ID)
local CRAFTING_MENU_CATEGORY_IMAGE_ID = resolveImageId(ImageIds.craftingMenuCategory, CRAFTING_MENU_INNER_IMAGE_ID)
local resolveSelectedRecipeFromEntries: (entries: { CraftingRecipeEntry }, selectedRecipeIdRaw: any) -> CraftingRecipeEntry?

resolveSelectedRecipeFromEntries = function(
	entries: { CraftingRecipeEntry },
	selectedRecipeIdRaw: any
): CraftingRecipeEntry?
	local selectedRecipeId = if typeof(selectedRecipeIdRaw) == "string" and selectedRecipeIdRaw ~= ""
		then selectedRecipeIdRaw
		else nil
	if selectedRecipeId == nil then
		return nil
	end

	for _, entry in entries do
		if entry.recipeId == selectedRecipeId then
			return entry
		end
	end
	return nil
end

local function resolveBestRecipeEntry(entries: { CraftingRecipeEntry }): CraftingRecipeEntry?
	local preferred = nil :: CraftingRecipeEntry?
	for _, entry in entries do
		if preferred == nil then
			preferred = entry
			continue
		end
		if entry.canCraft ~= preferred.canCraft then
			if entry.canCraft then
				preferred = entry
			end
			continue
		end
		if entry.maxCraftableQuantity ~= preferred.maxCraftableQuantity then
			if entry.maxCraftableQuantity > preferred.maxCraftableQuantity then
				preferred = entry
			end
			continue
		end
		if entry.sortOrder ~= preferred.sortOrder then
			if entry.sortOrder < preferred.sortOrder then
				preferred = entry
			end
			continue
		end
		if entry.recipeId < preferred.recipeId then
			preferred = entry
		end
	end
	return preferred
end

local function pickPreferredRecipeEntry(
	entries: { CraftingRecipeEntry },
	selectedRecipeIdRaw: any
): CraftingRecipeEntry?
	local selectedRecipe = resolveSelectedRecipeFromEntries(entries, selectedRecipeIdRaw)
	if selectedRecipe ~= nil and selectedRecipe.canCraft then
		return selectedRecipe
	end

	local preferred = resolveBestRecipeEntry(entries)
	if preferred ~= nil then
		return preferred
	end

	return selectedRecipe
end

local function resolveDisplayRecipeGroups(
	entries: { CraftingRecipeEntry },
	categoryRaw: any,
	selectedRecipeIdRaw: any
): ({ CraftingRecipeEntry }, { [string]: { CraftingRecipeEntry } })
	local category = if typeof(categoryRaw) == "string" then categoryRaw else ""
	local shouldCollapseCurrencyResults = category == "" or category == "Currency"
	if not shouldCollapseCurrencyResults then
		local passthroughGroups = {} :: { [string]: { CraftingRecipeEntry } }
		for _, entry in entries do
			passthroughGroups[entry.recipeId] = { entry }
		end
		return entries, passthroughGroups
	end

	local groupedByResult = {} :: { [string]: { CraftingRecipeEntry } }
	local resultOrder = {} :: { string }
	for _, entry in entries do
		local isCurrencyRecipe = entry.category == "Currency"
		local groupKey = if isCurrencyRecipe
				and typeof(entry.resultItemId) == "string"
				and entry.resultItemId ~= ""
			then entry.resultItemId
			else entry.recipeId
		local group = groupedByResult[groupKey]
		if group == nil then
			group = {}
			groupedByResult[groupKey] = group
			resultOrder[#resultOrder + 1] = groupKey
		end
		group[#group + 1] = entry
	end

	local visibleEntries = {} :: { CraftingRecipeEntry }
	local groupsByVisibleRecipeId = {} :: { [string]: { CraftingRecipeEntry } }
	for _, groupKey in resultOrder do
		local group = groupedByResult[groupKey]
		if group ~= nil then
			local visibleEntry = pickPreferredRecipeEntry(group, selectedRecipeIdRaw)
			if visibleEntry ~= nil then
				visibleEntries[#visibleEntries + 1] = visibleEntry
				groupsByVisibleRecipeId[visibleEntry.recipeId] = group
			end
		end
	end

	visibleEntries = Sift.Array.sort(
		visibleEntries,
		function(lhs: CraftingRecipeEntry, rhs: CraftingRecipeEntry): boolean
			if lhs.sortOrder ~= rhs.sortOrder then
				return lhs.sortOrder < rhs.sortOrder
			end
			return lhs.recipeId < rhs.recipeId
		end
	)

	return visibleEntries, groupsByVisibleRecipeId
end

local function resolveDisplayedSelectedRecipe(
	displayedRecipes: { CraftingRecipeEntry },
	displayRecipeGroups: { [string]: { CraftingRecipeEntry } },
	selectedRecipeIdRaw: any
): CraftingRecipeEntry?
	local selectedRecipeId = if typeof(selectedRecipeIdRaw) == "string" and selectedRecipeIdRaw ~= ""
		then selectedRecipeIdRaw
		else nil
	if selectedRecipeId ~= nil then
		for _, visibleEntry in displayedRecipes do
			local visibleGroup = displayRecipeGroups[visibleEntry.recipeId]
			if visibleGroup ~= nil then
				for _, groupedEntry in visibleGroup do
					if groupedEntry.recipeId == selectedRecipeId then
						return visibleEntry
					end
				end
			elseif visibleEntry.recipeId == selectedRecipeId then
				return visibleEntry
			end
		end
	end

	return displayedRecipes[1]
end

local function buildIngredientRows(
	previewRaw: any,
	zIndex: number,
	requirementSlotSize: number,
	requirementIconSize: number
): { React.ReactNode }
	local rows: { React.ReactNode } = {}
	if typeof(previewRaw) ~= "table" then
		return rows
	end

	local ingredientsRaw = (previewRaw :: any).ingredients
	if typeof(ingredientsRaw) ~= "table" then
		return rows
	end

	for index, ingredientRaw in ingredientsRaw do
		if typeof(ingredientRaw) ~= "table" then
			continue
		end
		local ingredient = ingredientRaw :: { [string]: any }
		local itemId = if typeof(ingredient.itemId) == "string" then ingredient.itemId else "Item"
		local required = if typeof(ingredient.required) == "number"
				and ingredient.required == ingredient.required
			then math.max(0, math.floor(ingredient.required))
			else 0
		local isSufficient = ingredient.isSufficient == true

		local resolvedIcon = itemThunks.resolveItemIconByType(nil, itemId)
		local icon = if typeof(resolvedIcon) == "string" and resolvedIcon ~= ""
			then resolvedIcon
			else ImageIds.questionMark

		rows[#rows + 1] = e(IngredientSlot, {
			layoutOrder = index,
			itemId = itemId,
			required = required,
			isSufficient = isSufficient,
			icon = icon,
			size = UDim2.fromOffset(requirementSlotSize, requirementSlotSize),
			iconSize = UDim2.fromOffset(requirementIconSize, requirementIconSize),
			zIndex = zIndex,
		})
	end

	return rows
end

return function(props: CraftingSlotsProps): React.ReactNode
	local responsive = Responsive.useResponsiveMetrics()
	local craftingTokens = responsive.tokens.crafting
	local craftingState = (useStore(craftingSlice.craftingStateAtom) :: CraftingState?)
		or craftingSlice.getCraftingState()
	local searchText, setSearchText = React.useState(function(): string
		return craftingState.searchQuery
	end)
	local lastAppliedSearchQueryRef = React.useRef(craftingState.searchQuery)
	local searchQueryCommitInFlightRef = React.useRef(false)
	local debouncedSearchText = useDebounceValue(searchText, SEARCH_DEBOUNCE_SECONDS)

	local function commitSearchQuery(nextSearchText: string)
		if nextSearchText == lastAppliedSearchQueryRef.current then
			return
		end

		lastAppliedSearchQueryRef.current = nextSearchText
		searchQueryCommitInFlightRef.current = true
		craftingThunks.setSearchQuery(nextSearchText)
	end

	React.useEffect(function()
		local stop = craftingThunks.start()

		return function()
			craftingThunks.stopBulkCraft()
			stop()
		end
	end, {})

	React.useEffect(function()
		if debouncedSearchText ~= searchText then
			return
		end

		commitSearchQuery(debouncedSearchText)
	end, { debouncedSearchText, searchText })

	React.useEffect(function()
		if searchQueryCommitInFlightRef.current then
			if craftingState.searchQuery == lastAppliedSearchQueryRef.current then
				searchQueryCommitInFlightRef.current = false
			end
			return
		end

		if craftingState.searchQuery == lastAppliedSearchQueryRef.current then
			return
		end

		lastAppliedSearchQueryRef.current = craftingState.searchQuery
		setSearchText(craftingState.searchQuery)
	end, { craftingState.searchQuery })

	local isRequestedVisible = props.visible ~= false
	local isOpen = isRequestedVisible and craftingState.visible
	local craftMenuDrag = useCraftMenuDrag({
		enabled = isOpen,
		dragSmoothness = 16,
	})
	local lastCraftResultUpdatedAtRef = React.useRef(nil :: number?)
	local wasDraggingRef = React.useRef(false)
	local slideProgress = useCraftSlide({
		enabled = isOpen,
		spring = MENU_OPEN_SPRING,
	})

	React.useEffect(function()
		local lastCraftResult = craftingState.lastCraftResult
		if typeof(lastCraftResult) ~= "table" then
			return
		end

		local updatedAt = (lastCraftResult :: any).updatedAt
		if typeof(updatedAt) ~= "number" or updatedAt ~= updatedAt then
			return
		end
		if lastCraftResultUpdatedAtRef.current == updatedAt then
			return
		end

		lastCraftResultUpdatedAtRef.current = updatedAt
		if (lastCraftResult :: any).success == true then
			playUiSound(UiSound.craft)
		end
	end, { craftingState.lastCraftResult })

	React.useEffect(function()
		local wasDragging = wasDraggingRef.current
		wasDraggingRef.current = craftMenuDrag.isDragging
		if craftMenuDrag.isDragging and not wasDragging then
			playUiSound(UiSound.drag)
		end
	end, { craftMenuDrag.isDragging })

	if not isOpen and slideProgress <= 0.001 then
		return nil
	end

	local zIndex = props.zIndex or 180
	local responsivePanelScale = craftingTokens.panelScale
	local destinationOffset = UiScaleUtils.clampCenteredPanelOffset(
		craftMenuDrag.offset,
		Vector2.new(craftingTokens.panelWidth, craftingTokens.panelHeight),
		responsivePanelScale,
		responsive
	)
	local sourceOffset = destinationOffset + PANEL_OPEN_START_OFFSET * responsivePanelScale
	local animatedOffset = sourceOffset:Lerp(destinationOffset, slideProgress)
	local pathLength = (PANEL_OPEN_START_OFFSET * responsivePanelScale).Magnitude
	local remainingDistance = (destinationOffset - animatedOffset).Magnitude
	local panelTransparency = if pathLength > 0
		then math.clamp(remainingDistance / pathLength, 0, 1)
		else math.clamp(1 - slideProgress, 0, 1)
	local panelScale = responsivePanelScale * (PANEL_MIN_SCALE + (1 - PANEL_MIN_SCALE) * (1 - panelTransparency))
	local activeCategory = craftingState.categoryFilter
	local displayedRecipes, displayRecipeGroups =
		resolveDisplayRecipeGroups(craftingState.recipes, activeCategory, craftingState.selectedRecipeId)
	local selectedRecipe =
		resolveDisplayedSelectedRecipe(displayedRecipes, displayRecipeGroups, craftingState.selectedRecipeId)
	local canCraftSelected = selectedRecipe ~= nil and selectedRecipe.canCraft
	local categoryTabs = { "All" }
	for _, category in craftingState.availableCategories do
		categoryTabs[#categoryTabs + 1] = category
	end

	local recipeChildren: { React.ReactNode } = {}
	for index, entry in displayedRecipes do
		local entryGroup = displayRecipeGroups[entry.recipeId]
		local isSelected = false
		if entryGroup ~= nil and craftingState.selectedRecipeId ~= nil then
			for _, groupedEntry in entryGroup do
				if groupedEntry.recipeId == craftingState.selectedRecipeId then
					isSelected = true
					break
				end
			end
		end
		recipeChildren[#recipeChildren + 1] = e(RecipeSlot, {
			layoutOrder = index,
			zIndex = zIndex + 4,
			size = UDim2.fromOffset(craftingTokens.recipeSlotSize, craftingTokens.recipeSlotSize),
			recipe = entry,
			selected = isSelected,
			onActivated = function(recipeId: string)
				local nextRecipeId = recipeId
				local group = displayRecipeGroups[recipeId]
				if group ~= nil and #group > 1 and craftingState.selectedRecipeId ~= nil then
					local currentIndex = nil :: number?
					for groupedIndex, groupedEntry in group do
						if groupedEntry.recipeId == craftingState.selectedRecipeId then
							currentIndex = groupedIndex
							break
						end
					end
					if currentIndex ~= nil then
						local nextIndex = currentIndex + 1
						if nextIndex > #group then
							nextIndex = 1
						end
						nextRecipeId = group[nextIndex].recipeId
					end
				end
				craftingThunks.selectRecipe(nextRecipeId)
			end,
		})
	end

	local ingredientRows = buildIngredientRows(
		if selectedRecipe ~= nil then selectedRecipe.preview else nil,
		zIndex + 4,
		craftingTokens.requirementSlotSize,
		craftingTokens.iconSize
	)

	return e(Layer, {
		layoutOrder = props.layoutOrder or 12,
		zIndex = zIndex,
		visible = isRequestedVisible,
		children = {
			e(CraftingPanel, {
				size = UDim2.fromOffset(craftingTokens.panelWidth, craftingTokens.panelHeight),
				position = UDim2.new(0.5, math.floor(animatedOffset.X), 0.5, math.floor(animatedOffset.Y)),
				anchorPoint = Vector2.new(0.5, 0.5),
				scale = panelScale,
				panelImage = CRAFTING_MENU_IMAGE_ID,
				panelTransparency = panelTransparency,
				zIndex = zIndex + 1,
				onDragInputBegan = function(rbx: GuiObject, inputObject: InputObject)
					craftMenuDrag.onDragInputBegan(rbx, inputObject)
				end,
				onDragInputEnded = function(rbx: GuiObject, inputObject: InputObject)
					craftMenuDrag.onDragInputEnded(rbx, inputObject)
				end,
				children = {
					e(SearchBox, {
						text = searchText,
						image = CRAFTING_MENU_TEXTBOX_IMAGE_ID,
						panelTransparency = panelTransparency,
						zIndex = zIndex + 3,
						position = UDim2.fromOffset(craftingTokens.panelPadding, craftingTokens.searchY),
						size = UDim2.new(1, -craftingTokens.panelPadding * 2, 0, 28),
						textSize = craftingTokens.textSize + 1,
						onTextChanged = setSearchText,
						onFocusLost = function()
							commitSearchQuery(searchText)
						end,
					}),
					e(CategoryTabs, {
						categories = categoryTabs,
						activeCategory = activeCategory,
						categoryImage = CRAFTING_MENU_CATEGORY_IMAGE_ID,
						panelTransparency = panelTransparency,
						zIndex = zIndex + 3,
						position = UDim2.fromOffset(craftingTokens.panelPadding, craftingTokens.categoryY),
						size = UDim2.new(1, -craftingTokens.panelPadding * 2, 0, 26),
						tabPadding = UDim.new(0, 4),
						textSize = craftingTokens.textSize,
						onActivated = function(categoryValue: string)
							craftingThunks.setCategoryFilter(categoryValue)
						end,
					}),
					e(RecipeGrid, {
						image = CRAFTING_MENU_INNER_IMAGE_ID,
						panelTransparency = panelTransparency,
						position = UDim2.fromOffset(craftingTokens.panelPadding, craftingTokens.recipeGridY),
						size = UDim2.new(1, -craftingTokens.panelPadding * 2, 0, 240),
						slotSize = craftingTokens.recipeSlotSize,
						slotPadding = RECIPE_SLOT_PADDING,
						zIndex = zIndex + 3,
						children = recipeChildren,
					}),
					e(RecipeDetails, {
						image = CRAFTING_MENU_INNER_IMAGE_ID,
						panelTransparency = panelTransparency,
						position = UDim2.fromOffset(craftingTokens.panelPadding, craftingTokens.recipeDetailsY),
						size = UDim2.new(1, -craftingTokens.panelPadding * 2, 0, 64),
						slotSize = craftingTokens.requirementSlotSize,
						slotPadding = RECIPE_REQUIREMENT_SLOT_PADDING,
						zIndex = zIndex + 3,
						children = ingredientRows,
					}),
					e(CraftingButton, {
						size = UDim2.new(1, -craftingTokens.panelPadding * 2, 0, craftingTokens.craftButtonHeight),
						position = UDim2.fromOffset(craftingTokens.panelPadding, craftingTokens.craftButtonY),
						zIndex = zIndex + 4,
						disabled = not canCraftSelected,
						icon = ImageIds.finalCraftButton,
						iconPressed = ImageIds.finalCraftButtonPressed,
						text = if craftingState.isBulkCrafting then "Crafting..." else "Craft",
						onActivated = function()
							if canCraftSelected and selectedRecipe ~= nil then
								craftingThunks.requestCraft(selectedRecipe.recipeId, 1)
							end
						end,
					}),
				},
			}),
		},
	})
end
]]></string>
                    </Properties>
                  </Item>
                </Item>
                <Item class="Folder" referent="887">
                  <Properties>
                    <string name="Name">state</string>
                  </Properties>
                  <Item class="ModuleScript" referent="888">
                    <Properties>
                      <string name="Name">craftingSlice</string>
                      <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Sift = require(ReplicatedStorage.Packages.Sift)

local Charm = require(ReplicatedStorage.Packages.Charm)

export type CraftingRecipeEntry = {
	recipeId: string,
	displayName: string,
	category: string,
	resultItemId: string?,
	canCraft: boolean,
	maxCraftableQuantity: number,
	groupId: string?,
	sortOrder: number,
	preview: { [string]: any }?,
}

export type CraftingState = {
	started: boolean,
	visible: boolean,
	searchQuery: string,
	categoryFilter: string,
	selectedRecipeId: string?,
	availableCategories: { string },
	recipes: { CraftingRecipeEntry },
	activeStations: { string },
	isBulkCrafting: boolean,
	lastCraftResult: { [string]: any }?,
	updatedAt: number,
}

local DEFAULT_STATE: CraftingState = {
	started = false,
	visible = false,
	searchQuery = "",
	categoryFilter = "",
	selectedRecipeId = nil,
	availableCategories = {},
	recipes = {},
	activeStations = {},
	isBulkCrafting = false,
	lastCraftResult = nil,
	updatedAt = os.clock(),
}

local craftingStateAtom: Charm.Atom<CraftingState> = Charm.atom(DEFAULT_STATE)

local function trim(textRaw: any): string
	if typeof(textRaw) ~= "string" then
		return ""
	end
	return string.match(textRaw, "^%s*(.-)%s*$") or ""
end

local function sanitizeBoolean(valueRaw: any, fallback: boolean): boolean
	if typeof(valueRaw) == "boolean" then
		return valueRaw
	end
	return fallback
end

local function sanitizeInteger(valueRaw: any, fallback: number, minimum: number, maximum: number): number
	if typeof(valueRaw) ~= "number" or valueRaw ~= valueRaw then
		return fallback
	end
	return math.clamp(math.floor(valueRaw), minimum, maximum)
end

local function cloneStringArray(arrayRaw: any): { string }
	local output: { string } = {}
	if typeof(arrayRaw) ~= "table" then
		return output
	end
	for _, valueRaw in arrayRaw do
		local value = trim(valueRaw)
		if value ~= "" then
			output[#output + 1] = value
		end
	end
	return output
end

local function sanitizeRecipeEntries(entriesRaw: any): { CraftingRecipeEntry }
	local output: { CraftingRecipeEntry } = {}
	if typeof(entriesRaw) ~= "table" then
		return output
	end

	for index, entryRaw in entriesRaw do
		if typeof(entryRaw) ~= "table" then
			continue
		end
		local entry = entryRaw :: { [string]: any }
		local recipeId = trim(entry.recipeId)
		if recipeId == "" then
			continue
		end

		local displayName = trim(entry.displayName)
		if displayName == "" then
			displayName = recipeId
		end
		local category = trim(entry.category)
		if category == "" then
			category = "Misc"
		end

		output[#output + 1] = {
			recipeId = recipeId,
			displayName = displayName,
			category = category,
			resultItemId = if trim(entry.resultItemId) ~= "" then trim(entry.resultItemId) else nil,
			canCraft = entry.canCraft == true,
			maxCraftableQuantity = sanitizeInteger(entry.maxCraftableQuantity, 0, 0, 999_999),
			groupId = if trim(entry.groupId) ~= "" then trim(entry.groupId) else nil,
			sortOrder = sanitizeInteger(entry.sortOrder, index, -999_999, 999_999),
			preview = if typeof(entry.preview) == "table" then entry.preview else nil,
		}
	end

	return output
end

local function cloneRecipeEntries(entriesRaw: { CraftingRecipeEntry }): { CraftingRecipeEntry }
	local output: { CraftingRecipeEntry } = Sift.Array.create(#entriesRaw)
	for index, entry in entriesRaw do
		output[index] = {
			recipeId = entry.recipeId,
			displayName = entry.displayName,
			category = entry.category,
			resultItemId = entry.resultItemId,
			canCraft = entry.canCraft,
			maxCraftableQuantity = entry.maxCraftableQuantity,
			groupId = entry.groupId,
			sortOrder = entry.sortOrder,
			preview = if typeof(entry.preview) == "table" then Sift.Dictionary.copy(entry.preview) else nil,
		}
	end
	return output
end

local function hasRecipeId(entries: { CraftingRecipeEntry }, recipeId: string): boolean
	for _, entry in entries do
		if entry.recipeId == recipeId then
			return true
		end
	end
	return false
end

local function normalizeSelectedRecipeId(
	entries: { CraftingRecipeEntry },
	selectedRecipeIdRaw: any,
	fallbackRecipeId: string?
): string?
	local selectedRecipeId = trim(selectedRecipeIdRaw)
	if selectedRecipeId ~= "" and hasRecipeId(entries, selectedRecipeId) then
		return selectedRecipeId
	end

	local fallback = trim(fallbackRecipeId)
	if fallback ~= "" and hasRecipeId(entries, fallback) then
		return fallback
	end

	if #entries <= 0 then
		return nil
	end
	return entries[1].recipeId
end

local function getCraftingState(): CraftingState
	return craftingStateAtom()
end

local function setCraftingState(stateRaw: any): CraftingState
	local current = craftingStateAtom()
	local source = if typeof(stateRaw) == "table" then (stateRaw :: { [string]: any }) else {}
	local nextRecipes = if source.recipes ~= nil then sanitizeRecipeEntries(source.recipes) else cloneRecipeEntries(current.recipes)
	local nextAvailableCategories = if source.availableCategories ~= nil
		then cloneStringArray(source.availableCategories)
		else cloneStringArray(current.availableCategories)
	local nextActiveStations = if source.activeStations ~= nil
		then cloneStringArray(source.activeStations)
		else cloneStringArray(current.activeStations)

	local nextSelectedRecipeId = normalizeSelectedRecipeId(
		nextRecipes,
		if source.selectedRecipeId ~= nil then source.selectedRecipeId else current.selectedRecipeId,
		current.selectedRecipeId
	)

	local nextState: CraftingState = {
		started = sanitizeBoolean(source.started, current.started),
		visible = sanitizeBoolean(source.visible, current.visible),
		searchQuery = if source.searchQuery ~= nil then trim(source.searchQuery) else current.searchQuery,
		categoryFilter = if source.categoryFilter ~= nil then trim(source.categoryFilter) else current.categoryFilter,
		selectedRecipeId = nextSelectedRecipeId,
		availableCategories = nextAvailableCategories,
		recipes = nextRecipes,
		activeStations = nextActiveStations,
		isBulkCrafting = sanitizeBoolean(source.isBulkCrafting, current.isBulkCrafting),
		lastCraftResult = if typeof(source.lastCraftResult) == "table"
			then source.lastCraftResult
			else if source.lastCraftResult == nil then current.lastCraftResult else nil,
		updatedAt = os.clock(),
	}
	craftingStateAtom(nextState)
	return nextState
end

local function applyServiceSnapshot(snapshotRaw: any): CraftingState
	return setCraftingState(snapshotRaw)
end

local function resetCraftingState(): CraftingState
	local nextState: CraftingState = {
		started = false,
		visible = false,
		searchQuery = "",
		categoryFilter = "",
		selectedRecipeId = nil,
		availableCategories = {},
		recipes = {},
		activeStations = {},
		isBulkCrafting = false,
		lastCraftResult = nil,
		updatedAt = os.clock(),
	}
	craftingStateAtom(nextState)
	return nextState
end

local function setVisible(visibleRaw: any): CraftingState
	return setCraftingState({
		visible = visibleRaw == true,
	})
end

local function toggleVisible(): CraftingState
	local current = craftingStateAtom()
	return setCraftingState({
		visible = not current.visible,
	})
end

local function setSearchQuery(searchQueryRaw: any): CraftingState
	return setCraftingState({
		searchQuery = searchQueryRaw,
	})
end

local function setCategoryFilter(categoryRaw: any): CraftingState
	return setCraftingState({
		categoryFilter = categoryRaw,
	})
end

local function setSelectedRecipeId(recipeIdRaw: any): CraftingState
	return setCraftingState({
		selectedRecipeId = recipeIdRaw,
	})
end

return {
	craftingStateAtom = craftingStateAtom,
	getCraftingState = getCraftingState,
	setCraftingState = setCraftingState,
	applyServiceSnapshot = applyServiceSnapshot,
	resetCraftingState = resetCraftingState,
	setVisible = setVisible,
	toggleVisible = toggleVisible,
	setSearchQuery = setSearchQuery,
	setCategoryFilter = setCategoryFilter,
	setSelectedRecipeId = setSelectedRecipeId,
}
]]></string>
                    </Properties>
                  </Item>
                  <Item class="ModuleScript" referent="889">
                    <Properties>
                      <string name="Name">craftingThunks</string>
                      <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Sift = require(ReplicatedStorage.Packages.Sift)

local ConnectionUtils = require(script:FindFirstAncestor("game").Client.UI.core.utils.ConnectionUtils)
local ServiceSync = require(script:FindFirstAncestor("game").Client.UI.core.utils.ServiceSync)
local craftingSlice = require(script:FindFirstAncestor("game").Client.UI.features.crafting.state.craftingSlice)
local CraftingServiceClient = require(script:FindFirstAncestor("game").Client.Services.CraftingServiceClient)

type CraftingState = craftingSlice.CraftingState

local craftingThunks = {}

local runtime = {
	started = false,
	stateChangedConnection = nil :: RBXScriptConnection?,
}

local function trim(textRaw: any): string
	if typeof(textRaw) ~= "string" then
		return ""
	end
	return string.match(textRaw, "^%s*(.-)%s*$") or ""
end

local function sanitizeQuantity(quantityRaw: any): number
	local quantity = 1
	if typeof(quantityRaw) == "number" and quantityRaw == quantityRaw then
		quantity = math.floor(quantityRaw)
	elseif typeof(quantityRaw) == "string" then
		local parsed = tonumber(trim(quantityRaw))
		if parsed ~= nil and parsed == parsed then
			quantity = math.floor(parsed)
		end
	end
	return math.clamp(quantity, 1, 99)
end

local function toStringArrayFromSet(setRaw: any): { string }
	local output: { string } = {}
	if typeof(setRaw) ~= "table" then
		return output
	end
	for key, value in setRaw do
		if typeof(key) == "string" and value == true then
			output[#output + 1] = key
		end
	end
	return Sift.Array.sort(output)
end

local function applyFromService(): CraftingState
	local currentState = craftingSlice.getCraftingState()

	local serviceState: { [string]: any } = {}
	local didReadState = pcall(function()
		serviceState = CraftingServiceClient:getState()
	end)
	if not didReadState then
		serviceState = {}
	end

	local searchQuery = currentState.searchQuery
	local categoryFilter = currentState.categoryFilter
	if typeof(serviceState.searchQuery) == "string" then
		searchQuery = serviceState.searchQuery
	end
	if typeof(serviceState.categoryFilter) == "string" then
		categoryFilter = serviceState.categoryFilter
	end

	local recipes: { [string]: any } = {}
	local didReadRecipes = pcall(function()
		recipes = CraftingServiceClient:getRecipes({
			category = categoryFilter,
			searchText = searchQuery,
		})
	end)
	if not didReadRecipes then
		recipes = {}
	end

	local availableCategories = if typeof(serviceState.availableCategories) == "table" then serviceState.availableCategories else {}
	local activeStations = toStringArrayFromSet(serviceState.activeStations)
	local selectedRecipeId = currentState.selectedRecipeId
	if typeof(selectedRecipeId) ~= "string" or selectedRecipeId == "" then
		selectedRecipeId = nil
	end
	if selectedRecipeId == nil and #recipes > 0 then
		selectedRecipeId = recipes[1].recipeId
	end

	return craftingSlice.applyServiceSnapshot({
		started = true,
		searchQuery = searchQuery,
		categoryFilter = categoryFilter,
		selectedRecipeId = selectedRecipeId,
		availableCategories = availableCategories,
		recipes = recipes,
		activeStations = activeStations,
		isBulkCrafting = serviceState.isBulkCrafting == true,
		lastCraftResult = if typeof(serviceState.lastCraftResult) == "table" then serviceState.lastCraftResult else nil,
	})
end

local function ensureStarted()
	if runtime.started then
		return
	end
	craftingThunks.Start()
end

function craftingThunks.Start(): () -> ()
	if runtime.started then
		return craftingThunks.Stop
	end

	runtime.started = true
	applyFromService()

	runtime.stateChangedConnection = ServiceSync.connectStateChanged(CraftingServiceClient, function()
		applyFromService()
	end)
	ServiceSync.requestSync(CraftingServiceClient)

	return craftingThunks.Stop
end

function craftingThunks.Stop()
	ConnectionUtils.disconnect(runtime.stateChangedConnection)
	runtime.stateChangedConnection = nil
	runtime.started = false
	craftingSlice.setCraftingState({
		started = false,
		isBulkCrafting = false,
	})
end

function craftingThunks.Refresh(): CraftingState
	ensureStarted()
	return applyFromService()
end

function craftingThunks.ToggleVisible(): CraftingState
	ensureStarted()
	return craftingSlice.toggleVisible()
end

function craftingThunks.SetVisible(visibleRaw: any): CraftingState
	ensureStarted()
	return craftingSlice.setVisible(visibleRaw)
end

function craftingThunks.SetSearchQuery(searchQueryRaw: any): CraftingState
	ensureStarted()
	local nextState = craftingSlice.setSearchQuery(searchQueryRaw)
	pcall(function()
		CraftingServiceClient:setSearchQuery(nextState.searchQuery)
	end)
	return applyFromService()
end

function craftingThunks.SetCategoryFilter(categoryRaw: any): CraftingState
	ensureStarted()
	local nextState = craftingSlice.setCategoryFilter(categoryRaw)
	pcall(function()
		CraftingServiceClient:setCategoryFilter(nextState.categoryFilter)
	end)
	return applyFromService()
end

function craftingThunks.SelectRecipe(recipeIdRaw: any): CraftingState
	ensureStarted()
	return craftingSlice.setSelectedRecipeId(recipeIdRaw)
end

function craftingThunks.RequestCraft(recipeIdRaw: any, quantityRaw: any): boolean
	ensureStarted()
	local recipeId = trim(recipeIdRaw)
	if recipeId == "" then
		return false
	end

	local quantity = sanitizeQuantity(quantityRaw)
	local didSend = false
	pcall(function()
		didSend = CraftingServiceClient:requestCraft(recipeId, quantity) == true
	end)
	task.defer(applyFromService)
	return didSend
end

function craftingThunks.CraftSelected(quantityRaw: any): boolean
	ensureStarted()
	local currentState = craftingSlice.getCraftingState()
	local selectedRecipeId = currentState.selectedRecipeId
	if selectedRecipeId == nil or selectedRecipeId == "" then
		return false
	end
	return craftingThunks.RequestCraft(selectedRecipeId, quantityRaw)
end

function craftingThunks.StartBulkCraftSelected(quantityRaw: any): boolean
	ensureStarted()
	local currentState = craftingSlice.getCraftingState()
	local selectedRecipeId = currentState.selectedRecipeId
	if selectedRecipeId == nil or selectedRecipeId == "" then
		return false
	end

	local quantity = sanitizeQuantity(quantityRaw)
	local didStart = false
	pcall(function()
		didStart = CraftingServiceClient:startBulkCraft(selectedRecipeId, quantity) == true
	end)
	task.defer(applyFromService)
	return didStart
end

function craftingThunks.StopBulkCraft(): boolean
	ensureStarted()
	local didStop = false
	pcall(function()
		didStop = CraftingServiceClient:stopBulkCraft() == true
	end)
	task.defer(applyFromService)
	return didStop
end

function craftingThunks.GetCraftingState(): CraftingState
	return craftingSlice.getCraftingState()
end

craftingThunks.start = craftingThunks.Start
craftingThunks.stop = craftingThunks.Stop
craftingThunks.refresh = craftingThunks.Refresh
craftingThunks.toggleVisible = craftingThunks.ToggleVisible
craftingThunks.setVisible = craftingThunks.SetVisible
craftingThunks.setSearchQuery = craftingThunks.SetSearchQuery
craftingThunks.setCategoryFilter = craftingThunks.SetCategoryFilter
craftingThunks.selectRecipe = craftingThunks.SelectRecipe
craftingThunks.requestCraft = craftingThunks.RequestCraft
craftingThunks.craftSelected = craftingThunks.CraftSelected
craftingThunks.startBulkCraftSelected = craftingThunks.StartBulkCraftSelected
craftingThunks.stopBulkCraft = craftingThunks.StopBulkCraft
craftingThunks.getCraftingState = craftingThunks.GetCraftingState

return craftingThunks
]]></string>
                    </Properties>
