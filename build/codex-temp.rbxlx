            <Item class="ModuleScript" referent="1168">
              <Properties>
                <string name="Name">EntityCatalog</string>
                <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local BossServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.BossServiceUtils)
local NpcDefinitions = require(script:FindFirstAncestor("game").Shared.Modules.Items.Npcs)

export type EntityKind = "Boss" | "Npc"
export type EntityEntry = {
	Id: string,
	Kind: EntityKind,
	Name: string,
	Tokens: { string },
	CanonicalToken: string,
}

local EntityCatalog = {}

local function normalizeToken(valueRaw: any): string
	return BossServiceUtils.normalizeToken(valueRaw)
end

local function cloneTokens(tokens: { string }): { string }
	local copy = table.create(#tokens)
	for index, token in tokens do
		copy[index] = token
	end
	return copy
end

local function cloneEntry(entry: EntityEntry): EntityEntry
	return {
		Id = entry.Id,
		Kind = entry.Kind,
		Name = entry.Name,
		Tokens = cloneTokens(entry.Tokens),
		CanonicalToken = entry.CanonicalToken,
	}
end

local function addUniqueToken(target: { string }, seen: { [string]: boolean }, tokenRaw: any)
	local token = normalizeToken(tokenRaw)
	if token == "" or seen[token] == true then
		return
	end

	seen[token] = true
	target[#target + 1] = token
end

local function buildEntries(): { EntityEntry }
	local entries = {}

	for _, bossEntry in BossServiceUtils.getRegistryEntries() do
		local tokens = {}
		local seen = {}
		for _, token in bossEntry.manualSummonTokens do
			addUniqueToken(tokens, seen, token)
		end
		addUniqueToken(tokens, seen, bossEntry.id)
		addUniqueToken(tokens, seen, bossEntry.displayName)

		entries[#entries + 1] = {
			Id = bossEntry.id,
			Kind = "Boss",
			Name = bossEntry.displayName,
			Tokens = tokens,
			CanonicalToken = tokens[1] or normalizeToken(bossEntry.id),
		}
	end

	if typeof(NpcDefinitions) == "table" then
		for npcId, definition in NpcDefinitions do
			if typeof(npcId) ~= "string" then
				continue
			end

			local displayName = if typeof(definition) == "table" and typeof((definition :: any).name) == "string"
				then (definition :: any).name
				else npcId

			local tokens = {}
			local seen = {}
			addUniqueToken(tokens, seen, npcId)
			addUniqueToken(tokens, seen, displayName)

			entries[#entries + 1] = {
				Id = npcId,
				Kind = "Npc",
				Name = displayName,
				Tokens = tokens,
				CanonicalToken = tokens[1] or normalizeToken(npcId),
			}
		end
	end

	table.sort(entries, function(left, right)
		if left.Kind ~= right.Kind then
			return left.Kind < right.Kind
		end
		return left.Name < right.Name
	end)

	return entries
end

local ENTRIES = buildEntries()

function EntityCatalog.GetEntries(): { EntityEntry }
	local copy = table.create(#ENTRIES)
	for index, entry in ENTRIES do
		copy[index] = cloneEntry(entry)
	end
	return copy
end

function EntityCatalog.Resolve(tokenRaw: any): EntityEntry?
	local normalizedToken = normalizeToken(tokenRaw)
	if normalizedToken == "" then
		return nil
	end

	for _, entry in ENTRIES do
		for _, token in entry.Tokens do
			if token == normalizedToken then
				return cloneEntry(entry)
			end
		end
	end

	return nil
end

function EntityCatalog.GetAutocompleteEntries(): { { Name: string, Entity: EntityEntry } }
	local entries = table.create(#ENTRIES)
	for index, entry in ENTRIES do
		entries[index] = {
			Name = (`{entry.Name} [{string.lower(entry.Kind)}]`),
			Entity = cloneEntry(entry),
		}
	end
	return entries
end

EntityCatalog.getEntries = EntityCatalog.GetEntries
EntityCatalog.resolve = EntityCatalog.Resolve
EntityCatalog.getAutocompleteEntries = EntityCatalog.GetAutocompleteEntries

return EntityCatalog
]]></string>
              </Properties>
            </Item>
            <Item class="Folder" referent="1169">
              <Properties>
                <string name="Name">Types</string>
              </Properties>
              <Item class="ModuleScript" referent="1170">
                <Properties>
                  <string name="Name">EntityToken</string>
                  <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local PACKAGE_NAME = "AquariaBackup"

local function resolveGameRoot(): Instance
	local directGameRoot = script:FindFirstAncestor("game")
	if directGameRoot ~= nil then
		return directGameRoot
	end

	local serverPackage = ServerScriptService:FindFirstChild(PACKAGE_NAME)
	if serverPackage ~= nil then
		local serverGameRoot = serverPackage:FindFirstChild("game")
		if serverGameRoot ~= nil then
			return serverGameRoot
		end
	end

	local replicatedPackage = ReplicatedStorage:FindFirstChild(PACKAGE_NAME) or ReplicatedStorage:WaitForChild(PACKAGE_NAME, 5)
	if replicatedPackage ~= nil then
		local replicatedGameRoot = replicatedPackage:FindFirstChild("game")
		if replicatedGameRoot ~= nil then
			return replicatedGameRoot
		end
	end

	error("Missing Nevermore game root for EntityToken.")
end

local gameRoot = resolveGameRoot()

local EntityCatalog = require(gameRoot.Shared.Cmdr.EntityCatalog)

type EntityEntry = EntityCatalog.EntityEntry

return function(registry)
	local cmdrUtil = registry.Cmdr.Util

	registry:RegisterType("entityToken", {
		Transform = function(text: string)
			local entries = EntityCatalog.getAutocompleteEntries()
			local exactEntity = EntityCatalog.resolve(text)
			local fuzzyFinder = cmdrUtil.MakeFuzzyFinder(entries)
			local matches = fuzzyFinder(text)

			if exactEntity == nil then
				return matches
			end

			local exactEntry = nil :: { Name: string, Entity: EntityEntry }?
			for _, entry in entries do
				if entry.Entity.Id == exactEntity.Id and entry.Entity.Kind == exactEntity.Kind then
					exactEntry = entry
					break
				end
			end

			if exactEntry == nil then
				return matches
			end

			local orderedMatches = { exactEntry }
			for _, entry in matches do
				if entry.Entity.Id ~= exactEntry.Entity.Id or entry.Entity.Kind ~= exactEntry.Entity.Kind then
					orderedMatches[#orderedMatches + 1] = entry
				end
			end

			return orderedMatches
		end,

		Validate = function(items)
			return #items > 0, "No matching entity was found."
		end,

		Autocomplete = function(items)
			return cmdrUtil.GetNames(items)
		end,

		Parse = function(items)
			return items[1].Entity
		end,
	})
end
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="1171">
                <Properties>
                  <string name="Name">InventoryItem</string>
                  <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local PACKAGE_NAME = "AquariaBackup"

local function resolveGameRoot(): Instance
	local directGameRoot = script:FindFirstAncestor("game")
	if directGameRoot ~= nil then
		return directGameRoot
	end

	local serverPackage = ServerScriptService:FindFirstChild(PACKAGE_NAME)
	if serverPackage ~= nil then
		local serverGameRoot = serverPackage:FindFirstChild("game")
		if serverGameRoot ~= nil then
			return serverGameRoot
		end
	end

	local replicatedPackage = ReplicatedStorage:FindFirstChild(PACKAGE_NAME) or ReplicatedStorage:WaitForChild(PACKAGE_NAME, 5)
	if replicatedPackage ~= nil then
		local replicatedGameRoot = replicatedPackage:FindFirstChild("game")
		if replicatedGameRoot ~= nil then
			return replicatedGameRoot
		end
	end

	error("Missing Nevermore game root for InventoryItem.")
end

local gameRoot = resolveGameRoot()

local ItemRegistry = require(gameRoot.Shared.Modules.Items.Registry)

type ItemAutocompleteEntry = {
	Name: string,
	ItemId: string,
}

local function getEntries(): { ItemAutocompleteEntry }
	local entries = {}
	local seen = {}
	local definitionsById = ItemRegistry.getDefinitionsById()

	for itemId, definition in definitionsById do
		if seen[itemId] == true then
			continue
		end

		seen[itemId] = true
		local displayName = if typeof(definition) == "table" and typeof((definition :: any).name) == "string"
			then (definition :: any).name
			else itemId
		entries[#entries + 1] = {
			Name = (`{displayName} [{itemId}]`),
			ItemId = itemId,
		}
	end

	table.sort(entries, function(a, b)
		return a.Name < b.Name
	end)

	return entries
end

return function(registry)
	local cmdrUtil = registry.Cmdr.Util

	registry:RegisterType("inventoryItem", {
		Transform = function(text: string)
			local entries = getEntries()
			local exactItemId = ItemRegistry.resolveCanonicalItemId(text)
			local findEntry = cmdrUtil.MakeFuzzyFinder(entries)
			local matches = findEntry(text)

			if exactItemId == nil then
				return matches
			end

			local exactEntry = nil :: ItemAutocompleteEntry?
			for _, entry in entries do
				if entry.ItemId == exactItemId then
					exactEntry = entry
					break
				end
			end

			if exactEntry == nil then
				return matches
			end

			local orderedMatches = { exactEntry }
			for _, entry in matches do
				if entry.ItemId ~= exactEntry.ItemId then
					orderedMatches[#orderedMatches + 1] = entry
				end
			end
			return orderedMatches
		end,

		Validate = function(items)
			return #items > 0, "No matching item was found."
		end,

		Autocomplete = function(items)
			return cmdrUtil.GetNames(items)
		end,

		Parse = function(items)
			return items[1].ItemId
		end,
	})
end
]]></string>
                </Properties>
