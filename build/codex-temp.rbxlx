              <Item class="ModuleScript" referent="1240">
                <Properties>
                  <string name="Name">MiningPower</string>
                  <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ItemRegistry = require(script:FindFirstAncestor("game").Shared.Modules.Items.Registry)

local MiningPower = {}

export type ToolProfile = {
	toolType: string?,
	toolPower: number,
}

export type SelectedToolContext = ToolProfile & {
	itemId: string,
	slotIndex: number,
}

export type TreeRequirement = {
	requiredToolType: string,
	requiredToolPower: number,
	treeTier: string,
}

export type TileRequirement = {
	requiredToolType: string,
	requiredToolPower: number,
	tileTier: string,
}

local TREE_REQUIREMENTS_BY_TOKEN: { [string]: TreeRequirement } = {
	defaulttree = {
		requiredToolType = "axe",
		requiredToolPower = 0,
		treeTier = "default",
	},
	foresttree = {
		requiredToolType = "axe",
		requiredToolPower = 0,
		treeTier = "forest",
	},
	jungletree = {
		requiredToolType = "axe",
		requiredToolPower = 35,
		treeTier = "jungle",
	},
	corrupttree = {
		requiredToolType = "axe",
		requiredToolPower = 50,
		treeTier = "corrupt",
	},
}

local TILE_REQUIREMENTS_BY_TOKEN: { [string]: TileRequirement } = {
	grass = {
		requiredToolType = "pickaxe",
		requiredToolPower = 0,
		tileTier = "surface",
	},
	dirt = {
		requiredToolType = "pickaxe",
		requiredToolPower = 0,
		tileTier = "surface",
	},
	stone = {
		requiredToolType = "pickaxe",
		requiredToolPower = 35,
		tileTier = "stone",
	},
	sand = {
		requiredToolType = "pickaxe",
		requiredToolPower = 0,
		tileTier = "surface",
	},
	sandstone = {
		requiredToolType = "pickaxe",
		requiredToolPower = 20,
		tileTier = "sandstone",
	},
	snow = {
		requiredToolType = "pickaxe",
		requiredToolPower = 0,
		tileTier = "surface",
	},
	ice = {
		requiredToolType = "pickaxe",
		requiredToolPower = 15,
		tileTier = "ice",
	},
	mud = {
		requiredToolType = "pickaxe",
		requiredToolPower = 0,
		tileTier = "surface",
	},
	clay = {
		requiredToolType = "pickaxe",
		requiredToolPower = 0,
		tileTier = "surface",
	},
	copperore = {
		requiredToolType = "pickaxe",
		requiredToolPower = 30,
		tileTier = "copper",
	},
	ironore = {
		requiredToolType = "pickaxe",
		requiredToolPower = 40,
		tileTier = "iron",
	},
	silverore = {
		requiredToolType = "pickaxe",
		requiredToolPower = 45,
		tileTier = "silver",
	},
	goldore = {
		requiredToolType = "pickaxe",
		requiredToolPower = 55,
		tileTier = "gold",
	},
	corruptgrass = {
		requiredToolType = "pickaxe",
		requiredToolPower = 0,
		tileTier = "surface",
	},
	corruptsoil = {
		requiredToolType = "pickaxe",
		requiredToolPower = 0,
		tileTier = "surface",
	},
	corruptstone = {
		requiredToolType = "pickaxe",
		requiredToolPower = 45,
		tileTier = "corrupt",
	},
	ebonstone = {
		requiredToolType = "pickaxe",
		requiredToolPower = 45,
		tileTier = "corrupt",
	},
	junglegrass = {
		requiredToolType = "pickaxe",
		requiredToolPower = 0,
		tileTier = "surface",
	},
	wood = {
		requiredToolType = "pickaxe",
		requiredToolPower = 0,
		tileTier = "surface",
	},
}

local TILE_REQUIREMENTS_BY_ID: { [number]: TileRequirement } = {
	[1] = TILE_REQUIREMENTS_BY_TOKEN.grass,
	[2] = TILE_REQUIREMENTS_BY_TOKEN.dirt,
	[3] = TILE_REQUIREMENTS_BY_TOKEN.stone,
	[4] = TILE_REQUIREMENTS_BY_TOKEN.sand,
	[5] = TILE_REQUIREMENTS_BY_TOKEN.sandstone,
	[6] = TILE_REQUIREMENTS_BY_TOKEN.snow,
	[7] = TILE_REQUIREMENTS_BY_TOKEN.ice,
	[8] = TILE_REQUIREMENTS_BY_TOKEN.mud,
	[9] = TILE_REQUIREMENTS_BY_TOKEN.clay,
	[10] = TILE_REQUIREMENTS_BY_TOKEN.copperore,
	[11] = TILE_REQUIREMENTS_BY_TOKEN.ironore,
	[12] = TILE_REQUIREMENTS_BY_TOKEN.silverore,
	[13] = TILE_REQUIREMENTS_BY_TOKEN.goldore,
	[14] = TILE_REQUIREMENTS_BY_TOKEN.corruptgrass,
	[15] = TILE_REQUIREMENTS_BY_TOKEN.corruptsoil,
	[16] = TILE_REQUIREMENTS_BY_TOKEN.corruptstone,
	[17] = TILE_REQUIREMENTS_BY_TOKEN.junglegrass,
	[18] = TILE_REQUIREMENTS_BY_TOKEN.wood,
}

local DEFAULT_TILE_REQUIREMENT: TileRequirement = {
	requiredToolType = "pickaxe",
	requiredToolPower = 0,
	tileTier = "default",
}

local function trim(valueRaw: any): string
	if typeof(valueRaw) ~= "string" then
		return ""
	end
	return string.match(valueRaw, "^%s*(.-)%s*$") or ""
end

local function sanitizeItemId(itemIdRaw: any): string?
	local itemId = trim(itemIdRaw)
	if itemId == "" then
		return nil
	end
	return itemId
end

local function normalizeToken(valueRaw: any): string
	local value = string.lower(trim(valueRaw))
	if value == "" then
		return ""
	end
	return string.gsub(value, "[%s_%-%%%.]+", "")
end

local function parseNumericValue(valueRaw: any): number?
	if typeof(valueRaw) == "number" and valueRaw == valueRaw then
		return valueRaw
	end
	if typeof(valueRaw) ~= "string" then
		return nil
	end

	local numericText = string.match(string.lower(valueRaw), "%-?%d+%.?%d*")
	if numericText == nil then
		return nil
	end

	local parsed = tonumber(numericText)
	if parsed == nil or parsed ~= parsed then
		return nil
	end
	return parsed
end

local function capitalizeToken(valueRaw: any): string?
	local normalized = normalizeToken(valueRaw)
	if normalized == "" then
		return nil
	end
	return string.upper(string.sub(normalized, 1, 1)) .. string.sub(normalized, 2)
end

local function coerceDefinition(definitionRaw: any): { [string]: any }
	if typeof(definitionRaw) == "table" then
		return definitionRaw :: { [string]: any }
	end
	return {}
end

function MiningPower.ParsePowerPercent(valueRaw: any): number?
	local numericValue = parseNumericValue(valueRaw)
	if numericValue == nil then
		return nil
	end
	return math.max(0, numericValue)
end

function MiningPower.ResolveToolPower(definitionRaw: any, fallbackRaw: any?): number
	local definition = coerceDefinition(definitionRaw)
	local stats = coerceDefinition(definition.stats)
	local mining = coerceDefinition(definition.mining)

	local candidates = {
		mining.power,
		mining.toolPower,
		mining.miningPower,
		definition.power,
		definition.toolPower,
		definition.miningPower,
		stats.power,
		stats.toolPower,
		stats.miningPower,
		fallbackRaw,
	}

	for _, candidate in candidates do
		local resolved = MiningPower.ParsePowerPercent(candidate)
		if resolved ~= nil then
			return resolved
		end
	end

	return 0
end

function MiningPower.ResolveToolType(definitionRaw: any, fallbackRaw: any?): string?
	local definition = coerceDefinition(definitionRaw)
	local mining = coerceDefinition(definition.mining)

	local candidates = {
		mining.toolType,
		mining.harvestType,
		definition.toolType,
		definition.harvestType,
		definition.itemType,
		definition.type,
		fallbackRaw,
	}

	for _, candidate in candidates do
		local normalized = normalizeToken(candidate)
		if normalized ~= "" then
			return normalized
		end
	end

	return nil
end

function MiningPower.ResolveToolProfile(definitionRaw: any, fallbackTypeRaw: any?, fallbackPowerRaw: any?): ToolProfile
	return {
		toolType = MiningPower.ResolveToolType(definitionRaw, fallbackTypeRaw),
		toolPower = MiningPower.ResolveToolPower(definitionRaw, fallbackPowerRaw),
	}
end

function MiningPower.ResolveItemToolProfile(itemIdRaw: any): ToolProfile?
	local itemId = sanitizeItemId(itemIdRaw)
	if itemId == nil then
		return nil
	end

	local canonicalItemId = ItemRegistry.resolveCanonicalItemId(itemId)
	if canonicalItemId == nil then
		return nil
	end

	local definition = ItemRegistry.resolveDefinition(canonicalItemId)
	if typeof(definition) ~= "table" then
		return nil
	end

	local profile = MiningPower.ResolveToolProfile(definition, nil, nil)
	if profile.toolType == nil then
		return nil
	end

	return profile
end

function MiningPower.ResolveSelectedToolContextFromInventoryState(stateRaw: any): SelectedToolContext?
	if typeof(stateRaw) ~= "table" then
		return nil
	end

	local state = stateRaw :: { [string]: any }
	local selectedSlotRaw = state.selectedSlot
	if typeof(selectedSlotRaw) ~= "number" or selectedSlotRaw ~= selectedSlotRaw then
		return nil
	end

	local selectedSlot = math.floor(selectedSlotRaw)
	if selectedSlot <= 0 then
		return nil
	end

	local slots = state.slots
	if typeof(slots) ~= "table" then
		return nil
	end

	local slot = slots[selectedSlot]
	if typeof(slot) ~= "table" then
		return nil
	end

	local stack = (slot :: { [string]: any }).stack
	if typeof(stack) ~= "table" then
		return nil
	end

	local stackTable = stack :: { [string]: any }
	local amount = stackTable.amount
	if typeof(amount) == "number" and amount == amount and amount <= 0 then
		return nil
	end

	local canonicalItemId = ItemRegistry.resolveCanonicalItemId(stackTable.itemId)
	if canonicalItemId == nil then
		return nil
	end

	local profile = MiningPower.ResolveItemToolProfile(canonicalItemId)
	if profile == nil then
		return nil
	end

	return {
		itemId = canonicalItemId,
		slotIndex = selectedSlot,
		toolType = profile.toolType,
		toolPower = profile.toolPower,
	}
end

function MiningPower.ResolveTreeRequirement(treeTypeRaw: any): TreeRequirement
	local normalized = normalizeToken(treeTypeRaw)
	if normalized ~= "" then
		local direct = TREE_REQUIREMENTS_BY_TOKEN[normalized]
		if direct ~= nil then
			return direct
		end

		if string.find(normalized, "corrupt", 1, true) ~= nil or string.find(normalized, "ebon", 1, true) ~= nil then
			return TREE_REQUIREMENTS_BY_TOKEN.corrupttree
		end
		if string.find(normalized, "jungle", 1, true) ~= nil or string.find(normalized, "mahogany", 1, true) ~= nil then
			return TREE_REQUIREMENTS_BY_TOKEN.jungletree
		end
		if string.find(normalized, "forest", 1, true) ~= nil or string.find(normalized, "wood", 1, true) ~= nil then
			return TREE_REQUIREMENTS_BY_TOKEN.foresttree
		end
	end

	return TREE_REQUIREMENTS_BY_TOKEN.defaulttree
end

function MiningPower.ResolveTileRequirement(tileIdRaw: any, tileNameRaw: any?): TileRequirement
	if typeof(tileIdRaw) == "number" and tileIdRaw == tileIdRaw then
		local direct = TILE_REQUIREMENTS_BY_ID[math.floor(tileIdRaw)]
		if direct ~= nil then
			return direct
		end
	end

	local normalized = normalizeToken(tileNameRaw)
	if normalized ~= "" then
		local direct = TILE_REQUIREMENTS_BY_TOKEN[normalized]
		if direct ~= nil then
			return direct
		end

		if string.find(normalized, "corrupt", 1, true) ~= nil or string.find(normalized, "ebon", 1, true) ~= nil then
			return TILE_REQUIREMENTS_BY_TOKEN.corruptstone
		end
		if string.find(normalized, "gold", 1, true) ~= nil then
			return TILE_REQUIREMENTS_BY_TOKEN.goldore
		end
		if string.find(normalized, "silver", 1, true) ~= nil then
			return TILE_REQUIREMENTS_BY_TOKEN.silverore
		end
		if string.find(normalized, "iron", 1, true) ~= nil then
			return TILE_REQUIREMENTS_BY_TOKEN.ironore
		end
		if string.find(normalized, "copper", 1, true) ~= nil then
			return TILE_REQUIREMENTS_BY_TOKEN.copperore
		end
		if string.find(normalized, "stone", 1, true) ~= nil then
			return TILE_REQUIREMENTS_BY_TOKEN.stone
		end
	end

	return DEFAULT_TILE_REQUIREMENT
end

function MiningPower.ToToolAttributeBundle(
	definitionRaw: any,
	fallbackTypeRaw: any?,
	fallbackPowerRaw: any?
): { [string]: any }
	local profile = MiningPower.ResolveToolProfile(definitionRaw, fallbackTypeRaw, fallbackPowerRaw)
	local attributes: { [string]: any } = {}
	local toolType = profile.toolType
	if toolType ~= nil then
		local capitalizedToolType = capitalizeToken(toolType)
		attributes.ToolType = toolType
		attributes.HarvestType = toolType
		if capitalizedToolType ~= nil then
			attributes.WeaponType = capitalizedToolType
		end
	end

	attributes.ToolPower = profile.toolPower
	attributes.MiningPower = profile.toolPower

	if toolType == "pickaxe" then
		attributes.PickaxePower = profile.toolPower
	elseif toolType == "axe" then
		attributes.AxePower = profile.toolPower
	end

	return attributes
end

MiningPower.parsePowerPercent = MiningPower.ParsePowerPercent
MiningPower.resolveToolPower = MiningPower.ResolveToolPower
MiningPower.resolveToolType = MiningPower.ResolveToolType
MiningPower.resolveToolProfile = MiningPower.ResolveToolProfile
MiningPower.resolveItemToolProfile = MiningPower.ResolveItemToolProfile
MiningPower.resolveSelectedToolContextFromInventoryState = MiningPower.ResolveSelectedToolContextFromInventoryState
MiningPower.resolveTreeRequirement = MiningPower.ResolveTreeRequirement
MiningPower.resolveTileRequirement = MiningPower.ResolveTileRequirement
MiningPower.toToolAttributeBundle = MiningPower.ToToolAttributeBundle

return MiningPower
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="1241">
                <Properties>
                  <string name="Name">Noise</string>
                  <string name="Source"><![CDATA[--!strict
-- Seeded deterministic value-noise sampling helpers.

local Rand = require(script.Parent.Rand)
local Num = require(script.Parent.Num)

local Noise = {}

export type SeedInput = number | string | boolean

local UINT32_MOD = 4294967296

local function hashToUnit(hash: number): number
	return (hash % UINT32_MOD) / UINT32_MOD
end

local function fade(t: number): number
	return t * t * t * (t * (t * 6 - 15) + 10)
end

local function lerp(a: number, b: number, t: number): number
	return a + (b - a) * t
end

local function resolveScale(scale: number?): number
	local resolved = math.abs(scale or 1)
	if resolved == 0 then
		return 1
	end
	return resolved
end

local function unit1(seed: number, x: number): number
	local x0 = math.floor(x)
	local x1 = x0 + 1
	local tx = fade(x - x0)
	local v0 = hashToUnit(Rand.hashCoordinates(seed, x0, 0, 0))
	local v1 = hashToUnit(Rand.hashCoordinates(seed, x1, 0, 0))
	return lerp(v0, v1, tx)
end

local function unit2(seed: number, x: number, y: number): number
	local x0 = math.floor(x)
	local y0 = math.floor(y)
	local x1 = x0 + 1
	local y1 = y0 + 1
	local tx = fade(x - x0)
	local ty = fade(y - y0)

	local v00 = hashToUnit(Rand.hashCoordinates(seed, x0, y0, 0))
	local v10 = hashToUnit(Rand.hashCoordinates(seed, x1, y0, 0))
	local v01 = hashToUnit(Rand.hashCoordinates(seed, x0, y1, 0))
	local v11 = hashToUnit(Rand.hashCoordinates(seed, x1, y1, 0))

	local top = lerp(v00, v10, tx)
	local bottom = lerp(v01, v11, tx)
	return lerp(top, bottom, ty)
end

local function unit3(seed: number, x: number, y: number, z: number): number
	local x0 = math.floor(x)
	local y0 = math.floor(y)
	local z0 = math.floor(z)
	local x1 = x0 + 1
	local y1 = y0 + 1
	local z1 = z0 + 1
	local tx = fade(x - x0)
	local ty = fade(y - y0)
	local tz = fade(z - z0)

	local c000 = hashToUnit(Rand.hashCoordinates(seed, x0, y0, z0))
	local c100 = hashToUnit(Rand.hashCoordinates(seed, x1, y0, z0))
	local c010 = hashToUnit(Rand.hashCoordinates(seed, x0, y1, z0))
	local c110 = hashToUnit(Rand.hashCoordinates(seed, x1, y1, z0))
	local c001 = hashToUnit(Rand.hashCoordinates(seed, x0, y0, z1))
	local c101 = hashToUnit(Rand.hashCoordinates(seed, x1, y0, z1))
	local c011 = hashToUnit(Rand.hashCoordinates(seed, x0, y1, z1))
	local c111 = hashToUnit(Rand.hashCoordinates(seed, x1, y1, z1))

	local x00 = lerp(c000, c100, tx)
	local x10 = lerp(c010, c110, tx)
	local x01 = lerp(c001, c101, tx)
	local x11 = lerp(c011, c111, tx)
	local y00 = lerp(x00, x10, ty)
	local y11 = lerp(x01, x11, ty)
	return lerp(y00, y11, tz)
end

function Noise.ToUnit(value: number): number
	return Num.saturate(value * 0.5 + 0.5)
end

function Noise.ToSigned(value: number): number
	return Num.saturate(value) * 2 - 1
end

function Noise.FbmOctaves(
	octaves: number?,
	persistence: number?,
	lacunarity: number?,
	sampleOctave: (number, number) -> number
): number
	local count = math.max(1, math.floor(octaves or 1))
	local persistenceValue = persistence or 0.5
	local lacunarityValue = lacunarity or 2
	local amplitude = 1
	local frequency = 1
	local total = 0
	local weightTotal = 0

	for octave = 1, count do
		total = total + sampleOctave(octave, frequency) * amplitude
		weightTotal = weightTotal + amplitude
		amplitude = amplitude * persistenceValue
		frequency = frequency * lacunarityValue
	end

	if weightTotal == 0 then
		return 0
	end
	return total / weightTotal
end

function Noise.Sample1(x: number, scale: number?, seedRaw: SeedInput?): number
	local seed = Rand.seed(seedRaw)
	local scaledX = x / resolveScale(scale)
	return Noise.ToSigned(unit1(seed, scaledX))
end

function Noise.Sample2(x: number, y: number, scale: number?, seedRaw: SeedInput?): number
	local seed = Rand.seed(seedRaw)
	local resolvedScale = resolveScale(scale)
	return Noise.ToSigned(unit2(seed, x / resolvedScale, y / resolvedScale))
end

function Noise.Sample3(x: number, y: number, z: number, scale: number?, seedRaw: SeedInput?): number
	local seed = Rand.seed(seedRaw)
	local resolvedScale = resolveScale(scale)
	return Noise.ToSigned(unit3(seed, x / resolvedScale, y / resolvedScale, z / resolvedScale))
end

function Noise.SampleUnit1(x: number, scale: number?, seedRaw: SeedInput?): number
	local seed = Rand.seed(seedRaw)
	local scaledX = x / resolveScale(scale)
	return unit1(seed, scaledX)
end

function Noise.SampleUnit2(x: number, y: number, scale: number?, seedRaw: SeedInput?): number
	local seed = Rand.seed(seedRaw)
	local resolvedScale = resolveScale(scale)
	return unit2(seed, x / resolvedScale, y / resolvedScale)
end

function Noise.SampleUnit3(x: number, y: number, z: number, scale: number?, seedRaw: SeedInput?): number
	local seed = Rand.seed(seedRaw)
	local resolvedScale = resolveScale(scale)
	return unit3(seed, x / resolvedScale, y / resolvedScale, z / resolvedScale)
end

function Noise.Fbm1(x: number, scale: number?, seedRaw: SeedInput?, octaves: number?, persistence: number?, lacunarity: number?): number
	local seed = Rand.seed(seedRaw)
	local resolvedScale = resolveScale(scale)
	return Noise.FbmOctaves(octaves or 4, persistence or 0.5, lacunarity or 2, function(octave, frequency)
		local octaveSeed = Rand.fork(seed, octave)
		return Noise.ToSigned(unit1(octaveSeed, x / resolvedScale * frequency))
	end)
end

function Noise.Fbm2(
	x: number,
	y: number,
	scale: number?,
	seedRaw: SeedInput?,
	octaves: number?,
	persistence: number?,
	lacunarity: number?
): number
	local seed = Rand.seed(seedRaw)
	local resolvedScale = resolveScale(scale)
	return Noise.FbmOctaves(octaves or 4, persistence or 0.5, lacunarity or 2, function(octave, frequency)
		local octaveSeed = Rand.fork(seed, octave)
		return Noise.ToSigned(unit2(octaveSeed, x / resolvedScale * frequency, y / resolvedScale * frequency))
	end)
end

function Noise.Fbm3(
	x: number,
	y: number,
	z: number,
	scale: number?,
	seedRaw: SeedInput?,
	octaves: number?,
	persistence: number?,
	lacunarity: number?
): number
	local seed = Rand.seed(seedRaw)
	local resolvedScale = resolveScale(scale)
	return Noise.FbmOctaves(octaves or 4, persistence or 0.5, lacunarity or 2, function(octave, frequency)
		local octaveSeed = Rand.fork(seed, octave)
		return Noise.ToSigned(unit3(
			octaveSeed,
			x / resolvedScale * frequency,
			y / resolvedScale * frequency,
			z / resolvedScale * frequency
		))
	end)
end

function Noise.FbmUnit1(
	x: number,
	scale: number?,
	seedRaw: SeedInput?,
	octaves: number?,
	persistence: number?,
	lacunarity: number?
): number
	return Noise.ToUnit(Noise.Fbm1(x, scale, seedRaw, octaves, persistence, lacunarity))
end

function Noise.FbmUnit2(
	x: number,
	y: number,
	scale: number?,
	seedRaw: SeedInput?,
	octaves: number?,
	persistence: number?,
	lacunarity: number?
): number
	return Noise.ToUnit(Noise.Fbm2(x, y, scale, seedRaw, octaves, persistence, lacunarity))
end

function Noise.FbmUnit3(
	x: number,
	y: number,
	z: number,
	scale: number?,
	seedRaw: SeedInput?,
	octaves: number?,
	persistence: number?,
	lacunarity: number?
): number
	return Noise.ToUnit(Noise.Fbm3(x, y, z, scale, seedRaw, octaves, persistence, lacunarity))
end

Noise.toUnit = Noise.ToUnit
Noise.toSigned = Noise.ToSigned
Noise.fbmOctaves = Noise.FbmOctaves
Noise.sample1 = Noise.Sample1
Noise.sample2 = Noise.Sample2
Noise.sample3 = Noise.Sample3
Noise.sampleUnit1 = Noise.SampleUnit1
Noise.sampleUnit2 = Noise.SampleUnit2
Noise.sampleUnit3 = Noise.SampleUnit3
Noise.fbm1 = Noise.Fbm1
Noise.fbm2 = Noise.Fbm2
Noise.fbm3 = Noise.Fbm3
Noise.fbmUnit1 = Noise.FbmUnit1
Noise.fbmUnit2 = Noise.FbmUnit2
Noise.fbmUnit3 = Noise.FbmUnit3

return Noise
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="1242">
                <Properties>
                  <string name="Name">Num</string>
                  <string name="Source"><![CDATA[--!strict
-- Core scalar helpers.

local Num = {}

local DEFAULT_EPSILON = 1e-5

local function sortBounds(minValue: number, maxValue: number): (number, number)
	if minValue <= maxValue then
		return minValue, maxValue
	end
	return maxValue, minValue
end

local function roundInteger(value: number): number
	if value >= 0 then
		return math.floor(value + 0.5)
	end
	return math.ceil(value - 0.5)
end

function Num.IsFinite(value: any): boolean
	return typeof(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

function Num.Clamp(value: number, minValue: number, maxValue: number): number
	local low, high = sortBounds(minValue, maxValue)
	if value < low then
		return low
	end
	if value > high then
		return high
	end
	return value
end

function Num.Saturate(value: number): number
	return Num.Clamp(value, 0, 1)
end

function Num.Sign(value: number): number
	if value > 0 then
		return 1
	end
	if value < 0 then
		return -1
	end
	return 0
end

function Num.NearlyEqual(a: number, b: number, epsilon: number?): boolean
	if a == b then
		return true
	end

	local tolerance = math.max(epsilon or DEFAULT_EPSILON, 0)
	local difference = math.abs(a - b)
	if difference <= tolerance then
		return true
	end

	local scale = math.max(1, math.abs(a), math.abs(b))
	return difference <= tolerance * scale
end

function Num.Round(value: number, digits: number?): number
	local places = math.floor(digits or 0)
	if places == 0 then
		return roundInteger(value)
	end

	local factor = 10 ^ math.abs(places)
	if places > 0 then
		return roundInteger(value * factor) / factor
	end
	return roundInteger(value / factor) * factor
end

function Num.Snap(value: number, step: number, origin: number?): number
	local interval = math.abs(step)
	if interval == 0 then
		return value
	end

	local offset = origin or 0
	return offset + Num.Round((value - offset) / interval) * interval
end

function Num.InverseLerp(a: number, b: number, value: number): number
	local delta = b - a
	if delta == 0 then
		return 0
	end
	return (value - a) / delta
end

function Num.Remap(
	value: number,
	fromMin: number,
	fromMax: number,
	toMin: number,
	toMax: number
): number
	return toMin + (toMax - toMin) * Num.InverseLerp(fromMin, fromMax, value)
end

function Num.SafeDiv(numerator: number, denominator: number, fallback: number?): number
	if denominator == 0 then
		return fallback or 0
	end
	return numerator / denominator
end

function Num.Fract(value: number): number
	return value - math.floor(value)
end

Num.isFinite = Num.IsFinite
Num.clamp = Num.Clamp
Num.saturate = Num.Saturate
Num.sign = Num.Sign
Num.nearlyEqual = Num.NearlyEqual
Num.round = Num.Round
Num.snap = Num.Snap
Num.inverseLerp = Num.InverseLerp
Num.remap = Num.Remap
Num.safeDiv = Num.SafeDiv
Num.fract = Num.Fract

return Num
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="1243">
                <Properties>
                  <string name="Name">Osc</string>
                  <string name="Source"><![CDATA[--!strict
-- Deterministic waveform and ping-pong helpers.

local Num = require(script.Parent.Num)
local Range = require(script.Parent.Range)
local Trig = require(script.Parent.Trig)

local Osc = {}

function Osc.Phase01(time: number, frequency: number, phaseRadians: number?): number
	local cycles = time * frequency + (phaseRadians or 0) / Trig.TAU
	return Range.wrap(cycles, 0, 1)
end

function Osc.Sine(time: number, amplitude: number?, frequency: number?, phaseRadians: number?, offset: number?): number
	local amp = amplitude or 1
	local hz = frequency or 1
	local phase = phaseRadians or 0
	local bias = offset or 0
	return bias + amp * math.sin(Trig.TAU * hz * time + phase)
end

function Osc.Cosine(time: number, amplitude: number?, frequency: number?, phaseRadians: number?, offset: number?): number
	local amp = amplitude or 1
	local hz = frequency or 1
	local phase = phaseRadians or 0
	local bias = offset or 0
	return bias + amp * math.cos(Trig.TAU * hz * time + phase)
end

function Osc.Triangle(time: number, amplitude: number?, frequency: number?, phaseRadians: number?, offset: number?): number
	local amp = amplitude or 1
	local hz = frequency or 1
	local bias = offset or 0
	local phase = Osc.Phase01(time, hz, phaseRadians)
	local wave = 1 - 4 * math.abs(phase - 0.5)
	return bias + amp * wave
end

function Osc.Saw(time: number, amplitude: number?, frequency: number?, phaseRadians: number?, offset: number?): number
	local amp = amplitude or 1
	local hz = frequency or 1
	local bias = offset or 0
	local phase = Osc.Phase01(time, hz, phaseRadians)
	return bias + amp * (phase * 2 - 1)
end

function Osc.Square(
	time: number,
	amplitude: number?,
	frequency: number?,
	phaseRadians: number?,
	dutyCycle: number?,
	offset: number?
): number
	local amp = amplitude or 1
	local hz = frequency or 1
	local bias = offset or 0
	local duty = Num.clamp(dutyCycle or 0.5, 0, 1)
	local phase = Osc.Phase01(time, hz, phaseRadians)
	local wave = if phase < duty then 1 else -1
	return bias + amp * wave
end

function Osc.PingPong(time: number, length: number): number
	local extent = math.max(length, 0)
	if extent == 0 then
		return 0
	end

	local wrapped = Range.wrap(time, 0, extent * 2)
	return extent - math.abs(wrapped - extent)
end

Osc.phase01 = Osc.Phase01
Osc.sine = Osc.Sine
Osc.cosine = Osc.Cosine
Osc.triangle = Osc.Triangle
Osc.saw = Osc.Saw
Osc.square = Osc.Square
Osc.pingPong = Osc.PingPong

return Osc
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="1244">
                <Properties>
                  <string name="Name">Plane</string>
                  <string name="Source"><![CDATA[--!strict
-- Plane construction, distances, projections, and intersections.

local Vec = require(script.Parent.Vec)

local Plane = {}

export type Plane = {
	normal: Vector3,
	distance: number,
}

export type Intersection = {
	t: number,
	point: Vector3,
}

local EPSILON = 1e-8
local Y_AXIS = Vector3.new(0, 1, 0)

function Plane.New(normal: Vector3, distance: number): Plane
	local unitNormal = Vec.unit(normal, Y_AXIS)
	return {
		normal = unitNormal,
		distance = distance,
	}
end

function Plane.FromPointNormal(point: Vector3, normal: Vector3): Plane
	local unitNormal = Vec.unit(normal, Y_AXIS)
	return {
		normal = unitNormal,
		distance = unitNormal:Dot(point),
	}
end

function Plane.FromPoints(a: Vector3, b: Vector3, c: Vector3): Plane
	local unitNormal = Vec.unit((b - a):Cross(c - a), Y_AXIS)
	return {
		normal = unitNormal,
		distance = unitNormal:Dot(a),
	}
end

function Plane.SignedDistance(plane: Plane, point: Vector3): number
	return plane.normal:Dot(point) - plane.distance
end

function Plane.ClosestPoint(plane: Plane, point: Vector3): Vector3
	return point - plane.normal * Plane.SignedDistance(plane, point)
end

function Plane.ProjectPoint(plane: Plane, point: Vector3): Vector3
	return Plane.ClosestPoint(plane, point)
end

function Plane.ReflectPoint(plane: Plane, point: Vector3): Vector3
	local signedDistance = Plane.SignedDistance(plane, point)
	return point - plane.normal * (2 * signedDistance)
end

function Plane.IntersectLine(plane: Plane, origin: Vector3, direction: Vector3): Intersection?
	local denominator = plane.normal:Dot(direction)
	if math.abs(denominator) <= EPSILON then
		return nil
	end

	local t = (plane.distance - plane.normal:Dot(origin)) / denominator
	return {
		t = t,
		point = origin + direction * t,
	}
end

function Plane.Raycast(plane: Plane, origin: Vector3, direction: Vector3): Intersection?
	local hit = Plane.IntersectLine(plane, origin, direction)
	if hit == nil or hit.t < 0 then
		return nil
	end
	return hit
end

Plane.new = Plane.New
Plane.fromPointNormal = Plane.FromPointNormal
Plane.fromPoints = Plane.FromPoints
Plane.signedDistance = Plane.SignedDistance
Plane.closestPoint = Plane.ClosestPoint
Plane.projectPoint = Plane.ProjectPoint
Plane.reflectPoint = Plane.ReflectPoint
Plane.intersectLine = Plane.IntersectLine
Plane.raycast = Plane.Raycast

return Plane
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="1245">
                <Properties>
                  <string name="Name">Proj</string>
                  <string name="Source"><![CDATA[--!strict
-- Projection, rejection, reflection, and closest-point helpers.

local Num = require(script.Parent.Num)
local Vec = require(script.Parent.Vec)

local Proj = {}

function Proj.Scalar(vector: Vector3, onto: Vector3): number
	local axis = Vec.unit(onto)
	if axis == Vector3.zero then
		return 0
	end
	return vector:Dot(axis)
end

function Proj.Vector(vector: Vector3, onto: Vector3): Vector3
	local denominator = onto:Dot(onto)
	if denominator == 0 then
		return Vector3.zero
	end
	return onto * (vector:Dot(onto) / denominator)
end

function Proj.Reject(vector: Vector3, onto: Vector3): Vector3
	return vector - Proj.Vector(vector, onto)
end

function Proj.OntoPlane(vector: Vector3, planeNormal: Vector3): Vector3
	return vector - Proj.Vector(vector, planeNormal)
end

function Proj.Reflect(vector: Vector3, normal: Vector3): Vector3
	local unitNormal = Vec.unit(normal)
	if unitNormal == Vector3.zero then
		return vector
	end
	return vector - unitNormal * (2 * vector:Dot(unitNormal))
end

function Proj.PointOnLine(point: Vector3, lineOrigin: Vector3, lineDirection: Vector3): Vector3
	local denominator = lineDirection:Dot(lineDirection)
	if denominator == 0 then
		return lineOrigin
	end

	local t = (point - lineOrigin):Dot(lineDirection) / denominator
	return lineOrigin + lineDirection * t
end

function Proj.PointOnRay(point: Vector3, rayOrigin: Vector3, rayDirection: Vector3): Vector3
	local denominator = rayDirection:Dot(rayDirection)
	if denominator == 0 then
		return rayOrigin
	end

	local t = math.max(0, (point - rayOrigin):Dot(rayDirection) / denominator)
	return rayOrigin + rayDirection * t
end

function Proj.PointOnSegment(point: Vector3, a: Vector3, b: Vector3): Vector3
	local segment = b - a
	local denominator = segment:Dot(segment)
	if denominator == 0 then
		return a
	end

	local t = Num.clamp((point - a):Dot(segment) / denominator, 0, 1)
	return a + segment * t
end

Proj.scalar = Proj.Scalar
Proj.vector = Proj.Vector
Proj.reject = Proj.Reject
Proj.ontoPlane = Proj.OntoPlane
Proj.reflect = Proj.Reflect
Proj.pointOnLine = Proj.PointOnLine
Proj.pointOnRay = Proj.PointOnRay
Proj.pointOnSegment = Proj.PointOnSegment

return Proj
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="1246">
                <Properties>
                  <string name="Name">Rand</string>
                  <string name="Source"><![CDATA[--!strict
-- Stateless deterministic random helpers built around explicit seeds.

local Num = require(script.Parent.Num)

local Rand = {}

export type SeedInput = number | string | boolean

export type WeightedEntry<T> = {
	value: T,
	weight: number,
}

local UINT32_MAX = 4294967295
local UINT32_MOD = 4294967296
local DEFAULT_SEED = 1

local function normalizeUint32(value: number): number
	local integer = math.floor(value) % UINT32_MOD
	if integer < 0 then
		integer = integer + UINT32_MOD
	end
	if integer == 0 then
		integer = DEFAULT_SEED
	end
	return integer
end

function Rand.Uint32(value: number): number
	return normalizeUint32(value)
end

function Rand.HashString(source: string): number
	local hash = 2166136261
	for index = 1, #source do
		hash = bit32.bxor(hash, string.byte(source, index))
		hash = (hash * 16777619) % UINT32_MOD
	end
	return normalizeUint32(hash)
end

function Rand.HashCoordinates(seed: number, x: number, y: number, z: number?): number
	local xi = normalizeUint32(x)
	local yi = normalizeUint32(y)
	local zi = normalizeUint32(z or 0)

	local hash = normalizeUint32(seed)
	hash = bit32.bxor(hash, bit32.band(xi * 374761393, UINT32_MAX))
	hash = bit32.bxor(hash, bit32.band(yi * 668265263, UINT32_MAX))
	hash = bit32.bxor(hash, bit32.band(zi * 2147483647, UINT32_MAX))
	hash = bit32.band(hash * 1274126177, UINT32_MAX)
	hash = bit32.bxor(hash, bit32.rshift(hash, 16))
	return normalizeUint32(hash)
end

local function xorshift32(state: number): number
	local x = bit32.bxor(state, bit32.lshift(state, 13))
	x = bit32.bxor(x, bit32.rshift(x, 17))
	x = bit32.bxor(x, bit32.lshift(x, 5))
	x = bit32.band(x, UINT32_MAX)
	if x == 0 then
		return DEFAULT_SEED
	end
	return x
end

function Rand.Seed(seedRaw: SeedInput?): number
	local kind = typeof(seedRaw)
	if kind == "nil" then
		return DEFAULT_SEED
	end
	if kind == "number" then
		return normalizeUint32(seedRaw :: number)
	end
	if kind == "string" then
		return Rand.HashString(seedRaw :: string)
	end
	if kind == "boolean" then
		return if seedRaw == true then 1 else 2
	end
	return Rand.HashString(tostring(seedRaw))
end

function Rand.Step(seed: number): (number, number)
	local nextSeed = xorshift32(normalizeUint32(seed))
	return nextSeed, nextSeed
end

function Rand.Number(seed: number, minValue: number?, maxValue: number?): (number, number)
	local nextSeed, raw = Rand.Step(seed)
	local unit = raw / UINT32_MOD

	if minValue == nil and maxValue == nil then
		return nextSeed, unit
	end

	local minResolved = if minValue ~= nil then minValue else 0
	local maxResolved = if maxValue ~= nil then maxValue else 1
	if maxResolved < minResolved then
		local temporary = maxResolved
		maxResolved = minResolved
		minResolved = temporary
	end

	return nextSeed, minResolved + (maxResolved - minResolved) * unit
end

function Rand.Integer(seed: number, minValue: number, maxValue: number): (number, number)
	local low = math.floor(minValue)
	local high = math.floor(maxValue)
	if high < low then
		local temporary = high
		high = low
		low = temporary
	end

	local span = high - low + 1
	if span <= 1 then
		return normalizeUint32(seed), low
	end

	local nextSeed, raw = Rand.Step(seed)
	return nextSeed, low + (raw % span)
end

function Rand.Chance(seed: number, probability: number): (number, boolean)
	local nextSeed, value = Rand.Number(seed)
	return nextSeed, value <= Num.saturate(probability)
end

function Rand.pick<T>(seed: number, values: { T }): (number, T?)
	if #values == 0 then
		return normalizeUint32(seed), nil
	end

	local nextSeed, index = Rand.Integer(seed, 1, #values)
	return nextSeed, values[index]
end

function Rand.weighted<T>(seed: number, entries: { WeightedEntry<T> }): (number, T?)
	if #entries == 0 then
		return normalizeUint32(seed), nil
	end

	local totalWeight = 0
	for _, entry in entries do
		if entry.weight > 0 then
			totalWeight = totalWeight + entry.weight
		end
	end

	if totalWeight <= 0 then
		return normalizeUint32(seed), entries[1].value
	end

	local nextSeed, roll = Rand.Number(seed, 0, totalWeight)
	local running = 0
	for _, entry in entries do
		local weight = if entry.weight > 0 then entry.weight else 0
		running = running + weight
		if roll <= running then
			return nextSeed, entry.value
		end
	end

	return nextSeed, entries[#entries].value
end

function Rand.shuffle<T>(seed: number, values: { T }): (number, { T })
	local result = table.clone(values)

	local currentSeed = normalizeUint32(seed)
	for index = #result, 2, -1 do
		local swapIndex
		currentSeed, swapIndex = Rand.Integer(currentSeed, 1, index)
		result[index], result[swapIndex] = result[swapIndex], result[index]
	end

	return currentSeed, result
end

function Rand.Fork(seed: number, salt: SeedInput?): number
	local mixed = bit32.bxor(normalizeUint32(seed), Rand.Seed(salt))
	return xorshift32(normalizeUint32(mixed))
end

Rand.uint32 = Rand.Uint32
Rand.hashString = Rand.HashString
Rand.hashCoordinates = Rand.HashCoordinates
Rand.seed = Rand.Seed
Rand.step = Rand.Step
Rand.number = Rand.Number
Rand.integer = Rand.Integer
Rand.chance = Rand.Chance
Rand.fork = Rand.Fork

return Rand
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="1247">
                <Properties>
                  <string name="Name">RandomNumber</string>
                  <string name="Source"><![CDATA[--!strict

local Rand = require(script.Parent.Rand)

local RandomNumber = {}

function RandomNumber.Between(minValueRaw: any, maxValueRaw: any, randomOrSeedRaw: any?): (number, number?)
	local minValue = if typeof(minValueRaw) == "number" and minValueRaw == minValueRaw then minValueRaw else 1
	local maxValue = if typeof(maxValueRaw) == "number" and maxValueRaw == maxValueRaw then maxValueRaw else 100

	if typeof(randomOrSeedRaw) == "number" then
		local nextSeed, value = Rand.integer(randomOrSeedRaw, minValue, maxValue)
		return value, nextSeed
	end

	local randomObject = if typeof(randomOrSeedRaw) == "Random" then randomOrSeedRaw :: Random else Random.new()
	return randomObject:NextInteger(math.floor(minValue), math.floor(maxValue)), nil
end

function RandomNumber.Unit(randomOrSeedRaw: any?): (number, number?)
	if typeof(randomOrSeedRaw) == "number" then
		local nextSeed, value = Rand.number(randomOrSeedRaw)
		return value, nextSeed
	end

	local randomObject = if typeof(randomOrSeedRaw) == "Random" then randomOrSeedRaw :: Random else Random.new()
	return randomObject:NextNumber(), nil
end

RandomNumber.between = RandomNumber.Between
RandomNumber.unit = RandomNumber.Unit

return RandomNumber
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="1248">
                <Properties>
                  <string name="Name">Range</string>
                  <string name="Source"><![CDATA[--!strict
-- Interval helpers for wrapping, normalization, and overlap tests.

local Num = require(script.Parent.Num)

local Range = {}

export type Interval = {
	min: number,
	max: number,
}

local function sortBounds(minValue: number, maxValue: number): (number, number)
	if minValue <= maxValue then
		return minValue, maxValue
	end
	return maxValue, minValue
end

function Range.New(minValue: number, maxValue: number): Interval
	local low, high = sortBounds(minValue, maxValue)
	return {
		min = low,
		max = high,
	}
end

function Range.Span(minValue: number, maxValue: number): number
	local low, high = sortBounds(minValue, maxValue)
	return high - low
end

function Range.Center(minValue: number, maxValue: number): number
	local low, high = sortBounds(minValue, maxValue)
	return (low + high) * 0.5
end

function Range.Normalize(value: number, minValue: number, maxValue: number): number
	local low, high = sortBounds(minValue, maxValue)
	return Num.inverseLerp(low, high, value)
end

function Range.NormalizeClamped(value: number, minValue: number, maxValue: number): number
	return Num.saturate(Range.Normalize(value, minValue, maxValue))
end

function Range.Wrap(value: number, minValue: number, maxValue: number): number
	local low, high = sortBounds(minValue, maxValue)
	local span = high - low
	if span == 0 then
		return low
	end

	local wrapped = (value - low) % span
	if wrapped < 0 then
		wrapped = wrapped + span
	end
	return low + wrapped
end

function Range.Contains(value: number, minValue: number, maxValue: number, inclusive: boolean?): boolean
	local low, high = sortBounds(minValue, maxValue)
	if inclusive == false then
		return value > low and value < high
	end
	return value >= low and value <= high
end

function Range.Overlaps(
	aMin: number,
	aMax: number,
	bMin: number,
	bMax: number,
	inclusive: boolean?
): boolean
	local aLow, aHigh = sortBounds(aMin, aMax)
	local bLow, bHigh = sortBounds(bMin, bMax)
	if inclusive == false then
		return aLow < bHigh and bLow < aHigh
	end
	return aLow <= bHigh and bLow <= aHigh
end

function Range.Intersection(aMin: number, aMax: number, bMin: number, bMax: number): Interval?
	local aLow, aHigh = sortBounds(aMin, aMax)
	local bLow, bHigh = sortBounds(bMin, bMax)
	local low = math.max(aLow, bLow)
	local high = math.min(aHigh, bHigh)
	if low > high then
		return nil
	end
	return {
		min = low,
		max = high,
	}
end

Range.new = Range.New
Range.span = Range.Span
Range.center = Range.Center
Range.normalize = Range.Normalize
Range.normalizeClamped = Range.NormalizeClamped
Range.wrap = Range.Wrap
Range.contains = Range.Contains
Range.overlaps = Range.Overlaps
Range.intersection = Range.Intersection

return Range
]]></string>
                </Properties>
              </Item>
