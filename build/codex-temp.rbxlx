                <Item class="ModuleScript" referent="1107">
                  <Properties>
                    <string name="Name">room</string>
                    <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local BuildServiceClient = require(script:FindFirstAncestor("game").Client.Services.BuildServiceClient)
local BuildServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.BuildServiceUtils)
local Configs = require(script:FindFirstAncestor("game").Shared.Modules.Core.Configs)
local RoomScaleFactor = require(script:FindFirstAncestor("game").Shared.Modules.Math.RoomScaleFactor)
local WorldGenerationServiceClient =
	require(script:FindFirstAncestor("game").Client.Services.WorldGenerationServiceClient)

local Room = {}
Room.__index = Room

export type RoomConfig = RoomScaleFactor.RoomScaleFactorConfig
export type RoomScaleResult = RoomScaleFactor.RoomScaleResult
export type ViewConfig = {
	distance: number,
	height: number,
	lookHeight: number,
	fieldOfView: number,
}

export type Room = typeof(setmetatable(
	{} :: {
		config: RoomConfig,
		lastSampleAt: number,
		lastTileX: number?,
		lastTileY: number?,
		cachedScaleResult: RoomScaleResult,
	},
	Room
))

local DEFAULT_CONFIG = RoomScaleFactor.sanitizeConfig(((Configs.cameraData :: any).room or {}) :: RoomConfig)
local AIR_TILE_ID = BuildServiceUtils.AIR_TILE_ID

local function resolveWorldSpace(): (Vector3?, number?)
	local worldGenerationClient = WorldGenerationServiceClient :: any
	local worldGenerationState = worldGenerationClient.state
	local tileSize = if typeof(worldGenerationState) == "table"
			and typeof(worldGenerationState.tileSize) == "number"
		then worldGenerationState.tileSize
		else nil
	local worldOrigin = nil :: Vector3?
	if typeof(worldGenerationClient.worldOrigin) == "Vector3" then
		worldOrigin = worldGenerationClient.worldOrigin
	elseif
		typeof(worldGenerationState) == "table" and typeof((worldGenerationState :: any).worldOrigin) == "Vector3"
	then
		worldOrigin = (worldGenerationState :: any).worldOrigin
	end
	if worldOrigin ~= nil and tileSize ~= nil and tileSize > 0 then
		return worldOrigin, tileSize
	end

	local buildClient = BuildServiceClient :: any
	local buildState = buildClient.state
	if typeof(buildState) ~= "table" then
		return nil, nil
	end

	local buildWorldOrigin = if typeof((buildState :: any).worldOrigin) == "Vector3"
		then (buildState :: any).worldOrigin
		else nil
	local buildTileSize = if typeof((buildState :: any).tileSize) == "number" then (buildState :: any).tileSize else nil
	if buildWorldOrigin ~= nil and buildTileSize ~= nil and buildTileSize > 0 then
		return buildWorldOrigin, buildTileSize
	end

	return nil, nil
end

local function getTileAtFromWorldGeneration(tileX: number, tileY: number): number
	local worldGenerationClient = WorldGenerationServiceClient :: any
	local state = worldGenerationClient.state
	local chunkSnapshots = worldGenerationClient.chunkSnapshots
	if typeof(state) ~= "table" or typeof(chunkSnapshots) ~= "table" then
		return AIR_TILE_ID
	end

	local chunkSize = math.max(1, math.floor((state :: any).chunkSize or 32))
	local chunkX = BuildServiceUtils.toChunkCoordinate(tileX, chunkSize)
	local chunkY = BuildServiceUtils.toChunkCoordinate(tileY, chunkSize)
	local chunkKey = BuildServiceUtils.packChunkKey(chunkX, chunkY)
	local snapshot = chunkSnapshots[chunkKey]
	if typeof(snapshot) ~= "table" then
		return AIR_TILE_ID
	end

	local tileMinX = if typeof((snapshot :: any).tileMinX) == "number"
		then math.floor((snapshot :: any).tileMinX)
		else chunkX * chunkSize
	local tileMinY = if typeof((snapshot :: any).tileMinY) == "number"
		then math.floor((snapshot :: any).tileMinY)
		else chunkY * chunkSize
	local width = if typeof((snapshot :: any).width) == "number"
		then math.max(1, math.floor((snapshot :: any).width))
		else chunkSize
	local height = if typeof((snapshot :: any).height) == "number"
		then math.max(1, math.floor((snapshot :: any).height))
		else chunkSize
	local localX = tileX - tileMinX
	local localY = tileY - tileMinY
	if localX < 0 or localX >= width or localY < 0 or localY >= height then
		return AIR_TILE_ID
	end

	local tiles = (snapshot :: any).tiles
	if typeof(tiles) ~= "table" then
		return AIR_TILE_ID
	end

	local index = BuildServiceUtils.computeTileIndex(localX, localY, width)
	return BuildServiceUtils.sanitizeTileId(tiles[index]) or AIR_TILE_ID
end

local function getTileAt(tileX: number, tileY: number): number
	local buildClient = BuildServiceClient :: any
	if typeof(buildClient.state) == "table" then
		local ok, tileIdOrError = pcall(function()
			return buildClient:getTileAt(tileX, tileY, false)
		end)
		if ok then
			return BuildServiceUtils.sanitizeTileId(tileIdOrError) or AIR_TILE_ID
		end
	end

	return getTileAtFromWorldGeneration(tileX, tileY)
end

local function isSolidTile(tileX: number, tileY: number): boolean
	return BuildServiceUtils.isSolidTile(getTileAt(tileX, tileY))
end

local function resolveOriginTile(tileX: number, tileY: number): (number, number)
	for _, offsetY in { 0, 1, -1, 2, -2 } do
		local candidateTileY = tileY + offsetY
		if not isSolidTile(tileX, candidateTileY) then
			return tileX, candidateTileY
		end
	end
	return tileX, tileY
end

local function resolveBoundaryDistance(
	tileX: number,
	tileY: number,
	stepX: number,
	stepY: number,
	maxDistance: number
): number?
	for distance = 1, maxDistance do
		if isSolidTile(tileX + (stepX * distance), tileY + (stepY * distance)) then
			return distance
		end
	end
	return nil
end

function Room.New(config: RoomConfig?): Room
	return setmetatable({
		config = RoomScaleFactor.sanitizeConfig(config, DEFAULT_CONFIG),
		lastSampleAt = -math.huge,
		lastTileX = nil,
		lastTileY = nil,
		cachedScaleResult = RoomScaleFactor.createDefaultResult(),
	}, Room)
end

function Room.Reset(self: Room)
	self.lastSampleAt = -math.huge
	self.lastTileX = nil
	self.lastTileY = nil
	self.cachedScaleResult = RoomScaleFactor.createDefaultResult()
end

function Room.ApplyConfig(self: Room, config: RoomConfig?)
	self.config = RoomScaleFactor.sanitizeConfig(config, self.config)
	self:reset()
end

function Room.SampleScale(self: Room, worldPosition: Vector3): RoomScaleResult
	if self.config.enabled ~= true then
		self.cachedScaleResult = RoomScaleFactor.createDefaultResult()
		return self.cachedScaleResult
	end

	local worldOrigin, tileSize = resolveWorldSpace()
	if worldOrigin == nil or tileSize == nil then
		self.cachedScaleResult = RoomScaleFactor.createDefaultResult()
		return self.cachedScaleResult
	end

	local tileX, tileY = BuildServiceUtils.worldPositionToTile(worldPosition, worldOrigin, tileSize)
	tileX, tileY = resolveOriginTile(tileX, tileY)

	local now = os.clock()
	local sampleInterval = self.config.sampleIntervalSeconds :: number
	local shouldResample = self.lastTileX ~= tileX
		or self.lastTileY ~= tileY
		or (now - self.lastSampleAt) >= sampleInterval
	if not shouldResample then
		return self.cachedScaleResult
	end

	self.lastSampleAt = now
	self.lastTileX = tileX
	self.lastTileY = tileY

	local horizontalScanRadius = math.max(1, math.floor(self.config.horizontalScanRadiusTiles :: number))
	local verticalScanRadius = math.max(1, math.floor(self.config.verticalScanRadiusTiles :: number))
	local leftDistance = resolveBoundaryDistance(tileX, tileY, -1, 0, horizontalScanRadius)
	local rightDistance = resolveBoundaryDistance(tileX, tileY, 1, 0, horizontalScanRadius)
	local upDistance = resolveBoundaryDistance(tileX, tileY, 0, 1, verticalScanRadius)
	local downDistance = resolveBoundaryDistance(tileX, tileY, 0, -1, verticalScanRadius)
	local isEnclosed = leftDistance ~= nil and rightDistance ~= nil and upDistance ~= nil and downDistance ~= nil
	local widthTiles = if isEnclosed then math.max(1, (leftDistance :: number) + (rightDistance :: number) - 1) else 0
	local heightTiles = if isEnclosed then math.max(1, (upDistance :: number) + (downDistance :: number) - 1) else 0

	self.cachedScaleResult = RoomScaleFactor.resolve(self.config, {
		isEnclosed = isEnclosed,
		widthTiles = widthTiles,
		heightTiles = heightTiles,
		leftDistance = leftDistance,
		rightDistance = rightDistance,
		upDistance = upDistance,
		downDistance = downDistance,
	})
	return self.cachedScaleResult
end

function Room.ResolveViewConfig(self: Room, baseViewConfig: ViewConfig, targetPosition: Vector3?): ViewConfig
	if targetPosition == nil then
		return baseViewConfig
	end

	local scaleResult = self:sampleScale(targetPosition)
	if not scaleResult.active then
		return baseViewConfig
	end

	return {
		distance = baseViewConfig.distance * scaleResult.distanceScale,
		height = baseViewConfig.height * scaleResult.heightScale,
		lookHeight = baseViewConfig.lookHeight * scaleResult.lookHeightScale,
		fieldOfView = baseViewConfig.fieldOfView * scaleResult.fieldOfViewScale,
	}
end

Room.new = Room.New
Room.reset = Room.Reset
Room.applyConfig = Room.ApplyConfig
Room.sampleScale = Room.SampleScale
Room.resolveViewConfig = Room.ResolveViewConfig

return Room
]]></string>
                  </Properties>
                </Item>
              </Item>
              <Item class="ModuleScript" referent="1108">
                <Properties>
                  <string name="Name">Cache</string>
                  <string name="Source"><![CDATA[--!strict

local Cache = {}
Cache.__index = Cache

export type SubjectSnapshot = {
	key: string,
	kind: string,
	position: Vector3,
	velocity: Vector3,
	updatedAt: number,
}

export type FrameSnapshot = {
	frame: number,
	updatedAt: number,
	deltaTime: number,
	mode: string,
	reason: string,
	subjectKey: string?,
	subjectKind: string?,
	targetPosition: Vector3?,
	predictedPosition: Vector3?,
	cameraCFrame: CFrame?,
	fieldOfView: number?,
	hasOverride: boolean,
}

export type Cache = typeof(setmetatable(
	{} :: {
		frame: number,
		lastUpdatedAt: number,
		lastDeltaTime: number,
		subjects: { [string]: SubjectSnapshot },
		lastFrame: FrameSnapshot,
	},
	Cache
))

local function sanitizeNumber(valueRaw: any, fallback: number, minimum: number?, maximum: number?): number
	local value = if typeof(valueRaw) == "number" and valueRaw == valueRaw then valueRaw else fallback
	if minimum ~= nil and value < minimum then
		value = minimum
	end
	if maximum ~= nil and value > maximum then
		value = maximum
	end
	return value
end

local function cloneFrameSnapshot(snapshot: FrameSnapshot): FrameSnapshot
	return {
		frame = snapshot.frame,
		updatedAt = snapshot.updatedAt,
		deltaTime = snapshot.deltaTime,
		mode = snapshot.mode,
		reason = snapshot.reason,
		subjectKey = snapshot.subjectKey,
		subjectKind = snapshot.subjectKind,
		targetPosition = snapshot.targetPosition,
		predictedPosition = snapshot.predictedPosition,
		cameraCFrame = snapshot.cameraCFrame,
		fieldOfView = snapshot.fieldOfView,
		hasOverride = snapshot.hasOverride,
	}
end

local function createDefaultFrameSnapshot(): FrameSnapshot
	return {
		frame = 0,
		updatedAt = 0,
		deltaTime = 1 / 60,
		mode = "Disabled",
		reason = "uninitialized",
		subjectKey = nil,
		subjectKind = nil,
		targetPosition = nil,
		predictedPosition = nil,
		cameraCFrame = nil,
		fieldOfView = nil,
		hasOverride = false,
	}
end

function Cache.New(): Cache
	return setmetatable({
		frame = 0,
		lastUpdatedAt = 0,
		lastDeltaTime = 1 / 60,
		subjects = {} :: { [string]: SubjectSnapshot },
		lastFrame = createDefaultFrameSnapshot(),
	}, Cache)
end

function Cache.Reset(self: Cache)
	self.frame = 0
	self.lastUpdatedAt = 0
	self.lastDeltaTime = 1 / 60
	table.clear(self.subjects)
	self.lastFrame = createDefaultFrameSnapshot()
end

function Cache.GetSubject(self: Cache, keyRaw: any): SubjectSnapshot?
	if typeof(keyRaw) ~= "string" or keyRaw == "" then
		return nil
	end
	return self.subjects[keyRaw]
end

function Cache.ResolveDerivedVelocity(
	self: Cache,
	keyRaw: any,
	positionRaw: any,
	nowRaw: any,
	fallbackVelocityRaw: any?
): Vector3
	local fallbackVelocity = if typeof(fallbackVelocityRaw) == "Vector3" then fallbackVelocityRaw else Vector3.zero
	if typeof(keyRaw) ~= "string" or keyRaw == "" or typeof(positionRaw) ~= "Vector3" then
		return fallbackVelocity
	end

	local previous = self.subjects[keyRaw]
	if previous == nil then
		return fallbackVelocity
	end

	local now = sanitizeNumber(nowRaw, os.clock(), 0, nil)
	local dt = now - previous.updatedAt
	if dt <= 1e-4 then
		return fallbackVelocity
	end

	local derivedVelocity = (positionRaw - previous.position) / dt
	if derivedVelocity.Magnitude <= 1e-4 then
		return fallbackVelocity
	end
	return derivedVelocity
end

function Cache.RememberSubject(
	self: Cache,
	keyRaw: any,
	kindRaw: any,
	positionRaw: any,
	velocityRaw: any,
	nowRaw: any
): SubjectSnapshot?
	if typeof(keyRaw) ~= "string" or keyRaw == "" or typeof(positionRaw) ~= "Vector3" then
		return nil
	end

	local snapshot: SubjectSnapshot = {
		key = keyRaw,
		kind = if typeof(kindRaw) == "string" and kindRaw ~= "" then kindRaw else "Unknown",
		position = positionRaw,
		velocity = if typeof(velocityRaw) == "Vector3" then velocityRaw else Vector3.zero,
		updatedAt = sanitizeNumber(nowRaw, os.clock(), 0, nil),
	}
	self.subjects[keyRaw] = snapshot
	return snapshot
end

function Cache.StoreFrame(self: Cache, snapshotRaw: any): FrameSnapshot
	local snapshot = if typeof(snapshotRaw) == "table" then snapshotRaw else {}
	self.frame += 1
	self.lastUpdatedAt = sanitizeNumber((snapshot :: any).updatedAt, os.clock(), 0, nil)
	self.lastDeltaTime = sanitizeNumber((snapshot :: any).deltaTime, self.lastDeltaTime, 0, 1)

	self.lastFrame = {
		frame = self.frame,
		updatedAt = self.lastUpdatedAt,
		deltaTime = self.lastDeltaTime,
		mode = if typeof((snapshot :: any).mode) == "string" then (snapshot :: any).mode else "Unknown",
		reason = if typeof((snapshot :: any).reason) == "string" then (snapshot :: any).reason else "",
		subjectKey = if typeof((snapshot :: any).subjectKey) == "string" then (snapshot :: any).subjectKey else nil,
		subjectKind = if typeof((snapshot :: any).subjectKind) == "string" then (snapshot :: any).subjectKind else nil,
		targetPosition = if typeof((snapshot :: any).targetPosition) == "Vector3"
			then (snapshot :: any).targetPosition
			else nil,
		predictedPosition = if typeof((snapshot :: any).predictedPosition) == "Vector3"
			then (snapshot :: any).predictedPosition
			else nil,
		cameraCFrame = if typeof((snapshot :: any).cameraCFrame) == "CFrame"
			then (snapshot :: any).cameraCFrame
			else nil,
		fieldOfView = if typeof((snapshot :: any).fieldOfView) == "number" then (snapshot :: any).fieldOfView else nil,
		hasOverride = (snapshot :: any).hasOverride == true,
	}

	return self:getFrame()
end

function Cache.GetFrame(self: Cache): FrameSnapshot
	return cloneFrameSnapshot(self.lastFrame)
end

function Cache.GetDebugState(self: Cache): { [string]: any }
	local frame = self.lastFrame
	return {
		frame = self.frame,
		updatedAt = self.lastUpdatedAt,
		deltaTime = self.lastDeltaTime,
		mode = frame.mode,
		reason = frame.reason,
		subjectKey = frame.subjectKey,
		subjectKind = frame.subjectKind,
		targetPosition = frame.targetPosition,
		predictedPosition = frame.predictedPosition,
		hasOverride = frame.hasOverride,
		fieldOfView = frame.fieldOfView,
	}
end

Cache.new = Cache.New
Cache.reset = Cache.Reset
Cache.getSubject = Cache.GetSubject
Cache.resolveDerivedVelocity = Cache.ResolveDerivedVelocity
Cache.rememberSubject = Cache.RememberSubject
Cache.storeFrame = Cache.StoreFrame
Cache.getFrame = Cache.GetFrame
Cache.getDebugState = Cache.GetDebugState

return Cache
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="1109">
                <Properties>
                  <string name="Name">Predict</string>
                  <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Vec = require(script:FindFirstAncestor("game").Shared.Modules.Math.Vec)

local Predict = {}
Predict.__index = Predict

export type PredictionConfig = {
	enabled: boolean?,
	leadTime: number?,
	maxLeadTime: number?,
	minimumSpeed: number?,
	maximumDistance: number?,
	derivedVelocityWeight: number?,
}

export type PredictionResult = {
	active: boolean,
	position: Vector3?,
	basePosition: Vector3?,
	velocity: Vector3,
	speed: number,
	leadTime: number,
	offset: Vector3,
}

export type Predict = typeof(setmetatable(
	{} :: {
		enabled: boolean,
		leadTime: number,
		maxLeadTime: number,
		minimumSpeed: number,
		maximumDistance: number,
		derivedVelocityWeight: number,
	},
	Predict
))

local DEFAULT_CONFIG: PredictionConfig = {
	enabled = false,
	leadTime = 0.08,
	maxLeadTime = 0.18,
	minimumSpeed = 2,
	maximumDistance = 18,
	derivedVelocityWeight = 0.35,
}

local function sanitizeNumber(valueRaw: any, fallback: number, minimum: number, maximum: number): number
	if typeof(valueRaw) ~= "number" or valueRaw ~= valueRaw then
		return fallback
	end
	return math.clamp(valueRaw, minimum, maximum)
end

local function sanitizeConfig(configRaw: any, fallbackRaw: PredictionConfig?): PredictionConfig
	local source = if typeof(configRaw) == "table" then configRaw else {}
	local fallback = if typeof(fallbackRaw) == "table" then fallbackRaw else DEFAULT_CONFIG

	local leadTime = sanitizeNumber((source :: any).leadTime, fallback.leadTime or 0.08, 0, 1)
	local maxLeadTime = sanitizeNumber((source :: any).maxLeadTime, fallback.maxLeadTime or leadTime, leadTime, 1)

	return {
		enabled = if typeof((source :: any).enabled) == "boolean"
			then (source :: any).enabled
			else fallback.enabled ~= false,
		leadTime = leadTime,
		maxLeadTime = maxLeadTime,
		minimumSpeed = sanitizeNumber((source :: any).minimumSpeed, fallback.minimumSpeed or 2, 0, 1024),
		maximumDistance = sanitizeNumber((source :: any).maximumDistance, fallback.maximumDistance or 18, 0, 4096),
		derivedVelocityWeight = sanitizeNumber(
			(source :: any).derivedVelocityWeight,
			fallback.derivedVelocityWeight or 0.35,
			0,
			1
		),
	}
end

local function buildResult(
	active: boolean,
	position: Vector3?,
	basePosition: Vector3?,
	velocity: Vector3,
	leadTime: number,
	offset: Vector3
): PredictionResult
	return {
		active = active,
		position = position,
		basePosition = basePosition,
		velocity = velocity,
		speed = velocity.Magnitude,
		leadTime = leadTime,
		offset = offset,
	}
end

function Predict.New(configRaw: PredictionConfig?): Predict
	local config = sanitizeConfig(configRaw, DEFAULT_CONFIG)
	return setmetatable({
		enabled = config.enabled ~= false,
		leadTime = config.leadTime or 0.08,
		maxLeadTime = config.maxLeadTime or 0.18,
		minimumSpeed = config.minimumSpeed or 2,
		maximumDistance = config.maximumDistance or 18,
		derivedVelocityWeight = config.derivedVelocityWeight or 0.35,
	}, Predict)
end

function Predict.ApplyConfig(self: Predict, configRaw: PredictionConfig?)
	local config = sanitizeConfig(configRaw, {
		enabled = self.enabled,
		leadTime = self.leadTime,
		maxLeadTime = self.maxLeadTime,
		minimumSpeed = self.minimumSpeed,
		maximumDistance = self.maximumDistance,
		derivedVelocityWeight = self.derivedVelocityWeight,
	})

	self.enabled = config.enabled ~= false
	self.leadTime = config.leadTime or self.leadTime
	self.maxLeadTime = config.maxLeadTime or self.maxLeadTime
	self.minimumSpeed = config.minimumSpeed or self.minimumSpeed
	self.maximumDistance = config.maximumDistance or self.maximumDistance
	self.derivedVelocityWeight = config.derivedVelocityWeight or self.derivedVelocityWeight
end

function Predict.Resolve(self: Predict, targetRaw: any, cacheRaw: any?, optionsRaw: any?): PredictionResult
	local target = if typeof(targetRaw) == "table" then targetRaw else nil
	local options = if typeof(optionsRaw) == "table" then optionsRaw else {}
	local configOverride = sanitizeConfig((options :: any).config, {
		enabled = self.enabled,
		leadTime = self.leadTime,
		maxLeadTime = self.maxLeadTime,
		minimumSpeed = self.minimumSpeed,
		maximumDistance = self.maximumDistance,
		derivedVelocityWeight = self.derivedVelocityWeight,
	})

	if target == nil or typeof((target :: any).position) ~= "Vector3" then
		return buildResult(false, nil, nil, Vector3.zero, 0, Vector3.zero)
	end

	local basePosition = (target :: any).position :: Vector3
	local fallbackVelocity = if typeof((target :: any).velocity) == "Vector3"
		then (target :: any).velocity
		else Vector3.zero
	local derivedVelocity = fallbackVelocity
	local cache = if typeof(cacheRaw) == "table" then cacheRaw else nil
	local subjectKey = if typeof((target :: any).cacheKey) == "string" then (target :: any).cacheKey else nil

	if cache ~= nil and subjectKey ~= nil and typeof((cache :: any).resolveDerivedVelocity) == "function" then
		derivedVelocity = (cache :: any):resolveDerivedVelocity(
			subjectKey,
			basePosition,
			(options :: any).now,
			fallbackVelocity
		)
	end

	local blendAlpha = configOverride.derivedVelocityWeight or 0.35
	local velocity = fallbackVelocity + ((derivedVelocity - fallbackVelocity) * blendAlpha)
	if fallbackVelocity.Magnitude <= 1e-4 then
		velocity = derivedVelocity
	end

	local speed = velocity.Magnitude
	local leadTime = sanitizeNumber(
		(options :: any).leadTime,
		configOverride.leadTime or 0.08,
		0,
		configOverride.maxLeadTime or 0.18
	)
	if configOverride.enabled == false or speed < (configOverride.minimumSpeed or 2) or leadTime <= 0 then
		return buildResult(false, basePosition, basePosition, velocity, 0, Vector3.zero)
	end

	local offset = Vec.clampMagnitude(velocity * leadTime, configOverride.maximumDistance or 18)
	if offset.Magnitude <= 1e-4 then
		return buildResult(false, basePosition, basePosition, velocity, leadTime, Vector3.zero)
	end

	return buildResult(true, basePosition + offset, basePosition, velocity, leadTime, offset)
end

Predict.new = Predict.New
Predict.applyConfig = Predict.ApplyConfig
Predict.resolve = Predict.Resolve

return Predict
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="1110">
                <Properties>
                  <string name="Name">Resolve</string>
                  <string name="Source"><![CDATA[--!strict

local Resolve = {}
Resolve.__index = Resolve

export type ViewConfig = {
	distance: number,
	height: number,
	lookHeight: number,
	fieldOfView: number,
}

export type Settings = {
	sideSign: number,
	movementBackAmount: number,
	movementSpeedForMaxBack: number,
	movementBackSign: number,
	mouseInfluenceX: number,
	mouseInfluenceY: number,
}

export type ResolutionResult = {
	state: { [string]: any },
	override: { [string]: any }?,
	subject: { [string]: any }?,
	predicted: { [string]: any },
	targetPosition: Vector3?,
	baseTargetPosition: Vector3?,
	lookPosition: Vector3?,
	viewConfig: ViewConfig,
	settings: Settings,
	cameraCFrame: CFrame?,
	fieldOfView: number,
}

export type Resolve = typeof(setmetatable(
	{} :: {
		cache: any,
		predictor: any,
		stack: any,
		state: any,
		target: any,
	},
	Resolve
))

local function sanitizeNumber(valueRaw: any, fallback: number, minimum: number?, maximum: number?): number
	local value = if typeof(valueRaw) == "number" and valueRaw == valueRaw then valueRaw else fallback
	if minimum ~= nil and value < minimum then
		value = minimum
	end
	if maximum ~= nil and value > maximum then
		value = maximum
	end
	return value
end

local function sanitizeSign(valueRaw: any, fallback: number): number
	local sign = math.sign(sanitizeNumber(valueRaw, fallback, -1, 1))
	if sign == 0 then
		return if fallback < 0 then -1 else 1
	end
	return sign
end

local function cloneViewConfig(viewConfig: ViewConfig): ViewConfig
	return {
		distance = viewConfig.distance,
		height = viewConfig.height,
		lookHeight = viewConfig.lookHeight,
		fieldOfView = viewConfig.fieldOfView,
	}
end

local function cloneSettings(settings: Settings): Settings
	return {
		sideSign = settings.sideSign,
		movementBackAmount = settings.movementBackAmount,
		movementSpeedForMaxBack = settings.movementSpeedForMaxBack,
		movementBackSign = settings.movementBackSign,
		mouseInfluenceX = settings.mouseInfluenceX,
		mouseInfluenceY = settings.mouseInfluenceY,
	}
end

local function resolveViewConfig(baseViewConfig: ViewConfig, overrideRaw: any): ViewConfig
	local override = if typeof(overrideRaw) == "table" then overrideRaw else {}
	local overrideViewConfig = if typeof((override :: any).viewConfig) == "table"
		then (override :: any).viewConfig
		else nil
	local nextViewConfig = cloneViewConfig(baseViewConfig)

	local source = if overrideViewConfig ~= nil then overrideViewConfig else override
	if typeof((source :: any).distance) == "number" then
		nextViewConfig.distance = math.max((source :: any).distance, 0)
	end
	if typeof((source :: any).height) == "number" then
		nextViewConfig.height = (source :: any).height
	end
	if typeof((source :: any).lookHeight) == "number" then
		nextViewConfig.lookHeight = (source :: any).lookHeight
	end
	if typeof((override :: any).fieldOfView) == "number" then
		nextViewConfig.fieldOfView = sanitizeNumber((override :: any).fieldOfView, nextViewConfig.fieldOfView, 1, 120)
	elseif typeof((source :: any).fieldOfView) == "number" then
		nextViewConfig.fieldOfView = sanitizeNumber((source :: any).fieldOfView, nextViewConfig.fieldOfView, 1, 120)
	end

	return nextViewConfig
end

local function resolveSettings(baseSettings: Settings, overrideRaw: any): Settings
	local override = if typeof(overrideRaw) == "table" then overrideRaw else {}
	local settings = cloneSettings(baseSettings)

	settings.sideSign = sanitizeSign((override :: any).sideSign, settings.sideSign)

	if typeof((override :: any).movementBackAmount) == "number" then
		settings.movementBackAmount = math.max((override :: any).movementBackAmount, 0)
	end
	if typeof((override :: any).movementSpeedForMaxBack) == "number" then
		settings.movementSpeedForMaxBack = math.max((override :: any).movementSpeedForMaxBack, 0.01)
	end
	if typeof((override :: any).movementBackSign) == "number" then
		settings.movementBackSign = sanitizeSign((override :: any).movementBackSign, settings.movementBackSign)
	end
	if typeof((override :: any).mouseInfluenceX) == "number" then
		settings.mouseInfluenceX = math.max((override :: any).mouseInfluenceX, 0)
	end
	if typeof((override :: any).mouseInfluenceY) == "number" then
		settings.mouseInfluenceY = math.max((override :: any).mouseInfluenceY, 0)
	end

	if (override :: any).disableMovementBack == true then
		settings.movementBackAmount = 0
	end
	if (override :: any).disableMouseInfluence == true then
		settings.mouseInfluenceX = 0
		settings.mouseInfluenceY = 0
	end

	return settings
end

function Resolve.New(dependenciesRaw: any?): Resolve
	local dependencies = if typeof(dependenciesRaw) == "table" then dependenciesRaw else {}
	return setmetatable({
		cache = (dependencies :: any).cache,
		predictor = (dependencies :: any).predictor,
		stack = (dependencies :: any).stack,
		state = (dependencies :: any).state,
		target = (dependencies :: any).target,
	}, Resolve)
end

function Resolve.Resolve(self: Resolve, contextRaw: any): ResolutionResult
	local context = if typeof(contextRaw) == "table" then contextRaw else {}
	local now = sanitizeNumber((context :: any).now, os.clock(), 0, nil)
	local deltaTime = sanitizeNumber((context :: any).deltaTime, 1 / 60, 0, 1)

	local baseViewConfig = resolveViewConfig({
		distance = sanitizeNumber((context :: any).distance, 38, 0, 4096),
		height = sanitizeNumber((context :: any).height, 8, -4096, 4096),
		lookHeight = sanitizeNumber((context :: any).lookHeight, 3, -4096, 4096),
		fieldOfView = sanitizeNumber((context :: any).fieldOfView, 60, 1, 120),
	}, nil)
	local baseSettings = resolveSettings({
		sideSign = sanitizeSign((context :: any).sideSign, 1),
		movementBackAmount = math.max(sanitizeNumber((context :: any).movementBackAmount, 0, 0, 4096), 0),
		movementSpeedForMaxBack = math.max(
			sanitizeNumber((context :: any).movementSpeedForMaxBack, 1, 0.01, 4096),
			0.01
		),
		movementBackSign = sanitizeSign((context :: any).movementBackSign, 1),
		mouseInfluenceX = math.max(sanitizeNumber((context :: any).mouseInfluenceX, 0, 0, 256), 0),
		mouseInfluenceY = math.max(sanitizeNumber((context :: any).mouseInfluenceY, 0, 0, 256), 0),
	}, nil)

	local override = nil
	if typeof(self.stack) == "table" and typeof((self.stack :: any).resolve) == "function" then
		override = (self.stack :: any):resolve(now)
	end

	local subject = nil
	if typeof(self.target) == "table" and typeof((self.target :: any).resolve) == "function" then
		subject = (self.target :: any):resolve({
			override = override,
			character = (context :: any).character,
			localPlayer = (context :: any).localPlayer,
			now = now,
		})
	end

	local predicted = {
		active = false,
		position = if subject ~= nil then (subject :: any).position else nil,
		basePosition = if subject ~= nil then (subject :: any).position else nil,
		velocity = if subject ~= nil and typeof((subject :: any).velocity) == "Vector3"
			then (subject :: any).velocity
			else Vector3.zero,
		speed = 0,
		leadTime = 0,
		offset = Vector3.zero,
	}
	if
		subject ~= nil
		and typeof(self.predictor) == "table"
		and typeof((self.predictor :: any).resolve) == "function"
	then
		predicted = (self.predictor :: any):resolve(subject, self.cache, {
			now = now,
			deltaTime = deltaTime,
			config = if override ~= nil then (override :: any).predict else (context :: any).predictConfig,
			leadTime = (context :: any).predictionLeadTime,
		})
	end

	local targetPosition = if predicted.active == true and typeof(predicted.position) == "Vector3"
		then predicted.position
		else if subject ~= nil and typeof((subject :: any).position) == "Vector3"
			then (subject :: any).position
			else nil
	local baseTargetPosition = if subject ~= nil and typeof((subject :: any).position) == "Vector3"
		then (subject :: any).position
		else nil

	local resolvedViewConfig = cloneViewConfig(baseViewConfig)
	if targetPosition ~= nil and override ~= nil and (override :: any).disableRoom ~= true then
		local roomBehavior = (context :: any).roomBehavior
		if typeof(roomBehavior) == "table" and typeof((roomBehavior :: any).resolveViewConfig) == "function" then
			resolvedViewConfig = (roomBehavior :: any):resolveViewConfig(resolvedViewConfig, targetPosition)
		end
	elseif targetPosition ~= nil and override == nil then
		local roomBehavior = (context :: any).roomBehavior
		if typeof(roomBehavior) == "table" and typeof((roomBehavior :: any).resolveViewConfig) == "function" then
			resolvedViewConfig = (roomBehavior :: any):resolveViewConfig(resolvedViewConfig, targetPosition)
		end
	end
	resolvedViewConfig = resolveViewConfig(resolvedViewConfig, override)

	local resolvedSettings = resolveSettings(baseSettings, override)
	local lookPosition = if override ~= nil and typeof((override :: any).lookPosition) == "Vector3"
		then (override :: any).lookPosition
		else if subject ~= nil and typeof((subject :: any).lookPosition) == "Vector3"
			then (subject :: any).lookPosition
			else if targetPosition ~= nil
				then targetPosition + Vector3.new(0, resolvedViewConfig.lookHeight, 0)
				else nil

	local fieldOfView = resolvedViewConfig.fieldOfView
	local cameraCFrame = nil :: CFrame?
	local overrideCameraCFrame = if override ~= nil and typeof((override :: any).cameraCFrame) == "CFrame"
		then (override :: any).cameraCFrame
		else nil
	local overrideCameraPosition = if override ~= nil and typeof((override :: any).cameraPosition) == "Vector3"
		then (override :: any).cameraPosition
		else nil

	if overrideCameraCFrame ~= nil then
		cameraCFrame = overrideCameraCFrame
	elseif overrideCameraPosition ~= nil then
		local fallbackLookPosition = if lookPosition ~= nil
			then lookPosition
			else overrideCameraPosition + Vector3.new(-resolvedSettings.sideSign, 0, 0)
		cameraCFrame = CFrame.lookAt(overrideCameraPosition, fallbackLookPosition)
	elseif targetPosition ~= nil and lookPosition ~= nil then
		local velocity = if predicted ~= nil and typeof(predicted.velocity) == "Vector3"
			then predicted.velocity
			else if subject ~= nil and typeof((subject :: any).velocity) == "Vector3"
				then (subject :: any).velocity
				else Vector3.zero
		local sidewaysSpeed = math.abs(velocity.Z)
		local speedAlpha = if resolvedSettings.movementSpeedForMaxBack > 0
			then math.clamp(sidewaysSpeed / resolvedSettings.movementSpeedForMaxBack, 0, 1)
			else 0
		local movementBackOffset = resolvedSettings.movementBackAmount * speedAlpha * resolvedSettings.movementBackSign

		local baseCameraPosition = targetPosition
			+ Vector3.new(resolvedViewConfig.distance * resolvedSettings.sideSign, resolvedViewConfig.height, 0)
		local cameraToLook = baseCameraPosition - lookPosition
		local backDirection = if cameraToLook.Magnitude > 0
			then cameraToLook.Unit
			else Vector3.new(resolvedSettings.sideSign, 0, 0)
		local cameraPositionWithMovementBack = baseCameraPosition + (backDirection * movementBackOffset)
		local baseCFrame = CFrame.lookAt(baseCameraPosition, lookPosition)

		local mouseNormalized = if typeof((context :: any).mouseNormalized) == "Vector2"
			then (context :: any).mouseNormalized
			else Vector2.zero
		local mouseOffset = (baseCFrame.RightVector * (mouseNormalized.X * resolvedSettings.mouseInfluenceX))
			+ (baseCFrame.UpVector * (-mouseNormalized.Y * resolvedSettings.mouseInfluenceY))
		local cameraPosition = cameraPositionWithMovementBack + mouseOffset
		local finalLookPosition = lookPosition + mouseOffset
		cameraCFrame = CFrame.lookAt(cameraPosition, finalLookPosition)
		lookPosition = finalLookPosition
	end

	local stateSnapshot = {}
	if typeof(self.state) == "table" and typeof((self.state :: any).resolve) == "function" then
		stateSnapshot = (self.state :: any):resolve({
			target = subject,
			override = override,
			now = now,
		})
	end

	if
		subject ~= nil
		and typeof(self.cache) == "table"
		and typeof((self.cache :: any).rememberSubject) == "function"
	then
		(self.cache :: any):rememberSubject(
			(subject :: any).cacheKey,
			(subject :: any).kind,
			(subject :: any).position,
			(subject :: any).velocity,
			now
		)
	end

	if typeof(self.cache) == "table" and typeof((self.cache :: any).storeFrame) == "function" then
		(self.cache :: any):storeFrame({
			updatedAt = now,
			deltaTime = deltaTime,
			mode = (stateSnapshot :: any).mode,
			reason = (stateSnapshot :: any).reason,
			subjectKey = if subject ~= nil then (subject :: any).cacheKey else nil,
			subjectKind = if subject ~= nil then (subject :: any).kind else nil,
			targetPosition = baseTargetPosition,
			predictedPosition = if predicted.active == true then targetPosition else nil,
			cameraCFrame = cameraCFrame,
			fieldOfView = fieldOfView,
			hasOverride = override ~= nil,
		})
	end

	return {
		state = stateSnapshot,
		override = override,
		subject = subject,
		predicted = predicted,
		targetPosition = targetPosition,
		baseTargetPosition = baseTargetPosition,
		lookPosition = lookPosition,
		viewConfig = resolvedViewConfig,
		settings = resolvedSettings,
		cameraCFrame = cameraCFrame,
		fieldOfView = fieldOfView,
	}
end

Resolve.new = Resolve.New
Resolve.resolve = Resolve.Resolve

return Resolve
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="1111">
                <Properties>
                  <string name="Name">SideView</string>
                  <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Cache = require(script.Parent.Cache)
local CameraServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.CameraServiceUtils)
local CatchUpPlayer = require(script.Parent.Behavior.catchUpPlayer)
local Configs = require(script:FindFirstAncestor("game").Shared.Modules.Core.Configs)
local Janitor = require(ReplicatedStorage.Packages.Janitor)
local Predict = require(script.Parent.Predict)
local Resolve = require(script.Parent.Resolve)
local Ripple = require(ReplicatedStorage.Packages.Ripple)
local RoomBehavior = require(script.Parent.Behavior.room)
local Stack = require(script.Parent.Stack)
local State = require(script.Parent.State)
local Target = require(script.Parent.Target)

local SideView = {}
SideView.__index = SideView

type Motion<T> = Ripple.Motion<T>
type SpringOptions = Ripple.SpringOptions
type JanitorClass = {
	GiveChore: (self: JanitorClass, chore: any, ...any) -> (),
	Clean: (self: JanitorClass) -> (),
	Destroy: (self: JanitorClass) -> (),
}

export type SideViewConfig = {
	distance: number?,
	height: number?,
	lookHeight: number?,
	sideSign: number?,
	fieldOfView: number?,
	movementBackAmount: number?,
	movementSpeedForMaxBack: number?,
	movementBackSign: number?,
	mouseInfluenceX: number?,
	mouseInfluenceY: number?,
	cameraSpring: SpringOptions?,
	fovSpring: SpringOptions?,
	room: RoomBehavior.RoomConfig?,
	catchUpPlayer: CatchUpPlayer.CatchUpPlayerConfig?,
	predict: Predict.PredictionConfig?,
}

export type SideViewInitOptions = {
	snapToTarget: boolean?,
}

export type SideView = typeof(setmetatable(
	{} :: {
		enabled: boolean,
		target: any?,
		character: Model?,
		renderStepName: string,
		distance: number,
		height: number,
		lookHeight: number,
		sideSign: number,
		fieldOfView: number,
		movementBackAmount: number,
		movementSpeedForMaxBack: number,
		movementBackSign: number,
		mouseInfluenceX: number,
		mouseInfluenceY: number,
		cameraSpring: SpringOptions,
		fovSpring: SpringOptions,
		catchUpPlayerBehavior: CatchUpPlayer.CatchUpPlayer,
		roomBehavior: RoomBehavior.Room,
		backendCache: Cache.Cache,
		backendPredict: Predict.Predict,
		backendResolver: Resolve.Resolve,
		backendStack: Stack.Stack,
		backendState: State.State,
		backendTarget: Target.Target,
		cameraMotion: Motion<CFrame>,
		fovMotion: Motion<number>,
		janitor: JanitorClass,
		lastCameraType: Enum.CameraType?,
		lastFieldOfView: number?,
		lastResolution: Resolve.ResolutionResult?,
	},
	SideView
))

local DEFAULT_CAMERA_SPRING: SpringOptions = {
	frequency = 6,
	damping = 1,
}

local DEFAULT_FOV_SPRING: SpringOptions = {
	frequency = 4,
	damping = 1,
}

local DEFAULT_SIDE_VIEW_CONFIG = Configs.cameraData :: SideViewConfig
local SIDE_VIEW_RENDER_PRIORITY = Enum.RenderPriority.Camera.Value
local sideViewInstanceCount = 0

local function getMouseViewportNormalized(camera: Camera): Vector2
	local viewportSize = camera.ViewportSize
	if viewportSize.X <= 0 or viewportSize.Y <= 0 then
		return Vector2.zero
	end

	local center = viewportSize * 0.5
	local mouseLocation = UserInputService:GetMouseLocation()

	return Vector2.new(
		math.clamp((mouseLocation.X - center.X) / center.X, -1, 1),
		math.clamp((mouseLocation.Y - center.Y) / center.Y, -1, 1)
	)
end

local function getBaseViewConfig(self: SideView): Resolve.ViewConfig
	return {
		distance = self.distance,
		height = self.height,
		lookHeight = self.lookHeight,
		fieldOfView = self.fieldOfView,
	}
end

function SideView.New(config: SideViewConfig?): SideView
	local camera = Workspace.CurrentCamera
	local startCFrame = if camera then camera.CFrame else CFrame.new()
	local startFov = if camera then camera.FieldOfView else 40
	sideViewInstanceCount += 1

	local backendCache = Cache.new()
	local backendPredict = Predict.new(if config then (config :: any).predict else nil)
	local backendStack = Stack.new()
	local backendState = State.new()
	local backendTarget = Target.new({
		resolveCharacterTarget = CameraServiceUtils.resolveCharacterTarget,
	})
	local backendResolver = Resolve.new({
		cache = backendCache,
		predictor = backendPredict,
		stack = backendStack,
		state = backendState,
		target = backendTarget,
	})

	local self = setmetatable({
		enabled = false,
		target = nil,
		character = nil,
		renderStepName = ("SideViewCameraUpdate_%d"):format(sideViewInstanceCount),
		distance = if config and config.distance then config.distance else DEFAULT_SIDE_VIEW_CONFIG.distance :: number,
		height = if config and config.height then config.height else DEFAULT_SIDE_VIEW_CONFIG.height :: number,
		lookHeight = if config and config.lookHeight
			then config.lookHeight
			else DEFAULT_SIDE_VIEW_CONFIG.lookHeight :: number,
		sideSign = if config and config.sideSign
			then math.sign(config.sideSign)
			else math.sign(DEFAULT_SIDE_VIEW_CONFIG.sideSign :: number),
		fieldOfView = if config and config.fieldOfView
			then config.fieldOfView
			else DEFAULT_SIDE_VIEW_CONFIG.fieldOfView :: number,
		movementBackAmount = if config and config.movementBackAmount
			then config.movementBackAmount
			else DEFAULT_SIDE_VIEW_CONFIG.movementBackAmount :: number,
		movementSpeedForMaxBack = if config and config.movementSpeedForMaxBack
			then config.movementSpeedForMaxBack
			else DEFAULT_SIDE_VIEW_CONFIG.movementSpeedForMaxBack :: number,
		movementBackSign = if config and config.movementBackSign
			then math.sign(config.movementBackSign)
			else math.sign(DEFAULT_SIDE_VIEW_CONFIG.movementBackSign :: number),
		mouseInfluenceX = if config and config.mouseInfluenceX
			then config.mouseInfluenceX
			else DEFAULT_SIDE_VIEW_CONFIG.mouseInfluenceX :: number,
		mouseInfluenceY = if config and config.mouseInfluenceY
			then config.mouseInfluenceY
			else DEFAULT_SIDE_VIEW_CONFIG.mouseInfluenceY :: number,
		cameraSpring = if config and config.cameraSpring
			then config.cameraSpring
			else (DEFAULT_SIDE_VIEW_CONFIG.cameraSpring or DEFAULT_CAMERA_SPRING),
		fovSpring = if config and config.fovSpring
			then config.fovSpring
			else (DEFAULT_SIDE_VIEW_CONFIG.fovSpring or DEFAULT_FOV_SPRING),
		catchUpPlayerBehavior = CatchUpPlayer.new(if config then (config :: any).catchUpPlayer else nil),
		roomBehavior = RoomBehavior.new(if config then (config :: any).room else nil),
		backendCache = backendCache,
		backendPredict = backendPredict,
		backendResolver = backendResolver,
		backendStack = backendStack,
		backendState = backendState,
		backendTarget = backendTarget,
		cameraMotion = Ripple.createMotion(startCFrame),
		fovMotion = Ripple.createMotion(startFov),
		janitor = Janitor.new(),
		lastCameraType = nil,
		lastFieldOfView = nil,
		lastResolution = nil,
	}, SideView)

	if self.sideSign == 0 then
		self.sideSign = 1
	end
	if self.movementBackSign == 0 then
		self.movementBackSign = 1
	end

	return self
end

function SideView.ResolveGoal(self: SideView, camera: Camera?, deltaTime: number?): Resolve.ResolutionResult
	local resolution = self.backendResolver:resolve({
		now = os.clock(),
		deltaTime = deltaTime,
		character = self.character,
		distance = self.distance,
		height = self.height,
		lookHeight = self.lookHeight,
		sideSign = self.sideSign,
		fieldOfView = self.fieldOfView,
		movementBackAmount = self.movementBackAmount,
		movementSpeedForMaxBack = self.movementSpeedForMaxBack,
		movementBackSign = self.movementBackSign,
		mouseInfluenceX = self.mouseInfluenceX,
		mouseInfluenceY = self.mouseInfluenceY,
		roomBehavior = self.roomBehavior,
		mouseNormalized = if camera ~= nil then getMouseViewportNormalized(camera) else Vector2.zero,
	})
	self.lastResolution = resolution
	return resolution
end

function SideView.ResolveDynamicViewConfig(self: SideView): RoomBehavior.ViewConfig
	local subject = self.backendTarget:resolve({
		character = self.character,
	})
	local baseViewConfig = getBaseViewConfig(self)
	if subject == nil then
		return baseViewConfig
	end

	return self.roomBehavior:resolveViewConfig(baseViewConfig, subject.position)
end

function SideView.GetTargetCFrame(self: SideView, camera: Camera, _viewConfig: RoomBehavior.ViewConfig): CFrame
	local resolution = self:resolveGoal(camera, 1 / 60)
	return if resolution.cameraCFrame ~= nil then resolution.cameraCFrame else camera.CFrame
end

function SideView.SetTarget(self: SideView, target: any?)
	self.target = target
	self.backendTarget:setExplicitTarget(target)
	self.catchUpPlayerBehavior:reset()
	self.roomBehavior:reset()
end

function SideView.SetCharacter(self: SideView, character: Model?)
	self.character = character
	self.backendTarget:setCharacter(character)
	self.catchUpPlayerBehavior:reset()
	self.roomBehavior:reset()
end

function SideView.PushOverride(self: SideView, overrideRaw: any): number
	local id = self.backendStack:push(overrideRaw)
	self.catchUpPlayerBehavior:reset()
	self.roomBehavior:reset()
	return id
end

function SideView.UpdateOverride(self: SideView, idRaw: any, patchRaw: any): boolean
	local didUpdate = self.backendStack:update(idRaw, patchRaw)
	if didUpdate then
		self.catchUpPlayerBehavior:reset()
		self.roomBehavior:reset()
	end
	return didUpdate
end

function SideView.RemoveOverride(self: SideView, idRaw: any): boolean
	local didRemove = self.backendStack:remove(idRaw)
	if didRemove then
		self.catchUpPlayerBehavior:reset()
		self.roomBehavior:reset()
	end
	return didRemove
end

function SideView.ClearOverrides(self: SideView)
	self.backendStack:clear()
	self.catchUpPlayerBehavior:reset()
	self.roomBehavior:reset()
end

function SideView.SetTemporaryTargetOverride(self: SideView, targetRaw: any?, durationSecondsRaw: any?)
	self.backendTarget:setTemporaryOverride(targetRaw, durationSecondsRaw)
	self.catchUpPlayerBehavior:reset()
	self.roomBehavior:reset()
end

function SideView.ClearTemporaryTargetOverride(self: SideView)
	self.backendTarget:clearTemporaryOverride()
	self.catchUpPlayerBehavior:reset()
	self.roomBehavior:reset()
end

function SideView.GetBackendState(self: SideView): { [string]: any }
	local stateSnapshot = self.backendState:getSnapshot()
	local cacheSnapshot = self.backendCache:getDebugState()
	local overrideEntries = self.backendStack:getEntries(os.clock())
	local targetSnapshot = self.backendTarget:resolve({
		character = self.character,
	})

	return {
		state = stateSnapshot,
		cache = cacheSnapshot,
		overrides = overrideEntries,
		target = targetSnapshot,
		lastResolution = self.lastResolution,
	}
end

function SideView.SnapToTarget(self: SideView)
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end

	local resolution = self:resolveGoal(camera, 0)
	if resolution.cameraCFrame == nil then
		return
	end

	camera.CameraType = Enum.CameraType.Scriptable
	camera.CFrame = resolution.cameraCFrame
	camera.FieldOfView = resolution.fieldOfView
	self.cameraMotion:immediate(resolution.cameraCFrame)
	self.fovMotion:immediate(resolution.fieldOfView)
	self.catchUpPlayerBehavior:reset()
	self.roomBehavior:reset()
end

function SideView.Enable(self: SideView)
	if self.enabled then
		return
	end

	local camera = Workspace.CurrentCamera
	if camera then
		self.lastCameraType = camera.CameraType
		self.lastFieldOfView = camera.FieldOfView
		camera.CameraType = Enum.CameraType.Scriptable
		self.cameraMotion:immediate(camera.CFrame)
		self.fovMotion:immediate(camera.FieldOfView)
	end
	self.catchUpPlayerBehavior:reset()
	self.roomBehavior:reset()
	self.backendState:setEnabled(true)

	self.enabled = true
	RunService:BindToRenderStep(self.renderStepName, SIDE_VIEW_RENDER_PRIORITY, function(deltaTime)
		self:update(deltaTime)
	end)
	self.janitor:GiveChore(function()
		RunService:UnbindFromRenderStep(self.renderStepName)
	end)
end

function SideView.Disable(self: SideView)
	if not self.enabled then
		return
	end

	self.enabled = false
	self.backendState:setEnabled(false)
	self.janitor:Clean()
	self.catchUpPlayerBehavior:reset()
	self.roomBehavior:reset()

	local camera = Workspace.CurrentCamera
	if camera then
		if self.lastCameraType then
			camera.CameraType = self.lastCameraType
		end
		if self.lastFieldOfView then
			camera.FieldOfView = self.lastFieldOfView
		end
	end
end

function SideView.Update(self: SideView, deltaTime: number?)
	if not self.enabled then
		return
	end

	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end

	camera.CameraType = Enum.CameraType.Scriptable

	local resolution = self:resolveGoal(camera, deltaTime)
	if resolution.cameraCFrame == nil then
		return
	end

	local currentCFrame = self.cameraMotion:get()
	local resolvedCameraSpring =
		self.catchUpPlayerBehavior:resolveSpring(self.cameraSpring, currentCFrame, resolution.cameraCFrame, deltaTime)

	self.cameraMotion:spring(resolution.cameraCFrame, resolvedCameraSpring)
	self.fovMotion:spring(resolution.fieldOfView, self.fovSpring)

	local dt = deltaTime or (1 / 60)
	camera.CFrame = self.cameraMotion:step(dt)
	camera.FieldOfView = self.fovMotion:step(dt)
end

function SideView.ApplyConfig(self: SideView, config: SideViewConfig)
	if config.distance then
		self.distance = config.distance
	end
	if config.height then
		self.height = config.height
	end
	if config.lookHeight then
		self.lookHeight = config.lookHeight
	end
	if config.sideSign then
		self.sideSign = math.sign(config.sideSign)
		if self.sideSign == 0 then
			self.sideSign = 1
		end
	end
	if config.fieldOfView then
		self.fieldOfView = config.fieldOfView
	end
	if config.movementBackAmount ~= nil then
		self.movementBackAmount = math.max(config.movementBackAmount, 0)
	end
	if config.movementSpeedForMaxBack ~= nil then
		self.movementSpeedForMaxBack = math.max(config.movementSpeedForMaxBack, 0.01)
	end
	if config.movementBackSign ~= nil then
		self.movementBackSign = math.sign(config.movementBackSign)
		if self.movementBackSign == 0 then
			self.movementBackSign = 1
		end
	end
	if config.mouseInfluenceX ~= nil then
		self.mouseInfluenceX = math.max(config.mouseInfluenceX, 0)
	end
	if config.mouseInfluenceY ~= nil then
		self.mouseInfluenceY = math.max(config.mouseInfluenceY, 0)
	end
	if config.cameraSpring then
		self.cameraSpring = config.cameraSpring
	end
	if config.fovSpring then
		self.fovSpring = config.fovSpring
	end
	if (config :: any).room ~= nil then
		self.roomBehavior:applyConfig((config :: any).room)
	end

	local catchUpPlayerConfig = (config :: any).catchUpPlayer
	if catchUpPlayerConfig ~= nil then
		self.catchUpPlayerBehavior:applyConfig(catchUpPlayerConfig)
	end

	local predictConfig = (config :: any).predict
	if predictConfig ~= nil then
		self.backendPredict:applyConfig(predictConfig)
	end

	self.catchUpPlayerBehavior:reset()
	self.roomBehavior:reset()
end

function SideView.Init(self: SideView, target: any?, config: SideViewConfig?, options: SideViewInitOptions?)
	self:setTarget(target)

	if config then
		self:applyConfig(config)
	end

	local snapToTarget = if options and options.snapToTarget ~= nil then options.snapToTarget else false
	if snapToTarget then
		self:snapToTarget()
	end

	self:enable()
	if not snapToTarget then
		self:update(1 / 60)
	end
end

function SideView.Destroy(self: SideView)
	self:disable()
	self:clearOverrides()
	self:clearTemporaryTargetOverride()
	self.cameraMotion:destroy()
	self.fovMotion:destroy()
	self.janitor:Destroy()
end

SideView.new = SideView.New
SideView.resolveGoal = SideView.ResolveGoal
SideView.resolveDynamicViewConfig = SideView.ResolveDynamicViewConfig
SideView.getTargetCFrame = SideView.GetTargetCFrame
SideView.setTarget = SideView.SetTarget
SideView.setCharacter = SideView.SetCharacter
SideView.pushOverride = SideView.PushOverride
SideView.updateOverride = SideView.UpdateOverride
SideView.removeOverride = SideView.RemoveOverride
SideView.clearOverrides = SideView.ClearOverrides
SideView.setTemporaryTargetOverride = SideView.SetTemporaryTargetOverride
SideView.clearTemporaryTargetOverride = SideView.ClearTemporaryTargetOverride
SideView.getBackendState = SideView.GetBackendState
SideView.snapToTarget = SideView.SnapToTarget
SideView.enable = SideView.Enable
SideView.disable = SideView.Disable
SideView.update = SideView.Update
SideView.applyConfig = SideView.ApplyConfig
SideView.init = SideView.Init
SideView.destroy = SideView.Destroy

return SideView
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="1112">
                <Properties>
                  <string name="Name">Stack</string>
                  <string name="Source"><![CDATA[--!strict

local Stack = {}
Stack.__index = Stack

export type OverrideEntry = {
	id: number,
	order: number,
	priority: number,
	kind: string,
	label: string,
	enabled: boolean,
	createdAt: number,
	expiresAt: number?,
	subject: any?,
	target: any?,
	position: Vector3?,
	velocity: Vector3?,
	lookPosition: Vector3?,
	cameraPosition: Vector3?,
	cameraCFrame: CFrame?,
	fieldOfView: number?,
	viewConfig: { [string]: any }?,
	predict: { [string]: any }?,
	sideSign: number?,
	movementBackAmount: number?,
	mouseInfluenceX: number?,
	mouseInfluenceY: number?,
	disableRoom: boolean?,
	disableMovementBack: boolean?,
	disableMouseInfluence: boolean?,
	runtimeId: string?,
	bossId: string?,
	encounterChannel: string?,
	metadata: { [string]: any }?,
}

export type Stack = typeof(setmetatable(
	{} :: {
		nextId: number,
		nextOrder: number,
		entries: { [number]: OverrideEntry },
	},
	Stack
))

local function trim(valueRaw: any): string
	if typeof(valueRaw) ~= "string" then
		return ""
	end
	return string.match(valueRaw, "^%s*(.-)%s*$") or ""
end

local function sanitizeNumber(valueRaw: any, fallback: number, minimum: number?, maximum: number?): number
	local value = if typeof(valueRaw) == "number" and valueRaw == valueRaw then valueRaw else fallback
	if minimum ~= nil and value < minimum then
		value = minimum
	end
	if maximum ~= nil and value > maximum then
		value = maximum
	end
	return value
end

local function cloneDictionary(sourceRaw: any): { [string]: any }?
	if typeof(sourceRaw) ~= "table" then
		return nil
	end
	local clone = {}
	for key, value in sourceRaw do
		clone[key] = value
	end
	return clone
end

local function cloneEntry(entry: OverrideEntry): OverrideEntry
	return {
		id = entry.id,
		order = entry.order,
		priority = entry.priority,
		kind = entry.kind,
		label = entry.label,
		enabled = entry.enabled,
		createdAt = entry.createdAt,
		expiresAt = entry.expiresAt,
		subject = entry.subject,
		target = entry.target,
		position = entry.position,
		velocity = entry.velocity,
		lookPosition = entry.lookPosition,
		cameraPosition = entry.cameraPosition,
		cameraCFrame = entry.cameraCFrame,
		fieldOfView = entry.fieldOfView,
		viewConfig = cloneDictionary(entry.viewConfig),
		predict = cloneDictionary(entry.predict),
		sideSign = entry.sideSign,
		movementBackAmount = entry.movementBackAmount,
		mouseInfluenceX = entry.mouseInfluenceX,
		mouseInfluenceY = entry.mouseInfluenceY,
		disableRoom = entry.disableRoom,
		disableMovementBack = entry.disableMovementBack,
		disableMouseInfluence = entry.disableMouseInfluence,
		runtimeId = entry.runtimeId,
		bossId = entry.bossId,
		encounterChannel = entry.encounterChannel,
		metadata = cloneDictionary(entry.metadata),
	}
end

local function isExpired(entry: OverrideEntry, now: number): boolean
	return entry.expiresAt ~= nil and now >= entry.expiresAt
end

function Stack.New(): Stack
	return setmetatable({
		nextId = 0,
		nextOrder = 0,
		entries = {} :: { [number]: OverrideEntry },
	}, Stack)
end

function Stack.Push(self: Stack, entryRaw: any): number
	local source = if typeof(entryRaw) == "table" then entryRaw else {}
	self.nextId += 1
	self.nextOrder += 1

	local now = os.clock()
	local durationSeconds = if typeof((source :: any).durationSeconds) == "number"
			and (source :: any).durationSeconds >= 0
		then (source :: any).durationSeconds
		else nil
	local explicitExpiresAt = if typeof((source :: any).expiresAt) == "number" then (source :: any).expiresAt else nil

	local entry: OverrideEntry = {
		id = self.nextId,
		order = self.nextOrder,
		priority = math.floor(sanitizeNumber((source :: any).priority, 0, -1000000, 1000000)),
		kind = if trim((source :: any).kind) ~= "" then trim((source :: any).kind) else "Override",
		label = if trim((source :: any).label) ~= "" then trim((source :: any).label) else "",
		enabled = (source :: any).enabled ~= false,
		createdAt = now,
		expiresAt = if explicitExpiresAt ~= nil
			then explicitExpiresAt
			else if durationSeconds ~= nil then now + durationSeconds else nil,
		subject = (source :: any).subject,
		target = (source :: any).target,
		position = if typeof((source :: any).position) == "Vector3" then (source :: any).position else nil,
		velocity = if typeof((source :: any).velocity) == "Vector3" then (source :: any).velocity else nil,
		lookPosition = if typeof((source :: any).lookPosition) == "Vector3" then (source :: any).lookPosition else nil,
		cameraPosition = if typeof((source :: any).cameraPosition) == "Vector3"
			then (source :: any).cameraPosition
			else nil,
		cameraCFrame = if typeof((source :: any).cameraCFrame) == "CFrame" then (source :: any).cameraCFrame else nil,
		fieldOfView = if typeof((source :: any).fieldOfView) == "number" then (source :: any).fieldOfView else nil,
		viewConfig = cloneDictionary((source :: any).viewConfig),
		predict = cloneDictionary((source :: any).predict),
		sideSign = if typeof((source :: any).sideSign) == "number" then (source :: any).sideSign else nil,
		movementBackAmount = if typeof((source :: any).movementBackAmount) == "number"
			then (source :: any).movementBackAmount
			else nil,
		mouseInfluenceX = if typeof((source :: any).mouseInfluenceX) == "number"
			then (source :: any).mouseInfluenceX
			else nil,
		mouseInfluenceY = if typeof((source :: any).mouseInfluenceY) == "number"
			then (source :: any).mouseInfluenceY
			else nil,
		disableRoom = if typeof((source :: any).disableRoom) == "boolean" then (source :: any).disableRoom else nil,
		disableMovementBack = if typeof((source :: any).disableMovementBack) == "boolean"
			then (source :: any).disableMovementBack
			else nil,
		disableMouseInfluence = if typeof((source :: any).disableMouseInfluence) == "boolean"
			then (source :: any).disableMouseInfluence
			else nil,
		runtimeId = if trim((source :: any).runtimeId) ~= "" then trim((source :: any).runtimeId) else nil,
		bossId = if trim((source :: any).bossId) ~= "" then trim((source :: any).bossId) else nil,
		encounterChannel = if trim((source :: any).encounterChannel) ~= ""
			then trim((source :: any).encounterChannel)
			else if trim((source :: any).channel) ~= "" then trim((source :: any).channel) else nil,
		metadata = cloneDictionary((source :: any).metadata),
	}

	self.entries[entry.id] = entry
	return entry.id
end

function Stack.Update(self: Stack, idRaw: any, patchRaw: any): boolean
	if typeof(idRaw) ~= "number" or typeof(patchRaw) ~= "table" then
		return false
	end

	local id = math.floor(idRaw)
	local entry = self.entries[id]
	if entry == nil then
		return false
	end

	local patch = patchRaw :: any
	for key, value in patch do
		if key ~= "id" and key ~= "order" and key ~= "createdAt" then
			(entry :: any)[key] = value
		end
	end
	return true
end

function Stack.Remove(self: Stack, idRaw: any): boolean
	if typeof(idRaw) ~= "number" then
		return false
	end
	local id = math.floor(idRaw)
	if self.entries[id] == nil then
		return false
	end
	self.entries[id] = nil
	return true
end

function Stack.Clear(self: Stack)
	table.clear(self.entries)
end

function Stack.PruneExpired(self: Stack, nowRaw: any)
	local now = sanitizeNumber(nowRaw, os.clock(), 0, nil)
	for id, entry in self.entries do
		if entry.enabled ~= true or isExpired(entry, now) then
			self.entries[id] = nil
		end
	end
end

function Stack.Resolve(self: Stack, nowRaw: any): OverrideEntry?
	local now = sanitizeNumber(nowRaw, os.clock(), 0, nil)
	self:pruneExpired(now)

	local bestEntry = nil :: OverrideEntry?
	for _, entry in self.entries do
		if entry.enabled ~= true then
			continue
		end
		if bestEntry == nil then
			bestEntry = entry
			continue
		end
		if
			entry.priority > bestEntry.priority
			or (entry.priority == bestEntry.priority and entry.order > bestEntry.order)
		then
			bestEntry = entry
		end
	end

	if bestEntry == nil then
		return nil
	end
	return cloneEntry(bestEntry)
end

function Stack.GetEntries(self: Stack, nowRaw: any): { OverrideEntry }
	local now = sanitizeNumber(nowRaw, os.clock(), 0, nil)
	self:pruneExpired(now)

	local entries = {}
	for _, entry in self.entries do
		entries[#entries + 1] = cloneEntry(entry)
	end
	table.sort(entries, function(left: OverrideEntry, right: OverrideEntry): boolean
		if left.priority ~= right.priority then
			return left.priority > right.priority
		end
		return left.order > right.order
	end)
	return entries
end

Stack.new = Stack.New
Stack.push = Stack.Push
Stack.update = Stack.Update
Stack.remove = Stack.Remove
Stack.clear = Stack.Clear
Stack.pruneExpired = Stack.PruneExpired
Stack.resolve = Stack.Resolve
Stack.getEntries = Stack.GetEntries

return Stack
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="1113">
                <Properties>
                  <string name="Name">State</string>
                  <string name="Source"><![CDATA[--!strict

local State = {}
State.__index = State

export type StateSnapshot = {
	enabled: boolean,
	mode: string,
	reason: string,
	hasTarget: boolean,
	hasOverride: boolean,
	hasDirectCameraOverride: boolean,
	hasTemporaryOverride: boolean,
	subjectKind: string?,
	updatedAt: number,
}

export type State = typeof(setmetatable(
	{} :: {
		enabled: boolean,
		snapshot: StateSnapshot,
	},
	State
))

local function createSnapshot(): StateSnapshot
	return {
		enabled = false,
		mode = "Disabled",
		reason = "disabled",
		hasTarget = false,
		hasOverride = false,
		hasDirectCameraOverride = false,
		hasTemporaryOverride = false,
		subjectKind = nil,
		updatedAt = 0,
	}
end

local function cloneSnapshot(snapshot: StateSnapshot): StateSnapshot
	return {
		enabled = snapshot.enabled,
		mode = snapshot.mode,
		reason = snapshot.reason,
		hasTarget = snapshot.hasTarget,
		hasOverride = snapshot.hasOverride,
		hasDirectCameraOverride = snapshot.hasDirectCameraOverride,
		hasTemporaryOverride = snapshot.hasTemporaryOverride,
		subjectKind = snapshot.subjectKind,
		updatedAt = snapshot.updatedAt,
	}
end

function State.New(): State
	return setmetatable({
		enabled = false,
		snapshot = createSnapshot(),
	}, State)
end

function State.SetEnabled(self: State, enabledRaw: any)
	self.enabled = enabledRaw == true
end

function State.Resolve(self: State, contextRaw: any): StateSnapshot
	local context = if typeof(contextRaw) == "table" then contextRaw else {}
	local target = if typeof((context :: any).target) == "table" then (context :: any).target else nil
	local override = if typeof((context :: any).override) == "table" then (context :: any).override else nil
	local hasTarget = target ~= nil and typeof((target :: any).position) == "Vector3"
	local hasOverride = override ~= nil
	local hasDirectCameraOverride = hasOverride
		and (
			typeof((override :: any).cameraCFrame) == "CFrame"
			or typeof((override :: any).cameraPosition) == "Vector3"
		)
	local hasTemporaryOverride = target ~= nil and (target :: any).kind == "TemporaryOverride"
	local subjectKind = if target ~= nil and typeof((target :: any).kind) == "string" then (target :: any).kind else nil

	local mode = "Disabled"
	local reason = "disabled"
	if self.enabled then
		if hasDirectCameraOverride then
			mode = "DirectOverride"
			reason = if typeof((override :: any).kind) == "string" then (override :: any).kind else "direct_override"
		elseif hasOverride then
			mode = "Override"
			reason = if typeof((override :: any).kind) == "string" then (override :: any).kind else "override"
		elseif hasTemporaryOverride then
			mode = "TemporaryOverride"
			reason = "temporary_override"
		elseif hasTarget then
			mode = "Follow"
			reason = if subjectKind ~= nil then subjectKind else "target"
		else
			mode = "AwaitingTarget"
			reason = "target_missing"
		end
	end

	self.snapshot = {
		enabled = self.enabled,
		mode = mode,
		reason = reason,
		hasTarget = hasTarget,
		hasOverride = hasOverride,
		hasDirectCameraOverride = hasDirectCameraOverride,
		hasTemporaryOverride = hasTemporaryOverride,
		subjectKind = subjectKind,
		updatedAt = os.clock(),
	}
	return self:getSnapshot()
end

function State.GetSnapshot(self: State): StateSnapshot
	return cloneSnapshot(self.snapshot)
end

State.new = State.New
State.setEnabled = State.SetEnabled
State.resolve = State.Resolve
State.getSnapshot = State.GetSnapshot

return State
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="1114">
                <Properties>
                  <string name="Name">Target</string>
                  <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local BossServiceClient = require(script:FindFirstAncestor("game").Client.Services.BossServiceClient)

local Target = {}
Target.__index = Target

export type ResolvedTarget = {
	kind: string,
	position: Vector3,
	velocity: Vector3,
	lookPosition: Vector3?,
	cacheKey: string?,
	instance: Instance?,
	model: Model?,
	basePart: BasePart?,
	subject: any?,
	source: any?,
	metadata: { [string]: any }?,
}

export type Target = typeof(setmetatable(
	{} :: {
		localPlayer: Player?,
		character: Model?,
		explicitTarget: any?,
		resolveCharacterTarget: ((character: Model?) -> BasePart?)?,
		temporaryOverride: any?,
		temporaryOverrideExpiresAt: number?,
	},
	Target
))

local function trim(valueRaw: any): string
	if typeof(valueRaw) ~= "string" then
		return ""
	end
	return string.match(valueRaw, "^%s*(.-)%s*$") or ""
end

local function getInstanceCacheKey(instance: Instance): string
	local ok, debugIdOrError = pcall(function()
		return instance:GetDebugId(0)
	end)
	if ok and typeof(debugIdOrError) == "string" and debugIdOrError ~= "" then
		return debugIdOrError
	end

	local okFullName, fullNameOrError = pcall(function()
		return instance:GetFullName()
	end)
	if okFullName and typeof(fullNameOrError) == "string" and fullNameOrError ~= "" then
		return fullNameOrError
	end

	return tostring(instance)
end

local function sanitizeVelocity(valueRaw: any): Vector3
	if typeof(valueRaw) == "Vector3" then
		return valueRaw
	end
	return Vector3.zero
end

local function resolveModelRootPart(model: Model?): BasePart?
	if model == nil then
		return nil
	end

	local humanoidRootPart = model:FindFirstChild("HumanoidRootPart")
	if humanoidRootPart ~= nil and humanoidRootPart:IsA("BasePart") then
		return humanoidRootPart
	end

	if model.PrimaryPart ~= nil then
		return model.PrimaryPart
	end

	return model:FindFirstChildWhichIsA("BasePart", true)
end

local function resolvePlayerCharacterRoot(player: Player?): BasePart?
	if player == nil then
		return nil
	end
	return resolveModelRootPart(player.Character)
end

local function cloneMetadata(metadataRaw: any): { [string]: any }?
	if typeof(metadataRaw) ~= "table" then
		return nil
	end

	local metadata = {}
	for key, value in metadataRaw do
		metadata[key] = value
	end
	return metadata
end

local function createResolvedTarget(
	kindRaw: any,
	position: Vector3,
	velocityRaw: any,
	lookPositionRaw: any,
	cacheKeyRaw: any,
	instanceRaw: any,
	modelRaw: any,
	basePartRaw: any,
	subjectRaw: any,
	sourceRaw: any,
	metadataRaw: any
): ResolvedTarget
	local basePart = if typeof(basePartRaw) == "Instance" and basePartRaw:IsA("BasePart") then basePartRaw else nil
	local model = if typeof(modelRaw) == "Instance" and modelRaw:IsA("Model") then modelRaw else nil
	local instance = if typeof(instanceRaw) == "Instance" then instanceRaw else nil

	return {
		kind = if trim(kindRaw) ~= "" then trim(kindRaw) else "Target",
		position = position,
		velocity = sanitizeVelocity(velocityRaw),
		lookPosition = if typeof(lookPositionRaw) == "Vector3" then lookPositionRaw else nil,
		cacheKey = if trim(cacheKeyRaw) ~= "" then trim(cacheKeyRaw) else nil,
		instance = instance,
		model = model,
		basePart = basePart,
		subject = subjectRaw,
		source = sourceRaw,
		metadata = cloneMetadata(metadataRaw),
	}
end

local function getBossState(): any
	local bossClient = BossServiceClient :: any
	if typeof(bossClient) ~= "table" then
		return nil
	end
	return bossClient.state
end

local function resolveBossSnapshotByRuntimeId(runtimeIdRaw: any): any?
	local runtimeId = trim(runtimeIdRaw)
	if runtimeId == "" then
		return nil
	end

	local state = getBossState()
	if typeof(state) ~= "table" or typeof((state :: any).byId) ~= "table" then
		return nil
	end
	return (state :: any).byId[runtimeId]
end

local function resolveBossSnapshotByFilters(filtersRaw: any): any?
	local filters = if typeof(filtersRaw) == "table" then filtersRaw else {}
	local state = getBossState()
	if
		typeof(state) ~= "table"
		or typeof((state :: any).orderedIds) ~= "table"
		or typeof((state :: any).byId) ~= "table"
	then
		return nil
	end

	local bossId = trim((filters :: any).bossId)
	local encounterChannel = trim((filters :: any).encounterChannel)
	local orderedIds = (state :: any).orderedIds :: { string }
	local byId = (state :: any).byId :: { [string]: any }

	for _, runtimeId in orderedIds do
		local snapshot = byId[runtimeId]
		if typeof(snapshot) ~= "table" then
			continue
		end

		if bossId ~= "" and trim((snapshot :: any).bossId) ~= bossId then
			continue
		end
		if encounterChannel ~= "" and trim((snapshot :: any).encounterChannel) ~= encounterChannel then
			continue
		end
		if (snapshot :: any).isAlive == false then
			continue
		end
		return snapshot
	end

	return nil
end

local function resolveBossSnapshot(sourceRaw: any): any?
	local source = if typeof(sourceRaw) == "table" then sourceRaw else {}
	local runtimeId = trim((source :: any).runtimeId)
	if runtimeId ~= "" then
		return resolveBossSnapshotByRuntimeId(runtimeId)
	end
	return resolveBossSnapshotByFilters(source)
end

local function createBossTarget(sourceRaw: any, snapshotRaw: any): ResolvedTarget?
	local snapshot = if typeof(snapshotRaw) == "table" then snapshotRaw else nil
	if snapshot == nil then
		return nil
	end

	local motion = if typeof((snapshot :: any).motion) == "table" then (snapshot :: any).motion else {}
	local position = if typeof((motion :: any).position) == "Vector3"
		then (motion :: any).position
		else (snapshot :: any).position
	if typeof(position) ~= "Vector3" then
		return nil
	end

	local velocity = if typeof((motion :: any).velocity) == "Vector3"
		then (motion :: any).velocity
		else sanitizeVelocity((snapshot :: any).velocity)
	local lookPosition = if typeof((snapshot :: any).facing) == "Vector3"
		then position + (snapshot :: any).facing
		else nil

	return createResolvedTarget(
		(sourceRaw :: any).kind or "Boss",
		position,
		velocity,
		lookPosition,
		"boss:" .. trim((snapshot :: any).id),
		nil,
		nil,
		nil,
		snapshot,
		sourceRaw,
		{
			runtimeId = trim((snapshot :: any).id),
			bossId = trim((snapshot :: any).bossId),
			encounterChannel = trim((snapshot :: any).encounterChannel),
		}
	)
end

function Target.New(optionsRaw: any?): Target
	local options = if typeof(optionsRaw) == "table" then optionsRaw else {}

	return setmetatable({
		localPlayer = if typeof((options :: any).localPlayer) == "Instance"
				and (options :: any).localPlayer:IsA("Player")
			then (options :: any).localPlayer
			else Players.LocalPlayer,
		character = if typeof((options :: any).character) == "Instance"
				and (options :: any).character:IsA("Model")
			then (options :: any).character
			else nil,
		explicitTarget = (options :: any).target,
		resolveCharacterTarget = if typeof((options :: any).resolveCharacterTarget) == "function"
			then (options :: any).resolveCharacterTarget
			else nil,
		temporaryOverride = nil,
		temporaryOverrideExpiresAt = nil,
	}, Target)
end

function Target.SetCharacter(self: Target, characterRaw: any)
	if typeof(characterRaw) == "Instance" and characterRaw:IsA("Model") then
		self.character = characterRaw
		return
	end
	self.character = nil
end

function Target.SetExplicitTarget(self: Target, targetRaw: any?)
	self.explicitTarget = targetRaw
end

function Target.SetTemporaryOverride(self: Target, targetRaw: any?, durationSecondsRaw: any?)
	self.temporaryOverride = targetRaw

	if typeof(durationSecondsRaw) == "number" and durationSecondsRaw >= 0 then
		self.temporaryOverrideExpiresAt = os.clock() + durationSecondsRaw
		return
	end

	if typeof(targetRaw) == "table" and typeof((targetRaw :: any).durationSeconds) == "number" then
		self.temporaryOverrideExpiresAt = os.clock() + math.max((targetRaw :: any).durationSeconds, 0)
		return
	end
	if typeof(targetRaw) == "table" and typeof((targetRaw :: any).expiresAt) == "number" then
		self.temporaryOverrideExpiresAt = (targetRaw :: any).expiresAt
		return
	end

	self.temporaryOverrideExpiresAt = nil
end

function Target.ClearTemporaryOverride(self: Target)
	self.temporaryOverride = nil
	self.temporaryOverrideExpiresAt = nil
end

function Target.HasTemporaryOverride(self: Target): boolean
	if self.temporaryOverride == nil then
		return false
	end
	if self.temporaryOverrideExpiresAt ~= nil and os.clock() >= self.temporaryOverrideExpiresAt then
		self:clearTemporaryOverride()
		return false
	end
	return true
end

function Target.ResolveAny(self: Target, sourceRaw: any, kindFallback: string?): ResolvedTarget?
	if sourceRaw == nil then
		return nil
	end

	if typeof(sourceRaw) == "Instance" then
		if sourceRaw:IsA("BasePart") then
			if sourceRaw.Parent == nil then
				return nil
			end
			return createResolvedTarget(
				kindFallback or "BasePart",
				sourceRaw.Position,
				sourceRaw.AssemblyLinearVelocity,
				nil,
				getInstanceCacheKey(sourceRaw),
				sourceRaw,
				sourceRaw.Parent,
				sourceRaw,
				sourceRaw,
				sourceRaw,
				nil
			)
		end

		if sourceRaw:IsA("Attachment") then
			if sourceRaw.Parent == nil then
				return nil
			end
			local parentPart = if sourceRaw.Parent ~= nil and sourceRaw.Parent:IsA("BasePart")
				then sourceRaw.Parent
				else nil
			return createResolvedTarget(
				kindFallback or "Attachment",
				sourceRaw.WorldPosition,
				if parentPart ~= nil then parentPart.AssemblyLinearVelocity else Vector3.zero,
				nil,
				getInstanceCacheKey(sourceRaw),
				sourceRaw,
				if sourceRaw.Parent ~= nil and sourceRaw.Parent:IsA("Model") then sourceRaw.Parent else nil,
				parentPart,
				sourceRaw,
				sourceRaw,
				nil
			)
		end

		if sourceRaw:IsA("Model") then
			if sourceRaw.Parent == nil then
				return nil
			end
			local rootPart = resolveModelRootPart(sourceRaw)
			if rootPart == nil then
				return nil
			end

			return createResolvedTarget(
				kindFallback or "Model",
				rootPart.Position,
				rootPart.AssemblyLinearVelocity,
				nil,
				getInstanceCacheKey(sourceRaw),
				sourceRaw,
				sourceRaw,
				rootPart,
				sourceRaw,
				sourceRaw,
				nil
			)
		end

		if sourceRaw:IsA("Player") then
			local rootPart = resolvePlayerCharacterRoot(sourceRaw)
			if rootPart == nil then
				return nil
			end

			return createResolvedTarget(
				kindFallback or "Player",
				rootPart.Position,
				rootPart.AssemblyLinearVelocity,
				nil,
				"player:" .. tostring(sourceRaw.UserId),
				sourceRaw,
				sourceRaw.Character,
				rootPart,
				sourceRaw,
				sourceRaw,
				{
					userId = sourceRaw.UserId,
				}
			)
		end
	end

	if typeof(sourceRaw) ~= "table" then
		return nil
	end

	local source = sourceRaw :: any
	local nestedTarget = source.target
		or source.subject
		or source.instance
		or source.basePart
		or source.rootPart
		or source.model
	if nestedTarget ~= nil and nestedTarget ~= sourceRaw then
		local nestedResolved = self:resolveAny(nestedTarget, source.kind or kindFallback)
		if nestedResolved ~= nil then
			if typeof(source.lookPosition) == "Vector3" then
				nestedResolved.lookPosition = source.lookPosition
			end
			if typeof(source.velocity) == "Vector3" then
				nestedResolved.velocity = source.velocity
			end
			if trim(source.cacheKey) ~= "" then
				nestedResolved.cacheKey = trim(source.cacheKey)
			end
			nestedResolved.source = sourceRaw
			if source.metadata ~= nil then
				nestedResolved.metadata = cloneMetadata(source.metadata)
			end
			return nestedResolved
		end
	end

	if source.player ~= nil then
		local playerResolved = self:resolveAny(source.player, source.kind or kindFallback or "Player")
		if playerResolved ~= nil then
			playerResolved.source = sourceRaw
			return playerResolved
		end
	end

	if source.character ~= nil then
		local characterResolved = self:resolveAny(source.character, source.kind or kindFallback or "Character")
		if characterResolved ~= nil then
			characterResolved.source = sourceRaw
			return characterResolved
		end
	end

	local bossSnapshot = resolveBossSnapshot(sourceRaw)
	if bossSnapshot ~= nil then
		local bossTarget = createBossTarget(sourceRaw, bossSnapshot)
		if bossTarget ~= nil then
			return bossTarget
		end
	end

	if typeof(source.position) == "Vector3" then
		return createResolvedTarget(
			source.kind or kindFallback or "Point",
			source.position,
			source.velocity,
			source.lookPosition,
			source.cacheKey,
			nil,
			nil,
			nil,
			source.subject,
			sourceRaw,
			source.metadata
		)
	end

	return nil
end

function Target.ResolveCharacterTarget(self: Target, characterRaw: any?): ResolvedTarget?
	local character = if typeof(characterRaw) == "Instance" and characterRaw:IsA("Model")
		then characterRaw
		else self.character
	if character == nil then
		return nil
	end

	if self.resolveCharacterTarget ~= nil then
		local ok, basePart = pcall(self.resolveCharacterTarget, character)
		if ok and typeof(basePart) == "Instance" and basePart:IsA("BasePart") then
			return self:resolveAny(basePart, "Character")
		end
	end

	return self:resolveAny(character, "Character")
end

function Target.Resolve(self: Target, optionsRaw: any?): ResolvedTarget?
	local options = if typeof(optionsRaw) == "table" then optionsRaw else {}
	if self.temporaryOverrideExpiresAt ~= nil and os.clock() >= self.temporaryOverrideExpiresAt then
		self:clearTemporaryOverride()
	end

	local override = if typeof((options :: any).override) == "table" then (options :: any).override else nil
	if override ~= nil then
		local resolvedOverride = self:resolveAny(override, (override :: any).kind or "Override")
		if resolvedOverride ~= nil then
			return resolvedOverride
		end
	end

	if self:hasTemporaryOverride() then
		local temporaryTarget = self:resolveAny(self.temporaryOverride, "TemporaryOverride")
		if temporaryTarget ~= nil then
			temporaryTarget.kind = "TemporaryOverride"
			return temporaryTarget
		end
	end

	local explicitTarget = self:resolveAny(self.explicitTarget, "ExplicitTarget")
	if explicitTarget ~= nil then
		return explicitTarget
	end

	local characterTarget = self:resolveCharacterTarget((options :: any).character)
	if characterTarget ~= nil then
		return characterTarget
	end

	local localPlayer = if typeof((options :: any).localPlayer) == "Instance"
			and (options :: any).localPlayer:IsA("Player")
		then (options :: any).localPlayer
		else self.localPlayer
	if localPlayer ~= nil then
		return self:resolveAny(localPlayer, "Player")
	end

	return nil
end

Target.new = Target.New
Target.setCharacter = Target.SetCharacter
Target.setExplicitTarget = Target.SetExplicitTarget
Target.setTemporaryOverride = Target.SetTemporaryOverride
Target.clearTemporaryOverride = Target.ClearTemporaryOverride
Target.hasTemporaryOverride = Target.HasTemporaryOverride
Target.resolveAny = Target.ResolveAny
Target.resolveCharacterTarget = Target.ResolveCharacterTarget
Target.resolve = Target.Resolve

return Target
]]></string>
                </Properties>
              </Item>
            </Item>
            <Item class="ModuleScript" referent="1115">
              <Properties>
                <string name="Name">EnemyHitbox</string>
                <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local SpatialHash = require(script.Utils.SpatialHash)

local EnemyHitbox = {}
EnemyHitbox.__index = EnemyHitbox

export type EnemyConfig = {
	id: string,
	owner: any?,
	model: Model?,
	getModel: ((owner: any) -> Model?)?,
	getCenter: ((owner: any) -> Vector3?)?,
	getAlive: ((owner: any) -> boolean)?,
	getDamage: ((owner: any) -> number)?,
	getAttackCooldown: ((owner: any) -> number)?,
	getHurtboxSize: ((owner: any, model: Model?, rootPart: BasePart?) -> Vector3?)?,
	getAttackSize: ((owner: any, model: Model?, rootPart: BasePart?) -> Vector3?)?,
	canHitPlayer: ((owner: any, player: Player) -> boolean)?,
	onHitPlayer: ((owner: any, player: Player, damage: number) -> ())?,
}

export type EnemyHitboxConfig = {
	cellSize: number?,
	playerCellSize: number?,
	playerHitboxSizePadding: Vector3?,
}

type EnemyRecord = {
	id: string,
	config: EnemyConfig,
	owner: any?,
	model: Model?,
	rootPart: BasePart?,
	center: Vector3,
	hurtboxSize: Vector3,
	attackSize: Vector3,
	aabbMin: Vector3,
	aabbMax: Vector3,
	attackAabbMin: Vector3,
	attackAabbMax: Vector3,
	alive: boolean,
	damage: number,
	attackCooldown: number,
	nextDamageAtByPlayer: { [Player]: number },
}

type PlayerRecord = {
	id: string,
	player: Player,
	humanoid: Humanoid,
	rootPart: BasePart,
	aabbMin: Vector3,
	aabbMax: Vector3,
}

export type EnemyHitbox = typeof(setmetatable(
	{} :: {
		enemySpatial: SpatialHash.SpatialHash<EnemyRecord>,
		playerSpatial: SpatialHash.SpatialHash<PlayerRecord>,
		enemiesById: { [string]: EnemyRecord },
		enemyIdByModel: { [Model]: string },
		playersById: { [string]: PlayerRecord },
		playerHitboxSizePadding: Vector3,
		heartbeatConnection: RBXScriptConnection?,
		destroyed: boolean,
	},
	EnemyHitbox
))

local DEFAULT_CELL_SIZE = 8
local DEFAULT_PLAYER_CELL_SIZE = 8
local DEFAULT_PLAYER_HITBOX_PADDING = Vector3.new(1.2, 1.6, 1.2)
local DEFAULT_HURTBOX_SIZE = Vector3.new(4, 3, 4)
local DEFAULT_ATTACK_SIZE = Vector3.new(5.5, 3.5, 5.5)
local DEFAULT_ATTACK_COOLDOWN = 0.85
local DEFAULT_DAMAGE = 6

local function sanitizeNumber(valueRaw: any, fallback: number, minimum: number?, maximum: number?): number
	local value = fallback
	if typeof(valueRaw) == "number" and valueRaw == valueRaw then
		value = valueRaw
	end

	if minimum ~= nil and value < minimum then
		value = minimum
	end
	if maximum ~= nil and value > maximum then
		value = maximum
	end
	return value
end

local function sanitizeVector3(valueRaw: any, fallback: Vector3, minimumComponent: number): Vector3
	if typeof(valueRaw) ~= "Vector3" then
		return fallback
	end

	return Vector3.new(
		math.max(minimumComponent, math.abs(valueRaw.X)),
		math.max(minimumComponent, math.abs(valueRaw.Y)),
		math.max(minimumComponent, math.abs(valueRaw.Z))
	)
end

local function resolveRootPart(model: Model?): BasePart?
	if model == nil then
		return nil
	end

	local rootPartCandidate = model:FindFirstChild("HumanoidRootPart")
	if rootPartCandidate ~= nil and rootPartCandidate:IsA("BasePart") then
		return rootPartCandidate
	end

	if model.PrimaryPart ~= nil then
		return model.PrimaryPart
	end

	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") then
			return descendant
		end
	end

	return nil
end

local function resolveCharacterRoot(player: Player): (Humanoid?, BasePart?)
	local character = player.Character
	if character == nil then
		return nil, nil
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid == nil or humanoid.Health <= 0 then
		return nil, nil
	end

	local rootPartCandidate = character:FindFirstChild("HumanoidRootPart")
	local rootPart = if rootPartCandidate ~= nil and rootPartCandidate:IsA("BasePart") then rootPartCandidate else nil
	if rootPart == nil then
		local primary = character.PrimaryPart
		if primary ~= nil and primary:IsA("BasePart") then
			rootPart = primary
		end
	end

	return humanoid, rootPart
end

local function runCallback(callback: ((...any) -> any)?, defaultValue: any, ...: any): any
	if typeof(callback) ~= "function" then
		return defaultValue
	end

	local ok, result = pcall(callback, ...)
	if ok then
		return result
	end

	return defaultValue
end

function EnemyHitbox.New(configRaw: EnemyHitboxConfig?): EnemyHitbox
	local config = if typeof(configRaw) == "table" then configRaw else {}

	local self = setmetatable({
		enemySpatial = SpatialHash.new(sanitizeNumber(config.cellSize, DEFAULT_CELL_SIZE, 0.5, 256)),
		playerSpatial = SpatialHash.new(sanitizeNumber(config.playerCellSize, DEFAULT_PLAYER_CELL_SIZE, 0.5, 256)),
		enemiesById = {},
		enemyIdByModel = {},
		playersById = {},
		playerHitboxSizePadding = sanitizeVector3(config.playerHitboxSizePadding, DEFAULT_PLAYER_HITBOX_PADDING, 0),
		heartbeatConnection = nil,
		destroyed = false,
	}, EnemyHitbox)

	self.heartbeatConnection = RunService.Heartbeat:Connect(function()
		self:_step()
	end)

	return self
end

function EnemyHitbox.Destroy(self: EnemyHitbox)
	if self.destroyed then
		return
	end
	self.destroyed = true

	if self.heartbeatConnection ~= nil then
		self.heartbeatConnection:Disconnect()
		self.heartbeatConnection = nil
	end

	table.clear(self.enemyIdByModel)
	table.clear(self.enemiesById)
	table.clear(self.playersById)
	self.enemySpatial:clear()
	self.playerSpatial:clear()
end

function EnemyHitbox.RegisterEnemy(self: EnemyHitbox, configRaw: any): boolean
	if typeof(configRaw) ~= "table" then
		return false
	end

	local config = configRaw :: EnemyConfig
	if typeof(config.id) ~= "string" or config.id == "" then
		return false
	end

	self:unregisterEnemy(config.id)

	local record: EnemyRecord = {
		id = config.id,
		config = config,
		owner = config.owner,
		model = config.model,
		rootPart = nil,
		center = Vector3.zero,
		hurtboxSize = DEFAULT_HURTBOX_SIZE,
		attackSize = DEFAULT_ATTACK_SIZE,
		aabbMin = Vector3.zero,
		aabbMax = Vector3.zero,
		attackAabbMin = Vector3.zero,
		attackAabbMax = Vector3.zero,
		alive = false,
		damage = DEFAULT_DAMAGE,
		attackCooldown = DEFAULT_ATTACK_COOLDOWN,
		nextDamageAtByPlayer = {},
	}

	self.enemiesById[record.id] = record
	self:_refreshEnemy(record)
	return true
end

function EnemyHitbox.UnregisterEnemy(self: EnemyHitbox, enemyIdRaw: any)
	if typeof(enemyIdRaw) ~= "string" or enemyIdRaw == "" then
		return
	end

	local record = self.enemiesById[enemyIdRaw]
	if record == nil then
		return
	end

	if record.model ~= nil and self.enemyIdByModel[record.model] == record.id then
		self.enemyIdByModel[record.model] = nil
	end

	table.clear(record.nextDamageAtByPlayer)
	self.enemySpatial:remove(record.id)
	self.enemiesById[record.id] = nil
end

function EnemyHitbox.SetEnemyModel(self: EnemyHitbox, enemyIdRaw: any, modelRaw: any)
	if typeof(enemyIdRaw) ~= "string" or enemyIdRaw == "" then
		return
	end

	local record = self.enemiesById[enemyIdRaw]
	if record == nil then
		return
	end

	local nextModel = if typeof(modelRaw) == "Instance" and modelRaw:IsA("Model") then modelRaw else nil
	record.config.model = nextModel
	record.model = nextModel
	self:_refreshEnemy(record)
end

function EnemyHitbox.SetEnemyAlive(self: EnemyHitbox, enemyIdRaw: any, aliveRaw: any)
	if typeof(enemyIdRaw) ~= "string" or enemyIdRaw == "" then
		return
	end

	local record = self.enemiesById[enemyIdRaw]
	if record == nil then
		return
	end

	record.alive = aliveRaw == true
	if not record.alive then
		self.enemySpatial:remove(record.id)
	end
end

function EnemyHitbox.ResolveEnemyIdFromModel(self: EnemyHitbox, modelRaw: any): string?
	if typeof(modelRaw) ~= "Instance" or not modelRaw:IsA("Model") then
		return nil
	end

	local cursor: Instance? = modelRaw
	while cursor ~= nil do
		if cursor:IsA("Model") then
			local enemyId = self.enemyIdByModel[cursor]
			if enemyId ~= nil then
				return enemyId
			end
		end
		cursor = cursor.Parent
	end

	return nil
end

function EnemyHitbox.ResolveEnemyIdFromPart(self: EnemyHitbox, partRaw: any): string?
	if typeof(partRaw) ~= "Instance" or not partRaw:IsA("BasePart") then
		return nil
	end

	local part = partRaw :: BasePart
	local enemyIdFromModel = self:resolveEnemyIdFromModel(part:FindFirstAncestorOfClass("Model"))
	return enemyIdFromModel
end

function EnemyHitbox._refreshPlayers(self: EnemyHitbox)
	local alivePlayerIds: { [string]: true } = {}

	for _, player in Players:GetPlayers() do
		local humanoid, rootPart = resolveCharacterRoot(player)
		if humanoid == nil or rootPart == nil then
			continue
		end

		local playerId = tostring(player.UserId)
		alivePlayerIds[playerId] = true

		local hitboxSize = rootPart.Size + self.playerHitboxSizePadding
		local aabbMin, aabbMax = SpatialHash.aabbFromCenterSize(rootPart.Position, hitboxSize)
		local record: PlayerRecord = {
			id = playerId,
			player = player,
			humanoid = humanoid,
			rootPart = rootPart,
			aabbMin = aabbMin,
			aabbMax = aabbMax,
		}

		self.playersById[playerId] = record
		self.playerSpatial:upsert(playerId, aabbMin, aabbMax, record)
	end

	for playerId, record in self.playersById do
		if alivePlayerIds[playerId] ~= true then
			self.playersById[playerId] = nil
			self.playerSpatial:remove(playerId)
			for _, enemyRecord in self.enemiesById do
				enemyRecord.nextDamageAtByPlayer[record.player] = nil
			end
		end
	end
end

function EnemyHitbox._refreshEnemy(self: EnemyHitbox, record: EnemyRecord)
	local config = record.config
	local owner = record.owner

	local previousModel = record.model
	local nextModel = config.model
	if nextModel == nil then
		nextModel = runCallback(config.getModel, nil, owner)
	end
	if typeof(nextModel) ~= "Instance" or not nextModel:IsA("Model") then
		nextModel = nil
	end

	if previousModel ~= nil and previousModel ~= nextModel and self.enemyIdByModel[previousModel] == record.id then
		self.enemyIdByModel[previousModel] = nil
	end

	record.model = nextModel
	if nextModel ~= nil then
		self.enemyIdByModel[nextModel] = record.id
	end

	local rootPart = resolveRootPart(nextModel)
	record.rootPart = rootPart

	local aliveFromCallback = runCallback(config.getAlive, true, owner)
	record.alive = aliveFromCallback and nextModel ~= nil and rootPart ~= nil
	if not record.alive then
		self.enemySpatial:remove(record.id)
		return
	end

	local center = runCallback(config.getCenter, nil, owner)
	if typeof(center) ~= "Vector3" then
		if rootPart ~= nil then
			center = rootPart.Position
		elseif nextModel ~= nil then
			center = nextModel:GetPivot().Position
		else
			center = Vector3.zero
		end
	end

	local rootSize = if rootPart ~= nil then rootPart.Size else DEFAULT_HURTBOX_SIZE
	local hurtboxSize = sanitizeVector3(
		runCallback(config.getHurtboxSize, nil, owner, nextModel, rootPart),
		Vector3.new(math.max(2, rootSize.X), math.max(2, rootSize.Y), math.max(2, rootSize.Z)),
		0.5
	)
	local attackSize = sanitizeVector3(
		runCallback(config.getAttackSize, nil, owner, nextModel, rootPart),
		Vector3.new(
			math.max(hurtboxSize.X, rootSize.X + 1.5),
			math.max(hurtboxSize.Y, rootSize.Y + 0.5),
			math.max(hurtboxSize.Z, rootSize.Z + 2)
		),
		0.5
	)

	local aabbMin, aabbMax = SpatialHash.aabbFromCenterSize(center, hurtboxSize)
	local attackAabbMin, attackAabbMax = SpatialHash.aabbFromCenterSize(center, attackSize)
	record.center = center
	record.hurtboxSize = hurtboxSize
	record.attackSize = attackSize
	record.aabbMin = aabbMin
	record.aabbMax = aabbMax
	record.attackAabbMin = attackAabbMin
	record.attackAabbMax = attackAabbMax
	record.damage = sanitizeNumber(runCallback(config.getDamage, DEFAULT_DAMAGE, owner), DEFAULT_DAMAGE, 0, 100000)
	record.attackCooldown =
		sanitizeNumber(runCallback(config.getAttackCooldown, DEFAULT_ATTACK_COOLDOWN, owner), DEFAULT_ATTACK_COOLDOWN, 0.05, 30)

	self.enemySpatial:upsert(record.id, aabbMin, aabbMax, record)
end

function EnemyHitbox._processEnemyAttacks(self: EnemyHitbox, now: number)
	for _, record in self.enemiesById do
		if record.alive ~= true then
			continue
		end
		if record.damage <= 0 then
			continue
		end

		local canHitPlayerCallback = record.config.canHitPlayer
		local onHitPlayerCallback = record.config.onHitPlayer
		if typeof(onHitPlayerCallback) ~= "function" then
			continue
		end

		local candidates = self.playerSpatial:queryAabb(record.attackAabbMin, record.attackAabbMax)
		if #candidates <= 0 then
			continue
		end

		for _, entry in candidates do
			local playerRecord = entry.payload
			local player = playerRecord.player
			if playerRecord.humanoid.Health <= 0 then
				continue
			end

			local nextAllowedAt = record.nextDamageAtByPlayer[player]
			if nextAllowedAt ~= nil and now < nextAllowedAt then
				continue
			end

			local canHitPlayer = runCallback(canHitPlayerCallback, true, record.owner, player)
			if not canHitPlayer then
				continue
			end

			if not SpatialHash.aabbIntersects(
				record.attackAabbMin,
				record.attackAabbMax,
				playerRecord.aabbMin,
				playerRecord.aabbMax
			) then
				continue
			end

			record.nextDamageAtByPlayer[player] = now + record.attackCooldown
			runCallback(onHitPlayerCallback, nil, record.owner, player, record.damage)
		end
	end
end

function EnemyHitbox._step(self: EnemyHitbox)
	if self.destroyed then
		return
	end

	self:_refreshPlayers()
	for _, record in self.enemiesById do
		self:_refreshEnemy(record)
	end
	self:_processEnemyAttacks(os.clock())
end

EnemyHitbox.new = EnemyHitbox.New
EnemyHitbox.destroy = EnemyHitbox.Destroy
EnemyHitbox.registerEnemy = EnemyHitbox.RegisterEnemy
EnemyHitbox.unregisterEnemy = EnemyHitbox.UnregisterEnemy
EnemyHitbox.setEnemyModel = EnemyHitbox.SetEnemyModel
EnemyHitbox.setEnemyAlive = EnemyHitbox.SetEnemyAlive
EnemyHitbox.resolveEnemyIdFromModel = EnemyHitbox.ResolveEnemyIdFromModel
EnemyHitbox.resolveEnemyIdFromPart = EnemyHitbox.ResolveEnemyIdFromPart

return EnemyHitbox
]]></string>
              </Properties>
              <Item class="Folder" referent="1116">
                <Properties>
                  <string name="Name">Utils</string>
                </Properties>
                <Item class="ModuleScript" referent="1117">
                  <Properties>
                    <string name="Name">SpatialHash</string>
                    <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Bounds = require(script:FindFirstAncestor("game").Shared.Modules.Math.Bounds)

local SpatialHash = {}
SpatialHash.__index = SpatialHash

export type SpatialHashEntry<T> = {
	id: string,
	payload: T,
	aabbMin: Vector3,
	aabbMax: Vector3,
	cellKeys: { [string]: true },
}

export type SpatialHash<T> = typeof(setmetatable(
	{} :: {
		cellSize: number,
		cells: { [string]: { [string]: SpatialHashEntry<T> } },
		entries: { [string]: SpatialHashEntry<T> },
	},
	SpatialHash
))

local DEFAULT_CELL_SIZE = 8

local function sanitizeNumber(valueRaw: any, fallback: number, minimum: number?, maximum: number?): number
	local value = fallback
	if typeof(valueRaw) == "number" and valueRaw == valueRaw then
		value = valueRaw
	end

	if minimum ~= nil and value < minimum then
		value = minimum
	end
	if maximum ~= nil and value > maximum then
		value = maximum
	end

	return value
end

local function ensureAabb(aabbMinRaw: any, aabbMaxRaw: any): (Vector3, Vector3)
	if typeof(aabbMinRaw) ~= "Vector3" or typeof(aabbMaxRaw) ~= "Vector3" then
		return Vector3.zero, Vector3.zero
	end

	local bounds = Bounds.new(aabbMinRaw, aabbMaxRaw)
	return bounds.min, bounds.max
end

local function hashCellKey(cellX: number, cellY: number, cellZ: number): string
	return (`{cellX}:{cellY}:{cellZ}`)
end

local function computeCellIndex(value: number, cellSize: number): number
	return math.floor(value / cellSize)
end

local function overlapRange(minValue: number, maxValue: number, cellSize: number): (number, number)
	local fromCell = computeCellIndex(minValue, cellSize)
	local toCell = computeCellIndex(maxValue, cellSize)
	if toCell < fromCell then
		toCell = fromCell
	end
	return fromCell, toCell
end

function SpatialHash.new<T>(cellSizeRaw: any): SpatialHash<T>
	local self = setmetatable({
		cellSize = sanitizeNumber(cellSizeRaw, DEFAULT_CELL_SIZE, 0.1, 2048),
		cells = {},
		entries = {},
	}, SpatialHash)

	return self :: any
end

function SpatialHash.CellKey(cellX: number, cellY: number, cellZ: number): string
	return hashCellKey(cellX, cellY, cellZ)
end

function SpatialHash.AabbFromCenterSize(centerRaw: any, sizeRaw: any): (Vector3, Vector3)
	local center = if typeof(centerRaw) == "Vector3" then centerRaw else Vector3.zero
	local size = if typeof(sizeRaw) == "Vector3" then sizeRaw else Vector3.zero
	local bounds = Bounds.fromCenterSize(center, size)
	return bounds.min, bounds.max
end

function SpatialHash.AabbIntersects(aMinRaw: any, aMaxRaw: any, bMinRaw: any, bMaxRaw: any): boolean
	if typeof(aMinRaw) ~= "Vector3"
		or typeof(aMaxRaw) ~= "Vector3"
		or typeof(bMinRaw) ~= "Vector3"
		or typeof(bMaxRaw) ~= "Vector3" then
		return false
	end

	return Bounds.intersects(Bounds.new(aMinRaw, aMaxRaw), Bounds.new(bMinRaw, bMaxRaw))
end

function SpatialHash._forEachOverlappingCell(
	self: SpatialHash<any>,
	aabbMinRaw: any,
	aabbMaxRaw: any,
	callback: (cellKey: string, cellX: number, cellY: number, cellZ: number) -> ()
)
	if typeof(callback) ~= "function" then
		return
	end

	local aabbMin, aabbMax = ensureAabb(aabbMinRaw, aabbMaxRaw)
	local cellSize = self.cellSize
	local fromX, toX = overlapRange(aabbMin.X, aabbMax.X, cellSize)
	local fromY, toY = overlapRange(aabbMin.Y, aabbMax.Y, cellSize)
	local fromZ, toZ = overlapRange(aabbMin.Z, aabbMax.Z, cellSize)

	for cellX = fromX, toX do
		for cellY = fromY, toY do
			for cellZ = fromZ, toZ do
				local key = hashCellKey(cellX, cellY, cellZ)
				callback(key, cellX, cellY, cellZ)
			end
		end
	end
end

function SpatialHash.Has(self: SpatialHash<any>, idRaw: any): boolean
	if typeof(idRaw) ~= "string" or idRaw == "" then
		return false
	end
	return self.entries[idRaw] ~= nil
end

function SpatialHash.Get(self: SpatialHash<any>, idRaw: any): SpatialHashEntry<any>?
	if typeof(idRaw) ~= "string" or idRaw == "" then
		return nil
	end
	return self.entries[idRaw]
end

function SpatialHash.Remove(self: SpatialHash<any>, idRaw: any)
	if typeof(idRaw) ~= "string" or idRaw == "" then
		return
	end

	local entry = self.entries[idRaw]
	if entry == nil then
		return
	end

	for cellKey in entry.cellKeys do
		local cell = self.cells[cellKey]
		if cell ~= nil then
			cell[idRaw] = nil
			if next(cell) == nil then
				self.cells[cellKey] = nil
			end
		end
	end

	self.entries[idRaw] = nil
end

function SpatialHash.Upsert(
	self: SpatialHash<any>,
	idRaw: any,
	aabbMinRaw: any,
	aabbMaxRaw: any,
	payload: any
): SpatialHashEntry<any>?
	if typeof(idRaw) ~= "string" or idRaw == "" then
		return nil
	end

	local aabbMin, aabbMax = ensureAabb(aabbMinRaw, aabbMaxRaw)
	if payload == nil then
		return nil
	end

	self:remove(idRaw)

	local entry: SpatialHashEntry<any> = {
		id = idRaw,
		payload = payload,
		aabbMin = aabbMin,
		aabbMax = aabbMax,
		cellKeys = {},
	}

	self.entries[idRaw] = entry

	self:_forEachOverlappingCell(aabbMin, aabbMax, function(cellKey: string)
		local cell = self.cells[cellKey]
		if cell == nil then
			cell = {}
			self.cells[cellKey] = cell
		end
		cell[idRaw] = entry
		entry.cellKeys[cellKey] = true
	end)

	return entry
end

function SpatialHash.Clear(self: SpatialHash<any>)
	table.clear(self.cells)
	table.clear(self.entries)
end

function SpatialHash.QueryAabb(
	self: SpatialHash<any>,
	aabbMinRaw: any,
	aabbMaxRaw: any,
	predicate: ((entry: SpatialHashEntry<any>) -> boolean)?
): { SpatialHashEntry<any> }
	local aabbMin, aabbMax = ensureAabb(aabbMinRaw, aabbMaxRaw)
	local dedupById: { [string]: SpatialHashEntry<any> } = {}

	self:_forEachOverlappingCell(aabbMin, aabbMax, function(cellKey: string)
		local cell = self.cells[cellKey]
		if cell == nil then
			return
		end

		for id, entry in cell do
			if dedupById[id] ~= nil then
				continue
			end

			if not SpatialHash.AabbIntersects(entry.aabbMin, entry.aabbMax, aabbMin, aabbMax) then
				continue
			end

			if predicate ~= nil and not predicate(entry) then
				continue
			end

			dedupById[id] = entry
		end
	end)

	local out = {}
	for _, entry in dedupById do
		table.insert(out, entry)
	end
	return out
end

function SpatialHash.QuerySphere(
	self: SpatialHash<any>,
	centerRaw: any,
	radiusRaw: any,
	predicate: ((entry: SpatialHashEntry<any>) -> boolean)?
): { SpatialHashEntry<any> }
	local center = if typeof(centerRaw) == "Vector3" then centerRaw else Vector3.zero
	local radius = sanitizeNumber(radiusRaw, 0, 0, nil)
	local half = Vector3.new(radius, radius, radius)
	local aabbMin = center - half
	local aabbMax = center + half
	local radiusSquared = radius * radius

	return self:queryAabb(aabbMin, aabbMax, function(entry: SpatialHashEntry<any>): boolean
		if predicate ~= nil and not predicate(entry) then
			return false
		end

		local bounds = Bounds.new(entry.aabbMin, entry.aabbMax)
		return Bounds.distanceSqToPoint(bounds, center) <= radiusSquared
	end)
end

SpatialHash.cellKey = SpatialHash.CellKey
SpatialHash.aabbFromCenterSize = SpatialHash.AabbFromCenterSize
SpatialHash.aabbIntersects = SpatialHash.AabbIntersects
SpatialHash.has = SpatialHash.Has
SpatialHash.get = SpatialHash.Get
SpatialHash.remove = SpatialHash.Remove
SpatialHash.upsert = SpatialHash.Upsert
SpatialHash.clear = SpatialHash.Clear
SpatialHash.queryAabb = SpatialHash.QueryAabb
SpatialHash.querySphere = SpatialHash.QuerySphere

return SpatialHash
]]></string>
                  </Properties>
                </Item>
              </Item>
            </Item>
            <Item class="ModuleScript" referent="1118">
              <Properties>
                <string name="Name">Gore</string>
                <string name="Source"><![CDATA[--!strict
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Janitor = require(ReplicatedStorage.Packages.Janitor)
local BloodEngine = require(ReplicatedStorage.Packages.BloodEngine)
local WorkspaceFolders = require(script:FindFirstAncestor("game").Shared.Modules.Core.WorkspaceFolders)
local Gib = require(script.Gib)
local LimbDestruction = require(script.LimbDestruction)

type JanitorClass = {
	GiveChore: (self: JanitorClass, chore: any, ...any) -> (any),
	Clean: (self: JanitorClass) -> (),
	Destroy: (self: JanitorClass) -> (),
}

export type LimbProfile = {
	bloodColor: Color3?,
	bloodAmount: number?,
	arcHeight: number?,
	travelTime: number?,
	restDistance: NumberRange?,
}

export type GoreConfig = {
	entity: Model?,
	model: Model?,
	parent: Instance?,
	raycastFilter: { Instance }?,
	bloodColor: Color3?,
	bloodSettings: { [string]: any }?,
	gibLifetime: number?,
	gibArcHeight: number?,
	gibTravelTime: number?,
	gibRestDistance: NumberRange?,
	bloodBurstAmount: number?,
	limbProfiles: { [string]: LimbProfile }?,
	limbDestruction: LimbDestruction.LimbDestructionConfig?,
}

export type DestroyLimbOptions = {
	bloodColor: Color3?,
	bloodAmount: number?,
	arcHeight: number?,
	travelTime: number?,
	restDistance: NumberRange?,
	restPosition: Vector3?,
	spawnGib: boolean?,
}

export type DestroyLimbResult = {
	limbName: string,
	limb: BasePart,
	gib: Gib.Gib?,
	bloodColor: Color3,
}

local Gore = {}
Gore.__index = Gore

export type Gore = typeof(setmetatable(
	{} :: {
		janitor: JanitorClass,
		random: Random,
		entityModel: Model?,
		runtimeFolder: Folder,
		raycastParams: RaycastParams,
		limbProfiles: { [string]: LimbProfile },
		bloodColor: Color3,
		bloodBurstAmount: number,
		gibLifetime: number,
		gibArcHeight: number,
		gibTravelTime: number,
		gibRestDistance: NumberRange,
		cleanupDelaySeconds: number,
		bloodEngine: any?,
		limbDestruction: LimbDestruction.LimbDestruction,
		activeGibs: { [Gib.Gib]: true },
		isDestroyed: boolean,
	},
	Gore
))

local DEFAULT_BLOOD_COLOR = Color3.fromRGB(105, 0, 0)
local DEFAULT_BLOOD_BURST_AMOUNT = 16
local DEFAULT_GIB_LIFETIME = 10
local DEFAULT_GIB_ARC_HEIGHT = 5.5
local DEFAULT_GIB_TRAVEL_TIME = 0.48
local DEFAULT_GIB_REST_DISTANCE = NumberRange.new(2.5, 6.5)
local DEFAULT_BLOOD_DECAY_DELAY_SECONDS = 15
local DEFAULT_BLOOD_DECAY_TWEEN_SECONDS = 1
local DEFAULT_CLEANUP_BUFFER_SECONDS = 0.5
local MAX_DESTROY_DRAIN_WAIT_SECONDS = 5

local function sanitizeNumber(valueRaw: any, fallback: number, minimum: number?, maximum: number?): number
	local value = fallback
	if typeof(valueRaw) == "number" and valueRaw == valueRaw then
		value = valueRaw
	end
	if minimum ~= nil and value < minimum then
		value = minimum
	end
	if maximum ~= nil and value > maximum then
		value = maximum
	end
	return value
end

local function sanitizeColor(valueRaw: any, fallback: Color3): Color3
	if typeof(valueRaw) == "Color3" then
		return valueRaw
	end
	return fallback
end

local function sanitizeRange(valueRaw: any, fallback: NumberRange): NumberRange
	if typeof(valueRaw) == "NumberRange" then
		local minimum = math.min(valueRaw.Min, valueRaw.Max)
		local maximum = math.max(valueRaw.Min, valueRaw.Max)
		return NumberRange.new(minimum, maximum)
	end
	return fallback
end

local function getRangeMaximum(valueRaw: any, fallback: number): number
	if typeof(valueRaw) == "NumberRange" then
		return math.max(valueRaw.Min, valueRaw.Max)
	end
	return fallback
end

local function getTweenDuration(valueRaw: any, fallback: number): number
	if typeof(valueRaw) == "TweenInfo" then
		return math.max(0, valueRaw.Time)
	end
	return fallback
end

local function normalizeToken(valueRaw: any): string
	if typeof(valueRaw) ~= "string" then
		return ""
	end
	return string.lower(string.gsub(string.match(valueRaw, "^%s*(.-)%s*$") or "", "[%s_%-%.]", ""))
end

local function ensureFolder(parent: Instance, name: string): Folder
	local existing = parent:FindFirstChild(name)
	if existing ~= nil and existing:IsA("Folder") then
		return existing
	end

	local folder = Instance.new("Folder")
	folder.Name = name
	folder.Parent = parent
	return folder
end

local function resolveEntityModel(config: GoreConfig?): Model?
	if config == nil then
		return nil
	end
	if config.model ~= nil then
		return config.model
	end
	if config.entity ~= nil then
		return config.entity
	end
	return nil
end

local function cloneDictionary(sourceRaw: any): { [string]: any }
	if typeof(sourceRaw) ~= "table" then
		return {}
	end
	local cloned = {}
	for key, value in sourceRaw do
		if typeof(key) == "string" then
			cloned[key] = value
		end
	end
	return cloned
end

local function resolveRaycastFilter(config: GoreConfig?, entityModel: Model?, runtimeFolder: Folder): { Instance }
	local filter = { runtimeFolder } :: { Instance }
	if entityModel ~= nil then
		table.insert(filter, entityModel)
	end

	if config ~= nil and typeof(config.raycastFilter) == "table" then
		for _, item in config.raycastFilter do
			if typeof(item) == "Instance" then
				table.insert(filter, item)
			end
		end
	end

	return filter
end

local function buildRaycastParams(filter: { Instance }): RaycastParams
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = filter
	params.IgnoreWater = false
	return params
end

local function resolveCleanupDelaySeconds(
	bloodSettingsRaw: any,
	gibTravelTime: number,
	gibLifetime: number
): number
	local bloodSettings = if typeof(bloodSettingsRaw) == "table" then bloodSettingsRaw else {}
	local tweens = if typeof(bloodSettings.Tweens) == "table" then bloodSettings.Tweens else nil
	local decayDelaySeconds = getRangeMaximum(bloodSettings.DecayDelay, DEFAULT_BLOOD_DECAY_DELAY_SECONDS)
	local decayTweenSeconds =
		getTweenDuration(if tweens ~= nil then tweens.Decay else nil, DEFAULT_BLOOD_DECAY_TWEEN_SECONDS)
	local bloodCleanupSeconds = decayDelaySeconds + decayTweenSeconds + DEFAULT_CLEANUP_BUFFER_SECONDS
	local gibCleanupSeconds = gibTravelTime + gibLifetime + DEFAULT_CLEANUP_BUFFER_SECONDS

	return math.max(bloodCleanupSeconds, gibCleanupSeconds)
end

function Gore._resolveBloodColor(self: Gore, limb: BasePart, optionsRaw: any, profileRaw: LimbProfile?): Color3
	local options = if typeof(optionsRaw) == "table" then optionsRaw else {}
	local profile = if typeof(profileRaw) == "table" then profileRaw else nil

	if typeof(options.bloodColor) == "Color3" then
		return options.bloodColor
	end
	if profile ~= nil and typeof(profile.bloodColor) == "Color3" then
		return profile.bloodColor
	end

	local limbAttribute = limb:GetAttribute("BloodColor")
	if typeof(limbAttribute) == "Color3" then
		return limbAttribute
	end

	return limb.Color
end

function Gore._resolveLimbProfile(self: Gore, limbNameRaw: any): LimbProfile?
	local token = normalizeToken(limbNameRaw)
	if token == "" then
		return nil
	end
	return self.limbProfiles[token]
end

function Gore._resolveGibRestPosition(self: Gore, originCFrame: CFrame, sourcePart: BasePart): Vector3
	local origin = originCFrame.Position
	local horizontalDirection = Vector3.new(self.random:NextNumber(-1, 1), 0, self.random:NextNumber(-1, 1))
	if horizontalDirection.Magnitude <= 1e-4 then
		horizontalDirection = Vector3.new(0, 0, 1)
	end

	if self.entityModel ~= nil then
		local entityCenter = self.entityModel:GetPivot().Position
		local outward = origin - entityCenter
		outward = Vector3.new(outward.X, 0, outward.Z)
		if outward.Magnitude > 0.1 then
			horizontalDirection = outward.Unit
		end
	end

	local distance = self.random:NextNumber(self.gibRestDistance.Min, self.gibRestDistance.Max)
	local candidate = origin + horizontalDirection.Unit * distance
	local jitter = Vector3.new(self.random:NextNumber(-0.8, 0.8), 0, self.random:NextNumber(-0.8, 0.8))
	candidate += jitter

	local castOrigin = candidate + Vector3.new(0, 40, 0)
	local castDirection = Vector3.new(0, -120, 0)
	local raycastResult = Workspace:Raycast(castOrigin, castDirection, self.raycastParams)
	if raycastResult ~= nil then
		local restY = raycastResult.Position.Y + sourcePart.Size.Y * 0.5
		return Vector3.new(candidate.X, restY, candidate.Z)
	end

	return Vector3.new(candidate.X, origin.Y, candidate.Z)
end

function Gore._trackGib(self: Gore, gib: Gib.Gib)
	self.activeGibs[gib] = true
	local timeToCleanup = self.gibTravelTime + self.gibLifetime + 1
	task.delay(timeToCleanup, function()
		if self.isDestroyed then
			return
		end
		self.activeGibs[gib] = nil
	end)
end

function Gore.New(configRaw: GoreConfig?): Gore
	local config = if typeof(configRaw) == "table" then (configRaw :: GoreConfig) else nil
	local entityModel = resolveEntityModel(config)
	local rootParent = if config ~= nil and typeof(config.parent) == "Instance"
		then config.parent
		else WorkspaceFolders.getOrCreateGameFolder()
	local rootFolder = ensureFolder(rootParent, "GoreRuntime")
	local runtimeFolder = Instance.new("Folder")
	runtimeFolder.Name = if entityModel ~= nil then ("Gore_" .. entityModel.Name) else "Gore_Entity"
	runtimeFolder.Parent = rootFolder

	local raycastFilter = resolveRaycastFilter(config, entityModel, runtimeFolder)
	local raycastParams = buildRaycastParams(raycastFilter)

	local self = setmetatable({
		janitor = Janitor.new(),
		random = Random.new(),
		entityModel = entityModel,
		runtimeFolder = runtimeFolder,
		raycastParams = raycastParams,
		limbProfiles = {} :: { [string]: LimbProfile },
		bloodColor = sanitizeColor(config and config.bloodColor, DEFAULT_BLOOD_COLOR),
		bloodBurstAmount = sanitizeNumber(config and config.bloodBurstAmount, DEFAULT_BLOOD_BURST_AMOUNT, 1, 200),
		gibLifetime = sanitizeNumber(config and config.gibLifetime, DEFAULT_GIB_LIFETIME, 0.05, 120),
		gibArcHeight = sanitizeNumber(config and config.gibArcHeight, DEFAULT_GIB_ARC_HEIGHT, 0, 200),
		gibTravelTime = sanitizeNumber(config and config.gibTravelTime, DEFAULT_GIB_TRAVEL_TIME, 0.1, 12),
		gibRestDistance = sanitizeRange(config and config.gibRestDistance, DEFAULT_GIB_REST_DISTANCE),
		cleanupDelaySeconds = 0,
		bloodEngine = nil,
		limbDestruction = LimbDestruction.new({
			model = entityModel,
			destroyedTransparency = 1,
		}),
		activeGibs = {} :: { [Gib.Gib]: true },
		isDestroyed = false,
	}, Gore)

	if config ~= nil and typeof(config.limbProfiles) == "table" then
		for limbName, profile in config.limbProfiles do
			if typeof(limbName) == "string" and typeof(profile) == "table" then
				self.limbProfiles[normalizeToken(limbName)] = profile
			end
		end
	end

	if config ~= nil and typeof(config.limbDestruction) == "table" then
		self.limbDestruction:destroy()
		local limbConfig = cloneDictionary(config.limbDestruction)
		limbConfig.model = entityModel
		self.limbDestruction = LimbDestruction.new(limbConfig)
	end

	local bloodSettings = {
		FolderName = runtimeFolder.Name .. "_Blood",
		DropletColor = self.bloodColor,
		Filter = raycastFilter,
	} :: { [string]: any }
	if config ~= nil and typeof(config.bloodSettings) == "table" then
		for key, value in config.bloodSettings do
			if typeof(key) == "string" then
				bloodSettings[key] = value
			end
		end
	end
	if typeof(bloodSettings.Filter) ~= "table" then
		bloodSettings.Filter = raycastFilter
	end
	self.cleanupDelaySeconds = resolveCleanupDelaySeconds(bloodSettings, self.gibTravelTime, self.gibLifetime)

	local ok, engineOrError = pcall(function()
		return BloodEngine(bloodSettings)
	end)
	if ok then
		self.bloodEngine = engineOrError
	else
	end

	self.janitor:GiveChore(function()
		for gib in self.activeGibs do
			gib:destroy()
		end
		table.clear(self.activeGibs)
	end)
	self.janitor:GiveChore(function()
		self.limbDestruction:destroy()
	end)
	self.janitor:GiveChore(function()
		if self.bloodEngine ~= nil and typeof(self.bloodEngine.Destroy) == "function" then
			self.bloodEngine:Destroy()
		end
	end)
	self.janitor:GiveChore(function()
		if self.runtimeFolder.Parent ~= nil then
			self.runtimeFolder:Destroy()
		end
	end)

	return self
end

function Gore.SetBloodColor(self: Gore, bloodColorRaw: any)
	local nextColor = sanitizeColor(bloodColorRaw, self.bloodColor)
	self.bloodColor = nextColor
	if self.bloodEngine ~= nil and typeof(self.bloodEngine.UpdateSettings) == "function" then
		self.bloodEngine:UpdateSettings({ DropletColor = nextColor })
	end
end

function Gore.GetBloodColor(self: Gore): Color3
	return self.bloodColor
end

function Gore.EmitBlood(self: Gore, originRaw: any, directionRaw: any?, amountRaw: any?, settingsRaw: any?): boolean
	if self.isDestroyed or self.bloodEngine == nil then
		return false
	end

	local origin = originRaw
	if typeof(originRaw) ~= "Vector3" and (typeof(originRaw) ~= "Instance" or not originRaw:IsA("BasePart")) then
		return false
	end

	local amount = sanitizeNumber(amountRaw, 1, 1, 200)
	local direction = if typeof(directionRaw) == "Vector3" then directionRaw else nil
	local settings = cloneDictionary(settingsRaw)
	if typeof(settings.DropletColor) ~= "Color3" then
		settings.DropletColor = self.bloodColor
	end

	if amount <= 1 then
		self.bloodEngine:Emit(origin, direction, settings)
		return true
	end

	self.bloodEngine:EmitAmount(origin, direction, amount, settings)
	return true
end

function Gore.SpawnGib(self: Gore, sourceRaw: any, optionsRaw: any?): Gib.Gib?
	if self.isDestroyed then
		return nil
	end

	local sourcePart = nil :: BasePart?
	if typeof(sourceRaw) == "Instance" and sourceRaw:IsA("BasePart") then
		sourcePart = sourceRaw
	end
	if sourcePart == nil then
		return nil
	end

	local options = if typeof(optionsRaw) == "table" then optionsRaw else {}
	local originCFrame = if typeof(options.originCFrame) == "CFrame" then options.originCFrame else sourcePart.CFrame
	local restPosition = options.restPosition
	if typeof(restPosition) ~= "Vector3" then
		restPosition = self:_resolveGibRestPosition(originCFrame, sourcePart)
	end

	local gib = Gib.new({
		source = sourcePart,
		parent = self.runtimeFolder,
		originCFrame = originCFrame,
		restPosition = restPosition,
		raycastParams = self.raycastParams,
		arcHeight = sanitizeNumber(options.arcHeight, self.gibArcHeight, 0, 200),
		travelTime = sanitizeNumber(options.travelTime, self.gibTravelTime, 0.1, 12),
		lifetime = sanitizeNumber(options.lifetime, self.gibLifetime, 0.05, 120),
		restDistance = sanitizeRange(options.restDistance, self.gibRestDistance),
		canCollide = true,
		canTouch = false,
		canQuery = false,
		anchoredAtRest = true,
	})
	gib:play()
	self:_trackGib(gib)
	return gib
end

function Gore.DestroyLimb(self: Gore, limbRaw: any, optionsRaw: DestroyLimbOptions?): DestroyLimbResult?
	if self.isDestroyed then
		return nil
	end

	local options = if typeof(optionsRaw) == "table" then optionsRaw else ({} :: DestroyLimbOptions)
	local destroyResult = self.limbDestruction:destroyLimb(limbRaw, options)
	if destroyResult == nil then
		return nil
	end

	local limbProfile = self:_resolveLimbProfile(destroyResult.limbName)
	local bloodColor = self:_resolveBloodColor(destroyResult.limb, options, limbProfile)
	local bloodAmountDefault = if limbProfile ~= nil
		then sanitizeNumber(limbProfile.bloodAmount, self.bloodBurstAmount, 1, 200)
		else self.bloodBurstAmount
	local bloodAmount = sanitizeNumber(options.bloodAmount, bloodAmountDefault, 1, 200)

	self:emitBlood(destroyResult.originPosition, nil, bloodAmount, { DropletColor = bloodColor })

	local gib: Gib.Gib? = nil
	if options.spawnGib ~= false then
		local arcHeightDefault = if limbProfile ~= nil then limbProfile.arcHeight else self.gibArcHeight
		local travelTimeDefault = if limbProfile ~= nil then limbProfile.travelTime else self.gibTravelTime
		local restDistanceDefault = if limbProfile ~= nil and limbProfile.restDistance ~= nil
			then limbProfile.restDistance
			else self.gibRestDistance
		gib = self:spawnGib(destroyResult.gibSource, {
			originCFrame = destroyResult.originCFrame,
			restPosition = options.restPosition,
			arcHeight = sanitizeNumber(options.arcHeight, arcHeightDefault, 0, 200),
			travelTime = sanitizeNumber(options.travelTime, travelTimeDefault, 0.1, 12),
			restDistance = sanitizeRange(options.restDistance, restDistanceDefault),
		})
	else
		destroyResult.gibSource:Destroy()
	end

	return {
		limbName = destroyResult.limbName,
		limb = destroyResult.limb,
		gib = gib,
		bloodColor = bloodColor,
	}
end

function Gore.RestoreLimb(self: Gore, limbRaw: any): boolean
	return self.limbDestruction:restoreLimb(limbRaw)
end

function Gore.RestoreAllLimbs(self: Gore)
	self.limbDestruction:restoreAll()
end

function Gore._countActiveBloodDroplets(self: Gore): number
	local bloodEngine = self.bloodEngine
	if typeof(bloodEngine) ~= "table" then
		return 0
	end

	local activeEngine = (bloodEngine :: any).ActiveEngine
	if typeof(activeEngine) ~= "table" then
		return 0
	end

	local cache = activeEngine.Cache
	if typeof(cache) ~= "table" or typeof(cache.InUse) ~= "table" then
		return 0
	end

	return #cache.InUse
end

function Gore.Destroy(self: Gore)
	if self.isDestroyed then
		return
	end
	self.isDestroyed = true

	local janitor = self.janitor
	local cleanupDelaySeconds = self.cleanupDelaySeconds
	task.spawn(function()
		local cleanupReadyAt = os.clock() + cleanupDelaySeconds
		local cleanupDeadlineAt = cleanupReadyAt + MAX_DESTROY_DRAIN_WAIT_SECONDS

		while os.clock() < cleanupDeadlineAt do
			if os.clock() >= cleanupReadyAt and self:_countActiveBloodDroplets() <= 0 then
				break
			end
			task.wait(0.25)
		end

		janitor:Destroy()
	end)
end

Gore.new = Gore.New
Gore.setBloodColor = Gore.SetBloodColor
Gore.getBloodColor = Gore.GetBloodColor
Gore.emitBlood = Gore.EmitBlood
Gore.spawnGib = Gore.SpawnGib
Gore.destroyLimb = Gore.DestroyLimb
Gore.restoreLimb = Gore.RestoreLimb
Gore.restoreAllLimbs = Gore.RestoreAllLimbs
Gore.destroy = Gore.Destroy

return Gore
]]></string>
              </Properties>
              <Item class="ModuleScript" referent="1119">
                <Properties>
                  <string name="Name">Gib</string>
                  <string name="Source"><![CDATA[--!strict
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Janitor = require(ReplicatedStorage.Packages.Janitor)
local Curve = require(script:FindFirstAncestor("game").Shared.Modules.Math.Curve)
local Ease = require(script:FindFirstAncestor("game").Shared.Modules.Math.Ease)
local Vec = require(script:FindFirstAncestor("game").Shared.Modules.Math.Vec)

local Gib = {}
Gib.__index = Gib

export type GibConfig = {
	source: BasePart?,
	part: BasePart?,
	parent: Instance?,
	originCFrame: CFrame?,
	restCFrame: CFrame?,
	restPosition: Vector3?,
	raycastParams: RaycastParams?,
	arcHeight: number?,
	travelTime: number?,
	lifetime: number?,
	rotationVelocity: Vector3?,
	restDistance: NumberRange?,
	anchoredAtRest: boolean?,
	canCollide: boolean?,
	canTouch: boolean?,
	canQuery: boolean?,
}

type JanitorClass = {
	GiveChore: (self: JanitorClass, chore: any, ...any) -> (any),
	Clean: (self: JanitorClass) -> (),
	Destroy: (self: JanitorClass) -> (),
}

export type Gib = typeof(setmetatable(
	{} :: {
		janitor: JanitorClass,
		random: Random,
		part: BasePart,
		startCFrame: CFrame,
		restCFrame: CFrame,
		raycastParams: RaycastParams?,
		controlPoint: Vector3,
		rotationVelocity: Vector3,
		travelTime: number,
		lifetime: number,
		restDistance: NumberRange,
		anchoredAtRest: boolean,
		elapsed: number,
		isPlaying: boolean,
		isLanded: boolean,
		isDestroyed: boolean,
		motionConnection: RBXScriptConnection?,
	},
	Gib
))

local DEFAULT_TRAVEL_TIME = 0.48
local DEFAULT_ARC_HEIGHT = 5.5
local DEFAULT_LIFETIME = 10
local DEFAULT_REST_DISTANCE = NumberRange.new(2, 6)
local DEFAULT_ROTATION_VELOCITY = Vector3.new(math.pi * 1.2, math.pi * 0.75, math.pi * 1.6)

local function sanitizeNumber(valueRaw: any, fallback: number, minimum: number?, maximum: number?): number
	local value = fallback
	if typeof(valueRaw) == "number" and valueRaw == valueRaw then
		value = valueRaw
	end
	if minimum ~= nil and value < minimum then
		value = minimum
	end
	if maximum ~= nil and value > maximum then
		value = maximum
	end
	return value
end

local function sanitizeBoolean(valueRaw: any, fallback: boolean): boolean
	if typeof(valueRaw) == "boolean" then
		return valueRaw
	end
	return fallback
end

local function sanitizeVector3(valueRaw: any, fallback: Vector3): Vector3
	if typeof(valueRaw) == "Vector3" then
		return valueRaw
	end
	return fallback
end

local function sanitizeRestRange(rangeRaw: any, fallback: NumberRange): NumberRange
	if typeof(rangeRaw) == "NumberRange" then
		local minimum = math.min(rangeRaw.Min, rangeRaw.Max)
		local maximum = math.max(rangeRaw.Min, rangeRaw.Max)
		return NumberRange.new(minimum, maximum)
	end
	return fallback
end

local function ensurePartSource(config: GibConfig): BasePart
	local source = config.source
	if source == nil then
		source = config.part
	end
	if source ~= nil then
		return source
	end

	local fallback = Instance.new("Part")
	fallback.Name = "GibSource"
	fallback.Size = Vector3.new(1, 1, 1)
	fallback.Material = Enum.Material.SmoothPlastic
	fallback.Color = Color3.fromRGB(117, 0, 0)
	fallback.CanCollide = true
	return fallback
end

local function clearConstraintsAndJoints(part: BasePart)
	for _, descendant in part:GetDescendants() do
		if descendant:IsA("Constraint") or descendant:IsA("JointInstance") or descendant:IsA("BaseScript") then
			descendant:Destroy()
		end
	end
end

local function quadraticBezier(a: Vector3, b: Vector3, c: Vector3, t: number): Vector3
	return Curve.quadratic(a, b, c, t)
end

local function quadraticTangent(a: Vector3, b: Vector3, c: Vector3, t: number): Vector3
	return Curve.quadraticTangent(a, b, c, t)
end

local function easeInOutSine(alpha: number): number
	return Ease.inOutSine(alpha)
end

local function randomUnitVector2D(randomObject: Random): Vector3
	local angle = randomObject:NextNumber(0, math.pi * 2)
	return Vector3.new(math.cos(angle), 0, math.sin(angle))
end

local function resolveRestPosition(self: Gib, startCFrame: CFrame): Vector3
	local distance = self.random:NextNumber(self.restDistance.Min, self.restDistance.Max)
	local direction = randomUnitVector2D(self.random)
	local planarOffset = direction * distance
	local candidate = startCFrame.Position + planarOffset

	local raycastParams = self.raycastParams
	if raycastParams ~= nil then
		local castOrigin = candidate + Vector3.new(0, 40, 0)
		local castDirection = Vector3.new(0, -120, 0)
		local raycast = Workspace:Raycast(castOrigin, castDirection, raycastParams)
		if raycast ~= nil then
			local y = raycast.Position.Y + self.part.Size.Y * 0.5
			return Vector3.new(candidate.X, y, candidate.Z)
		end
	end

	return Vector3.new(candidate.X, startCFrame.Position.Y, candidate.Z)
end

function Gib.New(configRaw: GibConfig?): Gib
	local config = if typeof(configRaw) == "table" then (configRaw :: GibConfig) else ({} :: GibConfig)
	local source = ensurePartSource(config)
	local clone = source:Clone()
	clearConstraintsAndJoints(clone)
	clone.Name = (source.Name ~= "" and source.Name or "GibSource") .. "_Runtime"

	local startCFrame = if typeof(config.originCFrame) == "CFrame" then config.originCFrame else source.CFrame
	local restCFrame = config.restCFrame
	local parent = if typeof(config.parent) == "Instance" then config.parent else Workspace

	local self = setmetatable({
		janitor = Janitor.new(),
		random = Random.new(),
		part = clone,
		startCFrame = startCFrame,
		restCFrame = if typeof(restCFrame) == "CFrame" then restCFrame else CFrame.new(),
		raycastParams = config.raycastParams,
		controlPoint = Vector3.zero,
		rotationVelocity = sanitizeVector3(config.rotationVelocity, DEFAULT_ROTATION_VELOCITY),
		travelTime = sanitizeNumber(config.travelTime, DEFAULT_TRAVEL_TIME, 0.1, 12),
		lifetime = sanitizeNumber(config.lifetime, DEFAULT_LIFETIME, 0.05, 120),
		restDistance = sanitizeRestRange(config.restDistance, DEFAULT_REST_DISTANCE),
		anchoredAtRest = sanitizeBoolean(config.anchoredAtRest, true),
		elapsed = 0,
		isPlaying = false,
		isLanded = false,
		isDestroyed = false,
		motionConnection = nil,
	}, Gib)

	clone.Anchored = true
	clone.CanCollide = sanitizeBoolean(config.canCollide, true)
	clone.CanTouch = sanitizeBoolean(config.canTouch, false)
	clone.CanQuery = sanitizeBoolean(config.canQuery, false)
	clone.CFrame = startCFrame
	clone.AssemblyLinearVelocity = Vector3.zero
	clone.AssemblyAngularVelocity = Vector3.zero

	local restPosition = config.restPosition
	if typeof(restPosition) ~= "Vector3" then
		restPosition = resolveRestPosition(self, startCFrame)
	end

	local randomYaw = self.random:NextNumber(-math.pi, math.pi)
	local defaultRestRotation = CFrame.Angles(0, randomYaw, 0)
	if typeof(restCFrame) == "CFrame" then
		self.restCFrame = restCFrame
	else
		self.restCFrame = CFrame.new(restPosition) * defaultRestRotation
	end

	local arcHeight = sanitizeNumber(config.arcHeight, DEFAULT_ARC_HEIGHT, 0, 200)
	local midpoint = (self.startCFrame.Position + self.restCFrame.Position) * 0.5
	self.controlPoint = midpoint + Vector3.new(0, arcHeight, 0)

	clone.Parent = parent
	self.janitor:GiveChore(function()
		if clone.Parent ~= nil then
			clone:Destroy()
		end
	end)

	return self
end

function Gib._step(self: Gib, dt: number)
	if self.isDestroyed or self.isLanded then
		return
	end

	self.elapsed += dt
	local alpha = math.clamp(self.elapsed / self.travelTime, 0, 1)
	local eased = easeInOutSine(alpha)

	local startPosition = self.startCFrame.Position
	local restPosition = self.restCFrame.Position
	local position = quadraticBezier(startPosition, self.controlPoint, restPosition, eased)
	local tangent = quadraticTangent(startPosition, self.controlPoint, restPosition, eased)
	if tangent.Magnitude <= 1e-4 then
		tangent = restPosition - startPosition
	end

	local spin = self.rotationVelocity * (self.elapsed / self.travelTime)
	local cframe = CFrame.lookAt(position, position + Vec.unit(tangent, Vector3.new(0, 0, -1)), Vector3.yAxis)
	self.part.CFrame = cframe * CFrame.Angles(spin.X, spin.Y, spin.Z)

	if alpha >= 1 then
		self:land()
	end
end

function Gib.Play(self: Gib): Gib
	if self.isDestroyed or self.isPlaying then
		return self
	end

	self.isPlaying = true
	self.motionConnection = RunService.Heartbeat:Connect(function(dt: number)
		self:_step(dt)
	end)
	self.janitor:GiveChore(self.motionConnection)

	return self
end

function Gib.Land(self: Gib)
	if self.isDestroyed or self.isLanded then
		return
	end

	self.isLanded = true
	self.isPlaying = false
	if self.motionConnection ~= nil then
		self.motionConnection:Disconnect()
		self.motionConnection = nil
	end

	self.part.CFrame = self.restCFrame
	self.part.AssemblyLinearVelocity = Vector3.zero
	self.part.AssemblyAngularVelocity = Vector3.zero
	self.part.Anchored = self.anchoredAtRest

	local snapshot = self
	task.delay(self.lifetime, function()
		if snapshot.isDestroyed then
			return
		end
		snapshot:destroy()
	end)
end

function Gib.Destroy(self: Gib)
	if self.isDestroyed then
		return
	end
	self.isDestroyed = true
	self.isPlaying = false
	self.motionConnection = nil
	self.janitor:Destroy()
end

Gib.new = Gib.New
Gib.play = Gib.Play
Gib.land = Gib.Land
Gib.destroy = Gib.Destroy

return Gib
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="1120">
                <Properties>
                  <string name="Name">LimbDestruction</string>
                  <string name="Source"><![CDATA[--!strict
local LimbDestruction = {}
LimbDestruction.__index = LimbDestruction

export type LimbDestructionConfig = {
	entity: Model?,
	model: Model?,
	destroyedTransparency: number?,
}

export type DestroyResult = {
	limb: BasePart,
	limbName: string,
	originCFrame: CFrame,
	originPosition: Vector3,
	gibSource: BasePart,
	bloodColor: Color3,
}

type MotorStateMap = { [Motor6D]: boolean }

type DestroyedLimbRecord = {
	part: BasePart,
	transparency: number,
	canCollide: boolean,
	canTouch: boolean,
	canQuery: boolean,
	massless: boolean,
	motorStates: MotorStateMap,
}

export type LimbDestruction = typeof(setmetatable(
	{} :: {
		entityModel: Model?,
		destroyedTransparency: number,
		destroyedByPart: { [BasePart]: DestroyedLimbRecord },
	},
	LimbDestruction
))

local function sanitizeNumber(valueRaw: any, fallback: number, minimum: number?, maximum: number?): number
	local value = fallback
	if typeof(valueRaw) == "number" and valueRaw == valueRaw then
		value = valueRaw
	end
	if minimum ~= nil and value < minimum then
		value = minimum
	end
	if maximum ~= nil and value > maximum then
		value = maximum
	end
	return value
end

local function normalizeToken(valueRaw: any): string
	if typeof(valueRaw) ~= "string" then
		return ""
	end
	return string.lower(string.gsub(string.match(valueRaw, "^%s*(.-)%s*$") or "", "[%s_%-%.]", ""))
end

local function resolveEntityModel(configRaw: LimbDestructionConfig?): Model?
	if configRaw == nil then
		return nil
	end

	local model = configRaw.model
	if model ~= nil then
		return model
	end

	local entity = configRaw.entity
	if entity ~= nil then
		return entity
	end

	return nil
end

local function cloneLimbForGib(limb: BasePart): BasePart
	local clone = limb:Clone()
	clone.Name = limb.Name .. "_Gib"
	clone.Anchored = true
	clone.AssemblyLinearVelocity = Vector3.zero
	clone.AssemblyAngularVelocity = Vector3.zero

	for _, descendant in clone:GetDescendants() do
		if descendant:IsA("JointInstance") or descendant:IsA("Constraint") or descendant:IsA("BaseScript") then
			descendant:Destroy()
		end
	end

	return clone
end

local function resolveLimbFromString(entityModel: Model?, tokenRaw: string): BasePart?
	if entityModel == nil then
		return nil
	end

	local token = normalizeToken(tokenRaw)
	if token == "" then
		return nil
	end

	for _, descendant in entityModel:GetDescendants() do
		if descendant:IsA("BasePart") and normalizeToken(descendant.Name) == token then
			return descendant
		end
	end

	return nil
end

local function resolveBloodColor(limb: BasePart, fallbackRaw: any): Color3
	if typeof(fallbackRaw) == "Color3" then
		return fallbackRaw
	end

	local attributeValue = limb:GetAttribute("BloodColor")
	if typeof(attributeValue) == "Color3" then
		return attributeValue
	end

	return limb.Color
end

function LimbDestruction.New(configRaw: LimbDestructionConfig?): LimbDestruction
	local config = if typeof(configRaw) == "table" then configRaw else nil
	local self = setmetatable({
		entityModel = resolveEntityModel(config),
		destroyedTransparency = sanitizeNumber(config and config.destroyedTransparency, 1, 0, 1),
		destroyedByPart = {} :: { [BasePart]: DestroyedLimbRecord },
	}, LimbDestruction)

	return self
end

function LimbDestruction.SetEntityModel(self: LimbDestruction, modelRaw: any)
	if typeof(modelRaw) == "Instance" and modelRaw:IsA("Model") then
		self.entityModel = modelRaw
		return
	end
	self.entityModel = nil
end

function LimbDestruction.ResolveLimb(self: LimbDestruction, limbRaw: any): BasePart?
	if typeof(limbRaw) == "Instance" and limbRaw:IsA("BasePart") then
		local model = self.entityModel
		if model == nil then
			return limbRaw
		end
		if limbRaw:IsDescendantOf(model) then
			return limbRaw
		end
		return nil
	end

	if typeof(limbRaw) == "string" then
		return resolveLimbFromString(self.entityModel, limbRaw)
	end

	return nil
end

function LimbDestruction.IsDestroyed(self: LimbDestruction, limbRaw: any): boolean
	local limb = self:resolveLimb(limbRaw)
	if limb == nil then
		return false
	end
	return self.destroyedByPart[limb] ~= nil
end

function LimbDestruction._disableLimbMotors(self: LimbDestruction, limb: BasePart): MotorStateMap
	local motorStates = {} :: MotorStateMap
	local model = self.entityModel
	if model == nil then
		return motorStates
	end

	for _, descendant in model:GetDescendants() do
		if not descendant:IsA("Motor6D") then
			continue
		end
		if descendant.Part0 ~= limb and descendant.Part1 ~= limb then
			continue
		end

		motorStates[descendant] = descendant.Enabled
		descendant.Enabled = false
	end

	return motorStates
end

function LimbDestruction.DestroyLimb(self: LimbDestruction, limbRaw: any, optionsRaw: any): DestroyResult?
	local limb = self:resolveLimb(limbRaw)
	if limb == nil then
		return nil
	end
	if self.destroyedByPart[limb] ~= nil then
		return nil
	end

	local options = if typeof(optionsRaw) == "table" then optionsRaw else {}
	local destroyedTransparency = sanitizeNumber(options.destroyedTransparency, self.destroyedTransparency, 0, 1)
	local record: DestroyedLimbRecord = {
		part = limb,
		transparency = limb.Transparency,
		canCollide = limb.CanCollide,
		canTouch = limb.CanTouch,
		canQuery = limb.CanQuery,
		massless = limb.Massless,
		motorStates = self:_disableLimbMotors(limb),
	}
	self.destroyedByPart[limb] = record

	limb.Transparency = destroyedTransparency
	limb.CanCollide = false
	limb.CanTouch = false
	limb.CanQuery = false
	limb.Massless = true

	local gibSource = cloneLimbForGib(limb)
	local bloodColor = resolveBloodColor(limb, options.bloodColor)
	return {
		limb = limb,
		limbName = limb.Name,
		originCFrame = limb.CFrame,
		originPosition = limb.Position,
		gibSource = gibSource,
		bloodColor = bloodColor,
	}
end

function LimbDestruction.RestoreLimb(self: LimbDestruction, limbRaw: any): boolean
	local limb = self:resolveLimb(limbRaw)
	if limb == nil then
		return false
	end

	local record = self.destroyedByPart[limb]
	if record == nil then
		return false
	end

	limb.Transparency = record.transparency
	limb.CanCollide = record.canCollide
	limb.CanTouch = record.canTouch
	limb.CanQuery = record.canQuery
	limb.Massless = record.massless

	for motor, wasEnabled in record.motorStates do
		if motor.Parent ~= nil then
			motor.Enabled = wasEnabled
		end
	end

	self.destroyedByPart[limb] = nil
	return true
end

function LimbDestruction.RestoreAll(self: LimbDestruction)
	for limb in self.destroyedByPart do
		self:restoreLimb(limb)
	end
end

function LimbDestruction.Destroy(self: LimbDestruction)
	self:restoreAll()
	table.clear(self.destroyedByPart)
	self.entityModel = nil
end

LimbDestruction.new = LimbDestruction.New
LimbDestruction.setEntityModel = LimbDestruction.SetEntityModel
LimbDestruction.resolveLimb = LimbDestruction.ResolveLimb
LimbDestruction.isDestroyed = LimbDestruction.IsDestroyed
LimbDestruction.destroyLimb = LimbDestruction.DestroyLimb
LimbDestruction.restoreLimb = LimbDestruction.RestoreLimb
LimbDestruction.restoreAll = LimbDestruction.RestoreAll
LimbDestruction.destroy = LimbDestruction.Destroy

return LimbDestruction
]]></string>
                </Properties>
              </Item>
            </Item>
            <Item class="ModuleScript" referent="1121">
              <Properties>
                <string name="Name">Magic</string>
                <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ItemRegistry = require(script:FindFirstAncestor("game").Shared.Modules.Items.Registry)
local Janitor = require(ReplicatedStorage.Packages.Janitor)
local ResolveToolInstance = require(script:FindFirstAncestor("game").Shared.Modules.Game.Format.ResolveToolInstance)
local Signal = require(ReplicatedStorage.Packages.Signal)

local Magic = {}
Magic.__index = Magic

export type MagicWeaponConfig = {
	itemId: string,
	itemType: string,
	displayName: string,
	description: string,
	damage: number,
	manaCost: number,
	cooldown: number,
	castTime: number,
	range: number,
	autoRepeatWhileHeld: boolean,
	allowQueueOnCooldown: boolean,
	projectile: { [string]: any }?,
	animations: { [string]: any }?,
	definition: { [string]: any },
}

export type MagicServiceAdapter = {
	canConsumeMana: ((
		self: MagicServiceAdapter,
		player: Player?,
		amount: number,
		context: { [string]: any }
	) -> boolean?)?,
	hasMana: ((self: MagicServiceAdapter, player: Player?, amount: number, context: { [string]: any }) -> boolean?)?,
	getMana: ((self: MagicServiceAdapter, player: Player?, context: { [string]: any }) -> number?)?,
	consumeMana: ((self: MagicServiceAdapter, player: Player?, amount: number, context: { [string]: any }) -> boolean?)?,
	spendMana: ((self: MagicServiceAdapter, player: Player?, amount: number, context: { [string]: any }) -> boolean?)?,
	onMagicCastRequested: ((self: MagicServiceAdapter, magic: any, context: { [string]: any }) -> boolean?)?,
	onMagicCastCommitted: ((self: MagicServiceAdapter, magic: any, context: { [string]: any }) -> ())?,
}

export type MagicCallbacks = {
	onCastRequested: ((self: Magic, context: { [string]: any }) -> ())?,
	onCastStarted: ((self: Magic, context: { [string]: any }) -> ())?,
	onCastCommitted: ((self: Magic, context: { [string]: any }) -> ())?,
	onCastFinished: ((self: Magic, context: { [string]: any }) -> ())?,
	onCastFailed: ((self: Magic, context: { [string]: any }) -> ())?,
	onWeaponChanged: ((self: Magic, context: { [string]: any }) -> ())?,
	onInputHeldChanged: ((self: Magic, inputHeld: boolean) -> ())?,
	onEnabledChanged: ((self: Magic, enabled: boolean) -> ())?,
}

export type MagicConfig = {
	tool: Tool?,
	character: Model?,
	ownerPlayer: Player?,
	service: MagicServiceAdapter?,
	callbacks: MagicCallbacks?,
	expectedItemType: string?,
	autoRepeatWhileHeld: boolean?,
	validateDefinitionItemType: boolean?,
	allowQueueOnCooldown: boolean?,
}

type SignalObject = {
	Connect: (self: SignalObject, callback: (...any) -> ()) -> RBXScriptConnection,
	Fire: (self: SignalObject, ...any) -> (),
	Destroy: (self: SignalObject) -> (),
}

type MagicSignals = {
	castRequested: SignalObject,
	castStarted: SignalObject,
	castCommitted: SignalObject,
	castFinished: SignalObject,
	castFailed: SignalObject,
	weaponChanged: SignalObject,
	inputHeldChanged: SignalObject,
	enabledChanged: SignalObject,
}

export type Magic = typeof(setmetatable(
	{} :: {
		janitor: any,
		toolJanitor: any,
		signals: MagicSignals,
		callbacks: MagicCallbacks,
		service: MagicServiceAdapter?,
		boundTool: Tool?,
		character: Model?,
		ownerPlayer: Player?,
		enabled: boolean,
		inputHeld: boolean,
		autoRepeatWhileHeld: boolean,
		allowQueueOnCooldown: boolean,
		validateDefinitionItemType: boolean,
		expectedItemType: string,
		expectedItemTypeToken: string,
		weaponConfig: MagicWeaponConfig?,
		resolvedItemId: string?,
		resolvedItemType: string?,
		queued: boolean,
		casting: boolean,
		cooldownUntil: number,
		retryToken: number,
		castToken: number,
		destroyed: boolean,
		lastError: string?,
	},
	Magic
))

local DEFAULT_EXPECTED_ITEM_TYPE = "magicWeapon"
local DEFAULT_DAMAGE = 12
local DEFAULT_MANA_COST = 8
local DEFAULT_COOLDOWN = 0.6
local DEFAULT_CAST_TIME = 0.15
local DEFAULT_RANGE = 35
local DEFAULT_AUTO_REPEAT = true
local DEFAULT_ALLOW_QUEUE_ON_COOLDOWN = true
local DEFAULT_VALIDATE_DEFINITION_ITEM_TYPE = true

local ATTACK_SPEED_TO_COOLDOWN = {
	["insanely fast"] = 0.18,
	["very fast"] = 0.24,
	["fast"] = 0.34,
	["normal speed"] = 0.48,
	["normal"] = 0.48,
	["slow"] = 0.66,
	["very slow"] = 0.86,
}

local cachedItemIdLookup: { [string]: string }? = nil
local cachedDefinitions: { [string]: any } = {}
local cachedWeaponConfigs: { [string]: MagicWeaponConfig | false } = {}

local function trim(valueRaw: any): string
	if typeof(valueRaw) ~= "string" then
		return ""
	end
	return string.match(valueRaw, "^%s*(.-)%s*$") or ""
end

local function sanitizeItemId(itemIdRaw: any): string?
	local itemId = trim(itemIdRaw)
	if itemId == "" then
		return nil
	end
	return itemId
end

local function sanitizeString(valueRaw: any, fallback: string): string
	local value = trim(valueRaw)
	if value == "" then
		return fallback
	end
	return value
end

local function sanitizeBoolean(valueRaw: any, fallback: boolean): boolean
	if typeof(valueRaw) == "boolean" then
		return valueRaw
	end
	return fallback
end

local function sanitizeNumber(valueRaw: any, fallback: number, minimum: number?, maximum: number?): number
	local value = fallback
	if typeof(valueRaw) == "number" and valueRaw == valueRaw then
		value = valueRaw
	elseif typeof(valueRaw) == "string" then
		local numericText = string.match(string.lower(valueRaw), "%-?%d+%.?%d*")
		if numericText ~= nil then
			local parsed = tonumber(numericText)
			if parsed ~= nil and parsed == parsed then
				value = parsed
			end
		end
	end

	if minimum ~= nil and value < minimum then
		value = minimum
	end
	if maximum ~= nil and value > maximum then
		value = maximum
	end
	return value
end

local function normalizeTypeToken(valueRaw: any): string
	local normalized = string.lower(trim(valueRaw))
	if normalized == "" then
		return ""
	end
	return string.gsub(normalized, "[%s_%-]+", "")
end

local function normalizeTypeLabel(valueRaw: any, fallback: string): string
	local value = trim(valueRaw)
	if value == "" then
		return fallback
	end
	return value
end

local function cloneWeaponConfig(config: MagicWeaponConfig): MagicWeaponConfig
	return {
		itemId = config.itemId,
		itemType = config.itemType,
		displayName = config.displayName,
		description = config.description,
		damage = config.damage,
		manaCost = config.manaCost,
		cooldown = config.cooldown,
		castTime = config.castTime,
		range = config.range,
		autoRepeatWhileHeld = config.autoRepeatWhileHeld,
		allowQueueOnCooldown = config.allowQueueOnCooldown,
		projectile = config.projectile,
		animations = config.animations,
		definition = config.definition,
	}
end

local function areWeaponConfigsEquivalent(lhsRaw: any, rhsRaw: any): boolean
	if lhsRaw == rhsRaw then
		return true
	end
	if typeof(lhsRaw) ~= "table" or typeof(rhsRaw) ~= "table" then
		return false
	end

	local lhs = lhsRaw :: MagicWeaponConfig
	local rhs = rhsRaw :: MagicWeaponConfig
	return lhs.itemId == rhs.itemId
		and lhs.itemType == rhs.itemType
		and lhs.damage == rhs.damage
		and lhs.manaCost == rhs.manaCost
		and lhs.cooldown == rhs.cooldown
		and lhs.castTime == rhs.castTime
		and lhs.range == rhs.range
		and lhs.autoRepeatWhileHeld == rhs.autoRepeatWhileHeld
		and lhs.allowQueueOnCooldown == rhs.allowQueueOnCooldown
end

local function resolveItemIdLookup(): { [string]: string }
	if cachedItemIdLookup ~= nil then
		return cachedItemIdLookup
	end

	cachedItemIdLookup = ItemRegistry.getItemIdLookup()
	return cachedItemIdLookup :: { [string]: string }
end

local function resolveCanonicalItemId(itemIdRaw: any): string?
	local itemId = sanitizeItemId(itemIdRaw)
	if itemId == nil then
		return nil
	end

	local lookup = resolveItemIdLookup()
	local canonical = lookup[itemId]
	if canonical == nil then
		canonical = lookup[string.lower(itemId)]
	end
	if canonical ~= nil then
		return canonical
	end

	return nil
end

local function getItemDefinition(itemIdRaw: any): { [string]: any }?
	local rawItemId = sanitizeItemId(itemIdRaw)
	if rawItemId == nil then
		return nil
	end

	local itemId = resolveCanonicalItemId(rawItemId)
	if itemId == nil then
		return nil
	end

	local cached = cachedDefinitions[itemId]
	if cached ~= nil then
		return if cached == false then nil else cached
	end

	local definition = ItemRegistry.resolveDefinition(itemId)
	if definition == nil then
		cachedDefinitions[itemId] = false
		cachedDefinitions[rawItemId] = false
		return nil
	end

	cachedDefinitions[itemId] = definition
	cachedDefinitions[rawItemId] = definition
	return definition
end

function Magic.ResolveToolItemId(toolRaw: any): string?
	return ResolveToolInstance.resolveToolItemId(toolRaw)
end

function Magic.ResolveToolItemType(toolRaw: any): string?
	local normalized = normalizeTypeToken(ResolveToolInstance.resolveToolItemType(toolRaw))
	if normalized == "" then
		return nil
	end

	return normalized
end

function Magic.IsMagicTool(toolRaw: any, expectedTypeRaw: any): boolean
	local itemType = Magic.ResolveToolItemType(toolRaw)
	if itemType == nil then
		return false
	end

	local expectedTypeToken =
		normalizeTypeToken(if expectedTypeRaw == nil then DEFAULT_EXPECTED_ITEM_TYPE else expectedTypeRaw)
	if expectedTypeToken == "" then
		expectedTypeToken = normalizeTypeToken(DEFAULT_EXPECTED_ITEM_TYPE)
	end
	return itemType == expectedTypeToken
end

local function normalizeProjectile(definition: { [string]: any }, magicData: { [string]: any }): { [string]: any }?
	local projectileRaw = if typeof(magicData.projectile) == "table"
		then magicData.projectile
		else definition.projectile
	if typeof(projectileRaw) ~= "table" then
		return nil
	end

	local projectile = projectileRaw :: { [string]: any }
	return {
		enabled = sanitizeBoolean(projectile.enabled, true),
		speed = sanitizeNumber(projectile.speed, 120, 1, 5000),
		spread = sanitizeNumber(projectile.spread, 0, 0, 90),
		count = math.max(1, math.floor(sanitizeNumber(projectile.count, 1, 1, 50))),
		lifetime = sanitizeNumber(projectile.lifetime, 2, 0.05, 60),
		pierce = math.max(0, math.floor(sanitizeNumber(projectile.pierce, 0, 0, 100))),
	}
end

local function resolveWeaponConfig(
	itemIdRaw: any,
	expectedTypeToken: string,
	expectedTypeLabel: string,
	validateDefinitionType: boolean
): MagicWeaponConfig?
	local rawItemId = sanitizeItemId(itemIdRaw)
	if rawItemId == nil then
		return nil
	end

	local canonicalItemId = resolveCanonicalItemId(rawItemId)
	if canonicalItemId == nil then
		cachedWeaponConfigs[rawItemId] = false
		return nil
	end

	local cached = cachedWeaponConfigs[canonicalItemId]
	if cached == nil then
		cached = cachedWeaponConfigs[rawItemId]
	end
	if cached ~= nil then
		if cached == false then
			return nil
		end
		local cloned = cloneWeaponConfig(cached)
		cloned.itemType = expectedTypeLabel
		return cloned
	end

	local definition = getItemDefinition(canonicalItemId)
	if definition == nil then
		cachedWeaponConfigs[canonicalItemId] = false
		cachedWeaponConfigs[rawItemId] = false
		return nil
	end

	local magicData = if typeof(definition.magic) == "table" then definition.magic :: { [string]: any } else {}
	local stats = if typeof(definition.stats) == "table" then definition.stats :: { [string]: any } else {}

	local definitionTypeToken =
		normalizeTypeToken(definition.itemType or definition.type or definition.weaponType or magicData.itemType)
	if validateDefinitionType and definitionTypeToken ~= "" and definitionTypeToken ~= expectedTypeToken then
		cachedWeaponConfigs[canonicalItemId] = false
		cachedWeaponConfigs[rawItemId] = false
		return nil
	end

	local useCase = string.lower(trim(definition.useCase))
	if useCase ~= "" and useCase ~= "weapon" and useCase ~= "magic" then
		cachedWeaponConfigs[canonicalItemId] = false
		cachedWeaponConfigs[rawItemId] = false
		return nil
	end

	local attackSpeedCooldown = ATTACK_SPEED_TO_COOLDOWN[string.lower(trim(stats.attackSpeed))]
	local cooldownFromAttackSpeed = if attackSpeedCooldown ~= nil then attackSpeedCooldown else DEFAULT_COOLDOWN

	local weaponConfig: MagicWeaponConfig = {
		itemId = canonicalItemId,
		itemType = expectedTypeLabel,
		displayName = sanitizeString(definition.name, canonicalItemId),
		description = sanitizeString(definition.description, ""),
		damage = sanitizeNumber(
			magicData.damage or stats.magicDamage or stats.dmg or definition.damage,
			DEFAULT_DAMAGE,
			0,
			500000
		),
		manaCost = sanitizeNumber(
			magicData.manaCost or magicData.mana or stats.manaCost or stats.mana,
			DEFAULT_MANA_COST,
			0,
			100000
		),
		cooldown = sanitizeNumber(magicData.cooldown or definition.cooldown, cooldownFromAttackSpeed, 0, 120),
		castTime = sanitizeNumber(magicData.castTime or definition.castTime, DEFAULT_CAST_TIME, 0, 60),
		range = sanitizeNumber(magicData.range or definition.range, DEFAULT_RANGE, 0.1, 5000),
		autoRepeatWhileHeld = sanitizeBoolean(magicData.autoRepeatWhileHeld, DEFAULT_AUTO_REPEAT),
		allowQueueOnCooldown = sanitizeBoolean(magicData.allowQueueOnCooldown, DEFAULT_ALLOW_QUEUE_ON_COOLDOWN),
		projectile = normalizeProjectile(definition, magicData),
		animations = if typeof(magicData.animations) == "table"
			then magicData.animations
			else if typeof(definition.animations) == "table" then definition.animations else nil,
		definition = definition,
	}

	cachedWeaponConfigs[canonicalItemId] = weaponConfig
	cachedWeaponConfigs[rawItemId] = weaponConfig
	return cloneWeaponConfig(weaponConfig)
end

function Magic.ResolveWeaponConfig(itemIdRaw: any, expectedItemTypeRaw: any): MagicWeaponConfig?
	local expectedTypeLabel = normalizeTypeLabel(expectedItemTypeRaw, DEFAULT_EXPECTED_ITEM_TYPE)
	local expectedTypeToken = normalizeTypeToken(expectedTypeLabel)
	if expectedTypeToken == "" then
		return nil
	end
	return resolveWeaponConfig(itemIdRaw, expectedTypeToken, expectedTypeLabel, false)
end

function Magic.ResolveWeaponConfigFromTool(toolRaw: any, expectedItemTypeRaw: any): MagicWeaponConfig?
	if typeof(toolRaw) ~= "Instance" or not toolRaw:IsA("Tool") then
		return nil
	end

	local expectedTypeLabel = normalizeTypeLabel(expectedItemTypeRaw, DEFAULT_EXPECTED_ITEM_TYPE)
	local expectedTypeToken = normalizeTypeToken(expectedTypeLabel)
	if expectedTypeToken == "" then
		return nil
	end

	local itemTypeToken = Magic.ResolveToolItemType(toolRaw)
	if itemTypeToken == nil or itemTypeToken ~= expectedTypeToken then
		return nil
	end

	local itemId = Magic.ResolveToolItemId(toolRaw)
	if itemId == nil then
		return nil
	end

	return resolveWeaponConfig(itemId, expectedTypeToken, expectedTypeLabel, true)
end

local function getServiceMethod(service: MagicServiceAdapter, methodName: string): ((...any) -> any)?
	local method = (service :: any)[methodName]
	if typeof(method) ~= "function" then
		return nil
	end
	return method
end

local function mergeContext(base: { [string]: any }, extra: { [string]: any }?): { [string]: any }
	if extra == nil then
		return base
	end
	for key, value in extra do
		base[key] = value
	end
	return base
end

function Magic.New(configRaw: MagicConfig?): Magic
	local config = if typeof(configRaw) == "table" then configRaw else {}
	local expectedTypeLabel = normalizeTypeLabel(config.expectedItemType, DEFAULT_EXPECTED_ITEM_TYPE)
	local expectedTypeToken = normalizeTypeToken(expectedTypeLabel)

	local self = setmetatable({
		janitor = Janitor.new(),
		toolJanitor = Janitor.new(),
		signals = {
			castRequested = Signal.new(),
			castStarted = Signal.new(),
			castCommitted = Signal.new(),
			castFinished = Signal.new(),
			castFailed = Signal.new(),
			weaponChanged = Signal.new(),
			inputHeldChanged = Signal.new(),
			enabledChanged = Signal.new(),
		},
		callbacks = if typeof(config.callbacks) == "table" then config.callbacks else {},
		service = if typeof(config.service) == "table" then config.service else nil,
		boundTool = nil,
		character = if typeof(config.character) == "Instance" and config.character:IsA("Model")
			then config.character
			else nil,
		ownerPlayer = if typeof(config.ownerPlayer) == "Instance" and config.ownerPlayer:IsA("Player")
			then config.ownerPlayer
			else nil,
		enabled = true,
		inputHeld = false,
		autoRepeatWhileHeld = sanitizeBoolean(config.autoRepeatWhileHeld, DEFAULT_AUTO_REPEAT),
		allowQueueOnCooldown = sanitizeBoolean(config.allowQueueOnCooldown, DEFAULT_ALLOW_QUEUE_ON_COOLDOWN),
		validateDefinitionItemType = sanitizeBoolean(
			config.validateDefinitionItemType,
			DEFAULT_VALIDATE_DEFINITION_ITEM_TYPE
		),
		expectedItemType = expectedTypeLabel,
		expectedItemTypeToken = if expectedTypeToken == ""
			then normalizeTypeToken(DEFAULT_EXPECTED_ITEM_TYPE)
			else expectedTypeToken,
		weaponConfig = nil,
		resolvedItemId = nil,
		resolvedItemType = nil,
		queued = false,
		casting = false,
		cooldownUntil = 0,
		retryToken = 0,
		castToken = 0,
		destroyed = false,
		lastError = nil,
	}, Magic)

	self.janitor:GiveChore(self.toolJanitor)
	self.janitor:GiveChore(function()
		for _, signalObject in self.signals do
			local signalObjectTyped = signalObject :: SignalObject
			signalObjectTyped:Destroy()
		end
	end)

	if config.tool ~= nil then
		self:bindTool(config.tool)
	end

	return self
end

function Magic:_invokeCallback(name: string, ...: any)
	local callback = (self.callbacks :: any)[name]
	if typeof(callback) ~= "function" then
		return
	end
	pcall(callback, self, ...)
end

function Magic:_callServiceBoolean(methodName: string, amount: number, context: { [string]: any }): boolean?
	if self.service == nil then
		return nil
	end

	local method = getServiceMethod(self.service, methodName)
	if method == nil then
		return nil
	end

	local ok, result = pcall(method, self.service, self.ownerPlayer, amount, context)
	if not ok then
		return false
	end
	if result == nil then
		return nil
	end
	return result == true
end

function Magic:_serviceAllowsCast(context: { [string]: any }): boolean
	if self.service == nil then
		return true
	end

	local onRequested = getServiceMethod(self.service, "onMagicCastRequested")
	if onRequested == nil then
		return true
	end

	local ok, result = pcall(onRequested, self.service, self, context)
	if not ok then
		return false
	end
	return result ~= false
end

function Magic:_serviceCanConsumeMana(amount: number, context: { [string]: any }): boolean
	if amount <= 0 or self.service == nil then
		return true
	end

	local canConsume = self:_callServiceBoolean("canConsumeMana", amount, context)
	if canConsume ~= nil then
		return canConsume
	end

	local hasMana = self:_callServiceBoolean("hasMana", amount, context)
	if hasMana ~= nil then
		return hasMana
	end

	local getManaMethod = getServiceMethod(self.service, "getMana")
	if getManaMethod == nil then
		return true
	end

	local ok, result = pcall(getManaMethod, self.service, self.ownerPlayer, context)
	if not ok then
		return false
	end
	if typeof(result) == "number" and result == result then
		return result >= amount
	end
	return true
end

function Magic:_serviceConsumeMana(amount: number, context: { [string]: any }): boolean
	if amount <= 0 or self.service == nil then
		return true
	end

	local consumed = self:_callServiceBoolean("consumeMana", amount, context)
	if consumed ~= nil then
		return consumed
	end

	local spent = self:_callServiceBoolean("spendMana", amount, context)
	if spent ~= nil then
		return spent
	end

	return true
end

function Magic:_notifyServiceCommitted(context: { [string]: any })
	if self.service == nil then
		return
	end

	local onCommitted = getServiceMethod(self.service, "onMagicCastCommitted")
	if onCommitted == nil then
		return
	end

	pcall(onCommitted, self.service, self, context)
end

function Magic:_emitFailed(reason: string, contextExtra: { [string]: any }?)
	self.lastError = reason
	local context = mergeContext({
		now = os.clock(),
		reason = reason,
		itemId = self.resolvedItemId,
		itemType = self.resolvedItemType,
		weaponConfig = self.weaponConfig,
	}, contextExtra)
	self.signals.castFailed:Fire(context)
	self:_invokeCallback("onCastFailed", context)
end

function Magic:_emitFinished(success: boolean, reason: string, contextExtra: { [string]: any }?)
	local context = mergeContext({
		now = os.clock(),
		success = success,
		reason = reason,
		itemId = self.resolvedItemId,
		itemType = self.resolvedItemType,
		weaponConfig = self.weaponConfig,
	}, contextExtra)
	self.signals.castFinished:Fire(context)
	self:_invokeCallback("onCastFinished", context)
end

function Magic:_scheduleQueue(waitTime: number)
	if self.destroyed then
		return
	end

	self.retryToken += 1
	local token = self.retryToken
	task.delay(math.max(0, waitTime), function()
		if self.destroyed or token ~= self.retryToken then
			return
		end
		self:_processQueue("CooldownReady")
	end)
end

function Magic:_processQueue(triggerRaw: any)
	if self.destroyed or not self.enabled or not self.queued or self.casting then
		return
	end

	local now = os.clock()
	if now < self.cooldownUntil then
		if self.allowQueueOnCooldown then
			self:_scheduleQueue(self.cooldownUntil - now)
		end
		return
	end

	self.queued = false
	self:_startCast(triggerRaw)
end

function Magic:_commitCast(token: number, baseContext: { [string]: any })
	if self.destroyed or not self.casting or self.castToken ~= token then
		return
	end

	local config = self.weaponConfig
	if config == nil then
		self.casting = false
		self:_emitFailed("WeaponConfigLost", baseContext)
		self:_emitFinished(false, "WeaponConfigLost", baseContext)
		return
	end

	local context = mergeContext({
		now = os.clock(),
		itemId = config.itemId,
		itemType = config.itemType,
		weaponConfig = config,
		tool = self.boundTool,
		ownerPlayer = self.ownerPlayer,
		character = self.character,
		castToken = token,
	}, baseContext)

	if not self:_serviceConsumeMana(config.manaCost, context) then
		self.casting = false
		self:_emitFailed("ManaConsumeRejected", context)
		self:_emitFinished(false, "ManaConsumeRejected", context)
		return
	end

	self.cooldownUntil = os.clock() + math.max(0, config.cooldown)
	self.casting = false

	self.signals.castCommitted:Fire(context)
	self:_invokeCallback("onCastCommitted", context)
	self:_notifyServiceCommitted(context)
	self:_emitFinished(true, "CastCommitted", context)

	if self.autoRepeatWhileHeld and self.inputHeld then
		self:queueCast("HoldRepeat")
	elseif self.queued then
		self:_processQueue("Pending")
	end
end

function Magic:_startCast(triggerRaw: any)
	if self.destroyed or not self.enabled or self.casting then
		return
	end

	local tool = self.boundTool
	if tool == nil then
		self:_emitFailed("NoBoundTool", { trigger = triggerRaw })
		return
	end

	local config = self:refreshWeaponConfig()
	if config == nil then
		self:_emitFailed(if self.lastError ~= nil then self.lastError else "WeaponConfigNotFound", {
			trigger = triggerRaw,
			tool = tool,
		})
		return
	end

	local context = {
		now = os.clock(),
		trigger = sanitizeString(triggerRaw, "Cast"),
		itemId = config.itemId,
		itemType = config.itemType,
		weaponConfig = config,
		tool = tool,
		ownerPlayer = self.ownerPlayer,
		character = self.character,
	}

	if not self:_serviceAllowsCast(context) then
		self:_emitFailed("ServiceRejected", context)
		return
	end
	if not self:_serviceCanConsumeMana(config.manaCost, context) then
		self:_emitFailed("NotEnoughMana", context)
		return
	end

	self.casting = true
	self.castToken += 1
	local token = self.castToken

	context.castToken = token
	context.startedAt = os.clock()
	self.signals.castStarted:Fire(context)
	self:_invokeCallback("onCastStarted", context)

	local castTime = math.max(0, config.castTime)
	if castTime <= 0 then
		self:_commitCast(token, context)
		return
	end

	task.delay(castTime, function()
		if self.destroyed or not self.casting or self.castToken ~= token then
			return
		end
		self:_commitCast(token, context)
	end)
end

function Magic:QueueCast(triggerRaw: any): boolean
	if self.destroyed or not self.enabled then
		return false
	end

	self.queued = true
	local context = {
		now = os.clock(),
		trigger = sanitizeString(triggerRaw, "Queue"),
		itemId = self.resolvedItemId,
		itemType = self.resolvedItemType,
		weaponConfig = self.weaponConfig,
		tool = self.boundTool,
	}

	self.signals.castRequested:Fire(context)
	self:_invokeCallback("onCastRequested", context)
	self:_processQueue(context.trigger)
	return true
end

function Magic:Cast(triggerRaw: any): boolean
	return self:queueCast(triggerRaw or "Cast")
end

function Magic:Tap(triggerRaw: any): boolean
	return self:queueCast(triggerRaw or "Tap")
end

function Magic:InputBegan(triggerRaw: any): boolean
	local wasHeld = self.inputHeld
	self.inputHeld = true
	if wasHeld ~= self.inputHeld then
		self.signals.inputHeldChanged:Fire(self.inputHeld)
		self:_invokeCallback("onInputHeldChanged", self.inputHeld)
	end
	return self:queueCast(triggerRaw or "InputBegan")
end

function Magic:InputEnded(_: any): boolean
	local wasHeld = self.inputHeld
	self.inputHeld = false
	if wasHeld ~= self.inputHeld then
		self.signals.inputHeldChanged:Fire(self.inputHeld)
		self:_invokeCallback("onInputHeldChanged", self.inputHeld)
	end
	return true
end

function Magic:SetEnabled(enabledRaw: any)
	local enabled = sanitizeBoolean(enabledRaw, self.enabled)
	if enabled == self.enabled then
		return
	end

	self.enabled = enabled
	self.signals.enabledChanged:Fire(self.enabled)
	self:_invokeCallback("onEnabledChanged", self.enabled)
	if not enabled then
		self:cancel("Disabled")
	elseif self.queued then
		self:_processQueue("Enabled")
	end
end

function Magic:SetService(serviceRaw: any)
	self.service = if typeof(serviceRaw) == "table" then serviceRaw else nil
end

function Magic:SetOwnerPlayer(playerRaw: any)
	self.ownerPlayer = if typeof(playerRaw) == "Instance" and playerRaw:IsA("Player") then playerRaw else nil
end

function Magic:SetCharacter(characterRaw: any)
	self.character = if typeof(characterRaw) == "Instance" and characterRaw:IsA("Model") then characterRaw else nil
end

function Magic:SetExpectedItemType(itemTypeRaw: any)
	local label = normalizeTypeLabel(itemTypeRaw, DEFAULT_EXPECTED_ITEM_TYPE)
	local token = normalizeTypeToken(label)
	if token == "" then
		return
	end

	self.expectedItemType = label
	self.expectedItemTypeToken = token
	self:refreshWeaponConfig()
end

function Magic:RefreshWeaponConfig(): MagicWeaponConfig?
	local tool = self.boundTool
	if tool == nil then
		self.weaponConfig = nil
		self.resolvedItemId = nil
		self.resolvedItemType = nil
		self.lastError = "NoBoundTool"
		return nil
	end

	local toolItemType = Magic.ResolveToolItemType(tool)
	if toolItemType == nil then
		self.weaponConfig = nil
		self.resolvedItemId = nil
		self.resolvedItemType = nil
		self.lastError = "MissingItemTypeAttribute"
		return nil
	end
	if toolItemType ~= self.expectedItemTypeToken then
		self.weaponConfig = nil
		self.resolvedItemId = nil
		self.resolvedItemType = toolItemType
		self.lastError = "InvalidItemType"
		return nil
	end

	local itemId = Magic.ResolveToolItemId(tool)
	if itemId == nil then
		self.weaponConfig = nil
		self.resolvedItemId = nil
		self.resolvedItemType = toolItemType
		self.lastError = "MissingItemIdAttribute"
		return nil
	end

	local weaponConfig =
		resolveWeaponConfig(itemId, self.expectedItemTypeToken, self.expectedItemType, self.validateDefinitionItemType)
	if weaponConfig == nil then
		self.weaponConfig = nil
		self.resolvedItemId = itemId
		self.resolvedItemType = toolItemType
		self.lastError = "NoMagicWeaponDefinition"
		return nil
	end

	local previousItemId = self.resolvedItemId
	local previousWeaponConfig = self.weaponConfig

	self.weaponConfig = weaponConfig
	self.resolvedItemId = weaponConfig.itemId
	self.resolvedItemType = toolItemType
	self.lastError = nil
	self.autoRepeatWhileHeld = weaponConfig.autoRepeatWhileHeld
	self.allowQueueOnCooldown = weaponConfig.allowQueueOnCooldown

	if previousItemId ~= self.resolvedItemId or not areWeaponConfigsEquivalent(previousWeaponConfig, weaponConfig) then
		local context = {
			now = os.clock(),
			itemId = self.resolvedItemId,
			itemType = self.resolvedItemType,
			weaponConfig = self.weaponConfig,
			tool = tool,
		}
		self.signals.weaponChanged:Fire(context)
		self:_invokeCallback("onWeaponChanged", context)
	end

	return cloneWeaponConfig(weaponConfig)
end

function Magic:BindTool(toolRaw: any): boolean
	local tool = if typeof(toolRaw) == "Instance" and toolRaw:IsA("Tool") then toolRaw else nil
	if tool == nil then
		return false
	end

	self.toolJanitor:Clean()
	self.boundTool = tool
	if tool.Parent ~= nil and tool.Parent:IsA("Model") then
		self:setCharacter(tool.Parent)
	end

	for _, attributeName in { "itemType", "ItemType", "itemtype", "type", "itemId", "ItemId", "ittemId", "id" } do
		self.toolJanitor:GiveChore(tool:GetAttributeChangedSignal(attributeName):Connect(function()
			self:refreshWeaponConfig()
		end))
	end

	self.toolJanitor:GiveChore(tool.Equipped:Connect(function()
		if tool.Parent ~= nil and tool.Parent:IsA("Model") then
			self:setCharacter(tool.Parent)
		end
		self:refreshWeaponConfig()
	end))

	self.toolJanitor:GiveChore(tool.Activated:Connect(function()
		self:inputBegan("ToolActivated")
	end))

	self.toolJanitor:GiveChore(tool.Deactivated:Connect(function()
		self:inputEnded("ToolDeactivated")
	end))

	self.toolJanitor:GiveChore(tool.Unequipped:Connect(function()
		self:inputEnded("ToolUnequipped")
		self:cancel("ToolUnequipped")
	end))

	self.toolJanitor:GiveChore(tool.Destroying:Connect(function()
		if self.boundTool == tool then
			self:unbindTool()
		end
	end))

	self:refreshWeaponConfig()
	return true
end

function Magic:UnbindTool()
	self.toolJanitor:Clean()
	self.boundTool = nil
	self.weaponConfig = nil
	self.resolvedItemId = nil
	self.resolvedItemType = nil
	self.lastError = nil
	self.queued = false
	self.retryToken += 1
end

function Magic:ResolveBoundWeaponConfig(): MagicWeaponConfig?
	return self:refreshWeaponConfig()
end

function Magic:GetBoundItemId(): string?
	return self.resolvedItemId
end

function Magic:GetBoundItemType(): string?
	return self.resolvedItemType
end

function Magic:GetLastError(): string?
	return self.lastError
end

function Magic:On(signalNameRaw: any, callback: (...any) -> ()): RBXScriptConnection?
	if typeof(signalNameRaw) ~= "string" or typeof(callback) ~= "function" then
		return nil
	end

	local signalObject = (self.signals :: any)[signalNameRaw]
	if signalObject == nil then
		return nil
	end
	return (signalObject :: SignalObject):Connect(callback)
end

function Magic:Cancel(reasonRaw: any)
	self.queued = false
	self.retryToken += 1

	local wasCasting = self.casting
	self.casting = false
	self.castToken += 1

	local wasHeld = self.inputHeld
	self.inputHeld = false
	if wasHeld ~= self.inputHeld then
		self.signals.inputHeldChanged:Fire(self.inputHeld)
		self:_invokeCallback("onInputHeldChanged", self.inputHeld)
	end

	if wasCasting then
		self:_emitFinished(false, sanitizeString(reasonRaw, "Cancelled"))
	end
end

function Magic:Destroy()
	if self.destroyed then
		return
	end
	self.destroyed = true
	self:cancel("Destroyed")
	self:unbindTool()
	self.janitor:Destroy()
end

Magic.resolveToolItemId = Magic.ResolveToolItemId
Magic.resolveToolItemType = Magic.ResolveToolItemType
Magic.isMagicTool = Magic.IsMagicTool
Magic.resolveWeaponConfig = Magic.ResolveWeaponConfig
Magic.resolveWeaponConfigFromTool = Magic.ResolveWeaponConfigFromTool
Magic.new = Magic.New
Magic.queueCast = Magic.QueueCast
Magic.cast = Magic.Cast
Magic.tap = Magic.Tap
Magic.inputBegan = Magic.InputBegan
Magic.inputEnded = Magic.InputEnded
Magic.setEnabled = Magic.SetEnabled
Magic.setService = Magic.SetService
Magic.setOwnerPlayer = Magic.SetOwnerPlayer
Magic.setCharacter = Magic.SetCharacter
Magic.setExpectedItemType = Magic.SetExpectedItemType
Magic.refreshWeaponConfig = Magic.RefreshWeaponConfig
Magic.bindTool = Magic.BindTool
Magic.unbindTool = Magic.UnbindTool
Magic.resolveBoundWeaponConfig = Magic.ResolveBoundWeaponConfig
Magic.getBoundItemId = Magic.GetBoundItemId
Magic.getBoundItemType = Magic.GetBoundItemType
Magic.getLastError = Magic.GetLastError
Magic.on = Magic.On
Magic.cancel = Magic.Cancel
Magic.destroy = Magic.Destroy

return Magic
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="1122">
              <Properties>
                <string name="Name">Melee</string>
                <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Janitor = require(ReplicatedStorage.Packages.Janitor)
local Signal = require(ReplicatedStorage.Packages.Signal)

type SignalObject = {
	Connect: (self: SignalObject, callback: (...any) -> ()) -> RBXScriptConnection,
	Fire: (self: SignalObject, ...any) -> (),
	Destroy: (self: SignalObject) -> (),
}

local DEFAULT_START_EVENTS = { "startSwing", "StartSwing", "swingStart", "SwingStart" }
local DEFAULT_END_EVENTS = { "endSwing", "EndSwing", "swingEnd", "SwingEnd" }
local DEFAULT_PROJECTILE_EVENTS = { "projectile", "Projectile", "spawnProjectile", "SpawnProjectile" }

local DEFAULT_COOLDOWN = 0.2
local DEFAULT_TIMEOUT = 0.5
local DEFAULT_TIMEOUT_PADDING = 0.08
local DEFAULT_SLASH_RESET_COOLDOWN = 0.9
local DEFAULT_STANCE_DELAY = 1.35

local NAMED_ANIMATION_STATE_ALIASES: { [string]: { string } } = {
	Equip = { "equip", "draw", "equipanimation", "drawanimation" },
	Idle = { "idle", "weaponidle", "holdidle", "idleanimation" },
	Unequip = { "unequip", "holster", "sheath", "sheathe", "unequipanimation" },
	StanceTransition = {
		"stancetransition",
		"transitiontostance",
		"enterstance",
		"stancestart",
		"stancetransitionanimation",
	},
	StanceIdle = { "stanceidle", "stance", "combatidle", "readyidle", "stanceidleanimation" },
}
local NAMED_ANIMATION_TOKEN_TO_STATE: { [string]: string } = {}

for stateName, aliases in NAMED_ANIMATION_STATE_ALIASES do
	for _, alias in aliases do
		NAMED_ANIMATION_TOKEN_TO_STATE[alias] = stateName
	end
end

local function trim(valueRaw: any): string
	if typeof(valueRaw) ~= "string" then
		return ""
	end
	return string.match(valueRaw, "^%s*(.-)%s*$") or ""
end

local function normalizeEventName(nameRaw: any): string
	return string.lower(trim(nameRaw))
end

local function normalizeToken(valueRaw: any): string
	local normalized = string.lower(trim(valueRaw))
	if normalized == "" then
		return ""
	end
	return string.gsub(normalized, "[%s_%-]+", "")
end

local function normalizeNamedAnimationStateKey(nameRaw: any): string?
	local token = normalizeToken(nameRaw)
	if token == "" then
		return nil
	end
	return NAMED_ANIMATION_TOKEN_TO_STATE[token]
end

local function toBool(valueRaw: any, fallback: boolean): boolean
	if typeof(valueRaw) == "boolean" then
		return valueRaw
	end
	return fallback
end

local function toNumber(valueRaw: any, fallback: number, minValue: number?, maxValue: number?): number
	local value = if typeof(valueRaw) == "number" and valueRaw == valueRaw then valueRaw else fallback
	if minValue ~= nil and value < minValue then
		value = minValue
	end
	if maxValue ~= nil and value > maxValue then
		value = maxValue
	end
	return value
end

local function toArray(valueRaw: any, fallback: { string }): { string }
	local out = {}
	if typeof(valueRaw) == "table" then
		for _, entry in valueRaw do
			if typeof(entry) == "string" then
				local text = trim(entry)
				if text ~= "" then
					table.insert(out, text)
				end
			end
		end
		return out
	end
	if typeof(valueRaw) == "string" then
		local text = trim(valueRaw)
		if text ~= "" then
			table.insert(out, text)
		end
		return out
	end
	for _, entry in fallback do
		table.insert(out, entry)
	end
	return out
end

local function normalizeAnimationId(idRaw: any): string?
	if typeof(idRaw) == "number" then
		if idRaw <= 0 or idRaw ~= idRaw then
			return nil
		end
		return "rbxassetid://" .. tostring(math.floor(idRaw))
	end

	if typeof(idRaw) ~= "string" then
		return nil
	end

	local text = trim(idRaw)
	if text == "" then
		return nil
	end

	if string.find(text, "rbxassetid://", 1, true) == 1 then
		return text
	end

	local digits = string.match(text, "^%d+$")
	if digits ~= nil then
		return "rbxassetid://" .. digits
	end

	return text
end

local function normalizeAnimationMode(modeRaw: any): string
	local mode = string.lower(trim(modeRaw))
	if mode == "sequence" or mode == "sequential" or mode == "ordered" then
		return "Sequence"
	end
	return "Sequence"
end

local function resolveClipAnimationId(clipRaw: { [string]: any }): string?
	local animationId = normalizeAnimationId(clipRaw.id)
	if animationId ~= nil then
		return animationId
	end

	animationId = normalizeAnimationId(clipRaw.animationId)
	if animationId ~= nil then
		return animationId
	end

	animationId = normalizeAnimationId(clipRaw.AnimationId)
	if animationId ~= nil then
		return animationId
	end

	animationId = normalizeAnimationId(clipRaw.assetId)
	if animationId ~= nil then
		return animationId
	end

	animationId = normalizeAnimationId(clipRaw.animId)
	if animationId ~= nil then
		return animationId
	end

	animationId = normalizeAnimationId(clipRaw.animation)
	if animationId ~= nil then
		return animationId
	end

	return nil
end

local function isAnimationClipTable(valueRaw: any): boolean
	if typeof(valueRaw) ~= "table" then
		return false
	end

	local value = valueRaw :: { [string]: any }
	return value.id ~= nil
		or value.animation ~= nil
		or value.animationId ~= nil
		or value.AnimationId ~= nil
		or value.assetId ~= nil
		or value.animId ~= nil
end

local function resolveAnimationConfigClips(configRaw: any): any
	if configRaw == nil then
		return {}
	end

	if typeof(configRaw) ~= "table" then
		return { configRaw }
	end

	local config = configRaw :: { [string]: any }
	if config.clips ~= nil then
		return config.clips
	end
	if isAnimationClipTable(config) then
		return { config }
	end
	return configRaw
end

local function normalizeNamedAnimationClip(
	clipRaw: any,
	fallbackName: string,
	defaultLooped: boolean?
): { [string]: any }?
	local clipTable = if typeof(clipRaw) == "table" then clipRaw else { animation = clipRaw }
	if typeof(clipTable) ~= "table" then
		return nil
	end

	local animation = if typeof(clipTable.animation) == "Instance" and clipTable.animation:IsA("Animation")
		then clipTable.animation
		else nil
	if animation == nil and typeof(clipRaw) == "Instance" and clipRaw:IsA("Animation") then
		animation = clipRaw
	end

	local animationId = resolveClipAnimationId(clipTable)
	if animationId == nil and animation ~= nil then
		animationId = normalizeAnimationId(animation.AnimationId)
	end

	if animation == nil and animationId == nil then
		return nil
	end

	local clip = {
		name = trim(clipTable.name) ~= "" and trim(clipTable.name) or fallbackName,
		animation = animation,
		id = animationId,
		looped = if typeof(clipTable.looped) == "boolean" then clipTable.looped else defaultLooped,
		priority = if typeof(clipTable.priority) == "EnumItem" then clipTable.priority else nil,
		speed = if typeof(clipTable.speed) == "number" then clipTable.speed else nil,
		weight = if typeof(clipTable.weight) == "number" then clipTable.weight else nil,
		fadeTime = if typeof(clipTable.fadeTime) == "number" then clipTable.fadeTime else nil,
		duration = if typeof(clipTable.duration) == "number" then clipTable.duration else nil,
	}
	return clip
end

local function mergeNamedAnimationStateClips(
	target: { [string]: { [string]: any } },
	sourceRaw: any,
	defaultLoopedByState: { [string]: boolean }
)
	if typeof(sourceRaw) ~= "table" then
		return
	end

	for key, value in sourceRaw do
		local stateKey = normalizeNamedAnimationStateKey(key)
		if stateKey == nil or target[stateKey] ~= nil then
			continue
		end

		local clip = normalizeNamedAnimationClip(value, stateKey, defaultLoopedByState[stateKey])
		if clip ~= nil then
			target[stateKey] = clip
		end
	end
end

local function resolveNamedAnimationStateClips(configRaw: any): { [string]: { [string]: any } }
	local clipsByState: { [string]: { [string]: any } } = {}
	local defaultLoopedByState = {
		Idle = true,
		StanceIdle = true,
	}

	if typeof(configRaw) ~= "table" then
		return clipsByState
	end

	local config = configRaw :: { [string]: any }
	mergeNamedAnimationStateClips(clipsByState, config.namedAnimations, defaultLoopedByState)
	mergeNamedAnimationStateClips(clipsByState, config.named, defaultLoopedByState)
	mergeNamedAnimationStateClips(clipsByState, config, defaultLoopedByState)
	return clipsByState
end

local function createAnimatorFromHumanoid(humanoid: Humanoid?): Animator?
	if humanoid == nil then
		return nil
	end
	local existing = humanoid:FindFirstChildOfClass("Animator")
	if existing then
		return existing
	end
	local animator = Instance.new("Animator")
	animator.Name = "Animator"
	animator.Parent = humanoid
	return animator
end

local function createAnimatorFromCharacter(character: Model?): Animator?
	if character == nil then
		return nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid == nil then
		return nil
	end
	return createAnimatorFromHumanoid(humanoid)
end

local function buildEventSet(eventsRaw: any, defaults: { string }): ({ [string]: boolean }, { string })
	local names = toArray(eventsRaw, defaults)
	local eventSet = {}
	local markerSet = {}
	local markers = {}

	local function pushMarker(nameRaw: any)
		if typeof(nameRaw) ~= "string" then
			return
		end
		local value = trim(nameRaw)
		if value == "" or markerSet[value] then
			return
		end
		markerSet[value] = true
		table.insert(markers, value)
	end

	for _, name in names do
		local normalized = normalizeEventName(name)
		if normalized ~= "" then
			eventSet[normalized] = true
			pushMarker(name)
			pushMarker(string.lower(name))
			pushMarker(string.upper(string.sub(name, 1, 1)) .. string.sub(name, 2))
		end
	end

	return eventSet, markers
end

local function mergeUniqueStringLists(...: { string }): { string }
	local out = {}
	local seen = {}
	for _, list in { ... } do
		for _, name in list do
			local text = trim(name)
			if text ~= "" and not seen[text] then
				seen[text] = true
				table.insert(out, text)
			end
		end
	end
	return out
end

local AnimationController = {}
AnimationController.__index = AnimationController

function AnimationController.New(configRaw: any)
	local config = if typeof(configRaw) == "table" then configRaw else {}
	local self = setmetatable({
		janitor = Janitor.new(),
		trackJanitor = Janitor.new(),
		signals = {
			markerReached = Signal.new(),
			keyframeReached = Signal.new(),
			trackStopped = Signal.new(),
		},
		animator = nil :: Animator?,
		clips = {},
		mode = normalizeAnimationMode(config.mode),
		random = if typeof(config.random) == "Random" then config.random else Random.new(),
		sequenceIndex = 0,
		markers = toArray(config.markerNames, {}),
		trackCache = {},
	}, AnimationController)

	self.janitor:GiveChore(self.trackJanitor)
	self.janitor:GiveChore(function()
		for _, signalObject in self.signals do
			local signalObjectTyped = signalObject :: SignalObject
			signalObjectTyped:Destroy()
		end
	end)

	self:setClips(resolveAnimationConfigClips(configRaw))
	return self
end

function AnimationController:SetAnimator(animatorRaw: any)
	local animator = if typeof(animatorRaw) == "Instance" and animatorRaw:IsA("Animator") then animatorRaw else nil
	if self.animator == animator then
		return
	end
	self.animator = animator
	self:clearTracks()
end

function AnimationController:SetMode(modeRaw: any)
	self.mode = normalizeAnimationMode(modeRaw)
end

function AnimationController:ResetSequence()
	self.sequenceIndex = 0
end

function AnimationController:SetMarkers(markersRaw: any)
	self.markers = toArray(markersRaw, {})
	self:clearTracks()
end

function AnimationController:GetMarkers(): { string }
	local out = {}
	for _, marker in self.markers do
		table.insert(out, marker)
	end
	return out
end

function AnimationController:SetClips(clipsRaw: any)
	local clips = {}
	if typeof(clipsRaw) ~= "table" then
		clipsRaw = if clipsRaw == nil then {} else { clipsRaw }
	end

	local fallbackIndex = 0
	for i, clipRaw in clipsRaw do
		fallbackIndex += 1
		local fallbackName = if typeof(i) == "number" and i == i
			then ("Swing_%d"):format(math.floor(i))
			else ("Swing_%d"):format(fallbackIndex)
		local clipTable = if typeof(clipRaw) == "table" then clipRaw else { id = clipRaw }
		if typeof(clipTable) ~= "table" then
			continue
		end

		local animation = if typeof(clipTable.animation) == "Instance" and clipTable.animation:IsA("Animation")
			then clipTable.animation
			else nil
		local animationId = resolveClipAnimationId(clipTable)
		if animation == nil and typeof(clipRaw) == "Instance" and clipRaw:IsA("Animation") then
			animation = clipRaw
			animationId = normalizeAnimationId(clipRaw.AnimationId)
		end

		if animation ~= nil or animationId ~= nil then
			table.insert(clips, {
				name = trim(clipTable.name) ~= "" and trim(clipTable.name) or fallbackName,
				animation = animation,
				id = animationId,
				looped = if typeof(clipTable.looped) == "boolean" then clipTable.looped else nil,
				priority = if typeof(clipTable.priority) == "EnumItem" then clipTable.priority else nil,
				speed = if typeof(clipTable.speed) == "number" then clipTable.speed else nil,
				weight = if typeof(clipTable.weight) == "number" then clipTable.weight else nil,
				fadeTime = if typeof(clipTable.fadeTime) == "number" then clipTable.fadeTime else nil,
				cooldown = if typeof(clipTable.cooldown) == "number" then clipTable.cooldown else nil,
				duration = if typeof(clipTable.duration) == "number" then clipTable.duration else nil,
			})
		end
	end
	self.clips = clips
	self.sequenceIndex = 0
	self:clearTracks()
end

function AnimationController:ClearTracks()
	for _, track in self.trackCache do
		pcall(function()
			track:Stop(0)
		end)
	end
	self.trackJanitor:Clean()
	self.trackCache = {}
end

function AnimationController:LoadTrack(index: number): AnimationTrack?
	if self.trackCache[index] ~= nil then
		return self.trackCache[index]
	end
	if self.animator == nil then
		return nil
	end
	local clip = self.clips[index]
	if clip == nil then
		return nil
	end

	local anim = clip.animation
	local destroyAnim = false
	if anim == nil then
		if clip.id == nil then
			return nil
		end
		local generated = Instance.new("Animation")
		generated.Name = clip.name
		generated.AnimationId = clip.id
		anim = generated
		destroyAnim = true
	end

	local ok, trackOrErr = pcall(function()
		return self.animator:LoadAnimation(anim :: Animation)
	end)
	if destroyAnim and anim ~= nil then
		anim:Destroy()
	end
	if not ok then
		return nil
	end

	local track = trackOrErr :: AnimationTrack
	if clip.looped ~= nil then
		track.Looped = clip.looped
	end
	if clip.priority ~= nil then
		track.Priority = clip.priority
	end

	for _, markerName in self.markers do
		self.trackJanitor:GiveChore(track:GetMarkerReachedSignal(markerName):Connect(function(param: string)
			self.signals.markerReached:Fire(markerName, param, track, clip, index)
		end))
	end

	self.trackJanitor:GiveChore(track.KeyframeReached:Connect(function(keyframeName: string)
		self.signals.keyframeReached:Fire(keyframeName, nil, track, clip, index)
	end))

	self.trackJanitor:GiveChore(track.Stopped:Connect(function()
		self.signals.trackStopped:Fire(track, clip, index)
	end))

	self.trackCache[index] = track
	return track
end

function AnimationController:PickClipIndex(): number?
	if #self.clips <= 0 then
		return nil
	end
	if self.mode == "Random" then
		return self.random:NextInteger(1, #self.clips)
	end
	self.sequenceIndex += 1
	if self.sequenceIndex > #self.clips then
		self.sequenceIndex = 1
	end
	return self.sequenceIndex
end

function AnimationController:PlayNext(playbackRaw: any): { [string]: any }?
	local index = self:pickClipIndex()
	if index == nil then
		return nil
	end

	local track = self:loadTrack(index)
	if track == nil then
		return nil
	end

	local clip = self.clips[index]
	local playback = if typeof(playbackRaw) == "table" then playbackRaw else {}

	for _, otherTrack in self.trackCache do
		if otherTrack ~= track and otherTrack.IsPlaying then
			pcall(function()
				otherTrack:Stop(toNumber(playback.stopFadeTime, 0.04, 0, nil))
			end)
		end
	end

	local fadeTime = toNumber(playback.fadeTime, clip.fadeTime or 0.06, 0, nil)
	local weight = toNumber(playback.weight, clip.weight or 1, 0, nil)
	local speed = toNumber(playback.speed, clip.speed or 1, 0.01, nil)

	local ok, err = pcall(function()
		track:Play(fadeTime, weight, speed)
	end)
	if not ok then
		return nil
	end

	return {
		track = track,
		clip = clip,
		index = index,
	}
end

function AnimationController:StopAll(fadeTimeRaw: any)
	local fadeTime = toNumber(fadeTimeRaw, 0.06, 0, nil)
	for _, track in self.trackCache do
		pcall(function()
			track:Stop(fadeTime)
		end)
	end
end

function AnimationController:Destroy()
	self:clearTracks()
	self.janitor:Destroy()
end

local Melee = {}
Melee.__index = Melee
Melee.AnimationController = AnimationController

function Melee.New(configRaw: any)
	local config = if typeof(configRaw) == "table" then configRaw else {}
	local projectile = if typeof(config.projectile) == "table" then config.projectile else {}

	local startSet, startMarkers = buildEventSet(config.startSwingEvents, DEFAULT_START_EVENTS)
	local endSet, endMarkers = buildEventSet(config.endSwingEvents, DEFAULT_END_EVENTS)
	local projectileSet, projectileMarkers = buildEventSet(projectile.markerNames, DEFAULT_PROJECTILE_EVENTS)
	local extraMarkers = toArray(config.trackedMarkerNames, {})

	local animationConfig = config.animations
	local controller = AnimationController.New(animationConfig)
	local namedAnimationStateClips = resolveNamedAnimationStateClips(animationConfig)
	local hasStanceNamedAnimations = namedAnimationStateClips.StanceTransition ~= nil
		or namedAnimationStateClips.StanceIdle ~= nil

	local stanceConfig = {}
	if typeof(animationConfig) == "table" and typeof((animationConfig :: any).stance) == "table" then
		stanceConfig = (animationConfig :: any).stance
	end
	local stanceEnabled = toBool(
		if config.stanceEnabled ~= nil
			then config.stanceEnabled
			else if (animationConfig :: any) ~= nil and typeof(animationConfig) == "table"
				then ((animationConfig :: any).stanceEnabled or (stanceConfig :: any).enabled)
				else nil,
		hasStanceNamedAnimations
	)
	local stanceDelay = toNumber(
		if config.stanceDelay ~= nil
			then config.stanceDelay
			else if (animationConfig :: any) ~= nil and typeof(animationConfig) == "table"
				then ((animationConfig :: any).stanceDelay or (animationConfig :: any).weaponStanceDelay or (
					stanceConfig :: any
				).delay)
				else nil,
		DEFAULT_STANCE_DELAY,
		0.05,
		nil
	)
	local namedAnimationPlaybackEnabled = toBool(config.namedAnimationPlaybackEnabled, true)

	local mergedMarkers =
		mergeUniqueStringLists(controller:getMarkers(), startMarkers, endMarkers, projectileMarkers, extraMarkers)
	controller:setMarkers(mergedMarkers)

	local trackedKeyframes = {}
	for _, name in toArray(config.trackedKeyframeNames, {}) do
		local normalized = normalizeEventName(name)
		if normalized ~= "" then
			trackedKeyframes[normalized] = true
		end
	end

	local self = setmetatable({
		janitor = Janitor.new(),
		toolJanitor = Janitor.new(),
		presentationJanitor = Janitor.new(),
		namedTrackJanitor = Janitor.new(),
		controller = controller,
		signals = {
			attackRequested = Signal.new(),
			attackStarted = Signal.new(),
			swingStarted = Signal.new(),
			swingEnded = Signal.new(),
			attackFinished = Signal.new(),
			animationEvent = Signal.new(),
			projectileFired = Signal.new(),
			inputHeldChanged = Signal.new(),
			enabledChanged = Signal.new(),
		},
		callbacks = if typeof(config.callbacks) == "table" then config.callbacks else {},
		startEventSet = startSet,
		endEventSet = endSet,
		projectileEventSet = projectileSet,
		trackedKeyframes = trackedKeyframes,
		trackAllKeyframes = toBool(config.trackAllKeyframes, false),
		enabled = toBool(config.enabled, true),
		autoRepeat = toBool(config.autoRepeatWhileHeld, true),
		cooldown = toNumber(config.cooldown, DEFAULT_COOLDOWN, 0, nil),
		slashResetCooldown = toNumber(config.slashResetCooldown, DEFAULT_SLASH_RESET_COOLDOWN, 0, nil),
		cooldownStartsOn = if trim(config.cooldownStartsOn) == "SwingStart" then "SwingStart" else "SwingEnd",
		timeout = toNumber(config.fallbackSwingDuration, DEFAULT_TIMEOUT, 0.01, nil),
		timeoutPadding = toNumber(config.fallbackSwingPadding, DEFAULT_TIMEOUT_PADDING, 0, nil),
		syntheticSwingEvents = toBool(config.syntheticSwingEventsWhenMissing, true),
		syntheticAttackWhenNoTrack = toBool(config.syntheticAttackWhenNoTrack, false),
		projectileEnabled = toBool(projectile.enabled, projectile.spawn ~= nil),
		projectileCooldown = toNumber(projectile.cooldown, 0, 0, nil),
		projectileSpawnOnStart = toBool(projectile.spawnOnAttackStart, false),
		projectileSpawn = if typeof(projectile.spawn) == "function" then projectile.spawn else nil,
		inputHeld = false,
		queued = false,
		attackActive = false,
		swingStarted = false,
		swingEnded = false,
		swingWindowOpen = false,
		cooldownUntil = 0,
		lastAttackFinishedAt = -math.huge,
		lastProjectileAt = -math.huge,
		swingCount = 0,
		tokenCount = 0,
		active = nil,
		lastTrigger = "Queue",
		retryToken = 0,
		timeoutToken = 0,
		boundTool = nil,
		namedAnimationPlaybackEnabled = namedAnimationPlaybackEnabled,
		namedAnimationStateClips = namedAnimationStateClips,
		namedAnimationTrackCache = {},
		presentationState = nil,
		presentationTrack = nil,
		presentationToken = 0,
		stanceEnabled = stanceEnabled,
		stanceDelay = stanceDelay,
		stanceTimerToken = 0,
		isToolEquipped = false,
		destroyed = false,
	}, Melee)

	self.janitor:GiveChore(self.toolJanitor)
	self.janitor:GiveChore(self.presentationJanitor)
	self.janitor:GiveChore(self.namedTrackJanitor)
	self.janitor:GiveChore(function()
		self.controller:destroy()
	end)
	self.janitor:GiveChore(function()
		for _, signalObject in self.signals do
			local signalObjectTyped = signalObject :: SignalObject
			signalObjectTyped:Destroy()
		end
	end)

	self.janitor:GiveChore(
		self.controller.signals.markerReached:Connect(
			function(name: string, param: string?, track: AnimationTrack, clip: any, index: number)
				self:_onAnimationEvent(name, "Marker", param, track, clip, index)
			end
		)
	)

	self.janitor:GiveChore(
		self.controller.signals.keyframeReached:Connect(
			function(name: string, _: any, track: AnimationTrack, clip: any, index: number)
				self:_onAnimationEvent(name, "Keyframe", nil, track, clip, index)
			end
		)
	)

	self.janitor:GiveChore(self.controller.signals.trackStopped:Connect(function(track: AnimationTrack)
		self:_onTrackStopped(track)
	end))

	if config.animator ~= nil then
		self:setAnimator(config.animator)
	elseif config.humanoid ~= nil then
		self:setHumanoid(config.humanoid)
	elseif config.character ~= nil then
		self:setCharacter(config.character)
	end

	if config.tool ~= nil then
		self:bindTool(config.tool, config.toolOptions)
	end

	return self
end

function Melee:_context(eventName: any, eventType: any, param: any): { [string]: any }
	local active = self.active
	local clip = if active ~= nil then active.clip else nil
	return {
		now = os.clock(),
		eventName = eventName,
		eventType = eventType,
		eventParameter = param,
		enabled = self.enabled,
		inputHeld = self.inputHeld,
		queued = self.queued,
		attackActive = self.attackActive,
		swingWindowOpen = self.swingWindowOpen,
		cooldownUntil = self.cooldownUntil,
		token = if active ~= nil then active.token else nil,
		swingIndex = if active ~= nil then active.swingIndex else nil,
		trigger = if active ~= nil then active.trigger else self.lastTrigger,
		startedAt = if active ~= nil then active.startedAt else nil,
		clip = clip,
		clipName = if clip ~= nil then clip.name else nil,
		clipIndex = if active ~= nil then active.index else nil,
		track = if active ~= nil then active.track else nil,
	}
end

function Melee:_invokeCallback(name: string, context: { [string]: any })
	local callback = self.callbacks[name]
	if typeof(callback) ~= "function" then
		return
	end
	pcall(callback, self, context)
end

function Melee:_cancelStanceTimer()
	self.stanceTimerToken += 1
end

function Melee:_stopPresentationTrack(fadeTimeRaw: any)
	local track = self.presentationTrack
	self.presentationTrack = nil
	self.presentationState = nil
	self.presentationToken += 1
	self.presentationJanitor:Clean()

	if track ~= nil and track.IsPlaying then
		local fadeTime = toNumber(fadeTimeRaw, 0.08, 0, nil)
		pcall(function()
			track:Stop(fadeTime)
		end)
	end
end

function Melee:_clearNamedTracks()
	self:_stopPresentationTrack(0)

	for _, track in self.namedAnimationTrackCache do
		if track.IsPlaying then
			pcall(function()
				track:Stop(0)
			end)
		end
	end

	self.namedAnimationTrackCache = {}
	self.namedTrackJanitor:Clean()
end

function Melee:_loadNamedAnimationTrack(stateKeyRaw: any): AnimationTrack?
	local stateKey = if typeof(stateKeyRaw) == "string" then stateKeyRaw else nil
	if stateKey == nil then
		return nil
	end

	local cached = self.namedAnimationTrackCache[stateKey]
	if cached ~= nil then
		return cached
	end

	local clip = self.namedAnimationStateClips[stateKey]
	if clip == nil then
		return nil
	end

	local animator = self.controller.animator
	if animator == nil then
		return nil
	end

	local animation = clip.animation
	local destroyGeneratedAnimation = false
	if animation == nil then
		if clip.id == nil then
			return nil
		end
		local generated = Instance.new("Animation")
		generated.Name = clip.name
		generated.AnimationId = clip.id
		animation = generated
		destroyGeneratedAnimation = true
	end

	local ok, trackOrError = pcall(function()
		return animator:LoadAnimation(animation :: Animation)
	end)
	if destroyGeneratedAnimation and animation ~= nil then
		animation:Destroy()
	end
	if not ok then
		return nil
	end

	local track = trackOrError :: AnimationTrack
	if clip.looped ~= nil then
		track.Looped = clip.looped
	end
	if clip.priority ~= nil then
		track.Priority = clip.priority
	end

	self.namedAnimationTrackCache[stateKey] = track
	return track
end

function Melee:_canUseStance(): boolean
	if not self.namedAnimationPlaybackEnabled or not self.stanceEnabled then
		return false
	end
	if not self.isToolEquipped or self.attackActive or self.inputHeld then
		return false
	end
	return self.namedAnimationStateClips.StanceTransition ~= nil or self.namedAnimationStateClips.StanceIdle ~= nil
end

function Melee:_playNamedState(stateKeyRaw: any, optionsRaw: any): boolean
	if not self.namedAnimationPlaybackEnabled then
		return false
	end
	local stateKey = if typeof(stateKeyRaw) == "string" then stateKeyRaw else nil
	if stateKey == nil then
		return false
	end

	local clip = self.namedAnimationStateClips[stateKey]
	if clip == nil then
		return false
	end

	local track = self:_loadNamedAnimationTrack(stateKey)
	if track == nil then
		return false
	end

	local options = if typeof(optionsRaw) == "table" then optionsRaw else {}
	if self.presentationState == stateKey and self.presentationTrack == track and track.IsPlaying then
		return true
	end
	self.presentationToken += 1
	local token = self.presentationToken
	self.presentationJanitor:Clean()
	self:_cancelStanceTimer()

	for _, otherTrack in self.namedAnimationTrackCache do
		if otherTrack ~= track and otherTrack.IsPlaying then
			pcall(function()
				otherTrack:Stop(toNumber(options.stopFadeTime, 0.06, 0, nil))
			end)
		end
	end

	local fadeTime = toNumber(options.fadeTime, clip.fadeTime or 0.08, 0, nil)
	local weight = toNumber(options.weight, clip.weight or 1, 0, nil)
	local speed = toNumber(options.speed, clip.speed or 1, 0.01, nil)
	local ok, err = pcall(function()
		track:Play(fadeTime, weight, speed)
	end)
	if not ok then
		return false
	end

	self.presentationTrack = track
	self.presentationState = stateKey
	local onStopped = options.onStopped
	if typeof(onStopped) == "function" then
		local stoppedConnection = track.Stopped:Connect(function()
			if self.destroyed or token ~= self.presentationToken then
				return
			end
			onStopped()
		end)
		self.presentationJanitor:GiveChore(stoppedConnection)
	end

	return true
end

function Melee:_enterStance()
	if not self:_canUseStance() then
		return
	end

	local playedTransition = self:_playNamedState("StanceTransition", {
		onStopped = function()
			if not self:_canUseStance() then
				return
			end
			self:_playNamedState("StanceIdle")
		end,
	})
	if playedTransition then
		return
	end

	self:_playNamedState("StanceIdle")
end

function Melee:_scheduleStance()
	if not self:_canUseStance() then
		self:_cancelStanceTimer()
		return
	end

	local expectedToken = self.stanceTimerToken + 1
	self.stanceTimerToken = expectedToken
	task.delay(self.stanceDelay, function()
		if self.destroyed or expectedToken ~= self.stanceTimerToken then
			return
		end
		self:_enterStance()
	end)
end

function Melee:_playIdleAndScheduleStance()
	if not self.namedAnimationPlaybackEnabled then
		return
	end
	if not self.isToolEquipped or self.attackActive or self.inputHeld then
		self:_cancelStanceTimer()
		return
	end

	local hasIdle = self.namedAnimationStateClips.Idle ~= nil
	if hasIdle then
		self:_playNamedState("Idle")
	end
	self:_scheduleStance()
end

function Melee:_onToolEquipped()
	self.isToolEquipped = true
	self:_cancelStanceTimer()
	if self.attackActive then
		return
	end

	local playedEquip = self:_playNamedState("Equip", {
		onStopped = function()
			if self.destroyed or not self.isToolEquipped or self.attackActive then
				return
			end
			self:_playIdleAndScheduleStance()
		end,
	})
	if playedEquip then
		return
	end
	self:_playIdleAndScheduleStance()
end

function Melee:_onToolUnequipped()
	self.isToolEquipped = false
	self:_cancelStanceTimer()

	local playedUnequip = self:_playNamedState("Unequip", {
		onStopped = function()
			if self.destroyed then
				return
			end
			self:_stopPresentationTrack(0)
		end,
	})
	if playedUnequip then
		return
	end
	self:_stopPresentationTrack(0.06)
end

function Melee:_onPresentationAnimatorChanged()
	self:_clearNamedTracks()
	if self.destroyed or not self.namedAnimationPlaybackEnabled then
		return
	end
	if self.isToolEquipped and not self.attackActive and not self.inputHeld then
		self:_playIdleAndScheduleStance()
	end
end

function Melee:_resolveCooldown(clipRaw: any): number
	local clip = if typeof(clipRaw) == "table" then clipRaw else nil
	if clip ~= nil and typeof((clip :: any).cooldown) == "number" then
		return toNumber((clip :: any).cooldown, self.cooldown, 0, nil)
	end
	return self.cooldown
end

function Melee:_commitActiveCooldown(startedAtRaw: any?, clipRaw: any?)
	local active = self.active
	if active == nil or active.cooldownCommitted == true then
		return
	end

	local startedAt = toNumber(startedAtRaw, os.clock(), 0, nil)
	local clip = if clipRaw ~= nil then clipRaw else active.clip
	active.cooldownCommitted = true
	self.cooldownUntil = math.max(self.cooldownUntil, startedAt + self:_resolveCooldown(clip))
end

function Melee:_emitSwingStart(eventName: any, eventType: any, param: any, synthetic: boolean?)
	if self.swingStarted then
		return
	end
	self.swingStarted = true
	self.swingWindowOpen = true
	local ctx = self:_context(eventName, eventType, param)
	ctx.synthetic = synthetic == true
	self.signals.swingStarted:Fire(ctx)
	self:_invokeCallback("onSwingStarted", ctx)
end

function Melee:_emitSwingEnd(eventName: any, eventType: any, param: any, synthetic: boolean?)
	if self.swingEnded then
		return
	end
	self.swingEnded = true
	self.swingWindowOpen = false
	local ctx = self:_context(eventName, eventType, param)
	ctx.synthetic = synthetic == true
	self.signals.swingEnded:Fire(ctx)
	self:_invokeCallback("onSwingEnded", ctx)
end

function Melee:_spawnProjectile(eventName: any, eventType: any, param: any)
	if not self.projectileEnabled or self.projectileSpawn == nil then
		return
	end
	local now = os.clock()
	if now - self.lastProjectileAt < self.projectileCooldown then
		return
	end
	self.lastProjectileAt = now
	local ctx = self:_context(eventName, eventType, param)
	self.signals.projectileFired:Fire(ctx)
	self:_invokeCallback("onProjectileFired", ctx)
	pcall(self.projectileSpawn, self, ctx)
end

function Melee:_scheduleRetry(waitTime: number)
	self.retryToken += 1
	local token = self.retryToken
	task.delay(math.max(0, waitTime), function()
		if token ~= self.retryToken or self.destroyed then
			return
		end
		self:_processQueue("CooldownReady")
	end)
end

function Melee:_processQueue(triggerRaw: any)
	if not self.enabled or self.attackActive or not self.queued then
		return
	end
	local now = os.clock()
	if now < self.cooldownUntil then
		self:_scheduleRetry(self.cooldownUntil - now)
		return
	end

	self.queued = false
	self.lastTrigger = trim(triggerRaw)
	if self.lastTrigger == "" then
		self.lastTrigger = "Queue"
	end
	self:_startAttack()
end

function Melee:_startAttack()
	if self.attackActive or not self.enabled then
		return
	end
	self:_cancelStanceTimer()
	self:_stopPresentationTrack(0.05)

	local now = os.clock()
	local shouldResetSequence = not self.inputHeld and (now - self.lastAttackFinishedAt) >= self.slashResetCooldown
	if shouldResetSequence then
		self.controller:resetSequence()
		self.swingCount = 0
	end

	local play = self.controller:playNext(nil)
	local usedSyntheticAttack = false
	if play == nil and self.syntheticAttackWhenNoTrack then
		usedSyntheticAttack = true
		play = {
			track = nil,
			clip = {
				name = "SyntheticSwing",
				cooldown = self.cooldown,
				duration = self.timeout,
			},
			index = 0,
		}
	end

	if play == nil then
		self.queued = true
		self.cooldownUntil = math.max(self.cooldownUntil, os.clock() + self.cooldown)
		self:_scheduleRetry(self.cooldown)
		return
	end

	self.attackActive = true
	self.swingStarted = false
	self.swingEnded = false
	self.swingWindowOpen = false
	self.swingCount += 1
	self.tokenCount += 1
	self.active = {
		token = self.tokenCount,
		swingIndex = self.swingCount,
		trigger = self.lastTrigger,
		startedAt = now,
		track = play.track,
		clip = play.clip,
		index = play.index,
		synthetic = usedSyntheticAttack,
		cooldownCommitted = false,
	}

	if self.cooldownStartsOn == "SwingStart" then
		self:_commitActiveCooldown(now, play.clip)
	end

	local startedContext = self:_context(nil, "AttackStarted", nil)
	self.signals.attackStarted:Fire(startedContext)
	self:_invokeCallback("onAttackStarted", startedContext)

	if self.projectileSpawnOnStart then
		self:_spawnProjectile("attackStart", "Synthetic", nil)
	end

	local clipSpeed = if typeof(play.clip.speed) == "number" and play.clip.speed > 0 then play.clip.speed else 1
	local duration = if typeof(play.clip.duration) == "number"
		then play.clip.duration
		else if play.track ~= nil and play.track.Length > 0 then play.track.Length / clipSpeed else self.timeout
	self.timeoutToken += 1
	local token = self.timeoutToken
	task.delay(math.max(0.01, duration + self.timeoutPadding), function()
		if token ~= self.timeoutToken or self.destroyed then
			return
		end
		if self.attackActive then
			self:_finishAttack("Timeout")
		end
	end)
end

function Melee:_finishAttack(reasonRaw: any)
	if not self.attackActive then
		return
	end
	local reason = trim(reasonRaw)
	if reason == "" then
		reason = "Finished"
	end

	if self.syntheticSwingEvents and not self.swingStarted then
		self:_emitSwingStart("syntheticStart", "Synthetic", nil, true)
	end
	if self.syntheticSwingEvents and not self.swingEnded then
		self:_emitSwingEnd("syntheticEnd", "Synthetic", nil, true)
	end

	local active = self.active
	local activeTrack = if active ~= nil then active.track else nil
	local activeClip = if active ~= nil then active.clip else nil
	if self.cooldownStartsOn == "SwingEnd" then
		self:_commitActiveCooldown(os.clock(), activeClip)
	end

	local finishedContext = self:_context(reason, "AttackFinished", nil)
	finishedContext.reason = reason

	self.attackActive = false
	self.swingWindowOpen = false
	self.active = nil
	self.timeoutToken += 1
	self.lastAttackFinishedAt = os.clock()

	self.signals.attackFinished:Fire(finishedContext)
	self:_invokeCallback("onAttackFinished", finishedContext)

	-- If a track never reported completion, force it down before the next queued swing can begin.
	if reason == "Timeout" and activeTrack ~= nil and activeTrack.IsPlaying then
		pcall(function()
			activeTrack:Stop(toNumber(if activeClip ~= nil then activeClip.fadeTime else nil, 0.02, 0, nil))
		end)
	end

	if not self.inputHeld and self.isToolEquipped then
		self:_playIdleAndScheduleStance()
	end

	if self.autoRepeat and self.inputHeld then
		self:queueSwing("HoldRepeat")
	elseif self.queued then
		self:_processQueue("Pending")
	end
end

function Melee:_onAnimationEvent(
	nameRaw: any,
	eventType: string,
	param: any,
	track: AnimationTrack,
	clip: any,
	index: number
)
	if not self.attackActive or self.active == nil then
		return
	end
	if self.active.track ~= track then
		return
	end

	local normalized = normalizeEventName(nameRaw)
	if normalized == "" then
		return
	end

	if eventType == "Keyframe" and not self.trackAllKeyframes then
		local tracked = self.trackedKeyframes[normalized]
			or self.startEventSet[normalized]
			or self.endEventSet[normalized]
			or self.projectileEventSet[normalized]
		if not tracked then
			return
		end
	end

	self.active.clip = clip
	self.active.index = index

	local eventContext = self:_context(nameRaw, eventType, param)
	self.signals.animationEvent:Fire(eventContext)
	self:_invokeCallback("onAnimationEvent", eventContext)

	if self.startEventSet[normalized] then
		self:_emitSwingStart(nameRaw, eventType, param, false)
	end

	if self.projectileEventSet[normalized] then
		self:_spawnProjectile(nameRaw, eventType, param)
	end

	if self.endEventSet[normalized] then
		self:_emitSwingEnd(nameRaw, eventType, param, false)
		if self.cooldownStartsOn == "SwingEnd" then
			self:_commitActiveCooldown(eventContext.now, clip)
		end
	end
end

function Melee:_onTrackStopped(track: AnimationTrack)
	if not self.attackActive or self.active == nil then
		return
	end
	if self.active.track ~= track then
		return
	end
	if not self.swingEnded then
		self:_emitSwingEnd("trackStopped", "TrackStopped", nil, self.syntheticSwingEvents)
	end
	self:_finishAttack("TrackStopped")
end

function Melee:QueueSwing(triggerRaw: any): boolean
	if not self.enabled then
		return false
	end
	self.queued = true
	self.lastTrigger = trim(triggerRaw)
	if self.lastTrigger == "" then
		self.lastTrigger = "Queue"
	end

	local requestContext = self:_context(nil, "AttackRequested", nil)
	requestContext.trigger = self.lastTrigger
	self.signals.attackRequested:Fire(requestContext)
	self:_invokeCallback("onAttackRequested", requestContext)

	self:_processQueue(self.lastTrigger)
	return true
end

function Melee:InputBegan(triggerRaw: any): boolean
	local wasHeld = self.inputHeld
	self.inputHeld = true
	if wasHeld ~= self.inputHeld then
		self.signals.inputHeldChanged:Fire(self.inputHeld)
	end
	self:_cancelStanceTimer()
	return self:queueSwing(triggerRaw or "InputBegan")
end

function Melee:InputEnded(_: any): boolean
	local wasHeld = self.inputHeld
	self.inputHeld = false
	if wasHeld ~= self.inputHeld then
		self.signals.inputHeldChanged:Fire(self.inputHeld)
	end
	if not self.attackActive and self.isToolEquipped then
		self:_playIdleAndScheduleStance()
	end
	return true
end

function Melee:Tap(triggerRaw: any): boolean
	return self:queueSwing(triggerRaw or "Tap")
end

function Melee:SetEnabled(enabledRaw: any)
	local enabled = toBool(enabledRaw, self.enabled)
	if self.enabled == enabled then
		return
	end
	self.enabled = enabled
	self.signals.enabledChanged:Fire(self.enabled)
	if not enabled then
		self:cancel("Disabled")
	elseif self.queued then
		self:_processQueue("Enabled")
	end
end

function Melee:SetCooldown(secondsRaw: any)
	self.cooldown = toNumber(secondsRaw, self.cooldown, 0, nil)
end

function Melee:SetSlashResetCooldown(secondsRaw: any)
	self.slashResetCooldown = toNumber(secondsRaw, self.slashResetCooldown, 0, nil)
end

function Melee:SetAnimator(animatorRaw: any)
	self.controller:setAnimator(animatorRaw)
	self:_onPresentationAnimatorChanged()
end

function Melee:SetHumanoid(humanoidRaw: any)
	local humanoid = if typeof(humanoidRaw) == "Instance" and humanoidRaw:IsA("Humanoid") then humanoidRaw else nil
	self.controller:setAnimator(createAnimatorFromHumanoid(humanoid))
	self:_onPresentationAnimatorChanged()
end

function Melee:SetCharacter(characterRaw: any)
	local character = if typeof(characterRaw) == "Instance" and characterRaw:IsA("Model") then characterRaw else nil
	self.controller:setAnimator(createAnimatorFromCharacter(character))
	self:_onPresentationAnimatorChanged()
end

function Melee:SetClips(clipsRaw: any)
	self.controller:setClips(clipsRaw)
end

function Melee:SetMode(modeRaw: any)
	self.controller:setMode(modeRaw)
end

function Melee:BindTool(toolRaw: any, optionsRaw: any): boolean
	local tool = if typeof(toolRaw) == "Instance" and toolRaw:IsA("Tool") then toolRaw else nil
	if tool == nil then
		return false
	end

	if self.boundTool ~= nil and self.boundTool ~= tool then
		self:_onToolUnequipped()
	end
	self.toolJanitor:Clean()
	self.boundTool = tool

	local options = if typeof(optionsRaw) == "table" then optionsRaw else {}
	local resolveAnimatorOnEquip = toBool(options.resolveAnimatorOnEquip, true)
	local cancelOnUnequip = toBool(options.cancelOnUnequip, true)

	if resolveAnimatorOnEquip and tool.Parent and tool.Parent:IsA("Model") then
		self:setCharacter(tool.Parent)
	end
	if tool.Parent ~= nil and tool.Parent:IsA("Model") then
		self:_onToolEquipped()
	else
		self.isToolEquipped = false
		self:_cancelStanceTimer()
		self:_stopPresentationTrack(0)
	end

	self.toolJanitor:GiveChore(tool.Equipped:Connect(function()
		if resolveAnimatorOnEquip and tool.Parent and tool.Parent:IsA("Model") then
			self:setCharacter(tool.Parent)
		end
		self:_onToolEquipped()
	end))

	self.toolJanitor:GiveChore(tool.Activated:Connect(function()
		self:inputBegan("ToolActivated")
	end))

	self.toolJanitor:GiveChore(tool.Deactivated:Connect(function()
		self:inputEnded("ToolDeactivated")
	end))

	self.toolJanitor:GiveChore(tool.Unequipped:Connect(function()
		self:_onToolUnequipped()
		self:inputEnded("ToolUnequipped")
		if cancelOnUnequip then
			self:cancel("ToolUnequipped")
		end
	end))

	self.toolJanitor:GiveChore(tool.Destroying:Connect(function()
		if self.boundTool == tool then
			self:unbindTool()
		end
	end))

	return true
end

function Melee:UnbindTool()
	self:_onToolUnequipped()
	self.toolJanitor:Clean()
	self.boundTool = nil
end

function Melee:On(signalNameRaw: any, callback: (...any) -> ()): RBXScriptConnection?
	if typeof(signalNameRaw) ~= "string" or typeof(callback) ~= "function" then
		return nil
	end
	local signalObject = self.signals[signalNameRaw]
	if signalObject == nil then
		return nil
	end
	return (signalObject :: SignalObject):Connect(callback)
end

function Melee:Cancel(reasonRaw: any)
	self.queued = false
	local wasHeld = self.inputHeld
	self.inputHeld = false
	if wasHeld ~= self.inputHeld then
		self.signals.inputHeldChanged:Fire(self.inputHeld)
	end
	self.retryToken += 1
	self:_cancelStanceTimer()
	self.controller:resetSequence()
	self.swingCount = 0
	self.lastAttackFinishedAt = -math.huge

	local activeTrack = if self.active ~= nil then self.active.track else nil
	self:_finishAttack(reasonRaw or "Cancelled")
	if activeTrack ~= nil and activeTrack.IsPlaying then
		pcall(function()
			activeTrack:Stop(0)
		end)
	end
	if self.isToolEquipped then
		self:_playIdleAndScheduleStance()
	else
		self:_stopPresentationTrack(0.05)
	end
end

function Melee:Destroy()
	if self.destroyed then
		return
	end
	self.destroyed = true
	self:unbindTool()
	self:_clearNamedTracks()
	self:cancel("Destroyed")
	self.janitor:Destroy()
end

AnimationController.new = AnimationController.New
AnimationController.setAnimator = AnimationController.SetAnimator
AnimationController.setMode = AnimationController.SetMode
AnimationController.resetSequence = AnimationController.ResetSequence
AnimationController.setMarkers = AnimationController.SetMarkers
AnimationController.getMarkers = AnimationController.GetMarkers
AnimationController.setClips = AnimationController.SetClips
AnimationController.clearTracks = AnimationController.ClearTracks
AnimationController.loadTrack = AnimationController.LoadTrack
AnimationController.pickClipIndex = AnimationController.PickClipIndex
AnimationController.playNext = AnimationController.PlayNext
AnimationController.stopAll = AnimationController.StopAll
AnimationController.destroy = AnimationController.Destroy
Melee.new = Melee.New
Melee.queueSwing = Melee.QueueSwing
Melee.inputBegan = Melee.InputBegan
Melee.inputEnded = Melee.InputEnded
Melee.tap = Melee.Tap
Melee.setEnabled = Melee.SetEnabled
Melee.setCooldown = Melee.SetCooldown
Melee.setSlashResetCooldown = Melee.SetSlashResetCooldown
Melee.setAnimator = Melee.SetAnimator
Melee.setHumanoid = Melee.SetHumanoid
Melee.setCharacter = Melee.SetCharacter
Melee.setClips = Melee.SetClips
Melee.setMode = Melee.SetMode
Melee.bindTool = Melee.BindTool
Melee.unbindTool = Melee.UnbindTool
Melee.on = Melee.On
Melee.cancel = Melee.Cancel
Melee.destroy = Melee.Destroy

return Melee
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="1123">
              <Properties>
                <string name="Name">Npc</string>
                <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local HttpService = game:GetService("HttpService")

local Signal = require(ReplicatedStorage.Packages.Signal)

local Npc = {}
Npc.__index = Npc

export type NpcState = "Idle" | "Moving" | "Attacking" | "Dead"

export type NpcStatsConfig = {
	maxHp: number?,
	hp: number?,
	damage: number?,
	defense: number?,
}

export type NpcMovementConfig = {
	walkSpeed: number?,
	jumpPower: number?,
	canMove: boolean?,
	canWander: boolean?,
	wanderRadius: number?,
	wanderInterval: number?,
	thinkInterval: number?,
	detectionRange: number?,
	loseTargetRange: number?,
	moveRepathDistance: number?,
	autoRotate: boolean?,
}

export type NpcCombatConfig = {
	attackRange: number?,
	attackCooldown: number?,
	minDamage: number?,
	damageVariance: number?,
	targetPlayers: boolean?,
	targetNpcs: boolean?,
	allowFriendlyFire: boolean?,
}

export type NpcBehaviorConfig = {
	acquireTarget: ((self: any) -> any?)?,
	shouldTarget: ((self: any, target: any) -> boolean)?,
	onSpawn: ((self: any) -> ())?,
	onThink: ((self: any, dt: number) -> ())?,
	onAttack: ((self: any, target: any, damage: number) -> ())?,
	onDamageTaken: ((self: any, damage: number, source: any?, hp: number) -> ())?,
	onDeath: ((self: any, killer: any?) -> ())?,
}

export type NpcLifecycleConfig = {
	spawnParent: Instance?,
	spawnCFrame: CFrame?,
	autoStart: boolean?,
	autoDestroyModelOnDeath: boolean?,
}

export type NpcConfig = {
	archetype: string?,
	displayName: string?,
	faction: string?,
	model: Instance? | string?,
	modelName: string?,
	ownerPlayer: Player?,
	stats: NpcStatsConfig?,
	movement: NpcMovementConfig?,
	combat: NpcCombatConfig?,
	behavior: NpcBehaviorConfig?,
	lifecycle: NpcLifecycleConfig?,
	tags: { [string]: boolean }?,
	hp: number?,
	maxHp: number?,
	damage: number?,
	dmg: number?,
	defense: number?,
	def: number?,
}

type SignalObject = {
	Connect: (self: SignalObject, callback: (...any) -> ()) -> RBXScriptConnection,
	Fire: (self: SignalObject, ...any) -> (),
	Destroy: (self: SignalObject) -> (),
}

type NpcSignals = {
	spawned: SignalObject,
	stateChanged: SignalObject,
	targetChanged: SignalObject,
	damaged: SignalObject,
	attacked: SignalObject,
	died: SignalObject,
}

type RuntimeMovementConfig = {
	walkSpeed: number,
	jumpPower: number,
	canMove: boolean,
	canWander: boolean,
	wanderRadius: number,
	wanderInterval: number,
	thinkInterval: number,
	detectionRange: number,
	loseTargetRange: number,
	moveRepathDistance: number,
	autoRotate: boolean,
}

type RuntimeCombatConfig = {
	attackRange: number,
	attackCooldown: number,
	minDamage: number,
	damageVariance: number,
	targetPlayers: boolean,
	targetNpcs: boolean,
	allowFriendlyFire: boolean,
}

type RuntimeLifecycleConfig = {
	spawnParent: Instance,
	spawnCFrame: CFrame?,
	autoStart: boolean,
	autoDestroyModelOnDeath: boolean,
}

type NormalizedNpcConfig = {
	archetype: string,
	displayName: string,
	faction: string,
	ownerPlayer: Player?,
	modelTemplate: Model?,
	stats: {
		maxHp: number,
		hp: number,
		damage: number,
		defense: number,
	},
	movement: RuntimeMovementConfig,
	combat: RuntimeCombatConfig,
	behavior: NpcBehaviorConfig,
	lifecycle: RuntimeLifecycleConfig,
	tags: { [string]: boolean },
}

export type Npc = typeof(setmetatable(
	{} :: {
		_isNpcInstance: boolean,
		_isDestroyed: boolean,
		uniqueId: string,
		archetype: string,
		displayName: string,
		faction: string,
		ownerPlayer: Player?,
		modelTemplate: Model?,
		model: Model?,
		humanoid: Humanoid?,
		rootPart: BasePart?,
		maxHp: number,
		hp: number,
		damage: number,
		defense: number,
		dmg: number,
		def: number,
		movement: RuntimeMovementConfig,
		combat: RuntimeCombatConfig,
		behavior: NpcBehaviorConfig,
		lifecycle: RuntimeLifecycleConfig,
		tags: { [string]: boolean },
		signals: NpcSignals,
		state: NpcState,
		currentTarget: any?,
		spawnCFrame: CFrame?,
		isSpawned: boolean,
		isAlive: boolean,
		npcs: { [string]: Npc },
		_thinkAccumulator: number,
		_lastAttackAt: number,
		_lastWanderAt: number,
		_lastMoveTarget: Vector3?,
		_heartbeatConnection: RBXScriptConnection?,
	},
	Npc
))
export type npc = Npc

local DEFAULT_ARCHETYPE = "GenericNpc"
local DEFAULT_FACTION = "Neutral"
local DEFAULT_MAX_HP = 100
local DEFAULT_DAMAGE = 10
local DEFAULT_DEFENSE = 0

local DEFAULT_WALK_SPEED = 8
local DEFAULT_JUMP_POWER = 50
local DEFAULT_DETECTION_RANGE = 45
local DEFAULT_LOSE_TARGET_RANGE = 65
local DEFAULT_WANDER_RADIUS = 25
local DEFAULT_WANDER_INTERVAL = 2.5
local DEFAULT_THINK_INTERVAL = 0.2
local DEFAULT_MOVE_REPATH_DISTANCE = 2

local DEFAULT_ATTACK_RANGE = 4
local DEFAULT_ATTACK_COOLDOWN = 1.1
local DEFAULT_MIN_DAMAGE = 1
local DEFAULT_DAMAGE_VARIANCE = 0.1

local ACTIVE_NPCS_BY_ID: { [string]: Npc } = {}
local ACTIVE_NPCS_BY_MODEL: { [Model]: Npc } = {}

local assetsFolder = ReplicatedStorage:FindFirstChild("Assets")
local npcAssetFolder = if assetsFolder then assetsFolder:FindFirstChild("Npcs") else nil
local NPC_ASSET_FOLDER: Instance? = npcAssetFolder

local RANDOM = Random.new()

local function sanitizeNumber(value: any, fallback: number, minimum: number?, maximum: number?): number
	local numeric = fallback
	if typeof(value) == "number" and value == value then
		numeric = value
	end

	if minimum ~= nil and numeric < minimum then
		numeric = minimum
	end

	if maximum ~= nil and numeric > maximum then
		numeric = maximum
	end

	return numeric
end

local function sanitizeString(value: any, fallback: string): string
	if typeof(value) ~= "string" then
		return fallback
	end
	if value == "" then
		return fallback
	end
	return value
end

local function sanitizeBoolean(value: any, fallback: boolean): boolean
	if typeof(value) == "boolean" then
		return value
	end
	return fallback
end

local function sanitizeTags(rawTags: any): { [string]: boolean }
	local out: { [string]: boolean } = {}
	if typeof(rawTags) ~= "table" then
		return out
	end

	for key, value in rawTags do
		if typeof(key) == "string" then
			out[key] = value == true
		end
	end

	return out
end

local function asPlayer(value: any): Player?
	if typeof(value) == "Instance" and value:IsA("Player") then
		return value
	end
	return nil
end

local function asFunction(value: any): ((...any) -> ())?
	if typeof(value) == "function" then
		return value
	end
	return nil
end

local function splitModelPathTokens(modelPath: string): { string }
	local normalized = string.gsub(modelPath, "\\", "/")
	normalized = string.gsub(normalized, "%.", "/")

	local out = {}
	for token in string.gmatch(normalized, "[^/]+") do
		if token ~= "" then
			table.insert(out, token)
		end
	end
	return out
end

local function resolveModelFromAssetFolder(modelName: string): Model?
	if NPC_ASSET_FOLDER == nil then
		return nil
	end

	local pathTokens = splitModelPathTokens(modelName)
	if #pathTokens > 1 then
		local cursor: Instance? = NPC_ASSET_FOLDER
		for _, token in pathTokens do
			if cursor == nil then
				return nil
			end
			cursor = cursor:FindFirstChild(token)
		end

		if cursor and cursor:IsA("Model") then
			return cursor
		end
	end

	local candidate = NPC_ASSET_FOLDER:FindFirstChild(modelName)
	if candidate and candidate:IsA("Model") then
		return candidate
	end

	local targetName = if #pathTokens > 0 then pathTokens[#pathTokens] else modelName
	local targetNameLower = string.lower(targetName)
	for _, descendant in NPC_ASSET_FOLDER:GetDescendants() do
		if descendant:IsA("Model") and string.lower(descendant.Name) == targetNameLower then
			return descendant
		end
	end

	return nil
end

local function resolveModelTemplate(rawModel: any, rawModelName: any, archetype: string): Model?
	if typeof(rawModel) == "Instance" and rawModel:IsA("Model") then
		return rawModel
	end

	if typeof(rawModel) == "string" and rawModel ~= "" then
		local byRawModelName = resolveModelFromAssetFolder(rawModel)
		if byRawModelName then
			return byRawModelName
		end
	end

	if typeof(rawModelName) == "string" and rawModelName ~= "" then
		local byModelName = resolveModelFromAssetFolder(rawModelName)
		if byModelName then
			return byModelName
		end
	end

	if archetype ~= "" then
		local byArchetype = resolveModelFromAssetFolder(archetype)
		if byArchetype then
			return byArchetype
		end
	end

	return nil
end

local function resolveHumanoidFromModel(model: Model?): Humanoid?
	if model == nil then
		return nil
	end
	return model:FindFirstChildOfClass("Humanoid")
end

local function resolveRootPart(model: Model?): BasePart?
	if model == nil then
		return nil
	end

	local humanoidRootPart = model:FindFirstChild("HumanoidRootPart")
	if humanoidRootPart and humanoidRootPart:IsA("BasePart") then
		return humanoidRootPart
	end

	if model.PrimaryPart then
		return model.PrimaryPart
	end

	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") then
			return descendant
		end
	end

	return nil
end

local function isNpcInstance(value: any): boolean
	return typeof(value) == "table" and (value :: any)._isNpcInstance == true
end

local function resolveModelFromTarget(target: any): Model?
	if target == nil then
		return nil
	end

	if isNpcInstance(target) then
		return (target :: Npc).model
	end

	if typeof(target) ~= "Instance" then
		return nil
	end

	if target:IsA("Player") then
		local character = target.Character
		if character and character:IsA("Model") then
			return character
		end
		return nil
	end

	if target:IsA("Model") then
		return target
	end

	if target:IsA("Humanoid") then
		local parentModel = target.Parent
		if parentModel and parentModel:IsA("Model") then
			return parentModel
		end
		return nil
	end

	if target:IsA("BasePart") then
		return target:FindFirstAncestorOfClass("Model")
	end

	return nil
end

local function resolveHumanoidFromTarget(target: any): Humanoid?
	if target == nil then
		return nil
	end

	if isNpcInstance(target) then
		return (target :: Npc).humanoid
	end

	if typeof(target) == "Instance" and target:IsA("Humanoid") then
		return target
	end

	local model = resolveModelFromTarget(target)
	return resolveHumanoidFromModel(model)
end

local function resolvePositionFromTarget(target: any): Vector3?
	if target == nil then
		return nil
	end

	if typeof(target) == "Vector3" then
		return target
	end

	if isNpcInstance(target) then
		return (target :: Npc):getPosition()
	end

	if typeof(target) == "Instance" then
		if target:IsA("BasePart") then
			return target.Position
		end

		if target:IsA("Player") then
			local character = target.Character
			local rootPart = resolveRootPart(character)
			if rootPart then
				return rootPart.Position
			end
			return nil
		end
	end

	local model = resolveModelFromTarget(target)
	local rootPart = resolveRootPart(model)
	if rootPart then
		return rootPart.Position
	end

	return nil
end

local function resolveNpcFromTarget(target: any): Npc?
	if isNpcInstance(target) then
		return target :: Npc
	end

	local model = resolveModelFromTarget(target)
	if model == nil then
		return nil
	end

	return ACTIVE_NPCS_BY_MODEL[model]
end

local function disconnectConnection(connection: RBXScriptConnection?)
	if connection then
		connection:Disconnect()
	end
end

local function normalizeConfig(
	configOrHp: NpcConfig | number,
	damage: number?,
	defense: number?,
	legacyModel: Instance?
): NormalizedNpcConfig
	local rawConfig: any = {}
	local legacyHp = DEFAULT_MAX_HP
	local legacyDamage = DEFAULT_DAMAGE
	local legacyDefense = DEFAULT_DEFENSE
	local legacyTemplate: any = legacyModel

	if typeof(configOrHp) == "table" then
		rawConfig = configOrHp
		if rawConfig.model ~= nil then
			legacyTemplate = rawConfig.model
		end
	else
		legacyHp = sanitizeNumber(configOrHp, DEFAULT_MAX_HP, 1, nil)
		legacyDamage = sanitizeNumber(damage, DEFAULT_DAMAGE, 0, nil)
		legacyDefense = sanitizeNumber(defense, DEFAULT_DEFENSE, 0, nil)
	end

	local rawStats = if typeof(rawConfig.stats) == "table" then rawConfig.stats else {}
	local maxHp = sanitizeNumber(rawStats.maxHp or rawConfig.maxHp or rawConfig.hp, legacyHp, 1, nil)
	local hp = sanitizeNumber(rawStats.hp or rawConfig.hp, maxHp, 0, maxHp)
	local baseDamage = sanitizeNumber(rawStats.damage or rawConfig.damage or rawConfig.dmg, legacyDamage, 0, nil)
	local baseDefense = sanitizeNumber(rawStats.defense or rawConfig.defense or rawConfig.def, legacyDefense, 0, nil)

	local archetype = sanitizeString(rawConfig.archetype, DEFAULT_ARCHETYPE)
	local displayName = sanitizeString(rawConfig.displayName, archetype)
	local faction = sanitizeString(rawConfig.faction, DEFAULT_FACTION)
	local ownerPlayer = asPlayer(rawConfig.ownerPlayer)

	local modelTemplate = resolveModelTemplate(legacyTemplate, rawConfig.modelName, archetype)

	local rawMovement = if typeof(rawConfig.movement) == "table" then rawConfig.movement else {}
	local detectionRange = sanitizeNumber(rawMovement.detectionRange, DEFAULT_DETECTION_RANGE, 0, nil)
	local loseTargetRange = sanitizeNumber(rawMovement.loseTargetRange, DEFAULT_LOSE_TARGET_RANGE, detectionRange, nil)

	local movement: RuntimeMovementConfig = {
		walkSpeed = sanitizeNumber(rawMovement.walkSpeed, DEFAULT_WALK_SPEED, 0, nil),
		jumpPower = sanitizeNumber(rawMovement.jumpPower, DEFAULT_JUMP_POWER, 0, nil),
		canMove = sanitizeBoolean(rawMovement.canMove, true),
		canWander = sanitizeBoolean(rawMovement.canWander, true),
		wanderRadius = sanitizeNumber(rawMovement.wanderRadius, DEFAULT_WANDER_RADIUS, 0, nil),
		wanderInterval = sanitizeNumber(rawMovement.wanderInterval, DEFAULT_WANDER_INTERVAL, 0.1, nil),
		thinkInterval = sanitizeNumber(rawMovement.thinkInterval, DEFAULT_THINK_INTERVAL, 0.03, nil),
		detectionRange = detectionRange,
		loseTargetRange = loseTargetRange,
		moveRepathDistance = sanitizeNumber(rawMovement.moveRepathDistance, DEFAULT_MOVE_REPATH_DISTANCE, 0, nil),
		autoRotate = sanitizeBoolean(rawMovement.autoRotate, true),
	}

	local rawCombat = if typeof(rawConfig.combat) == "table" then rawConfig.combat else {}
	local combat: RuntimeCombatConfig = {
		attackRange = sanitizeNumber(rawCombat.attackRange, DEFAULT_ATTACK_RANGE, 0, nil),
		attackCooldown = sanitizeNumber(rawCombat.attackCooldown, DEFAULT_ATTACK_COOLDOWN, 0, nil),
		minDamage = sanitizeNumber(rawCombat.minDamage, DEFAULT_MIN_DAMAGE, 0, nil),
		damageVariance = sanitizeNumber(rawCombat.damageVariance, DEFAULT_DAMAGE_VARIANCE, 0, 1),
		targetPlayers = sanitizeBoolean(rawCombat.targetPlayers, true),
		targetNpcs = sanitizeBoolean(rawCombat.targetNpcs, true),
		allowFriendlyFire = sanitizeBoolean(rawCombat.allowFriendlyFire, false),
	}

	local rawLifecycle = if typeof(rawConfig.lifecycle) == "table" then rawConfig.lifecycle else {}
	local spawnParent = if typeof(rawLifecycle.spawnParent) == "Instance" then rawLifecycle.spawnParent else Workspace
	local spawnCFrame = if typeof(rawLifecycle.spawnCFrame) == "CFrame" then rawLifecycle.spawnCFrame else nil
	local lifecycle: RuntimeLifecycleConfig = {
		spawnParent = spawnParent,
		spawnCFrame = spawnCFrame,
		autoStart = sanitizeBoolean(rawLifecycle.autoStart, false),
		autoDestroyModelOnDeath = sanitizeBoolean(rawLifecycle.autoDestroyModelOnDeath, true),
	}

	local rawBehavior = if typeof(rawConfig.behavior) == "table" then rawConfig.behavior else {}
	local behavior: NpcBehaviorConfig = {
		acquireTarget = asFunction(rawBehavior.acquireTarget) :: any,
		shouldTarget = asFunction(rawBehavior.shouldTarget) :: any,
		onSpawn = asFunction(rawBehavior.onSpawn) :: any,
		onThink = asFunction(rawBehavior.onThink) :: any,
		onAttack = asFunction(rawBehavior.onAttack) :: any,
		onDamageTaken = asFunction(rawBehavior.onDamageTaken) :: any,
		onDeath = asFunction(rawBehavior.onDeath) :: any,
	}

	return {
		archetype = archetype,
		displayName = displayName,
		faction = faction,
		ownerPlayer = ownerPlayer,
		modelTemplate = modelTemplate,
		stats = {
			maxHp = maxHp,
			hp = hp,
			damage = baseDamage,
			defense = baseDefense,
		},
		movement = movement,
		combat = combat,
		behavior = behavior,
		lifecycle = lifecycle,
		tags = sanitizeTags(rawConfig.tags),
	}
end

local function registerNpc(npcObject: Npc)
	ACTIVE_NPCS_BY_ID[npcObject.uniqueId] = npcObject
	if npcObject.model ~= nil then
		ACTIVE_NPCS_BY_MODEL[npcObject.model] = npcObject
	end
end

local function unregisterNpc(npcObject: Npc)
	ACTIVE_NPCS_BY_ID[npcObject.uniqueId] = nil
	if npcObject.model ~= nil then
		ACTIVE_NPCS_BY_MODEL[npcObject.model] = nil
	end
end

function Npc.New(configOrHp: NpcConfig | number, damage: number?, defense: number?, model: Instance?): Npc
	local normalized = normalizeConfig(configOrHp, damage, defense, model)

	local self = setmetatable({
		_isNpcInstance = true,
		_isDestroyed = false,
		uniqueId = HttpService:GenerateGUID(false),
		archetype = normalized.archetype,
		displayName = normalized.displayName,
		faction = normalized.faction,
		ownerPlayer = normalized.ownerPlayer,
		modelTemplate = normalized.modelTemplate,
		model = nil,
		humanoid = nil,
		rootPart = nil,
		maxHp = normalized.stats.maxHp,
		hp = normalized.stats.hp,
		damage = normalized.stats.damage,
		defense = normalized.stats.defense,
		dmg = normalized.stats.damage,
		def = normalized.stats.defense,
		movement = normalized.movement,
		combat = normalized.combat,
		behavior = normalized.behavior,
		lifecycle = normalized.lifecycle,
		tags = normalized.tags,
		signals = {
			spawned = Signal.new(),
			stateChanged = Signal.new(),
			targetChanged = Signal.new(),
			damaged = Signal.new(),
			attacked = Signal.new(),
			died = Signal.new(),
		},
		state = "Idle" :: NpcState,
		currentTarget = nil,
		spawnCFrame = normalized.lifecycle.spawnCFrame,
		isSpawned = false,
		isAlive = false,
		npcs = ACTIVE_NPCS_BY_ID,
		_thinkAccumulator = 0,
		_lastAttackAt = -math.huge,
		_lastWanderAt = 0,
		_lastMoveTarget = nil,
		_heartbeatConnection = nil,
	}, Npc)

	if self.lifecycle.autoStart then
		self:start(self.lifecycle.spawnCFrame)
	end

	return self
end

function Npc.IsNpc(value: any): boolean
	return isNpcInstance(value)
end

function Npc.GetById(uniqueId: string): Npc?
	return ACTIVE_NPCS_BY_ID[uniqueId]
end

function Npc.GetByModel(model: Model?): Npc?
	if model == nil then
		return nil
	end
	return ACTIVE_NPCS_BY_MODEL[model]
end

function Npc.GetAllActive(): { Npc }
	local out = {}
	for _, candidate in ACTIVE_NPCS_BY_ID do
		table.insert(out, candidate)
	end
	return out
end

function Npc._setState(self: Npc, nextState: NpcState)
	if self.state == nextState then
		return
	end

	local previousState = self.state
	self.state = nextState
	self.signals.stateChanged:Fire(nextState, previousState)
end

function Npc._rebuildRigRefs(self: Npc)
	local model = self.model
	if model == nil then
		self.humanoid = nil
		self.rootPart = nil
		return
	end

	self.humanoid = resolveHumanoidFromModel(model)
	self.rootPart = resolveRootPart(model)

	if model.PrimaryPart == nil and self.rootPart ~= nil then
		model.PrimaryPart = self.rootPart
	end

	if self.humanoid then
		self.humanoid.WalkSpeed = self.movement.walkSpeed
		self.humanoid.AutoRotate = self.movement.autoRotate
		if self.humanoid.UseJumpPower then
			self.humanoid.JumpPower = self.movement.jumpPower
		else
			self.humanoid.JumpHeight = math.max(0, self.movement.jumpPower * 0.06)
		end
	end
end

function Npc._disconnectRuntime(self: Npc)
	disconnectConnection(self._heartbeatConnection)
	self._heartbeatConnection = nil
	self._thinkAccumulator = 0
	self._lastMoveTarget = nil
end

function Npc._startThinkLoop(self: Npc)
	if self._heartbeatConnection ~= nil then
		return
	end

	self._heartbeatConnection = RunService.Heartbeat:Connect(function(dt: number)
		self:_onHeartbeat(dt)
	end)
end

function Npc.Start(self: Npc, spawnCFrame: CFrame?): Model?
	if self._isDestroyed then
		return nil
	end

	if self.isSpawned and self.model ~= nil then
		return self.model
	end

	if self.modelTemplate == nil then
		return nil
	end

	local model = self.modelTemplate:Clone()
	model.Parent = self.lifecycle.spawnParent

	local desiredCFrame = if spawnCFrame ~= nil then spawnCFrame else self.lifecycle.spawnCFrame
	if desiredCFrame ~= nil then
		model:PivotTo(desiredCFrame)
	end

	self.model = model
	self:_rebuildRigRefs()
	self.spawnCFrame = model:GetPivot()

	if self.hp <= 0 then
		self.hp = self.maxHp
	end

	self.isSpawned = true
	self.isAlive = true
	self._lastAttackAt = -math.huge
	self._lastWanderAt = os.clock()
	self:_setState("Idle")

	registerNpc(self)

	self:_startThinkLoop()
	self.signals.spawned:Fire(model)

	local onSpawn = self.behavior.onSpawn
	if onSpawn then
		onSpawn(self)
	end

	return model
end

function Npc.Respawn(self: Npc, spawnCFrame: CFrame?): Model?
	if self.model then
		unregisterNpc(self)
		self.model:Destroy()
	end

	self.model = nil
	self.humanoid = nil
	self.rootPart = nil
	self.isSpawned = false
	self.isAlive = false
	self.hp = self.maxHp

	return self:start(spawnCFrame)
end

function Npc.Stop(self: Npc, removeModel: boolean?)
	if self._isDestroyed then
		return
	end

	unregisterNpc(self)
	self:_disconnectRuntime()
	self:clearTarget()
	self.isAlive = false

	if self.state ~= "Dead" then
		self:_setState("Idle")
	end

	if removeModel == true and self.model ~= nil then
		self.model:Destroy()
		self.model = nil
		self.humanoid = nil
		self.rootPart = nil
		self.isSpawned = false
	end
end

function Npc.Destroy(self: Npc)
	if self._isDestroyed then
		return
	end

	self:stop(true)
	self._isDestroyed = true

	for _, signalObject in self.signals do
		signalObject:Destroy()
	end
end

function Npc.GetPosition(self: Npc): Vector3?
	local rootPart = self.rootPart
	if rootPart then
		return rootPart.Position
	end

	if self.model then
		return self.model:GetPivot().Position
	end

	return nil
end

function Npc.GetDistanceTo(self: Npc, target: any): number?
	local ownPosition = self:getPosition()
	local targetPosition = resolvePositionFromTarget(target)
	if ownPosition == nil or targetPosition == nil then
		return nil
	end

	return (targetPosition - ownPosition).Magnitude
end
function Npc.IsTargetValid(self: Npc, target: any): boolean
	if target == nil then
		return false
	end

	local targetPosition = resolvePositionFromTarget(target)
	local ownPosition = self:getPosition()
	if targetPosition == nil or ownPosition == nil then
		return false
	end

	if typeof(target) == "Vector3" then
		return true
	end

	local targetNpc = resolveNpcFromTarget(target)
	if targetNpc ~= nil then
		if targetNpc == self then
			return false
		end
		if not targetNpc.isAlive then
			return false
		end
		if (not self.combat.allowFriendlyFire) and targetNpc.faction == self.faction then
			return false
		end
	end

	local targetIsAlive = false
	if targetNpc ~= nil then
		targetIsAlive = targetNpc.isAlive
	else
		local targetHumanoid = resolveHumanoidFromTarget(target)
		if targetHumanoid ~= nil and targetHumanoid.Health > 0 then
			targetIsAlive = true
		end
	end
	if not targetIsAlive then
		return false
	end

	local distance = (targetPosition - ownPosition).Magnitude
	if distance > self.movement.loseTargetRange then
		return false
	end

	local shouldTarget = self.behavior.shouldTarget
	if shouldTarget then
		return shouldTarget(self, target)
	end

	return true
end

function Npc._isFriendlyPlayer(self: Npc, player: Player): boolean
	if self.combat.allowFriendlyFire then
		return false
	end

	if self.ownerPlayer and player == self.ownerPlayer then
		return true
	end

	local playerTeam = player.Team
	if playerTeam and playerTeam.Name == self.faction then
		return true
	end

	return false
end

function Npc.AcquireTarget(self: Npc): any?
	local customAcquire = self.behavior.acquireTarget
	if customAcquire then
		local customTarget = customAcquire(self)
		if customTarget ~= nil and self:isTargetValid(customTarget) then
			return customTarget
		end
	end

	local ownPosition = self:getPosition()
	if ownPosition == nil then
		return nil
	end

	local detectionRangeSquared = self.movement.detectionRange * self.movement.detectionRange
	local nearestDistanceSquared = detectionRangeSquared
	local nearestTarget: any = nil

	local function considerTarget(candidateTarget: any)
		local candidatePosition = resolvePositionFromTarget(candidateTarget)
		if candidatePosition == nil then
			return
		end

		local offset = candidatePosition - ownPosition
		local distanceSquared = offset:Dot(offset)
		if distanceSquared > nearestDistanceSquared then
			return
		end

		if not self:isTargetValid(candidateTarget) then
			return
		end

		nearestDistanceSquared = distanceSquared
		nearestTarget = candidateTarget
	end

	if self.combat.targetPlayers then
		for _, player in Players:GetPlayers() do
			if not self:_isFriendlyPlayer(player) then
				considerTarget(player)
			end
		end
	end

	if self.combat.targetNpcs then
		for _, npcObject in ACTIVE_NPCS_BY_ID do
			if npcObject ~= self then
				considerTarget(npcObject)
			end
		end
	end

	return nearestTarget
end

function Npc.SetTarget(self: Npc, target: any?): boolean
	if target == nil then
		self:clearTarget()
		return false
	end

	if not self:isTargetValid(target) then
		return false
	end

	local previousTarget = self.currentTarget
	self.currentTarget = target
	self.signals.targetChanged:Fire(target, previousTarget)
	return true
end

function Npc.ClearTarget(self: Npc)
	if self.currentTarget == nil then
		return
	end

	local previousTarget = self.currentTarget
	self.currentTarget = nil
	self.signals.targetChanged:Fire(nil, previousTarget)
end

function Npc.MoveTo(self: Npc, targetPosition: Vector3): boolean
	if self._isDestroyed or not self.isAlive then
		return false
	end
	if not self.movement.canMove then
		return false
	end

	if self.model == nil then
		return false
	end

	local rootPart = self.rootPart
	if rootPart == nil then
		self:_rebuildRigRefs()
		rootPart = self.rootPart
		if rootPart == nil then
			return false
		end
	end

	if self._lastMoveTarget ~= nil then
		local distanceToPreviousMoveTarget = (targetPosition - self._lastMoveTarget).Magnitude
		if distanceToPreviousMoveTarget < self.movement.moveRepathDistance then
			return true
		end
	end
	self._lastMoveTarget = targetPosition

	if self.humanoid then
		self.humanoid:MoveTo(targetPosition)
	else
		local direction = targetPosition - rootPart.Position
		local destination = CFrame.new(targetPosition)
		if direction.Magnitude > 0.01 then
			destination = CFrame.lookAt(targetPosition, targetPosition + direction.Unit, Vector3.new(0, 1, 0))
		end
		self.model:PivotTo(destination)
	end

	self:_setState("Moving")
	return true
end

function Npc.MoveInDirection(self: Npc, direction: Vector3, distance: number?): boolean
	local ownPosition = self:getPosition()
	if ownPosition == nil then
		return false
	end
	if direction.Magnitude <= 0 then
		return false
	end

	local moveDistance = sanitizeNumber(distance, 1, 0, nil)
	local moveTarget = ownPosition + direction.Unit * moveDistance
	return self:moveTo(moveTarget)
end

function Npc.StopMoving(self: Npc)
	if self.humanoid then
		self.humanoid:Move(Vector3.zero, true)
	end
	self._lastMoveTarget = nil
	if self.state ~= "Dead" then
		self:_setState("Idle")
	end
end

function Npc.Jump(self: Npc): boolean
	if self._isDestroyed or not self.isAlive then
		return false
	end
	if self.humanoid == nil then
		return false
	end

	self.humanoid.Jump = true
	return true
end

function Npc.RollDamage(self: Npc, rawDamage: number?): number
	local damage = sanitizeNumber(rawDamage, self.damage, 0, nil)
	if damage <= 0 then
		return 0
	end

	local variance = self.combat.damageVariance
	if variance > 0 then
		local multiplier = RANDOM:NextNumber(1 - variance, 1 + variance)
		damage *= multiplier
	end

	damage = math.floor(damage + 0.5)
	return math.max(self.combat.minDamage, damage)
end

function Npc.TakeDamage(self: Npc, rawDamage: number, source: any?): number
	if self._isDestroyed or not self.isAlive then
		return 0
	end

	local incomingDamage = sanitizeNumber(rawDamage, 0, 0, nil)
	if incomingDamage <= 0 then
		return 0
	end

	local mitigatedDamage = incomingDamage - self.defense
	if mitigatedDamage <= 0 then
		mitigatedDamage = self.combat.minDamage
	end
	mitigatedDamage = math.floor(mitigatedDamage + 0.5)

	self.hp = math.max(0, self.hp - mitigatedDamage)
	self.signals.damaged:Fire(mitigatedDamage, source, self.hp)

	local onDamageTaken = self.behavior.onDamageTaken
	if onDamageTaken then
		onDamageTaken(self, mitigatedDamage, source, self.hp)
	end

	if self.hp <= 0 then
		self:die(source)
	end

	return mitigatedDamage
end

function Npc.Heal(self: Npc, rawAmount: number): number
	if self._isDestroyed then
		return 0
	end

	local healAmount = sanitizeNumber(rawAmount, 0, 0, nil)
	if healAmount <= 0 then
		return 0
	end

	local hpBefore = self.hp
	self.hp = math.min(self.maxHp, self.hp + healAmount)
	return self.hp - hpBefore
end

function Npc.GiveDamage(self: Npc, target: any, rawDamage: number?): number
	if self._isDestroyed or not self.isAlive then
		return 0
	end

	local finalDamage = self:rollDamage(rawDamage)
	if finalDamage <= 0 then
		return 0
	end

	local targetNpc = resolveNpcFromTarget(target)
	if targetNpc ~= nil then
		if targetNpc == self then
			return 0
		end
		return targetNpc:takeDamage(finalDamage, self)
	end

	local targetHumanoid = resolveHumanoidFromTarget(target)
	if targetHumanoid == nil or targetHumanoid.Health <= 0 then
		return 0
	end

	targetHumanoid:TakeDamage(finalDamage)
	return finalDamage
end

function Npc.CanAttackTarget(self: Npc, target: any): boolean
	if self._isDestroyed or not self.isAlive then
		return false
	end
	if not self:isTargetValid(target) then
		return false
	end

	local ownPosition = self:getPosition()
	local targetPosition = resolvePositionFromTarget(target)
	if ownPosition == nil or targetPosition == nil then
		return false
	end

	return (targetPosition - ownPosition).Magnitude <= self.combat.attackRange
end

function Npc.Attack(self: Npc, target: any?): (boolean, number)
	if self._isDestroyed or not self.isAlive then
		return false, 0
	end

	local targetObject = if target ~= nil then target else self.currentTarget
	if targetObject == nil then
		return false, 0
	end

	local now = os.clock()
	local timeSinceLastAttack = now - self._lastAttackAt
	if timeSinceLastAttack < self.combat.attackCooldown then
		return false, 0
	end

	if not self:canAttackTarget(targetObject) then
		return false, 0
	end

	local damageDealt = self:giveDamage(targetObject)
	if damageDealt <= 0 then
		return false, 0
	end

	self._lastAttackAt = now
	self:_setState("Attacking")
	self.signals.attacked:Fire(targetObject, damageDealt)

	local onAttack = self.behavior.onAttack
	if onAttack then
		onAttack(self, targetObject, damageDealt)
	end

	return true, damageDealt
end

function Npc._tryWander(self: Npc)
	if not self.movement.canWander or not self.movement.canMove then
		return
	end
	if self.spawnCFrame == nil then
		return
	end

	local now = os.clock()
	local elapsed = now - self._lastWanderAt
	if elapsed < self.movement.wanderInterval then
		return
	end

	self._lastWanderAt = now

	local angle = RANDOM:NextNumber(0, math.pi * 2)
	local radius = RANDOM:NextNumber(0, self.movement.wanderRadius)
	local offset = Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
	local destination = self.spawnCFrame.Position + offset
	self:moveTo(destination)
end

function Npc._tickBehavior(self: Npc, dt: number)
	local onThink = self.behavior.onThink
	if onThink then
		onThink(self, dt)
	end

	local currentTarget = self.currentTarget
	if currentTarget ~= nil and not self:isTargetValid(currentTarget) then
		self:clearTarget()
		currentTarget = nil
	end

	if currentTarget == nil then
		local acquired = self:acquireTarget()
		if acquired ~= nil then
			self:setTarget(acquired)
			currentTarget = self.currentTarget
		end
	end

	if currentTarget ~= nil then
		if self:canAttackTarget(currentTarget) then
			local attacked = self:attack(currentTarget)
			if not attacked then
				local targetPosition = resolvePositionFromTarget(currentTarget)
				if targetPosition then
					self:moveTo(targetPosition)
				end
			end
		else
			local targetPosition = resolvePositionFromTarget(currentTarget)
			if targetPosition then
				self:moveTo(targetPosition)
			else
				self:clearTarget()
			end
		end
		return
	end

	self:_tryWander()
	if self.state ~= "Dead" and self.state ~= "Moving" then
		self:_setState("Idle")
	end
end

function Npc._onHeartbeat(self: Npc, dt: number)
	if self._isDestroyed or not self.isAlive then
		return
	end

	self._thinkAccumulator += dt
	if self._thinkAccumulator < self.movement.thinkInterval then
		return
	end

	local thinkDt = self._thinkAccumulator
	self._thinkAccumulator = 0
	self:_tickBehavior(thinkDt)
end

function Npc.Die(self: Npc, killer: any?)
	if self._isDestroyed or not self.isAlive then
		return
	end

	self.isAlive = false
	self.hp = 0
	self:clearTarget()
	self:_disconnectRuntime()
	unregisterNpc(self)
	self:_setState("Dead")

	self.signals.died:Fire(killer)

	local onDeath = self.behavior.onDeath
	if onDeath then
		onDeath(self, killer)
	end

	if self.lifecycle.autoDestroyModelOnDeath and self.model ~= nil then
		self.model:Destroy()
		self.model = nil
		self.humanoid = nil
		self.rootPart = nil
		self.isSpawned = false
	end
end

Npc.new = Npc.New
Npc.isNpc = Npc.IsNpc
Npc.getById = Npc.GetById
Npc.getByModel = Npc.GetByModel
Npc.getAllActive = Npc.GetAllActive
Npc.start = Npc.Start
Npc.respawn = Npc.Respawn
Npc.stop = Npc.Stop
Npc.destroy = Npc.Destroy
Npc.getPosition = Npc.GetPosition
Npc.getDistanceTo = Npc.GetDistanceTo
Npc.isTargetValid = Npc.IsTargetValid
Npc.acquireTarget = Npc.AcquireTarget
Npc.setTarget = Npc.SetTarget
Npc.clearTarget = Npc.ClearTarget
Npc.moveTo = Npc.MoveTo
Npc.moveInDirection = Npc.MoveInDirection
Npc.stopMoving = Npc.StopMoving
Npc.jump = Npc.Jump
Npc.rollDamage = Npc.RollDamage
Npc.takeDamage = Npc.TakeDamage
Npc.heal = Npc.Heal
Npc.giveDamage = Npc.GiveDamage
Npc.canAttackTarget = Npc.CanAttackTarget
Npc.attack = Npc.Attack
Npc.die = Npc.Die

return Npc
]]></string>
              </Properties>
              <Item class="Folder" referent="1124">
                <Properties>
                  <string name="Name">AiTypes</string>
                </Properties>
                <Item class="ModuleScript" referent="1125">
                  <Properties>
                    <string name="Name">Default</string>
                    <string name="Source"><![CDATA[--!strict

local Npc = require(script.Parent.Parent)

local Default = {}

export type DefaultNpc = Npc.Npc
export type DefaultNpcConfig = Npc.NpcConfig

function Default.New(configRaw: DefaultNpcConfig?): DefaultNpc
	return Npc.new(configRaw)
end

Default.new = Default.New

return Default
]]></string>
