local function clampNumber(valueRaw: any, fallback: number, minimum: number, maximum: number): number
	local value = if typeof(valueRaw) == "number" and valueRaw == valueRaw then valueRaw else fallback
	if value < minimum then
		return minimum
	end
	if value > maximum then
		return maximum
	end
	return value
end

local function sanitizeString(valueRaw: any, fallback: string): string
	return if typeof(valueRaw) == "string" and valueRaw ~= "" then valueRaw else fallback
end

local function mergeTables(baseRaw: any, overrideRaw: any): { [string]: any }
	local merged = {}
	if typeof(baseRaw) == "table" then
		for key, value in baseRaw do
			if typeof(value) == "table" then
				merged[key] = mergeTables(value, nil)
			else
				merged[key] = value
			end
		end
	end
	if typeof(overrideRaw) == "table" then
		for key, value in overrideRaw do
			if typeof(value) == "table" and typeof(merged[key]) == "table" then
				merged[key] = mergeTables(merged[key], value)
			else
				merged[key] = value
			end
		end
	end
	return merged
end

local function splitCommaSeparatedNames(valueRaw: any): { string }
	local out = {}
	if typeof(valueRaw) ~= "string" then
		return out
	end
	for token in string.gmatch(valueRaw, "[^,]+") do
		local trimmed = string.match(token, "^%s*(.-)%s*$") or ""
		if trimmed ~= "" then
			out[#out + 1] = trimmed
		end
	end
	return out
end

local function resolveRootPartFromModel(model: Model): BasePart?
	local humanoidRootPart = model:FindFirstChild("HumanoidRootPart")
	if humanoidRootPart ~= nil and humanoidRootPart:IsA("BasePart") then
		return humanoidRootPart
	end
	if model.PrimaryPart ~= nil then
		return model.PrimaryPart
	end
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") then
			return descendant
		end
	end
	return nil
end

local function resolveWorldPosition(instance: Instance): Vector3?
	if instance:IsA("Attachment") then
		return instance.WorldPosition
	end
	if instance:IsA("Bone") then
		local ok, worldCFrame = pcall(function()
			return instance.WorldCFrame
		end)
		if ok and typeof(worldCFrame) == "CFrame" then
			return worldCFrame.Position
		end
		return nil
	end
	if instance:IsA("BasePart") then
		return instance.Position
	end
	if instance:IsA("Model") then
		local rootPart = resolveRootPartFromModel(instance)
		if rootPart ~= nil then
			return rootPart.Position
		end
		local ok, pivot = pcall(function()
			return instance:GetPivot()
		end)
		if ok and typeof(pivot) == "CFrame" then
			return pivot.Position
		end
	end
	return nil
end

local function resolveWorldVelocity(instance: Instance, currentPosition: Vector3, previousPosition: Vector3, dt: number): Vector3
	if instance:IsA("BasePart") then
		return instance.AssemblyLinearVelocity
	end
	if instance:IsA("Model") then
		local rootPart = resolveRootPartFromModel(instance)
		if rootPart ~= nil then
			return rootPart.AssemblyLinearVelocity
		end
	end
	if dt <= 0 then
		return ZERO
	end
	return (currentPosition - previousPosition) / dt
end

local function canBeFoliageRoot(instance: Instance): boolean
	return instance:IsA("BasePart") or instance:IsA("Model") or instance:IsA("Bone")
end

local function canBeDisturber(instance: Instance): boolean
	return instance:IsA("BasePart") or instance:IsA("Model") or instance:IsA("Attachment") or instance:IsA("Bone")
end

local function isInWorkspace(instance: Instance): boolean
	return instance == Workspace or instance:IsDescendantOf(Workspace)
end

local function isInWorldAnimatorRuntime(instance: Instance): boolean
	local current = instance.Parent
	while current ~= nil do
		if current.Name == WORLD_ANIMATOR_RUNTIME_FOLDER_NAME then
			return true
		end
		current = current.Parent
	end
	return false
end

local function getServerAlignedTime(): number
	local ok, value = pcall(function()
		return Workspace:GetServerTimeNow()
	end)
	if ok and typeof(value) == "number" and value == value then
		return value
	end
	return os.clock()
end

function WindFoliage.New(configRaw: Config?): any
	local config = mergeTables(DEFAULT_CONFIG, configRaw)
	local bucketCount = math.max(1, math.floor(clampNumber(config.bucketCount, DEFAULT_CONFIG.bucketCount, 1, 32)))
	local tickScheduler = (config :: any).tickScheduler
	if tickScheduler == nil then
		error("WindFoliage.New requires a tickScheduler")
	end

	local lodConfig = mergeTables(DEFAULT_CONFIG.lod, config.lod)
	local self = setmetatable({
		config = config,
		tickScheduler = tickScheduler :: TickScheduler,
		janitor = Janitor.new(),
		attributeCache = AttributeCache.new(),
		tagQuery = TagQuery.new(CollectionService),
		windField = WindField.new(config.windField),
		bufferPool = BufferPool.new({
			maxAvailable = 32,
		}),
		runtimeRegistry = nil,
		lodController = nil,
		updateManager = nil,
		disturbancePool = ObjectPool.new(function()
			return DisturbanceSourceModule.createTemplate()
		end, {
			expandBy = 16,
			minAvailable = 4,
			maxAvailable = 512,
			reset = DisturbanceSourceModule.reset,
		}),
		trackedDisturbers = {} :: { [Instance]: TrackedDisturberRecord },
		activeDisturbances = {} :: { DisturbanceSource },
		playerTracks = {} :: { [Player]: PlayerTrackRecord },
		nextFoliageId = 0,
		nextDisturbanceId = 0,
		bucketCount = bucketCount,
		time = 0,
		timeOffset = getServerAlignedTime(),
		trackedRefreshAccumulator = 0,
		disturbanceAccumulator = 0,
		poolShrinkAccumulator = 0,
		schedulerToken = nil :: CancellationToken?,
		schedulerGroup = ("windFoliage_%s"):format(tostring(math.floor(os.clock() * 1000))),
		initialized = false,
		destroyed = false,
	}, WindFoliage)

	self.runtimeRegistry = TreeRuntimeRegistry.new({
		gridCellSize = clampNumber(config.gridCellSize, DEFAULT_CONFIG.gridCellSize, 1, 2048),
		octreeMaxDepth = clampNumber(config.octreeMaxDepth, DEFAULT_CONFIG.octreeMaxDepth, 1, 12),
	})
	self.lodController = LODController.new({
		lod = lodConfig,
		runtime = config.runtime,
	})
	self.updateManager = FoliageUpdateManager.new(config, self.runtimeRegistry, self.windField, self.lodController, self.bufferPool)

	return self
end

function WindFoliage.ResolvePreset(self: any, presetNameRaw: any): { [string]: any }
	local presets = if typeof(self.config.presets) == "table" then self.config.presets else DEFAULT_PRESETS
	local fallbackPresetName = sanitizeString(self.config.fallbackPreset, "GrassLight")
	local presetName = sanitizeString(presetNameRaw, fallbackPresetName)
	local preset = presets[presetName]
	if typeof(preset) ~= "table" then
		preset = presets[fallbackPresetName]
	end
	if typeof(preset) ~= "table" then
		preset = DEFAULT_PRESETS.GrassLight
	end
	return mergeTables(preset, nil)
end

function WindFoliage.ResolveFoliageConfig(self: any, instance: Instance, id: number): { [string]: any }
	self.attributeCache:bind(instance)

	local presetName = self.attributeCache:get(instance, ATTRIBUTES.preset, self.config.fallbackPreset)
	local preset = self:resolvePreset(presetName)
	local seed = DeterministicRNG.seedFrom(instance:GetFullName())
	local bucketIndex = (seed % self.bucketCount) + 1

	local function overrideNumber(fieldName: string, attributeName: string)
		local value = self.attributeCache:get(instance, attributeName, nil)
		if typeof(value) == "number" then
			preset[fieldName] = value
		end
	end

	local function overrideString(fieldName: string, attributeName: string)
		local value = self.attributeCache:get(instance, attributeName, nil)
		if typeof(value) == "string" and value ~= "" then
			preset[fieldName] = value
		end
	end

	overrideString("representation", ATTRIBUTES.representation)
	overrideString("motionStyle", ATTRIBUTES.motionStyle)
	overrideString("pivotMode", ATTRIBUTES.pivotMode)
	overrideString("pivotAttachmentName", ATTRIBUTES.pivotAttachment)
	overrideNumber("bendStiffness", ATTRIBUTES.bendStiffness)
	overrideNumber("damping", ATTRIBUTES.damping)
	overrideNumber("maxBendAngle", ATTRIBUTES.maxBendAngle)
	overrideNumber("heightMultiplier", ATTRIBUTES.heightMultiplier)
	overrideNumber("swayAmplitude", ATTRIBUTES.swayAmplitude)
	overrideNumber("gustSensitivity", ATTRIBUTES.gustSensitivity)
	overrideNumber("recoverySpeed", ATTRIBUTES.recoverySpeed)
	overrideNumber("disturbanceSensitivity", ATTRIBUTES.disturbanceSensitivity)
	overrideNumber("detailAmplitude", ATTRIBUTES.detailAmplitude)
	overrideNumber("translationWeight", ATTRIBUTES.translationWeight)
	overrideNumber("yawWeight", ATTRIBUTES.yawWeight)
	overrideNumber("tipBias", ATTRIBUTES.tipBias)

	local pivotOffset = self.attributeCache:get(instance, ATTRIBUTES.pivotOffset, nil)
	if typeof(pivotOffset) == "Vector3" then
		preset.pivotOffset = pivotOffset
	end

	local boneNames = self.attributeCache:get(instance, ATTRIBUTES.boneNames, nil)
	if typeof(boneNames) == "string" and boneNames ~= "" then
		preset.boneNames = splitCommaSeparatedNames(boneNames)
	end

	preset.id = id
	preset.seed = seed
	preset.bucketIndex = bucketIndex
	preset.presetName = sanitizeString(presetName, self.config.fallbackPreset)

	return preset
end

function WindFoliage.ShouldRegisterFoliage(self: any, instance: Instance): boolean
	if not canBeFoliageRoot(instance) then
		return false
	end
	if not isInWorkspace(instance) then
		return false
	end
	if isInWorldAnimatorRuntime(instance) then
		return false
	end

	local foliageTag = sanitizeString(self.config.foliageTag, DEFAULT_FOLIAGE_TAG)
	local hasTag = self.tagQuery:hasTag(instance, foliageTag)
	local enabled = instance:GetAttribute(ATTRIBUTES.foliageEnabled)
	if typeof(enabled) == "boolean" then
		if not enabled then
			return false
		end
		return true
	end

	if hasTag then
		return true
	end

	local presetName = instance:GetAttribute(ATTRIBUTES.preset)
	return typeof(presetName) == "string" and presetName ~= ""
end

function WindFoliage.ShouldTrackDisturber(self: any, instance: Instance): boolean
	if not canBeDisturber(instance) then
		return false
	end
	if not isInWorkspace(instance) then
		return false
	end
	if isInWorldAnimatorRuntime(instance) then
		return false
	end

	local enabled = instance:GetAttribute(ATTRIBUTES.disturbanceEnabled)
	if typeof(enabled) == "boolean" then
		return enabled
	end

	local disturberTag = sanitizeString(self.config.disturberTag, DEFAULT_DISTURBER_TAG)
	return self.tagQuery:hasTag(instance, disturberTag)
end

function WindFoliage.ResolveDisturberConfig(self: any, instance: Instance, overrideConfigRaw: any, kind: string): { [string]: any }
	self.attributeCache:bind(instance)

	local baseConfig =
		if kind == "player" and typeof(self.config.playerDisturber) == "table"
			then self.config.playerDisturber
			else self.config.disturberDefaults
	local config = mergeTables(baseConfig, overrideConfigRaw)

	local radius = self.attributeCache:get(instance, ATTRIBUTES.disturbanceRadius, nil)
	if typeof(radius) == "number" then
		config.radius = radius
	end

	local strength = self.attributeCache:get(instance, ATTRIBUTES.disturbanceStrength, nil)
	if typeof(strength) == "number" then
		config.strength = strength
	end

	local lifetime = self.attributeCache:get(instance, ATTRIBUTES.disturbanceLifetime, nil)
	if typeof(lifetime) == "number" then
		config.lifetime = lifetime
	end

	local falloffCurve = self.attributeCache:get(instance, ATTRIBUTES.disturbanceFalloff, nil)
	if typeof(falloffCurve) == "number" then
		config.falloffCurve = falloffCurve
	end

	local propagationDistance = self.attributeCache:get(instance, ATTRIBUTES.disturbancePropagationDistance, nil)
	if typeof(propagationDistance) == "number" then
		config.propagationDistance = propagationDistance
	end

	local propagationWeight = self.attributeCache:get(instance, ATTRIBUTES.disturbancePropagationWeight, nil)
	if typeof(propagationWeight) == "number" then
		config.propagationWeight = propagationWeight
	end

	local velocityInfluence = self.attributeCache:get(instance, ATTRIBUTES.disturbanceVelocityInfluence, nil)
	if typeof(velocityInfluence) == "number" then
		config.velocityInfluence = velocityInfluence
	end

	return config
end

function WindFoliage.ResolveLOD(self: any, distance: number): LODState?
	local controller = self.lodController
	if controller == nil then
		return nil
	end

	local tier = controller:resolve(distance * distance, self:resolveReferencePosition(), 0)
	if tier ~= nil and not tier.frozen then
		return tier.lodState
	end
	return nil
end

function WindFoliage.ResolveReferencePosition(_self: any): Vector3
	local camera = Workspace.CurrentCamera
	if camera ~= nil then
		return camera.CFrame.Position
	end

	local localPlayer = Players.LocalPlayer
	if localPlayer ~= nil and localPlayer.Character ~= nil then
		local characterRoot = resolveRootPartFromModel(localPlayer.Character)
		if characterRoot ~= nil then
			return characterRoot.Position
		end
	end

	return ZERO
end

function WindFoliage.RemoveFromBucket(_self: any, _record: FoliageRecord)
	return nil
end

function WindFoliage.InsertActiveDisturbance(self: any, source: DisturbanceSource)
	local index = #self.activeDisturbances + 1
	self.activeDisturbances[index] = source
	if source.trackedInstance ~= nil then
		local trackedRecord = self.trackedDisturbers[source.trackedInstance]
		if trackedRecord ~= nil then
			trackedRecord.sourceIndex = index
		end
	end
end

function WindFoliage.RemoveActiveDisturbanceAt(self: any, index: number)
	local source = self.activeDisturbances[index]
	if source == nil then
		return
	end

	local lastIndex = #self.activeDisturbances
	local lastSource = self.activeDisturbances[lastIndex]
	self.activeDisturbances[lastIndex] = nil
	if index < lastIndex and lastSource ~= nil then
		self.activeDisturbances[index] = lastSource
		if lastSource.trackedInstance ~= nil then
			local trackedRecord = self.trackedDisturbers[lastSource.trackedInstance]
			if trackedRecord ~= nil then
				trackedRecord.sourceIndex = index
			end
		end
	end
end

function WindFoliage.ReleaseDisturbanceAt(self: any, index: number)
	local source = self.activeDisturbances[index]
	if source == nil then
		return
	end
	self:removeActiveDisturbanceAt(index)
	self.disturbancePool:release(source)
end

function WindFoliage.MaybeUnbindAttributes(self: any, instance: Instance)
	if self.runtimeRegistry:get(instance) ~= nil then
		return
	end
	if self.trackedDisturbers[instance] ~= nil then
		return
	end
	self.attributeCache:unbind(instance)
end

function WindFoliage.RegisterFoliage(self: any, instanceRaw: any): any
	if typeof(instanceRaw) ~= "Instance" then
		return nil
	end
	local instance = instanceRaw :: Instance
	local existing = self.runtimeRegistry:get(instance)
	if existing ~= nil then
		return existing
	end
	if not self:shouldRegisterFoliage(instance) then
		return nil
	end

	self.nextFoliageId += 1
	local config = self:resolveFoliageConfig(instance, self.nextFoliageId)
	local entry = self.runtimeRegistry:register(instance, config)
	if entry == nil then
		return nil
	end

	local entryAny = entry :: any

	entryAny.destroyConnection = instance.Destroying:Connect(function()
		self:unregisterFoliage(instance)
	end)
	entryAny.attributeDisconnect = self.attributeCache:onChanged(instance, "*", function(changedInstance, attributeName)
		if typeof(attributeName) ~= "string" then
			return
		end
		if REFRESH_ATTRIBUTE_SET[attributeName] ~= true then
			return
		end
		self:refreshFoliage(changedInstance)
	end)

	return entry
end

function WindFoliage.UnregisterFoliage(self: any, instanceRaw: any)
	if typeof(instanceRaw) ~= "Instance" then
		return
	end
	local instance = instanceRaw :: Instance
	local entry = self.runtimeRegistry:get(instance)
	if entry == nil then
		return
	end

	local entryAny = entry :: any
	if entryAny.destroyConnection ~= nil then
		entryAny.destroyConnection:Disconnect()
		entryAny.destroyConnection = nil
	end
	if entryAny.attributeDisconnect ~= nil then
		entryAny.attributeDisconnect()
		entryAny.attributeDisconnect = nil
	end

	setAttributeIfChanged(instance, RUNTIME_ATTRIBUTE_LOD, nil)
	setAttributeIfChanged(instance, RUNTIME_ATTRIBUTE_WRITES, nil)
	self.runtimeRegistry:unregister(instance)
	self:maybeUnbindAttributes(instance)
end

function WindFoliage.RefreshFoliage(self: any, instanceRaw: any)
	if typeof(instanceRaw) ~= "Instance" then
		return
	end
	local instance = instanceRaw :: Instance
	local shouldRegister = self:shouldRegisterFoliage(instance)
	if not shouldRegister then
		self:unregisterFoliage(instance)
		return
	end

	if self.runtimeRegistry:get(instance) ~= nil then
		self:unregisterFoliage(instance)
	end
	self:registerFoliage(instance)
end

function WindFoliage.UpdateTrackedSource(self: any, record: TrackedDisturberRecord, dt: number)
	local instance = record.instance
	if instance.Parent == nil then
		self:untrackDisturber(instance)
		return
	end

	if record.kind ~= "player" and not self:shouldTrackDisturber(instance) then
		self:untrackDisturber(instance)
		return
	end

	local position = resolveWorldPosition(instance)
	if position == nil then
		self:untrackDisturber(instance)
		return
	end

	local velocity = resolveWorldVelocity(instance, position, record.lastPosition, dt)
	record.lastPosition = position

	local source = record.source
	local config = self:resolveDisturberConfig(instance, record.overrideConfig, record.kind)
	local lifetime = math.max(
		clampNumber(config.lifetime, 0.24, 0.01, 10),
		clampNumber(self.config.trackedRefreshInterval, 0.08, 0.01, 5) * 2
	)
	DisturbanceSourceModule.populate(source, {
		position = position,
		velocity = velocity,
		radius = config.radius,
		strength = config.strength,
		lifetime = lifetime,
		falloffCurve = config.falloffCurve,
		propagationDistance = config.propagationDistance,
		propagationWeight = config.propagationWeight,
		velocityInfluence = config.velocityInfluence,
		trackedInstance = instance,
	}, self.time, lifetime)
end

function WindFoliage.TrackDisturber(self: any, instanceRaw: any, overrideConfigRaw: any?, kindRaw: any?): TrackedDisturberRecord?
	if typeof(instanceRaw) ~= "Instance" then
		return nil
	end
	local instance = instanceRaw :: Instance
	local kind = sanitizeString(kindRaw, "tagged")
	local existing = self.trackedDisturbers[instance]
	if existing ~= nil then
		if typeof(overrideConfigRaw) == "table" then
			existing.overrideConfig = overrideConfigRaw
		end
		existing.kind = kind
		self:updateTrackedSource(existing, math.max(1 / 60, clampNumber(self.config.trackedRefreshInterval, 0.08, 0.01, 10)))
		return self.trackedDisturbers[instance]
	end

	if kind ~= "player" and not self:shouldTrackDisturber(instance) then
		return nil
	end

	local position = resolveWorldPosition(instance)
	if position == nil then
		return nil
	end

	self.attributeCache:bind(instance)
	local source = self.disturbancePool:acquire()
	self.nextDisturbanceId += 1
	source.id = self.nextDisturbanceId

	local record: TrackedDisturberRecord = {
		instance = instance,
		source = source,
		sourceIndex = 0,
		lastPosition = position,
		overrideConfig = if typeof(overrideConfigRaw) == "table" then overrideConfigRaw else nil,
		kind = kind,
		destroyConnection = nil,
	}

	record.destroyConnection = instance.Destroying:Connect(function()
		self:untrackDisturber(instance)
	end)

	self.trackedDisturbers[instance] = record
	self:insertActiveDisturbance(source)
	self:updateTrackedSource(record, math.max(1 / 60, clampNumber(self.config.trackedRefreshInterval, 0.08, 0.01, 10)))

	return record
end

function WindFoliage.UntrackDisturber(self: any, instanceRaw: any)
	if typeof(instanceRaw) ~= "Instance" then
		return
	end
	local instance = instanceRaw :: Instance
	local record = self.trackedDisturbers[instance]
	if record == nil then
		return
	end

	self.trackedDisturbers[instance] = nil
	if record.destroyConnection ~= nil then
		record.destroyConnection:Disconnect()
		record.destroyConnection = nil
	end
	if record.sourceIndex > 0 then
		self:releaseDisturbanceAt(record.sourceIndex)
	end

	self:maybeUnbindAttributes(instance)
end

function WindFoliage.AddDisturbance(self: any, paramsRaw: any): number?
	local params = if typeof(paramsRaw) == "table" then paramsRaw else {}
	local position = if typeof(params.position) == "Vector3" then params.position else nil
	if position == nil then
		return nil
	end

	local source = self.disturbancePool:acquire()
	self.nextDisturbanceId += 1
	source.id = self.nextDisturbanceId
	DisturbanceSourceModule.populate(source, params, self.time, params.lifetime)
	self:insertActiveDisturbance(source)
	return source.id
end

function WindFoliage.ApplyDisturbanceSource(self: any, source: DisturbanceSource, pulseDt: number)
	local queryRadius = source.radius + source.propagationDistance
	if queryRadius <= 0 then
		return
	end

	local records = self.runtimeRegistry:queryRadius(source.position, queryRadius)
	local updateManager = self.updateManager
	local maxInteractiveTrees = updateManager.maxInteractiveTrees
	local applied = 0
	for _, entry in records do
		if entry ~= nil then
			local impulse = DisturbanceSourceModule.computeImpulse(source, entry.rootPosition)
			if impulse.Magnitude > 1e-5 then
				updateManager:applyInteractionImpulse(entry, impulse * pulseDt, source.position)
				applied += 1
				if applied >= maxInteractiveTrees then
					break
				end
			end
		end
	end
end

function WindFoliage.PulseDisturbances(self: any, pulseDt: number)
	for index = #self.activeDisturbances, 1, -1 do
		local source = self.activeDisturbances[index]
		if source == nil then
			continue
		end
		if DisturbanceSourceModule.isExpired(source, self.time) then
			if source.trackedInstance ~= nil and self.trackedDisturbers[source.trackedInstance] ~= nil then
				source.expiresAt = self.time + clampNumber(self.config.trackedRefreshInterval, 0.08, 0.01, 5) * 2
				continue
			end
			self:releaseDisturbanceAt(index)
			continue
		end
		self:applyDisturbanceSource(source, pulseDt)
	end
end

function WindFoliage.RefreshBucketSamples(_self: any, _bucketIndex: number, _referencePosition: Vector3)
	return nil
end

function WindFoliage.StepActiveFoliage(_self: any, _dt: number)
	return nil
end

function WindFoliage.RefreshTrackedDisturbers(self: any, refreshDt: number)
	local records = {}
	for _, record in self.trackedDisturbers do
		records[#records + 1] = record
	end
	for _, record in records do
		if self.trackedDisturbers[record.instance] ~= nil then
			self:updateTrackedSource(record, refreshDt)
		end
	end
end

function WindFoliage.OnFixedStep(self: any, dt: number)
	if self.destroyed then
		return
	end

	self.time += dt
	self.attributeCache:update(dt)

	self.trackedRefreshAccumulator += dt
	local trackedRefreshInterval = clampNumber(self.config.trackedRefreshInterval, 0.08, 0.01, 5)
	while self.trackedRefreshAccumulator >= trackedRefreshInterval do
		self.trackedRefreshAccumulator -= trackedRefreshInterval
		self:refreshTrackedDisturbers(trackedRefreshInterval)
	end

	self.disturbanceAccumulator += dt
	local disturbancePulseInterval = clampNumber(self.config.disturbancePulseInterval, 0.05, 0.01, 1)
	while self.disturbanceAccumulator >= disturbancePulseInterval do
		self.disturbanceAccumulator -= disturbancePulseInterval
		self:pulseDisturbances(disturbancePulseInterval)
	end

	self.poolShrinkAccumulator += dt
	local poolShrinkInterval = clampNumber(self.config.poolShrinkInterval, 2.5, 0.1, 60)
	if self.poolShrinkAccumulator >= poolShrinkInterval then
		self.poolShrinkAccumulator = 0
		self.disturbancePool:softShrink(clampNumber(self.config.maxPoolShrinkPerSweep, 12, 0, 128))
	end

	self.updateManager:update(self.time + self.timeOffset, dt, self:resolveReferencePosition())
end

function WindFoliage.TrackPlayer(self: any, player: Player)
	if self.playerTracks[player] ~= nil then
		return
	end

	local janitor = Janitor.new()
	local record: PlayerTrackRecord = {
		janitor = janitor,
		character = nil,
	}
	self.playerTracks[player] = record

	local function bindCharacter(character: Model)
		record.character = character
		self:trackDisturber(character, nil, "player")
	end

	local function unbindCharacter(character: Model)
		if record.character == character then
			record.character = nil
		end
		self:untrackDisturber(character)
	end

	janitor:GiveChore(player.CharacterAdded:Connect(bindCharacter))
	if typeof((player :: any).CharacterRemoving) == "RBXScriptSignal" then
		janitor:GiveChore((player :: any).CharacterRemoving:Connect(unbindCharacter))
	end
	janitor:GiveChore(function()
		if record.character ~= nil then
			self:untrackDisturber(record.character)
		end
	end)

	if player.Character ~= nil then
		bindCharacter(player.Character)
	end
end

function WindFoliage.UntrackPlayer(self: any, player: Player)
	local record = self.playerTracks[player]
	if record == nil then
		return
	end
	self.playerTracks[player] = nil
	record.janitor:Destroy()
end

function WindFoliage.ConsiderDescendant(self: any, instanceRaw: any)
	if typeof(instanceRaw) ~= "Instance" then
		return
	end
	local instance = instanceRaw :: Instance

	if self:shouldRegisterFoliage(instance) then
		self:registerFoliage(instance)
	end
	if self:shouldTrackDisturber(instance) then
		self:trackDisturber(instance)
	end
end

function WindFoliage.CleanupDescendant(self: any, instanceRaw: any)
	if typeof(instanceRaw) ~= "Instance" then
		return
	end
	local instance = instanceRaw :: Instance
	if self.runtimeRegistry:get(instance) ~= nil then
		self:unregisterFoliage(instance)
	end
	if self.trackedDisturbers[instance] ~= nil then
		self:untrackDisturber(instance)
	end
end

function WindFoliage.Init(self: any)
	if self.initialized then
		return self
	end
	self.initialized = true
	self.destroyed = false

	local janitor = self.janitor :: JanitorClass
	local foliageTag = sanitizeString(self.config.foliageTag, DEFAULT_FOLIAGE_TAG)
	local disturberTag = sanitizeString(self.config.disturberTag, DEFAULT_DISTURBER_TAG)

	janitor:GiveChore(function()
		self.tagQuery:destroy()
	end)
	janitor:GiveChore(function()
		self.attributeCache:destroy()
	end)
	janitor:GiveChore(function()
		self.disturbancePool:destroy()
	end)

	if self.config.observeTaggedInstances ~= false then
		janitor:GiveChore(self.tagQuery:observeTag(foliageTag, function(instance: Instance)
			self:registerFoliage(instance)
		end, function(instance: Instance)
			if self:shouldRegisterFoliage(instance) then
				self:refreshFoliage(instance)
			else
				self:unregisterFoliage(instance)
			end
		end))

		janitor:GiveChore(self.tagQuery:observeTag(disturberTag, function(instance: Instance)
			self:trackDisturber(instance)
		end, function(instance: Instance)
			if self:shouldTrackDisturber(instance) then
				self:trackDisturber(instance)
			else
				self:untrackDisturber(instance)
			end
		end))

		janitor:GiveChore(Workspace.DescendantAdded:Connect(function(instance: Instance)
			self:considerDescendant(instance)
		end))
		janitor:GiveChore(Workspace.DescendantRemoving:Connect(function(instance: Instance)
			self:cleanupDescendant(instance)
		end))
	end

	if self.config.autoTrackPlayers ~= false then
		janitor:GiveChore(Players.PlayerAdded:Connect(function(player: Player)
			self:trackPlayer(player)
		end))
		janitor:GiveChore(Players.PlayerRemoving:Connect(function(player: Player)
			self:untrackPlayer(player)
		end))
		for _, player in Players:GetPlayers() do
			self:trackPlayer(player)
		end
	end

	if self.config.observeTaggedInstances ~= false then
		for _, descendant in Workspace:GetDescendants() do
			self:considerDescendant(descendant)
		end
	end

	self.schedulerToken = self.tickScheduler:scheduleFixed(function(dt)
		self:onFixedStep(dt)
	end, 1, {
		group = self.schedulerGroup,
		priority = TickSchedulerModule.Priority.LOW,
	})
	janitor:GiveChore(function()
		if self.schedulerToken ~= nil then
			self.schedulerToken:cancel()
			self.schedulerToken = nil
		end
	end)

	return self
end

function WindFoliage.GetStats(self: any): { [string]: number }
	local trackedCount = 0
	for _ in self.trackedDisturbers do
		trackedCount += 1
	end
	local runtimeStats = self.updateManager:getStats()

	return {
		registeredFoliage = runtimeStats.registeredTrees,
		activeAnimatedTrees = runtimeStats.activeAnimatedTrees,
		activeDisturbances = #self.activeDisturbances,
		trackedDisturbers = trackedCount,
		nearTrees = runtimeStats.nearTrees,
		midTrees = runtimeStats.midTrees,
		farTrees = runtimeStats.farTrees,
		frozenTrees = runtimeStats.frozenTrees,
		culledTrees = runtimeStats.culledTrees,
		activeRippleDrivers = runtimeStats.activeRippleDrivers,
		transformWrites = runtimeStats.transformWrites,
		averageUpdateCostMs = runtimeStats.averageUpdateCostMs,
		time = self.time,
	}
end

function WindFoliage.Destroy(self: any)
	if self.destroyed then
		return
	end
	self.destroyed = true

	local foliageInstances = {}
	for _, entry in self.runtimeRegistry.entries do
		foliageInstances[#foliageInstances + 1] = entry.instance
	end
	for _, instance in foliageInstances do
		self:unregisterFoliage(instance)
	end

	local trackedInstances = {}
	for instance in self.trackedDisturbers do
		trackedInstances[#trackedInstances + 1] = instance
	end
	for _, instance in trackedInstances do
		self:untrackDisturber(instance)
	end

	local trackedPlayers = {}
	for player in self.playerTracks do
		trackedPlayers[#trackedPlayers + 1] = player
	end
	for _, player in trackedPlayers do
		self:untrackPlayer(player)
	end

	if self.janitor ~= nil then
		(self.janitor :: JanitorClass):Destroy()
	end
	table.clear(self.trackedDisturbers)
	table.clear(self.playerTracks)
	table.clear(self.activeDisturbances)
	self.runtimeRegistry:destroy()
	self.bufferPool:destroy()
end

WindFoliage.Tags = {
	Foliage = DEFAULT_FOLIAGE_TAG,
	Disturber = DEFAULT_DISTURBER_TAG,
}

WindFoliage.Attributes = ATTRIBUTES
WindFoliage.DefaultConfig = DEFAULT_CONFIG
WindFoliage.DefaultPresets = DEFAULT_PRESETS
WindFoliage.WindField = WindField
WindFoliage.FoliageInstance = FoliageInstance
WindFoliage.DisturbanceSource = DisturbanceSourceModule
WindFoliage.BufferPool = BufferPool
WindFoliage.LODController = LODController
WindFoliage.TreeRuntimeRegistry = TreeRuntimeRegistry
WindFoliage.FoliageUpdateManager = FoliageUpdateManager

WindFoliage.new = WindFoliage.New
WindFoliage.resolvePreset = WindFoliage.ResolvePreset
WindFoliage.resolveFoliageConfig = WindFoliage.ResolveFoliageConfig
WindFoliage.shouldRegisterFoliage = WindFoliage.ShouldRegisterFoliage
WindFoliage.shouldTrackDisturber = WindFoliage.ShouldTrackDisturber
WindFoliage.resolveDisturberConfig = WindFoliage.ResolveDisturberConfig
WindFoliage.resolveLOD = WindFoliage.ResolveLOD
WindFoliage.resolveReferencePosition = WindFoliage.ResolveReferencePosition
WindFoliage.removeFromBucket = WindFoliage.RemoveFromBucket
WindFoliage.insertActiveDisturbance = WindFoliage.InsertActiveDisturbance
WindFoliage.removeActiveDisturbanceAt = WindFoliage.RemoveActiveDisturbanceAt
WindFoliage.releaseDisturbanceAt = WindFoliage.ReleaseDisturbanceAt
WindFoliage.maybeUnbindAttributes = WindFoliage.MaybeUnbindAttributes
WindFoliage.registerFoliage = WindFoliage.RegisterFoliage
WindFoliage.unregisterFoliage = WindFoliage.UnregisterFoliage
WindFoliage.refreshFoliage = WindFoliage.RefreshFoliage
WindFoliage.updateTrackedSource = WindFoliage.UpdateTrackedSource
WindFoliage.trackDisturber = WindFoliage.TrackDisturber
WindFoliage.untrackDisturber = WindFoliage.UntrackDisturber
WindFoliage.addDisturbance = WindFoliage.AddDisturbance
WindFoliage.applyDisturbanceSource = WindFoliage.ApplyDisturbanceSource
WindFoliage.pulseDisturbances = WindFoliage.PulseDisturbances
WindFoliage.refreshBucketSamples = WindFoliage.RefreshBucketSamples
WindFoliage.stepActiveFoliage = WindFoliage.StepActiveFoliage
WindFoliage.refreshTrackedDisturbers = WindFoliage.RefreshTrackedDisturbers
WindFoliage.onFixedStep = WindFoliage.OnFixedStep
WindFoliage.trackPlayer = WindFoliage.TrackPlayer
WindFoliage.untrackPlayer = WindFoliage.UntrackPlayer
WindFoliage.considerDescendant = WindFoliage.ConsiderDescendant
WindFoliage.cleanupDescendant = WindFoliage.CleanupDescendant
WindFoliage.init = WindFoliage.Init
WindFoliage.getStats = WindFoliage.GetStats
WindFoliage.destroy = WindFoliage.Destroy

return WindFoliage
]]></string>
              </Properties>
              <Item class="ModuleScript" referent="1132">
                <Properties>
                  <string name="Name">BufferPool</string>
                  <string name="Source"><![CDATA[--!strict

local BufferPool = {}
BufferPool.__index = BufferPool

export type BufferPool = typeof(setmetatable({} :: any, BufferPool))

local function clampInteger(valueRaw: any, fallback: number, minimum: number, maximum: number): number
	local value = if typeof(valueRaw) == "number" and valueRaw == valueRaw then math.floor(valueRaw) else fallback
	if value < minimum then
		return minimum
	end
	if value > maximum then
		return maximum
	end
	return value
end

function BufferPool.New(configRaw: any?): BufferPool
	local config = if typeof(configRaw) == "table" then configRaw else {}
	local self = setmetatable({
		maxAvailable = clampInteger(config.maxAvailable, 32, 1, 1024),
		arrays = {} :: { { any } },
	}, BufferPool)
	return self
end

function BufferPool.AcquireArray(self: BufferPool): { any }
	local count = #self.arrays
	if count <= 0 then
		return {}
	end

	local array = self.arrays[count]
	self.arrays[count] = nil
	table.clear(array)
	return array
end

function BufferPool.ReleaseArray(self: BufferPool, arrayRaw: any)
	if typeof(arrayRaw) ~= "table" then
		return
	end

	local array = arrayRaw :: { any }
	table.clear(array)
	if #self.arrays >= self.maxAvailable then
		return
	end
	self.arrays[#self.arrays + 1] = array
end

function BufferPool.Destroy(self: BufferPool)
	for index = #self.arrays, 1, -1 do
		self.arrays[index] = nil
	end
end

BufferPool.new = BufferPool.New
BufferPool.acquireArray = BufferPool.AcquireArray
BufferPool.releaseArray = BufferPool.ReleaseArray
BufferPool.destroy = BufferPool.Destroy

return BufferPool
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="1133">
                <Properties>
                  <string name="Name">DisturbanceSource</string>
                  <string name="Source"><![CDATA[--!strict

local DisturbanceSource = {}

export type DisturbanceSource = {
	id: number,
	position: Vector3,
	velocity: Vector3,
	radius: number,
	strength: number,
	falloffCurve: number,
	lifetime: number,
	expiresAt: number,
	propagationDistance: number,
	propagationWeight: number,
	velocityInfluence: number,
	trackedInstance: Instance?,
}

local ZERO = Vector3.zero

local function clampNumber(valueRaw: any, fallback: number, minimum: number, maximum: number): number
	local value = if typeof(valueRaw) == "number" and valueRaw == valueRaw then valueRaw else fallback
	if value < minimum then
		return minimum
	end
	if value > maximum then
		return maximum
	end
	return value
end

function DisturbanceSource.Reset(source: DisturbanceSource)
	source.id = 0
	source.position = ZERO
	source.velocity = ZERO
	source.radius = 0
	source.strength = 0
	source.falloffCurve = 1
	source.lifetime = 0
	source.expiresAt = 0
	source.propagationDistance = 0
	source.propagationWeight = 0
	source.velocityInfluence = 1
	source.trackedInstance = nil
end

function DisturbanceSource.Populate(source: DisturbanceSource, paramsRaw: any, nowRaw: any, defaultLifetimeRaw: any?): DisturbanceSource
	local params = if typeof(paramsRaw) == "table" then paramsRaw else {}
	local now = if typeof(nowRaw) == "number" and nowRaw == nowRaw then nowRaw else 0
	local defaultLifetime =
		if typeof(defaultLifetimeRaw) == "number" and defaultLifetimeRaw == defaultLifetimeRaw then defaultLifetimeRaw else 0.2

	source.position = if typeof(params.position) == "Vector3" then params.position else ZERO
	source.velocity = if typeof(params.velocity) == "Vector3" then params.velocity else ZERO
	source.radius = clampNumber(params.radius, 8, 0.1, 512)
	source.strength = clampNumber(params.strength, 1, 0, 100)
	source.falloffCurve = clampNumber(params.falloffCurve, 1.5, 0.25, 8)
	source.lifetime = clampNumber(params.lifetime, defaultLifetime, 0.01, 10)
	source.expiresAt = now + source.lifetime
	source.propagationDistance = clampNumber(params.propagationDistance, source.radius * 0.4, 0, 256)
	source.propagationWeight = clampNumber(params.propagationWeight, 0.35, 0, 2)
	source.velocityInfluence = clampNumber(params.velocityInfluence, 0.5, 0, 4)
	source.trackedInstance = if typeof(params.trackedInstance) == "Instance" then params.trackedInstance else nil

	return source
end

function DisturbanceSource.IsExpired(source: DisturbanceSource, nowRaw: any): boolean
	local now = if typeof(nowRaw) == "number" and nowRaw == nowRaw then nowRaw else 0
	return now >= source.expiresAt
end

function DisturbanceSource.ComputeImpulse(source: DisturbanceSource, targetPosition: Vector3): Vector3
	if source.radius <= 0 or source.strength <= 0 then
		return ZERO
	end

	local velocity = source.velocity
	local speed = velocity.Magnitude
	local direction = if speed > 1e-4 then velocity / speed else ZERO
	local predictedCenter = source.position + direction * source.propagationDistance
	local delta = targetPosition - predictedCenter
	local distance = delta.Magnitude

	if distance >= source.radius then
		return ZERO
	end

	local away = if distance > 1e-4 then delta / distance else if speed > 1e-4 then -direction else Vector3.new(1, 0, 0)
	local radialAlpha = 1 - math.clamp(distance / source.radius, 0, 1)
	local falloff = radialAlpha ^ source.falloffCurve
	local velocityBias =
		if speed > 1e-4 then direction * (source.propagationWeight * radialAlpha * source.velocityInfluence) else ZERO
	local impulseDirection = away + velocityBias
	local impulseMagnitude = source.strength * falloff * (1 + math.min(1.5, speed / math.max(1, source.radius)) * 0.35)

	if impulseDirection.Magnitude <= 1e-4 or impulseMagnitude <= 0 then
		return ZERO
	end

	return impulseDirection.Unit * impulseMagnitude
end

function DisturbanceSource.CreateTemplate(): DisturbanceSource
	local source = {
		id = 0,
		position = ZERO,
		velocity = ZERO,
		radius = 0,
		strength = 0,
		falloffCurve = 1,
		lifetime = 0,
		expiresAt = 0,
		propagationDistance = 0,
		propagationWeight = 0,
		velocityInfluence = 1,
		trackedInstance = nil,
	} :: DisturbanceSource
	return source
end

DisturbanceSource.reset = DisturbanceSource.Reset
DisturbanceSource.populate = DisturbanceSource.Populate
DisturbanceSource.isExpired = DisturbanceSource.IsExpired
DisturbanceSource.computeImpulse = DisturbanceSource.ComputeImpulse
DisturbanceSource.createTemplate = DisturbanceSource.CreateTemplate

return DisturbanceSource
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="1134">
                <Properties>
                  <string name="Name">FoliageInstance</string>
                  <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Sift = require(ReplicatedStorage.Packages.Sift)

local Janitor = require(ReplicatedStorage.Packages.Janitor)
local Damp = require(script:FindFirstAncestor("game").Shared.Modules.Math.Damp)
local Vec = require(script:FindFirstAncestor("game").Shared.Modules.Math.Vec)
local TreeFoliageGraph = require(script.Parent.TreeFoliageGraph)

local FoliageInstance = {}
FoliageInstance.__index = FoliageInstance

export type MotionStyle = "GrassTip" | "BushBlend" | "Branch"
export type Representation = "BasePart" | "Model" | "Bone"

export type Config = {
	id: number,
	seed: number,
	bucketIndex: number,
	presetName: string,
	representation: Representation?,
	motionStyle: MotionStyle?,
	bendStiffness: number,
	damping: number,
	maxBendAngle: number,
	heightMultiplier: number,
	swayAmplitude: number,
	gustSensitivity: number,
	recoverySpeed: number,
	disturbanceSensitivity: number,
	detailAmplitude: number?,
	translationWeight: number?,
	yawWeight: number?,
	tipBias: number?,
	pivotMode: string?,
	pivotAttachmentName: string?,
	pivotOffset: Vector3?,
	boneNames: { string }?,
}

export type WindSample = {
	vector: Vector3,
	direction: Vector3,
	strength: number,
	gustAlpha: number,
	detailAlpha: number,
	detailVector: Vector3,
	flutter: number,
}

export type LODState = {
	level: string,
	windScale: number,
	detailScale: number,
	disturbanceScale: number,
}

export type FoliageInstance = typeof(setmetatable({} :: any, FoliageInstance))

type BoneRecord = {
	bone: Bone,
	restTransform: CFrame,
	weight: number,
}

type JanitorClass = {
	GiveChore: (self: JanitorClass, chore: any, ...any) -> (any),
	Clean: (self: JanitorClass) -> (),
	Destroy: (self: JanitorClass) -> (),
}

local ZERO = Vector3.zero
local DEFAULT_MOTION_STYLE: MotionStyle = "GrassTip"
local DEFAULT_REPRESENTATION: Representation = "BasePart"

local function clampNumber(valueRaw: any, fallback: number, minimum: number, maximum: number): number
	local value = if typeof(valueRaw) == "number" and valueRaw == valueRaw then valueRaw else fallback
	if value < minimum then
		return minimum
	end
	if value > maximum then
		return maximum
	end
	return value
end

local function sanitizeString(valueRaw: any, fallback: string): string
	return if typeof(valueRaw) == "string" and valueRaw ~= "" then valueRaw else fallback
end

local function normalizeMotionStyle(valueRaw: any): MotionStyle
	if valueRaw == "BushBlend" then
		return "BushBlend"
	end
	if valueRaw == "Branch" then
		return "Branch"
	end
	return "GrassTip"
end

local function normalizeRepresentation(valueRaw: any): Representation
	if valueRaw == "Model" then
		return "Model"
	end
	if valueRaw == "Bone" then
		return "Bone"
	end
	return DEFAULT_REPRESENTATION
end

local function resolveBasePartFromInstance(instance: Instance): BasePart?
	if instance:IsA("BasePart") then
		return instance
	end
	if instance:IsA("Model") then
		if instance.PrimaryPart ~= nil then
			return instance.PrimaryPart
		end
		for _, descendant in instance:GetDescendants() do
			if descendant:IsA("BasePart") then
				return descendant
			end
		end
	end
	return nil
end

local function safeModelPivot(model: Model): CFrame
	local ok, pivot = pcall(function()
		return model:GetPivot()
	end)
	if ok and typeof(pivot) == "CFrame" then
		return pivot
	end
	return CFrame.new()
end

local function safeModelBoundingBox(model: Model): (CFrame, Vector3)
	local ok, boxCFrame, boxSize = pcall(function()
		return model:GetBoundingBox()
	end)
	if ok and typeof(boxCFrame) == "CFrame" and typeof(boxSize) == "Vector3" then
		return boxCFrame, boxSize
	end
	return safeModelPivot(model), Vector3.one
end

local function getInstanceHeight(instance: Instance): number
	if instance:IsA("BasePart") then
		return math.max(0.25, instance.Size.Y)
	end
	if instance:IsA("Model") then
		local _, size = safeModelBoundingBox(instance)
		return math.max(0.25, size.Y)
	end
	local parentModel = instance:FindFirstAncestorOfClass("Model")
	if parentModel ~= nil then
		local _, size = safeModelBoundingBox(parentModel)
		return math.max(0.25, size.Y)
	end
	return 1
end

local function findAttachmentByName(root: Instance, name: string?): Attachment?
	if name == nil or name == "" then
		return nil
	end
	if root:IsA("Attachment") and root.Name == name then
		return root
	end
	for _, descendant in root:GetDescendants() do
		if descendant:IsA("Attachment") and descendant.Name == name then
			return descendant
		end
	end
	return nil
end

local function normalizePivotMode(valueRaw: any): string
	if valueRaw == "Center" then
		return "Center"
	end
	if valueRaw == "Attachment" then
		return "Attachment"
	end
	if valueRaw == "Bottom" then
		return "Bottom"
	end
	return "Auto"
end

local function resolvePartPivotFrame(part: BasePart, config: Config): CFrame
	local pivotOffset = if typeof(config.pivotOffset) == "Vector3" then config.pivotOffset else ZERO
	local pivotAttachment = findAttachmentByName(part, config.pivotAttachmentName)
	local pivotMode = normalizePivotMode(config.pivotMode)

	if pivotAttachment ~= nil then
		return pivotAttachment.WorldCFrame * CFrame.new(pivotOffset)
	end

	local localOffset = pivotOffset
	if pivotMode == "Bottom" or pivotMode == "Auto" then
		localOffset += Vector3.new(0, -part.Size.Y * 0.5, 0)
	end

	return part.CFrame * CFrame.new(localOffset)
end

local function resolveModelPivotFrame(model: Model, config: Config): CFrame
	local pivotOffset = if typeof(config.pivotOffset) == "Vector3" then config.pivotOffset else ZERO
	local pivotAttachment = findAttachmentByName(model, config.pivotAttachmentName)
	local pivotMode = normalizePivotMode(config.pivotMode)

	if pivotAttachment ~= nil then
		local modelPivot = safeModelPivot(model)
		local attachmentPosition = pivotAttachment.WorldPosition
		local planarLook = Vector3.new(modelPivot.LookVector.X, 0, modelPivot.LookVector.Z)
		if planarLook.Magnitude > 1e-4 then
			return CFrame.lookAt(attachmentPosition, attachmentPosition + planarLook.Unit, Vector3.yAxis)
				* CFrame.new(pivotOffset)
		end
		return CFrame.new(attachmentPosition) * CFrame.new(pivotOffset)
	end

	local pivot = safeModelPivot(model)
	if pivotMode == "Bottom" or pivotMode == "Auto" then
		local _, boxSize = safeModelBoundingBox(model)
		return pivot * CFrame.new(pivotOffset + Vector3.new(0, -boxSize.Y * 0.5, 0))
	end

	return pivot * CFrame.new(pivotOffset)
end

local function countDepth(instance: Instance): number
	local depth = 0
	local current = instance.Parent
	while current ~= nil do
		depth += 1
		current = current.Parent
	end
	return depth
end

local function resolveBoneNames(config: Config): { string }
	local raw = config.boneNames
	if typeof(raw) ~= "table" then
		return {}
	end
	local out = {}
	for _, value in raw do
		if typeof(value) == "string" and value ~= "" then
			out[#out + 1] = value
		end
	end
	return out
end

local function collectBones(root: Instance, config: Config): { BoneRecord }
	local requestedNames = resolveBoneNames(config)
	local bones = {}

	if #requestedNames > 0 then
		for _, name in requestedNames do
			for _, descendant in root:GetDescendants() do
				if descendant:IsA("Bone") and descendant.Name == name then
					bones[#bones + 1] = descendant
					break
				end
			end
		end
	elseif root:IsA("Bone") then
		bones[1] = root
	else
		for _, descendant in root:GetDescendants() do
			if descendant:IsA("Bone") then
				bones[#bones + 1] = descendant
			end
		end
		table.sort(bones, function(a: Bone, b: Bone)
			local depthA = countDepth(a)
			local depthB = countDepth(b)
			if depthA ~= depthB then
				return depthA < depthB
			end
			return a:GetFullName() < b:GetFullName()
		end)
	end

	local tipBias = clampNumber(config.tipBias, 1.9, 0.1, 6)
	local records = Sift.Array.create(#bones)
	local count = #bones
	for index, bone in bones do
		local alpha = if count <= 1 then 1 else (index - 1) / (count - 1)
		local weight = if count <= 1 then 1 else math.max(0.12, alpha ^ tipBias)
		records[index] = {
			bone = bone,
			restTransform = bone.Transform,
			weight = weight,
		}
	end

	return records
end

local function resolveReferenceFrame(instance: Instance): CFrame
	if instance:IsA("Bone") then
		local ok, worldCFrame = pcall(function()
			return instance.WorldCFrame
		end)
		if ok and typeof(worldCFrame) == "CFrame" then
			return worldCFrame
		end
	end
	if instance:IsA("Model") then
		return safeModelPivot(instance)
	end
	local part = resolveBasePartFromInstance(instance)
	if part ~= nil then
		return part.CFrame
	end
	return CFrame.new()
end

local function determineRepresentation(instance: Instance, config: Config): Representation?
	local explicitRepresentation = config.representation
	if explicitRepresentation ~= nil then
		local normalized = normalizeRepresentation(explicitRepresentation)
		if normalized == "Bone" then
			return normalized
		end
		if normalized == "Model" and instance:IsA("Model") then
			return normalized
		end
		if normalized == "BasePart" and instance:IsA("BasePart") then
			return normalized
		end
	end

	if instance:IsA("Bone") then
		return "Bone"
	end

	for _, descendant in instance:GetDescendants() do
		if descendant:IsA("Bone") then
			return "Bone"
		end
	end

	if instance:IsA("Model") then
		return "Model"
	end
	if instance:IsA("BasePart") then
		return "BasePart"
	end
	return nil
end

function FoliageInstance.New(instanceRaw: any, configRaw: Config?): FoliageInstance?
	if typeof(instanceRaw) ~= "Instance" then
		return nil
	end

	local instance = instanceRaw :: Instance
	local config = if typeof(configRaw) == "table" then configRaw else ({} :: Config)
	local representation = determineRepresentation(instance, config)
	if representation == nil then
		return nil
	end

	local janitor = Janitor.new()
	local motionStyle = normalizeMotionStyle(config.motionStyle or DEFAULT_MOTION_STYLE)
	local referenceFrame = resolveReferenceFrame(instance)
	local objectHeight = getInstanceHeight(instance)
	local phaseOffset = (config.seed % 100000) / 100000 * math.pi * 2
	local amplitudeScale = 0.92 + ((config.seed % 8191) / 8191) * 0.18

	local self = setmetatable({
		id = config.id,
		instance = instance,
		representation = representation,
		motionStyle = motionStyle,
		presetName = sanitizeString(config.presetName, "GrassLight"),
		bucketIndex = config.bucketIndex,
		janitor = janitor,
		config = config,
		referenceFrame = referenceFrame,
		objectHeight = objectHeight,
		rootPosition = referenceFrame.Position,
		currentBend = ZERO,
		springVelocity = ZERO,
		reactiveBend = ZERO,
		lastDisturbanceImpulse = ZERO,
		lastUpdateTime = 0,
		phaseOffset = phaseOffset,
		amplitudeScale = amplitudeScale,
		part = nil :: BasePart?,
		model = nil :: Model?,
		treeGraph = nil :: any,
		bones = {} :: { BoneRecord },
		restCFrame = nil :: CFrame?,
		restPivotFrame = nil :: CFrame?,
		pivotToObject = nil :: CFrame?,
		destroyed = false,
	}, FoliageInstance)

	if representation == "Model" then
		local model = instance :: Model
		local treeGraph = TreeFoliageGraph.new(model, config)
		if treeGraph ~= nil then
			self.model = model
			self.treeGraph = treeGraph
			self.referenceFrame = CFrame.new(treeGraph:getRootPosition())
			self.rootPosition = treeGraph:getRootPosition()
		else
			local restCFrame = safeModelPivot(model)
			local restPivotFrame = resolveModelPivotFrame(model, config)
			self.model = model
			self.restCFrame = restCFrame
			self.restPivotFrame = restPivotFrame
			self.pivotToObject = restPivotFrame:ToObjectSpace(restCFrame)
			self.referenceFrame = restPivotFrame
			self.rootPosition = restPivotFrame.Position
		end
	elseif representation == "BasePart" then
		local part = instance :: BasePart
		local restCFrame = part.CFrame
		local restPivotFrame = resolvePartPivotFrame(part, config)
		self.part = part
		self.restCFrame = restCFrame
		self.restPivotFrame = restPivotFrame
		self.pivotToObject = restPivotFrame:ToObjectSpace(restCFrame)
		self.referenceFrame = restPivotFrame
		self.rootPosition = restPivotFrame.Position
	else
		self.bones = collectBones(instance, config)
		if #self.bones <= 0 then
			janitor:Destroy()
			return nil
		end
		self.referenceFrame = resolveReferenceFrame(instance)
		self.rootPosition = self.referenceFrame.Position
	end

	janitor:GiveChore(instance.Destroying:Connect(function()
		self:destroy()
	end))

	return self
end

function FoliageInstance.GetRootPosition(self: FoliageInstance): Vector3
	if self.treeGraph ~= nil then
		return self.treeGraph:getRootPosition()
	end
	return self.rootPosition
end

function FoliageInstance.ResetPose(self: FoliageInstance)
	if self.destroyed then
		return
	end

	self.currentBend = ZERO
	self.springVelocity = ZERO
	self.reactiveBend = ZERO
	self.lastDisturbanceImpulse = ZERO

	if self.treeGraph ~= nil then
		self.treeGraph:reset()
		self.rootPosition = self.treeGraph:getRootPosition()
		return
	end

	if self.representation == "BasePart" then
		local part = self.part
		local restCFrame = self.restCFrame
		local restPivotFrame = self.restPivotFrame
		if part ~= nil and restCFrame ~= nil and part.Parent ~= nil then
			part.CFrame = restCFrame
		end
		if restPivotFrame ~= nil then
			self.rootPosition = restPivotFrame.Position
		end
		return
	end

	if self.representation == "Model" then
		local model = self.model
		local restCFrame = self.restCFrame
		local restPivotFrame = self.restPivotFrame
		if model ~= nil and restCFrame ~= nil and model.Parent ~= nil then
			model:PivotTo(restCFrame)
		end
		if restPivotFrame ~= nil then
			self.rootPosition = restPivotFrame.Position
		end
		return
	end

	for _, record in self.bones do
		if record.bone.Parent ~= nil then
			record.bone.Transform = record.restTransform
		end
	end
	self.rootPosition = self.referenceFrame.Position
end

function FoliageInstance.AddDisturbance(self: FoliageInstance, impulseWorld: Vector3, originWorldRaw: any?)
	if self.destroyed then
		return
	end
	if impulseWorld.Magnitude <= 1e-5 then
		return
	end
	if self.treeGraph ~= nil then
		self.treeGraph:addDisturbance(impulseWorld, originWorldRaw)
		return
	end

	local scaledImpulse = impulseWorld * clampNumber(self.config.disturbanceSensitivity, 1, 0, 10)
	self.reactiveBend += scaledImpulse
	if self.reactiveBend.Magnitude > 2 then
		self.reactiveBend = self.reactiveBend.Unit * 2
	end
	self.lastDisturbanceImpulse = scaledImpulse
	self.springVelocity += scaledImpulse * 0.28
end

function FoliageInstance.ResolveLocalAngles(self: FoliageInstance, bendWorld: Vector3, flutter: number, lod: LODState): (number, number, number, Vector3)
	local reference = self.referenceFrame
	local planar = Vec.flattenY(bendWorld)
	local magnitude = planar.Magnitude
	if magnitude <= 1e-5 then
		return 0, 0, 0, ZERO
	end

	local direction = planar / magnitude
	local localDirection = reference:VectorToObjectSpace(direction)
	local angleRadians = math.rad(clampNumber(self.config.maxBendAngle, 15, 0, 89))
	local blendWeight = 1
	local translationWeight = clampNumber(self.config.translationWeight, 0.12, 0, 1)
	local yawWeight = clampNumber(self.config.yawWeight, 0.06, 0, 1)

	if self.motionStyle == "BushBlend" then
		blendWeight = 0.72
		translationWeight = math.max(translationWeight, 0.18)
		yawWeight = math.max(yawWeight, 0.14)
	elseif self.motionStyle == "Branch" then
		blendWeight = 0.58
		translationWeight = math.max(translationWeight, 0.08)
		yawWeight = math.max(yawWeight, 0.1)
	end

	local finalAngle = math.min(1.2, magnitude) * angleRadians * blendWeight
	local pitch = -localDirection.Z * finalAngle
	local roll = localDirection.X * finalAngle
	local yaw = flutter * yawWeight * lod.detailScale * angleRadians * 0.35

	local translationDistance =
		self.objectHeight * clampNumber(self.config.heightMultiplier, 1, 0.1, 8) * translationWeight * magnitude * lod.windScale
	local translationWorld = direction * translationDistance + Vector3.new(0, -translationDistance * 0.06, 0)

	return pitch, yaw, roll, translationWorld
end

function FoliageInstance.ApplyTransform(self: FoliageInstance, pitch: number, yaw: number, roll: number, translationWorld: Vector3)
	if self.destroyed then
		return
	end

	if self.representation == "BasePart" then
		local part = self.part
		local restPivotFrame = self.restPivotFrame
		local pivotToObject = self.pivotToObject
		if part == nil or restPivotFrame == nil or pivotToObject == nil or part.Parent == nil then
			return
		end

		local pivotFrame = restPivotFrame + translationWorld
		local finalCFrame = pivotFrame * CFrame.Angles(pitch, yaw, roll) * pivotToObject
		part.CFrame = finalCFrame
		return
	end

	if self.representation == "Model" then
		local model = self.model
		local restPivotFrame = self.restPivotFrame
		local pivotToObject = self.pivotToObject
		if model == nil or restPivotFrame == nil or pivotToObject == nil or model.Parent == nil then
			return
		end

		local pivotFrame = restPivotFrame + translationWorld
		model:PivotTo(pivotFrame * CFrame.Angles(pitch, yaw, roll) * pivotToObject)
		return
	end

	local lateralOffset = self.referenceFrame:VectorToObjectSpace(translationWorld)
	for _, record in self.bones do
		if record.bone.Parent == nil then
			continue
		end

		local weight = record.weight
		record.bone.Transform =
			record.restTransform
			* CFrame.new(lateralOffset * weight * 0.18)
			* CFrame.Angles(pitch * weight, yaw * weight, roll * weight)
	end
end

function FoliageInstance.Step(self: FoliageInstance, simulationTime: number, dt: number, windSample: WindSample, lod: LODState)
	if self.destroyed or dt <= 0 then
		return
	end
	if self.treeGraph ~= nil then
		self.treeGraph:step(simulationTime, dt, windSample, lod)
		self.rootPosition = self.treeGraph:getRootPosition()
		self.lastUpdateTime = simulationTime
		return
	end

	local recoverySpeed = clampNumber(self.config.recoverySpeed, 4, 0, 30)
	self.reactiveBend = Damp.value(self.reactiveBend, ZERO, recoverySpeed, dt)
	if self.reactiveBend.Magnitude <= 1e-4 then
		self.reactiveBend = ZERO
	end

	local swayAmplitude = clampNumber(self.config.swayAmplitude, 1, 0, 10)
	local gustSensitivity = clampNumber(self.config.gustSensitivity, 1, 0, 10)
	local detailAmplitude = clampNumber(self.config.detailAmplitude, 0.22, 0, 10)
	local heightMultiplier = clampNumber(self.config.heightMultiplier, 1, 0.1, 8)

	local target =
		(windSample.vector * swayAmplitude + windSample.direction * windSample.gustAlpha * gustSensitivity)
		* lod.windScale
	target += windSample.detailVector * detailAmplitude * lod.detailScale
	target += self.reactiveBend * lod.disturbanceScale
	target *= heightMultiplier * self.amplitudeScale
	target = Vec.flattenY(target)

	if target.Magnitude > 1.35 then
		target = target.Unit * 1.35
	end

	local stiffness = clampNumber(self.config.bendStiffness, 12, 0.1, 200)
	local damping = clampNumber(self.config.damping, 7, 0, 100)
	local acceleration = (target - self.currentBend) * stiffness - self.springVelocity * damping
	self.springVelocity += acceleration * dt
	self.currentBend += self.springVelocity * dt

	if self.currentBend.Magnitude <= 1e-4 and self.springVelocity.Magnitude <= 1e-4 and target.Magnitude <= 1e-4 then
		self.currentBend = ZERO
		self.springVelocity = ZERO
	end

	local pitch, yaw, roll, translationWorld =
		self:resolveLocalAngles(self.currentBend, windSample.flutter, lod)
	self:applyTransform(pitch, yaw, roll, translationWorld)
	self.lastUpdateTime = simulationTime
end

function FoliageInstance.Destroy(self: FoliageInstance)
	if self.destroyed then
		return
	end
	self.destroyed = true
	if self.treeGraph ~= nil then
		self.treeGraph:destroy()
		local janitor = self.janitor :: JanitorClass
		janitor:Destroy()
		return
	end

	if self.representation == "BasePart" then
		if self.part ~= nil and self.part.Parent ~= nil and self.restCFrame ~= nil then
			self.part.CFrame = self.restCFrame
		end
	elseif self.representation == "Model" then
		if self.model ~= nil and self.model.Parent ~= nil and self.restCFrame ~= nil then
			self.model:PivotTo(self.restCFrame)
		end
	else
		for _, record in self.bones do
			if record.bone.Parent ~= nil then
				record.bone.Transform = record.restTransform
			end
		end
	end

	local janitor = self.janitor :: JanitorClass
	janitor:Destroy()
end

FoliageInstance.new = FoliageInstance.New
FoliageInstance.getRootPosition = FoliageInstance.GetRootPosition
FoliageInstance.resetPose = FoliageInstance.ResetPose
FoliageInstance.addDisturbance = FoliageInstance.AddDisturbance
FoliageInstance.resolveLocalAngles = FoliageInstance.ResolveLocalAngles
FoliageInstance.applyTransform = FoliageInstance.ApplyTransform
FoliageInstance.step = FoliageInstance.Step
FoliageInstance.destroy = FoliageInstance.Destroy

return FoliageInstance
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="1135">
                <Properties>
                  <string name="Name">FoliageUpdateManager</string>
                  <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Sift = require(ReplicatedStorage.Packages.Sift)


local RippleMotion = require(script.Parent.RippleMotion)

local FoliageUpdateManager = {}
FoliageUpdateManager.__index = FoliageUpdateManager

local RUNTIME_ATTRIBUTE_LOD = "WindRuntimeLOD"
local RUNTIME_ATTRIBUTE_WRITES = "WindRuntimeWrites"
local WORLD_ANIMATOR_ACTIVE_ATTRIBUTE = "WorldAnimatorAnimating"
local MAX_EFFECTIVE_STEP_DT = 0.1
local MAX_STALE_ELAPSED = 0.75

local function setAttributeIfChanged(instance: Instance, attributeName: string, value: any)
	if instance:GetAttribute(attributeName) == value then
		return
	end
	instance:SetAttribute(attributeName, value)
end

export type FoliageUpdateManager = typeof(setmetatable({} :: any, FoliageUpdateManager))

local ZERO = Vector3.zero

local function clampNumber(valueRaw: any, fallback: number, minimum: number, maximum: number): number
	local value = if typeof(valueRaw) == "number" and valueRaw == valueRaw then valueRaw else fallback
	if value < minimum then
		return minimum
	end
	if value > maximum then
		return maximum
	end
	return value
end

local function resolveDirectionOrFallback(vector: Vector3, fallback: Vector3): Vector3
	local planar = Vector3.new(vector.X, 0, vector.Z)
	if planar.Magnitude <= 1e-5 then
		local fallbackPlanar = Vector3.new(fallback.X, 0, fallback.Z)
		if fallbackPlanar.Magnitude <= 1e-5 then
			return Vector3.xAxis
		end
		return fallbackPlanar.Unit
	end
	return planar.Unit
end

local function isInAnimatingChunk(instance: Instance): boolean
	local current: Instance? = instance
	while current ~= nil do
		if current:GetAttribute(WORLD_ANIMATOR_ACTIVE_ATTRIBUTE) == true then
			return true
		end
		current = current.Parent
	end
	return false
end

local function resetEntryDrivers(entry: any)
	entry.primarySwayMotion:immediate(ZERO)
	entry.secondarySwayMotion:immediate(ZERO)
	entry.interactionBendMotion:immediate(ZERO)
	entry.canopyFlutterMotion:immediate(0)

	local resolved = entry.resolvedWindSample
	resolved.vector = ZERO
	resolved.direction = Vector3.xAxis
	resolved.strength = 0
	resolved.gustAlpha = 0
	resolved.detailAlpha = 0
	resolved.detailVector = ZERO
	resolved.flutter = 0
end

function FoliageUpdateManager.New(configRaw: any?, registry: any, windField: any, lodController: any, bufferPool: any): FoliageUpdateManager
	local config = if typeof(configRaw) == "table" then configRaw else {}
	local runtime = if typeof(config.runtime) == "table" then config.runtime else {}
	local self = setmetatable({
		config = config,
		runtimeConfig = runtime,
		registry = registry,
		windField = windField,
		lodController = lodController,
		bufferPool = bufferPool,
		entryCursor = 0,
		enableSecondaryFlutter = runtime.enableSecondaryFlutter ~= false,
		maxActiveTrees = math.max(1, math.floor(clampNumber(runtime.maxActiveTrees, 128, 1, 4096))),
		maxInteractiveTrees = math.max(1, math.floor(clampNumber(runtime.maxInteractiveTrees, 24, 1, 1024))),
		maxTransformWritesPerStep = math.max(1, math.floor(clampNumber(runtime.maxTransformWritesPerStep, 24000, 1, 1000000))),
		branchCapPerTree = math.max(1, math.floor(clampNumber(runtime.branchCapPerTree, 99999, 1, 999999))),
		leafClusterCapPerTree = math.max(1, math.floor(clampNumber(runtime.leafClusterCapPerTree, 99999, 1, 999999))),
		debugEnabled = if typeof(runtime.debug) == "table" then runtime.debug.enabled == true else false,
		stats = {
			registeredTrees = 0,
			activeAnimatedTrees = 0,
			culledTrees = 0,
			nearTrees = 0,
			midTrees = 0,
			farTrees = 0,
			frozenTrees = 0,
			activeRippleDrivers = 0,
			transformWrites = 0,
			averageUpdateCostMs = 0,
		},
		primarySpring = RippleMotion.resolveSpring(runtime.primaryDriverStiffness, runtime.primaryDriverDamping, 8, 5.5),
		secondarySpring = RippleMotion.resolveSpring(runtime.secondaryDriverStiffness, runtime.secondaryDriverDamping, 12, 6.5),
		interactionSpring = RippleMotion.resolveSpring(runtime.interactionDriverStiffness, runtime.interactionDriverDamping, 7.5, 5.2),
		flutterSpring = RippleMotion.resolveSpring(runtime.flutterDriverStiffness, runtime.flutterDriverDamping, 14, 7.5),
	}, FoliageUpdateManager)

	return self
end

function FoliageUpdateManager.ApplyInteractionImpulse(_self: FoliageUpdateManager, entry: any, impulseWorld: Vector3, originWorldRaw: any?)
	entry.interactionBendMotion:impulse(impulseWorld * 0.18)
	entry.foliage:addDisturbance(impulseWorld, originWorldRaw)
end

function FoliageUpdateManager.UpdateEntryDrivers(self: FoliageUpdateManager, entry: any, baseSample: any, dt: number)
	local primaryTarget = Vector3.new(baseSample.vector.X, 0, baseSample.vector.Z)
	local secondaryTarget = if self.enableSecondaryFlutter then baseSample.detailVector * baseSample.detailAlpha else ZERO

	entry.primarySwayMotion:spring(primaryTarget, self.primarySpring)
	entry.primarySwayMotion:step(dt)
	entry.secondarySwayMotion:spring(secondaryTarget, self.secondarySpring)
	entry.secondarySwayMotion:step(dt)
	entry.interactionBendMotion:spring(ZERO, self.interactionSpring)
	entry.interactionBendMotion:step(dt)
	entry.canopyFlutterMotion:spring(if self.enableSecondaryFlutter then baseSample.flutter else 0, self.flutterSpring)
	entry.canopyFlutterMotion:step(dt)

	local primaryValue = entry.primarySwayMotion:get()
	local secondaryValue = entry.secondarySwayMotion:get()
	local interactionValue = entry.interactionBendMotion:get()
	local flutterValue = entry.canopyFlutterMotion:get()

	local resolved = entry.resolvedWindSample
	local combinedVector = primaryValue + interactionValue
	resolved.vector = combinedVector
	resolved.direction = resolveDirectionOrFallback(combinedVector, baseSample.direction)
	resolved.strength = (combinedVector + secondaryValue).Magnitude
	resolved.gustAlpha = baseSample.gustAlpha
	resolved.detailAlpha = if self.enableSecondaryFlutter then baseSample.detailAlpha else 0
	resolved.detailVector = secondaryValue
	resolved.flutter = if typeof(flutterValue) == "number" then flutterValue else 0
	return resolved
end

function FoliageUpdateManager.Update(self: FoliageUpdateManager, simulationTime: number, _dt: number, referencePosition: Vector3)
	local startClock = os.clock()
	local entries = self.registry.entries
	local entryCount = #entries

	local activeAnimatedTrees = 0
	local culledTrees = 0
	local nearTrees = 0
	local midTrees = 0
	local farTrees = 0
	local frozenTrees = 0
	local transformWrites = 0

	if entryCount <= 0 then
		self.stats.registeredTrees = 0
		self.stats.activeAnimatedTrees = 0
		self.stats.culledTrees = 0
		self.stats.nearTrees = 0
		self.stats.midTrees = 0
		self.stats.farTrees = 0
		self.stats.frozenTrees = 0
		self.stats.activeRippleDrivers = 0
		self.stats.transformWrites = 0
		self.stats.averageUpdateCostMs = 0
		return
	end

	local startIndex = (self.entryCursor % entryCount) + 1
	for offset = 0, entryCount - 1 do
		local index = ((startIndex + offset - 1) % entryCount) + 1
		local entry = entries[index]
		if entry == nil then
			continue
		end
		if entry.instance.Parent == nil or entry.foliage.destroyed then
			self.registry:unregister(entry.instance)
			continue
		end
		if isInAnimatingChunk(entry.instance) then
			entry.foliage:resetPose()
			entry.rootPosition = entry.foliage:getRootPosition()
			resetEntryDrivers(entry)
			entry.lastUpdateTime = simulationTime
			continue
		end

		local delta = entry.rootPosition - referencePosition
		local distanceSquared = delta:Dot(delta)
		local tier = self.lodController:resolve(distanceSquared, entry.rootPosition, entry.boundingRadius)
		entry.lastDistanceSquared = distanceSquared
		entry.lastTierName = if tier ~= nil then tier.name else "Culled"

		if tier == nil then
			culledTrees += 1
			if self.debugEnabled then
				setAttributeIfChanged(entry.instance, RUNTIME_ATTRIBUTE_LOD, "Culled")
			end
			continue
		end

		if entry.branchCount > self.branchCapPerTree or entry.leafCount > self.leafClusterCapPerTree then
			tier = self.lodController:degrade(tier)
			entry.lastTierName = tier.name
		end

		if tier.name == "Near" then
			nearTrees += 1
		elseif tier.name == "Mid" then
			midTrees += 1
		elseif tier.name == "Far" then
			farTrees += 1
		else
			frozenTrees += 1
		end

		if entry.lastUpdateTime <= 0 then
			entry.foliage:resetPose()
			entry.rootPosition = entry.foliage:getRootPosition()
			resetEntryDrivers(entry)
			entry.lastUpdateTime = simulationTime
			if self.debugEnabled then
				setAttributeIfChanged(entry.instance, RUNTIME_ATTRIBUTE_LOD, tier.name)
			end
			continue
		end

		local elapsed = simulationTime - entry.lastUpdateTime
		if elapsed > MAX_STALE_ELAPSED then
			entry.foliage:resetPose()
			entry.rootPosition = entry.foliage:getRootPosition()
			resetEntryDrivers(entry)
			entry.lastUpdateTime = simulationTime
			if self.debugEnabled then
				setAttributeIfChanged(entry.instance, RUNTIME_ATTRIBUTE_LOD, tier.name)
			end
			continue
		end
		if elapsed < tier.updateInterval then
			if self.debugEnabled then
				setAttributeIfChanged(entry.instance, RUNTIME_ATTRIBUTE_LOD, tier.name)
			end
			continue
		end

		if activeAnimatedTrees >= self.maxActiveTrees then
			culledTrees += 1
			continue
		end
		if transformWrites + entry.estimatedTransformWrites > self.maxTransformWritesPerStep then
			culledTrees += 1
			continue
		end

		local baseSample =
			self.windField:sample(entry.rootPosition, simulationTime, entry.phaseOffset, entry.amplitudeScale)
		local effectiveDt = math.min(elapsed, MAX_EFFECTIVE_STEP_DT)
		local resolvedSample = self:updateEntryDrivers(entry, baseSample, effectiveDt)

		if not tier.frozen then
			entry.foliage:step(simulationTime, effectiveDt, resolvedSample, tier.lodState)
			entry.rootPosition = entry.foliage:getRootPosition()
			transformWrites += entry.estimatedTransformWrites
			activeAnimatedTrees += 1
		end

		entry.lastUpdateTime = simulationTime
		if self.debugEnabled then
			setAttributeIfChanged(entry.instance, RUNTIME_ATTRIBUTE_LOD, tier.name)
			setAttributeIfChanged(entry.instance, RUNTIME_ATTRIBUTE_WRITES, entry.estimatedTransformWrites)
		end
	end

	self.entryCursor = startIndex
	self.stats.registeredTrees = self.registry:count()
	self.stats.activeAnimatedTrees = activeAnimatedTrees
	self.stats.culledTrees = culledTrees
	self.stats.nearTrees = nearTrees
	self.stats.midTrees = midTrees
	self.stats.farTrees = farTrees
	self.stats.frozenTrees = frozenTrees
	self.stats.activeRippleDrivers = self.registry:count() * 4
	self.stats.transformWrites = transformWrites
	self.stats.averageUpdateCostMs = (os.clock() - startClock) * 1000
end

function FoliageUpdateManager.GetStats(self: FoliageUpdateManager): { [string]: number }
	return Sift.Dictionary.copy(self.stats)
end

FoliageUpdateManager.new = FoliageUpdateManager.New
FoliageUpdateManager.applyInteractionImpulse = FoliageUpdateManager.ApplyInteractionImpulse
FoliageUpdateManager.updateEntryDrivers = FoliageUpdateManager.UpdateEntryDrivers
FoliageUpdateManager.update = FoliageUpdateManager.Update
FoliageUpdateManager.getStats = FoliageUpdateManager.GetStats

return FoliageUpdateManager
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="1136">
                <Properties>
                  <string name="Name">LODController</string>
                  <string name="Source"><![CDATA[--!strict

local Workspace = game:GetService("Workspace")

local LODController = {}
LODController.__index = LODController

export type TierState = {
	name: string,
	updateInterval: number,
	lodState: {
		level: string,
		windScale: number,
		detailScale: number,
		disturbanceScale: number,
	},
	priority: number,
	frozen: boolean,
	canopyOnly: boolean,
}

export type LODController = typeof(setmetatable({} :: any, LODController))

local function clampNumber(valueRaw: any, fallback: number, minimum: number, maximum: number): number
	local value = if typeof(valueRaw) == "number" and valueRaw == valueRaw then valueRaw else fallback
	if value < minimum then
		return minimum
	end
	if value > maximum then
		return maximum
	end
	return value
end

local function buildTier(
	name: string,
	updateIntervalRaw: any,
	defaultInterval: number,
	windScaleRaw: any,
	defaultWindScale: number,
	detailScaleRaw: any,
	defaultDetailScale: number,
	disturbanceScaleRaw: any,
	defaultDisturbanceScale: number,
	priority: number,
	frozen: boolean,
	canopyOnly: boolean
): TierState
	return {
		name = name,
		updateInterval = clampNumber(updateIntervalRaw, defaultInterval, 1 / 240, 10),
		lodState = {
			level = name,
			windScale = clampNumber(windScaleRaw, defaultWindScale, 0, 4),
			detailScale = clampNumber(detailScaleRaw, defaultDetailScale, 0, 4),
			disturbanceScale = clampNumber(disturbanceScaleRaw, defaultDisturbanceScale, 0, 4),
		},
		priority = priority,
		frozen = frozen,
		canopyOnly = canopyOnly,
	}
end

function LODController.New(configRaw: any?): LODController
	local config = if typeof(configRaw) == "table" then configRaw else {}
	local runtime = if typeof(config.runtime) == "table" then config.runtime else {}
	local lod = if typeof(config.lod) == "table" then config.lod else {}

	local nearFallback = clampNumber(lod.nearDistance, 54, 0, 5000)
	local nearDistance = clampNumber(runtime.nearDistance, nearFallback, 0, 5000)
	local midFallback = clampNumber(lod.midDistance, 118, nearDistance, 5000)
	local midDistance = clampNumber(runtime.midDistance, midFallback, nearDistance, 5000)
	local farFallback = clampNumber(lod.farDistance, 190, midDistance, 10000)
	local farDistance = clampNumber(runtime.farDistance, farFallback, midDistance, 10000)
	local cullFallback = clampNumber(lod.cullDistance, 280, farDistance, 20000)
	local cullDistance = clampNumber(runtime.cullDistance, cullFallback, farDistance, 20000)

	local self = setmetatable({
		nearDistanceSquared = nearDistance * nearDistance,
		midDistanceSquared = midDistance * midDistance,
		farDistanceSquared = farDistance * farDistance,
		cullDistanceSquared = cullDistance * cullDistance,
		viewDotCull = clampNumber(runtime.viewDotCull, -0.35, -1, 1),
		enableVisibilityCull = runtime.enableVisibilityCull ~= false,
		tierNear = buildTier(
			"Near",
			runtime.nearUpdateInterval or lod.nearUpdateInterval,
			1 / 60,
			runtime.nearWindScale,
			1,
			runtime.nearDetailScale,
			1,
			runtime.nearDisturbanceScale,
			1,
			3,
			false,
			false
		),
		tierMid = buildTier(
			"Mid",
			runtime.midUpdateInterval or lod.midUpdateInterval,
			0.12,
			runtime.midWindScale,
			0.82,
			runtime.midDetailScale,
			0.42,
			runtime.midDisturbanceScale,
			0.42,
			2,
			false,
			false
		),
		tierFar = buildTier(
			"Far",
			runtime.farUpdateInterval or lod.farUpdateInterval,
			0.32,
			runtime.farWindScale,
			0.56,
			runtime.farDetailScale,
			0.1,
			runtime.farDisturbanceScale,
			0,
			1,
			false,
			runtime.enableCanopyOnlyFar == true
		),
		tierFrozen = buildTier(
			"Frozen",
			runtime.frozenUpdateInterval,
			0.75,
			0,
			0,
			0,
			0,
			0,
			0,
			0,
			true,
			false
		),
	}, LODController)

	return self
end

function LODController.IsVisible(self: LODController, worldPosition: Vector3, boundingRadius: number): boolean
	if not self.enableVisibilityCull then
		return true
	end

	local camera = Workspace.CurrentCamera
	if camera == nil then
		return true
	end

	local cameraPosition = camera.CFrame.Position
	local toTree = worldPosition - cameraPosition
	local distance = toTree.Magnitude
	if distance <= math.max(4, boundingRadius) then
		return true
	end
	if distance <= 1e-4 then
		return true
	end

	local dot = camera.CFrame.LookVector:Dot(toTree / distance)
	return dot >= self.viewDotCull
end

function LODController.Resolve(self: LODController, distanceSquared: number, worldPosition: Vector3, boundingRadius: number): TierState?
	if distanceSquared > self.cullDistanceSquared then
		return nil
	end

	if distanceSquared <= self.nearDistanceSquared then
		return self.tierNear
	end

	if not self:isVisible(worldPosition, boundingRadius) then
		return self.tierFrozen
	end

	if distanceSquared <= self.midDistanceSquared then
		return self.tierMid
	end
	if distanceSquared <= self.farDistanceSquared then
		return self.tierFar
	end
	return self.tierFrozen
end

function LODController.Degrade(self: LODController, tier: TierState): TierState
	if tier.name == "Near" then
		return self.tierMid
	end
	if tier.name == "Mid" then
		return self.tierFar
	end
	return self.tierFrozen
end

LODController.new = LODController.New
LODController.isVisible = LODController.IsVisible
LODController.resolve = LODController.Resolve
LODController.degrade = LODController.Degrade

return LODController
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="1137">
                <Properties>
                  <string name="Name">RippleMotion</string>
                  <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Ripple = require(ReplicatedStorage.Packages.Ripple)

local RippleMotion = {}

local function clampNumber(valueRaw: any, fallback: number, minimum: number, maximum: number): number
	local value = if typeof(valueRaw) == "number" and valueRaw == valueRaw then valueRaw else fallback
	if value < minimum then
		return minimum
	end
	if value > maximum then
		return maximum
	end
	return value
end

function RippleMotion.CreateMotion(initialValue: any): any
	local motion = Ripple.createMotion(initialValue)
	motion:immediate(initialValue)
	return motion
end

function RippleMotion.CreateVectorMotion(initialValue: Vector3): any
	return RippleMotion.CreateMotion(initialValue)
end

function RippleMotion.ResolveSpring(stiffnessRaw: any, dampingRaw: any, fallbackStiffness: number, fallbackDamping: number): { [string]: number }
	local stiffness = clampNumber(stiffnessRaw, fallbackStiffness, 0.01, 200)
	local damping = clampNumber(dampingRaw, fallbackDamping, 0, 100)
	local omega = math.sqrt(stiffness)
	local frequency = math.max(omega / (2 * math.pi), 0.01)
	local dampingRatio = if omega <= 1e-4 then 1 else math.max(damping / (2 * omega), 0)

	return {
		frequency = frequency,
		damping = dampingRatio,
	}
end

RippleMotion.createMotion = RippleMotion.CreateMotion
RippleMotion.createVectorMotion = RippleMotion.CreateVectorMotion
RippleMotion.resolveSpring = RippleMotion.ResolveSpring

return RippleMotion
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="1138">
                <Properties>
                  <string name="Name">TreeFoliageGraph</string>
                  <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local DeterministicRNG = require(script:FindFirstAncestor("game").Shared.Modules.Core.DeterministicRNG)
local Damp = require(script:FindFirstAncestor("game").Shared.Modules.Math.Damp)
local Vec = require(script:FindFirstAncestor("game").Shared.Modules.Math.Vec)

local TreeFoliageGraph = {}
TreeFoliageGraph.__index = TreeFoliageGraph

export type WindSample = {
	vector: Vector3,
	direction: Vector3,
	strength: number,
	gustAlpha: number,
	detailAlpha: number,
	detailVector: Vector3,
	flutter: number,
}

export type LODState = {
	level: string,
	windScale: number,
	detailScale: number,
	disturbanceScale: number,
}

type BranchNode = {
	part: BasePart,
	index: number,
	parentIndex: number,
	depth: number,
	restLocal: CFrame,
	jointToPart: CFrame,
	restWorld: CFrame,
	currentWorld: CFrame,
	currentBend: Vector3,
	springVelocity: Vector3,
	reactiveBend: Vector3,
	phaseOffset: number,
	amplitudeScale: number,
	stiffness: number,
	damping: number,
	maxAngleRadians: number,
	swayScale: number,
	detailScale: number,
	inheritedScale: number,
	disturbanceScale: number,
	yawScale: number,
	recoverySpeed: number,
}

type LeafNode = {
	part: BasePart,
	index: number,
	parentIndex: number,
	restLocal: CFrame,
	restWorld: CFrame,
	currentWorld: CFrame,
	currentBend: Vector3,
	springVelocity: Vector3,
	reactiveBend: Vector3,
	phaseOffset: number,
	amplitudeScale: number,
	stiffness: number,
	damping: number,
	maxAngleRadians: number,
	swayScale: number,
	detailScale: number,
	inheritedScale: number,
	disturbanceScale: number,
	yawScale: number,
	translationScale: number,
	recoverySpeed: number,
}

type Config = {
	seed: number,
	bendStiffness: number,
	damping: number,
	maxBendAngle: number,
	heightMultiplier: number,
	swayAmplitude: number,
	gustSensitivity: number,
	recoverySpeed: number,
	disturbanceSensitivity: number,
	detailAmplitude: number?,
}

export type TreeFoliageGraph = typeof(setmetatable({} :: any, TreeFoliageGraph))

local ZERO = Vector3.zero
local TREE_GRAPH_ATTRIBUTE = "WindFoliageTreeGraph"
local NODE_TYPE_ATTRIBUTE = "WindTreeNodeType"
local NODE_INDEX_ATTRIBUTE = "WindTreeNodeIndex"
local PARENT_INDEX_ATTRIBUTE = "WindTreeParentIndex"
local DEPTH_ATTRIBUTE = "WindTreeDepth"

local function clampNumber(valueRaw: any, fallback: number, minimum: number, maximum: number): number
	local value = if typeof(valueRaw) == "number" and valueRaw == valueRaw then valueRaw else fallback
	if value < minimum then
		return minimum
	end
	if value > maximum then
		return maximum
	end
	return value
end

local function resolveDeterministicPhase(seed: number, salt: string): (number, number)
	local nodeSeed = DeterministicRNG.seedFrom(("%s:%s"):format(tostring(seed), salt))
	local phaseOffset = (nodeSeed % 100000) / 100000 * math.pi * 2
	local amplitudeScale = 0.92 + ((nodeSeed % 8191) / 8191) * 0.18
	return phaseOffset, amplitudeScale
end

local function resolveBranchBaseFrame(part: BasePart): CFrame
	return part.CFrame * CFrame.new(0, 0, part.Size.Z * 0.5)
end

local function resolveBranchTipFrame(part: BasePart): CFrame
	return part.CFrame * CFrame.new(0, 0, -part.Size.Z * 0.5)
end

local function resolveTrunkBasePosition(part: BasePart): Vector3
	return resolveBranchBaseFrame(part).Position
end

local function resolvePlanarAngles(referenceFrame: CFrame, bendWorld: Vector3, maxAngleRadians: number, yawAmount: number): (number, number, number)
	local planar = Vec.flattenY(bendWorld)
	local magnitude = planar.Magnitude
	if magnitude <= 1e-5 or maxAngleRadians <= 0 then
		return 0, 0, 0
	end

	local direction = planar / magnitude
	local localDirection = referenceFrame:VectorToObjectSpace(direction)
	local finalAngle = math.min(1.25, magnitude) * maxAngleRadians
	local pitch = -localDirection.Z * finalAngle
	local roll = localDirection.X * finalAngle
	return pitch, yawAmount, roll
end

local function decayReactive(node: any, dt: number)
	node.reactiveBend = Damp.value(node.reactiveBend, ZERO, node.recoverySpeed, dt)
	if node.reactiveBend.Magnitude <= 1e-4 then
		node.reactiveBend = ZERO
	end
end

local function integrateSpring(node: any, target: Vector3, dt: number)
	local acceleration = (target - node.currentBend) * node.stiffness - node.springVelocity * node.damping
	node.springVelocity += acceleration * dt
	node.currentBend += node.springVelocity * dt
	if node.currentBend.Magnitude <= 1e-4 and node.springVelocity.Magnitude <= 1e-4 and target.Magnitude <= 1e-4 then
		node.currentBend = ZERO
		node.springVelocity = ZERO
	end
end

local function applyImpulse(node: any, impulseWorld: Vector3, scale: number)
	local scaledImpulse = impulseWorld * scale
	if scaledImpulse.Magnitude <= 1e-5 then
		return
	end
	node.reactiveBend += scaledImpulse
	if node.reactiveBend.Magnitude > 2 then
		node.reactiveBend = node.reactiveBend.Unit * 2
	end
	node.springVelocity += scaledImpulse * 0.22
end

function TreeFoliageGraph.New(modelRaw: any, configRaw: any): TreeFoliageGraph?
	if typeof(modelRaw) ~= "Instance" or not (modelRaw :: Instance):IsA("Model") then
		return nil
	end
	local model = modelRaw :: Model
	if model:GetAttribute(TREE_GRAPH_ATTRIBUTE) ~= true then
		return nil
	end

	local config = if typeof(configRaw) == "table" then configRaw :: Config else nil
	if config == nil then
		return nil
	end

	local trunkPart: BasePart? = nil
	local trunkIndex = 0
	local branchCandidates = {}
	local leafCandidates = {}
	local maxDepth = 0

	for _, descendant in model:GetDescendants() do
		if not descendant:IsA("BasePart") then
			continue
		end

		local nodeType = descendant:GetAttribute(NODE_TYPE_ATTRIBUTE)
		if typeof(nodeType) ~= "string" then
			continue
		end

		local nodeIndex = descendant:GetAttribute(NODE_INDEX_ATTRIBUTE)
		if typeof(nodeIndex) ~= "number" then
			continue
		end
		local parentIndex = descendant:GetAttribute(PARENT_INDEX_ATTRIBUTE)
		if typeof(parentIndex) ~= "number" then
			parentIndex = 0
		end
		local depth = descendant:GetAttribute(DEPTH_ATTRIBUTE)
		if typeof(depth) ~= "number" then
			depth = 0
		end

		if nodeType == "Trunk" then
			trunkPart = descendant
			trunkIndex = nodeIndex
			if depth > maxDepth then
				maxDepth = depth
			end
		elseif nodeType == "Branch" then
			if depth > maxDepth then
				maxDepth = depth
			end
			branchCandidates[#branchCandidates + 1] = {
				part = descendant,
				index = nodeIndex,
				parentIndex = parentIndex,
				depth = depth,
			}
		elseif nodeType == "Leaf" then
			leafCandidates[#leafCandidates + 1] = {
				part = descendant,
				index = nodeIndex,
				parentIndex = parentIndex,
			}
		end
	end

	if trunkPart == nil or trunkIndex == 0 then
		return nil
	end

	table.sort(branchCandidates, function(a: any, b: any): boolean
		if a.depth ~= b.depth then
			return a.depth < b.depth
		end
		return a.index < b.index
	end)
	table.sort(leafCandidates, function(a: any, b: any): boolean
		return a.index < b.index
	end)

	local trunkRestWorld = trunkPart.CFrame
	local trunkRestTipWorld = resolveBranchTipFrame(trunkPart)
	local trunkThickness = math.max(0.25, trunkPart.Size.X)
	local branchNodesByIndex = {} :: { [number]: BranchNode }
	local branchOrder = {} :: { BranchNode }
	local leafNodes = {} :: { LeafNode }

	local baseStiffness = clampNumber(config.bendStiffness, 8.5, 0.1, 200)
	local baseDamping = clampNumber(config.damping, 6.3, 0, 100)
	local baseMaxAngleRadians = math.rad(clampNumber(config.maxBendAngle, 10, 0, 89))
	local baseRecovery = clampNumber(config.recoverySpeed, 3.2, 0, 30)
	local baseDisturbance = clampNumber(config.disturbanceSensitivity, 0.72, 0, 10)

	for _, candidate in branchCandidates do
		local parentAttachmentWorld = trunkRestTipWorld
		if candidate.parentIndex ~= trunkIndex and branchNodesByIndex[candidate.parentIndex] ~= nil then
			local parentBranch = branchNodesByIndex[candidate.parentIndex]
			parentAttachmentWorld = resolveBranchTipFrame(parentBranch.part)
		end

		local part = candidate.part :: BasePart
		part.Anchored = true
		part.Massless = false

		local branchBaseWorld = resolveBranchBaseFrame(part)
		local thinness = 1 - math.clamp(part.Size.X / trunkThickness, 0.1, 1)
		local depthAlpha = if maxDepth <= 0 then 1 else math.clamp(candidate.depth / maxDepth, 0, 1)
		local phaseOffset, amplitudeScale =
			resolveDeterministicPhase(config.seed, ("branch:%d"):format(candidate.index))

		local node = {
			part = part,
			index = candidate.index,
			parentIndex = candidate.parentIndex,
			depth = candidate.depth,
			restLocal = parentAttachmentWorld:ToObjectSpace(branchBaseWorld),
			jointToPart = branchBaseWorld:ToObjectSpace(part.CFrame),
			restWorld = part.CFrame,
			currentWorld = part.CFrame,
			currentBend = ZERO,
			springVelocity = ZERO,
			reactiveBend = ZERO,
			phaseOffset = phaseOffset,
			amplitudeScale = amplitudeScale,
			stiffness = baseStiffness * (0.55 + thinness * 1.2),
			damping = baseDamping * (0.9 + (1 - thinness) * 0.55),
			maxAngleRadians = baseMaxAngleRadians * (0.45 + thinness * 1.1 + depthAlpha * 0.2),
			swayScale = (0.3 + thinness * 0.95 + depthAlpha * 0.3),
			detailScale = (0.35 + thinness * 0.8),
			inheritedScale = 0.45 + depthAlpha * 0.35,
			disturbanceScale = baseDisturbance * (0.45 + thinness * 0.8 + depthAlpha * 0.2),
			yawScale = 0.05 + thinness * 0.08,
			recoverySpeed = baseRecovery * (0.9 + thinness * 0.5),
		} :: BranchNode

		branchNodesByIndex[node.index] = node
		branchOrder[#branchOrder + 1] = node
	end

	for _, candidate in leafCandidates do
		local parentAttachmentWorld = trunkRestTipWorld
		if branchNodesByIndex[candidate.parentIndex] ~= nil then
			parentAttachmentWorld = resolveBranchTipFrame(branchNodesByIndex[candidate.parentIndex].part)
		end

		local part = candidate.part :: BasePart
		part.Anchored = true
		part.Massless = false

		local parentBranch = branchNodesByIndex[candidate.parentIndex]
		local inheritedScale = if parentBranch ~= nil then 0.9 + math.min(0.4, parentBranch.depth * 0.05) else 0.95
		local phaseOffset, amplitudeScale =
			resolveDeterministicPhase(config.seed, ("leaf:%d"):format(candidate.index))

		leafNodes[#leafNodes + 1] = {
			part = part,
			index = candidate.index,
			parentIndex = candidate.parentIndex,
			restLocal = parentAttachmentWorld:ToObjectSpace(part.CFrame),
			restWorld = part.CFrame,
			currentWorld = part.CFrame,
			currentBend = ZERO,
			springVelocity = ZERO,
			reactiveBend = ZERO,
			phaseOffset = phaseOffset,
			amplitudeScale = amplitudeScale,
			stiffness = baseStiffness * 1.45,
			damping = baseDamping * 0.8,
			maxAngleRadians = baseMaxAngleRadians * 1.15,
			swayScale = 0.28,
			detailScale = 1.55,
			inheritedScale = inheritedScale,
			disturbanceScale = baseDisturbance * 0.85,
			yawScale = 0.18,
			translationScale = 0.06,
			recoverySpeed = baseRecovery * 1.35,
		} :: LeafNode
	end

	local ok, _, boundsSize = pcall(function()
		return model:GetBoundingBox()
	end)
	local influenceRadius = 16
	if ok and typeof(boundsSize) == "Vector3" then
		influenceRadius = math.max(8, boundsSize.Magnitude * 0.45)
	end

	local self = setmetatable({
		model = model,
		config = config,
		trunk = trunkPart,
		trunkIndex = trunkIndex,
		trunkRestWorld = trunkRestWorld,
		trunkRestTipWorld = trunkRestTipWorld,
		branchNodesByIndex = branchNodesByIndex,
		branchOrder = branchOrder,
		leafNodes = leafNodes,
		rootPosition = resolveTrunkBasePosition(trunkPart),
		influenceRadius = influenceRadius,
		destroyed = false,
	}, TreeFoliageGraph)

	self:reset()
	return self
end

function TreeFoliageGraph.GetRootPosition(self: TreeFoliageGraph): Vector3
	return self.rootPosition
end

function TreeFoliageGraph.Reset(self: TreeFoliageGraph)
	self.trunk.CFrame = self.trunkRestWorld
	self.rootPosition = resolveTrunkBasePosition(self.trunk)

	for _, branch in self.branchOrder do
		branch.currentBend = ZERO
		branch.springVelocity = ZERO
		branch.reactiveBend = ZERO
		branch.currentWorld = branch.restWorld
		branch.part.CFrame = branch.restWorld
	end

	for _, leaf in self.leafNodes do
		leaf.currentBend = ZERO
		leaf.springVelocity = ZERO
		leaf.reactiveBend = ZERO
		leaf.currentWorld = leaf.restWorld
		leaf.part.CFrame = leaf.restWorld
	end
end

function TreeFoliageGraph.AddDisturbance(self: TreeFoliageGraph, impulseWorld: Vector3, originWorldRaw: any?)
	if self.destroyed or impulseWorld.Magnitude <= 1e-5 then
		return
	end

	local originWorld = if typeof(originWorldRaw) == "Vector3" then originWorldRaw else self.rootPosition

	for _, branch in self.branchOrder do
		local distance = (branch.currentWorld.Position - originWorld).Magnitude
		local falloff = 1 - math.clamp(distance / self.influenceRadius, 0, 1)
		if falloff > 0 then
			applyImpulse(branch, impulseWorld, falloff * branch.disturbanceScale)
		end
	end

	for _, leaf in self.leafNodes do
		local distance = (leaf.currentWorld.Position - originWorld).Magnitude
		local falloff = 1 - math.clamp(distance / self.influenceRadius, 0, 1)
		if falloff > 0 then
			applyImpulse(leaf, impulseWorld, falloff * leaf.disturbanceScale)
		end
	end
end

function TreeFoliageGraph.Step(
	self: TreeFoliageGraph,
	simulationTime: number,
	dt: number,
	windSample: WindSample,
	lod: LODState
)
	if self.destroyed or dt <= 0 then
		return
	end

	self.trunk.CFrame = self.trunkRestWorld
	self.rootPosition = resolveTrunkBasePosition(self.trunk)

	local heightMultiplier = clampNumber(self.config.heightMultiplier, 0.72, 0.1, 8)
	local swayAmplitude = clampNumber(self.config.swayAmplitude, 0.46, 0, 10)
	local gustSensitivity = clampNumber(self.config.gustSensitivity, 0.86, 0, 10)
	local detailAmplitude = clampNumber(self.config.detailAmplitude, 0.12, 0, 10)

	local parentAttachmentByIndex = {
		[self.trunkIndex] = self.trunkRestTipWorld,
	} :: { [number]: CFrame }

	for _, branch in self.branchOrder do
		decayReactive(branch, dt)

		local parentAttachmentWorld = parentAttachmentByIndex[branch.parentIndex] or self.trunkRestTipWorld
		local jointRestWorld = parentAttachmentWorld * branch.restLocal
		local phaseWave = math.sin(simulationTime * 0.8 + branch.phaseOffset)

		local target =
			(windSample.vector * swayAmplitude + windSample.direction * windSample.gustAlpha * gustSensitivity)
			* branch.swayScale
			* lod.windScale
		target += windSample.detailVector * detailAmplitude * branch.detailScale * lod.detailScale
		target += windSample.direction * phaseWave * 0.045 * branch.detailScale * lod.detailScale
		target += branch.reactiveBend * lod.disturbanceScale
		target *= heightMultiplier * branch.amplitudeScale
		target = Vec.flattenY(target)
		if target.Magnitude > 1.2 then
			target = target.Unit * 1.2
		end

		integrateSpring(branch, target, dt)

		local yawAmount = windSample.flutter * branch.yawScale * lod.detailScale * 0.25
		local pitch, yaw, roll =
			resolvePlanarAngles(jointRestWorld, branch.currentBend, branch.maxAngleRadians, yawAmount)
		local dynamicLocal = CFrame.Angles(pitch, yaw, roll)
		local finalBaseWorld = parentAttachmentWorld * branch.restLocal * dynamicLocal
		local finalWorld = finalBaseWorld * branch.jointToPart
		branch.currentWorld = finalWorld
		branch.part.CFrame = finalWorld
		parentAttachmentByIndex[branch.index] = resolveBranchTipFrame(branch.part)
	end

	for _, leaf in self.leafNodes do
		decayReactive(leaf, dt)

		local parentAttachmentWorld = parentAttachmentByIndex[leaf.parentIndex] or self.trunkRestTipWorld
		local flutterWave = math.sin(simulationTime * 4.6 + leaf.phaseOffset)

		local target = windSample.vector * swayAmplitude * leaf.swayScale * lod.windScale
		target += windSample.detailVector * detailAmplitude * leaf.detailScale * lod.detailScale
		target += windSample.direction * flutterWave * 0.14 * lod.detailScale
		target += leaf.reactiveBend * lod.disturbanceScale
		target *= leaf.amplitudeScale
		target = Vec.flattenY(target)
		if target.Magnitude > 1.45 then
			target = target.Unit * 1.45
		end

		integrateSpring(leaf, target, dt)

		local restWorld = parentAttachmentWorld * leaf.restLocal
		local yawAmount = (windSample.flutter + flutterWave * 0.5) * leaf.yawScale * lod.detailScale
		local pitch, yaw, roll = resolvePlanarAngles(restWorld, leaf.currentBend, leaf.maxAngleRadians, yawAmount)
		local localTranslation = restWorld:VectorToObjectSpace(leaf.currentBend) * leaf.translationScale * lod.windScale
		local dynamicLocal = CFrame.new(localTranslation) * CFrame.Angles(pitch, yaw, roll)
		local finalWorld = parentAttachmentWorld * leaf.restLocal * dynamicLocal
		leaf.currentWorld = finalWorld
		leaf.part.CFrame = finalWorld
	end
end

function TreeFoliageGraph.Destroy(self: TreeFoliageGraph)
	if self.destroyed then
		return
	end
	self:reset()
	self.destroyed = true
end

TreeFoliageGraph.new = TreeFoliageGraph.New
TreeFoliageGraph.getRootPosition = TreeFoliageGraph.GetRootPosition
TreeFoliageGraph.reset = TreeFoliageGraph.Reset
TreeFoliageGraph.addDisturbance = TreeFoliageGraph.AddDisturbance
TreeFoliageGraph.step = TreeFoliageGraph.Step
TreeFoliageGraph.destroy = TreeFoliageGraph.Destroy

return TreeFoliageGraph
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="1139">
                <Properties>
                  <string name="Name">TreeRuntimeRegistry</string>
                  <string name="Source"><![CDATA[--!strict

local packageRoot = script:FindFirstAncestor("game").Parent
local loaderUtils = assert(packageRoot:FindFirstChild("LoaderUtils", true), "Missing LoaderUtils")
local loader = require(loaderUtils.Parent).load(script)
local Octree = loader("Octree")
local FoliageInstance = require(script.Parent.FoliageInstance)
local RippleMotion = require(script.Parent.RippleMotion)

local TreeRuntimeRegistry = {}
TreeRuntimeRegistry.__index = TreeRuntimeRegistry

local RUNTIME_ATTRIBUTE_ID = "WindRuntimeId"

local function setAttributeIfChanged(instance: Instance, attributeName: string, value: any)
	if instance:GetAttribute(attributeName) == value then
		return
	end
	instance:SetAttribute(attributeName, value)
end

export type RuntimeEntry = {
	id: number,
	instance: Instance,
	foliage: any,
	config: { [string]: any },
	rootPosition: Vector3,
	boundingRadius: number,
	trunkReference: Instance?,
	seed: number,
	representation: string,
	branchCount: number,
	leafCount: number,
	boneCount: number,
	animatableNodeCount: number,
	phaseOffset: number,
	amplitudeScale: number,
	lastUpdateTime: number,
	lastDistanceSquared: number,
	lastTierName: string,
	estimatedTransformWrites: number,
	primarySwayMotion: any,
	secondarySwayMotion: any,
	interactionBendMotion: any,
	canopyFlutterMotion: any,
	resolvedWindSample: { [string]: any },
	orderIndex: number,
	debugActive: boolean,
}

export type TreeRuntimeRegistry = typeof(setmetatable({} :: any, TreeRuntimeRegistry))

local ZERO = Vector3.zero

local function clampNumber(valueRaw: any, fallback: number, minimum: number, maximum: number): number
	local value = if typeof(valueRaw) == "number" and valueRaw == valueRaw then valueRaw else fallback
	if value < minimum then
		return minimum
	end
	if value > maximum then
		return maximum
	end
	return value
end

local function clearArray(array: { any })
	for index = #array, 1, -1 do
		array[index] = nil
	end
end

local function sortEntriesById(a: RuntimeEntry, b: RuntimeEntry): boolean
	return a.id < b.id
end

local function configureOctree(spatialIndex: any, maxRegionSize: number, maxDepth: number): any
	if typeof(spatialIndex) ~= "table" then
		return spatialIndex
	end

	-- Nevermore's Octree constructor is argumentless; configure its search bounds explicitly.
	spatialIndex._maxDepth = maxDepth
	spatialIndex._maxRegionSize = { maxRegionSize, maxRegionSize, maxRegionSize }
	return spatialIndex
end

local function resolveSeed(instance: Instance, config: { [string]: any }): number
	local seed = instance:GetAttribute("Seed")
	if typeof(seed) == "number" and seed == seed then
		return math.floor(seed)
	end
	local configSeed = config.seed
	if typeof(configSeed) == "number" and configSeed == configSeed then
		return math.floor(configSeed)
	end
	return 0
end

local function resolveBoundingRadius(instance: Instance, foliage: any): number
	if foliage.treeGraph ~= nil then
		local graph = foliage.treeGraph
		if typeof(graph.influenceRadius) == "number" then
			return math.max(2, graph.influenceRadius)
		end
	end

	if instance:IsA("BasePart") then
		return math.max(1, instance.Size.Magnitude * 0.5)
	end
	if instance:IsA("Model") then
		local ok, _, size = pcall(function()
			return instance:GetBoundingBox()
		end)
		if ok and typeof(size) == "Vector3" then
			return math.max(2, size.Magnitude * 0.5)
		end
	end
	return math.max(1, clampNumber(foliage.objectHeight, 4, 1, 512) * 0.75)
end

local function resolveTrunkReference(instance: Instance, foliage: any): Instance?
	if foliage.treeGraph ~= nil then
		local graph = foliage.treeGraph
		if typeof(graph.trunk) == "Instance" then
			return graph.trunk
		end
	end
	if foliage.part ~= nil then
		return foliage.part
	end
	if foliage.model ~= nil then
		return foliage.model.PrimaryPart or foliage.model
	end
	if instance:IsA("Model") then
		return instance.PrimaryPart or instance
	end
	return instance
end

local function resolveRuntimeShape(foliage: any): (number, number, number, number, string)
	if foliage.treeGraph ~= nil then
		local graph = foliage.treeGraph
		local branchCount = if typeof(graph.branchOrder) == "table" then #graph.branchOrder else 0
		local leafCount = if typeof(graph.leafNodes) == "table" then #graph.leafNodes else 0
		return branchCount, leafCount, 0, branchCount + leafCount + 1, "TreeGraph"
	end

	local boneCount = if typeof(foliage.bones) == "table" then #foliage.bones else 0
	if boneCount > 0 then
		return 0, 0, boneCount, boneCount, "Bone"
	end
	return 0, 0, 0, 1, tostring(foliage.representation or "BasePart")
end

function TreeRuntimeRegistry.New(configRaw: any?): TreeRuntimeRegistry
	local config = if typeof(configRaw) == "table" then configRaw else {}
	local gridCellSize = clampNumber(config.gridCellSize, 18, 1, 2048)
	local octreeMaxDepth = math.max(1, math.floor(clampNumber(config.octreeMaxDepth, 4, 1, 12)))
	local octreeMaxRegionSize =
		clampNumber(config.octreeMaxRegionSize, math.max(64, gridCellSize * (2 ^ octreeMaxDepth)), 8, 32768)

	local self = setmetatable({
		config = config,
		nextId = 0,
		entries = {} :: { RuntimeEntry },
		entriesById = {} :: { [number]: RuntimeEntry },
		entriesByInstance = {} :: { [Instance]: RuntimeEntry },
		spatialIndex = configureOctree(Octree.new(), octreeMaxRegionSize, octreeMaxDepth),
		spatialNodesById = {} :: { [number]: any },
		queryBuffer = {} :: { RuntimeEntry },
	}, TreeRuntimeRegistry)

	return self
end

function TreeRuntimeRegistry.Register(self: TreeRuntimeRegistry, instanceRaw: any, configRaw: any): RuntimeEntry?
	if typeof(instanceRaw) ~= "Instance" then
		return nil
	end

	local instance = instanceRaw :: Instance
	local existing = self.entriesByInstance[instance]
	if existing ~= nil then
		return existing
	end

	local config = if typeof(configRaw) == "table" then configRaw :: { [string]: any } else {}
	local foliage = FoliageInstance.new(instance, config)
	if foliage == nil then
		return nil
	end

	self.nextId += 1
	local branchCount, leafCount, boneCount, animatableNodeCount, representation = resolveRuntimeShape(foliage)
	local entry: RuntimeEntry = {
		id = self.nextId,
		instance = instance,
		foliage = foliage,
		config = config,
		rootPosition = foliage:getRootPosition(),
		boundingRadius = resolveBoundingRadius(instance, foliage),
		trunkReference = resolveTrunkReference(instance, foliage),
		seed = resolveSeed(instance, config),
		representation = representation,
		branchCount = branchCount,
		leafCount = leafCount,
		boneCount = boneCount,
		animatableNodeCount = animatableNodeCount,
		phaseOffset = if typeof(foliage.phaseOffset) == "number" then foliage.phaseOffset else 0,
		amplitudeScale = if typeof(foliage.amplitudeScale) == "number" then foliage.amplitudeScale else 1,
		lastUpdateTime = 0,
		lastDistanceSquared = math.huge,
		lastTierName = "Uninitialized",
		estimatedTransformWrites = math.max(1, animatableNodeCount),
		primarySwayMotion = RippleMotion.createMotion(ZERO),
		secondarySwayMotion = RippleMotion.createMotion(ZERO),
		interactionBendMotion = RippleMotion.createMotion(ZERO),
		canopyFlutterMotion = RippleMotion.createMotion(0),
		resolvedWindSample = {
			vector = ZERO,
			direction = Vector3.xAxis,
			strength = 0,
			gustAlpha = 0,
			detailAlpha = 0,
			detailVector = ZERO,
			flutter = 0,
		},
		orderIndex = #self.entries + 1,
		debugActive = false,
	}

	self.entriesByInstance[instance] = entry
	self.entriesById[entry.id] = entry
	self.entries[entry.orderIndex] = entry
	self.spatialNodesById[entry.id] = self.spatialIndex:CreateNode(entry.rootPosition, entry)
	setAttributeIfChanged(instance, RUNTIME_ATTRIBUTE_ID, entry.id)

	return entry
end

function TreeRuntimeRegistry.Unregister(self: TreeRuntimeRegistry, instanceRaw: any)
	if typeof(instanceRaw) ~= "Instance" then
		return
	end

	local instance = instanceRaw :: Instance
	local entry = self.entriesByInstance[instance]
	if entry == nil then
		return
	end

	self.entriesByInstance[instance] = nil
	self.entriesById[entry.id] = nil
	local spatialNode = self.spatialNodesById[entry.id]
	if spatialNode ~= nil then
		spatialNode:Destroy()
		self.spatialNodesById[entry.id] = nil
	end

	local orderIndex = entry.orderIndex
	local lastEntry = self.entries[#self.entries]
	self.entries[#self.entries] = nil
	if lastEntry ~= nil and lastEntry ~= entry then
		self.entries[orderIndex] = lastEntry
		lastEntry.orderIndex = orderIndex
	end

	setAttributeIfChanged(instance, RUNTIME_ATTRIBUTE_ID, nil)
	entry.primarySwayMotion:destroy()
	entry.secondarySwayMotion:destroy()
	entry.interactionBendMotion:destroy()
	entry.canopyFlutterMotion:destroy()
	entry.foliage:destroy()
end

function TreeRuntimeRegistry.Get(self: TreeRuntimeRegistry, instanceRaw: any): RuntimeEntry?
	if typeof(instanceRaw) ~= "Instance" then
		return nil
	end
	return self.entriesByInstance[instanceRaw]
end

function TreeRuntimeRegistry.Count(self: TreeRuntimeRegistry): number
	return #self.entries
end

function TreeRuntimeRegistry.QueryRadius(
	self: TreeRuntimeRegistry,
	positionRaw: any,
	radiusRaw: any,
	outRaw: { any }?
): { any }
	local position = if typeof(positionRaw) == "Vector3" then positionRaw else ZERO
	local radius = clampNumber(radiusRaw, 0, 0, 1000000)
	local out = if outRaw ~= nil then outRaw else self.queryBuffer
	clearArray(out)

	local results = self.spatialIndex:RadiusSearch(position, radius)
	for index, entry in results do
		out[index] = entry
	end

	if #out > 1 then
		table.sort(out, sortEntriesById)
	end

	return out
end

function TreeRuntimeRegistry.Destroy(self: TreeRuntimeRegistry)
	for index = #self.entries, 1, -1 do
		local entry = self.entries[index]
		if entry ~= nil then
			self:unregister(entry.instance)
		end
	end
	table.clear(self.entriesByInstance)
	table.clear(self.entriesById)
	table.clear(self.spatialNodesById)
	table.clear(self.queryBuffer)
end

TreeRuntimeRegistry.new = TreeRuntimeRegistry.New
TreeRuntimeRegistry.register = TreeRuntimeRegistry.Register
TreeRuntimeRegistry.unregister = TreeRuntimeRegistry.Unregister
TreeRuntimeRegistry.get = TreeRuntimeRegistry.Get
TreeRuntimeRegistry.count = TreeRuntimeRegistry.Count
TreeRuntimeRegistry.queryRadius = TreeRuntimeRegistry.QueryRadius
TreeRuntimeRegistry.destroy = TreeRuntimeRegistry.Destroy

return TreeRuntimeRegistry
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="1140">
                <Properties>
                  <string name="Name">WindField</string>
                  <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local DeterministicRNG = require(script:FindFirstAncestor("game").Shared.Modules.Core.DeterministicRNG)
local Noise = require(script:FindFirstAncestor("game").Shared.Modules.Math.Noise)
local Trig = require(script:FindFirstAncestor("game").Shared.Modules.Math.Trig)
local Vec = require(script:FindFirstAncestor("game").Shared.Modules.Math.Vec)

local WindField = {}
WindField.__index = WindField

export type WindSample = {
	vector: Vector3,
	direction: Vector3,
	strength: number,
	gustAlpha: number,
	detailAlpha: number,
	detailVector: Vector3,
	flutter: number,
}

export type WindField = typeof(setmetatable({} :: any, WindField))

export type Config = {
	seed: any?,
	baseDirection: Vector3?,
	strengthMultiplier: number?,
	baseStrength: number?,
	gustStrength: number?,
	detailStrength: number?,
	gustSpatialScale: number?,
	gustTimeScale: number?,
	detailSpatialScale: number?,
	detailTimeScale: number?,
	directionJitterDegrees: number?,
	gustOctaves: number?,
	detailOctaves: number?,
}

local ZERO = Vector3.zero
local DEFAULT_DIRECTION = Vector3.new(1, 0, 0.25)

local function clampNumber(valueRaw: any, fallback: number, minimum: number, maximum: number): number
	local value = if typeof(valueRaw) == "number" and valueRaw == valueRaw then valueRaw else fallback
	if value < minimum then
		return minimum
	end
	if value > maximum then
		return maximum
	end
	return value
end

local function sanitizeDirection(directionRaw: any): Vector3
	local direction = if typeof(directionRaw) == "Vector3" then directionRaw else DEFAULT_DIRECTION
	return Vec.unit(Vec.flattenY(direction), Vec.unit(DEFAULT_DIRECTION, Vector3.xAxis))
end

local function remapNoise(sample: number): number
	return Noise.toSigned(sample)
end

function WindField.New(configRaw: Config?): WindField
	local config = if typeof(configRaw) == "table" then configRaw else {}
	local seed = DeterministicRNG.seedFrom(config.seed or "WindFoliage")

	local self = setmetatable({
		baseDirection = sanitizeDirection(config.baseDirection),
		strengthMultiplier = clampNumber(config.strengthMultiplier, 1, 0, 10),
		baseStrength = clampNumber(config.baseStrength, 0.62, 0, 10),
		gustStrength = clampNumber(config.gustStrength, 0.9, 0, 10),
		detailStrength = clampNumber(config.detailStrength, 0.2, 0, 10),
		gustSpatialScale = clampNumber(config.gustSpatialScale, 140, 1, 5000),
		gustTimeScale = clampNumber(config.gustTimeScale, 0.16, 0.001, 20),
		detailSpatialScale = clampNumber(config.detailSpatialScale, 22, 1, 2000),
		detailTimeScale = clampNumber(config.detailTimeScale, 1.55, 0.001, 60),
		directionJitterRadians = Trig.degToRad(clampNumber(config.directionJitterDegrees, 18, 0, 180)),
		gustOctaves = math.floor(clampNumber(config.gustOctaves, 4, 1, 8)),
		detailOctaves = math.floor(clampNumber(config.detailOctaves, 3, 1, 8)),
		gustNoise = DeterministicRNG.createNoise(seed),
		directionNoise = DeterministicRNG.createNoise(seed + 73),
		detailNoise = DeterministicRNG.createNoise(seed + 181),
		flutterNoise = DeterministicRNG.createNoise(seed + 997),
	}, WindField)

	return self
end

function WindField.Sample(
	self: WindField,
	worldPosition: Vector3,
	timeSecondsRaw: any,
	phaseOffsetRaw: any?,
	amplitudeScaleRaw: any?
): WindSample
	local timeSeconds = if typeof(timeSecondsRaw) == "number" and timeSecondsRaw == timeSecondsRaw then timeSecondsRaw else 0
	local phaseOffset = if typeof(phaseOffsetRaw) == "number" and phaseOffsetRaw == phaseOffsetRaw then phaseOffsetRaw else 0
	local amplitudeScale = clampNumber(amplitudeScaleRaw, 1, 0, 10)
	local strengthMultiplier = self.strengthMultiplier

	local x = worldPosition.X
	local z = worldPosition.Z

	local phaseX = math.cos(phaseOffset) * 31.73
	local phaseZ = math.sin(phaseOffset) * 27.11

	local gustField = remapNoise(
		self.gustNoise:fbm3D(
			(x + phaseX) / self.gustSpatialScale,
			timeSeconds * self.gustTimeScale,
			(z + phaseZ) / self.gustSpatialScale,
			self.gustOctaves,
			0.55,
			2
		)
	)
	local sweepField = remapNoise(
		self.gustNoise:fbm3D(
			(x - phaseZ * 0.4) / (self.gustSpatialScale * 0.7),
			timeSeconds * (self.gustTimeScale * 0.75),
			(z + phaseX * 0.45) / (self.gustSpatialScale * 0.7),
			math.max(2, self.gustOctaves - 1),
			0.5,
			2.1
		)
	)
	local gustAlpha = math.clamp(0.55 + gustField * 0.35 + sweepField * 0.2, 0, 1.6)

	local directionJitter = remapNoise(
		self.directionNoise:fbm3D(
			(x + phaseX * 0.2) / (self.gustSpatialScale * 0.85),
			timeSeconds * (self.gustTimeScale * 0.55),
			(z + phaseZ * 0.2) / (self.gustSpatialScale * 0.85),
			3,
			0.5,
			2
		)
	) * self.directionJitterRadians

	local baseHeading = math.atan2(self.baseDirection.Z, self.baseDirection.X) + directionJitter
	local direction = Vector3.new(math.cos(baseHeading), 0, math.sin(baseHeading))
	if direction.Magnitude <= 1e-5 then
		direction = self.baseDirection
	end
	direction = Vec.unit(direction, self.baseDirection)

	local detailX = remapNoise(
		self.detailNoise:fbm3D(
			(x + phaseX * 0.7) / self.detailSpatialScale,
			timeSeconds * self.detailTimeScale,
			(z + phaseZ * 0.7) / self.detailSpatialScale,
			self.detailOctaves,
			0.58,
			2
		)
	)
	local detailZ = remapNoise(
		self.detailNoise:fbm3D(
			(x - phaseZ * 0.55) / self.detailSpatialScale,
			timeSeconds * (self.detailTimeScale * 0.92),
			(z + phaseX * 0.55) / self.detailSpatialScale,
			self.detailOctaves,
			0.58,
			2
		)
	)
	local detailVector = Vector3.new(detailX, 0, detailZ)
	local detailMagnitude = detailVector.Magnitude
	if detailMagnitude > 1e-5 then
		detailVector *= 1 / math.max(1, detailMagnitude)
	end

	local flutter = remapNoise(
		self.flutterNoise:fbm3D(
			(x + phaseX * 1.2) / (self.detailSpatialScale * 0.5),
			timeSeconds * (self.detailTimeScale * 1.35),
			(z - phaseZ * 1.2) / (self.detailSpatialScale * 0.5),
			2,
			0.65,
			2.2
		)
	)

	local scalarStrength =
		(self.baseStrength + self.gustStrength * gustAlpha + self.detailStrength * math.min(1, detailMagnitude))
		* amplitudeScale
		* strengthMultiplier
	local vector =
		direction * (self.baseStrength + self.gustStrength * gustAlpha) * amplitudeScale * strengthMultiplier
		+ detailVector * self.detailStrength * amplitudeScale * strengthMultiplier

	return {
		vector = vector,
		direction = direction,
		strength = scalarStrength,
		gustAlpha = gustAlpha,
		detailAlpha = math.min(1.5, detailMagnitude),
		detailVector = detailVector,
		flutter = flutter,
	}
end

WindField.ZeroSample = {
	vector = ZERO,
	direction = DEFAULT_DIRECTION.Unit,
	strength = 0,
	gustAlpha = 0,
	detailAlpha = 0,
	detailVector = ZERO,
	flutter = 0,
} :: WindSample

WindField.new = WindField.New
WindField.sample = WindField.Sample

return WindField
]]></string>
                </Properties>
              </Item>
