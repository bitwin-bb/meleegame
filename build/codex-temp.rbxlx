              <Item class="ModuleScript" referent="1226">
                <Properties>
                  <string name="Name">Angle</string>
                  <string name="Source"><![CDATA[--!strict
-- Angle wrapping, shortest deltas, and signed-angle helpers.

local Num = require(script.Parent.Num)
local Trig = require(script.Parent.Trig)

local Angle = {}

local X_AXIS = Vector3.new(1, 0, 0)
local Y_AXIS = Vector3.new(0, 1, 0)
local ZERO_2 = Vector2.zero
local TWO_PI = Trig.TAU

local function safeUnit2(vector: Vector2): Vector2
	local magnitude = vector.Magnitude
	if magnitude == 0 then
		return ZERO_2
	end
	return vector / magnitude
end

local function safeUnit3(vector: Vector3, fallback: Vector3): Vector3
	local magnitude = vector.Magnitude
	if magnitude == 0 then
		return fallback
	end
	return vector / magnitude
end

function Angle.WrapRadians(angleRadians: number): number
	local wrapped = (angleRadians + math.pi) % TWO_PI
	if wrapped < 0 then
		wrapped = wrapped + TWO_PI
	end
	return wrapped - math.pi
end

function Angle.WrapDegrees(angleDegrees: number): number
	local wrapped = (angleDegrees + 180) % 360
	if wrapped < 0 then
		wrapped = wrapped + 360
	end
	return wrapped - 180
end

function Angle.DeltaRadians(fromAngle: number, toAngle: number): number
	return Angle.WrapRadians(toAngle - fromAngle)
end

function Angle.DeltaDegrees(fromAngle: number, toAngle: number): number
	return Angle.WrapDegrees(toAngle - fromAngle)
end

function Angle.LerpRadians(fromAngle: number, toAngle: number, alpha: number): number
	return fromAngle + Angle.DeltaRadians(fromAngle, toAngle) * alpha
end

function Angle.LerpDegrees(fromAngle: number, toAngle: number, alpha: number): number
	return fromAngle + Angle.DeltaDegrees(fromAngle, toAngle) * alpha
end

function Angle.FromVector2(direction: Vector2): number
	if direction == ZERO_2 then
		return 0
	end
	return math.atan2(direction.Y, direction.X)
end

function Angle.Signed2D(fromDirection: Vector2, toDirection: Vector2): number
	local fromUnit = safeUnit2(fromDirection)
	local toUnit = safeUnit2(toDirection)
	if fromUnit == ZERO_2 or toUnit == ZERO_2 then
		return 0
	end

	local cross = fromUnit.X * toUnit.Y - fromUnit.Y * toUnit.X
	local dot = Num.clamp(fromUnit:Dot(toUnit), -1, 1)
	return math.atan2(cross, dot)
end

function Angle.Signed3D(fromDirection: Vector3, toDirection: Vector3, axis: Vector3): number
	local axisUnit = safeUnit3(axis, Y_AXIS)
	local fromUnit = safeUnit3(fromDirection, X_AXIS)
	local toUnit = safeUnit3(toDirection, fromUnit)
	local cross = fromUnit:Cross(toUnit)
	local dot = Num.clamp(fromUnit:Dot(toUnit), -1, 1)
	return math.atan2(axisUnit:Dot(cross), dot)
end

function Angle.Unsigned3D(fromDirection: Vector3, toDirection: Vector3): number
	local fromMagnitude = fromDirection.Magnitude
	local toMagnitude = toDirection.Magnitude
	if fromMagnitude == 0 or toMagnitude == 0 then
		return 0
	end

	local dot = Num.clamp(fromDirection:Dot(toDirection) / (fromMagnitude * toMagnitude), -1, 1)
	return math.acos(dot)
end

Angle.wrapRadians = Angle.WrapRadians
Angle.wrapDegrees = Angle.WrapDegrees
Angle.deltaRadians = Angle.DeltaRadians
Angle.deltaDegrees = Angle.DeltaDegrees
Angle.lerpRadians = Angle.LerpRadians
Angle.lerpDegrees = Angle.LerpDegrees
Angle.fromVector2 = Angle.FromVector2
Angle.signed2D = Angle.Signed2D
Angle.signed3D = Angle.Signed3D
Angle.unsigned3D = Angle.Unsigned3D

return Angle
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="1227">
                <Properties>
                  <string name="Name">Arc</string>
                  <string name="Source"><![CDATA[--!strict
-- Circular arc sampling and orbit helpers.

local Vec = require(script.Parent.Vec)
local Trig = require(script.Parent.Trig)

local Arc = {}

function Arc.Length(radius: number, angleRadians: number): number
	return math.abs(radius * angleRadians)
end

function Arc.AngleFromLength(length: number, radius: number): number
	if radius == 0 then
		return 0
	end
	return length / radius
end

function Arc.Chord(radius: number, angleRadians: number): number
	return 2 * math.abs(radius) * math.sin(math.abs(angleRadians) * 0.5)
end

function Arc.Point2(center: Vector2, radius: number, angleRadians: number): Vector2
	local sinValue, cosValue = Trig.sinCos(angleRadians)
	return center + Vector2.new(cosValue, sinValue) * radius
end

function Arc.Tangent2(radius: number, angleRadians: number): Vector2
	local sinValue, cosValue = Trig.sinCos(angleRadians)
	return Vector2.new(-sinValue, cosValue) * radius
end

function Arc.Orbit2(center: Vector2, radius: number, angleRadians: number, angularVelocity: number?): (Vector2, Vector2)
	local velocityScale = angularVelocity or 1
	local position = Arc.Point2(center, radius, angleRadians)
	local velocity = Arc.Tangent2(radius, angleRadians) * velocityScale
	return position, velocity
end

function Arc.Point3(
	center: Vector3,
	radius: number,
	angleRadians: number,
	xAxis: Vector3,
	yAxis: Vector3
): Vector3
	local sinValue, cosValue = Trig.sinCos(angleRadians)
	local tangentX = Vec.unit(xAxis, Vector3.new(1, 0, 0))
	local tangentY = Vec.unit(yAxis, Vector3.new(0, 1, 0))
	return center + tangentX * (cosValue * radius) + tangentY * (sinValue * radius)
end

function Arc.Tangent3(radius: number, angleRadians: number, xAxis: Vector3, yAxis: Vector3): Vector3
	local sinValue, cosValue = Trig.sinCos(angleRadians)
	local tangentX = Vec.unit(xAxis, Vector3.new(1, 0, 0))
	local tangentY = Vec.unit(yAxis, Vector3.new(0, 1, 0))
	return (-tangentX * sinValue + tangentY * cosValue) * radius
end

function Arc.Orbit3(
	center: Vector3,
	radius: number,
	angleRadians: number,
	xAxis: Vector3,
	yAxis: Vector3,
	angularVelocity: number?
): (Vector3, Vector3)
	local velocityScale = angularVelocity or 1
	local position = Arc.Point3(center, radius, angleRadians, xAxis, yAxis)
	local velocity = Arc.Tangent3(radius, angleRadians, xAxis, yAxis) * velocityScale
	return position, velocity
end

Arc.length = Arc.Length
Arc.angleFromLength = Arc.AngleFromLength
Arc.chord = Arc.Chord
Arc.point2 = Arc.Point2
Arc.tangent2 = Arc.Tangent2
Arc.orbit2 = Arc.Orbit2
Arc.point3 = Arc.Point3
Arc.tangent3 = Arc.Tangent3
Arc.orbit3 = Arc.Orbit3

return Arc
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="1228">
                <Properties>
                  <string name="Name">Avg</string>
                  <string name="Source"><![CDATA[--!strict
-- Mean and moving-average helpers.

local Num = require(script.Parent.Num)

local Avg = {}

export type WeightedValue = {
	value: number,
	weight: number,
}

function Avg.Mean(values: { number }): number
	local count = #values
	if count == 0 then
		return 0
	end

	local total = 0
	for _, value in values do
		total = total + value
	end
	return total / count
end

function Avg.Weighted(values: { WeightedValue }): number
	local weightedTotal = 0
	local totalWeight = 0

	for _, entry in values do
		if entry.weight > 0 then
			weightedTotal = weightedTotal + entry.value * entry.weight
			totalWeight = totalWeight + entry.weight
		end
	end

	if totalWeight == 0 then
		return 0
	end
	return weightedTotal / totalWeight
end

function Avg.Moving(previousAverage: number, sample: number, alpha: number): number
	local blend = Num.saturate(alpha)
	return previousAverage + (sample - previousAverage) * blend
end

function Avg.Running(previousAverage: number, previousCount: number, sample: number): (number, number)
	local count = math.max(0, math.floor(previousCount)) + 1
	local average = previousAverage + (sample - previousAverage) / count
	return average, count
end

function Avg.Sliding(previousAverage: number, windowSize: number, outgoingSample: number, incomingSample: number): number
	local size = math.max(1, math.floor(windowSize))
	return previousAverage + (incomingSample - outgoingSample) / size
end

Avg.mean = Avg.Mean
Avg.weighted = Avg.Weighted
Avg.moving = Avg.Moving
Avg.running = Avg.Running
Avg.sliding = Avg.Sliding

return Avg
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="1229">
                <Properties>
                  <string name="Name">Basis</string>
                  <string name="Source"><![CDATA[--!strict
-- Orthonormal basis construction and local/world conversion helpers.

local Vec = require(script.Parent.Vec)

local Basis = {}

export type Basis = {
	origin: Vector3,
	xAxis: Vector3,
	yAxis: Vector3,
	zAxis: Vector3,
}

local X_AXIS = Vector3.new(1, 0, 0)
local Y_AXIS = Vector3.new(0, 1, 0)
local Z_AXIS = Vector3.new(0, 0, 1)

local function perpendicular(axis: Vector3): Vector3
	local reference = if math.abs(axis.Y) < 0.999 then Y_AXIS else X_AXIS
	return Vec.unit(reference:Cross(axis), X_AXIS)
end

local function orthonormalize(xAxis: Vector3, yAxis: Vector3, zAxis: Vector3?): (Vector3, Vector3, Vector3)
	local x = Vec.unit(xAxis, X_AXIS)

	local ySource = yAxis - x * x:Dot(yAxis)
	if Vec.isNearlyZero(ySource) then
		ySource = perpendicular(x):Cross(x)
	end
	local y = Vec.unit(ySource, Y_AXIS)

	local zSource = if zAxis ~= nil then zAxis else x:Cross(y)
	zSource = zSource - x * x:Dot(zSource) - y * y:Dot(zSource)
	if Vec.isNearlyZero(zSource) then
		zSource = x:Cross(y)
	end
	local z = Vec.unit(zSource, Z_AXIS)

	if x:Cross(y):Dot(z) < 0 then
		z = -z
	end

	y = Vec.unit(z:Cross(x), Y_AXIS)
	x = Vec.unit(y:Cross(z), X_AXIS)
	return x, y, z
end

function Basis.New(origin: Vector3, xAxis: Vector3, yAxis: Vector3, zAxis: Vector3?): Basis
	local x, y, z = orthonormalize(xAxis, yAxis, zAxis)
	return {
		origin = origin,
		xAxis = x,
		yAxis = y,
		zAxis = z,
	}
end

function Basis.FromLook(origin: Vector3, forward: Vector3, up: Vector3?): Basis
	local z = Vec.unit(forward, Z_AXIS)
	local upHint = up or Y_AXIS
	if math.abs(z:Dot(Vec.unit(upHint, Y_AXIS))) > 0.999 then
		upHint = X_AXIS
	end

	local x = Vec.unit(upHint:Cross(z), X_AXIS)
	local y = Vec.unit(z:Cross(x), Y_AXIS)
	return {
		origin = origin,
		xAxis = x,
		yAxis = y,
		zAxis = z,
	}
end

function Basis.FromCFrame(frame: CFrame): Basis
	return {
		origin = frame.Position,
		xAxis = frame.RightVector,
		yAxis = frame.UpVector,
		zAxis = frame.LookVector,
	}
end

function Basis.ToWorldVector(basis: Basis, localVector: Vector3): Vector3
	return basis.xAxis * localVector.X
		+ basis.yAxis * localVector.Y
		+ basis.zAxis * localVector.Z
end

function Basis.ToLocalVector(basis: Basis, worldVector: Vector3): Vector3
	return Vector3.new(
		worldVector:Dot(basis.xAxis),
		worldVector:Dot(basis.yAxis),
		worldVector:Dot(basis.zAxis)
	)
end

function Basis.ToWorldPoint(basis: Basis, localPoint: Vector3): Vector3
	return basis.origin + Basis.ToWorldVector(basis, localPoint)
end

function Basis.ToLocalPoint(basis: Basis, worldPoint: Vector3): Vector3
	return Basis.ToLocalVector(basis, worldPoint - basis.origin)
end

function Basis.ToCFrame(basis: Basis): CFrame
	return CFrame.fromMatrix(basis.origin, basis.xAxis, basis.yAxis, -basis.zAxis)
end

Basis.new = Basis.New
Basis.fromLook = Basis.FromLook
Basis.fromCFrame = Basis.FromCFrame
Basis.toWorldVector = Basis.ToWorldVector
Basis.toLocalVector = Basis.ToLocalVector
Basis.toWorldPoint = Basis.ToWorldPoint
Basis.toLocalPoint = Basis.ToLocalPoint
Basis.toCFrame = Basis.ToCFrame

return Basis
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="1230">
                <Properties>
                  <string name="Name">Bounds</string>
                  <string name="Source"><![CDATA[--!strict
-- Axis-aligned bounds helpers for closest points, distances, and ray hits.

local Vec = require(script.Parent.Vec)

local Bounds = {}

export type Bounds = {
	min: Vector3,
	max: Vector3,
}

export type RayIntersection = {
	tMin: number,
	tMax: number,
	point: Vector3,
}

local function resolvePadding(padding: number | Vector3): Vector3
	if typeof(padding) == "number" then
		local amount = math.abs(padding)
		return Vector3.new(amount, amount, amount)
	end
	return Vec.abs(padding)
end

local function intersectAxis(origin: number, direction: number, minValue: number, maxValue: number): (boolean, number, number)
	if direction == 0 then
		if origin < minValue or origin > maxValue then
			return false, 0, 0
		end
		return true, -math.huge, math.huge
	end

	local t0 = (minValue - origin) / direction
	local t1 = (maxValue - origin) / direction
	if t0 > t1 then
		local temporary = t0
		t0 = t1
		t1 = temporary
	end
	return true, t0, t1
end

function Bounds.New(minValue: Vector3, maxValue: Vector3): Bounds
	return {
		min = Vec.min(minValue, maxValue),
		max = Vec.max(minValue, maxValue),
	}
end

function Bounds.FromCenterSize(center: Vector3, size: Vector3): Bounds
	local halfSize = Vec.abs(size) * 0.5
	return {
		min = center - halfSize,
		max = center + halfSize,
	}
end

function Bounds.FromPoints(points: { Vector3 }): Bounds
	if #points == 0 then
		return {
			min = Vector3.zero,
			max = Vector3.zero,
		}
	end

	local minValue = points[1]
	local maxValue = points[1]
	for index = 2, #points do
		local point = points[index]
		minValue = Vec.min(minValue, point)
		maxValue = Vec.max(maxValue, point)
	end

	return {
		min = minValue,
		max = maxValue,
	}
end

function Bounds.Center(bounds: Bounds): Vector3
	return (bounds.min + bounds.max) * 0.5
end

function Bounds.Size(bounds: Bounds): Vector3
	return bounds.max - bounds.min
end

function Bounds.ContainsPoint(bounds: Bounds, point: Vector3, inclusive: boolean?): boolean
	if inclusive == false then
		return point.X > bounds.min.X
			and point.X < bounds.max.X
			and point.Y > bounds.min.Y
			and point.Y < bounds.max.Y
			and point.Z > bounds.min.Z
			and point.Z < bounds.max.Z
	end

	return point.X >= bounds.min.X
		and point.X <= bounds.max.X
		and point.Y >= bounds.min.Y
		and point.Y <= bounds.max.Y
		and point.Z >= bounds.min.Z
		and point.Z <= bounds.max.Z
end

function Bounds.ClosestPoint(bounds: Bounds, point: Vector3): Vector3
	return Vector3.new(
		math.clamp(point.X, bounds.min.X, bounds.max.X),
		math.clamp(point.Y, bounds.min.Y, bounds.max.Y),
		math.clamp(point.Z, bounds.min.Z, bounds.max.Z)
	)
end

function Bounds.DistanceSqToPoint(bounds: Bounds, point: Vector3): number
	return Vec.distanceSq(point, Bounds.ClosestPoint(bounds, point))
end

function Bounds.DistanceToPoint(bounds: Bounds, point: Vector3): number
	return math.sqrt(Bounds.DistanceSqToPoint(bounds, point))
end

function Bounds.Expand(bounds: Bounds, padding: number | Vector3): Bounds
	local resolvedPadding = resolvePadding(padding)
	return {
		min = bounds.min - resolvedPadding,
		max = bounds.max + resolvedPadding,
	}
end

function Bounds.Union(a: Bounds, b: Bounds): Bounds
	return {
		min = Vec.min(a.min, b.min),
		max = Vec.max(a.max, b.max),
	}
end

function Bounds.Intersects(a: Bounds, b: Bounds): boolean
	return a.min.X <= b.max.X
		and a.max.X >= b.min.X
		and a.min.Y <= b.max.Y
		and a.max.Y >= b.min.Y
		and a.min.Z <= b.max.Z
		and a.max.Z >= b.min.Z
end

function Bounds.IntersectRay(bounds: Bounds, origin: Vector3, direction: Vector3): RayIntersection?
	local successX, xMin, xMax = intersectAxis(origin.X, direction.X, bounds.min.X, bounds.max.X)
	if not successX then
		return nil
	end

	local successY, yMin, yMax = intersectAxis(origin.Y, direction.Y, bounds.min.Y, bounds.max.Y)
	if not successY then
		return nil
	end

	local successZ, zMin, zMax = intersectAxis(origin.Z, direction.Z, bounds.min.Z, bounds.max.Z)
	if not successZ then
		return nil
	end

	local tMin = math.max(xMin, yMin, zMin)
	local tMax = math.min(xMax, yMax, zMax)
	if tMax < math.max(tMin, 0) then
		return nil
	end

	local hitT = if tMin >= 0 then tMin else 0
	return {
		tMin = tMin,
		tMax = tMax,
		point = origin + direction * hitT,
	}
end

Bounds.new = Bounds.New
Bounds.fromCenterSize = Bounds.FromCenterSize
Bounds.fromPoints = Bounds.FromPoints
Bounds.center = Bounds.Center
Bounds.size = Bounds.Size
Bounds.containsPoint = Bounds.ContainsPoint
Bounds.closestPoint = Bounds.ClosestPoint
Bounds.distanceSqToPoint = Bounds.DistanceSqToPoint
Bounds.distanceToPoint = Bounds.DistanceToPoint
Bounds.expand = Bounds.Expand
Bounds.union = Bounds.Union
Bounds.intersects = Bounds.Intersects
Bounds.intersectRay = Bounds.IntersectRay

return Bounds
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="1231">
                <Properties>
                  <string name="Name">Curve</string>
                  <string name="Source"><![CDATA[--!strict
-- Bezier, Hermite, and Catmull-Rom curve sampling helpers.

local Curve = {}

local function add<T>(a: T, b: T): T
	return (((a :: any) + (b :: any)) :: any) :: T
end

local function mul<T>(value: T, scalar: number): T
	return (((value :: any) * scalar) :: any) :: T
end

function Curve.quadratic<T>(p0: T, p1: T, p2: T, t: number): T
	local u = 1 - t
	return add(
		add(mul(p0, u * u), mul(p1, 2 * u * t)),
		mul(p2, t * t)
	)
end

function Curve.quadraticTangent<T>(p0: T, p1: T, p2: T, t: number): T
	return add(
		mul((((p1 :: any) - (p0 :: any)) :: any) :: T, 2 * (1 - t)),
		mul((((p2 :: any) - (p1 :: any)) :: any) :: T, 2 * t)
	)
end

function Curve.cubic<T>(p0: T, p1: T, p2: T, p3: T, t: number): T
	local u = 1 - t
	local uu = u * u
	local tt = t * t
	return add(
		add(mul(p0, uu * u), mul(p1, 3 * uu * t)),
		add(mul(p2, 3 * u * tt), mul(p3, tt * t))
	)
end

function Curve.hermite<T>(p0: T, m0: T, p1: T, m1: T, t: number): T
	local tt = t * t
	local ttt = tt * t
	local h00 = 2 * ttt - 3 * tt + 1
	local h10 = ttt - 2 * tt + t
	local h01 = -2 * ttt + 3 * tt
	local h11 = ttt - tt

	return add(
		add(mul(p0, h00), mul(m0, h10)),
		add(mul(p1, h01), mul(m1, h11))
	)
end

function Curve.catmullRom<T>(p0: T, p1: T, p2: T, p3: T, t: number, tension: number?): T
	local tightness = tension or 0
	local m1 = mul((((p2 :: any) - (p0 :: any)) :: any) :: T, 0.5 * (1 - tightness))
	local m2 = mul((((p3 :: any) - (p1 :: any)) :: any) :: T, 0.5 * (1 - tightness))
	return Curve.hermite(p1, m1, p2, m2, t)
end

return Curve
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="1232">
                <Properties>
                  <string name="Name">Damp</string>
                  <string name="Source"><![CDATA[--!strict
-- Exponential damping helpers.

local Angle = require(script.Parent.Angle)

local Damp = {}

function Damp.Factor(lambda: number, dt: number): number
	local rate = math.max(lambda, 0)
	local step = math.max(dt, 0)
	if rate == 0 or step == 0 then
		return 0
	end
	return 1 - math.exp(-rate * step)
end

function Damp.HalfLifeFactor(halfLife: number, dt: number): number
	local life = math.max(halfLife, 0)
	local step = math.max(dt, 0)
	if step == 0 then
		return 0
	end
	if life == 0 then
		return 1
	end
	return 1 - 2 ^ (-step / life)
end

function Damp.value<T>(current: T, target: T, lambda: number, dt: number): T
	local blend = Damp.Factor(lambda, dt)
	return ((((current :: any) + (((target :: any) - (current :: any)) :: any) * blend) :: any) :: T)
end

function Damp.halfLifeValue<T>(current: T, target: T, halfLife: number, dt: number): T
	local blend = Damp.HalfLifeFactor(halfLife, dt)
	return ((((current :: any) + (((target :: any) - (current :: any)) :: any) * blend) :: any) :: T)
end

function Damp.AngleRadians(current: number, target: number, lambda: number, dt: number): number
	return current + Angle.deltaRadians(current, target) * Damp.Factor(lambda, dt)
end

function Damp.AngleDegrees(current: number, target: number, lambda: number, dt: number): number
	return current + Angle.deltaDegrees(current, target) * Damp.Factor(lambda, dt)
end

Damp.factor = Damp.Factor
Damp.halfLifeFactor = Damp.HalfLifeFactor
Damp.angleRadians = Damp.AngleRadians
Damp.angleDegrees = Damp.AngleDegrees

return Damp
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="1233">
                <Properties>
                  <string name="Name">Deriv</string>
                  <string name="Source"><![CDATA[--!strict
-- Lightweight numerical derivative helpers.

local Deriv = {}

export type Sample = number | Vector2 | Vector3

local function zeroLike<T>(value: T): T
	local kind = typeof(value)
	if kind == "number" then
		return (0 :: any) :: T
	end
	if kind == "Vector2" then
		return (Vector2.zero :: any) :: T
	end
	return (Vector3.zero :: any) :: T
end

local function add<T>(a: T, b: T): T
	return (((a :: any) + (b :: any)) :: any) :: T
end

local function sub<T>(a: T, b: T): T
	return (((a :: any) - (b :: any)) :: any) :: T
end

local function mul<T>(value: T, scalar: number): T
	return (((value :: any) * scalar) :: any) :: T
end

function Deriv.rate<T>(current: T, previous: T, dt: number): T
	if dt == 0 then
		return zeroLike(current)
	end
	return mul(sub(current, previous), 1 / dt)
end

function Deriv.central<T>(previous: T, nextValue: T, dt: number): T
	local span = dt * 2
	if span == 0 then
		return zeroLike(previous)
	end
	return mul(sub(nextValue, previous), 1 / span)
end

function Deriv.second<T>(previous: T, current: T, nextValue: T, dt: number): T
	if dt == 0 then
		return zeroLike(current)
	end

	local numerator = add(add(previous, nextValue), mul(current, -2))
	return mul(numerator, 1 / (dt * dt))
end

function Deriv.SampleForward(sample: (number) -> number, x: number, step: number?): number
	local h = math.max(math.abs(step or 1e-3), 1e-8)
	return (sample(x + h) - sample(x)) / h
end

function Deriv.SampleCentral(sample: (number) -> number, x: number, step: number?): number
	local h = math.max(math.abs(step or 1e-3), 1e-8)
	return (sample(x + h) - sample(x - h)) / (2 * h)
end

Deriv.sampleForward = Deriv.SampleForward
Deriv.sampleCentral = Deriv.SampleCentral

return Deriv
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="1234">
                <Properties>
                  <string name="Name">Diff</string>
                  <string name="Source"><![CDATA[--!strict
-- Finite-difference helpers for discrete samples and scalar fields.

local Diff = {}

local function sub<T>(a: T, b: T): T
	return (((a :: any) - (b :: any)) :: any) :: T
end

function Diff.delta<T>(current: T, previous: T): T
	return sub(current, previous)
end

function Diff.Forward(values: { number }, index: number, step: number?): number
	local i = math.floor(index)
	if i < 1 or i >= #values then
		return 0
	end

	local h = math.max(math.abs(step or 1), 1e-8)
	return (values[i + 1] - values[i]) / h
end

function Diff.Backward(values: { number }, index: number, step: number?): number
	local i = math.floor(index)
	if i <= 1 or i > #values then
		return 0
	end

	local h = math.max(math.abs(step or 1), 1e-8)
	return (values[i] - values[i - 1]) / h
end

function Diff.Central(values: { number }, index: number, step: number?): number
	local i = math.floor(index)
	if i <= 1 or i >= #values then
		return 0
	end

	local h = math.max(math.abs(step or 1), 1e-8)
	return (values[i + 1] - values[i - 1]) / (2 * h)
end

function Diff.Gradient2(sample: (number, number) -> number, x: number, y: number, step: number?): Vector2
	local h = math.max(math.abs(step or 1e-3), 1e-8)
	local dx = (sample(x + h, y) - sample(x - h, y)) / (2 * h)
	local dy = (sample(x, y + h) - sample(x, y - h)) / (2 * h)
	return Vector2.new(dx, dy)
end

function Diff.Gradient3(sample: (number, number, number) -> number, x: number, y: number, z: number, step: number?): Vector3
	local h = math.max(math.abs(step or 1e-3), 1e-8)
	local dx = (sample(x + h, y, z) - sample(x - h, y, z)) / (2 * h)
	local dy = (sample(x, y + h, z) - sample(x, y - h, z)) / (2 * h)
	local dz = (sample(x, y, z + h) - sample(x, y, z - h)) / (2 * h)
	return Vector3.new(dx, dy, dz)
end

Diff.forward = Diff.Forward
Diff.backward = Diff.Backward
Diff.central = Diff.Central
Diff.gradient2 = Diff.Gradient2
Diff.gradient3 = Diff.Gradient3

return Diff
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="1235">
                <Properties>
                  <string name="Name">DropChance</string>
                  <string name="Source"><![CDATA[--!strict

local Rand = require(script.Parent.Rand)

local DropChance = {}

export type DropEntry<T> = {
	value: T,
	weight: number?,
	chance: number?,
}

local function sanitizeChance(valueRaw: any, fallback: number): number
	if typeof(valueRaw) ~= "number" or valueRaw ~= valueRaw then
		return math.clamp(fallback, 0, 1)
	end
	return math.clamp(valueRaw, 0, 1)
end

local function sanitizeWeight(valueRaw: any): number
	if typeof(valueRaw) ~= "number" or valueRaw ~= valueRaw then
		return 0
	end
	return math.max(0, valueRaw)
end

function DropChance.Roll(chanceRaw: any, randomOrSeedRaw: any?): (boolean, number, number?)
	local chance = sanitizeChance(chanceRaw, 0)
	if typeof(randomOrSeedRaw) == "number" then
		local nextSeed, roll = Rand.number(randomOrSeedRaw)
		return roll <= chance, roll, nextSeed
	end

	local randomObject = if typeof(randomOrSeedRaw) == "Random" then randomOrSeedRaw :: Random else Random.new()
	local roll = randomObject:NextNumber()
	return roll <= chance, roll, nil
end

function DropChance.PickWeighted<T>(entries: { DropEntry<T> }, randomOrSeedRaw: any?): (T?, number?)
	if #entries == 0 then
		return nil, if typeof(randomOrSeedRaw) == "number" then randomOrSeedRaw else nil
	end

	local weightedEntries = {}
	for _, entry in entries do
		local weight = sanitizeWeight(entry.weight or entry.chance)
		if weight > 0 then
			weightedEntries[#weightedEntries + 1] = {
				value = entry.value,
				weight = weight,
			}
		end
	end

	if #weightedEntries == 0 then
		return entries[1].value, if typeof(randomOrSeedRaw) == "number" then randomOrSeedRaw else nil
	end

	if typeof(randomOrSeedRaw) == "number" then
		local nextSeed, value = Rand.weighted(randomOrSeedRaw, weightedEntries)
		return value, nextSeed
	end

	local randomObject = if typeof(randomOrSeedRaw) == "Random" then randomOrSeedRaw :: Random else Random.new()
	local totalWeight = 0
	for _, entry in weightedEntries do
		totalWeight += entry.weight
	end

	local roll = randomObject:NextNumber(0, totalWeight)
	local running = 0
	for _, entry in weightedEntries do
		running += entry.weight
		if roll <= running then
			return entry.value, nil
		end
	end

	return weightedEntries[#weightedEntries].value, nil
end

DropChance.roll = DropChance.Roll
DropChance.pickWeighted = DropChance.PickWeighted

return DropChance
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="1236">
                <Properties>
                  <string name="Name">Ease</string>
                  <string name="Source"><![CDATA[--!strict
-- Common easing curves for interpolation timing.

local Num = require(script.Parent.Num)

local Ease = {}

local HALF_PI = math.pi * 0.5

local function resolveAlpha(alpha: number): number
	return Num.saturate(alpha)
end

function Ease.Linear(alpha: number): number
	return resolveAlpha(alpha)
end

function Ease.InSine(alpha: number): number
	local x = resolveAlpha(alpha)
	return 1 - math.cos(x * HALF_PI)
end

function Ease.OutSine(alpha: number): number
	local x = resolveAlpha(alpha)
	return math.sin(x * HALF_PI)
end

function Ease.InOutSine(alpha: number): number
	local x = resolveAlpha(alpha)
	return -(math.cos(math.pi * x) - 1) * 0.5
end

function Ease.InQuad(alpha: number): number
	local x = resolveAlpha(alpha)
	return x * x
end

function Ease.OutQuad(alpha: number): number
	local x = resolveAlpha(alpha)
	return 1 - (1 - x) * (1 - x)
end

function Ease.InOutQuad(alpha: number): number
	local x = resolveAlpha(alpha)
	if x < 0.5 then
		return 2 * x * x
	end
	return 1 - ((-2 * x + 2) ^ 2) * 0.5
end

function Ease.InCubic(alpha: number): number
	local x = resolveAlpha(alpha)
	return x * x * x
end

function Ease.OutCubic(alpha: number): number
	local x = resolveAlpha(alpha)
	return 1 - (1 - x) ^ 3
end

function Ease.InOutCubic(alpha: number): number
	local x = resolveAlpha(alpha)
	if x < 0.5 then
		return 4 * x * x * x
	end
	return 1 - ((-2 * x + 2) ^ 3) * 0.5
end

function Ease.InQuart(alpha: number): number
	local x = resolveAlpha(alpha)
	return x ^ 4
end

function Ease.OutQuart(alpha: number): number
	local x = resolveAlpha(alpha)
	return 1 - (1 - x) ^ 4
end

function Ease.InOutQuart(alpha: number): number
	local x = resolveAlpha(alpha)
	if x < 0.5 then
		return 8 * x ^ 4
	end
	return 1 - ((-2 * x + 2) ^ 4) * 0.5
end

function Ease.InQuint(alpha: number): number
	local x = resolveAlpha(alpha)
	return x ^ 5
end

function Ease.OutQuint(alpha: number): number
	local x = resolveAlpha(alpha)
	return 1 - (1 - x) ^ 5
end

function Ease.InOutQuint(alpha: number): number
	local x = resolveAlpha(alpha)
	if x < 0.5 then
		return 16 * x ^ 5
	end
	return 1 - ((-2 * x + 2) ^ 5) * 0.5
end

function Ease.InExpo(alpha: number): number
	local x = resolveAlpha(alpha)
	if x == 0 then
		return 0
	end
	return 2 ^ (10 * x - 10)
end

function Ease.OutExpo(alpha: number): number
	local x = resolveAlpha(alpha)
	if x == 1 then
		return 1
	end
	return 1 - 2 ^ (-10 * x)
end

function Ease.InOutExpo(alpha: number): number
	local x = resolveAlpha(alpha)
	if x == 0 or x == 1 then
		return x
	end
	if x < 0.5 then
		return 2 ^ (20 * x - 10) * 0.5
	end
	return (2 - 2 ^ (-20 * x + 10)) * 0.5
end

function Ease.InCirc(alpha: number): number
	local x = resolveAlpha(alpha)
	return 1 - math.sqrt(1 - x * x)
end

function Ease.OutCirc(alpha: number): number
	local x = resolveAlpha(alpha)
	return math.sqrt(1 - (x - 1) * (x - 1))
end

function Ease.InOutCirc(alpha: number): number
	local x = resolveAlpha(alpha)
	if x < 0.5 then
		return (1 - math.sqrt(1 - (2 * x) ^ 2)) * 0.5
	end
	return (math.sqrt(1 - (-2 * x + 2) ^ 2) + 1) * 0.5
end

function Ease.InBack(alpha: number, overshoot: number?): number
	local x = resolveAlpha(alpha)
	local s = overshoot or 1.70158
	local c = s + 1
	return c * x * x * x - s * x * x
end

function Ease.OutBack(alpha: number, overshoot: number?): number
	local x = resolveAlpha(alpha)
	local s = overshoot or 1.70158
	local c = s + 1
	local y = x - 1
	return 1 + c * y * y * y + s * y * y
end

function Ease.InOutBack(alpha: number, overshoot: number?): number
	local x = resolveAlpha(alpha)
	local s = (overshoot or 1.70158) * 1.525
	if x < 0.5 then
		local y = 2 * x
		return (y * y * ((s + 1) * y - s)) * 0.5
	end
	local y = 2 * x - 2
	return (y * y * ((s + 1) * y + s) + 2) * 0.5
end

Ease.linear = Ease.Linear
Ease.inSine = Ease.InSine
Ease.outSine = Ease.OutSine
Ease.inOutSine = Ease.InOutSine
Ease.inQuad = Ease.InQuad
Ease.outQuad = Ease.OutQuad
Ease.inOutQuad = Ease.InOutQuad
Ease.inCubic = Ease.InCubic
Ease.outCubic = Ease.OutCubic
Ease.inOutCubic = Ease.InOutCubic
Ease.inQuart = Ease.InQuart
Ease.outQuart = Ease.OutQuart
Ease.inOutQuart = Ease.InOutQuart
Ease.inQuint = Ease.InQuint
Ease.outQuint = Ease.OutQuint
Ease.inOutQuint = Ease.InOutQuint
Ease.inExpo = Ease.InExpo
Ease.outExpo = Ease.OutExpo
Ease.inOutExpo = Ease.InOutExpo
Ease.inCirc = Ease.InCirc
Ease.outCirc = Ease.OutCirc
Ease.inOutCirc = Ease.InOutCirc
Ease.inBack = Ease.InBack
Ease.outBack = Ease.OutBack
Ease.inOutBack = Ease.InOutBack

return Ease
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="1237">
                <Properties>
                  <string name="Name">HopMotion</string>
                  <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Ripple = require(ReplicatedStorage.Packages.Ripple)

type NumberMotion = Ripple.Motion<number>
type SpringOptions = Ripple.SpringOptions

local HopMotion = {}
HopMotion.__index = HopMotion

export type HopConfig = {
	duration: number?,
	arcHeight: number?,
	minArcHeight: number?,
	maxArcHeight: number?,
	spring: SpringOptions?,
}

export type HopStep = {
	position: Vector3,
	velocity: Vector3,
	alpha: number,
	completed: boolean,
}

export type HopMotion = typeof(setmetatable(
	{} :: {
		duration: number,
		arcHeight: number,
		minArcHeight: number,
		maxArcHeight: number,
		spring: SpringOptions,
		progressMotion: NumberMotion,
		origin: Vector3,
		destination: Vector3,
		elapsed: number,
		lastAlpha: number,
		lastPosition: Vector3,
		active: boolean,
		completed: boolean,
	},
	HopMotion
))

local DEFAULT_DURATION = 0.45
local DEFAULT_MIN_ARC_HEIGHT = 0.9
local DEFAULT_MAX_ARC_HEIGHT = 8
local DEFAULT_ARC_DISTANCE_MULTIPLIER = 0.3

local DEFAULT_SPRING: SpringOptions = {
	frequency = 9,
	damping = 1,
}

local function sanitizeNumber(valueRaw: any, fallback: number, minimum: number?, maximum: number?): number
	local value = fallback
	if typeof(valueRaw) == "number" and valueRaw == valueRaw then
		value = valueRaw
	end

	if minimum ~= nil and value < minimum then
		value = minimum
	end
	if maximum ~= nil and value > maximum then
		value = maximum
	end

	return value
end

local function cloneSpringOptions(source: SpringOptions?): SpringOptions
	local spring: SpringOptions = {
		frequency = DEFAULT_SPRING.frequency,
		damping = DEFAULT_SPRING.damping,
	}

	if source == nil then
		return spring
	end

	for key, value in source do
		spring[key] = value
	end

	if source.frequency ~= nil then
		spring.frequency = sanitizeNumber(source.frequency, spring.frequency or 9, 0.01, 120)
	end
	if source.damping ~= nil then
		spring.damping = sanitizeNumber(source.damping, spring.damping or 1, 0, 20)
	end

	return spring
end

function HopMotion.ComputeArcHeight(horizontalDistanceRaw: any, minArcHeightRaw: any, maxArcHeightRaw: any): number
	local horizontalDistance = sanitizeNumber(horizontalDistanceRaw, 0, 0, nil)
	local minArcHeight = sanitizeNumber(minArcHeightRaw, DEFAULT_MIN_ARC_HEIGHT, 0, nil)
	local maxArcHeight = sanitizeNumber(maxArcHeightRaw, DEFAULT_MAX_ARC_HEIGHT, minArcHeight, nil)

	local scaledHeight = horizontalDistance * DEFAULT_ARC_DISTANCE_MULTIPLIER
	return math.clamp(scaledHeight, minArcHeight, maxArcHeight)
end

function HopMotion.New(configRaw: HopConfig?): HopMotion
	local config = if typeof(configRaw) == "table" then configRaw else {}
	local minArcHeight = sanitizeNumber(config.minArcHeight, DEFAULT_MIN_ARC_HEIGHT, 0, nil)
	local maxArcHeight = sanitizeNumber(config.maxArcHeight, DEFAULT_MAX_ARC_HEIGHT, minArcHeight, nil)
	local duration = sanitizeNumber(config.duration, DEFAULT_DURATION, 0.03, 8)
	local arcHeight = if config.arcHeight ~= nil
		then sanitizeNumber(config.arcHeight, minArcHeight, 0, nil)
		else minArcHeight

	local origin = Vector3.zero
	local progressMotion = Ripple.createMotion(0)

	local self = setmetatable({
		duration = duration,
		arcHeight = arcHeight,
		minArcHeight = minArcHeight,
		maxArcHeight = maxArcHeight,
		spring = cloneSpringOptions(config.spring),
		progressMotion = progressMotion,
		origin = origin,
		destination = origin,
		elapsed = 0,
		lastAlpha = 0,
		lastPosition = origin,
		active = false,
		completed = true,
	}, HopMotion)

	return self
end

function HopMotion.Sample(self: HopMotion, alphaRaw: any): Vector3
	local alpha = sanitizeNumber(alphaRaw, 0, 0, 1)
	local linearPosition = self.origin:Lerp(self.destination, alpha)
	local arcOffsetY = 4 * self.arcHeight * alpha * (1 - alpha)
	return linearPosition + Vector3.new(0, arcOffsetY, 0)
end

function HopMotion.Start(
	self: HopMotion,
	originRaw: any,
	destinationRaw: any,
	durationRaw: any,
	arcHeightRaw: any
)
	if typeof(originRaw) ~= "Vector3" or typeof(destinationRaw) ~= "Vector3" then
		return
	end

	self.origin = originRaw
	self.destination = destinationRaw
	self.duration = sanitizeNumber(durationRaw, self.duration, 0.03, 8)

	local horizontalDelta = Vector3.new(destinationRaw.X - originRaw.X, 0, destinationRaw.Z - originRaw.Z)
	local computedArcHeight = HopMotion.ComputeArcHeight(horizontalDelta.Magnitude, self.minArcHeight, self.maxArcHeight)
	self.arcHeight = if arcHeightRaw ~= nil
		then sanitizeNumber(arcHeightRaw, computedArcHeight, 0, nil)
		else computedArcHeight

	self.elapsed = 0
	self.lastAlpha = 0
	self.lastPosition = originRaw
	self.active = true
	self.completed = false
	self.progressMotion:immediate(0)
end

function HopMotion.Stop(self: HopMotion, snapToDestinationRaw: any)
	if not self.active and self.completed then
		return
	end

	local snapToDestination = snapToDestinationRaw == true
	self.active = false
	self.completed = true
	if snapToDestination then
		self.lastAlpha = 1
		self.lastPosition = self.destination
		self.progressMotion:immediate(1)
	else
		self.progressMotion:immediate(self.lastAlpha)
	end
end

function HopMotion.IsActive(self: HopMotion): boolean
	return self.active
end

function HopMotion.Step(self: HopMotion, dtRaw: any): HopStep
	local dt = sanitizeNumber(dtRaw, 0, 0, 1)
	if not self.active then
		return {
			position = self.lastPosition,
			velocity = Vector3.zero,
			alpha = self.lastAlpha,
			completed = self.completed,
		}
	end

	self.elapsed = math.min(self.duration, self.elapsed + dt)
	local rawAlpha = if self.duration > 0 then self.elapsed / self.duration else 1

	self.progressMotion:spring(rawAlpha, self.spring)
	local springAlpha = self.progressMotion:step(dt)
	local smoothedAlpha = rawAlpha + (springAlpha - rawAlpha) * 0.2
	smoothedAlpha = math.clamp(smoothedAlpha, self.lastAlpha, 1)

	local sampledPosition = self:sample(smoothedAlpha)
	local velocity = Vector3.zero
	if dt > 0 then
		velocity = (sampledPosition - self.lastPosition) / dt
	end

	self.lastAlpha = smoothedAlpha
	self.lastPosition = sampledPosition

	local completed = rawAlpha >= 1
	if completed then
		self.lastAlpha = 1
		self.lastPosition = self.destination
		self.active = false
		self.completed = true
		self.progressMotion:immediate(1)
		return {
			position = self.destination,
			velocity = velocity,
			alpha = 1,
			completed = true,
		}
	end

	return {
		position = sampledPosition,
		velocity = velocity,
		alpha = smoothedAlpha,
		completed = false,
	}
end

function HopMotion.Destroy(self: HopMotion)
	self.progressMotion:destroy()
	self.active = false
	self.completed = true
end

HopMotion.computeArcHeight = HopMotion.ComputeArcHeight
HopMotion.new = HopMotion.New
HopMotion.sample = HopMotion.Sample
HopMotion.start = HopMotion.Start
HopMotion.stop = HopMotion.Stop
HopMotion.isActive = HopMotion.IsActive
HopMotion.step = HopMotion.Step
HopMotion.destroy = HopMotion.Destroy

return HopMotion
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="1238">
                <Properties>
                  <string name="Name">Integ</string>
                  <string name="Source"><![CDATA[--!strict
-- Lightweight numerical integration and prediction helpers.

local Integ = {}

local function add<T>(a: T, b: T): T
	return (((a :: any) + (b :: any)) :: any) :: T
end

local function mul<T>(value: T, scalar: number): T
	return (((value :: any) * scalar) :: any) :: T
end

function Integ.euler<T>(value: T, rate: T, dt: number): T
	return add(value, mul(rate, dt))
end

function Integ.trapezoidStep<T>(value: T, previousRate: T, currentRate: T, dt: number): T
	return add(value, mul(add(previousRate, currentRate), 0.5 * dt))
end

function Integ.predict<T>(value: T, velocity: T, acceleration: T?, dt: number): T
	local predicted = add(value, mul(velocity, dt))
	if acceleration == nil then
		return predicted
	end
	return add(predicted, mul(acceleration, 0.5 * dt * dt))
end

function Integ.Trapezoid(sample: (number) -> number, a: number, b: number, segments: number?): number
	local count = math.max(1, math.floor(segments or 16))
	local width = (b - a) / count
	local total = 0.5 * (sample(a) + sample(b))

	for index = 1, count - 1 do
		total = total + sample(a + width * index)
	end

	return total * width
end

function Integ.Simpson(sample: (number) -> number, a: number, b: number, segments: number?): number
	local count = math.max(2, math.floor(segments or 32))
	if count % 2 ~= 0 then
		count = count + 1
	end

	local width = (b - a) / count
	local total = sample(a) + sample(b)

	for index = 1, count - 1 do
		local weight = if index % 2 == 0 then 2 else 4
		total = total + sample(a + width * index) * weight
	end

	return total * width / 3
end

Integ.trapezoid = Integ.Trapezoid
Integ.simpson = Integ.Simpson

return Integ
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="1239">
                <Properties>
                  <string name="Name">Lerp</string>
                  <string name="Source"><![CDATA[--!strict
-- Linear interpolation helpers.

local Angle = require(script.Parent.Angle)
local Num = require(script.Parent.Num)

local Lerp = {}

function Lerp.value<T>(a: T, b: T, alpha: number): T
	return ((((a :: any) + (((b :: any) - (a :: any)) :: any) * alpha) :: any) :: T)
end

function Lerp.clamped<T>(a: T, b: T, alpha: number): T
	return Lerp.value(a, b, Num.saturate(alpha))
end

function Lerp.AngleRadians(a: number, b: number, alpha: number): number
	return a + Angle.deltaRadians(a, b) * alpha
end

function Lerp.AngleDegrees(a: number, b: number, alpha: number): number
	return a + Angle.deltaDegrees(a, b) * alpha
end

function Lerp.Color3(a: Color3, b: Color3, alpha: number): Color3
	return Color3.new(
		a.R + (b.R - a.R) * alpha,
		a.G + (b.G - a.G) * alpha,
		a.B + (b.B - a.B) * alpha
	)
end

function Lerp.bilinear<T>(c00: T, c10: T, c01: T, c11: T, tx: number, ty: number): T
	local top = Lerp.value(c00, c10, tx)
	local bottom = Lerp.value(c01, c11, tx)
	return Lerp.value(top, bottom, ty)
end

function Lerp.trilinear<T>(
	c000: T,
	c100: T,
	c010: T,
	c110: T,
	c001: T,
	c101: T,
	c011: T,
	c111: T,
	tx: number,
	ty: number,
	tz: number
): T
	local front = Lerp.bilinear(c000, c100, c010, c110, tx, ty)
	local back = Lerp.bilinear(c001, c101, c011, c111, tx, ty)
	return Lerp.value(front, back, tz)
end

Lerp.angleRadians = Lerp.AngleRadians
Lerp.angleDegrees = Lerp.AngleDegrees
Lerp.color3 = Lerp.Color3

return Lerp
]]></string>
                </Properties>
