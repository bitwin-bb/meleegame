          <Item class="Folder" referent="732">
            <Properties>
              <string name="Name">Services</string>
            </Properties>
            <Item class="ModuleScript" referent="733">
              <Properties>
                <string name="Name">AnimationServiceClient</string>
                <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local AnimationServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.AnimationServiceUtils)
local AudioServiceClient = require(script:FindFirstAncestor("game").Client.Services.AudioServiceClient)
local Janitor = require(ReplicatedStorage.Packages.Janitor)
local Networker = require(script:FindFirstAncestor("game").Shared.Modules.Networking.Networker)
local PlayerServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.PlayerServiceUtils)

type AnimationClipConfig = AnimationServiceUtils.AnimationClipConfig
type AnimationProfile = AnimationServiceUtils.AnimationProfile
type AnimationServiceState = AnimationServiceUtils.AnimationServiceState
type CharacterRig = AnimationServiceUtils.CharacterRig

type JanitorClass = {
	GiveChore: (self: JanitorClass, chore: any, ...any) -> (),
	Clean: (self: JanitorClass) -> (),
	Destroy: (self: JanitorClass) -> (),
}

type CharacterRuntime = {
	rig: CharacterRig,
	profile: AnimationProfile,
	tracks: { [string]: AnimationTrack? },
	activeClipName: string?,
	lastFootstepAt: number,
	lastFootstepEventAt: number,
	lastJumpAt: number,
	lastJumpEventAt: number,
	footstepKeyframeSet: { [string]: boolean },
	jumpKeyframeSet: { [string]: boolean },
	movementSpeed: number,
	humanoidState: Enum.HumanoidStateType,
}

local AnimationServiceClient = {}
local FOOTSTEP_MOVE_DEADZONE = 0.05
local FOOTSTEP_EVENT_DEDUPE_WINDOW = 0.06
local JUMP_EVENT_DEDUPE_WINDOW = 0.09
local WALK_ANIMATION_SPEED_MIN_SCALE = 0.25
local WALK_ANIMATION_SPEED_MAX_SCALE = 2.5
local DEFAULT_TRANSITION_FADE_TIME = 0.14

local JUMP_STATES: { [Enum.HumanoidStateType]: boolean } = {
	[Enum.HumanoidStateType.Jumping] = true,
}

local FALL_STATES: { [Enum.HumanoidStateType]: boolean } = {
	[Enum.HumanoidStateType.Freefall] = true,
	[Enum.HumanoidStateType.FallingDown] = true,
}

local function getClipConfig(runtime: CharacterRuntime, clipName: string): AnimationClipConfig?
	return runtime.profile.animations[clipName]
end

local function isJumpState(state: Enum.HumanoidStateType): boolean
	return JUMP_STATES[state] == true
end

local function isFallState(state: Enum.HumanoidStateType): boolean
	return FALL_STATES[state] == true
end

local function resolveClipPlaybackSpeed(runtime: CharacterRuntime, clipName: string): number
	local clipConfig = getClipConfig(runtime, clipName)
	if not clipConfig then
		return 1
	end

	if clipName ~= "Walk" then
		return clipConfig.speed
	end

	local walkSpeed = runtime.rig.humanoid.WalkSpeed
	if walkSpeed <= 0 then
		return clipConfig.speed
	end

	local speedScale =
		math.clamp(runtime.movementSpeed / walkSpeed, WALK_ANIMATION_SPEED_MIN_SCALE, WALK_ANIMATION_SPEED_MAX_SCALE)
	return clipConfig.speed * speedScale
end

local function resolveTransitionFadeTime(runtime: CharacterRuntime, fromClipName: string?, toClipName: string?): number
	local fadeTime = DEFAULT_TRANSITION_FADE_TIME

	if fromClipName ~= nil then
		local fromClip = getClipConfig(runtime, fromClipName)
		if fromClip then
			fadeTime = math.max(fadeTime, fromClip.fadeTime)
		end
	end

	if toClipName ~= nil then
		local toClip = getClipConfig(runtime, toClipName)
		if toClip then
			fadeTime = math.max(fadeTime, toClip.fadeTime)
		end
	end

	return fadeTime
end

local function bindTrackAnimationEvents(
	janitor: JanitorClass,
	track: AnimationTrack?,
	markers: { string },
	keyframeSet: { [string]: boolean },
	onEvent: () -> ()
)
	if not track then
		return
	end

	for _, markerName in markers do
		janitor:GiveChore(track:GetMarkerReachedSignal(markerName):Connect(onEvent))
	end

	janitor:GiveChore(track.KeyframeReached:Connect(function(keyframeName: string)
		if keyframeSet[keyframeName] then
			onEvent()
		end
	end))
end

function AnimationServiceClient.Init(self: AnimationServiceClient)
	self.localPlayer = Players.LocalPlayer
	self.networker = Networker.client.new("AnimationService", self)
	self.janitor = Janitor.new()
	self.characterJanitor = Janitor.new()
	self.runtimeJanitor = Janitor.new()
	self.character = nil
	self.runtime = nil
	self.profileRegistry = AnimationServiceUtils.createDefaultProfileRegistry()
	self.state = AnimationServiceUtils.createDefaultState()
	self.movementLocked = false

	self.janitor:GiveChore(self.characterJanitor)
	self.characterJanitor:GiveChore(self.runtimeJanitor)
	self.janitor:GiveChore(function()
		self.networker:destroy()
	end)

	self.janitor:GiveChore(self.localPlayer.CharacterAdded:Connect(function(character: Model)
		self:onCharacterAdded(character)
	end))
	self.janitor:GiveChore(
		self.localPlayer
			:GetAttributeChangedSignal(PlayerServiceUtils.DEFAULT_MOVEMENT_LOCK_ATTRIBUTE)
			:Connect(function()
				local movementLockAttribute =
					self.localPlayer:GetAttribute(PlayerServiceUtils.DEFAULT_MOVEMENT_LOCK_ATTRIBUTE)
				self.movementLocked = movementLockAttribute == true
				self:refreshAnimation()
			end)
	)

	local movementLockAttribute = self.localPlayer:GetAttribute(PlayerServiceUtils.DEFAULT_MOVEMENT_LOCK_ATTRIBUTE)
	self.movementLocked = movementLockAttribute == true

	if self.localPlayer.Character then
		self:onCharacterAdded(self.localPlayer.Character)
	end

	self.networker:fire("requestSync")
end

function AnimationServiceClient.OnCharacterAdded(self: AnimationServiceClient, character: Model)
	self.character = character
	self.characterJanitor:Clean()

	self.runtimeJanitor = Janitor.new()
	self.characterJanitor:GiveChore(self.runtimeJanitor)

	self.characterJanitor:GiveChore(character.ChildAdded:Connect(function()
		if self.runtime == nil then
			self:rebuildRuntime()
		end
	end))

	self:rebuildRuntime()
end

function AnimationServiceClient.RebuildRuntime(self: AnimationServiceClient)
	self.runtimeJanitor:Clean()
	self.runtime = nil

	local character = self.character
	if not character then
		return
	end

	local rig = AnimationServiceUtils.resolveCharacterRig(character)
	if not rig then
		return
	end

	local profileName = AnimationServiceUtils.normalizeProfileName(
		self.state.profileName,
		self.profileRegistry,
		AnimationServiceUtils.DEFAULT_PROFILE_NAME
	)
	local profile = AnimationServiceUtils.getProfile(profileName, self.profileRegistry)
	if not profile then
		return
	end

	AnimationServiceUtils.disableDefaultAnimateScript(character)
	local animator = AnimationServiceUtils.resolveAnimator(rig.humanoid)
	local runtime: CharacterRuntime = {
		rig = rig,
		profile = profile,
		tracks = {},
		activeClipName = nil,
		lastFootstepAt = 0,
		lastFootstepEventAt = 0,
		lastJumpAt = 0,
		lastJumpEventAt = 0,
		footstepKeyframeSet = AnimationServiceUtils.arrayToSet(profile.footstepKeyframes),
		jumpKeyframeSet = AnimationServiceUtils.arrayToSet(profile.jumpKeyframes),
		movementSpeed = 0,
		humanoidState = rig.humanoid:GetState(),
	}

	for clipName, clipConfig in profile.animations do
		local track = AnimationServiceUtils.createAnimationTrack(animator, clipConfig)
		if track then
			runtime.tracks[clipName] = track
			self.runtimeJanitor:GiveChore(function()
				if track.IsPlaying then
					track:Stop(0.1)
				end
			end)
		end
	end

	bindTrackAnimationEvents(
		self.runtimeJanitor,
		runtime.tracks.Walk,
		profile.footstepMarkers,
		runtime.footstepKeyframeSet,
		function()
			self:onFootstepEvent()
		end
	)

	bindTrackAnimationEvents(
		self.runtimeJanitor,
		runtime.tracks.Jump,
		profile.jumpMarkers,
		runtime.jumpKeyframeSet,
		function()
			self:onJumpEvent()
		end
	)

	self.runtimeJanitor:GiveChore(rig.humanoid.Running:Connect(function(speed: number)
		self:updateMovementAnimation(speed)
	end))

	self.runtimeJanitor:GiveChore(rig.humanoid.StateChanged:Connect(function(_, newState: Enum.HumanoidStateType)
		self:updateHumanoidState(newState)
	end))

	self.runtimeJanitor:GiveChore(rig.humanoid:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
		self:refreshAnimation()
	end))

	self.runtimeJanitor:GiveChore(rig.humanoid.Died:Connect(function()
		self:switchToClip(nil)
	end))

	self.runtime = runtime
	runtime.movementSpeed = rig.humanoid.MoveDirection.Magnitude * rig.humanoid.WalkSpeed
	runtime.humanoidState = rig.humanoid:GetState()
	self:refreshAnimation()
end

function AnimationServiceClient.SwitchToClip(self: AnimationServiceClient, clipName: string?)
	local runtime = self.runtime
	if not runtime then
		return
	end
	local transitionFadeTime = resolveTransitionFadeTime(runtime, runtime.activeClipName, clipName)

	if clipName == nil then
		for _, track in runtime.tracks do
			if track and track.IsPlaying then
				track:Stop(transitionFadeTime)
			end
		end
		runtime.activeClipName = nil
		return
	end

	local requestedTrack = runtime.tracks[clipName]
	if requestedTrack == nil then
		if clipName ~= "Idle" and runtime.tracks.Idle then
			self:switchToClip("Idle")
		end
		return
	end

	if runtime.activeClipName == clipName then
		local activeTrack = runtime.tracks[clipName]
		local activeClipConfig = getClipConfig(runtime, clipName)
		local playbackSpeed = resolveClipPlaybackSpeed(runtime, clipName)
		if activeTrack and activeClipConfig then
			if activeTrack.IsPlaying then
				activeTrack:AdjustWeight(activeClipConfig.weight, transitionFadeTime)
				activeTrack:AdjustSpeed(playbackSpeed)
			else
				activeTrack:Play(transitionFadeTime, activeClipConfig.weight, playbackSpeed)
			end
		end
		return
	end

	local targetTrack = requestedTrack
	local targetClipConfig = getClipConfig(runtime, clipName)
	if targetTrack and targetClipConfig then
		local playbackSpeed = resolveClipPlaybackSpeed(runtime, clipName)
		if targetTrack.IsPlaying then
			targetTrack:AdjustWeight(targetClipConfig.weight, transitionFadeTime)
			targetTrack:AdjustSpeed(playbackSpeed)
		else
			targetTrack:Play(transitionFadeTime, targetClipConfig.weight, playbackSpeed)
		end
	end

	for candidateName, track in runtime.tracks do
		if candidateName ~= clipName and track and track.IsPlaying then
			track:Stop(transitionFadeTime)
		end
	end

	runtime.activeClipName = clipName
end

function AnimationServiceClient.UpdateMovementAnimation(self: AnimationServiceClient, speed: number)
	local runtime = self.runtime
	if not runtime then
		return
	end

	runtime.movementSpeed = math.max(speed, 0)
	self:refreshAnimation()
end

function AnimationServiceClient.UpdateHumanoidState(self: AnimationServiceClient, humanoidState: Enum.HumanoidStateType)
	local runtime = self.runtime
	if not runtime then
		return
	end

	runtime.humanoidState = humanoidState
	self:refreshAnimation()
end

function AnimationServiceClient.RefreshAnimation(self: AnimationServiceClient)
	local runtime = self.runtime
	if not runtime then
		return
	end

	if self.movementLocked then
		if runtime.tracks.Fall then
			self:switchToClip("Fall")
		elseif runtime.tracks.Jump then
			self:switchToClip("Jump")
		elseif runtime.tracks.Idle then
			self:switchToClip("Idle")
		else
			self:switchToClip(nil)
		end
		return
	end

	if isFallState(runtime.humanoidState) then
		if runtime.tracks.Fall then
			self:switchToClip("Fall")
			return
		end
		if runtime.tracks.Jump then
			self:switchToClip("Jump")
			return
		end
	end

	if runtime.tracks.Jump and isJumpState(runtime.humanoidState) then
		self:switchToClip("Jump")
		return
	end

	if runtime.movementSpeed > runtime.profile.walkSpeedThreshold and runtime.tracks.Walk then
		self:switchToClip("Walk")
		return
	end

	if runtime.tracks.Idle then
		self:switchToClip("Idle")
		return
	end

	self:switchToClip(nil)
end

function AnimationServiceClient.OnFootstepEvent(self: AnimationServiceClient)
	local runtime = self.runtime
	if not runtime then
		return
	end

	local now = os.clock()
	if now - runtime.lastFootstepEventAt < FOOTSTEP_EVENT_DEDUPE_WINDOW then
		return
	end
	runtime.lastFootstepEventAt = now
	self:playFootstep(runtime, now)
end

function AnimationServiceClient.CanPlayFootstep(self: AnimationServiceClient, runtime: CharacterRuntime): boolean
	if runtime.activeClipName ~= "Walk" then
		return false
	end
	if not self.state.footstepsEnabled then
		return false
	end

	local humanoid = runtime.rig.humanoid
	if humanoid.FloorMaterial == Enum.Material.Air then
		return false
	end
	if runtime.movementSpeed <= FOOTSTEP_MOVE_DEADZONE then
		return false
	end

	return true
end

function AnimationServiceClient.OnJumpEvent(self: AnimationServiceClient)
	local runtime = self.runtime
	if not runtime then
		return
	end

	local now = os.clock()
	if now - runtime.lastJumpEventAt < JUMP_EVENT_DEDUPE_WINDOW then
		return
	end
	runtime.lastJumpEventAt = now
	self:playJump(runtime, now)
end

function AnimationServiceClient.CanPlayJump(self: AnimationServiceClient, runtime: CharacterRuntime): boolean
	if runtime.activeClipName ~= "Jump" then
		return false
	end
	if not isJumpState(runtime.humanoidState) and not isFallState(runtime.humanoidState) then
		return false
	end
	return true
end

function AnimationServiceClient.PlayFootstep(
	self: AnimationServiceClient,
	runtime: CharacterRuntime,
	now: number
): boolean
	if not self:canPlayFootstep(runtime) then
		return false
	end
	if now - runtime.lastFootstepAt < runtime.profile.footstepCooldown then
		return false
	end
	if AudioServiceClient.categoryGroups == nil then
		return false
	end

	local humanoid = runtime.rig.humanoid
	local soundAssetId, soundOptions = AnimationServiceUtils.resolveFootstepSoundAssetIdAndOptions(
		runtime.rig.rootPart,
		humanoid.FloorMaterial,
		runtime.profile
	)
	if soundAssetId == nil or soundOptions == nil then
		return false
	end

	local playedSound = AudioServiceClient:playSfx(soundAssetId, soundOptions)
	if playedSound then
		runtime.lastFootstepAt = now
		return true
	end

	return false
end

function AnimationServiceClient.PlayJump(self: AnimationServiceClient, runtime: CharacterRuntime, now: number): boolean
	if not self:canPlayJump(runtime) then
		return false
	end
	if now - runtime.lastJumpAt < runtime.profile.jumpCooldown then
		return false
	end
	if AudioServiceClient.categoryGroups == nil then
		return false
	end

	local soundAssetId, soundOptions =
		AnimationServiceUtils.resolveJumpSoundAssetIdAndOptions(runtime.rig.rootPart, runtime.profile)
	if soundAssetId == nil or soundOptions == nil then
		return false
	end

	local playedSound = AudioServiceClient:playSfx(soundAssetId, soundOptions)
	if playedSound then
		runtime.lastJumpAt = now
		return true
	end

	return false
end

function AnimationServiceClient.ApplyState(self: AnimationServiceClient, profileNameRaw: any, footstepsEnabledRaw: any)
	local nextState =
		AnimationServiceUtils.createState(profileNameRaw, footstepsEnabledRaw, self.profileRegistry, self.state)
	local shouldRebuild = nextState.profileName ~= self.state.profileName
	self.state = nextState

	if shouldRebuild then
		self:rebuildRuntime()
	end
end

function AnimationServiceClient.SetProfile(self: AnimationServiceClient, profileName: string)
	self.networker:fire("setProfile", profileName)
end

function AnimationServiceClient.SetFootstepsEnabled(self: AnimationServiceClient, enabled: boolean)
	self.networker:fire("setFootstepsEnabled", enabled)
end

function AnimationServiceClient.RequestSync(self: AnimationServiceClient)
	self.networker:fire("requestSync")
end

function AnimationServiceClient.Destroy(self: AnimationServiceClient)
	if self.runtimeJanitor then
		self.runtimeJanitor:Destroy()
	end
	if self.characterJanitor then
		self.characterJanitor:Destroy()
	end
	if self.janitor then
		self.janitor:Destroy()
	end
end

AnimationServiceClient.init = AnimationServiceClient.Init
AnimationServiceClient.onCharacterAdded = AnimationServiceClient.OnCharacterAdded
AnimationServiceClient.rebuildRuntime = AnimationServiceClient.RebuildRuntime
AnimationServiceClient.switchToClip = AnimationServiceClient.SwitchToClip
AnimationServiceClient.updateMovementAnimation = AnimationServiceClient.UpdateMovementAnimation
AnimationServiceClient.updateHumanoidState = AnimationServiceClient.UpdateHumanoidState
AnimationServiceClient.refreshAnimation = AnimationServiceClient.RefreshAnimation
AnimationServiceClient.onFootstepEvent = AnimationServiceClient.OnFootstepEvent
AnimationServiceClient.canPlayFootstep = AnimationServiceClient.CanPlayFootstep
AnimationServiceClient.onJumpEvent = AnimationServiceClient.OnJumpEvent
AnimationServiceClient.canPlayJump = AnimationServiceClient.CanPlayJump
AnimationServiceClient.playFootstep = AnimationServiceClient.PlayFootstep
AnimationServiceClient.playJump = AnimationServiceClient.PlayJump
AnimationServiceClient.applyState = AnimationServiceClient.ApplyState
AnimationServiceClient.setProfile = AnimationServiceClient.SetProfile
AnimationServiceClient.setFootstepsEnabled = AnimationServiceClient.SetFootstepsEnabled
AnimationServiceClient.requestSync = AnimationServiceClient.RequestSync
AnimationServiceClient.destroy = AnimationServiceClient.Destroy

type AnimationServiceClient = typeof(AnimationServiceClient) & {
	localPlayer: Player,
	networker: Networker.Client,
	janitor: JanitorClass,
	characterJanitor: JanitorClass,
	runtimeJanitor: JanitorClass,
	character: Model?,
	runtime: CharacterRuntime?,
	profileRegistry: { [string]: AnimationProfile },
	state: AnimationServiceState,
	movementLocked: boolean,
}

return AnimationServiceClient :: AnimationServiceClient
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="734">
              <Properties>
                <string name="Name">AudioServiceClient</string>
                <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Sift = require(ReplicatedStorage.Packages.Sift)
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local RobloxSoundService = game:GetService("SoundService")
local RunService = game:GetService("RunService")

local AudioRegistry = require(script:FindFirstAncestor("game").Shared.Modules.Items.Audio)
local AudioServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.AudioServiceUtils)
local BossServiceClient = require(script:FindFirstAncestor("game").Client.Services.BossServiceClient)
local ClientBinderSupport = require(script:FindFirstAncestor("game").Client.Binders.ClientBinderSupport)
local Janitor = require(ReplicatedStorage.Packages.Janitor)
local Networker = require(script:FindFirstAncestor("game").Shared.Modules.Networking.Networker)
local NevermoreSupport = require(script:FindFirstAncestor("game").Shared.Modules.Core.NevermoreSupport)
local WeatherServiceClient = require(script:FindFirstAncestor("game").Client.Services.WeatherServiceClient)
local WeatherServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.WeatherServiceUtils)
local WorldGenerationServiceClient =
	require(script:FindFirstAncestor("game").Client.Services.WorldGenerationServiceClient)

type SoundCategory = AudioServiceUtils.SoundCategory
type AudioServiceState = AudioServiceUtils.AudioServiceState

type JanitorClass = {
	GiveChore: (self: JanitorClass, chore: any, ...any) -> (),
	Clean: (self: JanitorClass) -> (),
	Destroy: (self: JanitorClass) -> (),
}

local AudioServiceClient = {}

local DEFAULT_CHARACTER_SOUND_NAMES: { [string]: boolean } = {
	Climbing = true,
	FreeFalling = true,
	GettingUp = true,
	Jumping = true,
	Landing = true,
	Running = true,
	Splash = true,
	Swimming = true,
}

local SOUNDTRACK_CHANNEL_NAME = "biomeSoundtrack"
local SOUNDTRACK_FADE_SECONDS = 1.1
local SOUNDTRACK_TRACK_GAP_SECONDS = 0
local SOUNDTRACK_BIOME_SAMPLE_INTERVAL = 0.35
local DEFAULT_SOUNDTRACK_BIOME = "Overworld"
local OVERWORLD_NIGHT_SOUNDTRACK_BIOME = "OverworldNight"
local CORRUPTION_SOUNDTRACK_BIOME = "Corruption"
local SNOW_SOUNDTRACK_BIOME = "Snow"
local JUNGLE_SOUNDTRACK_BIOME = "Jungle"
local UNDERGROUND_SOUNDTRACK_BIOME = "Underground"
local UNDERGROUND_CORRUPTION_SOUNDTRACK_BIOME = "UndergroundCorruption"
local CAVERN_SOUNDTRACK_BIOME = "Cavern"
local RAIN_SOUNDTRACK_BIOME = "Rain"
local EYE_OF_CTHULHU_SOUNDTRACK_BIOME = "EyeOfCthulhu"
local BIOME_TYPE_NORMAL = 1
local BIOME_TYPE_CORRUPTION = 2
local BIOME_ID_FOREST = 1
local BIOME_ID_SNOW = 3
local BIOME_ID_JUNGLE = 4
local DEPTH_LAYER_UNDERGROUND = 2
local DEPTH_LAYER_CAVERN = 3
local DEPTH_LAYER_DEEP = 4
local NIGHT_CLOCK_START = 19
local NIGHT_CLOCK_END = 5.5
local MUSIC_AUDIO = (AudioRegistry :: any).Music or {}

local SOUNDTRACK_TRACK_KEYS_BY_BIOME: { [string]: { string } } = {
	Overworld = { "OverworldDay" },
	OverworldNight = { "OverworldNight" },
	Corruption = { "Corruption" },
	Snow = { "Snow" },
	Jungle = { "Jungle" },
	Underground = { "Underground" },
	UndergroundCorruption = { "UndergroundCorruption" },
	Cavern = { "Cavern" },
	Rain = { "Rain" },
	EyeOfCthulhu = { "EyeOfCthulhuRedux" },
}

local SOUNDTRACK_BIOME_BY_BIOME_TYPE: { [number]: string } = {
	[BIOME_TYPE_NORMAL] = DEFAULT_SOUNDTRACK_BIOME,
	[BIOME_TYPE_CORRUPTION] = CORRUPTION_SOUNDTRACK_BIOME,
}

local SOUNDTRACK_LOOPED_BY_BIOME: { [string]: boolean } = {
	Overworld = false,
	OverworldNight = true,
	Corruption = true,
	Snow = true,
	Jungle = true,
	Underground = true,
	UndergroundCorruption = true,
	Cavern = true,
	Rain = true,
	EyeOfCthulhu = true,
}

local function isRainActive(): boolean
	local weatherState = (WeatherServiceClient :: any).state
	if typeof(weatherState) ~= "table" then
		return false
	end

	local weatherType = WeatherServiceUtils.sanitizeWeatherType((weatherState :: any).weatherType, "Clear")
	if weatherType ~= WeatherServiceUtils.WEATHER_TYPE_CLEAR then
		return true
	end

	local rainIntensity = WeatherServiceUtils.sanitizeNumber((weatherState :: any).rainIntensity, 0, 0, 1)
	return rainIntensity > 0.01
end

local function isNightTime(clockTime: number): boolean
	return clockTime >= NIGHT_CLOCK_START or clockTime <= NIGHT_CLOCK_END
end

local function resolveCharacterRootPart(character: Model?): BasePart?
	if character == nil then
		return nil
	end
	local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
	if humanoidRootPart ~= nil and humanoidRootPart:IsA("BasePart") then
		return humanoidRootPart
	end
	if character.PrimaryPart ~= nil then
		return character.PrimaryPart
	end
	return character:FindFirstChildWhichIsA("BasePart")
end

local function shuffleStringsInPlace(randomObject: Random, values: { string })
	for index = #values, 2, -1 do
		local swapIndex = randomObject:NextInteger(1, index)
		values[index], values[swapIndex] = values[swapIndex], values[index]
	end
end

local function disableSoundScriptIfNeeded(scriptInstance: Instance)
	if scriptInstance.Name ~= "RbxCharacterSounds" then
		return
	end
	if scriptInstance:IsA("LocalScript") or scriptInstance:IsA("Script") then
		(scriptInstance :: any).Enabled = false
	end
end

local function removeDefaultCharacterSoundIfNeeded(instance: Instance)
	if not instance:IsA("Sound") then
		return
	end
	if DEFAULT_CHARACTER_SOUND_NAMES[instance.Name] ~= true then
		return
	end
	instance:Destroy()
end

local function disableDefaultCharacterSoundSystem(player: Player, character: Model?)
	local playerScripts = player:FindFirstChild("PlayerScripts")
	if playerScripts then
		local existingScript = playerScripts:FindFirstChild("RbxCharacterSounds")
		if existingScript then
			disableSoundScriptIfNeeded(existingScript)
		end
	end

	if character then
		for _, descendant in character:GetDescendants() do
			disableSoundScriptIfNeeded(descendant)
			removeDefaultCharacterSoundIfNeeded(descendant)
		end
	end
end

function AudioServiceClient.RefreshSoundtrackAssetIds(self: AudioServiceClient)
	local assetIdsByBiome: { [string]: { string } } = {}

	for soundtrackBiome, trackKeys in SOUNDTRACK_TRACK_KEYS_BY_BIOME do
		local trackAssetIds: { string } = {}
		for _, trackKey in trackKeys do
			local soundAssetId = AudioServiceUtils.normalizeSoundAssetId((MUSIC_AUDIO :: any)[trackKey])
			if soundAssetId ~= nil then
				table.insert(trackAssetIds, soundAssetId)
			end
		end
		assetIdsByBiome[soundtrackBiome] = trackAssetIds
	end

	self.soundtrackAssetIdsByBiome = assetIdsByBiome
	self.soundtrackShuffleBagByBiome = {}
end

function AudioServiceClient.ResolveBiomeTypeAtWorldPosition(self: AudioServiceClient, worldPosition: Vector3): number
	if typeof((WorldGenerationServiceClient :: any).state) ~= "table" then
		return BIOME_TYPE_NORMAL
	end

	local worldState = WorldGenerationServiceClient:getState()
	if worldState.ready ~= true then
		return BIOME_TYPE_NORMAL
	end

	local ok, biomeTypeOrError = pcall(function()
		return WorldGenerationServiceClient:getBiomeTypeAtWorldPosition(worldPosition)
	end)
	if not ok or typeof(biomeTypeOrError) ~= "number" then
		return BIOME_TYPE_NORMAL
	end

	local biomeType = math.floor(biomeTypeOrError)
	if biomeType == BIOME_TYPE_CORRUPTION then
		return BIOME_TYPE_CORRUPTION
	end
	return BIOME_TYPE_NORMAL
end

function AudioServiceClient.ResolveBiomeIdAtWorldPosition(self: AudioServiceClient, worldPosition: Vector3): number
	if typeof((WorldGenerationServiceClient :: any).state) ~= "table" then
		return BIOME_ID_FOREST
	end

	local worldState = WorldGenerationServiceClient:getState()
	if worldState.ready ~= true then
		return BIOME_ID_FOREST
	end

	local ok, biomeIdOrError = pcall(function()
		return WorldGenerationServiceClient:getBiomeIdAtWorldPosition(worldPosition)
	end)
	if not ok or typeof(biomeIdOrError) ~= "number" then
		return BIOME_ID_FOREST
	end

	local biomeId = math.floor(biomeIdOrError)
	if biomeId == BIOME_ID_SNOW then
		return BIOME_ID_SNOW
	end
	if biomeId == BIOME_ID_JUNGLE then
		return BIOME_ID_JUNGLE
	end
	return BIOME_ID_FOREST
end

function AudioServiceClient.ResolveDepthLayerAtWorldPosition(self: AudioServiceClient, worldPosition: Vector3): number?
	if typeof((WorldGenerationServiceClient :: any).state) ~= "table" then
		return nil
	end

	local worldState = WorldGenerationServiceClient:getState()
	if worldState.ready ~= true then
		return nil
	end

	local ok, depthLayerOrError = pcall(function()
		return (WorldGenerationServiceClient :: any):getDepthLayerAtWorldPosition(worldPosition)
	end)
	if not ok or typeof(depthLayerOrError) ~= "number" then
		return nil
	end
	return math.floor(depthLayerOrError)
end

function AudioServiceClient.AttachBossStateListenerIfNeeded(self: AudioServiceClient)
	if self.bossStateChangedConnection ~= nil then
		return
	end

	local bossStateChanged = (BossServiceClient :: any).stateChanged
	if typeof(bossStateChanged) ~= "table" or typeof((bossStateChanged :: any).Connect) ~= "function" then
		return
	end

	local connection = bossStateChanged:Connect(function()
		self.soundtrackSampleAccumulator = SOUNDTRACK_BIOME_SAMPLE_INTERVAL
		self:updateBiomeSoundtrack(SOUNDTRACK_BIOME_SAMPLE_INTERVAL)
	end)
	self.bossStateChangedConnection = connection
	self.janitor:GiveChore(connection)

	self.soundtrackSampleAccumulator = SOUNDTRACK_BIOME_SAMPLE_INTERVAL
end

function AudioServiceClient.ResolveBossSoundtrackBiome(self: AudioServiceClient): string?
	local bossState = (BossServiceClient :: any).state
	if typeof(bossState) ~= "table" then
		return nil
	end

	local orderedIds = (bossState :: any).orderedIds
	local byId = (bossState :: any).byId
	if typeof(orderedIds) ~= "table" or typeof(byId) ~= "table" then
		return nil
	end

	for _, runtimeId in orderedIds do
		local snapshot = byId[runtimeId]
		if typeof(snapshot) ~= "table" then
			continue
		end
		if (snapshot :: any).bossId ~= "EyeOfCthulhu" or (snapshot :: any).isAlive ~= true then
			continue
		end

		local state = (snapshot :: any).state
		if state ~= "Dormant" and state ~= "Death" and state ~= "Despawn" then
			return EYE_OF_CTHULHU_SOUNDTRACK_BIOME
		end
	end

	return nil
end

function AudioServiceClient.ResolveSoundtrackBiomeForLocalPlayer(self: AudioServiceClient): string?
	local bossSoundtrackBiome = self:resolveBossSoundtrackBiome()
	if bossSoundtrackBiome ~= nil then
		return bossSoundtrackBiome
	end

	local character = self.localPlayer.Character
	if character == nil then
		return nil
	end

	local rootPart = resolveCharacterRootPart(character)
	if rootPart == nil then
		return nil
	end
	local worldPosition = rootPart.Position

	local biomeType = self:resolveBiomeTypeAtWorldPosition(worldPosition)
	local depthLayer = self:resolveDepthLayerAtWorldPosition(worldPosition)
	if depthLayer == DEPTH_LAYER_CAVERN or depthLayer == DEPTH_LAYER_DEEP then
		if biomeType == BIOME_TYPE_CORRUPTION then
			return UNDERGROUND_CORRUPTION_SOUNDTRACK_BIOME
		end
		return CAVERN_SOUNDTRACK_BIOME
	end
	if depthLayer == DEPTH_LAYER_UNDERGROUND then
		if biomeType == BIOME_TYPE_CORRUPTION then
			return UNDERGROUND_CORRUPTION_SOUNDTRACK_BIOME
		end
		return UNDERGROUND_SOUNDTRACK_BIOME
	end

	if isRainActive() then
		return RAIN_SOUNDTRACK_BIOME
	end

	if biomeType == BIOME_TYPE_CORRUPTION then
		return CORRUPTION_SOUNDTRACK_BIOME
	end

	local biomeId = self:resolveBiomeIdAtWorldPosition(worldPosition)
	if biomeId == BIOME_ID_SNOW then
		return SNOW_SOUNDTRACK_BIOME
	end
	if biomeId == BIOME_ID_JUNGLE then
		return JUNGLE_SOUNDTRACK_BIOME
	end

	local soundtrackBiome = SOUNDTRACK_BIOME_BY_BIOME_TYPE[BIOME_TYPE_NORMAL]
	if soundtrackBiome ~= nil then
		if soundtrackBiome == DEFAULT_SOUNDTRACK_BIOME and isNightTime(Lighting.ClockTime) then
			return OVERWORLD_NIGHT_SOUNDTRACK_BIOME
		end
		return soundtrackBiome
	end
	return DEFAULT_SOUNDTRACK_BIOME
end

function AudioServiceClient.GetNextTrackForSoundtrackBiome(self: AudioServiceClient, soundtrackBiome: string): string?
	local assetIds = self.soundtrackAssetIdsByBiome[soundtrackBiome]
	if assetIds == nil or #assetIds <= 0 then
		return nil
	end

	local shuffleBag = self.soundtrackShuffleBagByBiome[soundtrackBiome]
	if shuffleBag == nil or #shuffleBag <= 0 then
		shuffleBag = Sift.Dictionary.copy(assetIds)
		shuffleStringsInPlace(self.random, shuffleBag)
		self.soundtrackShuffleBagByBiome[soundtrackBiome] = shuffleBag
	end

	if #shuffleBag <= 0 then
		return nil
	end
	return table.remove(shuffleBag, 1)
end

function AudioServiceClient.ClearActiveSoundtrackConnections(self: AudioServiceClient)
	if self.soundtrackTrackEndedConnection ~= nil then
		self.soundtrackTrackEndedConnection:Disconnect()
		self.soundtrackTrackEndedConnection = nil
	end
	if self.soundtrackTrackDestroyingConnection ~= nil then
		self.soundtrackTrackDestroyingConnection:Disconnect()
		self.soundtrackTrackDestroyingConnection = nil
	end
end

function AudioServiceClient.PlayNextSoundtrackTrack(self: AudioServiceClient, playbackToken: number)
	if playbackToken ~= self.soundtrackPlaybackToken then
		return
	end

	local soundtrackBiome = self.soundtrackCurrentBiome
	if soundtrackBiome == nil or soundtrackBiome == "" then
		return
	end

	local nextTrackAssetId = self:getNextTrackForSoundtrackBiome(soundtrackBiome)
	if nextTrackAssetId == nil then
		self:stopChannel(SOUNDTRACK_CHANNEL_NAME, SOUNDTRACK_FADE_SECONDS)
		self.soundtrackActiveTrack = nil
		return
	end
	local shouldLoop = SOUNDTRACK_LOOPED_BY_BIOME[soundtrackBiome] == true

	local playingSound = self:playSound(nextTrackAssetId, {
		category = "Music",
		channel = SOUNDTRACK_CHANNEL_NAME,
		looped = shouldLoop,
		autoDestroy = not shouldLoop,
		fadeInTime = SOUNDTRACK_FADE_SECONDS,
		fadeOutTime = SOUNDTRACK_FADE_SECONDS,
	}, "Music")
	if playingSound == nil then
		task.delay(SOUNDTRACK_TRACK_GAP_SECONDS, function()
			self:playNextSoundtrackTrack(playbackToken)
		end)
		return
	end

	self.soundtrackActiveTrack = playingSound
	self:clearActiveSoundtrackConnections()
	if shouldLoop then
		return
	end

	local handled = false
	local function queueNextTrack()
		if handled then
			return
		end
		handled = true
		self:clearActiveSoundtrackConnections()
		if self.soundtrackActiveTrack == playingSound then
			self.soundtrackActiveTrack = nil
		end
		if playbackToken ~= self.soundtrackPlaybackToken then
			return
		end
		task.delay(SOUNDTRACK_TRACK_GAP_SECONDS, function()
			self:playNextSoundtrackTrack(playbackToken)
		end)
	end

	self.soundtrackTrackEndedConnection = playingSound.Ended:Connect(function()
		queueNextTrack()
	end)
	self.soundtrackTrackDestroyingConnection = playingSound.Destroying:Connect(function()
		queueNextTrack()
	end)
end

function AudioServiceClient.SetSoundtrackBiome(self: AudioServiceClient, soundtrackBiomeRaw: any)
	local soundtrackBiome = if typeof(soundtrackBiomeRaw) == "string" and soundtrackBiomeRaw ~= ""
		then soundtrackBiomeRaw
		else DEFAULT_SOUNDTRACK_BIOME

	local tracks = self.soundtrackAssetIdsByBiome[soundtrackBiome]
	if tracks == nil or #tracks <= 0 then
		soundtrackBiome = DEFAULT_SOUNDTRACK_BIOME
	end

	local activeTrack = self.soundtrackActiveTrack
	local isTrackAlive = activeTrack ~= nil and activeTrack.Parent ~= nil
	if self.soundtrackCurrentBiome == soundtrackBiome and isTrackAlive then
		return
	end

	self.soundtrackCurrentBiome = soundtrackBiome
	self.soundtrackPlaybackToken += 1
	self:playNextSoundtrackTrack(self.soundtrackPlaybackToken)
end

function AudioServiceClient.UpdateBiomeSoundtrack(self: AudioServiceClient, deltaTime: number)
	self:attachBossStateListenerIfNeeded()
	self.soundtrackSampleAccumulator += deltaTime
	if self.soundtrackSampleAccumulator < SOUNDTRACK_BIOME_SAMPLE_INTERVAL then
		return
	end
	self.soundtrackSampleAccumulator = 0

	local soundtrackBiome = self:resolveSoundtrackBiomeForLocalPlayer()
	if soundtrackBiome == nil then
		return
	end
	self:setSoundtrackBiome(soundtrackBiome)
end

function AudioServiceClient.Init(self: AudioServiceClient)
	if self.janitor ~= nil then
		return
	end
	self.localPlayer = Players.LocalPlayer
	self.networker = Networker.client.new("AudioService", self)
	self.janitor = Janitor.new()
	self.characterSoundJanitor = Janitor.new()
	self.state = AudioServiceUtils.createDefaultState()
	self.runtimeFolder = AudioServiceUtils.ensureRuntimeFolder(RobloxSoundService)
	self.categoryGroups = AudioServiceUtils.ensureCategoryGroups(RobloxSoundService)
	self.channelSounds = {}
	self.random = Random.new()
	self.soundtrackAssetIdsByBiome = {}
	self.soundtrackShuffleBagByBiome = {}
	self.soundtrackCurrentBiome = nil
	self.soundtrackActiveTrack = nil
	self.soundtrackPlaybackToken = 0
	self.soundtrackTrackEndedConnection = nil
	self.soundtrackTrackDestroyingConnection = nil
	self.soundtrackSampleAccumulator = SOUNDTRACK_BIOME_SAMPLE_INTERVAL
	self.bossStateChangedConnection = nil

	self.binders = NevermoreSupport.getService(ClientBinderSupport)
	AudioServiceUtils.applyStateToCategoryGroups(self.state, self.categoryGroups)
	disableDefaultCharacterSoundSystem(self.localPlayer, self.localPlayer.Character)
	self:refreshSoundtrackAssetIds()

	self.janitor:GiveChore(self.characterSoundJanitor)
	self.janitor:GiveChore(self.localPlayer.CharacterAdded:Connect(function(character: Model)
		self:onCharacterAdded(character)
		self.soundtrackSampleAccumulator = SOUNDTRACK_BIOME_SAMPLE_INTERVAL
	end))
	self.janitor:GiveChore(RunService.Heartbeat:Connect(function(deltaTime: number)
		self:updateBiomeSoundtrack(deltaTime)
	end))

	self.janitor:GiveChore(function()
		self.networker:destroy()
	end)
	self.janitor:GiveChore(function()
		self:clearActiveSoundtrackConnections()
		self:stopAll(0)
	end)

	if self.localPlayer.Character then
		self:onCharacterAdded(self.localPlayer.Character)
	end

	self.networker:fire("requestSync")
end

function AudioServiceClient.OnCharacterAdded(self: AudioServiceClient, character: Model)
	self.characterSoundJanitor:Clean()
	disableDefaultCharacterSoundSystem(self.localPlayer, character)

	local playerScripts = self.localPlayer:FindFirstChild("PlayerScripts")
	if playerScripts then
		self.characterSoundJanitor:GiveChore(playerScripts.ChildAdded:Connect(function(child: Instance)
			disableSoundScriptIfNeeded(child)
		end))
	end

	self.characterSoundJanitor:GiveChore(character.DescendantAdded:Connect(function(instance: Instance)
		disableSoundScriptIfNeeded(instance)
		removeDefaultCharacterSoundIfNeeded(instance)
	end))
end

function AudioServiceClient.ApplyState(
	self: AudioServiceClient,
	masterVolumeRaw: any,
	mutedRaw: any,
	categoryVolumesRaw: any
)
	self.state = AudioServiceUtils.createState(masterVolumeRaw, mutedRaw, categoryVolumesRaw, self.state)
	AudioServiceUtils.applyStateToCategoryGroups(self.state, self.categoryGroups)
end

function AudioServiceClient.SetMasterVolume(self: AudioServiceClient, masterVolumeRaw: any, replicateToServer: boolean?)
	self.state = AudioServiceUtils.withMasterVolume(self.state, masterVolumeRaw)
	AudioServiceUtils.applyStateToCategoryGroups(self.state, self.categoryGroups)
	if replicateToServer ~= false then
		self.networker:fire("setMasterVolume", self.state.masterVolume)
	end
end

function AudioServiceClient.SetMuted(self: AudioServiceClient, mutedRaw: any, replicateToServer: boolean?)
	self.state = AudioServiceUtils.withMuted(self.state, mutedRaw)
	AudioServiceUtils.applyStateToCategoryGroups(self.state, self.categoryGroups)
	if replicateToServer ~= false then
		self.networker:fire("setMuted", self.state.muted)
	end
end

function AudioServiceClient.SetCategoryVolume(
	self: AudioServiceClient,
	categoryRaw: any,
	volumeRaw: any,
	replicateToServer: boolean?
)
	self.state = AudioServiceUtils.withCategoryVolume(self.state, categoryRaw, volumeRaw)
	AudioServiceUtils.applyStateToCategoryGroups(self.state, self.categoryGroups)
	if replicateToServer ~= false then
		local category = AudioServiceUtils.normalizeCategoryOrNil(categoryRaw)
		if category then
			self.networker:fire("setCategoryVolume", category, volumeRaw)
		end
	end
end

function AudioServiceClient.ToggleMute(self: AudioServiceClient, replicateToServer: boolean?)
	self:setMuted(not self.state.muted, replicateToServer)
end

function AudioServiceClient.RequestSync(self: AudioServiceClient)
	self.networker:fire("requestSync")
end

function AudioServiceClient.PlaySound(
	self: AudioServiceClient,
	soundAssetIdRaw: any,
	optionsRaw: any,
	fallbackCategory: SoundCategory?
): Sound?
	local soundAssetId, options =
		AudioServiceUtils.resolvePlaybackRequest(soundAssetIdRaw, optionsRaw, fallbackCategory)
	if soundAssetId == nil then
		return nil
	end

	if self.runtimeFolder == nil then
		self.runtimeFolder = AudioServiceUtils.ensureRuntimeFolder(RobloxSoundService)
	end
	if self.categoryGroups == nil then
		self.categoryGroups = AudioServiceUtils.ensureCategoryGroups(RobloxSoundService)
		local state = self.state or AudioServiceUtils.createDefaultState()
		self.state = state
		AudioServiceUtils.applyStateToCategoryGroups(state, self.categoryGroups)
	end
	if self.channelSounds == nil then
		self.channelSounds = {}
	end

	local categoryGroup = self.categoryGroups[options.category]

	local shouldReplaceChannel = if options.replaceChannel == nil then true else options.replaceChannel
	if options.channel and shouldReplaceChannel then
		self:stopChannel(options.channel, options.fadeOutTime)
	end

	local sound = AudioServiceUtils.createSoundInstance(soundAssetId, options, self.runtimeFolder, categoryGroup)
	if not sound then
		return nil
	end

	local channelName = options.channel
	if channelName then
		self.channelSounds[channelName] = sound

		local channelConnection: RBXScriptConnection?
		channelConnection = sound.Destroying:Connect(function()
			if self.channelSounds[channelName] == sound then
				self.channelSounds[channelName] = nil
			end
			if channelConnection then
				channelConnection:Disconnect()
				channelConnection = nil
			end
		end)
	end

	local fadeInTime = options.fadeInTime
	if fadeInTime and fadeInTime > 0 then
		local targetVolume: number = if options.volume ~= nil then options.volume else sound.Volume
		sound.Volume = 0
		AudioServiceUtils.fadeSoundVolume(sound, targetVolume, fadeInTime)
	end

	local shouldAutoDestroy = if options.autoDestroy == nil then not sound.Looped else options.autoDestroy
	if shouldAutoDestroy and not sound.Looped then
		local endedConnection: RBXScriptConnection?
		endedConnection = sound.Ended:Connect(function()
			if endedConnection then
				endedConnection:Disconnect()
				endedConnection = nil
			end
			if sound.Parent then
				sound:Destroy()
			end
		end)
	end

	sound:Play()
	return sound
end

function AudioServiceClient.PlaySfx(self: AudioServiceClient, soundAssetIdRaw: any, optionsRaw: any): Sound?
	return self:playSound(soundAssetIdRaw, optionsRaw, "SFX")
end

function AudioServiceClient.PlayUi(self: AudioServiceClient, soundAssetIdRaw: any, optionsRaw: any): Sound?
	return self:playSound(soundAssetIdRaw, optionsRaw, "UI")
end

function AudioServiceClient.PlayMusic(self: AudioServiceClient, soundAssetIdRaw: any, optionsRaw: any): Sound?
	local options = AudioServiceUtils.sanitizePlaybackOptions(optionsRaw, "Music")
	if options.channel == nil then
		options.channel = "music"
	end
	options.looped = true
	if options.fadeOutTime == nil or options.fadeOutTime <= 0 then
		options.fadeOutTime = 0.2
	end
	if options.fadeInTime == nil or options.fadeInTime <= 0 then
		options.fadeInTime = 0.2
	end
	return self:playSound(soundAssetIdRaw, options, "Music")
end

function AudioServiceClient.StopChannel(self: AudioServiceClient, channelNameRaw: any, fadeTimeRaw: any)
	if typeof(channelNameRaw) ~= "string" or channelNameRaw == "" then
		return
	end

	local sound = self.channelSounds[channelNameRaw]
	if not sound then
		return
	end

	self.channelSounds[channelNameRaw] = nil
	AudioServiceUtils.stopAndDestroySound(sound, fadeTimeRaw)
end

function AudioServiceClient.StopAll(self: AudioServiceClient, fadeTimeRaw: any)
	local channels: { string } = {}
	for channelName in self.channelSounds do
		table.insert(channels, channelName)
	end

	for _, channelName in channels do
		self:stopChannel(channelName, fadeTimeRaw)
	end
end

function AudioServiceClient.Destroy(self: AudioServiceClient)
	if self.janitor then
		self.janitor:Destroy()
		self.janitor = nil
	end
end

AudioServiceClient.refreshSoundtrackAssetIds = AudioServiceClient.RefreshSoundtrackAssetIds
AudioServiceClient.resolveBiomeTypeAtWorldPosition = AudioServiceClient.ResolveBiomeTypeAtWorldPosition
AudioServiceClient.resolveBiomeIdAtWorldPosition = AudioServiceClient.ResolveBiomeIdAtWorldPosition
AudioServiceClient.resolveDepthLayerAtWorldPosition = AudioServiceClient.ResolveDepthLayerAtWorldPosition
AudioServiceClient.attachBossStateListenerIfNeeded = AudioServiceClient.AttachBossStateListenerIfNeeded
AudioServiceClient.resolveBossSoundtrackBiome = AudioServiceClient.ResolveBossSoundtrackBiome
AudioServiceClient.resolveSoundtrackBiomeForLocalPlayer = AudioServiceClient.ResolveSoundtrackBiomeForLocalPlayer
AudioServiceClient.getNextTrackForSoundtrackBiome = AudioServiceClient.GetNextTrackForSoundtrackBiome
AudioServiceClient.clearActiveSoundtrackConnections = AudioServiceClient.ClearActiveSoundtrackConnections
AudioServiceClient.playNextSoundtrackTrack = AudioServiceClient.PlayNextSoundtrackTrack
AudioServiceClient.setSoundtrackBiome = AudioServiceClient.SetSoundtrackBiome
AudioServiceClient.updateBiomeSoundtrack = AudioServiceClient.UpdateBiomeSoundtrack
AudioServiceClient.init = AudioServiceClient.Init
AudioServiceClient.onCharacterAdded = AudioServiceClient.OnCharacterAdded
AudioServiceClient.applyState = AudioServiceClient.ApplyState
AudioServiceClient.setMasterVolume = AudioServiceClient.SetMasterVolume
AudioServiceClient.setMuted = AudioServiceClient.SetMuted
AudioServiceClient.setCategoryVolume = AudioServiceClient.SetCategoryVolume
AudioServiceClient.toggleMute = AudioServiceClient.ToggleMute
AudioServiceClient.requestSync = AudioServiceClient.RequestSync
AudioServiceClient.playSound = AudioServiceClient.PlaySound
AudioServiceClient.playSfx = AudioServiceClient.PlaySfx
AudioServiceClient.playUi = AudioServiceClient.PlayUi
AudioServiceClient.playMusic = AudioServiceClient.PlayMusic
AudioServiceClient.stopChannel = AudioServiceClient.StopChannel
AudioServiceClient.stopAll = AudioServiceClient.StopAll
AudioServiceClient.destroy = AudioServiceClient.Destroy

type AudioServiceClient = typeof(AudioServiceClient) & {
	refreshSoundtrackAssetIds: (self: AudioServiceClient) -> (),
	resolveBiomeTypeAtWorldPosition: (self: AudioServiceClient, worldPosition: Vector3) -> number,
	resolveBiomeIdAtWorldPosition: (self: AudioServiceClient, worldPosition: Vector3) -> number,
	resolveDepthLayerAtWorldPosition: (self: AudioServiceClient, worldPosition: Vector3) -> number?,
	attachBossStateListenerIfNeeded: (self: AudioServiceClient) -> (),
	resolveBossSoundtrackBiome: (self: AudioServiceClient) -> string?,
	resolveSoundtrackBiomeForLocalPlayer: (self: AudioServiceClient) -> string?,
	getNextTrackForSoundtrackBiome: (self: AudioServiceClient, soundtrackBiome: string) -> string?,
	clearActiveSoundtrackConnections: (self: AudioServiceClient) -> (),
	playNextSoundtrackTrack: (self: AudioServiceClient, playbackToken: number) -> (),
	setSoundtrackBiome: (self: AudioServiceClient, soundtrackBiomeRaw: any) -> (),
	updateBiomeSoundtrack: (self: AudioServiceClient, deltaTime: number) -> (),
	localPlayer: Player,
	networker: Networker.Client,
	janitor: JanitorClass,
	characterSoundJanitor: JanitorClass,
	state: AudioServiceState,
	runtimeFolder: Folder,
	categoryGroups: { [string]: SoundGroup },
	channelSounds: { [string]: Sound },
	random: Random,
	soundtrackAssetIdsByBiome: { [string]: { string } },
	soundtrackShuffleBagByBiome: { [string]: { string } },
	soundtrackCurrentBiome: string?,
	soundtrackActiveTrack: Sound?,
	soundtrackPlaybackToken: number,
	soundtrackTrackEndedConnection: RBXScriptConnection?,
	soundtrackTrackDestroyingConnection: RBXScriptConnection?,
	soundtrackSampleAccumulator: number,
	bossStateChangedConnection: RBXScriptConnection?,
}

return AudioServiceClient :: AudioServiceClient
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="735">
              <Properties>
                <string name="Name">BossServiceClient</string>
                <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")
local Workspace = game:GetService("Workspace")

local BossServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.BossServiceUtils)
local CameraShaker = require(ReplicatedStorage.Packages.EZCameraShake)
local EyeOfCthulhuPresentation = require(script:FindFirstAncestor("game").Shared.Classes.Boss.EyeOfCthulhu.Presentation)
local Janitor = require(ReplicatedStorage.Packages.Janitor)
local Networker = require(script:FindFirstAncestor("game").Shared.Modules.Networking.Networker)
local Sift = require(ReplicatedStorage.Packages.Sift)
local Signal = require(ReplicatedStorage.Packages.Signal)
local WorkspaceFolders = require(script:FindFirstAncestor("game").Shared.Modules.Core.WorkspaceFolders)

type BossSnapshot = BossServiceUtils.BossSnapshot
type BossServiceState = BossServiceUtils.BossServiceState

type SignalObject = {
	Connect: (self: SignalObject, callback: (...any) -> ()) -> RBXScriptConnection,
	Fire: (self: SignalObject, ...any) -> (),
	Destroy: (self: SignalObject) -> (),
}

type JanitorClass = {
	GiveChore: (self: JanitorClass, chore: any, ...any) -> (),
	Destroy: (self: JanitorClass) -> (),
}

type CameraShakerObject = {
	Start: (self: CameraShakerObject) -> (),
	Stop: (self: CameraShakerObject) -> (),
	ShakeOnce: (
		self: CameraShakerObject,
		magnitude: number,
		roughness: number,
		fadeInTime: number?,
		fadeOutTime: number?,
		posInfluence: Vector3?,
		rotInfluence: Vector3?
	) -> (),
}

type PresentationModule = {
	createRuntime: (modelRaw: any, snapshot: BossSnapshot, cameraShaker: CameraShakerObject?) -> any,
	applySnapshot: (runtime: any, snapshot: BossSnapshot) -> (),
	step: (runtime: any, dt: number) -> (),
	destroy: (runtime: any) -> (),
}

type BossVisualRuntime = {
	snapshot: BossSnapshot,
	model: Model?,
	presentationModule: PresentationModule?,
	presentationRuntime: any?,
}

local BossServiceClient = {}

local BOSS_RUNTIME_FOLDER_NAME = "BossRuntime"
local CAMERA_SHAKE_RENDER_PRIORITY = Enum.RenderPriority.Camera.Value + 1

local PRESENTATION_MODULES = {
	EyeOfCthulhu = EyeOfCthulhuPresentation,
}

local function appendUniqueOrderedId(orderedIds: { string }, runtimeId: string): { string }
	if Sift.Array.includes(orderedIds, runtimeId) then
		return orderedIds
	end
	return Sift.Array.append(orderedIds, runtimeId)
end

local function trim(valueRaw: any): string
	return BossServiceUtils.trim(valueRaw)
end

local function pushAnnouncement(textRaw: any)
	local text = trim(textRaw)
	if text == "" then
		return
	end

	local didNotify = false
	pcall(function()
		StarterGui:SetCore("SendNotification", {
			Title = "Boss",
			Text = text,
			Duration = 4,
		})
		didNotify = true
	end)

	if didNotify then
		return
	end

	pcall(function()
		StarterGui:SetCore("ChatMakeSystemMessage", {
			Text = text,
			Color = Color3.fromRGB(219, 88, 88),
		})
	end)
end

function BossServiceClient.ResolvePresentationModule(
	self: BossServiceClient,
	snapshot: BossSnapshot
): PresentationModule?
	local definition = BossServiceUtils.getRegistryEntryById(snapshot.bossId)
	if definition == nil then
		return nil
	end

	local presentationModule = PRESENTATION_MODULES[definition.presentationId]
	if typeof(presentationModule) == "table" then
		return presentationModule :: PresentationModule
	end
	return nil
end

function BossServiceClient.ResolveRuntimeModel(self: BossServiceClient, runtimeIdRaw: any): Model?
	local runtimeId = trim(runtimeIdRaw)
	if runtimeId == "" then
		return nil
	end

	local runtimeFolder = WorkspaceFolders.findFolderInGameOrWorkspace(BOSS_RUNTIME_FOLDER_NAME)
	if runtimeFolder == nil then
		return nil
	end

	for _, child in runtimeFolder:GetChildren() do
		if child:IsA("Model") and child:GetAttribute(BossServiceUtils.RUNTIME_ID_ATTRIBUTE) == runtimeId then
			return child
		end
	end

	return nil
end

function BossServiceClient.DestroyVisual(self: BossServiceClient, runtimeIdRaw: any)
	local runtimeId = trim(runtimeIdRaw)
	if runtimeId == "" then
		return
	end

	local visual = self.visualsById[runtimeId]
	if visual == nil then
		return
	end

	self.visualsById[runtimeId] = nil
	if visual.presentationRuntime ~= nil and visual.presentationModule ~= nil then
		visual.presentationModule.destroy(visual.presentationRuntime)
	end
end

function BossServiceClient.EnsureVisual(self: BossServiceClient, snapshot: BossSnapshot): BossVisualRuntime?
	local runtimeId = snapshot.id
	local visual = self.visualsById[runtimeId]
	if visual == nil then
		visual = {
			snapshot = snapshot,
			model = nil,
			presentationModule = self:resolvePresentationModule(snapshot),
			presentationRuntime = nil,
		}
		self.visualsById[runtimeId] = visual
	else
		visual.snapshot = snapshot
		if visual.presentationModule == nil then
			visual.presentationModule = self:resolvePresentationModule(snapshot)
		end
	end

	if visual.presentationModule == nil then
		return visual
	end

	local model = self:resolveRuntimeModel(runtimeId)
	if model ~= visual.model then
		if visual.presentationRuntime ~= nil then
			visual.presentationModule.destroy(visual.presentationRuntime)
			visual.presentationRuntime = nil
		end
		visual.model = model
	end

	if visual.presentationRuntime == nil and visual.model ~= nil then
		visual.presentationRuntime = visual.presentationModule.createRuntime(visual.model, snapshot, self.cameraShaker)
	end

	if visual.presentationRuntime ~= nil then
		visual.presentationModule.applySnapshot(visual.presentationRuntime, snapshot)
	end

	return visual
end

function BossServiceClient.PushStateChanged(self: BossServiceClient)
	self.stateChanged:Fire(self:getState())
end

function BossServiceClient.ApplyState(self: BossServiceClient, stateRaw: any)
	local nextState = BossServiceUtils.sanitizeState(stateRaw, self.state)
	local previousIds = Sift.Array.copy(self.state.orderedIds)
	self.state = nextState
	self.isReadyFlag = true

	local nextLookup = Sift.Set.fromArray(nextState.orderedIds)

	for _, runtimeId in previousIds do
		if nextLookup[runtimeId] ~= true then
			self:destroyVisual(runtimeId)
		end
	end

	for _, runtimeId in nextState.orderedIds do
		local snapshot = nextState.byId[runtimeId]
		if snapshot ~= nil then
			self:ensureVisual(snapshot)
		end
	end

	self:pushStateChanged()
end

function BossServiceClient.UpsertSnapshot(self: BossServiceClient, snapshotRaw: any)
	local existingSnapshot = nil :: BossSnapshot?
	local runtimeId = if typeof(snapshotRaw) == "table" then (snapshotRaw :: any).id else nil
	if typeof(runtimeId) == "string" then
		existingSnapshot = self.state.byId[runtimeId]
	end

	local snapshot = BossServiceUtils.sanitizeSnapshot(snapshotRaw, existingSnapshot)
	if snapshot == nil then
		return
	end

	self.state = {
		byId = Sift.Dictionary.set(self.state.byId, snapshot.id, snapshot),
		orderedIds = appendUniqueOrderedId(self.state.orderedIds, snapshot.id),
		updatedAt = os.clock(),
	}
	self.isReadyFlag = true
	self:ensureVisual(snapshot)
	self:pushStateChanged()
end

function BossServiceClient.OnBossAdded(self: BossServiceClient, snapshotRaw: any)
	self:upsertSnapshot(snapshotRaw)
end

function BossServiceClient.OnBossUpdated(self: BossServiceClient, snapshotRaw: any)
	self:upsertSnapshot(snapshotRaw)
end

function BossServiceClient.OnBossRemoved(self: BossServiceClient, runtimeIdRaw: any)
	local runtimeId = trim(runtimeIdRaw)
	if runtimeId == "" then
		return
	end

	self.state = {
		byId = Sift.Dictionary.removeKey(self.state.byId, runtimeId),
		orderedIds = Sift.Array.filter(self.state.orderedIds, function(existingId: string): boolean
			return existingId ~= runtimeId
		end),
		updatedAt = os.clock(),
	}
	self:destroyVisual(runtimeId)
	self:pushStateChanged()
end

function BossServiceClient.OnAnnouncement(self: BossServiceClient, payloadRaw: any)
	local payload = if typeof(payloadRaw) == "table" then payloadRaw else {}
	local text = trim((payload :: any).text)
	if text == "" then
		return
	end

	pushAnnouncement(text)
	self.announcementReceived:Fire(payload)
end

function BossServiceClient.RequestSync(self: BossServiceClient)
	self.networker:fire(BossServiceUtils.NETWORK_METHOD_REQUEST_SYNC)
end

function BossServiceClient.RequestManualSummon(self: BossServiceClient, bossTokenRaw: any, optionsRaw: any?)
	self.networker:fire(BossServiceUtils.NETWORK_METHOD_REQUEST_MANUAL_SUMMON, bossTokenRaw, optionsRaw)
end

function BossServiceClient.GetState(self: BossServiceClient): BossServiceState
	return BossServiceUtils.cloneState(self.state)
end

function BossServiceClient.IsReady(self: BossServiceClient): boolean
	return self.isReadyFlag == true
end

function BossServiceClient.StepVisuals(self: BossServiceClient, dtRaw: any)
	local dt = BossServiceUtils.sanitizeNumber(dtRaw, 1 / 60, 0, 1)
	for runtimeId, visual in self.visualsById do
		local snapshot = self.state.byId[runtimeId]
		if snapshot == nil then
			self:destroyVisual(runtimeId)
			continue
		end

		local ensuredVisual = self:ensureVisual(snapshot)
		if
			ensuredVisual ~= nil
			and ensuredVisual.presentationRuntime ~= nil
			and ensuredVisual.presentationModule ~= nil
		then
			ensuredVisual.presentationModule.step(ensuredVisual.presentationRuntime, dt)
		end
	end
end

function BossServiceClient.Init(self: BossServiceClient)
	self.localPlayer = Players.LocalPlayer
	self.networker = Networker.client.new("BossService", self)
	self.janitor = Janitor.new()
	self.stateChanged = Signal.new()
	self.announcementReceived = Signal.new()
	self.state = BossServiceUtils.createDefaultState()
	self.visualsById = {}
	self.isReadyFlag = false

	local cameraShakerOk, cameraShakerOrError = pcall(function()
		local cameraShaker = CameraShaker.new(CAMERA_SHAKE_RENDER_PRIORITY, function(shakeCFrame: CFrame)
			local camera = Workspace.CurrentCamera
			if camera ~= nil then
				camera.CFrame = camera.CFrame * shakeCFrame
			end
		end) :: any
		return cameraShaker :: CameraShakerObject
	end)
	if cameraShakerOk then
		self.cameraShaker = cameraShakerOrError :: CameraShakerObject
		pcall(function()
			(self.cameraShaker :: CameraShakerObject):Start()
		end)
	else
		self.cameraShaker = nil
	end

	self.janitor:GiveChore(RunService.RenderStepped:Connect(function(dt: number)
		self:stepVisuals(dt)
	end))
	self.janitor:GiveChore(function()
		for runtimeId in self.visualsById do
			self:destroyVisual(runtimeId)
		end
	end)
	self.janitor:GiveChore(function()
		if self.cameraShaker ~= nil then
			pcall(function()
				(self.cameraShaker :: CameraShakerObject):Stop()
			end)
			self.cameraShaker = nil
		end
	end)
	self.janitor:GiveChore(function()
		self.stateChanged:Destroy()
	end)
	self.janitor:GiveChore(function()
		self.announcementReceived:Destroy()
	end)
	self.janitor:GiveChore(function()
		self.networker:destroy()
	end)

	self:requestSync()
end

function BossServiceClient.Destroy(self: BossServiceClient)
	if self.janitor ~= nil then
		self.janitor:Destroy()
	end
end

BossServiceClient.resolvePresentationModule = BossServiceClient.ResolvePresentationModule
BossServiceClient.resolveRuntimeModel = BossServiceClient.ResolveRuntimeModel
BossServiceClient.destroyVisual = BossServiceClient.DestroyVisual
BossServiceClient.ensureVisual = BossServiceClient.EnsureVisual
BossServiceClient.pushStateChanged = BossServiceClient.PushStateChanged
BossServiceClient.applyState = BossServiceClient.ApplyState
BossServiceClient.upsertSnapshot = BossServiceClient.UpsertSnapshot
BossServiceClient.onBossAdded = BossServiceClient.OnBossAdded
BossServiceClient.onBossUpdated = BossServiceClient.OnBossUpdated
BossServiceClient.onBossRemoved = BossServiceClient.OnBossRemoved
BossServiceClient.onAnnouncement = BossServiceClient.OnAnnouncement
BossServiceClient.requestSync = BossServiceClient.RequestSync
BossServiceClient.requestManualSummon = BossServiceClient.RequestManualSummon
BossServiceClient.getState = BossServiceClient.GetState
BossServiceClient.isReady = BossServiceClient.IsReady
BossServiceClient.stepVisuals = BossServiceClient.StepVisuals
BossServiceClient.init = BossServiceClient.Init
BossServiceClient.destroy = BossServiceClient.Destroy

type BossServiceClient = typeof(BossServiceClient) & {
	localPlayer: Player,
	networker: Networker.Client,
	janitor: JanitorClass,
	stateChanged: SignalObject,
	announcementReceived: SignalObject,
	state: BossServiceState,
	visualsById: { [string]: BossVisualRuntime },
	cameraShaker: CameraShakerObject?,
	isReadyFlag: boolean,
}

return BossServiceClient :: BossServiceClient
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="736">
              <Properties>
                <string name="Name">BreathServiceClient</string>
                <string name="Source"><![CDATA[--!strict

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local BreathServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.BreathServiceUtils)
local Janitor = require(ReplicatedStorage.Packages.Janitor)
local Networker = require(script:FindFirstAncestor("game").Shared.Modules.Networking.Networker)
local Signal = require(ReplicatedStorage.Packages.Signal)

type BreathServiceState = BreathServiceUtils.BreathServiceState

type SignalObject = {
	Connect: (self: SignalObject, callback: (...any) -> ()) -> RBXScriptConnection,
	Fire: (self: SignalObject, ...any) -> (),
	Destroy: (self: SignalObject) -> (),
}

type JanitorClass = {
	GiveChore: (self: JanitorClass, chore: any, ...any) -> (),
	Destroy: (self: JanitorClass) -> (),
}

local BreathServiceClient = {}

function BreathServiceClient:EnsureEffects()
	if self.colorCorrection == nil or self.colorCorrection.Parent == nil then
		local effect = Instance.new("ColorCorrectionEffect")
		effect.Name = "BreathService_UnderwaterColor"
		effect.Enabled = false
		effect.Parent = Lighting
		self.colorCorrection = effect
	end
	if self.blur == nil or self.blur.Parent == nil then
		local effect = Instance.new("BlurEffect")
		effect.Name = "BreathService_UnderwaterBlur"
		effect.Enabled = false
		effect.Size = 0
		effect.Parent = Lighting
		self.blur = effect
	end
end

function BreathServiceClient:ApplyFeedback()
	self:ensureEffects()
	local state = self.state
	local correction = self.colorCorrection
	local blur = self.blur
	if correction == nil or blur == nil then
		return
	end

	local breathAlpha = 1 - math.clamp(state.breath / math.max(1, state.maxBreath), 0, 1)
	local underwaterAlpha = if state.isUnderwater then math.max(state.submersionRatio, 0.35) else 0
	local drowningBoost = if state.isDrowning then 0.4 else 0
	local pulse = self.eventPulse
	local strength = math.clamp(underwaterAlpha * 0.7 + breathAlpha * 0.35 + drowningBoost + pulse, 0, 1)

	local enabled = strength > 0.01
	correction.Enabled = enabled
	blur.Enabled = enabled
	if not enabled then
		blur.Size = 0
		return
	end

	correction.TintColor = Color3.fromRGB(
		math.floor(255 - 78 * strength),
		math.floor(255 - 36 * strength),
		math.floor(255 - 12 * strength)
	)
	correction.Brightness = -0.03 * strength
	correction.Contrast = 0.08 * strength
	correction.Saturation = -0.12 * strength
	blur.Size = 5 * strength + if state.isDrowning then 4 else 0
end

function BreathServiceClient:OnRenderStep(deltaTime: number)
	if self.eventPulse > 0 then
		self.eventPulse = math.max(0, self.eventPulse - deltaTime * 2.4)
	end
	self:applyFeedback()
end

function BreathServiceClient:ApplyState(stateRaw: any)
	self.state = BreathServiceUtils.createState(stateRaw, self.state)
	self.stateChanged:Fire(BreathServiceUtils.cloneState(self.state))
end

function BreathServiceClient:OnEvent(payloadRaw: any)
	if typeof(payloadRaw) ~= "table" then
		return
	end
	local payload = payloadRaw :: { [string]: any }
	if payload.eventType == BreathServiceUtils.EVENT_BREATH_DEPLETED then
		self.eventPulse = math.max(self.eventPulse, 0.55)
	end
	self.eventReceived:Fire(payload)
end

function BreathServiceClient:RequestSync()
	self.networker:fire(BreathServiceUtils.NETWORK_METHOD_REQUEST_SYNC)
end

function BreathServiceClient:GetState(): BreathServiceState
	return BreathServiceUtils.cloneState(self.state)
end

function BreathServiceClient:IsReady(): boolean
	return self.state.ready == true
end

function BreathServiceClient:Init()
	self.localPlayer = Players.LocalPlayer
	self.networker = Networker.client.new("BreathService", self)
	self.janitor = Janitor.new()
	self.state = BreathServiceUtils.createDefaultState()
	self.stateChanged = Signal.new()
	self.eventReceived = Signal.new()
	self.eventPulse = 0
	self.colorCorrection = nil :: ColorCorrectionEffect?
	self.blur = nil :: BlurEffect?

	self.janitor:GiveChore(function()
		self.networker:destroy()
	end)
	self.janitor:GiveChore(function()
		self.stateChanged:Destroy()
		self.eventReceived:Destroy()
	end)
	self.janitor:GiveChore(RunService.RenderStepped:Connect(function(deltaTime: number)
		self:onRenderStep(deltaTime)
	end))
	self.janitor:GiveChore(function()
		if self.colorCorrection ~= nil and self.colorCorrection.Parent ~= nil then
			self.colorCorrection:Destroy()
		end
		if self.blur ~= nil and self.blur.Parent ~= nil then
			self.blur:Destroy()
		end
	end)

	self:requestSync()
end

function BreathServiceClient:Destroy()
	if self.janitor ~= nil then
		self.janitor:Destroy()
	end
end

BreathServiceClient.ensureEffects = BreathServiceClient.EnsureEffects
BreathServiceClient.applyFeedback = BreathServiceClient.ApplyFeedback
BreathServiceClient.onRenderStep = BreathServiceClient.OnRenderStep
BreathServiceClient.applyState = BreathServiceClient.ApplyState
BreathServiceClient.onEvent = BreathServiceClient.OnEvent
BreathServiceClient.requestSync = BreathServiceClient.RequestSync
BreathServiceClient.getState = BreathServiceClient.GetState
BreathServiceClient.isReady = BreathServiceClient.IsReady
BreathServiceClient.init = BreathServiceClient.Init
BreathServiceClient.destroy = BreathServiceClient.Destroy

type BreathServiceClient = typeof(BreathServiceClient) & {
	localPlayer: Player,
	networker: Networker.Client,
	janitor: JanitorClass,
	state: BreathServiceState,
	stateChanged: SignalObject,
	eventReceived: SignalObject,
	eventPulse: number,
	colorCorrection: ColorCorrectionEffect?,
	blur: BlurEffect?,
	getState: (self: BreathServiceClient) -> BreathServiceState,
	isReady: (self: BreathServiceClient) -> boolean,
}

return BreathServiceClient :: BreathServiceClient
]]></string>
