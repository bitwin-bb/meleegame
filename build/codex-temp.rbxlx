              <Item class="ModuleScript" referent="1038">
                <Properties>
                  <string name="Name">SpawnServer</string>
                  <string name="Source"><![CDATA[--!strict
local gameRoot = script:FindFirstAncestor("game")
assert(gameRoot ~= nil, "Missing Nevermore game root for SpawnServer.")

local BossServiceServer = require(gameRoot.Server.Services.BossServiceServer)
local BossServiceUtils = require(gameRoot.Shared.Services.BossServiceUtils)
local NpcServiceServer = require(gameRoot.Server.Services.NpcServiceServer)

type EntityEntry = {
	Id: string,
	Kind: string,
	Name: string,
}

local function joinParts(parts: { string }): string
	return table.concat(parts, ", ")
end

local function formatReason(reasonRaw: any): string
	if typeof(reasonRaw) ~= "string" or reasonRaw == "" then
		return "unknown reason"
	end
	return string.lower(string.gsub(reasonRaw, "_", " "))
end

local function spawnBossForPlayer(entity: EntityEntry, player: Player, spawnIndex: number): (boolean, string?)
	local rootPart = BossServiceUtils.resolveCharacterRootPart(player)
	if rootPart == nil then
		return false, "missing_character"
	end

	local boss, reason = BossServiceServer:spawnBoss({
		bossId = entity.Id,
		targetPlayer = player,
		spawnSource = "DebugCommand",
		encounterChannel = BossServiceServer:createUniqueDebugEncounterChannel(entity.Id, player, spawnIndex),
		spawnPosition = rootPart.Position + Vector3.new(0, 18, 0),
		planeX = rootPart.Position.X,
	})
	if boss == nil then
		return false, reason
	end

	return true, nil
end

local function spawnNpcForPlayer(entity: EntityEntry, player: Player, spawnIndex: number): (boolean, string?)
	local runtime, reason = NpcServiceServer:spawnDebugNpcById(entity.Id, player, spawnIndex)
	if runtime == nil then
		return false, reason
	end

	return true, nil
end

return function(_context, entity: EntityEntry, players: { Player }, amountRaw: number)
	local amount = math.max(1, math.floor(amountRaw))
	local spawned = {}
	local failed = {}

	for _, player in players do
		local spawnedCount = 0

		for spawnIndex = 1, amount do
			local ok = false
			local reason = nil :: string?

			if entity.Kind == "Boss" then
				ok, reason = spawnBossForPlayer(entity, player, spawnIndex)
			elseif entity.Kind == "Npc" then
				ok, reason = spawnNpcForPlayer(entity, player, spawnIndex)
			else
				reason = "unsupported_entity_kind"
			end

			if ok then
				spawnedCount += 1
			else
				failed[#failed + 1] = `{player.Name} ({formatReason(reason)})`
			end
		end

		if spawnedCount > 0 then
			spawned[#spawned + 1] = `{player.Name} x{spawnedCount}`
		end
	end

	local responseParts = {}
	if #spawned > 0 then
		responseParts[#responseParts + 1] = `Spawned {entity.Name} for {joinParts(spawned)}.`
	end
	if #failed > 0 then
		responseParts[#responseParts + 1] = `Failed for {joinParts(failed)}.`
	end

	return table.concat(responseParts, " ")
end
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="1039">
                <Properties>
                  <string name="Name">TimeServer</string>
                  <string name="Source"><![CDATA[--!strict
local gameRoot = script:FindFirstAncestor("game")
assert(gameRoot ~= nil, "Missing Nevermore game root for TimeServer.")

local WeatherServiceServer = require(gameRoot.Server.Services.WeatherServiceServer)

local TIME_PRESETS = {
	day = 8.5,
	dawn = 5.5,
	dusk = 18.5,
	midnight = 0,
	night = 22,
	noon = 12,
}

local function trim(valueRaw: any): string
	if typeof(valueRaw) ~= "string" then
		return ""
	end
	return string.match(valueRaw, "^%s*(.-)%s*$") or ""
end

local function normalizeToken(valueRaw: any): string
	return string.lower(string.gsub(trim(valueRaw), "[%s_%-%.]", ""))
end

local function parseBooleanToken(valueRaw: any): boolean?
	local token = normalizeToken(valueRaw)
	if token == "on" or token == "true" or token == "yes" or token == "enable" or token == "enabled" then
		return true
	end
	if token == "off" or token == "false" or token == "no" or token == "disable" or token == "disabled" then
		return false
	end
	return nil
end

local function parseTimeValue(valueRaw: any): (number?, string?)
	local rawText = trim(valueRaw)
	if rawText == "" then
		return nil, nil
	end

	local presetToken = normalizeToken(rawText)
	local presetClockTime = TIME_PRESETS[presetToken]
	if presetClockTime ~= nil then
		return presetClockTime, presetToken
	end

	local numericClockTime = tonumber(rawText)
	if numericClockTime ~= nil and numericClockTime == numericClockTime then
		return numericClockTime, nil
	end

	return nil, nil
end

local function formatClockTime(clockTimeRaw: number): string
	local clockTime = clockTimeRaw % 24
	if clockTime < 0 then
		clockTime += 24
	end

	local hours = math.floor(clockTime)
	local minutes = math.floor((clockTime - hours) * 60 + 0.5)
	if minutes >= 60 then
		minutes -= 60
		hours = (hours + 1) % 24
	end

	return string.format("%02d:%02d", hours, minutes)
end

return function(_context, actionRaw: string, valueRaw: string)
	local action = normalizeToken(actionRaw)

	if action == "set" then
		local clockTime, preset = parseTimeValue(valueRaw)
		if clockTime == nil then
			return "Use a preset like day/night/dawn/dusk/noon/midnight or a numeric hour from 0 to 24."
		end

		WeatherServiceServer:setDayNightCycleEnabled(false, true)
		local appliedClockTime = WeatherServiceServer:setClockTime(clockTime, true)
		if preset ~= nil then
			return `Set time to {preset} ({formatClockTime(appliedClockTime)}) and paused the day/night cycle.`
		end
		return `Set time to {formatClockTime(appliedClockTime)} and paused the day/night cycle.`
	end

	if action == "cycle" then
		local enabled = parseBooleanToken(valueRaw)
		if enabled == nil then
			return "Use `time cycle on` or `time cycle off`."
		end

		WeatherServiceServer:setDayNightCycleEnabled(enabled, true)
		if enabled then
			return "Enabled the day/night cycle."
		end
		return "Disabled the day/night cycle."
	end

	return "Use `time set <preset|hour>` or `time cycle <on|off>`."
end
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="1040">
                <Properties>
                  <string name="Name">UnflyServer</string>
                  <string name="Source"><![CDATA[--!strict
local gameRoot = script:FindFirstAncestor("game")
assert(gameRoot ~= nil, "Missing Nevermore game root for UnflyServer.")

local CmdrUtils = require(gameRoot.Shared.Cmdr.CmdrUtils)

local function setFlyEnabled(player: Player, enabledRaw: any)
	local enabled = enabledRaw == true

	player:SetAttribute(CmdrUtils.FLY_ENABLED_ATTRIBUTE, enabled)
	if enabled then
		player:SetAttribute(CmdrUtils.FLY_SPEED_ATTRIBUTE, CmdrUtils.DEFAULT_FLY_SPEED)
	else
		player:SetAttribute(CmdrUtils.FLY_SPEED_ATTRIBUTE, nil)
	end
end

return function(_context, players: { Player })
	local updated = {}

	for index, player in players do
		setFlyEnabled(player, false)
		updated[index] = player.Name
	end

	return `Disabled fly for {table.concat(updated, ", ")}.`
end
