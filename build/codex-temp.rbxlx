                <Item class="Folder" referent="939">
                  <Properties>
                    <string name="Name">state</string>
                  </Properties>
                  <Item class="ModuleScript" referent="940">
                    <Properties>
                      <string name="Name">itemSlice</string>
                      <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Sift = require(ReplicatedStorage.Packages.Sift)

local Charm = require(ReplicatedStorage.Packages.Charm)
local InventoryServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.InventoryServiceUtils)

type InventoryItemStack = InventoryServiceUtils.InventoryItemStack

export type ItemDragMode = "Move" | "SplitHold"
export type ItemDragBeginOptions = {
	mode: ItemDragMode?,
	dragAmount: number?,
	sourceStackAmount: number?,
}

export type ItemDragState = {
	active: boolean,
	sourceSlot: number?,
	hoveredSlot: number?,
	stack: InventoryItemStack?,
	itemType: string?,
	icon: string?,
	pointerPosition: Vector2,
	mode: ItemDragMode,
	sourceStackAmount: number?,
	updatedAt: number,
}

export type ItemDragDebugState = {
	enabled: boolean,
	lines: { string },
	updatedAt: number,
}

local MAX_DEBUG_LINES = 12

local function sanitizeSlot(slotRaw: any): number?
	if typeof(slotRaw) ~= "number" or slotRaw ~= slotRaw then
		return nil
	end

	local slot = math.floor(slotRaw)
	if slot <= 0 then
		return nil
	end
	return slot
end

local function sanitizeVector2(valueRaw: any): Vector2
	if typeof(valueRaw) == "Vector3" then
		local value3 = valueRaw :: Vector3
		if value3.X ~= value3.X or value3.Y ~= value3.Y then
			return Vector2.zero
		end
		return Vector2.new(value3.X, value3.Y)
	end
	if typeof(valueRaw) ~= "Vector2" then
		return Vector2.zero
	end
	if valueRaw.X ~= valueRaw.X or valueRaw.Y ~= valueRaw.Y then
		return Vector2.zero
	end
	return valueRaw
end

local function sanitizeText(valueRaw: any): string?
	if typeof(valueRaw) ~= "string" then
		return nil
	end
	local value = string.match(valueRaw, "^%s*(.-)%s*$")
	if value == nil or value == "" then
		return nil
	end
	return value
end

local function sanitizeDragMode(valueRaw: any): ItemDragMode
	if valueRaw == "SplitHold" then
		return "SplitHold"
	end
	return "Move"
end

local function sanitizePositiveInteger(valueRaw: any, fallback: number, minimum: number, maximum: number?): number
	if typeof(valueRaw) ~= "number" or valueRaw ~= valueRaw then
		return fallback
	end

	local value = math.floor(valueRaw)
	if value < minimum then
		value = minimum
	end
	if maximum ~= nil and value > maximum then
		value = maximum
	end
	return value
end

local function cloneStack(stackRaw: any): InventoryItemStack?
	if typeof(stackRaw) ~= "table" then
		return nil
	end

	local stack = stackRaw :: { [string]: any }
	if typeof(stack.stackId) ~= "string" or typeof(stack.itemId) ~= "string" then
		return nil
	end

	local amount = if typeof(stack.amount) == "number" and stack.amount == stack.amount then math.max(0, stack.amount) else 0
	local maxStack = if typeof(stack.maxStack) == "number" and stack.maxStack == stack.maxStack
		then math.max(1, stack.maxStack)
		else 1

	return {
		stackId = stack.stackId,
		itemId = stack.itemId,
		amount = amount,
		maxStack = maxStack,
		metadata = InventoryServiceUtils.cloneDeep(stack.metadata),
	}
end

local function createDefaultDragState(): ItemDragState
	return {
		active = false,
		sourceSlot = nil,
		hoveredSlot = nil,
		stack = nil,
		itemType = nil,
		icon = nil,
		pointerPosition = Vector2.zero,
		mode = "Move",
		sourceStackAmount = nil,
		updatedAt = os.clock(),
	}
end

local dragStateAtom: Charm.Atom<ItemDragState> = Charm.atom(createDefaultDragState())
local dragDebugStateAtom: Charm.Atom<ItemDragDebugState> = Charm.atom({
	enabled = true,
	lines = {},
	updatedAt = os.clock(),
})

local function getDragState(): ItemDragState
	return dragStateAtom()
end

local function beginDrag(
	sourceSlotRaw: any,
	stackRaw: any,
	pointerPositionRaw: any,
	itemTypeRaw: any,
	iconRaw: any,
	optionsRaw: any?
): ItemDragState
	local sourceSlot = sanitizeSlot(sourceSlotRaw)
	local stack = cloneStack(stackRaw)
	if sourceSlot == nil or stack == nil then
		return dragStateAtom()
	end

	local options = if typeof(optionsRaw) == "table" then (optionsRaw :: ItemDragBeginOptions) else nil
	local mode = sanitizeDragMode(if options ~= nil then options.mode else nil)
	local sourceStackAmount = nil :: number?
	if mode == "SplitHold" then
		sourceStackAmount = sanitizePositiveInteger(
			if options ~= nil then options.sourceStackAmount else nil,
			stack.amount,
			1,
			math.max(1, stack.maxStack)
		)
	end
	local maxDragAmount = if sourceStackAmount ~= nil then sourceStackAmount else stack.amount
	local dragAmount = sanitizePositiveInteger(if options ~= nil then options.dragAmount else nil, stack.amount, 1, maxDragAmount)
	stack.amount = dragAmount

	local nextState: ItemDragState = {
		active = true,
		sourceSlot = sourceSlot,
		hoveredSlot = sourceSlot,
		stack = stack,
		itemType = sanitizeText(itemTypeRaw),
		icon = sanitizeText(iconRaw),
		pointerPosition = sanitizeVector2(pointerPositionRaw),
		mode = mode,
		sourceStackAmount = sourceStackAmount,
		updatedAt = os.clock(),
	}
	dragStateAtom(nextState)
	return nextState
end

local function setPointerPosition(pointerPositionRaw: any): ItemDragState
	local state = dragStateAtom()
	if not state.active then
		return state
	end

	local pointerPosition = sanitizeVector2(pointerPositionRaw)
	if pointerPosition == state.pointerPosition then
		return state
	end

	local nextState: ItemDragState = {
		active = state.active,
		sourceSlot = state.sourceSlot,
		hoveredSlot = state.hoveredSlot,
		stack = state.stack,
		itemType = state.itemType,
		icon = state.icon,
		pointerPosition = pointerPosition,
		mode = state.mode,
		sourceStackAmount = state.sourceStackAmount,
		updatedAt = os.clock(),
	}
	dragStateAtom(nextState)
	return nextState
end

local function setStackAmount(amountRaw: any): ItemDragState
	local state = dragStateAtom()
	if not state.active or state.stack == nil then
		return state
	end

	local stack = state.stack
	local maxAmount = math.max(1, stack.amount)
	if state.sourceStackAmount ~= nil then
		maxAmount = math.max(1, state.sourceStackAmount)
	end
	local nextAmount = sanitizePositiveInteger(amountRaw, stack.amount, 1, maxAmount)
	if nextAmount == stack.amount then
		return state
	end

	local nextStack = cloneStack(stack)
	if nextStack == nil then
		return state
	end
	nextStack.amount = nextAmount

	local nextState: ItemDragState = {
		active = state.active,
		sourceSlot = state.sourceSlot,
		hoveredSlot = state.hoveredSlot,
		stack = nextStack,
		itemType = state.itemType,
		icon = state.icon,
		pointerPosition = state.pointerPosition,
		mode = state.mode,
		sourceStackAmount = state.sourceStackAmount,
		updatedAt = os.clock(),
	}
	dragStateAtom(nextState)
	return nextState
end

local function setHoveredSlot(slotRaw: any): ItemDragState
	local state = dragStateAtom()
	if not state.active then
		return state
	end

	local hoveredSlot = sanitizeSlot(slotRaw)
	if hoveredSlot == state.hoveredSlot then
		return state
	end

	local nextState: ItemDragState = {
		active = state.active,
		sourceSlot = state.sourceSlot,
		hoveredSlot = hoveredSlot,
		stack = state.stack,
		itemType = state.itemType,
		icon = state.icon,
		pointerPosition = state.pointerPosition,
		mode = state.mode,
		sourceStackAmount = state.sourceStackAmount,
		updatedAt = os.clock(),
	}
	dragStateAtom(nextState)
	return nextState
end

local function clearDragState(): ItemDragState
	local nextState = createDefaultDragState()
	dragStateAtom(nextState)
	return nextState
end

local function getDragDebugState(): ItemDragDebugState
	return dragDebugStateAtom()
end

local function setDragDebugEnabled(enabledRaw: any): ItemDragDebugState
	local current = dragDebugStateAtom()
	local enabled = enabledRaw == true
	if current.enabled == enabled then
		return current
	end

	local nextState: ItemDragDebugState = {
		enabled = enabled,
		lines = current.lines,
		updatedAt = os.clock(),
	}
	dragDebugStateAtom(nextState)
	return nextState
end

local function clearDragDebug(): ItemDragDebugState
	local current = dragDebugStateAtom()
	local nextState: ItemDragDebugState = {
		enabled = current.enabled,
		lines = {},
		updatedAt = os.clock(),
	}
	dragDebugStateAtom(nextState)
	return nextState
end

local function pushDragDebug(messageRaw: any): ItemDragDebugState
	local current = dragDebugStateAtom()
	if not current.enabled then
		return current
	end

	local message = if typeof(messageRaw) == "string"
		then string.match(messageRaw, "^%s*(.-)%s*$") or ""
		else tostring(messageRaw)
	if message == "" then
		return current
	end

	local timestamp = os.clock()
	local prefix = ("[%0.3f] "):format(timestamp)
	local lines = Sift.Array.append(Sift.Array.copy(current.lines), prefix .. message)
	if #lines > MAX_DEBUG_LINES then
		lines = Sift.Array.removeIndex(lines, 1)
	end

	local nextState: ItemDragDebugState = {
		enabled = current.enabled,
		lines = lines,
		updatedAt = timestamp,
	}
	dragDebugStateAtom(nextState)
	return nextState
end

return {
	dragStateAtom = dragStateAtom,
	dragDebugStateAtom = dragDebugStateAtom,
	createDefaultDragState = createDefaultDragState,
	getDragState = getDragState,
	getDragDebugState = getDragDebugState,
	beginDrag = beginDrag,
	setPointerPosition = setPointerPosition,
	setStackAmount = setStackAmount,
	setHoveredSlot = setHoveredSlot,
	setDragDebugEnabled = setDragDebugEnabled,
	clearDragDebug = clearDragDebug,
	pushDragDebug = pushDragDebug,
	clearDragState = clearDragState,
}
]]></string>
                    </Properties>
                  </Item>
                  <Item class="ModuleScript" referent="941">
                    <Properties>
                      <string name="Name">itemThunks</string>
                      <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Sift = require(ReplicatedStorage.Packages.Sift)

local ImageIds = require(script:FindFirstAncestor("game").Client.UI.core.ImageIds)
local InventoryServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.InventoryServiceUtils)
local ItemRegistry = require(script:FindFirstAncestor("game").Shared.Modules.Items.Registry)
local inventoryThunks = require(script:FindFirstAncestor("game").Client.UI.hud.state.slice.inventoryThunks)
local itemSlice = require(script:FindFirstAncestor("game").Client.UI.features.item.state.itemSlice)

type InventoryItemStack = InventoryServiceUtils.InventoryItemStack
type ItemDragState = itemSlice.ItemDragState
type ItemDefinition = {
	itemId: string,
	name: string,
	description: string,
	useCase: string?,
	itemType: string?,
	stats: { [string]: any }?,
}

local itemThunks = {}
local cachedItemDefinitions: { [string]: ItemDefinition } = {}

local function joinStrings(values: { string }, delimiter: string): string
	local output = ""
	for index, value in values do
		if index > 1 then
			output ..= delimiter
		end
		output ..= value
	end
	return output
end

local function trim(textRaw: any): string
	if typeof(textRaw) ~= "string" then
		return ""
	end
	return string.match(textRaw, "^%s*(.-)%s*$") or ""
end

local function normalizeTypeKey(valueRaw: any): string?
	local value = string.lower(trim(valueRaw))
	if value == "" then
		return nil
	end
	value = string.gsub(value, "[%s_%-]+", "")
	if value == "" then
		return nil
	end
	return value
end

local function sanitizeText(valueRaw: any, fallback: string?): string?
	local value = trim(valueRaw)
	if value == "" then
		return fallback
	end
	return value
end

local function toTitleCase(textRaw: any): string
	local value = sanitizeText(textRaw, "Item") or "Item"
	value = string.gsub(value, "_", " ")
	value = string.gsub(value, "-", " ")
	value = string.gsub(value, "%s+", " ")
	return string.gsub(value, "(%a)([%w']*)", function(first: string, rest: string)
		return string.upper(first) .. string.lower(rest)
	end)
end

local function resolveItemTypeFromItemId(itemIdRaw: any): string?
	local itemId = normalizeTypeKey(itemIdRaw)
	if itemId == nil then
		return nil
	end

	if string.find(itemId, "sword", 1, true) ~= nil then
		return "sword"
	end
	if string.find(itemId, "pickaxe", 1, true) ~= nil then
		return "pickaxe"
	end
	if string.find(itemId, "axe", 1, true) ~= nil then
		return "axe"
	end
	if string.find(itemId, "hammer", 1, true) ~= nil then
		return "hammer"
	end
	if string.find(itemId, "coin", 1, true) ~= nil then
		return "coin"
	end
	if string.find(itemId, "crystal", 1, true) ~= nil then
		return "consumable"
	end

	return nil
end

local function normalizeItemDefinition(itemId: string, definitionRaw: any): ItemDefinition?
	if typeof(definitionRaw) ~= "table" then
		return nil
	end

	local definition = definitionRaw :: { [string]: any }
	local itemType = normalizeTypeKey(definition.itemType or definition.type)
	if itemType == nil then
		itemType = resolveItemTypeFromItemId(itemId)
	end

	local description = sanitizeText(definition.description, nil)
	if description == nil and definition.value ~= nil then
		description = sanitizeText(tostring(definition.value), nil)
	end

	return {
		itemId = itemId,
		name = toTitleCase(definition.name or itemId),
		description = description or "No description.",
		useCase = sanitizeText(definition.useCase, nil),
		itemType = itemType,
		stats = if typeof(definition.stats) == "table" then definition.stats else nil,
	}
end

local function resolveItemDefinition(itemIdRaw: any): ItemDefinition?
	local itemId = sanitizeText(itemIdRaw, nil)
	if itemId == nil then
		return nil
	end

	local cached = cachedItemDefinitions[itemId]
	if cached ~= nil then
		return cached
	end

	local canonicalItemId = ItemRegistry.resolveCanonicalItemId(itemId)
	local definitionTable = ItemRegistry.resolveDefinition(itemId)
	if canonicalItemId == nil or definitionTable == nil then
		return nil
	end

	local normalized = normalizeItemDefinition(canonicalItemId, definitionTable)
	if normalized == nil then
		return nil
	end

	cachedItemDefinitions[itemId] = normalized
	cachedItemDefinitions[canonicalItemId] = normalized
	local altId = sanitizeText((definitionTable :: any).id, nil)
	if altId ~= nil then
		cachedItemDefinitions[altId] = normalized
	end
	return normalized
end

local function resolveItemTypeFromStack(stackRaw: any): string?
	if typeof(stackRaw) ~= "table" then
		return nil
	end

	local stack = stackRaw :: { [string]: any }
	local metadata = if typeof(stack.metadata) == "table" then stack.metadata :: { [string]: any } else nil
	if metadata ~= nil then
		local typedFromMetadata = normalizeTypeKey(metadata.itemType or metadata.itemtype or metadata.type)
		if typedFromMetadata ~= nil then
			return typedFromMetadata
		end
	end

	local definition = resolveItemDefinition(stack.itemId)
	if definition ~= nil and definition.itemType ~= nil then
		return definition.itemType
	end

	return resolveItemTypeFromItemId(stack.itemId)
end

local function formatStats(statsRaw: any): string
	if typeof(statsRaw) ~= "table" then
		return ""
	end

	local stats = statsRaw :: { [string]: any }
	local lines = {}
	for key, value in stats do
		local label = toTitleCase(key)
		local textValue = sanitizeText(tostring(value), "")
		if textValue ~= nil and textValue ~= "" then
			lines = Sift.Array.append(lines, ("%s: %s"):format(label, textValue))
		end
	end
	lines = Sift.Array.sort(lines)
	return joinStrings(lines, "\n")
end

local function resolveStackAmount(stackRaw: any): number
	if typeof(stackRaw) ~= "table" then
		return 0
	end
	local amountRaw = (stackRaw :: any).amount
	if typeof(amountRaw) ~= "number" or amountRaw ~= amountRaw then
		return 0
	end
	return math.max(0, math.floor(amountRaw))
end

local function resolveRequestedDragAmount(state: ItemDragState, amountRaw: any): any
	if amountRaw ~= nil then
		return amountRaw
	end
	if state.stack == nil then
		return nil
	end
	return state.stack.amount
end

function itemThunks.ResolveItemIconByType(itemTypeRaw: any, itemIdRaw: any?): string?
	local normalizedType = normalizeTypeKey(itemTypeRaw)
	local normalizedItemId = normalizeTypeKey(itemIdRaw)
	local itemIcons = if typeof(ImageIds.itemIcons) == "table" then ImageIds.itemIcons :: { [string]: any } else nil

	if itemIcons ~= nil and normalizedItemId ~= nil then
		local byItemId = itemIcons[normalizedItemId]
		if typeof(byItemId) == "string" and byItemId ~= "" then
			return byItemId
		end

		for key, value in itemIcons do
			if normalizeTypeKey(key) == normalizedItemId and typeof(value) == "string" and value ~= "" then
				return value
			end
		end
	end

	if itemIcons ~= nil and normalizedType ~= nil then
		local icon = itemIcons[normalizedType]
		if typeof(icon) == "string" and icon ~= "" then
			return icon
		end
	end

	if itemIcons ~= nil then
		local fallback = itemIcons.default
		if typeof(fallback) == "string" and fallback ~= "" then
			return fallback
		end
	end

	local questionMark = ImageIds.questionMark
	if typeof(questionMark) == "string" and questionMark ~= "" then
		return questionMark
	end

	return nil
end

function itemThunks.ResolveIconForStack(stackRaw: any): string?
	local itemId = if typeof(stackRaw) == "table" then (stackRaw :: { [string]: any }).itemId else nil
	local itemType = resolveItemTypeFromStack(stackRaw)
	return itemThunks.ResolveItemIconByType(itemType, itemId)
end

function itemThunks.ResolveDisplayNameForStack(stackRaw: any): string
	if typeof(stackRaw) ~= "table" then
		return "Item"
	end

	local stack = stackRaw :: { [string]: any }
	local definition = resolveItemDefinition(stack.itemId)
	if definition ~= nil then
		return definition.name
	end
	return toTitleCase(stack.itemId)
end

function itemThunks.ResolveHoverTextForStack(stackRaw: any, slotIndexRaw: any): string
	if typeof(stackRaw) ~= "table" then
		local slotIndex = if typeof(slotIndexRaw) == "number" and slotIndexRaw == slotIndexRaw
			then math.floor(slotIndexRaw)
			else 0
		return ("Slot %d\nEmpty"):format(slotIndex)
	end

	local stack = stackRaw :: { [string]: any }
	local definition = resolveItemDefinition(stack.itemId)
	local name = if definition ~= nil then definition.name else toTitleCase(stack.itemId)
	local amount = if typeof(stack.amount) == "number" and stack.amount == stack.amount
		then math.max(0, stack.amount)
		else 0
	local useCase = if definition ~= nil then definition.useCase else nil
	local description = if definition ~= nil then definition.description else nil
	local statsText = if definition ~= nil then formatStats(definition.stats) else ""

	local lines = { name, ("Amount: %d"):format(amount) }
	if useCase ~= nil and useCase ~= "" then
		lines = Sift.Array.append(lines, ("Use: %s"):format(useCase))
	end
	if description ~= nil and description ~= "" then
		lines = Sift.Array.append(lines, "")
		lines = Sift.Array.append(lines, description)
	end
	if statsText ~= "" then
		lines = Sift.Array.append(lines, "")
		lines = Sift.Array.append(lines, statsText)
	end
	return joinStrings(lines, "\n")
end

function itemThunks.BeginDrag(slotIndexRaw: any, stackRaw: any, pointerPositionRaw: any): ItemDragState
	local itemId = if typeof(stackRaw) == "table" then (stackRaw :: { [string]: any }).itemId else nil
	local itemType = resolveItemTypeFromStack(stackRaw)
	local icon = itemThunks.ResolveItemIconByType(itemType, itemId)
	return itemSlice.beginDrag(slotIndexRaw, stackRaw, pointerPositionRaw, itemType, icon)
end

function itemThunks.BeginSplitDrag(
	slotIndexRaw: any,
	stackRaw: any,
	pointerPositionRaw: any,
	amountRaw: any
): ItemDragState
	local itemId = if typeof(stackRaw) == "table" then (stackRaw :: { [string]: any }).itemId else nil
	local itemType = resolveItemTypeFromStack(stackRaw)
	local icon = itemThunks.ResolveItemIconByType(itemType, itemId)
	local sourceStackAmount = resolveStackAmount(stackRaw)
	return itemSlice.beginDrag(slotIndexRaw, stackRaw, pointerPositionRaw, itemType, icon, {
		mode = "SplitHold",
		dragAmount = amountRaw,
		sourceStackAmount = sourceStackAmount,
	})
end

function itemThunks.UpdatePointer(pointerPositionRaw: any): ItemDragState
	return itemSlice.setPointerPosition(pointerPositionRaw)
end

function itemThunks.SetDragStackAmount(amountRaw: any): ItemDragState
	return itemSlice.setStackAmount(amountRaw)
end

function itemThunks.SetHoveredSlot(slotIndexRaw: any): ItemDragState
	return itemSlice.setHoveredSlot(slotIndexRaw)
end

function itemThunks.CancelDrag(): ItemDragState
	return itemSlice.clearDragState()
end

function itemThunks.TrashDrag(amountRaw: any): boolean
	local state = itemSlice.getDragState()
	if not state.active then
		return false
	end

	local sourceSlot = state.sourceSlot
	if sourceSlot == nil then
		itemSlice.clearDragState()
		return false
	end

	local requestedAmount = resolveRequestedDragAmount(state, amountRaw)
	local didRequest = inventoryThunks.trashSlot(sourceSlot, requestedAmount)
	itemSlice.clearDragState()
	return didRequest
end

function itemThunks.DropDrag(amountRaw: any): boolean
	local state = itemSlice.getDragState()
	if not state.active then
		return false
	end

	local sourceSlot = state.sourceSlot
	if sourceSlot == nil then
		itemSlice.clearDragState()
		return false
	end

	local requestedAmount = resolveRequestedDragAmount(state, amountRaw)
	local didRequest = inventoryThunks.dropFromSlot(sourceSlot, requestedAmount)
	if didRequest then
		itemSlice.clearDragState()
	end
	return didRequest
end

function itemThunks.EndDrag(targetSlotRaw: any): boolean
	local state = itemSlice.getDragState()
	if not state.active then
		return false
	end

	local sourceSlot = state.sourceSlot
	local targetSlot = if typeof(targetSlotRaw) == "number" and targetSlotRaw == targetSlotRaw
		then math.floor(targetSlotRaw)
		else nil
	local dragAmount = if state.stack ~= nil then state.stack.amount else nil
	local didMove = false
	if sourceSlot ~= nil and targetSlot ~= nil and sourceSlot ~= targetSlot then
		local requestedAmount = if state.mode == "SplitHold" then dragAmount else nil
		didMove = inventoryThunks.moveSlot(sourceSlot, targetSlot, requestedAmount)
	end

	itemSlice.clearDragState()
	return didMove
end

itemThunks.resolveItemIconByType = itemThunks.ResolveItemIconByType
itemThunks.resolveIconForStack = itemThunks.ResolveIconForStack
itemThunks.resolveDisplayNameForStack = itemThunks.ResolveDisplayNameForStack
itemThunks.resolveHoverTextForStack = itemThunks.ResolveHoverTextForStack
itemThunks.beginDrag = itemThunks.BeginDrag
itemThunks.beginSplitDrag = itemThunks.BeginSplitDrag
itemThunks.updatePointer = itemThunks.UpdatePointer
itemThunks.setDragStackAmount = itemThunks.SetDragStackAmount
itemThunks.setHoveredSlot = itemThunks.SetHoveredSlot
itemThunks.cancelDrag = itemThunks.CancelDrag
itemThunks.trashDrag = itemThunks.TrashDrag
itemThunks.dropDrag = itemThunks.DropDrag
itemThunks.endDrag = itemThunks.EndDrag

return itemThunks
]]></string>
                    </Properties>
                  </Item>
                </Item>
              </Item>
              <Item class="Folder" referent="942">
