                    <string name="Name">useAsync</string>
                    <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local React = require(ReplicatedStorage.Packages.React)
local useMounted = require(script.Parent.useMounted)
local useStableCallback = require(script.Parent.internal.useStableCallback)

export type AsyncStatus = "idle" | "loading" | "success" | "error"

export type AsyncOptions<TValue> = {
	initialValue: TValue?,
	onSuccess: ((TValue?) -> ())?,
	onError: ((string) -> ())?,
}

export type AsyncResult<TValue> = {
	status: AsyncStatus,
	loading: boolean,
	value: TValue?,
	error: string?,
	execute: (...any) -> number,
	cancel: () -> (),
	reset: () -> (),
}

local function cancelPromise(promiseRaw: any)
	if typeof(promiseRaw) ~= "table" then
		return
	end

	local cancel = (promiseRaw :: any).Cancel
	if typeof(cancel) ~= "function" then
		cancel = (promiseRaw :: any).cancel
	end
	if typeof(cancel) == "function" then
		pcall(function()
			cancel(promiseRaw)
		end)
	end
end

local function attachPromiseHandlers(promiseRaw: any, onResolve: (any) -> (), onReject: (any) -> ())
	if typeof(promiseRaw) ~= "table" then
		return
	end

	local thenMethod = (promiseRaw :: any).Then
	if typeof(thenMethod) ~= "function" then
		thenMethod = (promiseRaw :: any).andThen
	end

	local chainedPromise = promiseRaw
	if typeof(thenMethod) == "function" then
		local ok, result = pcall(function()
			return thenMethod(promiseRaw, onResolve)
		end)
		if ok and result ~= nil then
			chainedPromise = result
		else
			pcall(function()
				thenMethod(onResolve)
			end)
		end
	end

	local catchMethod = (chainedPromise :: any).Catch
	if typeof(catchMethod) ~= "function" then
		catchMethod = (chainedPromise :: any).catch
	end
	if typeof(catchMethod) == "function" then
		local ok = pcall(function()
			catchMethod(chainedPromise, onReject)
		end)
		if not ok then
			pcall(function()
				catchMethod(onReject)
			end)
		end
	end
end

local function isPromiseLike(valueRaw: any): boolean
	if typeof(valueRaw) ~= "table" then
		return false
	end
	return typeof((valueRaw :: any).Then) == "function" or typeof((valueRaw :: any).andThen) == "function"
end

local function useAsync<TValue>(callbackRaw: any, options: AsyncOptions<TValue>?): AsyncResult<TValue>
	local callback = useStableCallback(callbackRaw)
	local onSuccess = useStableCallback(if options ~= nil then options.onSuccess else nil)
	local onError = useStableCallback(if options ~= nil then options.onError else nil)
	local mountedRef = useMounted()
	local initialValue = if options ~= nil then options.initialValue else nil
	local requestIdRef = React.useRef(0)
	local activePromiseRef = React.useRef(nil)
	local status, setStatus = React.useState("idle" :: AsyncStatus)
	local loading, setLoading = React.useState(false)
	local value, setValue = React.useState(initialValue)
	local error, setError = React.useState(nil :: string?)

	local cancel = React.useCallback(function()
		requestIdRef.current += 1
		cancelPromise(activePromiseRef.current)
		activePromiseRef.current = nil
		if mountedRef.current then
			setLoading(false)
			setStatus("idle")
		end
	end, { mountedRef })

	local reset = React.useCallback(function()
		cancel()
		if mountedRef.current then
			setValue(initialValue)
			setError(nil)
		end
	end, { cancel, initialValue, mountedRef })

	local execute = React.useCallback(function(...): number
		requestIdRef.current += 1
		local requestId = requestIdRef.current
		cancelPromise(activePromiseRef.current)
		activePromiseRef.current = nil

		if mountedRef.current then
			setLoading(true)
			setStatus("loading")
			setError(nil)
		end

		local ok, result = pcall(callback, ...)
		if not ok then
			if mountedRef.current and requestIdRef.current == requestId then
				local message = tostring(result)
				setLoading(false)
				setStatus("error")
				setError(message)
				onError(message)
			end
			return requestId
		end

		if isPromiseLike(result) then
			activePromiseRef.current = result
			attachPromiseHandlers(result, function(resolvedValue: any)
				if not mountedRef.current or requestIdRef.current ~= requestId then
					return
				end

				activePromiseRef.current = nil
				setLoading(false)
				setStatus("success")
				setValue(resolvedValue)
				setError(nil)
				onSuccess(resolvedValue)
			end, function(rejectedValue: any)
				if not mountedRef.current or requestIdRef.current ~= requestId then
					return
				end

				activePromiseRef.current = nil
				local message = tostring(rejectedValue)
				setLoading(false)
				setStatus("error")
				setError(message)
				onError(message)
			end)
			return requestId
		end

		if mountedRef.current and requestIdRef.current == requestId then
			setLoading(false)
			setStatus("success")
			setValue(result)
			setError(nil)
			onSuccess(result)
		end

		return requestId
	end, { callback, mountedRef, onSuccess, onError })

	React.useEffect(function()
		return function()
			cancel()
		end
	end, { cancel })

	return {
		status = status,
		loading = loading,
		value = value,
		error = error,
		execute = execute,
		cancel = cancel,
		reset = reset,
	}
end

return useAsync
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="791">
                  <Properties>
                    <string name="Name">useBeatMotion</string>
                    <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local React = require(ReplicatedStorage.Packages.React)
local Ripple = require(ReplicatedStorage.Packages.Ripple)

type NumberMotion = Ripple.Motion<number>
type SpringOptions = Ripple.SpringOptions

export type BeatMotionOptions = {
	enabled: boolean?,
	auto: boolean?,
	bpm: number?,
	baseScale: number?,
	primaryScale: number?,
	secondaryScale: number?,
	secondaryDelay: number?,
	recoverDelay: number?,
	spring: SpringOptions?,
}

export type BeatMotionResult = {
	scale: React.Binding<number>,
	beat: () -> (),
}

local DEFAULT_SPRING: SpringOptions = {
	frequency = 1,
	damping = 0.85,
}

local DEFAULT_BPM = 72
local DEFAULT_BASE_SCALE = 1
local DEFAULT_PRIMARY_SCALE = 1.08
local DEFAULT_SECONDARY_SCALE = 1.04
local DEFAULT_SECONDARY_DELAY = 0.11
local DEFAULT_RECOVER_DELAY = 0.24

local function sanitizeNumber(value: any, fallback: number, minimum: number?, maximum: number?): number
	if typeof(value) ~= "number" or value ~= value then
		return fallback
	end

	local nextValue = value
	if minimum ~= nil and nextValue < minimum then
		nextValue = minimum
	end
	if maximum ~= nil and nextValue > maximum then
		nextValue = maximum
	end
	return nextValue
end

local function useBeatMotion(options: BeatMotionOptions?): BeatMotionResult
	local enabled = if options and options.enabled ~= nil then options.enabled else true
	local auto = if options and options.auto ~= nil then options.auto else true
	local bpm = sanitizeNumber(if options then options.bpm else nil, DEFAULT_BPM, 1, 400)
	local baseScale = sanitizeNumber(if options then options.baseScale else nil, DEFAULT_BASE_SCALE, 0.01, 10)
	local primaryScale = sanitizeNumber(if options then options.primaryScale else nil, DEFAULT_PRIMARY_SCALE, 0.01, 10)
	local secondaryScale =
		sanitizeNumber(if options then options.secondaryScale else nil, DEFAULT_SECONDARY_SCALE, 0.01, 10)
	local secondaryDelay =
		sanitizeNumber(if options then options.secondaryDelay else nil, DEFAULT_SECONDARY_DELAY, 0, 5)
	local recoverDelay = sanitizeNumber(if options then options.recoverDelay else nil, DEFAULT_RECOVER_DELAY, 0, 5)
	local spring = if options and options.spring then options.spring else DEFAULT_SPRING

	local scale, setScale = React.useBinding(baseScale)
	local motionRef = React.useRef(nil :: NumberMotion?)
	local aliveRef = React.useRef(true)
	local elapsedRef = React.useRef(0)
	local manualBeatUntilRef = React.useRef(0)

	React.useEffect(function()
		aliveRef.current = true
		local motion = Ripple.createMotion(baseScale)
		motionRef.current = motion
		elapsedRef.current = 0
		manualBeatUntilRef.current = 0
		setScale(baseScale)

		local steppedConnection = RunService.RenderStepped:Connect(function(deltaTime: number)
			local nextTarget = baseScale

			if enabled and auto then
				elapsedRef.current += deltaTime
				local period = 60 / bpm
				local phase = (elapsedRef.current % period) / period

				local pulseA = primaryScale - baseScale
				local pulseB = secondaryScale - baseScale
				local widthA = 0.055
				local widthB = 0.06
				local centerA = 0.12
				local centerB = 0.28

				local influenceA = math.exp(-(((phase - centerA) * (phase - centerA)) / (2 * widthA * widthA)))
				local influenceB = math.exp(-(((phase - centerB) * (phase - centerB)) / (2 * widthB * widthB)))
				nextTarget = baseScale + pulseA * influenceA + pulseB * influenceB
			elseif enabled and manualBeatUntilRef.current > 0 then
				manualBeatUntilRef.current = math.max(0, manualBeatUntilRef.current - deltaTime)
				local alpha = if recoverDelay > 0 then manualBeatUntilRef.current / recoverDelay else 0
				nextTarget = baseScale + (primaryScale - baseScale) * alpha
			end

			motion:spring(nextTarget, spring)
			setScale(motion:step(deltaTime))
		end)

		return function()
			aliveRef.current = false
			steppedConnection:Disconnect()
			motion:destroy()
			motionRef.current = nil
		end
	end, { enabled, auto, bpm, baseScale, primaryScale, secondaryScale, spring })

	React.useEffect(function()
		local motion = motionRef.current
		if not motion then
			return
		end

		motion:immediate(baseScale)
		setScale(baseScale)
	end, { baseScale })

	local beat = React.useCallback(function()
		local motion = motionRef.current
		if not motion or not aliveRef.current then
			return
		end

		manualBeatUntilRef.current = recoverDelay
		motion:spring(primaryScale, spring)
		task.delay(secondaryDelay, function()
			if not aliveRef.current then
				return
			end
			local nextMotion = motionRef.current
			if nextMotion then
				nextMotion:spring(secondaryScale, spring)
			end
		end)
	end, { baseScale, primaryScale, secondaryScale, secondaryDelay, recoverDelay, spring })

	return {
		scale = scale,
		beat = beat,
	}
end

return useBeatMotion
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="792">
                  <Properties>
                    <string name="Name">useClickOutside</string>
                    <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local GuiUtils = require(script.Parent.internal.gui)
local React = require(ReplicatedStorage.Packages.React)
local useStableCallback = require(script.Parent.internal.useStableCallback)

export type RefObject<T> = {
	current: T,
}

export type ClickOutsideOptions = {
	ref: RefObject<GuiObject?>?,
	ignoreRefs: { RefObject<GuiObject?> }?,
	enabled: boolean?,
	inputTypes: { Enum.UserInputType }?,
	onClickOutside: ((InputObject, Vector2) -> ())?,
	onClickInside: ((InputObject, Vector2) -> ())?,
}

export type ClickOutsideResult = {
	ref: RefObject<GuiObject?>,
	lastInteractionInside: boolean,
}

local DEFAULT_INPUT_TYPES = {
	Enum.UserInputType.MouseButton1,
	Enum.UserInputType.Touch,
}

local EMPTY_IGNORE_REFS = {} :: { RefObject<GuiObject?> }

local function matchesInputType(inputObject: InputObject, inputTypesRaw: { Enum.UserInputType }?): boolean
	local inputTypes = if type(inputTypesRaw) == "table" and #inputTypesRaw > 0
		then inputTypesRaw
		else DEFAULT_INPUT_TYPES
	for _, inputType in inputTypes do
		if inputObject.UserInputType == inputType then
			return true
		end
	end
	return false
end

local function isWithinRefs(
	guiObjects: { GuiObject },
	target: GuiObject,
	ignoreRefs: { RefObject<GuiObject?> },
	screenPosition: Vector2
): boolean
	for _, guiObject in guiObjects do
		if GuiUtils.IsDescendantOf(guiObject, target) then
			return true
		end
		for _, ignoreRef in ignoreRefs do
			if ignoreRef.current ~= nil and GuiUtils.IsDescendantOf(guiObject, ignoreRef.current) then
				return true
			end
		end
	end

	if GuiUtils.IsPointInsideGui(target, screenPosition) then
		return true
	end
	for _, ignoreRef in ignoreRefs do
		if ignoreRef.current ~= nil and GuiUtils.IsPointInsideGui(ignoreRef.current, screenPosition) then
			return true
		end
	end

	return false
end

local function useClickOutside(options: ClickOutsideOptions?): ClickOutsideResult
	local internalRef = React.useRef(nil :: GuiObject?) :: RefObject<GuiObject?>
	local targetRef = if options ~= nil and options.ref ~= nil then options.ref else internalRef
	local ignoreRefs = if options ~= nil and options.ignoreRefs ~= nil then options.ignoreRefs else EMPTY_IGNORE_REFS
	local enabled = if options ~= nil and options.enabled ~= nil then options.enabled == true else true
	local inputTypes = if options ~= nil then options.inputTypes else nil
	local onClickOutside = useStableCallback(if options ~= nil then options.onClickOutside else nil)
	local onClickInside = useStableCallback(if options ~= nil then options.onClickInside else nil)
	local lastInteractionInside, setLastInteractionInside = React.useState(false)

	React.useEffect(function()
		if not enabled then
			setLastInteractionInside(false)
			return
		end

		local connection = UserInputService.InputBegan:Connect(function(inputObject: InputObject)
			if not matchesInputType(inputObject, inputTypes) then
				return
			end

			local target = targetRef.current
			if target == nil then
				return
			end

			local screenPosition = GuiUtils.ResolveScreenPositionFromInput(inputObject)
			if screenPosition == nil then
				return
			end

			local guiObjects = GuiUtils.GetGuiObjectsAtPosition(screenPosition)
			local isInside = isWithinRefs(guiObjects, target, ignoreRefs, screenPosition)
			setLastInteractionInside(isInside)
			if isInside then
				onClickInside(inputObject, screenPosition)
			else
				onClickOutside(inputObject, screenPosition)
			end
		end)

		return function()
			connection:Disconnect()
		end
	end, { enabled, targetRef, ignoreRefs, inputTypes, onClickInside, onClickOutside })

	return {
		ref = targetRef,
		lastInteractionInside = lastInteractionInside,
	}
end

return useClickOutside
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="793">
                  <Properties>
                    <string name="Name">useDebounce</string>
                    <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local React = require(ReplicatedStorage.Packages.React)
local useLatest = require(script.Parent.internal.useLatest)
local useTimeout = require(script.Parent.useTimeout)

export type DebounceOptions<T> = {
	leading: boolean?,
	equalityFn: ((T, T) -> boolean)?,
}

export type DebounceResult<T> = {
	value: T,
	pending: boolean,
	cancel: () -> (),
	flush: () -> (),
}

local function defaultEquality<T>(a: T, b: T): boolean
	return a == b
end

local function sanitizeDelaySeconds(valueRaw: any): number
	if typeof(valueRaw) ~= "number" or valueRaw ~= valueRaw then
		return 0
	end
	return math.max(valueRaw, 0)
end

local function useDebounce<T>(value: T, delaySecondsRaw: any, options: DebounceOptions<T>?): DebounceResult<T>
	local delaySeconds = sanitizeDelaySeconds(delaySecondsRaw)
	local leading = if options ~= nil and options.leading ~= nil then options.leading == true else false
	local equalityFn = if options ~= nil and options.equalityFn ~= nil then options.equalityFn else defaultEquality
	local equalityRef = useLatest(equalityFn)
	local latestValueRef = useLatest(value)
	local debouncedValueRef = React.useRef(value)
	local debouncedValue, setDebouncedValue = React.useState(value)

	local commitLatestValue = React.useCallback(function()
		local nextValue = latestValueRef.current
		if equalityRef.current(debouncedValueRef.current, nextValue) then
			return
		end

		debouncedValueRef.current = nextValue
		setDebouncedValue(nextValue)
	end, { latestValueRef, equalityRef })

	local timeout = useTimeout(commitLatestValue, delaySeconds, {
		enabled = true,
		autoStart = false,
	})
	local cancelTimeout = timeout.cancel
	local restartTimeout = timeout.restart
	local isTimeoutScheduled = timeout.isScheduled

	React.useEffect(function()
		if equalityRef.current(debouncedValueRef.current, value) then
			cancelTimeout()
			return
		end

		if delaySeconds <= 0 then
			commitLatestValue()
			return
		end

		if leading and not isTimeoutScheduled then
			debouncedValueRef.current = value
			setDebouncedValue(value)
		end

		restartTimeout(delaySeconds)
	end, {
		value,
		delaySeconds,
		leading,
		isTimeoutScheduled,
		cancelTimeout,
		restartTimeout,
		commitLatestValue,
		equalityRef,
	})

	return {
		value = debouncedValue,
		pending = isTimeoutScheduled,
		cancel = cancelTimeout,
		flush = timeout.flush,
	}
end

return useDebounce
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="794">
                  <Properties>
                    <string name="Name">useFocus</string>
                    <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local React = require(ReplicatedStorage.Packages.React)
local useStableCallback = require(script.Parent.internal.useStableCallback)

export type FocusOptions = {
	initialFocused: boolean?,
	onChanged: ((boolean) -> ())?,
	onFocused: (() -> ())?,
	onBlurred: ((boolean?) -> ())?,
}

export type FocusResult = {
	focused: boolean,
	setFocused: (boolean) -> (),
	eventHandlers: { [any]: (...any) -> () },
}

local function useFocus(options: FocusOptions?): FocusResult
	local initialFocused = if options ~= nil and options.initialFocused ~= nil
		then options.initialFocused == true
		else false
	local onChanged = useStableCallback(if options ~= nil then options.onChanged else nil)
	local onFocusedCallback = useStableCallback(if options ~= nil then options.onFocused else nil)
	local onBlurred = useStableCallback(if options ~= nil then options.onBlurred else nil)
	local focusedRef = React.useRef(initialFocused)
	local focused, setFocusedState = React.useState(initialFocused)

	local setFocused = React.useCallback(function(nextFocusedRaw: boolean)
		local nextFocused = nextFocusedRaw == true
		if focusedRef.current == nextFocused then
			return
		end

		focusedRef.current = nextFocused
		setFocusedState(nextFocused)
		onChanged(nextFocused)
		if nextFocused then
			onFocusedCallback()
		end
	end, { onChanged, onFocusedCallback })

	local onFocused = React.useCallback(function()
		setFocused(true)
	end, { setFocused })

	local onFocusLost = React.useCallback(function(_rbx: TextBox, enterPressed: boolean?)
		setFocused(false)
		onBlurred(enterPressed == true)
	end, { setFocused, onBlurred })

	return {
		focused = focused,
		setFocused = setFocused,
		eventHandlers = {
			[React.Event.Focused] = onFocused,
			[React.Event.FocusLost] = onFocusLost,
		},
	}
end

return useFocus
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="795">
                  <Properties>
                    <string name="Name">useHover</string>
                    <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local React = require(ReplicatedStorage.Packages.React)
local useStableCallback = require(script.Parent.internal.useStableCallback)

export type HoverOptions = {
	initialHovered: boolean?,
	onChanged: ((boolean) -> ())?,
	onHoverStart: (() -> ())?,
	onHoverEnd: (() -> ())?,
}

export type HoverResult = {
	hovered: boolean,
	setHovered: (boolean) -> (),
	eventHandlers: { [any]: (...any) -> () },
}

local function useHover(options: HoverOptions?): HoverResult
	local initialHovered = if options ~= nil and options.initialHovered ~= nil
		then options.initialHovered == true
		else false
	local onChanged = useStableCallback(if options ~= nil then options.onChanged else nil)
	local onHoverStart = useStableCallback(if options ~= nil then options.onHoverStart else nil)
	local onHoverEnd = useStableCallback(if options ~= nil then options.onHoverEnd else nil)
	local hoveredRef = React.useRef(initialHovered)
	local hovered, setHoveredState = React.useState(initialHovered)

	local setHovered = React.useCallback(function(nextHoveredRaw: boolean)
		local nextHovered = nextHoveredRaw == true
		if hoveredRef.current == nextHovered then
			return
		end

		hoveredRef.current = nextHovered
		setHoveredState(nextHovered)
		onChanged(nextHovered)
		if nextHovered then
			onHoverStart()
		else
			onHoverEnd()
		end
	end, { onChanged, onHoverStart, onHoverEnd })

	local onMouseEnter = React.useCallback(function()
		setHovered(true)
	end, { setHovered })

	local onMouseLeave = React.useCallback(function()
		setHovered(false)
	end, { setHovered })

	return {
		hovered = hovered,
		setHovered = setHovered,
		eventHandlers = {
			[React.Event.MouseEnter] = onMouseEnter,
			[React.Event.MouseLeave] = onMouseLeave,
		},
	}
end

return useHover
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="796">
                  <Properties>
                    <string name="Name">useInterval</string>
                    <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Cleanup = require(script.Parent.internal.cleanup)
local React = require(ReplicatedStorage.Packages.React)
local useStableCallback = require(script.Parent.internal.useStableCallback)

export type IntervalOptions = {
	enabled: boolean?,
	autoStart: boolean?,
}

export type IntervalResult = {
	isRunning: boolean,
	cancel: () -> (),
	restart: (nextIntervalSeconds: number?) -> (),
	fire: () -> (),
}

local MINIMUM_INTERVAL_SECONDS = 1 / 240

local function sanitizeIntervalSeconds(valueRaw: any): number?
	if valueRaw == nil then
		return nil
	end
	if typeof(valueRaw) ~= "number" or valueRaw ~= valueRaw then
		return nil
	end
	return math.max(valueRaw, MINIMUM_INTERVAL_SECONDS)
end

local function useInterval(callbackRaw: any, intervalSecondsRaw: any, options: IntervalOptions?): IntervalResult
	local enabled = if options ~= nil and options.enabled ~= nil then options.enabled == true else true
	local autoStart = if options ~= nil and options.autoStart ~= nil then options.autoStart == true else true
	local intervalSeconds = sanitizeIntervalSeconds(intervalSecondsRaw)
	local callback = useStableCallback(callbackRaw)
	local generationRef = React.useRef(0)
	local threadRef = React.useRef(nil :: thread?)
	local isRunning, setIsRunning = React.useState(false)

	local cancel = React.useCallback(function()
		generationRef.current += 1
		Cleanup.CancelTask(threadRef.current)
		threadRef.current = nil
		setIsRunning(false)
	end, {})

	local restart = React.useCallback(function(nextIntervalSecondsRaw: number?)
		cancel()

		if not enabled then
			return
		end

		local nextIntervalSeconds = sanitizeIntervalSeconds(nextIntervalSecondsRaw)
		if nextIntervalSeconds == nil then
			return
		end

		generationRef.current += 1
		local generation = generationRef.current
		setIsRunning(true)

		local function scheduleNext()
			threadRef.current = task.delay(nextIntervalSeconds, function()
				if generationRef.current ~= generation then
					return
				end

				callback()

				if generationRef.current ~= generation then
					return
				end

				scheduleNext()
			end)
		end

		scheduleNext()
	end, { cancel, enabled, callback })

	local fire = React.useCallback(function()
		callback()
	end, { callback })

	React.useEffect(function()
		if enabled and autoStart and intervalSeconds ~= nil then
			restart(intervalSeconds)
		else
			cancel()
		end
	end, { enabled, autoStart, intervalSeconds, restart, cancel })

	React.useEffect(function()
		return function()
			cancel()
		end
	end, { cancel })

	return {
		isRunning = isRunning,
		cancel = cancel,
		restart = restart,
		fire = fire,
	}
end

return useInterval
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="797">
                  <Properties>
                    <string name="Name">useKeybind</string>
                    <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Cleanup = require(script.Parent.internal.cleanup)
local PlatformServiceClient = require(script:FindFirstAncestor("game").Client.Services.PlatformServiceClient)
local PlatformServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.PlatformServiceUtils)
local React = require(ReplicatedStorage.Packages.React)
local useStableCallback = require(script.Parent.internal.useStableCallback)

type PromptBinding = PlatformServiceUtils.PromptBinding
type ActionDefinition = PlatformServiceUtils.ActionDefinition

export type KeybindPhase = "Began" | "Changed" | "Ended"

export type KeybindContext = {
	phase: KeybindPhase,
	inputObject: InputObject?,
	keyCode: Enum.KeyCode?,
	inputType: Enum.UserInputType?,
	gameProcessed: boolean,
	actionContext: any?,
	prompt: PromptBinding?,
}

export type KeybindOptions = {
	enabled: boolean?,
	actionName: string?,
	keyCodes: { Enum.KeyCode }?,
	inputTypes: { Enum.UserInputType }?,
	captureProcessed: boolean?,
	overrideDefinition: ActionDefinition?,
	onTriggered: ((KeybindContext) -> ())?,
}

export type KeybindResult = {
	isPressed: boolean,
	prompt: PromptBinding?,
	lastContext: KeybindContext?,
}

local function keyCodeMatchesInput(inputObject: InputObject, keyCode: Enum.KeyCode): boolean
	if inputObject.KeyCode == keyCode then
		return true
	end

	if keyCode == Enum.KeyCode.MouseLeftButton then
		return inputObject.UserInputType == Enum.UserInputType.MouseButton1
	end
	if keyCode == Enum.KeyCode.MouseRightButton then
		return inputObject.UserInputType == Enum.UserInputType.MouseButton2
	end
	if keyCode == Enum.KeyCode.MouseMiddleButton then
		return inputObject.UserInputType == Enum.UserInputType.MouseButton3
	end

	return false
end

local function matchesConfiguredInput(
	inputObject: InputObject,
	keyCodesRaw: { Enum.KeyCode }?,
	inputTypesRaw: { Enum.UserInputType }?
): boolean
	local hasKeyCodes = type(keyCodesRaw) == "table" and #keyCodesRaw > 0
	local hasInputTypes = type(inputTypesRaw) == "table" and #inputTypesRaw > 0
	if not hasKeyCodes and not hasInputTypes then
		return false
	end

	if hasKeyCodes then
		for _, keyCode in keyCodesRaw :: { Enum.KeyCode } do
			if keyCodeMatchesInput(inputObject, keyCode) then
				return true
			end
		end
	end

	if hasInputTypes then
		for _, inputType in inputTypesRaw :: { Enum.UserInputType } do
			if inputObject.UserInputType == inputType then
				return true
			end
		end
	end

	return false
end

local function useKeybind(options: KeybindOptions?): KeybindResult
	local enabled = if options ~= nil and options.enabled ~= nil then options.enabled == true else true
	local actionName = if options ~= nil then options.actionName else nil
	local keyCodes = if options ~= nil then options.keyCodes else nil
	local inputTypes = if options ~= nil then options.inputTypes else nil
	local captureProcessed = if options ~= nil and options.captureProcessed ~= nil
		then options.captureProcessed == true
		else false
	local overrideDefinition = if options ~= nil then options.overrideDefinition else nil
	local onTriggered = useStableCallback(if options ~= nil then options.onTriggered else nil)
	local isPressed, setIsPressed = React.useState(false)
	local prompt, setPrompt = React.useState(nil :: PromptBinding?)
	local lastContext, setLastContext = React.useState(nil :: KeybindContext?)

	React.useEffect(function()
		setIsPressed(false)
		setLastContext(nil)

		if not enabled then
			setPrompt(nil)
			return
		end

		if typeof(actionName) == "string" and actionName ~= "" then
			setPrompt(PlatformServiceClient:getPromptForAction(actionName))
			local promptSignal = PlatformServiceClient:getPromptSignal(actionName)
			local promptConnection = if promptSignal ~= nil
					and typeof((promptSignal :: any).Connect) == "function"
				then (promptSignal :: any):Connect(function(nextPrompt: PromptBinding?)
					setPrompt(nextPrompt)
				end)
				else nil

			local unbind = PlatformServiceClient:bindAction(
				actionName,
				function(phase: KeybindPhase, actionContext: any)
					local nextPrompt = PlatformServiceClient:getPromptForAction(actionName)
					local context: KeybindContext = {
						phase = phase,
						inputObject = if typeof((actionContext :: any).inputObject) == "InputObject"
							then (actionContext :: any).inputObject
							else nil,
						keyCode = if typeof((actionContext :: any).inputObject) == "InputObject"
							then ((actionContext :: any).inputObject :: InputObject).KeyCode
							else nil,
						inputType = if typeof((actionContext :: any).inputObject) == "InputObject"
							then ((actionContext :: any).inputObject :: InputObject).UserInputType
							else nil,
						gameProcessed = false,
						actionContext = actionContext,
						prompt = nextPrompt,
					}

					setPrompt(nextPrompt)
					setIsPressed(phase ~= "Ended")
					setLastContext(context)
					onTriggered(context)
				end,
				overrideDefinition
			)

			return function()
				setIsPressed(false)
				Cleanup.Call(unbind)
				Cleanup.Call(promptConnection)
			end
		end

		local function handlePhase(phase: KeybindPhase, inputObject: InputObject, gameProcessed: boolean)
			if gameProcessed and not captureProcessed then
				return
			end
			if not matchesConfiguredInput(inputObject, keyCodes, inputTypes) then
				return
			end

			local context: KeybindContext = {
				phase = phase,
				inputObject = inputObject,
				keyCode = inputObject.KeyCode,
				inputType = inputObject.UserInputType,
				gameProcessed = gameProcessed,
				actionContext = nil,
				prompt = nil,
			}

			setIsPressed(phase ~= "Ended")
			setLastContext(context)
			onTriggered(context)
		end

		local beganConnection = UserInputService.InputBegan:Connect(
			function(inputObject: InputObject, gameProcessed: boolean)
				handlePhase("Began", inputObject, gameProcessed)
			end
		)

		local changedConnection = UserInputService.InputChanged:Connect(
			function(inputObject: InputObject, gameProcessed: boolean)
				handlePhase("Changed", inputObject, gameProcessed)
			end
		)

		local endedConnection = UserInputService.InputEnded:Connect(
			function(inputObject: InputObject, gameProcessed: boolean)
				handlePhase("Ended", inputObject, gameProcessed)
			end
		)

		return function()
			setIsPressed(false)
			Cleanup.Call(beganConnection)
			Cleanup.Call(changedConnection)
			Cleanup.Call(endedConnection)
		end
	end, {
		enabled,
		actionName,
		keyCodes,
		inputTypes,
		captureProcessed,
		overrideDefinition,
		onTriggered,
	})

	return {
		isPressed = isPressed,
		prompt = prompt,
		lastContext = lastContext,
	}
end

return useKeybind
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="798">
                  <Properties>
                    <string name="Name">useLongPress</string>
                    <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Cleanup = require(script.Parent.internal.cleanup)
local React = require(ReplicatedStorage.Packages.React)
local useStableCallback = require(script.Parent.internal.useStableCallback)

export type LongPressOptions = {
	duration: number?,
	enabled: boolean?,
	inputTypes: { Enum.UserInputType }?,
	cancelOnPointerLeave: boolean?,
	onLongPress: ((InputObject?) -> ())?,
	onPressStart: ((InputObject?) -> ())?,
	onPressEnd: ((boolean, InputObject?) -> ())?,
}

export type LongPressResult = {
	pressing: boolean,
	longPressed: boolean,
	cancel: () -> (),
	eventHandlers: { [any]: (...any) -> () },
}

local DEFAULT_DURATION_SECONDS = 0.45
local DEFAULT_INPUT_TYPES = {
	Enum.UserInputType.MouseButton1,
	Enum.UserInputType.Touch,
}

local function sanitizeDurationSeconds(valueRaw: any): number
	if typeof(valueRaw) ~= "number" or valueRaw ~= valueRaw then
		return DEFAULT_DURATION_SECONDS
	end
	return math.max(valueRaw, 0)
end

local function matchesInputType(inputObject: InputObject, inputTypesRaw: { Enum.UserInputType }?): boolean
	local inputTypes = if type(inputTypesRaw) == "table" and #inputTypesRaw > 0
		then inputTypesRaw
		else DEFAULT_INPUT_TYPES
	for _, inputType in inputTypes do
		if inputObject.UserInputType == inputType then
			return true
		end
	end
	return false
end

local function useLongPress(options: LongPressOptions?): LongPressResult
	local durationSeconds = sanitizeDurationSeconds(if options ~= nil then options.duration else nil)
	local enabled = if options ~= nil and options.enabled ~= nil then options.enabled == true else true
	local inputTypes = if options ~= nil then options.inputTypes else nil
	local cancelOnPointerLeave = if options ~= nil and options.cancelOnPointerLeave ~= nil
		then options.cancelOnPointerLeave == true
		else true
	local onLongPress = useStableCallback(if options ~= nil then options.onLongPress else nil)
	local onPressStart = useStableCallback(if options ~= nil then options.onPressStart else nil)
	local onPressEnd = useStableCallback(if options ~= nil then options.onPressEnd else nil)
	local pressingRef = React.useRef(false)
	local longPressedRef = React.useRef(false)
	local activeInputRef = React.useRef(nil :: InputObject?)
	local timerThreadRef = React.useRef(nil :: thread?)
	local endedConnectionRef = React.useRef(nil)
	local timerGenerationRef = React.useRef(0)
	local pressing, setPressing = React.useState(false)
	local longPressed, setLongPressed = React.useState(false)

	local cancel = React.useCallback(function()
		timerGenerationRef.current += 1
		Cleanup.CancelTask(timerThreadRef.current)
		timerThreadRef.current = nil
		Cleanup.Call(endedConnectionRef.current)
		endedConnectionRef.current = nil
		pressingRef.current = false
		longPressedRef.current = false
		activeInputRef.current = nil
		setPressing(false)
		setLongPressed(false)
	end, {})

	local finishPress = React.useCallback(function(resolvedInputObject: InputObject?)
		if not pressingRef.current and not longPressedRef.current then
			cancel()
			return
		end

		local didLongPress = longPressedRef.current
		local inputObject = if resolvedInputObject ~= nil then resolvedInputObject else activeInputRef.current
		cancel()
		onPressEnd(didLongPress, inputObject)
	end, { cancel, onPressEnd })

	local beginPress = React.useCallback(function(inputObject: InputObject)
		if not enabled or not matchesInputType(inputObject, inputTypes) then
			return
		end

		cancel()
		pressingRef.current = true
		longPressedRef.current = false
		activeInputRef.current = inputObject
		setPressing(true)
		setLongPressed(false)
		onPressStart(inputObject)

		timerGenerationRef.current += 1
		local generation = timerGenerationRef.current
		timerThreadRef.current = task.delay(durationSeconds, function()
			if timerGenerationRef.current ~= generation or not pressingRef.current then
				return
			end

			timerThreadRef.current = nil
			longPressedRef.current = true
			setLongPressed(true)
			onLongPress(activeInputRef.current)
		end)

		endedConnectionRef.current = UserInputService.InputEnded:Connect(function(endedInputObject: InputObject)
			local activeInput = activeInputRef.current
			if activeInput == nil then
				return
			end
			if endedInputObject == activeInput or endedInputObject.UserInputType == activeInput.UserInputType then
				finishPress(endedInputObject)
			end
		end)
	end, {
		enabled,
		inputTypes,
		cancel,
		durationSeconds,
		onPressStart,
		onLongPress,
		finishPress,
	})

	React.useEffect(function()
		return function()
			cancel()
		end
	end, { cancel })

	return {
		pressing = pressing,
		longPressed = longPressed,
		cancel = cancel,
		eventHandlers = {
			[React.Event.InputBegan] = function(_rbx: GuiObject, inputObject: InputObject)
				beginPress(inputObject)
			end,
			[React.Event.InputEnded] = function(_rbx: GuiObject, inputObject: InputObject)
				local activeInput = activeInputRef.current
				if activeInput == nil then
					return
				end
				if inputObject == activeInput or inputObject.UserInputType == activeInput.UserInputType then
					finishPress(inputObject)
				end
			end,
			[React.Event.MouseLeave] = function()
				if cancelOnPointerLeave then
					finishPress(activeInputRef.current)
				end
			end,
		},
	}
end

return useLongPress
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="799">
                  <Properties>
                    <string name="Name">useManaTransparency</string>
                    <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local React = require(ReplicatedStorage.Packages.React)
local Ripple = require(ReplicatedStorage.Packages.Ripple)

type NumberMotion = Ripple.Motion<number>
type SpringOptions = Ripple.SpringOptions

export type ManaTransparencyOptions = {
	enabled: boolean?,
	spring: SpringOptions?,
}

local DEFAULT_SPRING: SpringOptions = {
	frequency = 2.8,
	damping = 0.84,
}

local function useManaTransparency(options: ManaTransparencyOptions?): number
	local enabled = if options and options.enabled ~= nil then options.enabled else false
	local spring = if options and options.spring ~= nil then options.spring else DEFAULT_SPRING
	local targetRef = React.useRef(if enabled then 1 else 0)
	local progress, setProgress = React.useState(targetRef.current)

	React.useEffect(function()
		targetRef.current = if enabled then 1 else 0
	end, { enabled })

	React.useEffect(function()
		local motion: NumberMotion = Ripple.createMotion(progress)
		local connection = RunService.RenderStepped:Connect(function(deltaTime: number)
			motion:spring(targetRef.current, spring)
			local nextProgress = math.clamp(motion:step(deltaTime), 0, 1)
			setProgress(nextProgress)
		end)

		return function()
			connection:Disconnect()
			motion:destroy()
		end
	end, { spring })

	return progress
end

return useManaTransparency
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="800">
                  <Properties>
                    <string name="Name">useMounted</string>
                    <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local React = require(ReplicatedStorage.Packages.React)

export type MountedRef = {
	current: boolean,
}

local function useMounted(): MountedRef
	local mountedRef = React.useRef(false) :: MountedRef

	React.useEffect(function()
		mountedRef.current = true

		return function()
			mountedRef.current = false
		end
	end, {})

	return mountedRef
end

return useMounted
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="801">
                  <Properties>
                    <string name="Name">useParallax</string>
                    <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local GuiUtils = require(script.Parent.internal.gui)
local React = require(ReplicatedStorage.Packages.React)
local Ripple = require(ReplicatedStorage.Packages.Ripple)
local useSpring = require(script.Parent.useSpring)
local useViewport = require(script.Parent.useViewport)

export type ParallaxOptions = {
	enabled: boolean?,
	depth: number?,
	maxOffset: Vector2?,
	invert: boolean?,
	spring: Ripple.SpringOptions?,
}

export type ParallaxResult = {
	offset: Vector2,
	binding: React.Binding<Vector2>,
	normalized: Vector2,
}

local DEFAULT_MAX_OFFSET = Vector2.new(18, 14)

local function sanitizeDepth(valueRaw: any): number
	if typeof(valueRaw) ~= "number" or valueRaw ~= valueRaw then
		return 1
	end
	return math.max(valueRaw, 0)
end

local function computeNormalizedPosition(screenPosition: Vector2, viewport: Vector2): Vector2
	if viewport.X <= 0 or viewport.Y <= 0 then
		return Vector2.zero
	end

	local normalizedX = math.clamp((screenPosition.X / viewport.X) * 2 - 1, -1, 1)
	local normalizedY = math.clamp((screenPosition.Y / viewport.Y) * 2 - 1, -1, 1)
	return Vector2.new(normalizedX, normalizedY)
end

local function useParallax(options: ParallaxOptions?): ParallaxResult
	local enabled = if options ~= nil and options.enabled ~= nil then options.enabled == true else true
	local depth = sanitizeDepth(if options ~= nil then options.depth else nil)
	local maxOffset = if options ~= nil and options.maxOffset ~= nil then options.maxOffset else DEFAULT_MAX_OFFSET
	local invert = if options ~= nil and options.invert ~= nil then options.invert == true else false
	local viewportState = useViewport()
	local normalized, setNormalized = React.useState(Vector2.zero)

	React.useEffect(function()
		local function updateFromInput(inputObjectRaw: any)
			if not enabled then
				setNormalized(Vector2.zero)
				return
			end

			local screenPosition = GuiUtils.ResolveScreenPositionFromInput(inputObjectRaw)
			if screenPosition == nil then
				local mousePosition = UserInputService:GetMouseLocation()
				screenPosition = Vector2.new(mousePosition.X, mousePosition.Y)
			end

			setNormalized(computeNormalizedPosition(screenPosition, viewportState.viewport))
		end

		updateFromInput(nil)

		local changedConnection = UserInputService.InputChanged:Connect(function(inputObject: InputObject)
			if
				inputObject.UserInputType == Enum.UserInputType.MouseMovement
				or inputObject.UserInputType == Enum.UserInputType.Touch
			then
				updateFromInput(inputObject)
			end
		end)

		local lastInputConnection = UserInputService.LastInputTypeChanged:Connect(function()
			updateFromInput(nil)
		end)

		return function()
			changedConnection:Disconnect()
			lastInputConnection:Disconnect()
		end
	end, { enabled, viewportState.viewport })

	local direction = if invert then -1 else 1
	local targetOffset = if enabled
		then Vector2.new(normalized.X * maxOffset.X * depth * direction, normalized.Y * maxOffset.Y * depth * direction)
		else Vector2.zero
	local springState = useSpring(targetOffset, {
		enabled = enabled,
		initialValue = Vector2.zero,
		spring = if options ~= nil then options.spring else nil,
	})

	return {
		offset = springState.value,
		binding = springState.binding,
		normalized = normalized,
	}
end

return useParallax
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="802">
                  <Properties>
                    <string name="Name">usePressState</string>
                    <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local React = require(ReplicatedStorage.Packages.React)
local useStableCallback = require(script.Parent.internal.useStableCallback)

export type PressStateOptions = {
	disabled: boolean?,
	initialHovered: boolean?,
	initialPressed: boolean?,
	onHoverChanged: ((boolean) -> ())?,
	onPressedChanged: ((boolean) -> ())?,
}

export type PressStateResult = {
	hovered: boolean,
	pressed: boolean,
	setHovered: (boolean) -> (),
	setPressed: (boolean) -> (),
	eventHandlers: { [any]: (...any) -> () },
}

local function isPrimaryInput(inputObject: InputObject): boolean
	return inputObject.UserInputType == Enum.UserInputType.MouseButton1
		or inputObject.UserInputType == Enum.UserInputType.Touch
		or inputObject.KeyCode == Enum.KeyCode.ButtonA
end

local function usePressState(options: PressStateOptions?): PressStateResult
	local disabled = options ~= nil and options.disabled == true
	local onHoverChanged = useStableCallback(if options ~= nil then options.onHoverChanged else nil)
	local onPressedChanged = useStableCallback(if options ~= nil then options.onPressedChanged else nil)
	local hovered, setHoveredState = React.useState(options ~= nil and options.initialHovered == true)
	local pressed, setPressedState = React.useState(options ~= nil and options.initialPressed == true)

	local setHovered = React.useCallback(function(nextHoveredRaw: boolean)
		local nextHovered = nextHoveredRaw == true and not disabled
		setHoveredState(nextHovered)
		onHoverChanged(nextHovered)
	end, { disabled, onHoverChanged })

	local setPressed = React.useCallback(function(nextPressedRaw: boolean)
		local nextPressed = nextPressedRaw == true and not disabled
		setPressedState(nextPressed)
		onPressedChanged(nextPressed)
	end, { disabled, onPressedChanged })

	local onMouseEnter = React.useCallback(function()
		setHovered(true)
	end, { setHovered })

	local onMouseLeave = React.useCallback(function()
		setHovered(false)
		setPressed(false)
	end, { setHovered, setPressed })

	local onInputBegan = React.useCallback(function(_: GuiObject, inputObject: InputObject)
		if disabled or not isPrimaryInput(inputObject) then
			return
		end
		setPressed(true)
	end, { disabled, setPressed })

	local onInputEnded = React.useCallback(function(_: GuiObject, inputObject: InputObject)
		if not isPrimaryInput(inputObject) then
			return
		end
		setPressed(false)
	end, { setPressed })

	return {
		hovered = hovered,
		pressed = pressed,
		setHovered = setHovered,
		setPressed = setPressed,
		eventHandlers = {
			[React.Event.MouseEnter] = onMouseEnter,
			[React.Event.MouseLeave] = onMouseLeave,
			[React.Event.InputBegan] = onInputBegan,
			[React.Event.InputEnded] = onInputEnded,
		},
	}
end

return usePressState
]]></string>
                  </Properties>
