local SerdesEvent = "?"
local SerdesThread: thread?
Events.Reliable[0] = {}
Queue.Reliable[0] = table.create(256)
Queue.Reliable[2] = table.create(256)
export type PackedArguments = { Count: number, NilIndices: { number }, Values: { any } }
function SerdesFunctions.ReadEVENT_ServerToClient(): (string, string, {
