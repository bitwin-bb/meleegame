            <Item class="ModuleScript" referent="720">
              <Properties>
                <string name="Name">PadNavBinder</string>
                <string name="Source"><![CDATA[--!strict

local packageRoot = script:FindFirstAncestor("game").Parent
local loaderUtils = assert(packageRoot:FindFirstChild("LoaderUtils", true), "Missing LoaderUtils")
local loader = require(loaderUtils.Parent).load(script)

local Maid = loader("Maid")
local Observable = loader("Observable")
local Rx = loader("Rx")

local CoreRuntime = require(script:FindFirstAncestor("game").Shared.Modules.Core.Runtime)
local GamepadNav = require(script:FindFirstAncestor("game").Shared.Modules.Platform.GamepadNav)
local PlatformServiceClient = require(script:FindFirstAncestor("game").Client.Services.PlatformServiceClient)
local padSlice = require(script:FindFirstAncestor("game").Client.UI.features.pad.state.padSlice)

type ObservableObject = {
	Subscribe: (
		self: ObservableObject,
		fireCallback: ((...any) -> ())?,
		failCallback: ((...any) -> ())?,
		completeCallback: ((...any) -> ())?
	) -> any,
	Pipe: (self: ObservableObject, transformers: { any }) -> ObservableObject,
}

type MaidClass = {
	GiveTask: (self: MaidClass, task: any) -> any,
	DoCleaning: (self: MaidClass) -> (),
	Destroy: (self: MaidClass) -> (),
}

type ThumbstickState = {
	key: "Left" | "Right",
	raw: Vector2,
	screen: Vector2,
	magnitude: number,
	active: boolean,
}

type ThumbstickSnapshot = {
	left: ThumbstickState,
	right: ThumbstickState,
	dominant: "Left" | "Right"?,
	lastUpdatedAt: number,
	stickDeadzone: number,
	navigationDeadzone: number,
}

local PadNavBinder = {}
PadNavBinder.ServiceName = "PadNavBinder"

local EMPTY_THUMBSTICK_SNAPSHOT: ThumbstickSnapshot = {
	left = {
		key = "Left",
		raw = Vector2.zero,
		screen = Vector2.zero,
		magnitude = 0,
		active = false,
	},
	right = {
		key = "Right",
		raw = Vector2.zero,
		screen = Vector2.zero,
		magnitude = 0,
		active = false,
	},
	dominant = nil,
	lastUpdatedAt = 0,
	stickDeadzone = GamepadNav.DEFAULT_STICK_DEADZONE,
	navigationDeadzone = GamepadNav.DEFAULT_NAVIGATION_DEADZONE,
}

local function cleanupTask(taskRaw: any)
	if type(taskRaw) == "function" then
		taskRaw()
		return
	end

	if typeof(taskRaw) == "RBXScriptConnection" then
		taskRaw:Disconnect()
		return
	end

	if type(taskRaw) == "table" and typeof((taskRaw :: any).Disconnect) == "function" then
		(taskRaw :: any):Disconnect()
	end
end

local function resolveGamepadNav(runtimeContextRaw: any): any?
	if runtimeContextRaw == nil then
		return nil
	end

	if typeof((runtimeContextRaw :: any).getGamepadNav) == "function" then
		local ok, gamepadNavOrError = pcall(function()
			return (runtimeContextRaw :: any):getGamepadNav()
		end)
		if ok then
			return gamepadNavOrError
		end
	end

	return (runtimeContextRaw :: any).gamepadNav
end

local function resolveThumbstickSnapshot(gamepadNavRaw: any): ThumbstickSnapshot
	if gamepadNavRaw ~= nil and typeof((gamepadNavRaw :: any).getThumbstickState) == "function" then
		local ok, snapshotOrError = pcall(function()
			return (gamepadNavRaw :: any):getThumbstickState()
		end)
		if ok and typeof(snapshotOrError) == "table" then
			return snapshotOrError :: ThumbstickSnapshot
		end
	end

	return EMPTY_THUMBSTICK_SNAPSHOT
end

function PadNavBinder._observeThumbsticks(self): ObservableObject
	local gamepadNav = self._gamepadNav
	if gamepadNav == nil then
		return Rx.of(EMPTY_THUMBSTICK_SNAPSHOT) :: ObservableObject
	end

	return Observable.new(function(sub)
		local disconnect = nil

		if typeof((gamepadNav :: any).onThumbstickChanged) == "function" then
			disconnect = (gamepadNav :: any):onThumbstickChanged(function(snapshot: any)
				sub:Fire(snapshot)
			end)
		end

		sub:Fire(resolveThumbstickSnapshot(gamepadNav))

		return function()
			cleanupTask(disconnect)
		end
	end) :: ObservableObject
end

function PadNavBinder._bindStreams(self)
	self._maid:DoCleaning()
	self._gamepadNav = resolveGamepadNav(self._runtimeContext)

	padSlice.setPlatform(PlatformServiceClient:getPlatform())
	padSlice.updateThumbsticks(resolveThumbstickSnapshot(self._gamepadNav))

	self._maid:GiveTask(Rx.combineLatestDefer({
		platform = PlatformServiceClient:ObservePlatform(),
		thumbsticks = self:_observeThumbsticks(),
	}):Subscribe(function(snapshot: { platform: string, thumbsticks: ThumbstickSnapshot })
		local platform = snapshot.platform
		padSlice.setPlatform(platform)

		if platform == "Gamepad" then
			padSlice.updateThumbsticks(snapshot.thumbsticks)
		else
			padSlice.updateThumbsticks(EMPTY_THUMBSTICK_SNAPSHOT)
		end
	end))
end

function PadNavBinder.Init(self, serviceBag: any)
	assert(self._serviceBag == nil, "Already initialized")
	self._serviceBag = assert(serviceBag, "No serviceBag")
	self._maid = Maid.new() :: MaidClass

	self._runtimeContext = CoreRuntime.getClientRuntime()
	if self._runtimeContext ~= nil and typeof((self._runtimeContext :: any).init) == "function" then
		(self._runtimeContext :: any):init()
	end

	if not PlatformServiceClient:isReady() then
		PlatformServiceClient:init()
	end

	self:_bindStreams()
end

function PadNavBinder.Start(_self)
	-- this bridge binds during Init so pad state is ready before the UI mounts
end

function PadNavBinder.Destroy(self)
	if self._maid ~= nil then
		self._maid:DoCleaning()
		self._maid:Destroy()
		self._maid = nil
	end

	self._gamepadNav = nil
	self._runtimeContext = nil
	self._serviceBag = nil
	padSlice.resetPadState()
end

return PadNavBinder
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="721">
              <Properties>
                <string name="Name">PreviewBinder</string>
                <string name="Source"><![CDATA[--!strict

local RunService = game:GetService("RunService")

local BuildServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.BuildServiceUtils)
local ModelBinder = require(script:FindFirstAncestor("game").Shared.Binders.ModelBinder)

local PreviewBinder = {}
PreviewBinder.__index = PreviewBinder
setmetatable(PreviewBinder, ModelBinder)

local buildServiceClient = nil

local function getBuildServiceClient()
	if buildServiceClient == nil then
		buildServiceClient = require(script:FindFirstAncestor("game").Client.Services.BuildServiceClient)
	end
	return buildServiceClient
end

function PreviewBinder.new(instance: Instance, context: any)
	local self = ModelBinder.new(instance, context, PreviewBinder)
	self.part = if instance:IsA("BasePart") then instance else nil
	if self.part ~= nil then
		self.part.Name = "BuildPreviewBinder"
		self.part.Anchored = true
		self.part.CanCollide = false
		self.part.CanTouch = false
		self.part.CanQuery = false
		self.part.Material = Enum.Material.ForceField
		self.part.CastShadow = false
		self.part.Transparency = 1
	end

	self.instance:SetAttribute("PreviewTagged", true)
	self:Connect(RunService.RenderStepped, function()
		self:step()
	end)
	return self
end

function PreviewBinder.hide(self: any)
	if self.part ~= nil then
		self.part.Transparency = 1
	end
end

function PreviewBinder.step(self: any)
	if self.part == nil then
		return
	end

	local nextBuildServiceClient = getBuildServiceClient()
	local state = (nextBuildServiceClient :: any).state
	if typeof(state) ~= "table" then
		self:hide()
		return
	end

	local tileX = (nextBuildServiceClient :: any).cursorTileX
	local tileY = (nextBuildServiceClient :: any).cursorTileY
	local previewColor = Color3.fromRGB(255, 209, 92)
	local footprint = {} :: { any }
	local activePlaceSource = nextBuildServiceClient:resolveActivePlaceSource()

	if activePlaceSource ~= nil then
		tileX, tileY = nextBuildServiceClient:resolveTerrainHoverTile(tileX, tileY)
		if tileX == nil or tileY == nil then
			self:hide()
			return
		end

		local canPlace, _, resolvedFootprint =
			nextBuildServiceClient:canPlaceAt(tileX, tileY, activePlaceSource.config.tileId)
		previewColor = if canPlace then Color3.fromRGB(122, 230, 160) else Color3.fromRGB(255, 120, 120)
		footprint = resolvedFootprint
	else
		if tileX == nil or tileY == nil then
			self:hide()
			return
		end

		local hoveredTileId = nextBuildServiceClient:getTileAt(tileX, tileY, false)
		if hoveredTileId == BuildServiceUtils.AIR_TILE_ID then
			self:hide()
			return
		end
	end

	local previewGeometry = nextBuildServiceClient:resolvePreviewGeometry(tileX, tileY, footprint)
	if previewGeometry == nil then
		self:hide()
		return
	end

	self.part.Size = previewGeometry.size
	self.part.CFrame = CFrame.new(previewGeometry.centerPosition)
	self.part.Color = previewColor
	self.part.Transparency = 0.42
end

return PreviewBinder
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="722">
              <Properties>
                <string name="Name">UseBinder</string>
                <string name="Source"><![CDATA[--!strict

local ModelBinder = require(script:FindFirstAncestor("game").Shared.Binders.ModelBinder)

local UseBinder = {}
UseBinder.__index = UseBinder
setmetatable(UseBinder, ModelBinder)

local inventoryServiceClient = nil

local function getInventoryServiceClient()
	if inventoryServiceClient == nil then
		inventoryServiceClient = require(script:FindFirstAncestor("game").Client.Services.InventoryServiceClient)
	end
	return inventoryServiceClient
end

local function resolveStringAttribute(instance: Instance, attributeName: string, fallback: string): string
	local value = instance:GetAttribute(attributeName)
	if typeof(value) == "string" and value ~= "" then
		return value
	end
	return fallback
end

local function resolveNumberAttribute(instance: Instance, attributeName: string, fallback: number): number
	local value = instance:GetAttribute(attributeName)
	if typeof(value) ~= "number" or value ~= value then
		return fallback
	end
	return value
end

function UseBinder.new(instance: Instance, context: any)
	local self = ModelBinder.new(instance, context, UseBinder)
	self.adornee = ModelBinder.resolveAdornee(instance)
	self.rootPart = ModelBinder.resolveRootPart(instance)
	self.highlight = self:createHighlight()
	self.prompt = self:createPrompt()

	self:refresh()
	if self.prompt ~= nil then
		self:Connect(self.prompt.PromptShown, function()
			self:setFocused(true)
		end)
		self:Connect(self.prompt.PromptHidden, function()
			self:setFocused(false)
		end)
		self:Connect(self.prompt.Triggered, function()
			self:onTriggered()
		end)
	end

	self:ObserveAttribute("UseActionText", function()
		self:refresh()
	end)
	self:ObserveAttribute("UseObjectText", function()
		self:refresh()
	end)
	self:ObserveAttribute("UseMaxDistance", function()
		self:refresh()
	end)
	self:ObserveAttribute("UseEnabled", function()
		self:refresh()
	end)

	return self
end

function UseBinder.createHighlight(self: any): Highlight?
	if self.adornee == nil then
		return nil
	end

	local existing = self.instance:FindFirstChild("UseHighlight")
	if existing ~= nil and existing:IsA("Highlight") then
		existing.Adornee = self.adornee
		return existing
	end

	local highlight = Instance.new("Highlight")
	highlight.Name = "UseHighlight"
	highlight.Adornee = self.adornee
	highlight.DepthMode = Enum.HighlightDepthMode.Occluded
	highlight.FillColor = Color3.fromRGB(255, 232, 176)
	highlight.FillTransparency = 0.82
	highlight.OutlineColor = Color3.fromRGB(255, 210, 98)
	highlight.OutlineTransparency = 0.15
	highlight.Enabled = false
	highlight.Parent = self.instance
	self:AddCleanup(function()
		if highlight.Parent ~= nil then
			highlight:Destroy()
		end
	end)
	return highlight
end

function UseBinder.createPrompt(self: any): ProximityPrompt?
	if self.rootPart == nil then
		return nil
	end

	local existing = self.rootPart:FindFirstChild("UsePrompt")
	if existing ~= nil and existing:IsA("ProximityPrompt") then
		return existing
	end

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "UsePrompt"
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.GamepadKeyCode = Enum.KeyCode.ButtonB
	prompt.Parent = self.rootPart
	self:AddCleanup(function()
		if prompt.Parent ~= nil then
			prompt:Destroy()
		end
	end)
	return prompt
end

function UseBinder.refresh(self: any)
	local enabled = self.instance:GetAttribute("UseEnabled") ~= false
	local actionText = resolveStringAttribute(self.instance, "UseActionText", "Use")
	local objectText = resolveStringAttribute(self.instance, "UseObjectText", self.instance.Name)
	local maxDistance = resolveNumberAttribute(self.instance, "UseMaxDistance", 12)

	self.instance:SetAttribute("UseTagged", true)
	self.instance:SetAttribute("UseFocused", false)

	if self.prompt ~= nil then
		self.prompt.Enabled = enabled
		self.prompt.ActionText = actionText
		self.prompt.ObjectText = objectText
		self.prompt.MaxActivationDistance = maxDistance
	end
	if self.highlight ~= nil then
		self.highlight.Enabled = false
	end
end

function UseBinder.setFocused(self: any, focused: boolean)
	if self.highlight ~= nil then
		self.highlight.Enabled = focused
	end
	self.instance:SetAttribute("UseFocused", focused)
end

function UseBinder.onTriggered(self: any)
	local remoteName = self.instance:GetAttribute("UseRemoteName")
	if typeof(remoteName) == "string" and remoteName ~= "" then
		local remote = self.instance:FindFirstChild(remoteName, true)
		if remote ~= nil and remote:IsA("RemoteEvent") then
			remote:FireServer(self.instance)
			return
		end
	end

	local defaultRemote = self.instance:FindFirstChild("UseRemoteEvent", true)
	if defaultRemote ~= nil and defaultRemote:IsA("RemoteEvent") then
		defaultRemote:FireServer(self.instance)
		return
	end

	local route = self.instance:GetAttribute("UseRoute")
	if route == "UseSelectedSlot" or route == "SelectedSlot" then
		getInventoryServiceClient():useSelectedSlot(1)
		return
	end
	if route == "PlaceSelectedDeployable" then
		getInventoryServiceClient():requestPlaceSelectedDeployable()
	end
end

function UseBinder.Cleanup(self: any)
	self:setFocused(false)
end

return UseBinder
]]></string>
              </Properties>
            </Item>
          </Item>
          <Item class="Folder" referent="723">
            <Properties>
              <string name="Name">Cmdr</string>
            </Properties>
            <Item class="ModuleScript" referent="724">
              <Properties>
                <string name="Name">CmdrBootstrapClient</string>
                <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")

local packageRoot = script:FindFirstAncestor("game").Parent
local loaderUtils = assert(packageRoot:FindFirstChild("LoaderUtils", true), "Missing LoaderUtils")
local loader = require(loaderUtils.Parent).load(script)

local Maid = loader("Maid")
local CmdrUtils = require(script:FindFirstAncestor("game").Shared.Cmdr.CmdrUtils)
local MatterDebugMenuClient = require(script.Parent.MatterDebugMenuClient)

type MaidClass = {
	GiveTask: (self: MaidClass, task: any) -> any,
	DoCleaning: (self: MaidClass) -> (),
}

local CmdrBootstrapClient = {}

local localPlayer = Players.LocalPlayer
local MATTER_DEBUGGER_REMOTE_NAME = "MatterDebuggerRemote"

local started = false
local maid = nil :: MaidClass?
local matterDebugInitScheduled = false
local cmdrClient = nil :: any
local pendingCmdrRetry = false

local function findValidStarterGuiCmdr(): ScreenGui?
	local cmdrGui = CmdrUtils.keepSingleValidCmdrGui(StarterGui)

	while cmdrGui ~= nil and not CmdrUtils.isValidCmdrGui(cmdrGui) do
		task.wait()
		cmdrGui = CmdrUtils.keepSingleValidCmdrGui(StarterGui)
	end

	return cmdrGui
end

local function preparePlayerGuiForCmdr(): ScreenGui?
	local playerGui = localPlayer:FindFirstChild("PlayerGui")
	if playerGui == nil or not playerGui:IsA("PlayerGui") then
		return nil
	end

	return CmdrUtils.keepSingleValidCmdrGui(playerGui)
end

local function ensureCmdrClient(): any
	if cmdrClient ~= nil then
		return cmdrClient
	end

	local starterGuiCmdr = findValidStarterGuiCmdr()
	if starterGuiCmdr == nil then
		return nil
	end

	local existingGui = preparePlayerGuiForCmdr()
	local playerGui = localPlayer:FindFirstChild("PlayerGui")
	if playerGui == nil or not playerGui:IsA("PlayerGui") then
		return nil
	end

	if existingGui == nil then
		starterGuiCmdr:Clone().Parent = playerGui
		existingGui = CmdrUtils.keepSingleValidCmdrGui(playerGui)
	end

	if existingGui == nil then
		return nil
	end

	local cmdrClientModule = ReplicatedStorage:FindFirstChild("CmdrClient")
	if cmdrClientModule == nil or not cmdrClientModule:IsA("ModuleScript") then
		return nil
	end

	cmdrClient = require(cmdrClientModule)
	cmdrClient:SetActivationUnlocksMouse(true)
	cmdrClient:SetActivationKeys({ Enum.KeyCode.F2 })
	cmdrClient:SetEnabled(false)
	return cmdrClient
end

local function scheduleCmdrRetry()
	if pendingCmdrRetry then
		return
	end

	pendingCmdrRetry = true
	task.delay(0.1, function()
		pendingCmdrRetry = false
		if maid == nil then
			return
		end

		local applyCmdrAccess = CmdrBootstrapClient.applyCmdrAccess
		if applyCmdrAccess ~= nil then
			applyCmdrAccess()
		end
	end)
end

function CmdrBootstrapClient.ApplyCmdrAccess()
	local cmdrEnabled = localPlayer:GetAttribute(CmdrUtils.CMDR_ENABLED_ATTRIBUTE) == true or RunService:IsStudio()
	if not cmdrEnabled then
		if cmdrClient ~= nil then
			cmdrClient:SetEnabled(false)
			cmdrClient:Hide()
		end
		return
	end

	local ensuredClient = ensureCmdrClient()
	if ensuredClient ~= nil then
		ensuredClient:SetEnabled(true)
	else
		scheduleCmdrRetry()
	end
end

local function applyMatterDebugMenuAccess()
	local matterDebugEnabled = localPlayer:GetAttribute(CmdrUtils.MATTER_DEBUG_MENU_ENABLED_ATTRIBUTE) == true
	if not matterDebugEnabled then
		matterDebugInitScheduled = false
		MatterDebugMenuClient:destroy()
		return
	end

	if ReplicatedStorage:FindFirstChild(MATTER_DEBUGGER_REMOTE_NAME) == nil then
		return
	end

	local matterDebugMenuClient = MatterDebugMenuClient :: any
	if matterDebugMenuClient.initialized == true or matterDebugInitScheduled == true then
		return
	end

	matterDebugInitScheduled = true
	task.defer(function()
		matterDebugInitScheduled = false
		if maid == nil then
			return
		end

		local ok, err = pcall(function()
			MatterDebugMenuClient:init()
		end)
		if not ok then
			warn(`[CmdrBootstrapClient] Failed to initialize Matter debug menu: {err}`)
		end
	end)
end

function CmdrBootstrapClient.Start(_serviceBag: any)
	if started then
		return
	end
	started = true
	maid = Maid.new() :: MaidClass

	maid:GiveTask(localPlayer:GetAttributeChangedSignal(CmdrUtils.CMDR_ENABLED_ATTRIBUTE):Connect(function()
		CmdrBootstrapClient.ApplyCmdrAccess()
	end))
	maid:GiveTask(
		localPlayer:GetAttributeChangedSignal(CmdrUtils.MATTER_DEBUG_MENU_ENABLED_ATTRIBUTE):Connect(function()
			applyMatterDebugMenuAccess()
		end)
	)
	maid:GiveTask(localPlayer.ChildAdded:Connect(function(child)
		if child:IsA("PlayerGui") then
			CmdrBootstrapClient.ApplyCmdrAccess()
		end
	end))
	maid:GiveTask(ReplicatedStorage.ChildAdded:Connect(function(child)
		if child.Name == "CmdrClient" then
			CmdrBootstrapClient.ApplyCmdrAccess()
		elseif child.Name == MATTER_DEBUGGER_REMOTE_NAME then
			applyMatterDebugMenuAccess()
		end
	end))
	maid:GiveTask(StarterGui.ChildAdded:Connect(function(child)
		if child.Name == "Cmdr" then
			CmdrBootstrapClient.ApplyCmdrAccess()
		end
	end))

	task.defer(function()
		CmdrBootstrapClient.ApplyCmdrAccess()
		applyMatterDebugMenuAccess()
	end)
end

CmdrBootstrapClient.applyCmdrAccess = CmdrBootstrapClient.ApplyCmdrAccess
CmdrBootstrapClient.start = CmdrBootstrapClient.Start

return CmdrBootstrapClient
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="725">
              <Properties>
                <string name="Name">MatterDebugMenuClient</string>
                <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Matter = require(ReplicatedStorage.Packages.Matter)
local Plasma = require(ReplicatedStorage.Packages.Plasma)

local CmdrUtils = require(script:FindFirstAncestor("game").Shared.Cmdr.CmdrUtils)

local MatterDebugMenuClient = {}

type ConnectionMap = {
	default: RBXScriptConnection,
}

type MatterDebugMenuClient = typeof(MatterDebugMenuClient) & {
	localPlayer: Player?,
	world: any,
	loop: any,
	debugger: any,
	connection: ConnectionMap?,
	attributeConnection: RBXScriptConnection?,
	initialized: boolean,
}

function MatterDebugMenuClient:ApplyEnabledState()
	local localPlayer = self.localPlayer
	local debugger = self.debugger
	if localPlayer == nil or debugger == nil then
		return
	end

	local enabled = localPlayer:GetAttribute(CmdrUtils.MATTER_DEBUG_MENU_ENABLED_ATTRIBUTE) == true
	if enabled then
		debugger:show()
		debugger:switchToServerView()
	else
		debugger:hide()
	end
end

function MatterDebugMenuClient:Init()
	if self.initialized then
		return
	end

	local localPlayer = Players.LocalPlayer
	if localPlayer == nil then
		return
	end

	local world = Matter.World.new()
	local loop = Matter.Loop.new(world, self)
	local debugger = Matter.Debugger.new(Plasma)
	debugger:autoInitialize(loop)
	local connection = loop:begin({
		default = RunService.Heartbeat,
	})
	local attributeConnection = localPlayer
		:GetAttributeChangedSignal(CmdrUtils.MATTER_DEBUG_MENU_ENABLED_ATTRIBUTE)
		:Connect(function()
			self:applyEnabledState()
		end)

	self.localPlayer = localPlayer
	self.world = world
	self.loop = loop
	self.debugger = debugger
	self.connection = connection
	self.attributeConnection = attributeConnection
	self.initialized = true
	self:applyEnabledState()
end

function MatterDebugMenuClient:Destroy()
	if self.attributeConnection ~= nil then
		self.attributeConnection:Disconnect()
		self.attributeConnection = nil
	end
	if self.connection ~= nil then
		self.connection.default:Disconnect()
		self.connection = nil
	end
	self.debugger = nil
	self.loop = nil
	self.world = nil
	self.localPlayer = nil
	self.initialized = false
end

MatterDebugMenuClient.applyEnabledState = MatterDebugMenuClient.ApplyEnabledState
MatterDebugMenuClient.init = MatterDebugMenuClient.Init
MatterDebugMenuClient.destroy = MatterDebugMenuClient.Destroy

return MatterDebugMenuClient :: MatterDebugMenuClient
]]></string>
