local DEFAULT_ROOT_UPRIGHT_TOLERANCE_DEGREES = 1.5
local DEFAULT_HEAD_LOOK_MAX_YAW_DEGREES = 28
local DEFAULT_HEAD_LOOK_MAX_SCREEN_DISTANCE_PIXELS = 320
local DEFAULT_HEAD_LOOK_MAX_WORLD_DISTANCE = 12
