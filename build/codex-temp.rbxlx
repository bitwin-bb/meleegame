local DEFAULT_BREAK_DEBRIS_VISUAL = BREAK_DEBRIS_VISUALS[BuildServiceUtils.TILE_ID.STONE]
local BREAK_CHUNK_ANIMATION_SKIP_SECONDS = 1.5
local PRIMARY_INPUT_USER_TYPES = {
