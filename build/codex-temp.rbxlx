MagicServiceServer.createProjectilePart = MagicServiceServer.CreateProjectilePart
MagicServiceServer.acquireProjectilePart = MagicServiceServer.AcquireProjectilePart
MagicServiceServer.releaseProjectile = MagicServiceServer.ReleaseProjectile
MagicServiceServer.resolveCastOriginAndDirection = MagicServiceServer.ResolveCastOriginAndDirection
MagicServiceServer.invokeWeaponCallback = MagicServiceServer.InvokeWeaponCallback
MagicServiceServer.resolveHumanoidRootPart = MagicServiceServer.ResolveHumanoidRootPart
MagicServiceServer.collectOverlapParts = MagicServiceServer.CollectOverlapParts
MagicServiceServer.isValidHumanoidTarget = MagicServiceServer.IsValidHumanoidTarget
MagicServiceServer.applyKnockbackToHumanoid = MagicServiceServer.ApplyKnockbackToHumanoid
MagicServiceServer.damageHumanoidTarget = MagicServiceServer.DamageHumanoidTarget
MagicServiceServer.applyStackingStatusEffect = MagicServiceServer.ApplyStackingStatusEffect
MagicServiceServer.applySplashEffect = MagicServiceServer.ApplySplashEffect
MagicServiceServer.findNearestChainTarget = MagicServiceServer.FindNearestChainTarget
MagicServiceServer.applyChainEffect = MagicServiceServer.ApplyChainEffect
MagicServiceServer.applyEffectsFromHit = MagicServiceServer.ApplyEffectsFromHit
MagicServiceServer.expireProjectile = MagicServiceServer.ExpireProjectile
MagicServiceServer.handleProjectileHit = MagicServiceServer.HandleProjectileHit
MagicServiceServer.findNearestHomingTarget = MagicServiceServer.FindNearestHomingTarget
MagicServiceServer.stepProjectileHoming = MagicServiceServer.StepProjectileHoming
MagicServiceServer.resolveProjectileCollision = MagicServiceServer.ResolveProjectileCollision
MagicServiceServer.stepProjectiles = MagicServiceServer.StepProjectiles
MagicServiceServer.stepEffects = MagicServiceServer.StepEffects
MagicServiceServer.spawnProjectile = MagicServiceServer.SpawnProjectile
MagicServiceServer.executeCast = MagicServiceServer.ExecuteCast
MagicServiceServer.onMagicCastCommitted = MagicServiceServer.OnMagicCastCommitted
MagicServiceServer.stepHeldInput = MagicServiceServer.StepHeldInput
MagicServiceServer.onHeartbeat = MagicServiceServer.OnHeartbeat
MagicServiceServer.bindCharacter = MagicServiceServer.BindCharacter
MagicServiceServer.bindBackpack = MagicServiceServer.BindBackpack
MagicServiceServer.createMagicController = MagicServiceServer.CreateMagicController
MagicServiceServer.trackPlayer = MagicServiceServer.TrackPlayer
MagicServiceServer.untrackPlayer = MagicServiceServer.UntrackPlayer
MagicServiceServer.registerModifierProvider = MagicServiceServer.RegisterModifierProvider
MagicServiceServer.unregisterModifierProvider = MagicServiceServer.UnregisterModifierProvider
MagicServiceServer.registerWeaponDefinition = MagicServiceServer.RegisterWeaponDefinition
MagicServiceServer.registerWeaponModule = MagicServiceServer.RegisterWeaponModule
MagicServiceServer.registerDefinitionsFromFolder = MagicServiceServer.RegisterDefinitionsFromFolder
MagicServiceServer.init = MagicServiceServer.Init
MagicServiceServer.destroy = MagicServiceServer.Destroy

type MagicServiceServer = typeof(MagicServiceServer) & {
	networker: Networker.Server,
	inventoryService: InventoryServiceServerObject,
	manaService: ManaServiceServerObject?,
	npcService: NpcServiceServerObject?,
	bossService: BossServiceServerObject?,
	hpService: HpServiceServerObject?,
	playerRuntimes: { [Player]: PlayerRuntime },
	projectilePools: { [string]: { [string]: any } },
	activeProjectiles: { [number]: any },
	activeEffectsByHumanoid: { [Humanoid]: { [string]: any } },
	modifierProviders: { [string]: (...any) -> any },
	definitionOverrides: { [string]: any },
	projectileFolder: Folder,
	nextProjectileId: number,
	fixedStepAccumulator: number,
	playerAddedConnection: RBXScriptConnection?,
	playerRemovingConnection: RBXScriptConnection?,
	heartbeatConnection: RBXScriptConnection?,
}

return MagicServiceServer :: MagicServiceServer
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="1056">
              <Properties>
                <string name="Name">ManaServiceServer</string>
                <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerScriptService = game:GetService("ServerScriptService")

local ManaServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.ManaServiceUtils)
local Networker = require(script:FindFirstAncestor("game").Shared.Modules.Networking.Networker)
local PlayerDataServiceServer = require(script:FindFirstAncestor("game").Server.Services.PlayerDataServiceServer)
local PlayerServiceServer = require(script:FindFirstAncestor("game").Server.Services.PlayerServiceServer)

type ManaServiceState = ManaServiceUtils.ManaServiceState

type PlayerRuntime = {
	state: ManaServiceState,
	loadToken: number,
	hasResolvedPersistedLoad: boolean,
	stateChangedBeforePersistedLoad: boolean,
	dirty: boolean,
	lastPersistAt: number,
	lastStatePushAt: number,
}

type PlayerDataServiceServerObject = {
	waitForData: (self: PlayerDataServiceServerObject, player: Player, timeoutSecondsRaw: any) -> any,
	isLoaded: (self: PlayerDataServiceServerObject, player: Player) -> boolean,
	getValue: (self: PlayerDataServiceServerObject, player: Player, pathRaw: any, fallback: any) -> any,
	setValue: (
		self: PlayerDataServiceServerObject,
		player: Player,
		pathRaw: any,
		value: any,
		replicateToClientRaw: any
	) -> boolean,
	savePlayerData: (self: PlayerDataServiceServerObject, player: Player) -> boolean,
}

local ManaServiceServer = {}

local STATE_PUSH_INTERVAL = 0.1
local PERSIST_INTERVAL_SECONDS = 2
local DATA_LOAD_TIMEOUT_SECONDS = 20
local REGEN_PUSH_EPSILON = 0.01

local function sanitizeNumber(valueRaw: any, fallback: number, minimum: number?, maximum: number?): number
	local value = fallback
	if typeof(valueRaw) == "number" and valueRaw == valueRaw then
		value = valueRaw
	elseif typeof(valueRaw) == "string" then
		local parsed = tonumber(valueRaw)
		if parsed ~= nil and parsed == parsed then
			value = parsed
		end
	end

	if minimum ~= nil and value < minimum then
		value = minimum
	end
	if maximum ~= nil and value > maximum then
		value = maximum
	end
	return value
end

function ManaServiceServer.CreateRuntime(self: ManaServiceServer): PlayerRuntime
	return {
		state = ManaServiceUtils.createDefaultState(),
		loadToken = 0,
		hasResolvedPersistedLoad = false,
		stateChangedBeforePersistedLoad = false,
		dirty = false,
		lastPersistAt = 0,
		lastStatePushAt = 0,
	}
end

function ManaServiceServer.GetRuntime(self: ManaServiceServer, player: Player): PlayerRuntime
	local runtime = self.playerRuntimes[player]
	if runtime ~= nil then
		return runtime
	end

	local nextRuntime = self:createRuntime()
	self.playerRuntimes[player] = nextRuntime
	return nextRuntime
end

function ManaServiceServer.PushState(self: ManaServiceServer, player: Player, runtime: PlayerRuntime, forceRaw: any)
	local force = forceRaw == true
	local now = os.clock()
	if not force and now - runtime.lastStatePushAt < STATE_PUSH_INTERVAL then
		return
	end

	runtime.lastStatePushAt = now
	self.networker:fire(player, ManaServiceUtils.CLIENT_METHOD_APPLY_STATE, ManaServiceUtils.cloneState(runtime.state))
end

function ManaServiceServer.PersistRuntime(self: ManaServiceServer, player: Player, runtime: PlayerRuntime): boolean
	if not runtime.dirty then
		return false
	end
	if not runtime.hasResolvedPersistedLoad then
		return false
	end

	local playerDataService = self.playerDataService
	if playerDataService == nil then
		return false
	end
	if not playerDataService:isLoaded(player) then
		return false
	end

	local payload = ManaServiceUtils.serializeStateForData(runtime.state)
	local success, didSet = pcall(function()
		return playerDataService:setValue(player, self.dataPath, payload, false)
	end)
	if not success then
		return false
	end
	if didSet ~= true then
		return false
	end

	runtime.dirty = false
	runtime.lastPersistAt = os.clock()
	return true
end

function ManaServiceServer.ApplyState(
	self: ManaServiceServer,
	player: Player,
	runtime: PlayerRuntime,
	nextManaRaw: any,
	nextMaxManaRaw: any,
	nextRegenRaw: any,
	markDirtyRaw: any,
	forcePushRaw: any
)
	local nextState = ManaServiceUtils.createState(
		nextManaRaw,
		nextMaxManaRaw,
		nextRegenRaw,
		runtime.hasResolvedPersistedLoad,
		runtime.state
	)
	runtime.state = nextState

	if markDirtyRaw == true then
		runtime.dirty = true
		if not runtime.hasResolvedPersistedLoad then
			runtime.stateChangedBeforePersistedLoad = true
		end
	end

	self:pushState(player, runtime, forcePushRaw)
end

function ManaServiceServer.LoadPersistedState(self: ManaServiceServer, player: Player, loadToken: number)
	local runtime = self.playerRuntimes[player]
	if runtime == nil or runtime.loadToken ~= loadToken then
		return
	end

	local playerDataService = self.playerDataService
	if playerDataService ~= nil then
		pcall(function()
			playerDataService:waitForData(player, self.dataLoadTimeoutSeconds)
		end)
	end

	runtime = self.playerRuntimes[player]
	if runtime == nil or runtime.loadToken ~= loadToken then
		return
	end

	local persistedRaw = nil
	if playerDataService ~= nil then
		local readSuccess, readResult = pcall(function()
			return playerDataService:getValue(player, self.dataPath, nil)
		end)
		if readSuccess then
			persistedRaw = readResult
		else
		end
	end

	runtime = self.playerRuntimes[player]
	if runtime == nil or runtime.loadToken ~= loadToken then
		return
	end

	runtime.hasResolvedPersistedLoad = true
	if runtime.stateChangedBeforePersistedLoad then
		runtime.state = ManaServiceUtils.createState(
			runtime.state.mana,
			runtime.state.maxMana,
			runtime.state.regenPerSecond,
			true,
			runtime.state
		)
		self:pushState(player, runtime, true)
		if runtime.dirty then
			self:persistRuntime(player, runtime)
		end
		return
	end

	if persistedRaw ~= nil then
		runtime.state = ManaServiceUtils.createStateFromData(persistedRaw, runtime.state, true)
	else
		runtime.state = ManaServiceUtils.createState(
			runtime.state.mana,
			runtime.state.maxMana,
			runtime.state.regenPerSecond,
			true,
			runtime.state
		)
		runtime.dirty = true
	end

	self:pushState(player, runtime, true)
	if runtime.dirty then
		self:persistRuntime(player, runtime)
	end
end

function ManaServiceServer.StepRegen(self: ManaServiceServer, dt: number)
	for player, runtime in self.playerRuntimes do
		local state = runtime.state
		if state.regenPerSecond > 0 and state.mana < state.maxMana then
			local nextMana = math.clamp(state.mana + state.regenPerSecond * dt, 0, state.maxMana)
			if math.abs(nextMana - state.mana) >= REGEN_PUSH_EPSILON then
				self:applyState(player, runtime, nextMana, state.maxMana, state.regenPerSecond, true, false)
			end
		end

		if runtime.dirty and runtime.hasResolvedPersistedLoad then
			if os.clock() - runtime.lastPersistAt >= PERSIST_INTERVAL_SECONDS then
				self:persistRuntime(player, runtime)
			end
		end
	end
end

function ManaServiceServer.TrackPlayer(self: ManaServiceServer, player: Player)
	local runtime = self:getRuntime(player)
	runtime.loadToken += 1
	runtime.state = ManaServiceUtils.createDefaultState()
	runtime.hasResolvedPersistedLoad = false
	runtime.stateChangedBeforePersistedLoad = false
	runtime.dirty = false
	runtime.lastPersistAt = 0
	runtime.lastStatePushAt = 0
	self:pushState(player, runtime, true)

	local loadToken = runtime.loadToken
	task.spawn(function()
		self:loadPersistedState(player, loadToken)
	end)
end

function ManaServiceServer.UntrackPlayer(self: ManaServiceServer, player: Player)
	local runtime = self.playerRuntimes[player]
	if runtime == nil then
		return
	end

	self:persistRuntime(player, runtime)
	if self.playerDataService ~= nil then
		pcall(function()
			self.playerDataService:savePlayerData(player)
		end)
	end

	runtime.loadToken += 1
	self.playerRuntimes[player] = nil
end

function ManaServiceServer.RequestSync(self: ManaServiceServer, player: Player)
	if self.playerRuntimes[player] == nil then
		self:trackPlayer(player)
		return
	end
	local runtime = self:getRuntime(player)
	self:pushState(player, runtime, true)
end

function ManaServiceServer.GetState(self: ManaServiceServer, player: Player): ManaServiceState
	local runtime = self:getRuntime(player)
	return ManaServiceUtils.cloneState(runtime.state)
end

function ManaServiceServer.IsReady(self: ManaServiceServer, player: Player): boolean
	local runtime = self.playerRuntimes[player]
	if runtime == nil then
		return false
	end
	return runtime.hasResolvedPersistedLoad
end

function ManaServiceServer.GetMana(self: ManaServiceServer, player: Player?): number?
	if player == nil then
		return nil
	end
	local runtime = self.playerRuntimes[player]
	if runtime == nil then
		return nil
	end
	return runtime.state.mana
end

function ManaServiceServer.GetMaxMana(self: ManaServiceServer, player: Player?): number?
	if player == nil then
		return nil
	end
	local runtime = self.playerRuntimes[player]
	if runtime == nil then
		return nil
	end
	return runtime.state.maxMana
end

function ManaServiceServer.GetRegenPerSecond(self: ManaServiceServer, player: Player?): number?
	if player == nil then
		return nil
	end
	local runtime = self.playerRuntimes[player]
	if runtime == nil then
		return nil
	end
	return runtime.state.regenPerSecond
end

function ManaServiceServer.CanConsumeMana(
	self: ManaServiceServer,
	player: Player?,
	amountRaw: any,
	_contextRaw: any
): boolean
	if player == nil then
		return false
	end
	local runtime = self.playerRuntimes[player]
	if runtime == nil then
		return false
	end

	local amount = sanitizeNumber(amountRaw, 0, 0, 1_000_000)
	if amount <= 0 then
		return true
	end
	return runtime.state.mana + 1e-6 >= amount
end

function ManaServiceServer.ConsumeMana(
	self: ManaServiceServer,
	player: Player?,
	amountRaw: any,
	_contextRaw: any
): boolean
	if player == nil then
		return false
	end
	local runtime = self.playerRuntimes[player]
	if runtime == nil then
		return false
	end

	local amount = sanitizeNumber(amountRaw, 0, 0, 1_000_000)
	if amount <= 0 then
		return true
	end
	if runtime.state.mana + 1e-6 < amount then
		return false
	end

	self:applyState(
		player,
		runtime,
		runtime.state.mana - amount,
		runtime.state.maxMana,
		runtime.state.regenPerSecond,
		true,
		false
	)
	if runtime.hasResolvedPersistedLoad and os.clock() - runtime.lastPersistAt >= PERSIST_INTERVAL_SECONDS then
		self:persistRuntime(player, runtime)
	end
	return true
end

function ManaServiceServer.AddMana(self: ManaServiceServer, player: Player?, amountRaw: any, _contextRaw: any): number?
	if player == nil then
		return nil
	end
	local runtime = self.playerRuntimes[player]
	if runtime == nil then
		return nil
	end

	local amount = sanitizeNumber(amountRaw, 0, 0, 1_000_000)
	if amount <= 0 then
		return runtime.state.mana
	end

	local nextMana = math.clamp(runtime.state.mana + amount, 0, runtime.state.maxMana)
	if math.abs(nextMana - runtime.state.mana) <= 1e-6 then
		return runtime.state.mana
	end

	self:applyState(player, runtime, nextMana, runtime.state.maxMana, runtime.state.regenPerSecond, true, false)
	if runtime.hasResolvedPersistedLoad and os.clock() - runtime.lastPersistAt >= PERSIST_INTERVAL_SECONDS then
		self:persistRuntime(player, runtime)
	end
	return runtime.state.mana
end

function ManaServiceServer.SetMana(self: ManaServiceServer, player: Player?, manaRaw: any, _contextRaw: any): number?
	if player == nil then
		return nil
	end
	local runtime = self.playerRuntimes[player]
	if runtime == nil then
		return nil
	end

	local nextMana = sanitizeNumber(manaRaw, runtime.state.mana, 0, runtime.state.maxMana)
	if math.abs(nextMana - runtime.state.mana) <= 1e-6 then
		return runtime.state.mana
	end

	self:applyState(player, runtime, nextMana, runtime.state.maxMana, runtime.state.regenPerSecond, true, false)
	if runtime.hasResolvedPersistedLoad and os.clock() - runtime.lastPersistAt >= PERSIST_INTERVAL_SECONDS then
		self:persistRuntime(player, runtime)
	end
	return runtime.state.mana
end

function ManaServiceServer.SetMaxMana(
	self: ManaServiceServer,
	player: Player?,
	maxManaRaw: any,
	_contextRaw: any
): number?
	if player == nil then
		return nil
	end
	local runtime = self.playerRuntimes[player]
	if runtime == nil then
		return nil
	end

	local nextMaxMana = sanitizeNumber(maxManaRaw, runtime.state.maxMana, 1, 100000)
	local nextMana = math.clamp(runtime.state.mana, 0, nextMaxMana)
	if math.abs(nextMaxMana - runtime.state.maxMana) <= 1e-6 and math.abs(nextMana - runtime.state.mana) <= 1e-6 then
		return runtime.state.maxMana
	end

	self:applyState(player, runtime, nextMana, nextMaxMana, runtime.state.regenPerSecond, true, false)
	if runtime.hasResolvedPersistedLoad and os.clock() - runtime.lastPersistAt >= PERSIST_INTERVAL_SECONDS then
		self:persistRuntime(player, runtime)
	end
	return runtime.state.maxMana
end

function ManaServiceServer.SetRegenPerSecond(
	self: ManaServiceServer,
	player: Player?,
	regenRaw: any,
	_contextRaw: any
): number?
	if player == nil then
		return nil
	end
	local runtime = self.playerRuntimes[player]
	if runtime == nil then
		return nil
	end

	local nextRegen = sanitizeNumber(regenRaw, runtime.state.regenPerSecond, 0, 10000)
	if math.abs(nextRegen - runtime.state.regenPerSecond) <= 1e-6 then
		return runtime.state.regenPerSecond
	end

	self:applyState(player, runtime, runtime.state.mana, runtime.state.maxMana, nextRegen, true, false)
	if runtime.hasResolvedPersistedLoad and os.clock() - runtime.lastPersistAt >= PERSIST_INTERVAL_SECONDS then
		self:persistRuntime(player, runtime)
	end
	return runtime.state.regenPerSecond
end

function ManaServiceServer.OnHeartbeat(self: ManaServiceServer, dt: number)
	self:stepRegen(dt)
end

function ManaServiceServer.Init(self: ManaServiceServer)
	self.networker = Networker.server.new("ManaService", self, {
		self.RequestSync,
	})
	self.playerDataService = PlayerDataServiceServer :: PlayerDataServiceServerObject
	self.playerRuntimes = {}
	self.dataPath = ManaServiceUtils.getDefaultDataPath()
	self.dataLoadTimeoutSeconds = DATA_LOAD_TIMEOUT_SECONDS

	for _, player in Players:GetPlayers() do
		if PlayerServiceServer:isGameplayActiveForPlayer(player) then
			self:trackPlayer(player)
		end
	end

	self.playerAddedConnection = Players.PlayerAdded:Connect(function(player: Player)
		if PlayerServiceServer:isGameplayActiveForPlayer(player) then
			self:trackPlayer(player)
		end
	end)

	self.playerRemovingConnection = Players.PlayerRemoving:Connect(function(player: Player)
		self:untrackPlayer(player)
	end)

	self.heartbeatConnection = RunService.Heartbeat:Connect(function(dt: number)
		self:onHeartbeat(dt)
	end)
end

function ManaServiceServer.Destroy(self: ManaServiceServer)
	if self.playerAddedConnection ~= nil then
		self.playerAddedConnection:Disconnect()
		self.playerAddedConnection = nil
	end
	if self.playerRemovingConnection ~= nil then
		self.playerRemovingConnection:Disconnect()
		self.playerRemovingConnection = nil
	end
	if self.heartbeatConnection ~= nil then
		self.heartbeatConnection:Disconnect()
		self.heartbeatConnection = nil
	end

	for player in self.playerRuntimes do
		self:untrackPlayer(player)
	end

	if self.networker ~= nil then
		self.networker:destroy()
	end
end

ManaServiceServer.createRuntime = ManaServiceServer.CreateRuntime
ManaServiceServer.getRuntime = ManaServiceServer.GetRuntime
ManaServiceServer.pushState = ManaServiceServer.PushState
ManaServiceServer.persistRuntime = ManaServiceServer.PersistRuntime
ManaServiceServer.applyState = ManaServiceServer.ApplyState
ManaServiceServer.loadPersistedState = ManaServiceServer.LoadPersistedState
ManaServiceServer.stepRegen = ManaServiceServer.StepRegen
ManaServiceServer.trackPlayer = ManaServiceServer.TrackPlayer
ManaServiceServer.untrackPlayer = ManaServiceServer.UntrackPlayer
ManaServiceServer.requestSync = ManaServiceServer.RequestSync
ManaServiceServer.getState = ManaServiceServer.GetState
ManaServiceServer.isReady = ManaServiceServer.IsReady
ManaServiceServer.getMana = ManaServiceServer.GetMana
ManaServiceServer.getMaxMana = ManaServiceServer.GetMaxMana
ManaServiceServer.getRegenPerSecond = ManaServiceServer.GetRegenPerSecond
ManaServiceServer.canConsumeMana = ManaServiceServer.CanConsumeMana
ManaServiceServer.consumeMana = ManaServiceServer.ConsumeMana
ManaServiceServer.addMana = ManaServiceServer.AddMana
ManaServiceServer.setMana = ManaServiceServer.SetMana
ManaServiceServer.setMaxMana = ManaServiceServer.SetMaxMana
ManaServiceServer.setRegenPerSecond = ManaServiceServer.SetRegenPerSecond
ManaServiceServer.onHeartbeat = ManaServiceServer.OnHeartbeat
ManaServiceServer.init = ManaServiceServer.Init
ManaServiceServer.destroy = ManaServiceServer.Destroy

export type ManaServiceServer = typeof(ManaServiceServer) & {
	networker: Networker.Server,
	playerDataService: PlayerDataServiceServerObject,
	playerRuntimes: { [Player]: PlayerRuntime },
	dataPath: { string },
	dataLoadTimeoutSeconds: number,
	playerAddedConnection: RBXScriptConnection?,
	playerRemovingConnection: RBXScriptConnection?,
	heartbeatConnection: RBXScriptConnection?,
}

return ManaServiceServer :: ManaServiceServer
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="1057">
              <Properties>
                <string name="Name">MeleeServiceServer</string>
                <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local Workspace = game:GetService("Workspace")

local BossServiceServer = require(script:FindFirstAncestor("game").Server.Services.BossServiceServer)
local InventoryServiceServer = require(script:FindFirstAncestor("game").Server.Services.InventoryServiceServer)
local InventoryServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.InventoryServiceUtils)
local Janitor = require(ReplicatedStorage.Packages.Janitor)
local Melee = require(script:FindFirstAncestor("game").Shared.Classes.Melee)
local MeleeServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.MeleeServiceUtils)
local Networker = require(script:FindFirstAncestor("game").Shared.Modules.Networking.Networker)
local NevermoreSupport = require(script:FindFirstAncestor("game").Shared.Modules.Core.NevermoreSupport)
local NpcServiceServer = require(script:FindFirstAncestor("game").Server.Services.NpcServiceServer)
local PlayerServiceServer = require(script:FindFirstAncestor("game").Server.Services.PlayerServiceServer)
local RagdollServiceServer = require(script:FindFirstAncestor("game").Server.Services.RagdollServiceServer)
local RaycastHitbox = require(ReplicatedStorage.Packages.RaycastHitbox)
local ServerBinderSupport = require(script:FindFirstAncestor("game").Server.Binders.ServerBinderSupport)

type MeleeWeaponConfig = MeleeServiceUtils.MeleeWeaponConfig
type InventoryState = InventoryServiceUtils.InventoryState

type JanitorClass = {
	GiveChore: (self: JanitorClass, chore: any, ...any) -> (),
	Clean: (self: JanitorClass) -> (),
	Destroy: (self: JanitorClass) -> (),
}

type MeleeController = {
	inputBegan: (self: MeleeController, triggerRaw: any) -> boolean,
	inputEnded: (self: MeleeController, triggerRaw: any) -> boolean,
	setCharacter: (self: MeleeController, characterRaw: any) -> (),
	destroy: (self: MeleeController) -> (),
}

type HitboxConnection = {
	Disconnect: (self: HitboxConnection) -> (),
}

type HitboxSignal = {
	Connect: (
		self: HitboxSignal,
		callback: (part: BasePart, humanoid: Humanoid?, raycastResult: RaycastResult?, group: string?) -> ()
	) -> HitboxConnection,
}

type HitboxObject = {
	RaycastParams: RaycastParams?,
	Visualizer: boolean,
	DebugLog: boolean,
	OnHit: HitboxSignal,
	HitStart: (self: HitboxObject, seconds: number?) -> (),
	HitStop: (self: HitboxObject) -> (),
	Destroy: (self: HitboxObject) -> (),
	LinkAttachments: (self: HitboxObject, attachment1: Attachment, attachment2: Attachment) -> (),
	UnlinkAttachments: (self: HitboxObject, attachment: Attachment) -> (),
	SetPoints: (self: HitboxObject, object: BasePart | Bone, vectorPoints: { Vector3 }, group: string?) -> (),
	RemovePoints: (self: HitboxObject, object: BasePart | Bone, vectorPoints: { Vector3 }) -> (),
}

type PlayerRuntime = {
	playerJanitor: JanitorClass,
	characterJanitor: JanitorClass,
	character: Model?,
	humanoid: Humanoid?,
	rootPart: BasePart?,
	inputHeld: boolean,
	equippedItemId: string?,
	equippedSlot: number?,
	equippedTool: Tool?,
	equippedWeaponConfig: MeleeWeaponConfig?,
	meleeController: MeleeController?,
	hitbox: HitboxObject?,
	hitboxConnection: HitboxConnection?,
	hitboxPointsPart: BasePart?,
	hitboxPoints: { Vector3 },
	hitboxCleanupPromise: any?,
}

type InventoryServiceServerObject = {
	getState: (self: InventoryServiceServerObject, player: Player) -> InventoryState,
}

type RagdollServiceServerObject = {
	isPlayerRagdolled: (self: RagdollServiceServerObject, player: Player) -> boolean,
}

type BossServiceServerObject = {
	damageBossFromHitPart: (
		self: BossServiceServerObject,
		hitPartRaw: any,
		damageRaw: any,
		sourceRaw: any?,
		damageContextRaw: any?
	) -> number,
	damageBossesInBox: (
		self: BossServiceServerObject,
		boxCFrameRaw: any,
		boxSizeRaw: any,
		damageRaw: any,
		sourceRaw: any?,
		damageContextRaw: any?
	) -> number,
}

local MeleeServiceServer = {}

local HITBOX_CLEANUP_PADDING = 0.03
local RAYCAST_HITBOX_DEBUG = false
local DEFAULT_NPC_OVERLAP_QUERY_MAX_PARTS = 64

local function isHumanoidAlive(humanoid: Humanoid?): boolean
	if humanoid == nil then
		return false
	end
	if humanoid.Health <= 0 then
		return false
	end
	return humanoid:GetState() ~= Enum.HumanoidStateType.Dead
end

local function resolveHumanoidAndRootPart(character: Model?): (Humanoid?, BasePart?)
	if character == nil then
		return nil, nil
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local rootPartCandidate = character:FindFirstChild("HumanoidRootPart")
	local rootPart = if rootPartCandidate and rootPartCandidate:IsA("BasePart") then rootPartCandidate else nil
	return humanoid, rootPart
end

local function resolveToolHandlePart(toolRaw: any): BasePart?
	if typeof(toolRaw) ~= "Instance" or not toolRaw:IsA("Tool") then
		return nil
	end

	local tool = toolRaw :: Tool
	local handleCandidate = tool:FindFirstChild("Handle")
	if handleCandidate ~= nil and handleCandidate:IsA("BasePart") then
		return handleCandidate
	end

	local directBasePart = tool:FindFirstChildWhichIsA("BasePart")
	if directBasePart ~= nil then
		return directBasePart
	end

	return tool:FindFirstChildWhichIsA("BasePart", true)
end

local function resolveCharacterHandPart(character: Model?): BasePart?
	if character == nil then
		return nil
	end

	for _, partName in { "RightHand", "Right Arm", "RightLowerArm", "RightUpperArm", "LeftHand", "Left Arm" } do
		local candidate = character:FindFirstChild(partName)
		if candidate ~= nil and candidate:IsA("BasePart") then
			return candidate
		end
	end

	return nil
end

local function resolveHitboxAnchorPart(runtime: PlayerRuntime): BasePart?
	local character = runtime.character
	local equippedTool = runtime.equippedTool
	if equippedTool ~= nil and character ~= nil and equippedTool:IsDescendantOf(character) then
		local toolPart = resolveToolHandlePart(equippedTool)
		if toolPart ~= nil then
			return toolPart
		end
	end

	local handPart = resolveCharacterHandPart(character)
	if handPart ~= nil then
		return handPart
	end

	return runtime.rootPart
end

local function resolveNpcOverlapAnchorPart(runtime: PlayerRuntime): BasePart?
	if runtime.rootPart ~= nil then
		return runtime.rootPart
	end

	local handPart = resolveCharacterHandPart(runtime.character)
	if handPart ~= nil then
		return handPart
	end

	return resolveHitboxAnchorPart(runtime)
end

local function applyNpcOverlapDamageFallback(player: Player, runtime: PlayerRuntime, weaponConfig: MeleeWeaponConfig)
	if not weaponConfig.canHitNpcs then
		return
	end
	if runtime.character == nil then
		return
	end

	local damage = math.max(0, weaponConfig.damage)
	if damage <= 0 then
		return
	end

	local anchorPart = resolveNpcOverlapAnchorPart(runtime)
	if anchorPart == nil then
		return
	end

	local overlapParams = OverlapParams.new()
	overlapParams.FilterType = Enum.RaycastFilterType.Exclude
	overlapParams.FilterDescendantsInstances = { runtime.character }
	overlapParams.MaxParts = DEFAULT_NPC_OVERLAP_QUERY_MAX_PARTS

	local querySize = Vector3.new(
		math.max(1.5, weaponConfig.width * 1.3),
		math.max(2, weaponConfig.height + 1.25),
		math.max(2.25, weaponConfig.range + 1)
	)
	local queryCFrame = anchorPart.CFrame * CFrame.new(0, querySize.Y * 0.15, -querySize.Z * 0.5)
	if runtime.rootPart ~= nil and anchorPart == runtime.rootPart then
		querySize = Vector3.new(querySize.X, querySize.Y, querySize.Z * 2)
		queryCFrame = CFrame.new(anchorPart.Position + Vector3.new(0, querySize.Y * 0.15, 0))
	end

	local ok, overlapPartsOrError = pcall(function()
		return Workspace:GetPartBoundsInBox(queryCFrame, querySize, overlapParams)
	end)
	if not ok or typeof(overlapPartsOrError) ~= "table" then
		overlapPartsOrError = {}
	end

	local seenModels: { [Model]: true } = {}
	local overlapDamageApplied = 0
	for _, candidate in overlapPartsOrError do
		if typeof(candidate) ~= "Instance" or not candidate:IsA("BasePart") then
			continue
		end

		local model = candidate:FindFirstAncestorOfClass("Model")
		if model ~= nil then
			if seenModels[model] == true then
				continue
			end
			seenModels[model] = true
		end

		local appliedDamage = (NpcServiceServer :: any):damageNpcFromHitPart(candidate, damage, player, "Melee")
		if typeof(appliedDamage) == "number" and appliedDamage > 0 then
			overlapDamageApplied += appliedDamage
			continue
		end

		local bossDamage = (BossServiceServer :: BossServiceServerObject):damageBossFromHitPart(
			candidate,
			damage,
			player,
			"Melee"
		)
		if typeof(bossDamage) == "number" and bossDamage > 0 then
			overlapDamageApplied += bossDamage
		end
	end
	if overlapDamageApplied > 0 then
		return
	end

	local runtimeDamageOk, runtimeDamageOrError = pcall(function()
		return (NpcServiceServer :: any):damageNpcsInBox(queryCFrame, querySize, damage, player, "Melee")
	end)
	if runtimeDamageOk and typeof(runtimeDamageOrError) == "number" and runtimeDamageOrError > 0 then
		return
	end

	local bossRuntimeDamage = (BossServiceServer :: BossServiceServerObject):damageBossesInBox(
		queryCFrame,
		querySize,
		damage,
		player,
		"Melee"
	)
	if typeof(bossRuntimeDamage) == "number" and bossRuntimeDamage > 0 then
		return
	end
end

local function shallowCopyWeaponConfig(weaponConfig: MeleeWeaponConfig): MeleeWeaponConfig
	return {
		itemId = weaponConfig.itemId,
		displayName = weaponConfig.displayName,
		damage = weaponConfig.damage,
		cooldown = weaponConfig.cooldown,
		slashCooldown = weaponConfig.slashCooldown,
		slashResetCooldown = weaponConfig.slashResetCooldown,
		swingDuration = weaponConfig.swingDuration,
		hitboxDuration = weaponConfig.hitboxDuration,
		range = weaponConfig.range,
		width = weaponConfig.width,
		height = weaponConfig.height,
		pointCount = weaponConfig.pointCount,
		autoRepeatWhileHeld = weaponConfig.autoRepeatWhileHeld,
		canHitPlayers = weaponConfig.canHitPlayers,
		canHitNpcs = weaponConfig.canHitNpcs,
		animations = weaponConfig.animations,
	}
end

local function isWeaponConfigEquivalent(lhsRaw: any, rhsRaw: any): boolean
	if lhsRaw == rhsRaw then
		return true
	end
	if typeof(lhsRaw) ~= "table" or typeof(rhsRaw) ~= "table" then
		return false
	end

	local lhs = lhsRaw :: MeleeWeaponConfig
	local rhs = rhsRaw :: MeleeWeaponConfig
	if lhs.itemId ~= rhs.itemId then
		return false
	end
	if lhs.displayName ~= rhs.displayName then
		return false
	end
	if lhs.damage ~= rhs.damage then
		return false
	end
	if lhs.cooldown ~= rhs.cooldown then
		return false
	end
	if lhs.slashCooldown ~= rhs.slashCooldown then
		return false
	end
	if lhs.slashResetCooldown ~= rhs.slashResetCooldown then
		return false
	end
	if lhs.swingDuration ~= rhs.swingDuration then
		return false
	end
	if lhs.hitboxDuration ~= rhs.hitboxDuration then
		return false
	end
	if lhs.range ~= rhs.range then
		return false
	end
	if lhs.width ~= rhs.width then
		return false
	end
	if lhs.height ~= rhs.height then
		return false
	end
	if lhs.pointCount ~= rhs.pointCount then
		return false
	end
	if lhs.autoRepeatWhileHeld ~= rhs.autoRepeatWhileHeld then
		return false
	end
	if lhs.canHitPlayers ~= rhs.canHitPlayers then
		return false
	end
	if lhs.canHitNpcs ~= rhs.canHitNpcs then
		return false
	end
	if not MeleeServiceUtils.areAnimationConfigsEquivalent(lhs.animations, rhs.animations) then
		return false
	end

	return true
end

function MeleeServiceServer.Init(self: MeleeServiceServer)
	self.networker = Networker.server.new("MeleeService", self, {
		self.RequestRefreshEquipped,
		self.RequestSetInputHeld,
	})
	self.inventoryService = InventoryServiceServer :: InventoryServiceServerObject
	self.ragdollService = RagdollServiceServer :: RagdollServiceServerObject
	self.playerRuntimes = {}
	self.binders = NevermoreSupport.getService(ServerBinderSupport)

	for _, player in Players:GetPlayers() do
		if PlayerServiceServer:isGameplayActiveForPlayer(player) then
			self:trackPlayer(player)
		end
	end

	self.playerAddedConnection = Players.PlayerAdded:Connect(function(player: Player)
		if PlayerServiceServer:isGameplayActiveForPlayer(player) then
			self:trackPlayer(player)
		end
	end)

	self.playerRemovingConnection = Players.PlayerRemoving:Connect(function(player: Player)
		self:untrackPlayer(player)
	end)
end

function MeleeServiceServer.IsAttackBlocked(self: MeleeServiceServer, player: Player, runtime: PlayerRuntime): boolean
	if not isHumanoidAlive(runtime.humanoid) then
		return true
	end

	local humanoid = runtime.humanoid
	if humanoid ~= nil and humanoid.PlatformStand and humanoid:GetState() == Enum.HumanoidStateType.Physics then
		return true
	end

	local ragdollService = self.ragdollService
	if ragdollService ~= nil then
		local ok, isRagdolledOrError = pcall(function()
			return ragdollService:isPlayerRagdolled(player)
		end)
		if ok and isRagdolledOrError == true then
			return true
		end
	end

	return false
end

function MeleeServiceServer.EnforceInputAllowed(
	self: MeleeServiceServer,
	player: Player,
	runtime: PlayerRuntime,
	reason: string
)
	if not self:isAttackBlocked(player, runtime) then
		return
	end

	if runtime.inputHeld then
		runtime.inputHeld = false
	end
	self:stopHitbox(runtime)

	local meleeController = runtime.meleeController
	if meleeController ~= nil then
		meleeController:inputEnded(reason)
	end
end

function MeleeServiceServer.CreateRuntime(self: MeleeServiceServer): PlayerRuntime
	return {
		playerJanitor = Janitor.new(),
		characterJanitor = Janitor.new(),
		character = nil,
		humanoid = nil,
		rootPart = nil,
		inputHeld = false,
		equippedItemId = nil,
		equippedSlot = nil,
		equippedTool = nil,
		equippedWeaponConfig = nil,
		meleeController = nil,
		hitbox = nil,
		hitboxConnection = nil,
		hitboxPointsPart = nil,
		hitboxPoints = {},
		hitboxCleanupPromise = nil,
	}
end

function MeleeServiceServer.GetRuntime(self: MeleeServiceServer, player: Player): PlayerRuntime
	local runtime = self.playerRuntimes[player]
	if runtime ~= nil then
		return runtime
	end

	local nextRuntime = self:createRuntime()
	self.playerRuntimes[player] = nextRuntime
	return nextRuntime
end

function MeleeServiceServer.CancelHitboxCleanupPromise(self: MeleeServiceServer, runtime: PlayerRuntime)
	local hitboxCleanupPromise = runtime.hitboxCleanupPromise
	runtime.hitboxCleanupPromise = nil
	if hitboxCleanupPromise == nil then
		return
	end
	hitboxCleanupPromise:Destroy()
end

function MeleeServiceServer.StopHitbox(self: MeleeServiceServer, runtime: PlayerRuntime)
	self:cancelHitboxCleanupPromise(runtime)
	local hitbox = runtime.hitbox
	if hitbox == nil then
		return
	end
	pcall(function()
		hitbox:HitStop()
	end)
end

function MeleeServiceServer.ClearHitboxPoints(self: MeleeServiceServer, runtime: PlayerRuntime)
	local hitbox = runtime.hitbox
	local hitboxPointsPart = runtime.hitboxPointsPart
	local hitboxPoints = runtime.hitboxPoints
	if hitbox ~= nil and hitboxPointsPart ~= nil and #hitboxPoints > 0 then
		pcall(function()
			hitbox:RemovePoints(hitboxPointsPart, hitboxPoints)
		end)
	end

	runtime.hitboxPointsPart = nil
	runtime.hitboxPoints = {}
end

function MeleeServiceServer.ApplyHitboxPoints(self: MeleeServiceServer, runtime: PlayerRuntime)
	local hitbox = runtime.hitbox
	local weaponConfig = runtime.equippedWeaponConfig
	if hitbox == nil or weaponConfig == nil then
		self:clearHitboxPoints(runtime)
		return
	end

	local anchorPart = resolveHitboxAnchorPart(runtime)
	if anchorPart == nil then
		self:clearHitboxPoints(runtime)
		return
	end

	self:clearHitboxPoints(runtime)
	local points = MeleeServiceUtils.buildHitboxPoints(weaponConfig)
	if #points <= 0 then
		return
	end

	runtime.hitboxPointsPart = anchorPart
	runtime.hitboxPoints = points
	pcall(function()
		hitbox:SetPoints(anchorPart, points)
	end)
end

function MeleeServiceServer.DestroyHitbox(self: MeleeServiceServer, runtime: PlayerRuntime)
	self:stopHitbox(runtime)
	self:clearHitboxPoints(runtime)

	local hitboxConnection = runtime.hitboxConnection
	runtime.hitboxConnection = nil
	if hitboxConnection ~= nil then
		hitboxConnection:Disconnect()
	end

	local hitbox = runtime.hitbox
	runtime.hitbox = nil
	if hitbox ~= nil then
		pcall(function()
			hitbox:Destroy()
		end)
	end
end

function MeleeServiceServer.DestroyMeleeController(self: MeleeServiceServer, runtime: PlayerRuntime)
	local meleeController = runtime.meleeController
	runtime.meleeController = nil
	if meleeController == nil then
		return
	end
	pcall(function()
		meleeController:destroy()
	end)
end

function MeleeServiceServer.OnHit(
	self: MeleeServiceServer,
	player: Player,
	runtime: PlayerRuntime,
	hitPart: BasePart,
	hitHumanoidRaw: Humanoid?
)
	local resolvedItemId = nil :: string?
	if runtime.equippedTool ~= nil then
		resolvedItemId = MeleeServiceUtils.resolveToolItemId(runtime.equippedTool)
	end
	if resolvedItemId == nil then
		resolvedItemId = runtime.equippedItemId
	end

	local weaponConfig = if resolvedItemId ~= nil then MeleeServiceUtils.resolveWeaponConfig(resolvedItemId) else nil
	if weaponConfig == nil then
		weaponConfig = runtime.equippedWeaponConfig
	end
	if weaponConfig == nil then
		return
	end

	local damage = math.max(0, weaponConfig.damage)
	if damage <= 0 then
		return
	end

	if weaponConfig.canHitNpcs then
		local serviceDamage = (NpcServiceServer :: any):damageNpcFromHitPart(hitPart, damage, player, "Melee")
		if typeof(serviceDamage) == "number" and serviceDamage > 0 then
			return
		end

		local bossDamage = (BossServiceServer :: BossServiceServerObject):damageBossFromHitPart(
			hitPart,
			damage,
			player,
			"Melee"
		)
		if typeof(bossDamage) == "number" and bossDamage > 0 then
			return
		end
	end

	local hitHumanoid = if typeof(hitHumanoidRaw) == "Instance" and hitHumanoidRaw:IsA("Humanoid")
		then hitHumanoidRaw
		else nil
	if hitHumanoid == nil then
		return
	end
	if hitHumanoid.Health <= 0 then
		return
	end

	local targetCharacter = hitHumanoid.Parent
	if targetCharacter == runtime.character then
		return
	end
	if targetCharacter == nil or not targetCharacter:IsA("Model") then
		return
	end

	local targetPlayer = Players:GetPlayerFromCharacter(targetCharacter)
	if targetPlayer ~= nil and not weaponConfig.canHitPlayers then
		return
	end
	if targetPlayer == nil and not weaponConfig.canHitNpcs then
		return
	end

	hitHumanoid:TakeDamage(damage)
end

function MeleeServiceServer.OnAttackStarted(
	self: MeleeServiceServer,
	player: Player,
	runtime: PlayerRuntime,
	_context: { [string]: any }
)
	local currentRuntime = self.playerRuntimes[player]
	if currentRuntime ~= runtime then
		return
	end
	if self:isAttackBlocked(player, runtime) then
		self:enforceInputAllowed(player, runtime, "BlockedAttackStarted")
		return
	end

	local hitbox = runtime.hitbox
	if hitbox == nil or runtime.equippedWeaponConfig == nil then
		return
	end

	self:cancelHitboxCleanupPromise(runtime)
	self:applyHitboxPoints(runtime)
	pcall(function()
		hitbox:HitStart()
	end)

	local weaponConfig = runtime.equippedWeaponConfig
	if weaponConfig ~= nil then
		applyNpcOverlapDamageFallback(player, runtime, weaponConfig)
	end
end

function MeleeServiceServer.OnSwingEnded(
	self: MeleeServiceServer,
	player: Player,
	runtime: PlayerRuntime,
	_context: { [string]: any }
)
	local currentRuntime = self.playerRuntimes[player]
	if currentRuntime ~= runtime then
		return
	end
	self:stopHitbox(runtime)
end

function MeleeServiceServer.OnAttackFinished(
	self: MeleeServiceServer,
	player: Player,
	runtime: PlayerRuntime,
	_context: { [string]: any }
)
	local currentRuntime = self.playerRuntimes[player]
	if currentRuntime ~= runtime then
		return
	end
	self:stopHitbox(runtime)
end

function MeleeServiceServer.BindCharacter(self: MeleeServiceServer, player: Player, character: Model)
	local runtime = self:getRuntime(player)
	runtime.characterJanitor:Clean()

	runtime.character = character
	runtime.humanoid, runtime.rootPart = resolveHumanoidAndRootPart(character)

	self:destroyHitbox(runtime)
	local hitbox = RaycastHitbox.new(character) :: any
	runtime.hitbox = hitbox :: HitboxObject
	hitbox.Visualizer = RAYCAST_HITBOX_DEBUG
	hitbox.DebugLog = RAYCAST_HITBOX_DEBUG

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character }
	params.IgnoreWater = true
	hitbox.RaycastParams = params

	runtime.hitboxConnection = hitbox.OnHit:Connect(
		function(hitPart: BasePart, hitHumanoid: Humanoid?, raycastResult: RaycastResult?, group: string?)
			self:onHit(player, runtime, hitPart, hitHumanoid)
		end
	)

	runtime.characterJanitor:GiveChore(character.ChildAdded:Connect(function(child: Instance)
		if child:IsA("Humanoid") or child.Name == "HumanoidRootPart" then
			runtime.humanoid, runtime.rootPart = resolveHumanoidAndRootPart(character)
			if child:IsA("Humanoid") then
				runtime.characterJanitor:GiveChore(child.Died:Connect(function()
					self:enforceInputAllowed(player, runtime, "HumanoidDied")
				end))
				runtime.characterJanitor:GiveChore(child.StateChanged:Connect(function()
					self:enforceInputAllowed(player, runtime, "HumanoidStateChanged")
				end))
				runtime.characterJanitor:GiveChore(child.HealthChanged:Connect(function()
					self:enforceInputAllowed(player, runtime, "HumanoidHealthChanged")
				end))
			end
			self:applyHitboxPoints(runtime)
			return
		end
		if child:IsA("Tool") then
			self:refreshEquippedWeaponFromInventory(player, runtime)
		end
	end))

	runtime.characterJanitor:GiveChore(character.ChildRemoved:Connect(function(child: Instance)
		if child == runtime.humanoid then
			runtime.humanoid = nil
		end
		if child == runtime.rootPart then
			runtime.rootPart = nil
			self:clearHitboxPoints(runtime)
		end
		if child:IsA("Tool") then
			self:refreshEquippedWeaponFromInventory(player, runtime)
		end
	end))

	local function shouldRefreshFromDescendant(descendant: Instance): boolean
		if not (descendant:IsA("Animation") or descendant:IsA("Sound")) then
			return false
		end

		local cursor: Instance? = descendant
		while cursor ~= nil and cursor ~= character do
			if cursor:IsA("Tool") then
				return true
			end
			cursor = cursor.Parent
		end
		return false
	end

	runtime.characterJanitor:GiveChore(character.DescendantAdded:Connect(function(descendant: Instance)
		if shouldRefreshFromDescendant(descendant) then
			self:refreshEquippedWeaponFromInventory(player, runtime)
		end
	end))

	runtime.characterJanitor:GiveChore(character.DescendantRemoving:Connect(function(descendant: Instance)
		if shouldRefreshFromDescendant(descendant) then
			self:refreshEquippedWeaponFromInventory(player, runtime)
		end
	end))

	runtime.characterJanitor:GiveChore(character.AncestryChanged:Connect(function(_: Instance, parent: Instance?)
		if parent ~= nil then
			return
		end
		runtime.character = nil
		runtime.humanoid = nil
		runtime.rootPart = nil
		self:destroyHitbox(runtime)
	end))

	local currentHumanoid = runtime.humanoid
	if currentHumanoid ~= nil then
		runtime.characterJanitor:GiveChore(currentHumanoid.Died:Connect(function()
			self:enforceInputAllowed(player, runtime, "HumanoidDied")
		end))
		runtime.characterJanitor:GiveChore(currentHumanoid.StateChanged:Connect(function()
			self:enforceInputAllowed(player, runtime, "HumanoidStateChanged")
		end))
		runtime.characterJanitor:GiveChore(currentHumanoid.HealthChanged:Connect(function()
			self:enforceInputAllowed(player, runtime, "HumanoidHealthChanged")
		end))
	end

	self:applyHitboxPoints(runtime)
	if runtime.inputHeld and runtime.meleeController ~= nil then
		self:enforceInputAllowed(player, runtime, "CharacterBound")
		if runtime.inputHeld then
			runtime.meleeController:inputBegan("CharacterBound")
		end
	end
end

function MeleeServiceServer.SetEquippedWeaponConfig(
	self: MeleeServiceServer,
	player: Player,
	runtime: PlayerRuntime,
	itemId: string?,
	slotIndex: number?,
	weaponConfig: MeleeWeaponConfig?,
	selectedTool: Tool?
)
	runtime.equippedItemId = itemId
	runtime.equippedSlot = slotIndex
	runtime.equippedTool = selectedTool
	runtime.equippedWeaponConfig = weaponConfig

	self:destroyMeleeController(runtime)
	self:stopHitbox(runtime)
	self:applyHitboxPoints(runtime)

	if weaponConfig == nil then
		return
	end

	local classConfig = MeleeServiceUtils.createMeleeClassConfig(weaponConfig, {
		autoRepeatWhileHeld = weaponConfig.autoRepeatWhileHeld,
		namedAnimationPlaybackEnabled = false,
		animations = false,
		callbacks = {
			onAttackStarted = function(_: any, context: { [string]: any })
				self:onAttackStarted(player, runtime, context)
			end,
			onSwingEnded = function(_: any, context: { [string]: any })
				self:onSwingEnded(player, runtime, context)
			end,
			onAttackFinished = function(_: any, context: { [string]: any })
				self:onAttackFinished(player, runtime, context)
			end,
		},
	})
	if classConfig == nil then
		return
	end
	classConfig.fallbackSwingDuration = weaponConfig.hitboxDuration
	classConfig.fallbackSwingPadding = 0

	local meleeController = Melee.new(classConfig) :: any
	runtime.meleeController = meleeController :: MeleeController

	self:applyHitboxPoints(runtime)
	if runtime.inputHeld then
		self:enforceInputAllowed(player, runtime, "EquipWhileHeld")
		if runtime.inputHeld then
			runtime.meleeController:inputBegan("EquipWhileHeld")
		end
	end
end

function MeleeServiceServer.RefreshEquippedWeaponFromInventory(
	self: MeleeServiceServer,
	player: Player,
	runtime: PlayerRuntime
)
	local inventoryService = self.inventoryService
	if inventoryService == nil then
		self:setEquippedWeaponConfig(player, runtime, nil, nil, nil, nil)
		return
	end

	local state = inventoryService:getState(player)
	if not InventoryServiceUtils.isLoadedState(state.loadState) then
		self:setEquippedWeaponConfig(player, runtime, nil, nil, nil, nil)
		return
	end

	local selectedSlot = state.selectedSlot
	local stack = if selectedSlot ~= nil then InventoryServiceUtils.getStack(state, selectedSlot) else nil
	local itemId = if stack ~= nil then stack.itemId else nil
	local weaponConfig = if itemId ~= nil then MeleeServiceUtils.resolveWeaponConfig(itemId) else nil
	local backpack = player:FindFirstChildOfClass("Backpack")
	local selectedTool = if itemId ~= nil
		then MeleeServiceUtils.resolveToolByItemId(runtime.character, backpack, itemId)
		else nil

	if selectedTool == nil or not MeleeServiceUtils.isMeleeTool(selectedTool) then
		weaponConfig = nil
	elseif weaponConfig ~= nil then
		local nextWeaponConfig = shallowCopyWeaponConfig(weaponConfig)
		nextWeaponConfig.animations =
			MeleeServiceUtils.resolveToolAnimationOverrides(selectedTool, weaponConfig.animations)
		weaponConfig = nextWeaponConfig
	end

	local isSameWeapon = runtime.equippedItemId == itemId
		and runtime.equippedSlot == selectedSlot
		and runtime.meleeController ~= nil
		and runtime.equippedTool == selectedTool
		and isWeaponConfigEquivalent(runtime.equippedWeaponConfig, weaponConfig)
	if isSameWeapon then
		runtime.equippedTool = selectedTool
		runtime.equippedWeaponConfig = weaponConfig
		self:applyHitboxPoints(runtime)
		return
	end

	self:setEquippedWeaponConfig(player, runtime, itemId, selectedSlot, weaponConfig, selectedTool)
end

function MeleeServiceServer.TrackPlayer(self: MeleeServiceServer, player: Player)
	local runtime = self:getRuntime(player)
	runtime.playerJanitor:Clean()
	runtime.characterJanitor:Clean()
	runtime.character = nil
	runtime.humanoid = nil
	runtime.rootPart = nil
	runtime.inputHeld = false
	runtime.equippedTool = nil
	self:destroyMeleeController(runtime)
	self:destroyHitbox(runtime)

	runtime.playerJanitor:GiveChore(player.CharacterAdded:Connect(function(character: Model)
		self:bindCharacter(player, character)
	end))

	local function bindBackpack(backpack: Backpack)
		runtime.playerJanitor:GiveChore(backpack.ChildAdded:Connect(function(child: Instance)
			if child:IsA("Tool") then
				self:refreshEquippedWeaponFromInventory(player, runtime)
			end
		end))
		runtime.playerJanitor:GiveChore(backpack.ChildRemoved:Connect(function(child: Instance)
			if child:IsA("Tool") then
				self:refreshEquippedWeaponFromInventory(player, runtime)
			end
		end))

		local function shouldRefreshFromBackpackDescendant(descendant: Instance): boolean
			if not (descendant:IsA("Animation") or descendant:IsA("Sound")) then
				return false
			end

			local cursor: Instance? = descendant
			while cursor ~= nil and cursor ~= backpack do
				if cursor:IsA("Tool") then
					return true
				end
				cursor = cursor.Parent
			end
			return false
		end

		runtime.playerJanitor:GiveChore(backpack.DescendantAdded:Connect(function(descendant: Instance)
			if shouldRefreshFromBackpackDescendant(descendant) then
				self:refreshEquippedWeaponFromInventory(player, runtime)
			end
		end))

		runtime.playerJanitor:GiveChore(backpack.DescendantRemoving:Connect(function(descendant: Instance)
			if shouldRefreshFromBackpackDescendant(descendant) then
				self:refreshEquippedWeaponFromInventory(player, runtime)
			end
		end))
	end

	runtime.playerJanitor:GiveChore(player.ChildAdded:Connect(function(child: Instance)
		if child:IsA("Backpack") then
			bindBackpack(child)
			self:refreshEquippedWeaponFromInventory(player, runtime)
		end
	end))

	if player.Character ~= nil then
		self:bindCharacter(player, player.Character)
	end

	local backpack = player:FindFirstChildOfClass("Backpack")
	if backpack ~= nil then
		bindBackpack(backpack)
	end

	self:refreshEquippedWeaponFromInventory(player, runtime)
end

function MeleeServiceServer.UntrackPlayer(self: MeleeServiceServer, player: Player)
	local runtime = self.playerRuntimes[player]
	if runtime == nil then
		return
	end

	runtime.inputHeld = false
	self:destroyMeleeController(runtime)
	self:destroyHitbox(runtime)
	runtime.playerJanitor:Destroy()
	runtime.characterJanitor:Destroy()
	self.playerRuntimes[player] = nil
end

function MeleeServiceServer.RequestRefreshEquipped(self: MeleeServiceServer, player: Player)
	if self.playerRuntimes[player] == nil then
		self:trackPlayer(player)
	end
	local runtime = self:getRuntime(player)
	self:refreshEquippedWeaponFromInventory(player, runtime)
end

function MeleeServiceServer.RequestSetInputHeld(self: MeleeServiceServer, player: Player, inputHeldRaw: any)
	if self.playerRuntimes[player] == nil then
		self:trackPlayer(player)
	end
	local runtime = self:getRuntime(player)
	local inputHeld = inputHeldRaw == true
	if inputHeld and self:isAttackBlocked(player, runtime) then
		inputHeld = false
	end
	runtime.inputHeld = inputHeld

	self:refreshEquippedWeaponFromInventory(player, runtime)
	self:enforceInputAllowed(player, runtime, "InputHeldRequest")

	local meleeController = runtime.meleeController
	if meleeController == nil then
		if not inputHeld then
			self:stopHitbox(runtime)
		end
		return
	end

	if inputHeld then
		meleeController:inputBegan("ClientInputBegan")
	else
		meleeController:inputEnded("ClientInputEnded")
	end
end

function MeleeServiceServer.Destroy(self: MeleeServiceServer)
	if self.playerAddedConnection ~= nil then
		self.playerAddedConnection:Disconnect()
		self.playerAddedConnection = nil
	end
	if self.playerRemovingConnection ~= nil then
		self.playerRemovingConnection:Disconnect()
		self.playerRemovingConnection = nil
	end

	for player, runtime in self.playerRuntimes do
		runtime.inputHeld = false
		self:destroyMeleeController(runtime)
		self:destroyHitbox(runtime)
		runtime.playerJanitor:Destroy()
		runtime.characterJanitor:Destroy()
		self.playerRuntimes[player] = nil
	end

	if self.networker ~= nil then
		self.networker:destroy()
	end
end

MeleeServiceServer.init = MeleeServiceServer.Init
MeleeServiceServer.isAttackBlocked = MeleeServiceServer.IsAttackBlocked
MeleeServiceServer.enforceInputAllowed = MeleeServiceServer.EnforceInputAllowed
MeleeServiceServer.createRuntime = MeleeServiceServer.CreateRuntime
MeleeServiceServer.getRuntime = MeleeServiceServer.GetRuntime
MeleeServiceServer.cancelHitboxCleanupPromise = MeleeServiceServer.CancelHitboxCleanupPromise
MeleeServiceServer.stopHitbox = MeleeServiceServer.StopHitbox
MeleeServiceServer.clearHitboxPoints = MeleeServiceServer.ClearHitboxPoints
MeleeServiceServer.applyHitboxPoints = MeleeServiceServer.ApplyHitboxPoints
MeleeServiceServer.destroyHitbox = MeleeServiceServer.DestroyHitbox
MeleeServiceServer.destroyMeleeController = MeleeServiceServer.DestroyMeleeController
MeleeServiceServer.onHit = MeleeServiceServer.OnHit
MeleeServiceServer.onAttackStarted = MeleeServiceServer.OnAttackStarted
MeleeServiceServer.onSwingEnded = MeleeServiceServer.OnSwingEnded
MeleeServiceServer.onAttackFinished = MeleeServiceServer.OnAttackFinished
MeleeServiceServer.bindCharacter = MeleeServiceServer.BindCharacter
MeleeServiceServer.setEquippedWeaponConfig = MeleeServiceServer.SetEquippedWeaponConfig
MeleeServiceServer.refreshEquippedWeaponFromInventory = MeleeServiceServer.RefreshEquippedWeaponFromInventory
MeleeServiceServer.trackPlayer = MeleeServiceServer.TrackPlayer
MeleeServiceServer.untrackPlayer = MeleeServiceServer.UntrackPlayer
MeleeServiceServer.requestRefreshEquipped = MeleeServiceServer.RequestRefreshEquipped
MeleeServiceServer.requestSetInputHeld = MeleeServiceServer.RequestSetInputHeld
MeleeServiceServer.destroy = MeleeServiceServer.Destroy

type MeleeServiceServer = typeof(MeleeServiceServer) & {
	networker: Networker.Server,
	inventoryService: InventoryServiceServerObject,
	ragdollService: RagdollServiceServerObject,
	playerRuntimes: { [Player]: PlayerRuntime },
	playerAddedConnection: RBXScriptConnection?,
	playerRemovingConnection: RBXScriptConnection?,
}

return MeleeServiceServer :: MeleeServiceServer
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="1058">
              <Properties>
                <string name="Name">NpcServiceServer</string>
                <string name="Source"><![CDATA[--!strict
local PhysicsService = game:GetService("PhysicsService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerScriptService = game:GetService("ServerScriptService")
local Workspace = game:GetService("Workspace")

local AudioRegistry = require(script:FindFirstAncestor("game").Shared.Modules.Items.Audio)
local AudioServiceServer = require(script:FindFirstAncestor("game").Server.Services.AudioServiceServer)
local AudioServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.AudioServiceUtils)
local Bounds = require(script:FindFirstAncestor("game").Shared.Modules.Math.Bounds)
local Configs = require(script:FindFirstAncestor("game").Shared.Modules.Core.Configs)
local EnemyHitbox = require(script:FindFirstAncestor("game").Shared.Classes.EnemyHitbox)
local GoreServiceServer = require(script:FindFirstAncestor("game").Server.Services.GoreServiceServer)
local HpServiceServer = require(script:FindFirstAncestor("game").Server.Services.HpServiceServer)
local InstanceUtils = require(script:FindFirstAncestor("game").Shared.Modules.Platform.InstanceUtils)
local Janitor = require(ReplicatedStorage.Packages.Janitor)
local LootServiceServer = require(script:FindFirstAncestor("game").Server.Services.LootServiceServer)
local Networker = require(script:FindFirstAncestor("game").Shared.Modules.Networking.Networker)
local NevermoreSupport = require(script:FindFirstAncestor("game").Shared.Modules.Core.NevermoreSupport)
local NpcServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.NpcServiceUtils)
local PlayerServiceServer = require(script:FindFirstAncestor("game").Server.Services.PlayerServiceServer)
local ServerBinderSupport = require(script:FindFirstAncestor("game").Server.Binders.ServerBinderSupport)
local Slime = require(script:FindFirstAncestor("game").Shared.Classes.Npc.AiTypes.slime)
local StringUtils = require(script:FindFirstAncestor("game").Shared.Modules.Core.StringUtils)
local WorkspaceFolders = require(script:FindFirstAncestor("game").Shared.Modules.Core.WorkspaceFolders)
local WorldGenerationServiceServer =
	require(script:FindFirstAncestor("game").Server.Services.WorldGenerationServiceServer)

type SlimeClass = Slime.Slime
type RuntimeNpc = SlimeClass
type EnemyHitboxManager = EnemyHitbox.EnemyHitbox
type NpcType = NpcServiceUtils.NpcType
type NpcRuntimeState = NpcServiceUtils.NpcRuntimeState
type BiomeName = NpcServiceUtils.BiomeName
type AnimationEventAction = NpcServiceUtils.AnimationEventAction
type AnimationEventsByTrack = NpcServiceUtils.AnimationEventsByTrack
type StateMachineGraph = NpcServiceUtils.StateMachineGraph
type NpcSnapshot = NpcServiceUtils.NpcSnapshot
type SlimeSpawnConfig = NpcServiceUtils.SlimeSpawnConfig
type SlimeSpawnSettings = NpcServiceUtils.SlimeSpawnSettings
type HpServiceServerObject = {
	damagePlayer: (self: HpServiceServerObject, player: Player, damageRaw: any) -> number?,
}
type AudioServiceServerObject = {
	playSfxForAll: (self: AudioServiceServerObject, soundAssetIdRaw: any, optionsRaw: any) -> (),
}
type LootServiceServerObject = {
	spawnDropsFromSource: (
		self: LootServiceServerObject,
		sourceRaw: any,
		originRaw: any,
		optionsRaw: any
	) -> { any },
}
type GoreServiceServerObject = {
	registerNpcEntity: (self: GoreServiceServerObject, runtimeIdRaw: any, modelRaw: any, configRaw: any?) -> boolean,
	unregisterNpcEntity: (self: GoreServiceServerObject, runtimeIdRaw: any) -> boolean,
	onNpcDamaged: (self: GoreServiceServerObject, runtimeIdRaw: any, originRaw: any, damageRaw: any?) -> boolean,
	onNpcDied: (self: GoreServiceServerObject, runtimeIdRaw: any, originRaw: any) -> boolean,
	emitNpcSlimeBlood: (
		self: GoreServiceServerObject,
		runtimeIdRaw: any,
		originRaw: any,
		emitCountRaw: any?,
		followDurationRaw: any?,
		dropletAmountRaw: any?
	) -> boolean,
}

type JanitorClass = {
	GiveChore: (self: JanitorClass, chore: any, ...any) -> any,
	Clean: (self: JanitorClass) -> (),
	Destroy: (self: JanitorClass) -> (),
}

type NpcRuntime = {
	id: string,
	entityId: string,
	npcType: NpcType,
	displayName: string,
	npc: RuntimeNpc,
	slime: RuntimeNpc,
	hp: number,
	maxHp: number,
	isAlive: boolean,
	state: NpcRuntimeState,
	lastReason: string,
	biomeName: BiomeName,
	biomeReady: boolean,
	animationEvents: AnimationEventsByTrack,
	stateGraph: StateMachineGraph,
	updatedAt: number,
	janitor: JanitorClass,
	animationEventJanitor: JanitorClass,
	animationEventsBound: boolean,
	isRemoving: boolean,
	deathGoreEmitted: boolean,
	enemyHitboxId: string?,
	lastEnemyHitAt: number,
	lastPreDamageSlimeBloodAt: number,
}

local NpcServiceServer = {}

local DEFAULT_NPC_FOLDER_NAME = "NpcRuntime"
local DEFAULT_STATE_REFRESH_INTERVAL = 0.1
local DEFAULT_BIOME_REFRESH_INTERVAL = 0.35
local DEFAULT_PLAYER_RELATIVE_MIN_Z_OFFSET = 24
local DEFAULT_PLAYER_RELATIVE_MAX_Z_OFFSET = 48
local DEFAULT_PLAYER_RELATIVE_Y_OFFSET = 3
local DEFAULT_PLAYER_RELATIVE_SPAWN_ATTEMPTS_PER_PLAYER = 5
local DEFAULT_SPAWN_SURFACE_RAYCAST_HEIGHT = 96
local DEFAULT_SPAWN_SURFACE_RAYCAST_DEPTH = 224
local DEFAULT_SPAWN_SURFACE_CLEARANCE = 3
local DEFAULT_SPAWN_EMPTY_GAP_HALF_EXTENTS = Vector3.new(2.25, 2.5, 2.25)
local DEFAULT_SPAWN_EMPTY_GAP_FLOOR_BUFFER = 0.2
local DEFAULT_SPAWN_EMPTY_GAP_MAX_PARTS = 24
local DEFAULT_DESPAWN_CHECK_INTERVAL = 0.5
local DEFAULT_DESPAWN_DISTANCE_BUFFER = 8
local DEFAULT_SLIME_HP = 14
local DEFAULT_SLIME_DAMAGE_BLOOD_AMOUNT = 50
local DEFAULT_SLIME_DEATH_BLOOD_AMOUNT = 100
local DEFAULT_SLIME_BLOOD_POOL_SIZE = NumberRange.new(0.95, 1.7)
local DEFAULT_SLIME_BLOOD_POOL_SIZE_Y = NumberRange.new(0.16, 0.28)
local DEFAULT_SLIME_BLOOD_POOL_STARTING_SIZE = Vector3.new(0.2, 0.42, 0.2)
local DEFAULT_SLIME_BLOOD_POOL_MAX_SIZE = 1.8
local DEFAULT_SLIME_BLOOD_POOL_EXPANSE_DIVIDER = 2
local DEFAULT_RUNTIME_HURTBOX_SIZE = Vector3.new(4, 3, 4)
local DEFAULT_RUNTIME_HURTBOX_PADDING = Vector3.new(1.2, 0.5, 1.2)
local MIN_RUNTIME_HURTBOX_SIZE = Vector3.new(3.5, 2.75, 3.5)
local PLAYER_COLLISION_GROUP = "PlayersCharacters"
local ENEMY_COLLISION_GROUP = "NpcEnemies"
local WORLD_GENERATION_FOLDER_NAME = "WorldGeneration"
local EFFECTS_JUNK_FOLDER_NAME = "EffectsJunk"
local BIOME_TYPE_CORRUPTION = 2
local DEFAULT_SLIME_BLOOD_PARTICLES_PER_EMITTER = 18
local DEFAULT_SLIME_DEATH_SLIME_BLOOD_PARTICLES_PER_EMITTER = 30
local DEFAULT_SLIME_DEATH_SLIME_BLOOD_DROPLET_AMOUNT = 70
local DEFAULT_SLIME_BLOOD_CLEANUP_BUFFER_SECONDS = 1.5
local MIN_SLIME_BLOOD_CLEANUP_SECONDS = 2
local SLIME_BLOOD_EMIT_WINDOW_SECONDS = 0.1
local DEFAULT_PRE_DAMAGE_SLIME_BLOOD_EMIT_COUNT = 22
local DEFAULT_PRE_DAMAGE_SLIME_BLOOD_FOLLOW_DURATION = 0.1
local DEFAULT_PRE_DAMAGE_SLIME_BLOOD_DROPLET_AMOUNT = 8
local DEFAULT_PRE_DAMAGE_SLIME_BLOOD_LOW_HP_RATIO = 0.35
local DEFAULT_PRE_DAMAGE_SLIME_BLOOD_MIN_HP = 3
local DEFAULT_PRE_DAMAGE_SLIME_BLOOD_COOLDOWN = 0.12
local DEFAULT_FALLBACK_SLIME_BLOOD_COLOR = Color3.fromRGB(39, 145, 58)
local MISSING_SLIME_BLOOD_TEMPLATE_WARNING =
	"[NpcService] Missing slime blood template. Expected ReplicatedStorage.Assets.Effects.SlimeBlood. Using fallback emitter."
local NPC_AUDIO = (AudioRegistry :: any).Npcs or {}
local SLIME_AUDIO = (NPC_AUDIO :: any).Slimes or {}
local DEFAULT_SLIME_AUDIO_BINDINGS = (SLIME_AUDIO :: any).Default or {}
local GREEN_SLIME_AUDIO_BINDINGS = (SLIME_AUDIO :: any).GreenSlime or DEFAULT_SLIME_AUDIO_BINDINGS
local SLIME_GEL_DROP_ITEM_ID = "Gel"
local SLIME_GEL_DROP_AMOUNT = 1
local SLIME_AUDIO_KEY_BY_TOKEN = {
	jump = "Jump",
	land = "Land",
	hurt = "Hurt",
	hit = "Hurt",
	death = "Death",
}

local function isSlimeRuntime(runtime: NpcRuntime): boolean
	return runtime.npcType == "Slime"
end

local function fireForPlayers(networker: Networker.Server, players: { Player }, methodName: string, ...: any)
	for _, player in players do
		networker:fire(player, methodName, ...)
	end
end

local function resolveAnimator(humanoid: Humanoid): Animator
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if animator then
		return animator
	end

	local nextAnimator = Instance.new("Animator")
	nextAnimator.Name = "Animator"
	nextAnimator.Parent = humanoid
	return nextAnimator
end

local function resolveAnimatorFromModel(model: Model): Animator?
	local animationController = model:FindFirstChildOfClass("AnimationController")
	if animationController == nil then
		for _, descendant in model:GetDescendants() do
			if descendant:IsA("AnimationController") then
				animationController = descendant
				break
			end
		end
	end

	if animationController == nil then
		return nil
	end

	local animator = animationController:FindFirstChildOfClass("Animator")
	if animator ~= nil then
		return animator
	end

	local nextAnimator = Instance.new("Animator")
	nextAnimator.Name = "Animator"
	nextAnimator.Parent = animationController
	return nextAnimator
end

local function asAnimationTrack(value: any): AnimationTrack?
	if value == nil then
		return nil
	end

	local ok = pcall(function()
		local _ = (value :: any).KeyframeReached
	end)
	if ok then
		return value :: AnimationTrack
	end
	return nil
end

local function sanitizeNumber(valueRaw: any, fallback: number, minimum: number?, maximum: number?): number
	local value = fallback
	if typeof(valueRaw) == "number" and valueRaw == valueRaw then
		value = valueRaw
	end

	if minimum ~= nil and value < minimum then
		value = minimum
	end
	if maximum ~= nil and value > maximum then
		value = maximum
	end

	return value
end

local function sanitizeSizeVector(sizeRaw: any, fallback: Vector3): Vector3
	if typeof(sizeRaw) ~= "Vector3" then
		return fallback
	end
	return Vector3.new(
		math.max(0.05, math.abs(sizeRaw.X)),
		math.max(0.05, math.abs(sizeRaw.Y)),
		math.max(0.05, math.abs(sizeRaw.Z))
	)
end

local function computeBoxAabb(cframeRaw: any, sizeRaw: any): (Vector3, Vector3)
	local cframe = if typeof(cframeRaw) == "CFrame" then cframeRaw else CFrame.new()
	local size = sanitizeSizeVector(sizeRaw, Vector3.new(0.05, 0.05, 0.05))
	local halfSize = size * 0.5
	local right = cframe.RightVector
	local up = cframe.UpVector
	local look = cframe.LookVector
	local extents = Vector3.new(
		math.abs(right.X) * halfSize.X + math.abs(up.X) * halfSize.Y + math.abs(look.X) * halfSize.Z,
		math.abs(right.Y) * halfSize.X + math.abs(up.Y) * halfSize.Y + math.abs(look.Y) * halfSize.Z,
		math.abs(right.Z) * halfSize.X + math.abs(up.Z) * halfSize.Y + math.abs(look.Z) * halfSize.Z
	)
	local center = cframe.Position
	return center - extents, center + extents
end

local function aabbIntersects(aMin: Vector3, aMax: Vector3, bMin: Vector3, bMax: Vector3): boolean
	return Bounds.intersects(Bounds.new(aMin, aMax), Bounds.new(bMin, bMax))
end

local function setModelCollisionGroup(model: Model, collisionGroup: string)
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.CollisionGroup = collisionGroup
		end
	end
end

local function getOrCreateEffectsJunkFolder(): Folder
	return WorkspaceFolders.getOrCreateFolderInGame(EFFECTS_JUNK_FOLDER_NAME)
end

local function resolveSlimeBloodEffectTemplate(): BasePart?
	local directTemplate = InstanceUtils.resolveBasePartByPath(ReplicatedStorage, { "Assets", "Effects", "SlimeBlood" })
	if directTemplate ~= nil then
		return directTemplate
	end

	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local effects = if assets ~= nil then assets:FindFirstChild("Effects") else nil

	if effects ~= nil then
		local directChild = effects:FindFirstChild("SlimeBlood")
		local directPart = InstanceUtils.resolveFirstBasePart(directChild)
		if directPart ~= nil then
			return directPart
		end

		local nestedByToken = InstanceUtils.findDescendantBasePartByToken(effects, "SlimeBlood")
		if nestedByToken ~= nil then
			return nestedByToken
		end
	end

	local anywhereInReplicatedStorage = InstanceUtils.findDescendantBasePartByToken(ReplicatedStorage, "SlimeBlood")
	if anywhereInReplicatedStorage ~= nil then
		return anywhereInReplicatedStorage
	end

	if effects ~= nil then
		local bloodDirectPart = InstanceUtils.resolveFirstBasePart(effects:FindFirstChild("Blood"))
		if bloodDirectPart ~= nil then
			return bloodDirectPart
		end

		local bloodNestedPart = InstanceUtils.findDescendantBasePartByToken(effects, "Blood")
		if bloodNestedPart ~= nil then
			return bloodNestedPart
		end
	end

	return nil
end

local function createFallbackSlimeBloodEffect(): BasePart
	local part = Instance.new("Part")
	part.Name = "SlimeBlood"
	part.Size = Vector3.new(0.2, 0.2, 0.2)
	part.Transparency = 1
	part.Color = DEFAULT_FALLBACK_SLIME_BLOOD_COLOR
	part.Material = Enum.Material.SmoothPlastic
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false

	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "FallbackSlimeBloodEmitter"
	emitter.Enabled = false
	emitter.Rate = 0
	emitter.Color = ColorSequence.new(DEFAULT_FALLBACK_SLIME_BLOOD_COLOR)
	emitter.Lifetime = NumberRange.new(0.25, 0.9)
	emitter.Speed = NumberRange.new(7, 13)
	emitter.SpreadAngle = Vector2.new(55, 55)
	emitter.Drag = 3
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.3),
		NumberSequenceKeypoint.new(1, 0),
	})
	emitter.Parent = part

	return part
end

local function applyRuntimeModelAttributes(runtime: NpcRuntime, model: Model?)
	if model == nil then
		return
	end

	NpcServiceUtils.applyRuntimeModelAttributes(model, runtime.id, runtime.npcType, runtime.displayName)
end

local function isValidSurfaceSpawnPart(part: BasePart): boolean
	if not part.CanCollide then
		return false
	end
	if part.LocalTransparencyModifier >= 0.99 then
		return false
	end

	local worldFolder = WorkspaceFolders.findFolderInGameOrWorkspace(WORLD_GENERATION_FOLDER_NAME)
	if worldFolder == nil then
		return true
	end
	return part:IsDescendantOf(worldFolder)
end

function NpcServiceServer.EnsureNpcFolder(self: NpcServiceServer): Folder
	return WorkspaceFolders.getOrCreateFolderInGame(DEFAULT_NPC_FOLDER_NAME)
end

function NpcServiceServer.EnsureCollisionGroups(self: NpcServiceServer)
	if self.collisionGroupsReady == true then
		return
	end

	pcall(function()
		PhysicsService:RegisterCollisionGroup(PLAYER_COLLISION_GROUP)
	end)
	pcall(function()
		PhysicsService:RegisterCollisionGroup(ENEMY_COLLISION_GROUP)
	end)
	pcall(function()
		PhysicsService:CollisionGroupSetCollidable(PLAYER_COLLISION_GROUP, ENEMY_COLLISION_GROUP, false)
	end)
	pcall(function()
		PhysicsService:CollisionGroupSetCollidable(ENEMY_COLLISION_GROUP, PLAYER_COLLISION_GROUP, false)
	end)
	pcall(function()
		PhysicsService:CollisionGroupSetCollidable(ENEMY_COLLISION_GROUP, ENEMY_COLLISION_GROUP, false)
	end)

	self.collisionGroupsReady = true
end

function NpcServiceServer.ApplyPlayerCollisionGroup(self: NpcServiceServer, player: Player)
	local character = player.Character
	if character == nil then
		return
	end
	self:ensureCollisionGroups()
	setModelCollisionGroup(character, PLAYER_COLLISION_GROUP)
end

function NpcServiceServer.BindPlayerCollisionGroup(self: NpcServiceServer, player: Player)
	self:applyPlayerCollisionGroup(player)

	local previousConnection = self.playerCharacterAddedConnections[player]
	if previousConnection ~= nil then
		previousConnection:Disconnect()
	end

	self.playerCharacterAddedConnections[player] = player.CharacterAdded:Connect(function(character: Model)
		self:ensureCollisionGroups()
		setModelCollisionGroup(character, PLAYER_COLLISION_GROUP)
	end)
end

function NpcServiceServer.UnbindPlayerCollisionGroup(self: NpcServiceServer, player: Player)
	local connection = self.playerCharacterAddedConnections[player]
	if connection ~= nil then
		connection:Disconnect()
		self.playerCharacterAddedConnections[player] = nil
	end
end

function NpcServiceServer.ApplyRuntimeNpcCollisionGroup(self: NpcServiceServer, runtime: NpcRuntime)
	local model = runtime.slime.model
	if model == nil then
		return
	end
	self:ensureCollisionGroups()
	setModelCollisionGroup(model, ENEMY_COLLISION_GROUP)
end

local function resolveSlimeAudioBindings(runtime: NpcRuntime): { [string]: any }
	if isSlimeRuntime(runtime) and (runtime.slime :: any).isGreenSlime then
		return GREEN_SLIME_AUDIO_BINDINGS
	end
	return DEFAULT_SLIME_AUDIO_BINDINGS
end

function NpcServiceServer.ResolveRuntimeSoundSource(
	self: NpcServiceServer,
	runtime: NpcRuntime,
	soundNameRaw: any
): any?
	if typeof(soundNameRaw) ~= "string" or soundNameRaw == "" then
		return nil
	end

	local token = StringUtils.compactToken(soundNameRaw)
	local soundKey = if isSlimeRuntime(runtime) then SLIME_AUDIO_KEY_BY_TOKEN[token] else nil
	if soundKey ~= nil then
		local soundAssetIds = AudioServiceUtils.collectSoundAssetIds(resolveSlimeAudioBindings(runtime)[soundKey])
		if #soundAssetIds > 0 then
			return soundAssetIds[self.random:NextInteger(1, #soundAssetIds)]
		end
	end

	return NpcServiceUtils.findDescendantByNameOfClass(runtime.slime.model, soundNameRaw, "Sound")
end

function NpcServiceServer.PlayRuntimeNamedSound(self: NpcServiceServer, runtime: NpcRuntime, soundName: string): boolean
	local played = self:tryPlaySoundAction(runtime, {
		kind = "sound",
		soundName = soundName,
		autoDestroy = true,
	})
	return played
end

function NpcServiceServer.ResolveWorld(self: NpcServiceServer): any?
	local getWorldMethod = (WorldGenerationServiceServer :: any).getWorld
	if typeof(getWorldMethod) ~= "function" then
		return nil
	end

	local ok, worldOrError = pcall(function()
		return (WorldGenerationServiceServer :: any):getWorld()
	end)
	if not ok then
		return nil
	end

	if worldOrError ~= self.world then
		self.world = worldOrError
	end
	return self.world
end

function NpcServiceServer.IsCorruptionBiomePosition(self: NpcServiceServer, worldPosition: Vector3): boolean
	local world = self:resolveWorld()
	if world == nil then
		return false
	end

	local getBiomeTypeAtWorldPositionMethod = (world :: any).getBiomeTypeAtWorldPosition
	if typeof(getBiomeTypeAtWorldPositionMethod) ~= "function" then
		return false
	end

	local ok, biomeTypeOrError = pcall(function()
		return (world :: any):getBiomeTypeAtWorldPosition(worldPosition)
	end)
	if not ok or typeof(biomeTypeOrError) ~= "number" then
		return false
	end

	return math.floor(biomeTypeOrError) == BIOME_TYPE_CORRUPTION
end

function NpcServiceServer.CreateSnapshot(self: NpcServiceServer, runtime: NpcRuntime): NpcSnapshot
	self:syncRuntimeVitals(runtime)
	local position = runtime.slime:getPosition()
	return {
		id = runtime.id,
		npcType = runtime.npcType,
		displayName = runtime.displayName,
		state = runtime.state,
		biomeName = runtime.biomeName,
		biomeReady = runtime.biomeReady,
		hp = runtime.hp,
		maxHp = runtime.maxHp,
		isAlive = runtime.isAlive,
		position = position,
		updatedAt = runtime.updatedAt,
		lastReason = runtime.lastReason,
	}
end

function NpcServiceServer.SyncRuntimeVitals(self: NpcServiceServer, runtime: NpcRuntime)
	local slime = runtime.slime
	runtime.maxHp = slime.maxHp
	runtime.hp = math.clamp(slime.hp, 0, slime.maxHp)
	runtime.isAlive = slime.isAlive
end

function NpcServiceServer.GetRuntime(self: NpcServiceServer, runtimeId: string): NpcRuntime?
	return self.runtimes[runtimeId]
end

function NpcServiceServer.ResolveRuntimeFromModel(self: NpcServiceServer, modelRaw: any): NpcRuntime?
	if typeof(modelRaw) ~= "Instance" or not modelRaw:IsA("Model") then
		return nil
	end

	local cursor: Instance? = modelRaw
	while cursor ~= nil do
		if cursor:IsA("Model") then
			local runtime = self.runtimesByModel[cursor]
			if runtime ~= nil then
				return runtime
			end
		end
		cursor = cursor.Parent
	end

	return nil
end

function NpcServiceServer.ResolveRuntimeFromPart(self: NpcServiceServer, partRaw: any): NpcRuntime?
	if typeof(partRaw) ~= "Instance" or not partRaw:IsA("BasePart") then
		return nil
	end

	local enemyHitbox = self.enemyHitbox
	if enemyHitbox ~= nil then
		local runtimeId = enemyHitbox:resolveEnemyIdFromPart(partRaw)
		if runtimeId ~= nil then
			local runtime = self:getRuntime(runtimeId)
			if runtime ~= nil then
				return runtime
			end
		end
	end

	local parentModel = partRaw:FindFirstAncestorOfClass("Model")
	return self:resolveRuntimeFromModel(parentModel)
end

function NpcServiceServer.ResolveRuntimeHurtbox(self: NpcServiceServer, runtime: NpcRuntime): (Vector3, Vector3)
	local model = runtime.slime.model
	local center: Vector3? = nil
	local size = DEFAULT_RUNTIME_HURTBOX_SIZE
	if model ~= nil then
		local ok, boundsCFrameOrError, boundsSize = pcall(function()
			return model:GetBoundingBox()
		end)
		if ok and typeof(boundsCFrameOrError) == "CFrame" and typeof(boundsSize) == "Vector3" then
			center = boundsCFrameOrError.Position
			size = sanitizeSizeVector(boundsSize, DEFAULT_RUNTIME_HURTBOX_SIZE)
		end
	end

	if center == nil then
		local rootPart = InstanceUtils.resolveModelRootPart(model)
		if rootPart ~= nil then
			center = rootPart.Position
			size = sanitizeSizeVector(rootPart.Size, DEFAULT_RUNTIME_HURTBOX_SIZE)
		else
			local slimePosition = runtime.slime:getPosition()
			if typeof(slimePosition) == "Vector3" then
				center = slimePosition
			else
				center = Vector3.new()
			end
		end
	end

	local paddedSize = Vector3.new(
		math.max(MIN_RUNTIME_HURTBOX_SIZE.X, size.X + DEFAULT_RUNTIME_HURTBOX_PADDING.X),
		math.max(MIN_RUNTIME_HURTBOX_SIZE.Y, size.Y + DEFAULT_RUNTIME_HURTBOX_PADDING.Y),
		math.max(MIN_RUNTIME_HURTBOX_SIZE.Z, size.Z + DEFAULT_RUNTIME_HURTBOX_PADDING.Z)
	)
	return center, paddedSize
end

function NpcServiceServer.DamageNpcsInBox(
	self: NpcServiceServer,
	queryCFrameRaw: any,
	querySizeRaw: any,
	damageRaw: any,
	source: any?,
	damageContextRaw: any?
): number
	if self.runtimes == nil then
		return 0
	end
	if typeof(queryCFrameRaw) ~= "CFrame" then
		return 0
	end
	if typeof(querySizeRaw) ~= "Vector3" then
		return 0
	end

	local damage = sanitizeNumber(damageRaw, 0, 0, 100000)
	if damage <= 0 then
		return 0
	end

	local querySize = sanitizeSizeVector(querySizeRaw, Vector3.new(0.05, 0.05, 0.05))
	local queryMin, queryMax = computeBoxAabb(queryCFrameRaw, querySize)
	local totalAppliedDamage = 0
	for _, runtime in self.runtimes do
		if runtime.isRemoving or not runtime.isAlive then
			continue
		end

		local hurtboxCenter, hurtboxSize = self:resolveRuntimeHurtbox(runtime)
		local hurtboxMin, hurtboxMax = computeBoxAabb(CFrame.new(hurtboxCenter), hurtboxSize)
		if not aabbIntersects(queryMin, queryMax, hurtboxMin, hurtboxMax) then
			continue
		end

		totalAppliedDamage += self:applyRuntimeDamage(runtime, damage, source, damageContextRaw)
	end

	return totalAppliedDamage
end

function NpcServiceServer.EmitRuntimePreDamageSlimeBlood(
	self: NpcServiceServer,
	runtime: NpcRuntime,
	damage: number,
	source: any?,
	damageContextRaw: any?
)
	if StringUtils.compactToken(damageContextRaw) ~= "melee" then
		return
	end
	if runtime.npcType ~= "Slime" then
		return
	end
	if typeof(source) ~= "Instance" or not source:IsA("Player") then
		return
	end

	local goreService = self.goreService
	if goreService == nil then
		return
	end

	local now = os.clock()
	if now - runtime.lastPreDamageSlimeBloodAt < DEFAULT_PRE_DAMAGE_SLIME_BLOOD_COOLDOWN then
		return
	end

	local hp = math.max(0, runtime.hp)
	local maxHp = math.max(1, runtime.maxHp)
	local lowHpThreshold = math.max(
		DEFAULT_PRE_DAMAGE_SLIME_BLOOD_MIN_HP,
		math.floor(maxHp * DEFAULT_PRE_DAMAGE_SLIME_BLOOD_LOW_HP_RATIO + 0.5)
	)
	local likelyLethalHit = hp <= math.max(1, damage)
	local isLowHp = hp <= lowHpThreshold
	if not isLowHp and not likelyLethalHit then
		return
	end

	runtime.lastPreDamageSlimeBloodAt = now

	local origin: any = runtime.slime.rootPart
	if origin == nil or origin.Parent == nil then
		local modelRoot = InstanceUtils.resolveModelRootPart(runtime.slime.model)
		if modelRoot ~= nil then
			origin = modelRoot
		else
			local position = runtime.slime:getPosition()
			if position ~= nil then
				origin = position
			end
		end
	end
	if typeof(origin) == "Instance" and origin:IsA("BasePart") then
		origin = origin.Position
	end

	goreService:emitNpcSlimeBlood(
		runtime.id,
		origin,
		DEFAULT_PRE_DAMAGE_SLIME_BLOOD_EMIT_COUNT,
		DEFAULT_PRE_DAMAGE_SLIME_BLOOD_FOLLOW_DURATION,
		DEFAULT_PRE_DAMAGE_SLIME_BLOOD_DROPLET_AMOUNT
	)
end

function NpcServiceServer.ApplyRuntimeDamage(
	self: NpcServiceServer,
	runtime: NpcRuntime?,
	rawDamage: any,
	source: any?,
	damageContextRaw: any?
): number
	if runtime == nil then
		return 0
	end
	if runtime.isRemoving or not runtime.isAlive then
		return 0
	end

	local slime = runtime.slime
	if slime.isAlive ~= true then
		return 0
	end

	local damage = sanitizeNumber(rawDamage, 0, 0, 100000)
	if damage <= 0 then
		return 0
	end

	self:emitRuntimePreDamageSlimeBlood(runtime, damage, source, damageContextRaw)

	local appliedDamage = slime:takeDamage(damage, source)
	if appliedDamage > 0 then
		self:syncRuntimeVitals(runtime)
		self:updateRuntime(runtime, "externalDamage", false)
	end
	return appliedDamage
end

function NpcServiceServer.DamageNpcFromHitPart(
	self: NpcServiceServer,
	hitPartRaw: any,
	damageRaw: any,
	source: any?,
	damageContextRaw: any?
): number
	if self.runtimes == nil then
		return 0
	end

	local runtime = self:resolveRuntimeFromPart(hitPartRaw)
	if runtime == nil then
		return 0
	end

	return self:applyRuntimeDamage(runtime, damageRaw, source, damageContextRaw)
end

function NpcServiceServer.OnEnemyHitPlayer(self: NpcServiceServer, runtimeIdRaw: any, playerRaw: any, damageRaw: any)
	if typeof(runtimeIdRaw) ~= "string" or runtimeIdRaw == "" then
		return
	end
	if typeof(playerRaw) ~= "Instance" or not playerRaw:IsA("Player") then
		return
	end

	local runtime = self:getRuntime(runtimeIdRaw)
	if runtime == nil then
		return
	end
	if runtime.isRemoving or not runtime.isAlive then
		return
	end

	local hpService = HpServiceServer :: HpServiceServerObject
	local defaultDamage = sanitizeNumber(runtime.slime.damage, 0, 0, 100000)
	local damage = sanitizeNumber(damageRaw, defaultDamage, 0, 100000)
	if damage <= 0 then
		return
	end

	local healthAfterDamage = hpService:damagePlayer(playerRaw, damage)
	if healthAfterDamage == nil then
		return
	end

	runtime.lastEnemyHitAt = os.clock()
	self:updateRuntime(runtime, "enemyHitPlayer", false)
end

function NpcServiceServer.RegisterRuntimeEnemyHitbox(self: NpcServiceServer, runtime: NpcRuntime)
	if not isSlimeRuntime(runtime) then
		return
	end

	local enemyHitbox = self.enemyHitbox
	if enemyHitbox == nil then
		return
	end

	local runtimeId = runtime.id
	local didRegister = enemyHitbox:registerEnemy({
		id = runtimeId,
		owner = runtime,
		model = runtime.slime.model,
		getModel = function(ownerRuntime: NpcRuntime): Model?
			return ownerRuntime.slime.model
		end,
		getCenter = function(ownerRuntime: NpcRuntime): Vector3?
			local center = self:resolveRuntimeHurtbox(ownerRuntime)
			return center
		end,
		getAlive = function(ownerRuntime: NpcRuntime): boolean
			return ownerRuntime.isAlive and not ownerRuntime.isRemoving and ownerRuntime.slime.isAlive
		end,
		getDamage = function(ownerRuntime: NpcRuntime): number
			return sanitizeNumber(ownerRuntime.slime.damage, 0, 0, 100000)
		end,
		getAttackCooldown = function(ownerRuntime: NpcRuntime): number
			return sanitizeNumber(ownerRuntime.slime.combat.attackCooldown, 0.85, 0.05, 30)
		end,
		getHurtboxSize = function(ownerRuntime: NpcRuntime, _model: Model?, _rootPart: BasePart?): Vector3
			local _, hurtboxSize = self:resolveRuntimeHurtbox(ownerRuntime)
			return hurtboxSize
		end,
		getAttackSize = function(ownerRuntime: NpcRuntime, model: Model?, rootPart: BasePart?): Vector3
			local basePart = if rootPart ~= nil then rootPart else InstanceUtils.resolveModelRootPart(model)
			local baseSize = if basePart ~= nil then basePart.Size else DEFAULT_RUNTIME_HURTBOX_SIZE
			local slime = ownerRuntime.slime
			local attackRange = sanitizeNumber(slime.combat.attackRange, 3.5, 0.5, 25)
			local hopReach = sanitizeNumber(slime.hopDistance, 6, 1, 60) * 0.5
			local effectiveReach = math.max(attackRange, hopReach, 4)
			return Vector3.new(
				math.max(4, baseSize.X + 2),
				math.max(3, baseSize.Y + 1),
				math.max(6, baseSize.Z + effectiveReach * 2)
			)
		end,
		canHitPlayer = function(ownerRuntime: NpcRuntime, player: Player): boolean
			local slime = ownerRuntime.slime
			if ownerRuntime.isRemoving or not ownerRuntime.isAlive or not slime.isAlive then
				return false
			end
			if not slime.aggroOnPlayer then
				return false
			end
			if slime.passiveUntilHit and not slime.hasBeenHit then
				return false
			end

			local distance = slime:getDistanceTo(player)
			if distance == nil then
				return false
			end
			local maxContactDistance = math.max(5.5, sanitizeNumber(slime.hopDistance, 6, 1, 60) * 0.5 + 2)
			return distance <= maxContactDistance
		end,
		onHitPlayer = function(ownerRuntime: NpcRuntime, player: Player, damage: number)
			self:onEnemyHitPlayer(ownerRuntime.id, player, damage)
		end,
	})

	if didRegister then
		runtime.enemyHitboxId = runtimeId
	end
end

function NpcServiceServer.UnregisterRuntimeEnemyHitbox(self: NpcServiceServer, runtime: NpcRuntime)
	local enemyHitboxId = runtime.enemyHitboxId
	if enemyHitboxId ~= nil and self.enemyHitbox ~= nil then
		self.enemyHitbox:unregisterEnemy(enemyHitboxId)
	end
	runtime.enemyHitboxId = nil
end

function NpcServiceServer.GetActiveSlimeCount(self: NpcServiceServer): number
	local count = 0
	for _, runtime in self.runtimes do
		if runtime.npcType == "Slime" and runtime.isAlive and not runtime.isRemoving then
			count += 1
		end
	end
	return count
end

function NpcServiceServer.GetNextFallbackSpawnCFrame(self: NpcServiceServer): CFrame
	if #self.spawnCFrames <= 0 then
		self.spawnCFrames = NpcServiceUtils.collectSpawnCFrames(math.max(1, self.slimeSpawnSettings.maxAlive))
		self.nextSpawnIndex = 1
	end

	local spawnCFrames = self.spawnCFrames
	local index = math.clamp(self.nextSpawnIndex, 1, #spawnCFrames)
	local nextCFrame = spawnCFrames[index]
	self.nextSpawnIndex += 1
	if self.nextSpawnIndex > #spawnCFrames then
		self.nextSpawnIndex = 1
	end

	return nextCFrame
end

function NpcServiceServer.ResolveSurfaceSpawnCFrame(
	self: NpcServiceServer,
	candidatePosition: Vector3,
	characterToIgnore: Model?
): CFrame?
	local raycastParams = RaycastParams.new()
	raycastParams.FilterType = Enum.RaycastFilterType.Exclude
	local excludeInstances = {}
	if characterToIgnore ~= nil then
		table.insert(excludeInstances, characterToIgnore)
	end
	if self.npcFolder ~= nil then
		table.insert(excludeInstances, self.npcFolder)
	end
	raycastParams.FilterDescendantsInstances = excludeInstances
	raycastParams.IgnoreWater = false

	local origin = candidatePosition + Vector3.new(0, DEFAULT_SPAWN_SURFACE_RAYCAST_HEIGHT, 0)
	local direction = Vector3.new(0, -(DEFAULT_SPAWN_SURFACE_RAYCAST_HEIGHT + DEFAULT_SPAWN_SURFACE_RAYCAST_DEPTH), 0)
	local hit = Workspace:Raycast(origin, direction, raycastParams)
	if hit == nil then
		return nil
	end

	local hitPart = hit.Instance
	if not hitPart:IsA("BasePart") then
		return nil
	end
	if not isValidSurfaceSpawnPart(hitPart) then
		return nil
	end
	if hit.Normal.Y < 0.4 then
		return nil
	end

	local snappedPosition =
		Vector3.new(candidatePosition.X, hit.Position.Y + DEFAULT_SPAWN_SURFACE_CLEARANCE, candidatePosition.Z)
	return CFrame.new(snappedPosition)
end

function NpcServiceServer.IsSpawnGapClear(
	self: NpcServiceServer,
	spawnCFrame: CFrame,
	characterToIgnore: Model?
): boolean
	local overlapParams = OverlapParams.new()
	overlapParams.FilterType = Enum.RaycastFilterType.Exclude

	local excludeInstances = {}
	if characterToIgnore ~= nil then
		table.insert(excludeInstances, characterToIgnore)
	end
	if self.npcFolder ~= nil then
		table.insert(excludeInstances, self.npcFolder)
	end
	overlapParams.FilterDescendantsInstances = excludeInstances
	overlapParams.MaxParts = DEFAULT_SPAWN_EMPTY_GAP_MAX_PARTS

	local queryCenter = spawnCFrame.Position
		+ Vector3.new(0, DEFAULT_SPAWN_EMPTY_GAP_HALF_EXTENTS.Y + DEFAULT_SPAWN_EMPTY_GAP_FLOOR_BUFFER, 0)
	local parts =
		Workspace:GetPartBoundsInBox(CFrame.new(queryCenter), DEFAULT_SPAWN_EMPTY_GAP_HALF_EXTENTS * 2, overlapParams)
	for _, part in parts do
		if part:IsA("BasePart") and part.CanCollide then
			return false
		end
	end

	return true
end

function NpcServiceServer.GetNextPlayerRelativeSpawnCFrame(self: NpcServiceServer): CFrame?
	local players = Players:GetPlayers()
	if #players <= 0 then
		return nil
	end

	local startIndex = self.random:NextInteger(1, #players)
	for indexOffset = 0, #players - 1 do
		local index = ((startIndex + indexOffset - 1) % #players) + 1
		local player = players[index]
		local character = player.Character
		if character == nil then
			continue
		end

		local rootPartCandidate = character:FindFirstChild("HumanoidRootPart")
		local rootPart = if rootPartCandidate and rootPartCandidate:IsA("BasePart") then rootPartCandidate else nil
		if rootPart == nil then
			local primaryPart = character.PrimaryPart
			if primaryPart and primaryPart:IsA("BasePart") then
				rootPart = primaryPart
			end
		end
		if rootPart == nil then
			continue
		end

		for _ = 1, DEFAULT_PLAYER_RELATIVE_SPAWN_ATTEMPTS_PER_PLAYER do
			local spawnSign = if self.random:NextNumber() < 0.5 then -1 else 1
			local zOffset =
				self.random:NextNumber(DEFAULT_PLAYER_RELATIVE_MIN_Z_OFFSET, DEFAULT_PLAYER_RELATIVE_MAX_Z_OFFSET)
			local yOffset = self.random:NextNumber(0, DEFAULT_PLAYER_RELATIVE_Y_OFFSET)
			local spawnPosition = rootPart.Position + Vector3.new(0, yOffset, spawnSign * zOffset)

			local snappedSpawnCFrame = self:resolveSurfaceSpawnCFrame(spawnPosition, character)
			if
				snappedSpawnCFrame ~= nil
				and not self:isCorruptionBiomePosition(snappedSpawnCFrame.Position)
				and self:isSpawnGapClear(snappedSpawnCFrame, character)
			then
				return snappedSpawnCFrame
			end
		end
	end

	return nil
end

function NpcServiceServer.GetNearestPlayerDistance(self: NpcServiceServer, position: Vector3): number?
	local nearestDistance: number? = nil

	for _, player in Players:GetPlayers() do
		local character = player.Character
		if character == nil then
			continue
		end

		local rootPart = InstanceUtils.resolveModelRootPart(character)
		if rootPart == nil then
			continue
		end

		local distance = (rootPart.Position - position).Magnitude
		if nearestDistance == nil or distance < nearestDistance then
			nearestDistance = distance
		end
	end

	return nearestDistance
end

function NpcServiceServer.DespawnFarRuntimes(self: NpcServiceServer, reasonRaw: any): number
	local settings = self.slimeSpawnSettings
	if not settings.enabled then
		return 0
	end

	local despawnDistance = sanitizeNumber(settings.despawnDistance, 0, 0, 100000)
	if despawnDistance <= 0 then
		return 0
	end

	local removalIds = {}
	local distanceThreshold = despawnDistance + DEFAULT_DESPAWN_DISTANCE_BUFFER
	for runtimeId, runtime in self.runtimes do
		if runtime.isRemoving or not runtime.isAlive or runtime.slime.isAlive ~= true then
			continue
		end

		local position = runtime.slime:getPosition()
		if position == nil then
			table.insert(removalIds, runtimeId)
			continue
		end

		local nearestDistance = self:getNearestPlayerDistance(position)
		if nearestDistance == nil or nearestDistance > distanceThreshold then
			table.insert(removalIds, runtimeId)
		end
	end

	local reason = if typeof(reasonRaw) == "string" and reasonRaw ~= "" then reasonRaw else "tooFarFromPlayers"
	for _, runtimeId in removalIds do
		self:removeRuntime(runtimeId, reason)
	end

	return #removalIds
end

function NpcServiceServer.GetNextSpawnCFrame(self: NpcServiceServer): CFrame?
	return self:getNextPlayerRelativeSpawnCFrame()
end

function NpcServiceServer.CreateDefaultSpawnConfigAt(self: NpcServiceServer, spawnCFrame: CFrame): SlimeSpawnConfig?
	if self:isCorruptionBiomePosition(spawnCFrame.Position) then
		return nil
	end

	local configs = NpcServiceUtils.createDefaultSlimeSpawnConfigs({ spawnCFrame })
	if #configs <= 0 then
		return nil
	end
	return configs[1]
end

function NpcServiceServer.GetDebugSpawnCFrameForPlayer(self: NpcServiceServer, playerRaw: any, indexRaw: any): CFrame?
	if typeof(playerRaw) ~= "Instance" or not playerRaw:IsA("Player") then
		return self:getNextSpawnCFrame()
	end

	local character = playerRaw.Character
	if character == nil then
		return self:getNextSpawnCFrame()
	end

	local rootPart = InstanceUtils.resolveModelRootPart(character)
	if rootPart == nil then
		return self:getNextSpawnCFrame()
	end

	local index = math.max(1, math.floor(sanitizeNumber(indexRaw, 1, 1, 10 ^ 6)))
	local laneIndex = math.floor((index - 1) / 2)
	local directionSign = if index % 2 == 1 then 1 else -1
	local zOffset = DEFAULT_PLAYER_RELATIVE_MIN_Z_OFFSET + laneIndex * 8
	local yOffset = DEFAULT_PLAYER_RELATIVE_Y_OFFSET + math.min(laneIndex, 4)
	local candidatePosition = rootPart.Position + Vector3.new(0, yOffset, directionSign * zOffset)
	local snappedSpawnCFrame = self:resolveSurfaceSpawnCFrame(candidatePosition, character)

	if
		snappedSpawnCFrame ~= nil
		and not self:isCorruptionBiomePosition(snappedSpawnCFrame.Position)
		and self:isSpawnGapClear(snappedSpawnCFrame, character)
	then
		return snappedSpawnCFrame
	end

	return self:getNextSpawnCFrame()
end

function NpcServiceServer.SpawnDebugNpcById(
	self: NpcServiceServer,
	npcIdRaw: any,
	playerRaw: any,
	indexRaw: any
): (NpcRuntime?, string?)
	if npcIdRaw ~= "GreenSlime" then
		return nil, "unsupported_npc"
	end

	local spawnCFrame = self:getDebugSpawnCFrameForPlayer(playerRaw, indexRaw)
	if spawnCFrame == nil then
		return nil, "missing_spawn_cframe"
	end

	local spawnConfig = self:createDefaultSpawnConfigAt(spawnCFrame)
	if spawnConfig == nil then
		return nil, "invalid_spawn_configuration"
	end

	spawnConfig.slimeType = "GreenSlime"
	spawnConfig.displayName = "Green Slime"
	spawnConfig.modelName = "GreenSlime"
	spawnConfig.modelHierarchy = "Enemies.GreenSlime"

	local runtime = self:spawnSlime(spawnConfig)
	if runtime == nil then
		return nil, "spawn_failed"
	end

	return runtime, nil
end

function NpcServiceServer.TryAutoSpawnSlime(self: NpcServiceServer, reasonRaw: any): NpcRuntime?
	local settings = self.slimeSpawnSettings
	if not settings.enabled then
		return nil
	end

	self:despawnFarRuntimes("spawnPrecheck")

	local activeCount = self:getActiveSlimeCount()
	if activeCount >= settings.maxAlive then
		return nil
	end

	if settings.spawnChance <= 0 then
		return nil
	end

	local roll = self.random:NextNumber()
	if roll >= settings.spawnChance then
		return nil
	end

	local spawnCFrame = self:getNextSpawnCFrame()
	if spawnCFrame == nil then
		return nil
	end
	local spawnConfig = self:createDefaultSpawnConfigAt(spawnCFrame)
	if spawnConfig == nil then
		return nil
	end

	local runtime = self:spawnSlime(spawnConfig)
	if runtime ~= nil then
		local reason = if typeof(reasonRaw) == "string" and reasonRaw ~= "" then reasonRaw else "autoSpawn"
		self:transitionRuntimeState(runtime, "Spawning", reason, true)
	end
	return runtime
end

function NpcServiceServer.CreateStatePayload(self: NpcServiceServer): { NpcSnapshot }
	local snapshots = {}
	for _, runtime in self.runtimes do
		table.insert(snapshots, self:createSnapshot(runtime))
	end
	return snapshots
end

function NpcServiceServer.Broadcast(self: NpcServiceServer, methodName: string, ...: any)
	local recipients = {}
	for _, player in Players:GetPlayers() do
		if PlayerServiceServer:isGameplayActiveForPlayer(player) then
			recipients[#recipients + 1] = player
		end
	end
	fireForPlayers(self.networker, recipients, methodName, ...)
end

function NpcServiceServer.PushState(self: NpcServiceServer, player: Player)
	self.networker:fire(player, NpcServiceUtils.CLIENT_METHOD_APPLY_STATE, self:createStatePayload())
end

function NpcServiceServer.RequestSync(self: NpcServiceServer, player: Player)
	self:pushState(player)
end

function NpcServiceServer.TransitionRuntimeState(
	self: NpcServiceServer,
	runtime: NpcRuntime,
	nextState: NpcRuntimeState,
	reasonRaw: any,
	forceTransition: boolean?
): boolean
	local reason = if typeof(reasonRaw) == "string" and reasonRaw ~= "" then reasonRaw else "unknown"
	local currentState = runtime.state
	if nextState == currentState then
		runtime.lastReason = reason
		runtime.updatedAt = os.clock()
		return true
	end

	if forceTransition ~= true and not NpcServiceUtils.canTransition(runtime.stateGraph, currentState, nextState) then
		return false
	end

	runtime.state = nextState
	runtime.lastReason = reason
	runtime.updatedAt = os.clock()

	local payload = self:createSnapshot(runtime) :: any
	payload.previousState = currentState
	self:broadcast(NpcServiceUtils.CLIENT_METHOD_NPC_STATE_CHANGED, payload)
	return true
end

function NpcServiceServer.RemoveRuntime(self: NpcServiceServer, runtimeIdRaw: any, reasonRaw: any)
	if typeof(runtimeIdRaw) ~= "string" or runtimeIdRaw == "" then
		return
	end

	local runtime = self:getRuntime(runtimeIdRaw)
	if runtime == nil then
		return
	end

	runtime.isRemoving = true
	self.runtimes[runtimeIdRaw] = nil
	self:unregisterRuntimeEnemyHitbox(runtime)
	if self.goreService ~= nil then
		self.goreService:unregisterNpcEntity(runtime.id)
	end

	local model = runtime.slime.model
	if model and self.runtimesByModel[model] == runtime then
		self.runtimesByModel[model] = nil
	end

	local reason = if typeof(reasonRaw) == "string" and reasonRaw ~= "" then reasonRaw else "removed"
	self:transitionRuntimeState(runtime, "Dead", reason, true)

	if not (runtime.slime :: any)._isDestroyed then
		runtime.slime:destroy()
	end

	runtime.animationEventJanitor:Destroy()
	runtime.janitor:Destroy()
	self:broadcast(NpcServiceUtils.CLIENT_METHOD_NPC_REMOVED, runtimeIdRaw)
end

function NpcServiceServer.SyncRuntimeGoreRegistration(self: NpcServiceServer, runtime: NpcRuntime)
	local goreService = self.goreService
	if goreService == nil then
		return
	end

	local model = runtime.slime.model
	if model == nil or model.Parent == nil then
		goreService:unregisterNpcEntity(runtime.id)
		return
	end

	local goreConfig = nil
	if runtime.npcType == "Slime" then
		goreConfig = {
			damageBloodAmount = DEFAULT_SLIME_DAMAGE_BLOOD_AMOUNT,
			deathBloodAmount = DEFAULT_SLIME_DEATH_BLOOD_AMOUNT,
			bloodSettings = {
				DefaultSize = DEFAULT_SLIME_BLOOD_POOL_SIZE,
				SizeY = DEFAULT_SLIME_BLOOD_POOL_SIZE_Y,
				StartingSize = DEFAULT_SLIME_BLOOD_POOL_STARTING_SIZE,
				MaximumSize = DEFAULT_SLIME_BLOOD_POOL_MAX_SIZE,
				ExpanseDivider = DEFAULT_SLIME_BLOOD_POOL_EXPANSE_DIVIDER,
			},
		}
	end

	goreService:registerNpcEntity(runtime.id, model, goreConfig)
end

function NpcServiceServer.ResolveRuntimeDeathOrigin(self: NpcServiceServer, runtime: NpcRuntime): Vector3?
	local deathPosition = runtime.slime:getPosition()
	if deathPosition ~= nil then
		return deathPosition
	end

	local rootPart = InstanceUtils.resolveModelRootPart(runtime.slime.model)
	if rootPart ~= nil then
		return rootPart.Position
	end

	return nil
end

function NpcServiceServer.EmitRuntimeDeathGore(self: NpcServiceServer, runtime: NpcRuntime, originRaw: any?): boolean
	if runtime.deathGoreEmitted then
		return true
	end

	local goreService = self.goreService
	if goreService == nil then
		return false
	end

	local origin = if typeof(originRaw) == "Vector3" then originRaw else self:resolveRuntimeDeathOrigin(runtime)
	if origin == nil then
		return false
	end

	local didEmit = goreService:onNpcDied(runtime.id, origin)
	if didEmit then
		runtime.deathGoreEmitted = true
		return true
	end

	self:syncRuntimeGoreRegistration(runtime)
	didEmit = goreService:onNpcDied(runtime.id, origin)
	if didEmit then
		runtime.deathGoreEmitted = true
	end

	return didEmit
end

function NpcServiceServer.EmitRuntimeSlimeBlood(
	self: NpcServiceServer,
	runtime: NpcRuntime,
	emitCountRaw: any?,
	dropletAmountRaw: any?
): boolean
	if runtime.npcType ~= "Slime" then
		return false
	end

	local slimeBloodTemplate = resolveSlimeBloodEffectTemplate()
	local bloodEffect = (
		if slimeBloodTemplate ~= nil then slimeBloodTemplate:Clone() else createFallbackSlimeBloodEffect()
	) :: BasePart
	if slimeBloodTemplate == nil then
		if self.missingSlimeBloodTemplateWarningShown ~= true then
			self.missingSlimeBloodTemplateWarningShown = true
		end
	end

	local sourcePart = runtime.slime.rootPart
	if sourcePart == nil or sourcePart.Parent == nil then
		sourcePart = InstanceUtils.resolveModelRootPart(runtime.slime.model)
	end
	if sourcePart == nil then
		bloodEffect:Destroy()
		return false
	end

	local particlesPerEmitter =
		math.floor(sanitizeNumber(emitCountRaw, DEFAULT_SLIME_BLOOD_PARTICLES_PER_EMITTER, 1, 200) + 0.5)

	local bloodRuntimeModel = Instance.new("Model")
	bloodRuntimeModel.Name = "SlimeBloodRuntime"
	bloodEffect.Name = "SlimeBlood"
	bloodEffect.CFrame = sourcePart.CFrame
	bloodEffect.Anchored = true
	bloodEffect.CanCollide = false
	bloodEffect.CanTouch = false
	bloodEffect.CanQuery = false
	bloodEffect.Parent = bloodRuntimeModel
	bloodRuntimeModel.PrimaryPart = bloodEffect
	bloodRuntimeModel.Parent = getOrCreateEffectsJunkFolder()

	local emitted = false
	local maxLifetime = 0
	local effectEmitters = {} :: { ParticleEmitter }
	for _, descendant in bloodEffect:GetDescendants() do
		if descendant:IsA("ParticleEmitter") then
			local lifetime = descendant.Lifetime
			local maxEmitterLifetime = math.max(0, lifetime.Min, lifetime.Max)
			descendant.Enabled = true
			descendant:Emit(particlesPerEmitter)
			maxLifetime = math.max(maxLifetime, maxEmitterLifetime)
			emitted = true
			table.insert(effectEmitters, descendant)
		end
	end

	if not emitted then
		bloodRuntimeModel:Destroy()
		return false
	end

	local temporarySlimeBloodGoreRuntimeId: string? = nil
	local goreService = self.goreService
	local dropletAmount = math.floor(sanitizeNumber(dropletAmountRaw, 0, 0, 200) + 0.5)
	if goreService ~= nil and dropletAmount > 0 then
		local uniqueSuffix = math.floor(os.clock() * 1000) + self.random:NextInteger(1, 1_000_000)
		temporarySlimeBloodGoreRuntimeId = ("%s_slimeblood_%d"):format(runtime.id, uniqueSuffix)

		local didRegister = goreService:registerNpcEntity(temporarySlimeBloodGoreRuntimeId, bloodRuntimeModel, {
			damageBloodAmount = DEFAULT_SLIME_DAMAGE_BLOOD_AMOUNT,
			deathBloodAmount = DEFAULT_SLIME_DEATH_BLOOD_AMOUNT,
			deathGibCount = 0,
			emitDeathGibs = false,
			bloodSettings = {
				DefaultSize = DEFAULT_SLIME_BLOOD_POOL_SIZE,
				SizeY = DEFAULT_SLIME_BLOOD_POOL_SIZE_Y,
				StartingSize = DEFAULT_SLIME_BLOOD_POOL_STARTING_SIZE,
				MaximumSize = DEFAULT_SLIME_BLOOD_POOL_MAX_SIZE,
				ExpanseDivider = DEFAULT_SLIME_BLOOD_POOL_EXPANSE_DIVIDER,
			},
		})
		if didRegister then
			goreService:onNpcDamaged(temporarySlimeBloodGoreRuntimeId, bloodEffect, dropletAmount)
		else
			temporarySlimeBloodGoreRuntimeId = nil
		end
	end

	task.delay(SLIME_BLOOD_EMIT_WINDOW_SECONDS, function()
		for _, emitter in effectEmitters do
			if emitter.Parent ~= nil then
				emitter.Enabled = false
			end
		end
	end)

	local cleanupDelay = math.max(
		MIN_SLIME_BLOOD_CLEANUP_SECONDS,
		SLIME_BLOOD_EMIT_WINDOW_SECONDS + maxLifetime + DEFAULT_SLIME_BLOOD_CLEANUP_BUFFER_SECONDS
	)
	task.delay(cleanupDelay, function()
		local activeGoreService = self.goreService
		if temporarySlimeBloodGoreRuntimeId ~= nil and activeGoreService ~= nil then
			activeGoreService:unregisterNpcEntity(temporarySlimeBloodGoreRuntimeId)
		end
		if bloodRuntimeModel.Parent ~= nil then
			bloodRuntimeModel:Destroy()
		end
	end)

	return true
end

function NpcServiceServer.ResolveRuntimeState(self: NpcServiceServer, runtime: NpcRuntime): NpcRuntimeState
	local npc = runtime.npc
	if not runtime.isAlive then
		return "Dead"
	end
	if not runtime.biomeReady then
		return "AwaitingBiome"
	end
	if os.clock() - runtime.lastEnemyHitAt <= 0.25 then
		return "Attacking"
	end

	local currentTarget = npc.currentTarget
	local hasTarget = currentTarget ~= nil and npc:isTargetValid(currentTarget)
	if hasTarget then
		if npc:canAttackTarget(currentTarget) then
			return "Attacking"
		end
		return "Aggro"
	end

	if npc.state == "Moving" then
		return "Searching"
	end
	return "Idle"
end

function NpcServiceServer.RefreshRuntimeBiome(self: NpcServiceServer, runtime: NpcRuntime)
	local world = self:resolveWorld()
	if world == nil then
		runtime.biomeName = "Unknown"
		runtime.biomeReady = false
		return
	end

	local position = runtime.slime:getPosition()
	if position == nil then
		runtime.biomeName = "Unknown"
		runtime.biomeReady = false
		return
	end

	local biomeName, biomeReady = NpcServiceUtils.resolveBiomeNameFromWorld(world, position)
	runtime.biomeName = biomeName
	runtime.biomeReady = biomeReady
end

function NpcServiceServer.TryPlaySoundAction(
	self: NpcServiceServer,
	runtime: NpcRuntime,
	action: AnimationEventAction
): (boolean, any?, { [string]: any }?)
	local slimeModel = runtime.slime.model
	local soundSource = if action.sound ~= nil then action.sound else action.source
	if soundSource == nil and action.soundName ~= nil then
		soundSource = self:resolveRuntimeSoundSource(runtime, action.soundName)
	end

	local soundAssetId = NpcServiceUtils.resolveSoundSource(soundSource)
	if soundAssetId == nil then
		return false, nil, nil
	end

	local soundService = self.soundService
	if soundService == nil or (soundService :: any).networker == nil then
		return false, nil, nil
	end

	local parent = runtime.slime.rootPart
	if parent == nil then
		parent = slimeModel
	end
	if parent == nil then
		return false, nil, nil
	end

	local options: { [string]: any } = {
		category = "SFX",
		looped = action.looped,
		volume = action.volume,
		playbackSpeed = action.playbackSpeed,
		autoDestroy = action.autoDestroy,
		rollOffMaxDistance = action.rollOffMaxDistance,
		emitterSize = action.emitterSize,
		parent = parent,
	}

	soundService:playSfxForAll(soundAssetId, options)
	return true, nil, nil
end

function NpcServiceServer.TryPlayAnimationAction(
	self: NpcServiceServer,
	runtime: NpcRuntime,
	action: AnimationEventAction
): boolean
	local slimeModel = runtime.slime.model
	local animationSource = if action.animation ~= nil then action.animation else action.source
	if animationSource == nil and action.animationName ~= nil then
		animationSource = NpcServiceUtils.findDescendantByNameOfClass(slimeModel, action.animationName, "Animation")
	end

	local animationTemplate, animationAssetId = NpcServiceUtils.resolveAnimationSource(animationSource)
	if animationTemplate == nil and animationAssetId == nil then
		return false
	end

	local animator: Animator? = nil
	local humanoid = runtime.slime.humanoid
	if humanoid ~= nil then
		animator = resolveAnimator(humanoid)
	end
	if animator == nil and slimeModel ~= nil then
		animator = resolveAnimatorFromModel(slimeModel)
	end
	if animator == nil then
		return false
	end

	if action.stopOtherTracks == true then
		for _, playingTrack in (animator :: Animator):GetPlayingAnimationTracks() do
			playingTrack:Stop(math.min(0.1, if action.fadeTime then action.fadeTime else 0.08))
		end
	end

	local animationObject = animationTemplate
	local shouldDestroyAnimationObject = false
	if animationObject == nil and animationAssetId ~= nil then
		local generated = Instance.new("Animation")
		generated.Name = "NpcEventAnimation"
		generated.AnimationId = animationAssetId
		animationObject = generated
		shouldDestroyAnimationObject = true
	end

	if animationObject == nil then
		return false
	end

	local ok, trackOrError = pcall(function()
		return (animator :: Animator):LoadAnimation(animationObject :: Animation)
	end)
	if shouldDestroyAnimationObject then
		local animationObjectTyped = animationObject :: Animation
		animationObjectTyped:Destroy()
	end
	if not ok then
		return false
	end

	local track = trackOrError :: AnimationTrack
	if action.looped ~= nil then
		track.Looped = action.looped
	end
	if action.priority ~= nil then
		track.Priority = action.priority
	end

	local fadeTime = if action.fadeTime ~= nil then action.fadeTime else 0.08
	local weight = if action.weight ~= nil then action.weight else 1
	local speed = if action.playbackSpeed ~= nil then action.playbackSpeed else 1
	track:Play(fadeTime, weight, speed)

	if action.autoDestroy == true and not track.Looped then
		local stoppedConnection: RBXScriptConnection?
		stoppedConnection = track.Stopped:Connect(function()
			if stoppedConnection then
				stoppedConnection:Disconnect()
				stoppedConnection = nil
			end
			pcall(function()
				track:Destroy()
			end)
		end)
		runtime.animationEventJanitor:GiveChore(stoppedConnection)
	end

	return true
end

function NpcServiceServer.OnRuntimeAnimationEvent(
	self: NpcServiceServer,
	runtime: NpcRuntime,
	trackName: string,
	eventType: string,
	eventName: string,
	parameter: any,
	actions: { AnimationEventAction }
)
	if runtime.isRemoving then
		return
	end

	local clientEffects = {}
	for _, action in actions do
		if action.kind == "sound" then
			local played, clientSource, clientOptions = self:tryPlaySoundAction(runtime, action)
			if played and action.playOnClient == true and clientSource ~= nil then
				table.insert(clientEffects, {
					kind = "sound",
					source = clientSource,
					options = clientOptions,
				})
			end
		elseif action.kind == "animation" then
			local played = self:tryPlayAnimationAction(runtime, action)
			if played and action.playOnClient == true then
				table.insert(clientEffects, {
					kind = "animation",
					source = action.source,
				})
			end
		end
	end

	self:broadcast(NpcServiceUtils.CLIENT_METHOD_NPC_ANIMATION_EVENT, {
		id = runtime.id,
		npcType = runtime.npcType,
		trackName = trackName,
		eventType = eventType,
		eventName = eventName,
		parameter = parameter,
		state = runtime.state,
		biomeName = runtime.biomeName,
		biomeReady = runtime.biomeReady,
		updatedAt = os.clock(),
		clientEffects = clientEffects,
	})
end

function NpcServiceServer.EnsureRuntimeAnimationEventBindings(self: NpcServiceServer, runtime: NpcRuntime)
	if runtime.animationEventsBound then
		return
	end
	if not isSlimeRuntime(runtime) then
		return
	end

	local slimeAny = runtime.slime :: any
	if slimeAny._slimeAnimationsLoaded ~= true then
		return
	end

	local slimeTracks = slimeAny._slimeAnimations
	if typeof(slimeTracks) ~= "table" then
		return
	end

	runtime.animationEventJanitor:Clean()
	local boundConnections = 0

	for trackName, binding in runtime.animationEvents do
		local track = asAnimationTrack((slimeTracks :: any)[trackName])
		if track == nil then
			continue
		end

		for markerName, actions in binding.markers do
			if #actions <= 0 then
				continue
			end

			local ok, markerSignalOrError = pcall(function()
				return track:GetMarkerReachedSignal(markerName)
			end)
			if ok and markerSignalOrError ~= nil then
				runtime.animationEventJanitor:GiveChore((markerSignalOrError :: any):Connect(function(parameter: string)
					self:onRuntimeAnimationEvent(runtime, trackName, "Marker", markerName, parameter, actions)
				end))
				boundConnections += 1
			else
			end
		end

		if next(binding.keyframes) ~= nil then
			runtime.animationEventJanitor:GiveChore(track.KeyframeReached:Connect(function(keyframeName: string)
				local actions = binding.keyframes[keyframeName]
				if actions ~= nil and #actions > 0 then
					self:onRuntimeAnimationEvent(runtime, trackName, "Keyframe", keyframeName, nil, actions)
				end
			end))
			boundConnections += 1
		end
	end

	runtime.animationEventsBound = boundConnections > 0
end

function NpcServiceServer.UpdateRuntime(
	self: NpcServiceServer,
	runtime: NpcRuntime,
	reason: string,
	refreshBiome: boolean
)
	if runtime.isRemoving then
		return
	end

	local previousState = runtime.state
	local previousHp = runtime.hp
	local previousMaxHp = runtime.maxHp
	local previousAlive = runtime.isAlive

	self:syncRuntimeVitals(runtime)
	if self.enemyHitbox ~= nil then
		self.enemyHitbox:setEnemyAlive(runtime.id, runtime.isAlive)
	end

	if refreshBiome then
		self:refreshRuntimeBiome(runtime)
	end

	self:ensureRuntimeAnimationEventBindings(runtime)

	local desiredState = self:resolveRuntimeState(runtime)
	local transitioned = self:transitionRuntimeState(runtime, desiredState, reason, false)
	if
		transitioned
		and runtime.state == previousState
		and (runtime.hp ~= previousHp or runtime.maxHp ~= previousMaxHp or runtime.isAlive ~= previousAlive)
	then
		local payload = self:createSnapshot(runtime) :: any
		payload.previousState = previousState
		self:broadcast(NpcServiceUtils.CLIENT_METHOD_NPC_STATE_CHANGED, payload)
	end
end

function NpcServiceServer.TrackRuntime(self: NpcServiceServer, runtime: NpcRuntime)
	self.runtimes[runtime.id] = runtime

	local model = runtime.slime.model
	if model ~= nil then
		self.runtimesByModel[model] = runtime
		applyRuntimeModelAttributes(runtime, model)
	end
	self:syncRuntimeGoreRegistration(runtime)

	runtime.janitor:GiveChore(runtime.slime.signals.spawned:Connect(function(modelInstance: Model)
		self.runtimesByModel[modelInstance] = runtime
		applyRuntimeModelAttributes(runtime, modelInstance)
		runtime.animationEventsBound = false
		runtime.deathGoreEmitted = false
		runtime.lastPreDamageSlimeBloodAt = -math.huge
		self:syncRuntimeGoreRegistration(runtime)
		self:applyRuntimeNpcCollisionGroup(runtime)
		if self.enemyHitbox ~= nil then
			self.enemyHitbox:setEnemyModel(runtime.id, modelInstance)
			self.enemyHitbox:setEnemyAlive(runtime.id, runtime.slime.isAlive)
		end
		self:syncRuntimeVitals(runtime)
		self:updateRuntime(runtime, "spawned", true)
	end))

	runtime.janitor:GiveChore(runtime.slime.signals.stateChanged:Connect(function()
		self:updateRuntime(runtime, "npcStateChanged", false)
	end))

	runtime.janitor:GiveChore(runtime.slime.signals.targetChanged:Connect(function()
		self:updateRuntime(runtime, "targetChanged", false)
	end))

	runtime.janitor:GiveChore(runtime.npc.signals.attacked:Connect(function()
		runtime.lastEnemyHitAt = os.clock()
		self:updateRuntime(runtime, "npcAttacked", false)
	end))

	runtime.janitor:GiveChore(
		runtime.slime.signals.damaged:Connect(function(damageAmount: number, _source: any?, hpRaw: number?)
			if self.goreService ~= nil then
				local didEmit = self.goreService:onNpcDamaged(runtime.id, runtime.slime.rootPart, damageAmount)
				if not didEmit then
					self:syncRuntimeGoreRegistration(runtime)
					self.goreService:onNpcDamaged(runtime.id, runtime.slime.rootPart, damageAmount)
				end
			end

			if not runtime.deathGoreEmitted and typeof(hpRaw) == "number" and hpRaw <= 0 then
				local deathOrigin = self:resolveRuntimeDeathOrigin(runtime)
				self:emitRuntimeDeathGore(runtime, deathOrigin)
			end

			self:syncRuntimeVitals(runtime)
			self:updateRuntime(runtime, "damaged", false)
		end)
	)

	runtime.janitor:GiveChore(runtime.slime.signals.died:Connect(function()
		self:emitRuntimeDeathGore(runtime, nil)
		runtime.isAlive = false
		runtime.hp = 0
		self:playRuntimeNamedSound(runtime, "Death")
		if self.enemyHitbox ~= nil then
			self.enemyHitbox:setEnemyAlive(runtime.id, false)
		end
		local lootService = self.lootService
		if lootService ~= nil then
			local deathPosition = runtime.slime:getPosition()
			if deathPosition == nil then
				local rootPart = InstanceUtils.resolveModelRootPart(runtime.slime.model)
				if rootPart ~= nil then
					deathPosition = rootPart.Position
				end
			end
			if deathPosition ~= nil then
				lootService:spawnLootRuntime(SLIME_GEL_DROP_ITEM_ID, SLIME_GEL_DROP_AMOUNT, deathPosition, {
					sourceType = runtime.displayName,
				})
				lootService:spawnDropsFromSource(runtime.displayName, deathPosition, {
					sourceType = runtime.displayName,
				})
			end
		end
		self:transitionRuntimeState(runtime, "Dead", "died", true)
		task.delay(2, function()
			local activeRuntime = self:getRuntime(runtime.id)
			if activeRuntime == nil then
				return
			end
			if activeRuntime.slime.isAlive then
				return
			end
			self:removeRuntime(runtime.id, "deathCleanup")
		end)
	end))

	local runtimeModel = runtime.slime.model
	if runtimeModel then
		runtime.janitor:GiveChore(runtimeModel.Destroying:Connect(function()
			if runtime.isRemoving then
				return
			end
			self:removeRuntime(runtime.id, "modelDestroyed")
		end))
	end

	self:applyRuntimeNpcCollisionGroup(runtime)
	self:registerRuntimeEnemyHitbox(runtime)
end

function NpcServiceServer.SpawnSlime(self: NpcServiceServer, spawnConfig: SlimeSpawnConfig): NpcRuntime?
	local modelName = if spawnConfig.modelHierarchy ~= nil and spawnConfig.modelHierarchy ~= ""
		then spawnConfig.modelHierarchy
		else spawnConfig.modelName

	local slime = Slime.new({
		archetype = spawnConfig.slimeType,
		displayName = spawnConfig.displayName,
		modelName = modelName,
		slimeType = spawnConfig.slimeType,
		hp = DEFAULT_SLIME_HP,
		maxHp = DEFAULT_SLIME_HP,
		aggroOnPlayer = spawnConfig.aggroOnPlayer,
		passiveUntilHit = spawnConfig.passiveUntilHit,
		lockTo2DPlane = true,
		planeX = spawnConfig.planeX,
		restDuration = spawnConfig.restDuration,
		hopDuration = spawnConfig.hopDuration,
		hopDistance = spawnConfig.hopDistance,
		movement = {
			canWander = false,
			thinkInterval = 0.1,
			autoRotate = false,
		},
		combat = {
			attackRange = 0,
			attackCooldown = 1.1,
		},
		lifecycle = {
			spawnParent = self.npcFolder,
			autoDestroyModelOnDeath = true,
			autoStart = false,
		},
	})

	local model = slime:start(spawnConfig.spawnCFrame)
	if model == nil then
		slime:destroy()
		return nil
	end

	local runtimeJanitor = Janitor.new()
	local animationEventJanitor = Janitor.new()
	runtimeJanitor:GiveChore(animationEventJanitor)

	local defaultAnimationEvents = NpcServiceUtils.createDefaultSlimeAnimationEvents()
	local runtime: NpcRuntime = {
		id = slime.uniqueId,
		entityId = if typeof(spawnConfig.slimeType) == "string" and spawnConfig.slimeType ~= ""
			then spawnConfig.slimeType
			else if typeof(spawnConfig.modelName) == "string" and spawnConfig.modelName ~= ""
				then spawnConfig.modelName
				else spawnConfig.displayName,
		npcType = "Slime",
		displayName = spawnConfig.displayName,
		npc = slime,
		slime = slime,
		hp = slime.hp,
		maxHp = slime.maxHp,
		isAlive = slime.isAlive,
		state = "Dormant",
		lastReason = "spawn",
		biomeName = "Unknown",
		biomeReady = false,
		animationEvents = NpcServiceUtils.sanitizeAnimationEventsByTrack(
			spawnConfig.animationEvents,
			defaultAnimationEvents
		),
		stateGraph = NpcServiceUtils.createDefaultStateMachineGraph(),
		updatedAt = os.clock(),
		janitor = runtimeJanitor,
		animationEventJanitor = animationEventJanitor,
		animationEventsBound = false,
		isRemoving = false,
		deathGoreEmitted = false,
		enemyHitboxId = nil,
		lastEnemyHitAt = -math.huge,
		lastPreDamageSlimeBloodAt = -math.huge,
	}

	self:trackRuntime(runtime)
	self:transitionRuntimeState(runtime, "Spawning", "spawn", true)
	self:updateRuntime(runtime, "spawn", true)
	self:broadcast(NpcServiceUtils.CLIENT_METHOD_NPC_ADDED, self:createSnapshot(runtime))
	return runtime
end

function NpcServiceServer.SpawnInitialSlimes(self: NpcServiceServer)
	local settings = self.slimeSpawnSettings
	if not settings.enabled then
		return
	end

	local maxInitial = math.min(settings.initialSpawnCount, settings.maxAlive)
	for _ = 1, maxInitial do
		local spawnCFrame = self:getNextSpawnCFrame()
		if spawnCFrame == nil then
			continue
		end
		local spawnConfig = self:createDefaultSpawnConfigAt(spawnCFrame)
		if spawnConfig ~= nil then
			self:spawnSlime(spawnConfig)
		end
	end
end

function NpcServiceServer.OnHeartbeat(self: NpcServiceServer, dt: number)
	local settings = self.slimeSpawnSettings
	self.despawnRefreshAccumulator += dt
	if self.despawnRefreshAccumulator >= DEFAULT_DESPAWN_CHECK_INTERVAL then
		self.despawnRefreshAccumulator = 0
		self:despawnFarRuntimes("heartbeatDistance")
	end

	if settings.enabled then
		self.spawnAccumulator += dt
		while self.spawnAccumulator >= settings.spawnRate do
			self.spawnAccumulator -= settings.spawnRate
			self:tryAutoSpawnSlime("spawnRateTick")
		end
	end

	self.stateRefreshAccumulator += dt
	self.biomeRefreshAccumulator += dt

	local shouldRefreshState = self.stateRefreshAccumulator >= DEFAULT_STATE_REFRESH_INTERVAL
	local shouldRefreshBiome = self.biomeRefreshAccumulator >= DEFAULT_BIOME_REFRESH_INTERVAL
	if not shouldRefreshState and not shouldRefreshBiome then
		return
	end

	if shouldRefreshState then
		self.stateRefreshAccumulator = 0
	end
	if shouldRefreshBiome then
		self.biomeRefreshAccumulator = 0
		self:resolveWorld()
	end

	for _, runtime in self.runtimes do
		self:updateRuntime(runtime, "heartbeat", shouldRefreshBiome)
	end
end

function NpcServiceServer.Init(self: NpcServiceServer)
	self.networker = Networker.server.new("NpcService", self, {
		self.RequestSync,
	})
	self.runtimes = {}
	self.runtimesByModel = {}
	self.world = nil
	self.soundService = AudioServiceServer :: AudioServiceServerObject
	self.lootService = LootServiceServer :: LootServiceServerObject
	self.goreService = GoreServiceServer :: GoreServiceServerObject
	self.collisionGroupsReady = false
	self.playerCharacterAddedConnections = {}
	self:ensureCollisionGroups()
	self.enemyHitbox = EnemyHitbox.new({
		cellSize = 8,
		playerCellSize = 8,
	})
	self.npcFolder = self:ensureNpcFolder()
	local rawNpcSettings = if typeof(Configs) == "table" then (Configs :: any).npcSettings else nil
	local rawSlimeSettings = if typeof(rawNpcSettings) == "table" then (rawNpcSettings :: any).slime else nil
	self.slimeSpawnSettings = NpcServiceUtils.sanitizeSlimeSpawnSettings(rawSlimeSettings, nil)
	self.spawnCFrames = NpcServiceUtils.collectSpawnCFrames(math.max(1, self.slimeSpawnSettings.maxAlive))
	self.nextSpawnIndex = 1
	self.spawnAccumulator = 0
	self.despawnRefreshAccumulator = 0
	self.random = Random.new()
	self.missingSlimeBloodTemplateWarningShown = false
	self.stateRefreshAccumulator = 0
	self.biomeRefreshAccumulator = 0
	self.binders = NevermoreSupport.getService(ServerBinderSupport)

	for _, player in Players:GetPlayers() do
		self:bindPlayerCollisionGroup(player)
	end

	self.playerAddedConnection = Players.PlayerAdded:Connect(function(player: Player)
		self:bindPlayerCollisionGroup(player)
		if PlayerServiceServer:isGameplayActiveForPlayer(player) then
			self:pushState(player)
		end
	end)
	self.playerRemovingConnection = Players.PlayerRemoving:Connect(function(player: Player)
		self:unbindPlayerCollisionGroup(player)
	end)

	self.heartbeatConnection = RunService.Heartbeat:Connect(function(dt: number)
		self:onHeartbeat(dt)
	end)

	self:spawnInitialSlimes()
end

function NpcServiceServer.Destroy(self: NpcServiceServer)
	if self.playerAddedConnection then
		self.playerAddedConnection:Disconnect()
		self.playerAddedConnection = nil
	end
	if self.playerRemovingConnection then
		self.playerRemovingConnection:Disconnect()
		self.playerRemovingConnection = nil
	end

	for player, connection in self.playerCharacterAddedConnections do
		connection:Disconnect()
		self.playerCharacterAddedConnections[player] = nil
	end

	if self.heartbeatConnection then
		self.heartbeatConnection:Disconnect()
		self.heartbeatConnection = nil
	end

	local runtimeIds = {}
	for runtimeId in self.runtimes do
		table.insert(runtimeIds, runtimeId)
	end
	for _, runtimeId in runtimeIds do
		self:removeRuntime(runtimeId, "serviceDestroyed")
	end

	if self.enemyHitbox ~= nil then
		self.enemyHitbox:destroy()
		self.enemyHitbox = nil
	end

	if self.networker then
		self.networker:destroy()
	end
	self.soundService = nil
	self.lootService = nil
	self.goreService = nil
end

