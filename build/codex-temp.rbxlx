	Enum.KeyCode.End,
	Enum.KeyCode.PageUp,
	Enum.KeyCode.PageDown,
	Enum.KeyCode.F1,
	Enum.KeyCode.F2,
	Enum.KeyCode.F3,
	Enum.KeyCode.F4,
	Enum.KeyCode.F5,
	Enum.KeyCode.F6,
	Enum.KeyCode.F7,
	Enum.KeyCode.F8,
	Enum.KeyCode.F9,
	Enum.KeyCode.F10,
	Enum.KeyCode.F11,
	Enum.KeyCode.F12,
	Enum.KeyCode.F13,
	Enum.KeyCode.F14,
	Enum.KeyCode.F15,
	Enum.KeyCode.NumLock,
	Enum.KeyCode.CapsLock,
	Enum.KeyCode.ScrollLock,
	Enum.KeyCode.RightShift,
	Enum.KeyCode.LeftShift,
