                <Item class="Folder" referent="921">
                  <Properties>
                    <string name="Name">hooks</string>
                  </Properties>
                  <Item class="ModuleScript" referent="922">
                    <Properties>
                      <string name="Name">useCoinEmerge</string>
                      <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local React = require(ReplicatedStorage.Packages.React)
local Ripple = require(ReplicatedStorage.Packages.Ripple)

type NumberMotion = Ripple.Motion<number>
type SpringOptions = Ripple.SpringOptions

export type CoinEmergeOptions = {
	enabled: boolean?,
	fromOffset: Vector2?,
	toOffset: Vector2?,
	spring: SpringOptions?,
}

export type CoinEmergeState = {
	progress: number,
	offset: Vector2,
	transparency: number,
}

local DEFAULT_SPRING: SpringOptions = {
	frequency = 1,
	damping = 0.9,
}

local DEFAULT_FROM_OFFSET = Vector2.new(-240, 0)
local DEFAULT_TO_OFFSET = Vector2.zero

local function sanitizeVector2(valueRaw: any, fallback: Vector2): Vector2
	if typeof(valueRaw) ~= "Vector2" then
		return fallback
	end
	if valueRaw.X ~= valueRaw.X or valueRaw.Y ~= valueRaw.Y then
		return fallback
	end
	return valueRaw
end

local function sanitizeTransparency(valueRaw: number): number
	return math.clamp(valueRaw, 0, 1)
end

local function useCoinEmerge(options: CoinEmergeOptions?): CoinEmergeState
	local enabled = if options and options.enabled ~= nil then options.enabled else false
	local fromOffset = sanitizeVector2(if options then options.fromOffset else nil, DEFAULT_FROM_OFFSET)
	local toOffset = sanitizeVector2(if options then options.toOffset else nil, DEFAULT_TO_OFFSET)
	local spring = if options and options.spring ~= nil then options.spring else DEFAULT_SPRING
	local targetRef = React.useRef(if enabled then 1 else 0)
	local progress, setProgress = React.useState(targetRef.current)

	React.useEffect(function()
		targetRef.current = if enabled then 1 else 0
	end, { enabled })

	React.useEffect(function()
		local motion: NumberMotion = Ripple.createMotion(progress)
		local connection = RunService.RenderStepped:Connect(function(deltaTime: number)
			motion:spring(targetRef.current, spring)
			local nextProgress = math.clamp(motion:step(deltaTime), 0, 1)
			setProgress(nextProgress)
		end)

		return function()
			connection:Disconnect()
			motion:destroy()
		end
	end, { spring })

	local offset = fromOffset:Lerp(toOffset, progress)
	local totalDistance = (toOffset - fromOffset).Magnitude
	local remainingDistance = (toOffset - offset).Magnitude
	local transparency = if totalDistance <= 0.0001
		then 0
		else sanitizeTransparency(remainingDistance / totalDistance)

	return {
		progress = progress,
		offset = offset,
		transparency = transparency,
	}
end

return useCoinEmerge
]]></string>
                    </Properties>
                  </Item>
                  <Item class="ModuleScript" referent="923">
                    <Properties>
                      <string name="Name">useInventorySlide</string>
                      <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local React = require(ReplicatedStorage.Packages.React)
local Ripple = require(ReplicatedStorage.Packages.Ripple)

type NumberMotion = Ripple.Motion<number>
type SpringOptions = Ripple.SpringOptions

export type InventorySlideOptions = {
	enabled: boolean?,
	spring: SpringOptions?,
}

local DEFAULT_SPRING: SpringOptions = {
	frequency = 0.5,
	damping = 1,
}

local function useInventorySlide(options: InventorySlideOptions?): number
	local enabled = if options and options.enabled ~= nil then options.enabled else false
	local spring = if options and options.spring ~= nil then options.spring else DEFAULT_SPRING
	local targetRef = React.useRef(if enabled then 1 else 0)
	local progress, setProgress = React.useState(targetRef.current)

	React.useEffect(function()
		targetRef.current = if enabled then 1 else 0
	end, { enabled })

	React.useEffect(function()
		local motion: NumberMotion = Ripple.createMotion(progress)
		local connection = RunService.RenderStepped:Connect(function(deltaTime: number)
			motion:spring(targetRef.current, spring)
			local nextProgress = math.clamp(motion:step(deltaTime), 0, 1)
			setProgress(nextProgress)
		end)

		return function()
			connection:Disconnect()
			motion:destroy()
		end
	end, { spring })

	return progress
end

return useInventorySlide
]]></string>
                    </Properties>
                  </Item>
                  <Item class="ModuleScript" referent="924">
                    <Properties>
                      <string name="Name">useSlotSelect</string>
                      <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local React = require(ReplicatedStorage.Packages.React)
local Ripple = require(ReplicatedStorage.Packages.Ripple)

type NumberMotion = Ripple.Motion<number>
type SpringOptions = Ripple.SpringOptions

export type SlotSelectOptions = {
	enabled: boolean?,
	normalScale: number?,
	selectedScale: number?,
	spring: SpringOptions?,
}

local DEFAULT_SPRING: SpringOptions = {
	frequency = 0.25,
	damping = 0.82,
}

local DEFAULT_NORMAL_SCALE = 1
local DEFAULT_SELECTED_SCALE = 1.12

local function sanitizeScale(valueRaw: any, fallback: number): number
	if typeof(valueRaw) ~= "number" or valueRaw ~= valueRaw or valueRaw <= 0 then
		return fallback
	end
	return valueRaw
end

local function useSlotSelect(options: SlotSelectOptions?): number
	local enabled = if options and options.enabled ~= nil then options.enabled else false
	local normalScale = sanitizeScale(if options then options.normalScale else nil, DEFAULT_NORMAL_SCALE)
	local selectedScale = math.max(
		normalScale,
		sanitizeScale(if options then options.selectedScale else nil, DEFAULT_SELECTED_SCALE)
	)
	local spring = if options and options.spring ~= nil then options.spring else DEFAULT_SPRING
	local targetRef = React.useRef(if enabled then 1 else 0)
	local progress, setProgress = React.useState(targetRef.current)

	React.useEffect(function()
		targetRef.current = if enabled then 1 else 0
	end, { enabled })

	React.useEffect(function()
		local motion: NumberMotion = Ripple.createMotion(progress)
		local connection = RunService.RenderStepped:Connect(function(deltaTime: number)
			motion:spring(targetRef.current, spring)
			local nextProgress = math.clamp(motion:step(deltaTime), 0, 1)
			setProgress(nextProgress)
		end)

		return function()
			connection:Disconnect()
			motion:destroy()
		end
	end, { spring })

	return normalScale + (selectedScale - normalScale) * progress
end

return useSlotSelect
]]></string>
                    </Properties>
                  </Item>
                  <Item class="ModuleScript" referent="925">
                    <Properties>
                      <string name="Name">useTrashAppear</string>
                      <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local React = require(ReplicatedStorage.Packages.React)
local Ripple = require(ReplicatedStorage.Packages.Ripple)

type NumberMotion = Ripple.Motion<number>
type SpringOptions = Ripple.SpringOptions

export type TrashAppearOptions = {
	enabled: boolean?,
	fromOffset: Vector2?,
	toOffset: Vector2?,
	spring: SpringOptions?,
}

export type TrashAppearState = {
	progress: number,
	offset: Vector2,
	transparency: number,
}

local DEFAULT_SPRING: SpringOptions = {
	frequency = 1,
	damping = 0.82,
}

local DEFAULT_FROM_OFFSET = Vector2.new(-32, 0)
local DEFAULT_TO_OFFSET = Vector2.zero

local function sanitizeVector2(valueRaw: any, fallback: Vector2): Vector2
	if typeof(valueRaw) ~= "Vector2" then
		return fallback
	end
	if valueRaw.X ~= valueRaw.X or valueRaw.Y ~= valueRaw.Y then
		return fallback
	end
	return valueRaw
end

local function sanitizeTransparency(valueRaw: number): number
	return math.clamp(valueRaw, 0, 1)
end

local function smoothstep(alphaRaw: number): number
	local alpha = math.clamp(alphaRaw, 0, 1)
	return alpha * alpha * (3 - 2 * alpha)
end

local function useTrashAppear(options: TrashAppearOptions?): TrashAppearState
	local enabled = if options and options.enabled ~= nil then options.enabled else false
	local fromOffset = sanitizeVector2(if options then options.fromOffset else nil, DEFAULT_FROM_OFFSET)
	local toOffset = sanitizeVector2(if options then options.toOffset else nil, DEFAULT_TO_OFFSET)
	local spring = if options and options.spring ~= nil then options.spring else DEFAULT_SPRING

	local targetRef = React.useRef(if enabled then 1 else 0)
	local progress, setProgress = React.useState(targetRef.current)

	React.useEffect(function()
		targetRef.current = if enabled then 1 else 0
	end, { enabled })

	React.useEffect(function()
		local motion: NumberMotion = Ripple.createMotion(progress)
		local connection = RunService.RenderStepped:Connect(function(deltaTime: number)
			motion:spring(targetRef.current, spring)
			local nextProgress = math.clamp(motion:step(deltaTime), 0, 1)
			setProgress(nextProgress)
		end)

		return function()
			connection:Disconnect()
			motion:destroy()
		end
	end, { spring })

	local fluidProgress = smoothstep(progress)
	local offset = fromOffset:Lerp(toOffset, fluidProgress)
	local totalDistance = (toOffset - fromOffset).Magnitude
	local remainingDistance = (toOffset - offset).Magnitude
	local transparency = if totalDistance <= 0.0001
		then 0
		else sanitizeTransparency(remainingDistance / totalDistance)

	return {
		progress = progress,
		offset = offset,
		transparency = transparency,
	}
end

return useTrashAppear
]]></string>
                    </Properties>
                  </Item>
                </Item>
                <Item class="Folder" referent="926">
                  <Properties>
                    <string name="Name">screens</string>
                  </Properties>
                  <Item class="ModuleScript" referent="927">
                    <Properties>
                      <string name="Name">coinScreen</string>
                      <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CoinRow = require(script:FindFirstAncestor("game").Client.UI.features.inventory.components.CoinRow)
local ImageIds = require(script:FindFirstAncestor("game").Client.UI.core.ImageIds)
local ItemRegistry = require(script:FindFirstAncestor("game").Shared.Modules.Items.Registry)
local React = require(ReplicatedStorage.Packages.React)
local coinSlice = require(script:FindFirstAncestor("game").Client.UI.features.inventory.state.coinSlice)
local coinThunks = require(script:FindFirstAncestor("game").Client.UI.features.inventory.state.coinThunks)
local formatNumber = require(script:FindFirstAncestor("game").Client.UI.core.utils.formatNumber)
local infoThunks = require(script:FindFirstAncestor("game").Client.UI.features.info.state.infoThunks)
local useStore = require(script:FindFirstAncestor("game").Client.UI.core.hooks.useStore)

type CoinType = coinSlice.CoinType
type CoinState = coinSlice.CoinState

type CoinScreenProps = {
	layoutOrder: number?,
	visible: boolean?,
	zIndex: number?,
	position: UDim2?,
	anchorPoint: Vector2?,
	slotSize: UDim2?,
	emergeOffset: Vector2?,
	emergeTransparency: number?,
}

type CoinItemData = {
	name: string?,
	description: string?,
	value: string?,
}

type CoinDefinition = {
	id: CoinType,
	fallbackName: string,
	spriteSheetKey: string,
	itemData: CoinItemData,
}

local e: typeof(React.createElement) = React.createElement

local COIN_HOVER_ID_PREFIX = "inventory_coin_"
local DEFAULT_COIN_SLOT_SIZE = 58
local COIN_ICON_SIZE = 34
local COIN_ICON_TOP_PADDING = 4
local COIN_AMOUNT_HEIGHT = 16
local COIN_AMOUNT_GAP = 1

local function resolveCoinItemData(itemId: string): CoinItemData
	local definition = ItemRegistry.resolveDefinition(itemId)
	if typeof(definition) ~= "table" then
		return {}
	end

	return definition :: CoinItemData
end

local COIN_RENDER_ORDER: { CoinDefinition } = {
	{
		id = "copper",
		fallbackName = "Copper Coin",
		spriteSheetKey = "copperCoin",
		itemData = resolveCoinItemData("CopperCoin"),
	},
	{
		id = "silver",
		fallbackName = "Silver Coin",
		spriteSheetKey = "silverCoin",
		itemData = resolveCoinItemData("SilverCoin"),
	},
	{
		id = "gold",
		fallbackName = "Gold Coin",
		spriteSheetKey = "goldCoin",
		itemData = resolveCoinItemData("GoldCoin"),
	},
	{
		id = "platinum",
		fallbackName = "Platinum Coin",
		spriteSheetKey = "platinumCoin",
		itemData = resolveCoinItemData("PlatinumCoin"),
	},
}

local function resolveCoinAmount(state: CoinState, coinType: CoinType): number
	local amounts = state.amounts
	return if coinType == "platinum"
		then amounts.platinum
		else if coinType == "gold"
			then amounts.gold
			else if coinType == "silver" then amounts.silver else amounts.copper
end

local function resolveItemField(valueRaw: any, fallback: string): string
	if typeof(valueRaw) ~= "string" then
		return fallback
	end

	local trimmed = string.match(valueRaw, "^%s*(.-)%s*$") or ""
	if trimmed == "" then
		return fallback
	end
	return trimmed
end

local function resolveHoverText(coinDefinition: CoinDefinition, amount: number): string
	local itemData = coinDefinition.itemData
	local itemName = resolveItemField(itemData.name, coinDefinition.fallbackName)
	local itemDescription = resolveItemField(itemData.description, "No description.")
	local itemValue = resolveItemField(itemData.value, "Unknown value")

	return ("%s\n\n%s\n\nValue: %s\n\nOwned: %s"):format(itemName, itemDescription, itemValue, formatNumber(amount))
end

local function resolveEmergeOffset(offsetRaw: any): Vector2
	if typeof(offsetRaw) ~= "Vector2" then
		return Vector2.zero
	end
	if offsetRaw.X ~= offsetRaw.X or offsetRaw.Y ~= offsetRaw.Y then
		return Vector2.zero
	end
	return offsetRaw
end

local function resolveTransparency(valueRaw: any): number
	if typeof(valueRaw) ~= "number" or valueRaw ~= valueRaw then
		return 0
	end
	return math.clamp(valueRaw, 0, 1)
end

local function applyOffset(base: UDim2, offset: Vector2): UDim2
	return UDim2.new(base.X.Scale, base.X.Offset + offset.X, base.Y.Scale, base.Y.Offset + offset.Y)
end

return function(props: CoinScreenProps): React.ReactNode
	local coinState = (useStore(coinSlice.coinStateAtom) :: CoinState?) or coinSlice.coinStateAtom()

	React.useEffect(function()
		local stop = coinThunks.start()

		return function()
			stop()
			infoThunks.hideHover(nil)
		end
	end, {})

	if props.visible == false then
		return nil
	end

	local zIndex = props.zIndex or 40
	local emergeOffset = resolveEmergeOffset(props.emergeOffset)
	local emergeTransparency = resolveTransparency(props.emergeTransparency)
	local slotWidth = if props.slotSize ~= nil
		then math.max(1, math.floor(props.slotSize.X.Offset + 0.5))
		else DEFAULT_COIN_SLOT_SIZE
	local slotHeight = if props.slotSize ~= nil
		then math.max(1, math.floor(props.slotSize.Y.Offset + 0.5))
		else DEFAULT_COIN_SLOT_SIZE
	local iconTop = math.max(0, COIN_ICON_TOP_PADDING)
	local amountTop = iconTop + COIN_ICON_SIZE + COIN_AMOUNT_GAP
	local spriteSheets = if typeof(ImageIds.spriteSheets) == "table" then ImageIds.spriteSheets else {}
	local renderedCoinCount = 0
	local coinRowItems: { any } = {}

	for _, coinDefinition in COIN_RENDER_ORDER do
		local spriteSheetImage = (spriteSheets :: { [string]: any })[coinDefinition.spriteSheetKey]
		if typeof(spriteSheetImage) ~= "string" then
			if coinDefinition.id == "silver" then
				spriteSheetImage = (spriteSheets :: { [string]: any }).silverCoin
			end
		end

		if typeof(spriteSheetImage) ~= "string" then
			continue
		end

		renderedCoinCount += 1
		local coinAmount = resolveCoinAmount(coinState, coinDefinition.id)
		local coinLayoutOrder = renderedCoinCount
		local hoverId = COIN_HOVER_ID_PREFIX .. coinDefinition.id

		coinRowItems[#coinRowItems + 1] = {
			id = coinDefinition.id,
			amount = coinAmount,
			spriteSheetImage = spriteSheetImage,
			hoverId = hoverId,
			hoverText = resolveHoverText(coinDefinition, coinAmount),
			layoutOrder = coinLayoutOrder,
		}
	end

	if renderedCoinCount <= 0 then
		return nil
	end

	return e("Frame", {
		Size = UDim2.fromOffset(slotWidth * renderedCoinCount, slotHeight),
		Position = applyOffset(props.position or UDim2.fromScale(1, 1), emergeOffset),
		AnchorPoint = props.anchorPoint or Vector2.new(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		LayoutOrder = props.layoutOrder or 1,
		ZIndex = zIndex,
		Visible = props.visible ~= false,
	}, {
		e(CoinRow, {
			coins = coinRowItems,
			slotWidth = slotWidth,
			slotHeight = slotHeight,
			iconTop = iconTop,
			iconSize = COIN_ICON_SIZE,
			amountTop = amountTop,
			amountHeight = COIN_AMOUNT_HEIGHT,
			emergeTransparency = emergeTransparency,
			zIndex = zIndex,
			onHoverStart = function(coin)
				if emergeTransparency >= 0.98 then
					return
				end
				infoThunks.showHover({
					id = coin.hoverId,
					text = coin.hoverText,
				})
			end,
			onHoverEnd = function(coin)
				infoThunks.hideHover(coin.hoverId)
			end,
		}),
	})
end
]]></string>
                    </Properties>
                  </Item>
                  <Item class="ModuleScript" referent="928">
                    <Properties>
                      <string name="Name">trashScreen</string>
                      <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local React = require(ReplicatedStorage.Packages.React)
local TrashButton = require(script:FindFirstAncestor("game").Client.UI.features.inventory.components.TrashButton)
local UiSound = require(script:FindFirstAncestor("game").Client.UI.core.utils.UiSound)
local infoThunks = require(script:FindFirstAncestor("game").Client.UI.features.info.state.infoThunks)
local itemSlice = require(script:FindFirstAncestor("game").Client.UI.features.item.state.itemSlice)
local itemThunks = require(script:FindFirstAncestor("game").Client.UI.features.item.state.itemThunks)
local trashSlice = require(script:FindFirstAncestor("game").Client.UI.features.inventory.state.trashSlice)
local trashThunks = require(script:FindFirstAncestor("game").Client.UI.features.inventory.state.trashThunks)
local useStore = require(script:FindFirstAncestor("game").Client.UI.core.hooks.useStore)

type TrashState = trashSlice.TrashState
type ItemDragState = itemSlice.ItemDragState

type TrashScreenProps = {
	layoutOrder: number?,
	visible: boolean?,
	zIndex: number?,
	position: UDim2?,
	anchorPoint: Vector2?,
	size: UDim2?,
	emergeOffset: Vector2?,
	emergeTransparency: number?,
}

local e: typeof(React.createElement) = React.createElement

local TRASH_HOVER_ID = "inventory_trash"
local DEFAULT_SIZE = UDim2.fromOffset(58, 58)

local function resolveEmergeOffset(offsetRaw: any): Vector2
	if typeof(offsetRaw) ~= "Vector2" then
		return Vector2.zero
	end
	if offsetRaw.X ~= offsetRaw.X or offsetRaw.Y ~= offsetRaw.Y then
		return Vector2.zero
	end
	return offsetRaw
end

local function resolveTransparency(valueRaw: any): number
	if typeof(valueRaw) ~= "number" or valueRaw ~= valueRaw then
		return 0
	end
	return math.clamp(valueRaw, 0, 1)
end

local function applyOffset(base: UDim2, offset: Vector2): UDim2
	return UDim2.new(base.X.Scale, base.X.Offset + offset.X, base.Y.Scale, base.Y.Offset + offset.Y)
end

local function playUiTrashSound(soundAssetId: string?)
	UiSound.play(soundAssetId)
end

local function resolveHoverText(state: TrashState, dragState: ItemDragState): string
	if dragState.active and dragState.stack ~= nil then
		local slotIndex = if typeof(dragState.sourceSlot) == "number" then dragState.sourceSlot else 0
		return ("Trash\n\nDrop to destroy:\n%s"):format(itemThunks.resolveHoverTextForStack(dragState.stack, slotIndex))
	end

	if not state.canTrash or state.selectedStack == nil or state.selectedSlot == nil then
		return "Trash\n\nSelect an inventory slot to trash items."
	end

	return ("Trash\n\n%s"):format(itemThunks.resolveHoverTextForStack(state.selectedStack, state.selectedSlot))
end

return function(props: TrashScreenProps): React.ReactNode
	local state = (useStore(trashSlice.trashStateAtom) :: TrashState?) or trashSlice.getTrashState()
	local dragState = (useStore(itemSlice.dragStateAtom) :: ItemDragState?) or itemSlice.getDragState()

	React.useEffect(function()
		local stop = trashThunks.start()

		return function()
			stop()
			infoThunks.hideHover(TRASH_HOVER_ID)
		end
	end, {})

	React.useEffect(function()
		if not state.isHovered then
			return
		end
		infoThunks.showHover({
			id = TRASH_HOVER_ID,
			text = resolveHoverText(state, dragState),
		})
	end, { state.updatedAt, state.isHovered, dragState.updatedAt, dragState.active })

	if props.visible == false then
		return nil
	end

	local zIndex = props.zIndex or 60
	local emergeOffset = resolveEmergeOffset(props.emergeOffset)
	local emergeTransparency = resolveTransparency(props.emergeTransparency)
	local canTrashDragged = dragState.active and dragState.stack ~= nil and dragState.sourceSlot ~= nil
	local canInteract = canTrashDragged or state.canTrash
	local isBrightHover = state.isHovered and canTrashDragged
	local imageColor = if isBrightHover
		then Color3.fromRGB(255, 255, 255)
		else if canInteract then Color3.fromRGB(222, 222, 222) else Color3.fromRGB(180, 180, 180)

	return e(TrashButton, {
		size = props.size or DEFAULT_SIZE,
		position = applyOffset(props.position or UDim2.fromScale(1, 1), emergeOffset),
		anchorPoint = props.anchorPoint or Vector2.new(1, 0),
		layoutOrder = props.layoutOrder or 1,
		zIndex = zIndex,
		isOpen = state.isOpen,
		imageColor3 = imageColor,
		imageTransparency = emergeTransparency,
		active = emergeTransparency < 0.98,
		selectable = emergeTransparency < 0.98,
		onMouseEnter = function()
			trashThunks.open()
			infoThunks.showHover({
				id = TRASH_HOVER_ID,
				text = resolveHoverText(state, dragState),
			})
			playUiTrashSound((UiSound :: any).trashCanOpen)
		end,
		onMouseLeave = function()
			trashThunks.close()
			infoThunks.hideHover(TRASH_HOVER_ID)
			playUiTrashSound((UiSound :: any).trashCanClose)
		end,
		onInputBegan = function(_: GuiObject, inputObject: InputObject)
			local inputType = inputObject.UserInputType
			if inputType ~= Enum.UserInputType.MouseButton1 and inputType ~= Enum.UserInputType.Touch then
				return
			end
			if not canTrashDragged then
				return
			end

			local didRequest = itemThunks.trashDrag(nil)
			if didRequest then
				playUiTrashSound((UiSound :: any).itemPutDown)
				playUiTrashSound(UiSound.trash)
			end
		end,
		onActivated = function()
			if canTrashDragged then
				return
			end
			if not state.canTrash then
				return
			end

			local didRequest = trashThunks.trashSelected(nil)
			if didRequest then
				playUiTrashSound(UiSound.trash)
			end
		end,
	})
end
]]></string>
                    </Properties>
                  </Item>
                </Item>
                <Item class="Folder" referent="929">
                  <Properties>
                    <string name="Name">state</string>
                  </Properties>
                  <Item class="ModuleScript" referent="930">
                    <Properties>
                      <string name="Name">coinSlice</string>
                      <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Charm = require(ReplicatedStorage.Packages.Charm)
local PlayerDataServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.PlayerDataServiceUtils)

export type CoinType = "copper" | "silver" | "gold" | "platinum"
export type CoinAmounts = {
	copper: number,
	silver: number,
	gold: number,
	platinum: number,
}
export type CoinState = {
	loadState: PlayerDataServiceUtils.LoadState,
	amounts: CoinAmounts,
	totalCopper: number,
	updatedAt: number,
}

local COIN_VALUE_TO_COPPER: { [CoinType]: number } = {
	copper = 1,
	silver = 100,
	gold = 10_000,
	platinum = 1_000_000,
}

local COIN_TYPE_ORDER_DESCENDING: { CoinType } = { "platinum", "gold", "silver", "copper" }

local function sanitizeWholeNumber(valueRaw: any, fallback: number): number
	if typeof(valueRaw) ~= "number" or valueRaw ~= valueRaw then
		return fallback
	end

	return math.max(0, math.floor(valueRaw))
end

local function createDefaultCoinAmounts(): CoinAmounts
	return {
		copper = 0,
		silver = 0,
		gold = 0,
		platinum = 0,
	}
end

local function resolveRawCoinAmounts(coinsDataRaw: any): (CoinAmounts, boolean)
	if typeof(coinsDataRaw) ~= "table" then
		return createDefaultCoinAmounts(), false
	end

	local source = coinsDataRaw :: { [string]: any }
	local amounts: CoinAmounts = {
		copper = sanitizeWholeNumber(source.copper, 0),
		silver = sanitizeWholeNumber(source.silver, 0),
		gold = sanitizeWholeNumber(source.gold, 0),
		platinum = sanitizeWholeNumber(source.platinum, 0),
	}
	local hasExplicitAmounts = amounts.copper > 0 or amounts.silver > 0 or amounts.gold > 0 or amounts.platinum > 0
	return amounts, hasExplicitAmounts
end

local function coinsToTotalCopper(amounts: CoinAmounts): number
	return amounts.copper * COIN_VALUE_TO_COPPER.copper
		+ amounts.silver * COIN_VALUE_TO_COPPER.silver
		+ amounts.gold * COIN_VALUE_TO_COPPER.gold
		+ amounts.platinum * COIN_VALUE_TO_COPPER.platinum
end

local function totalCopperToCoinAmounts(totalCopperRaw: any): CoinAmounts
	local remaining = sanitizeWholeNumber(totalCopperRaw, 0)
	local amounts = createDefaultCoinAmounts()
	local amountMap = amounts :: { [CoinType]: number }

	for _, coinType in COIN_TYPE_ORDER_DESCENDING do
		local coinValue = COIN_VALUE_TO_COPPER[coinType]
		local coinCount = math.floor(remaining / coinValue)
		remaining -= coinCount * coinValue
		amountMap[coinType] = coinCount
	end

	return amounts
end

local function resolveTotalCopperFromCoinsData(coinsDataRaw: any, fallbackTotalCopper: number): number
	if typeof(coinsDataRaw) ~= "table" then
		return fallbackTotalCopper
	end

	local source = coinsDataRaw :: { [string]: any }
	local rawAmounts, hasExplicitAmounts = resolveRawCoinAmounts(source)
	if hasExplicitAmounts then
		return coinsToTotalCopper(rawAmounts)
	end

	local explicitTotalCopperRaw = source.totalCopper
	if typeof(explicitTotalCopperRaw) == "number" and explicitTotalCopperRaw == explicitTotalCopperRaw then
		return sanitizeWholeNumber(explicitTotalCopperRaw, fallbackTotalCopper)
	end

	return coinsToTotalCopper(rawAmounts)
end

local function createDefaultState(loadStateRaw: any): CoinState
	local amounts = createDefaultCoinAmounts()
	return {
		loadState = PlayerDataServiceUtils.sanitizeLoadState(loadStateRaw, PlayerDataServiceUtils.LOAD_STATE_UNLOADED),
		amounts = amounts,
		totalCopper = 0,
		updatedAt = os.clock(),
	}
end

local function createStateFromData(coinsDataRaw: any, loadStateRaw: any, fallbackStateRaw: any): CoinState
	local fallbackState = if typeof(fallbackStateRaw) == "table"
		then (fallbackStateRaw :: CoinState)
		else createDefaultState(PlayerDataServiceUtils.LOAD_STATE_UNLOADED)
	local loadState = PlayerDataServiceUtils.sanitizeLoadState(loadStateRaw, fallbackState.loadState)
	local rawAmounts, hasExplicitAmounts = resolveRawCoinAmounts(coinsDataRaw)
	local totalCopper = resolveTotalCopperFromCoinsData(coinsDataRaw, fallbackState.totalCopper)
	local amounts = if hasExplicitAmounts then rawAmounts else totalCopperToCoinAmounts(totalCopper)

	return {
		loadState = loadState,
		amounts = amounts,
		totalCopper = totalCopper,
		updatedAt = os.clock(),
	}
end

local coinStateAtom: Charm.Atom<CoinState> =
	Charm.atom(createDefaultState(PlayerDataServiceUtils.LOAD_STATE_UNLOADED))

local totalCopperAtom: Charm.Selector<number> = Charm.computed(function(): number
	return coinStateAtom().totalCopper
end)

local loadStateAtom: Charm.Selector<PlayerDataServiceUtils.LoadState> = Charm.computed(function()
	return coinStateAtom().loadState
end)

local function getCoinState(): CoinState
	return coinStateAtom()
end

local function setCoinState(stateRaw: any): CoinState
	local source = if typeof(stateRaw) == "table" then stateRaw else {}
	local sourceTable = source :: { [string]: any }
	local coinsData = if sourceTable.amounts ~= nil then sourceTable.amounts else sourceTable
	local nextState = createStateFromData(coinsData, sourceTable.loadState, coinStateAtom())
	coinStateAtom(nextState)
	return nextState
end

local function setCoinsData(coinsDataRaw: any, loadStateRaw: any): CoinState
	local nextState = createStateFromData(coinsDataRaw, loadStateRaw, coinStateAtom())
	coinStateAtom(nextState)
	return nextState
end

local function resetCoinState(): CoinState
	local nextState = createDefaultState(PlayerDataServiceUtils.LOAD_STATE_UNLOADED)
	coinStateAtom(nextState)
	return nextState
end

return {
	coinStateAtom = coinStateAtom,
	totalCopperAtom = totalCopperAtom,
	loadStateAtom = loadStateAtom,
	COIN_VALUE_TO_COPPER = COIN_VALUE_TO_COPPER,
	COIN_TYPE_ORDER_DESCENDING = COIN_TYPE_ORDER_DESCENDING,
	createDefaultCoinAmounts = createDefaultCoinAmounts,
	createDefaultState = createDefaultState,
	createStateFromData = createStateFromData,
	getCoinState = getCoinState,
	setCoinState = setCoinState,
	setCoinsData = setCoinsData,
	resetCoinState = resetCoinState,
}
]]></string>
                    </Properties>
                  </Item>
                  <Item class="ModuleScript" referent="931">
                    <Properties>
                      <string name="Name">coinThunks</string>
                      <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ConnectionUtils = require(script:FindFirstAncestor("game").Client.UI.core.utils.ConnectionUtils)
local ServiceSync = require(script:FindFirstAncestor("game").Client.UI.core.utils.ServiceSync)
local coinSlice = require(script:FindFirstAncestor("game").Client.UI.features.inventory.state.coinSlice)
local PlayerDataServiceClient = require(script:FindFirstAncestor("game").Client.Services.PlayerDataServiceClient)
local PlayerDataServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.PlayerDataServiceUtils)

type CoinState = coinSlice.CoinState
type PlayerDataServiceState = PlayerDataServiceUtils.PlayerDataServiceState

local coinThunks = {}

local runtime = {
	started = false,
	stateChangedConnection = nil :: RBXScriptConnection?,
}

local COINS_DATA_PATH = PlayerDataServiceUtils.getDefaultCoinsDataPath()
local LOCAL_PLAYER = Players.LocalPlayer

local function stringifyLogValue(valueRaw: any): string
	if valueRaw == nil then
		return "nil"
	end
	local valueType = typeof(valueRaw)
	if valueType == "string" or valueType == "number" or valueType == "boolean" then
		return tostring(valueRaw)
	end
	return valueType
end

local function logCoinsApplied(nextPlayerDataState: PlayerDataServiceState, nextCoinState: CoinState)
	local fields = {
		'stage="Coins applied from player data state"',
		("player=%s"):format(LOCAL_PLAYER.Name),
		("userId=%d"):format(LOCAL_PLAYER.UserId),
		("loadToken=%s"):format(stringifyLogValue(nextPlayerDataState.loadToken)),
		("elapsed=%.3f"):format(if typeof(nextPlayerDataState.loadElapsedSeconds) == "number" then nextPlayerDataState.loadElapsedSeconds else 0),
		("loadState=%s"):format(stringifyLogValue(nextPlayerDataState.loadState)),
		("hasResolvedInitialLoad=%s"):format(tostring(nextPlayerDataState.hasResolvedInitialLoad == true)),
		("isLoading=%s"):format(tostring(nextPlayerDataState.isLoading == true)),
		("totalCopper=%s"):format(stringifyLogValue(nextCoinState.totalCopper)),
	}
	if nextPlayerDataState.lastFailureReason ~= nil then
		fields[#fields + 1] = ("lastFailureReason=%s"):format(stringifyLogValue(nextPlayerDataState.lastFailureReason))
	end
end

local function applyPlayerDataState(nextPlayerDataStateRaw: any): CoinState
	local fallbackState = coinSlice.getCoinState()
	local nextPlayerDataState = if typeof(nextPlayerDataStateRaw) == "table"
		then (nextPlayerDataStateRaw :: PlayerDataServiceState)
		else nil
	if nextPlayerDataState == nil then
		return fallbackState
	end

	local fallbackCoinsData = if PlayerDataServiceUtils.hasResolvedState(nextPlayerDataState)
		then coinSlice.createDefaultCoinAmounts()
		else fallbackState.amounts
	local coinsData = PlayerDataServiceUtils.getValueAtPath(nextPlayerDataState.data, COINS_DATA_PATH, fallbackCoinsData)
	local nextCoinState = coinSlice.setCoinsData(coinsData, nextPlayerDataState.loadState)
	logCoinsApplied(nextPlayerDataState, nextCoinState)
	return nextCoinState
end

local function syncFromService(): CoinState
	return ServiceSync.syncFromService(PlayerDataServiceClient, coinSlice.getCoinState, applyPlayerDataState)
end

function coinThunks.Start(): () -> ()
	if runtime.started then
		return coinThunks.Stop
	end

	runtime.started = true
	syncFromService()

	runtime.stateChangedConnection = ServiceSync.connectStateChanged(PlayerDataServiceClient, function(nextState: PlayerDataServiceState)
		applyPlayerDataState(nextState)
	end)
	ServiceSync.requestSync(PlayerDataServiceClient)

	return coinThunks.Stop
end

function coinThunks.Stop()
	ConnectionUtils.disconnect(runtime.stateChangedConnection)
	runtime.stateChangedConnection = nil
	runtime.started = false
end

function coinThunks.SyncFromService(): CoinState
	return syncFromService()
end

function coinThunks.ApplyPlayerDataState(nextPlayerDataStateRaw: any): CoinState
	return applyPlayerDataState(nextPlayerDataStateRaw)
end

coinThunks.start = coinThunks.Start
coinThunks.stop = coinThunks.Stop
coinThunks.syncFromService = coinThunks.SyncFromService
coinThunks.applyPlayerDataState = coinThunks.ApplyPlayerDataState

return coinThunks
]]></string>
                    </Properties>
                  </Item>
                  <Item class="ModuleScript" referent="932">
                    <Properties>
                      <string name="Name">trashSlice</string>
                      <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Charm = require(ReplicatedStorage.Packages.Charm)
local InventoryServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.InventoryServiceUtils)

type InventoryState = InventoryServiceUtils.InventoryState
type InventoryItemStack = InventoryServiceUtils.InventoryItemStack

export type TrashState = {
	isHovered: boolean,
	isOpen: boolean,
	canTrash: boolean,
	selectedSlot: number?,
	selectedStack: InventoryItemStack?,
	updatedAt: number,
}

local function cloneStack(stackRaw: any): InventoryItemStack?
	if typeof(stackRaw) ~= "table" then
		return nil
	end

	local stack = stackRaw :: { [string]: any }
	if typeof(stack.stackId) ~= "string" or typeof(stack.itemId) ~= "string" then
		return nil
	end

	local amount = if typeof(stack.amount) == "number" and stack.amount == stack.amount then math.max(0, stack.amount) else 0
	local maxStack = if typeof(stack.maxStack) == "number" and stack.maxStack == stack.maxStack
		then math.max(1, stack.maxStack)
		else 1

	return {
		stackId = stack.stackId,
		itemId = stack.itemId,
		amount = amount,
		maxStack = maxStack,
		metadata = InventoryServiceUtils.cloneDeep(stack.metadata),
	}
end

local function createDefaultState(): TrashState
	return {
		isHovered = false,
		isOpen = false,
		canTrash = false,
		selectedSlot = nil,
		selectedStack = nil,
		updatedAt = os.clock(),
	}
end

local function createStateFromInventory(inventoryStateRaw: any, fallbackStateRaw: any): TrashState
	local fallback = if typeof(fallbackStateRaw) == "table" then (fallbackStateRaw :: TrashState) else createDefaultState()
	local inventoryState = if typeof(inventoryStateRaw) == "table" then (inventoryStateRaw :: InventoryState) else nil
	if inventoryState == nil then
		return fallback
	end

	local selectedSlot = inventoryState.selectedSlot
	local selectedStack: InventoryItemStack? = nil
	if selectedSlot ~= nil then
		local slot = InventoryServiceUtils.getSlot(inventoryState, selectedSlot)
		if slot ~= nil then
			selectedStack = cloneStack(slot.stack)
		end
	end

	local canTrash = selectedStack ~= nil and selectedStack.amount > 0
	return {
		isHovered = fallback.isHovered,
		isOpen = fallback.isHovered,
		canTrash = canTrash,
		selectedSlot = selectedSlot,
		selectedStack = selectedStack,
		updatedAt = os.clock(),
	}
end

local trashStateAtom: Charm.Atom<TrashState> = Charm.atom(createDefaultState())

local function getTrashState(): TrashState
	return trashStateAtom()
end

local function setHovered(isHoveredRaw: any): TrashState
	local state = trashStateAtom()
	local isHovered = isHoveredRaw == true
	if state.isHovered == isHovered and state.isOpen == isHovered then
		return state
	end

	local nextState: TrashState = {
		isHovered = isHovered,
		isOpen = isHovered,
		canTrash = state.canTrash,
		selectedSlot = state.selectedSlot,
		selectedStack = state.selectedStack,
		updatedAt = os.clock(),
	}
	trashStateAtom(nextState)
	return nextState
end

local function setFromInventoryState(inventoryStateRaw: any): TrashState
	local nextState = createStateFromInventory(inventoryStateRaw, trashStateAtom())
	trashStateAtom(nextState)
	return nextState
end

local function resetTrashState(): TrashState
	local nextState = createDefaultState()
	trashStateAtom(nextState)
	return nextState
end

return {
	trashStateAtom = trashStateAtom,
	createDefaultState = createDefaultState,
	getTrashState = getTrashState,
	setHovered = setHovered,
	setFromInventoryState = setFromInventoryState,
	resetTrashState = resetTrashState,
}
]]></string>
                    </Properties>
                  </Item>
                  <Item class="ModuleScript" referent="933">
                    <Properties>
                      <string name="Name">trashThunks</string>
                      <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Charm = require(ReplicatedStorage.Packages.Charm)
local InventoryServiceClient = require(script:FindFirstAncestor("game").Client.Services.InventoryServiceClient)
local inventorySlice = require(script:FindFirstAncestor("game").Client.UI.hud.state.slice.inventorySlice)
local trashSlice = require(script:FindFirstAncestor("game").Client.UI.features.inventory.state.trashSlice)

local trashThunks = {}

local runtime = {
	started = false,
	unsubscribeInventoryState = nil :: (() -> ())?,
}

local function applyInventoryState(nextInventoryStateRaw: any)
	return trashSlice.setFromInventoryState(nextInventoryStateRaw)
end

local function syncFromInventory()
	return applyInventoryState(inventorySlice.getInventoryState())
end

function trashThunks.Start(): () -> ()
	if runtime.started then
		return trashThunks.Stop
	end

	runtime.started = true
	syncFromInventory()

	runtime.unsubscribeInventoryState = Charm.subscribe(inventorySlice.inventoryStateAtom, function(nextInventoryState)
		applyInventoryState(nextInventoryState)
	end, {
		inclusive = true,
	})

	return trashThunks.Stop
end

function trashThunks.Stop()
	if runtime.unsubscribeInventoryState ~= nil then
		runtime.unsubscribeInventoryState()
		runtime.unsubscribeInventoryState = nil
	end
	runtime.started = false
end

function trashThunks.SetHovered(isHoveredRaw: any)
	return trashSlice.setHovered(isHoveredRaw)
end

function trashThunks.Open()
	return trashSlice.setHovered(true)
end

function trashThunks.Close()
	return trashSlice.setHovered(false)
end

function trashThunks.TrashSelected(amountRaw: any): boolean
	local state = trashSlice.getTrashState()
	if not state.canTrash then
		return false
	end

	local success = pcall(function()
		InventoryServiceClient:trashSelectedSlot(amountRaw)
	end)
	return success
end

function trashThunks.TrashSlot(slotIndexRaw: any, amountRaw: any): boolean
	local success = pcall(function()
		InventoryServiceClient:trashSlot(slotIndexRaw, amountRaw)
	end)
	return success
end

trashThunks.start = trashThunks.Start
trashThunks.stop = trashThunks.Stop
trashThunks.setHovered = trashThunks.SetHovered
trashThunks.open = trashThunks.Open
trashThunks.close = trashThunks.Close
trashThunks.trashSelected = trashThunks.TrashSelected
trashThunks.trashSlot = trashThunks.TrashSlot

return trashThunks
]]></string>
                    </Properties>
                  </Item>
                </Item>
              </Item>
              <Item class="Folder" referent="934">
                <Properties>
                  <string name="Name">item</string>
                </Properties>
                <Item class="Folder" referent="935">
                  <Properties>
                    <string name="Name">hooks</string>
                  </Properties>
                  <Item class="ModuleScript" referent="936">
                    <Properties>
                      <string name="Name">useDrag</string>
                      <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local React = require(ReplicatedStorage.Packages.React)
local Charm = require(ReplicatedStorage.Packages.Charm)
local Configs = require(script:FindFirstAncestor("game").Shared.Modules.Core.Configs)
local Damp = require(script:FindFirstAncestor("game").Shared.Modules.Math.Damp)
local AudioRegistry = require(script:FindFirstAncestor("game").Shared.Modules.Items.Audio)
local BuildServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.BuildServiceUtils)
local itemSlice = require(script:FindFirstAncestor("game").Client.UI.features.item.state.itemSlice)
local itemThunks = require(script:FindFirstAncestor("game").Client.UI.features.item.state.itemThunks)
local AudioServiceClient = require(script:FindFirstAncestor("game").Client.Services.AudioServiceClient)
local AudioServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.AudioServiceUtils)
local InventoryServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.InventoryServiceUtils)

type ItemDragState = itemSlice.ItemDragState
type InventoryItemStack = InventoryServiceUtils.InventoryItemStack

export type UseDragOptions = {
	hoveredSlotIndex: number?,
}

export type UseDragResult = {
	handleSlotInput: (slotIndexRaw: any, stackRaw: any, inputObjectRaw: any?) -> (),
	handleSlotSecondaryInput: (slotIndexRaw: any, stackRaw: any, pointerPositionRaw: any?) -> (),
	cancelDrag: () -> (),
	shouldSuppressActivation: (slotIndexRaw: any) -> boolean,
	isDragging: boolean,
	dragSourceSlot: number?,
	dragState: ItemDragState,
}

type ActivationSuppression = {
	sourceSlot: number?,
	targetSlot: number?,
	untilTime: number,
}

type PendingSplitHold = {
	slotIndex: number,
	stack: InventoryItemStack,
	startedAt: number,
	nextIncrementAt: number,
	canSplit: boolean,
}

type SplitHoldConfig = {
	enabled: boolean,
	holdDelaySeconds: number,
	initialIntervalSeconds: number,
	minimumIntervalSeconds: number,
	accelerationRampSeconds: number,
}

local ACTIVATION_SUPPRESSION_SECONDS = 0.2
local SLOT_CLICK_GRACE_SECONDS = 0.1
local POINTER_SMOOTHING_SPEED = 10
local MOUSE_CURSOR_CENTER_OFFSET = Vector2.zero
local DEFAULT_SPLIT_HOLD_CONFIG: SplitHoldConfig = {
	enabled = true,
	holdDelaySeconds = 0.18,
	initialIntervalSeconds = 0.18,
	minimumIntervalSeconds = 0.035,
	accelerationRampSeconds = 1.1,
}
local UI_AUDIO = (AudioRegistry :: any).UI or {}
local UI_ITEM_PICKUP_SOUND = AudioServiceUtils.normalizeSoundAssetId(UI_AUDIO.ItemPickup)
local UI_ITEM_PUT_DOWN_SOUND = AudioServiceUtils.normalizeSoundAssetId(UI_AUDIO.ItemPutDown)

local function sanitizeNumber(valueRaw: any, fallback: number, minimum: number, maximum: number?): number
	if typeof(valueRaw) ~= "number" or valueRaw ~= valueRaw then
		return fallback
	end

	local value = valueRaw
	if value < minimum then
		value = minimum
	end
	if maximum ~= nil and value > maximum then
		value = maximum
	end
	return value
end

local function resolveSplitHoldConfig(configRaw: any): SplitHoldConfig
	local inventoryConfig = if typeof(configRaw) == "table" then (configRaw :: any).inventory else nil
	local splitConfig = if typeof(inventoryConfig) == "table" then (inventoryConfig :: any).rightHoldSplit else nil
	if typeof(splitConfig) ~= "table" then
		return DEFAULT_SPLIT_HOLD_CONFIG
	end

	return {
		enabled = (splitConfig :: any).enabled ~= false,
		holdDelaySeconds = sanitizeNumber(
			(splitConfig :: any).holdDelaySeconds,
			DEFAULT_SPLIT_HOLD_CONFIG.holdDelaySeconds,
			0.05,
			1
		),
		initialIntervalSeconds = sanitizeNumber(
			(splitConfig :: any).initialIntervalSeconds,
			DEFAULT_SPLIT_HOLD_CONFIG.initialIntervalSeconds,
			0.02,
			0.5
		),
		minimumIntervalSeconds = sanitizeNumber(
			(splitConfig :: any).minimumIntervalSeconds,
			DEFAULT_SPLIT_HOLD_CONFIG.minimumIntervalSeconds,
			0.01,
			0.2
		),
		accelerationRampSeconds = sanitizeNumber(
			(splitConfig :: any).accelerationRampSeconds,
			DEFAULT_SPLIT_HOLD_CONFIG.accelerationRampSeconds,
			0.1,
			4
		),
	}
end

local SPLIT_HOLD_CONFIG = resolveSplitHoldConfig(Configs)

local function playUiItemPickupSound()
	if AudioServiceClient.categoryGroups == nil then
		return
	end
	if UI_ITEM_PICKUP_SOUND == nil then
		return
	end
	AudioServiceClient:playUi(UI_ITEM_PICKUP_SOUND, {
		replaceChannel = false,
	})
end

local function playUiItemReleaseSound()
	if AudioServiceClient.categoryGroups == nil then
		return
	end
	if UI_ITEM_PUT_DOWN_SOUND == nil then
		return
	end
	AudioServiceClient:playUi(UI_ITEM_PUT_DOWN_SOUND, {
		replaceChannel = false,
	})
end

local function toGuiPosition(screenPosition: Vector2): Vector2
	return screenPosition
end

local function applyMouseCenterOffset(guiPosition: Vector2, inputType: Enum.UserInputType?): Vector2
	if inputType == Enum.UserInputType.MouseButton1 or inputType == Enum.UserInputType.MouseMovement then
		return guiPosition + MOUSE_CURSOR_CENTER_OFFSET
	end
	return guiPosition
end

local function isDragInput(inputObject: InputObject): boolean
	return inputObject.UserInputType == Enum.UserInputType.MouseButton1
		or inputObject.UserInputType == Enum.UserInputType.Touch
end

local function resolvePointerPosition(inputObject: InputObject): Vector2
	local position = inputObject.Position
	local screenPosition = Vector2.new(position.X, position.Y)
	local guiPosition = toGuiPosition(screenPosition)
	return applyMouseCenterOffset(guiPosition, inputObject.UserInputType)
end

local function resolveCurrentMousePosition(): Vector2
	local mousePosition = UserInputService:GetMouseLocation()
	local guiPosition = toGuiPosition(Vector2.new(mousePosition.X, mousePosition.Y))
	return guiPosition + MOUSE_CURSOR_CENTER_OFFSET
end

local function sanitizeSlot(slotRaw: any): number?
	if typeof(slotRaw) ~= "number" or slotRaw ~= slotRaw then
		return nil
	end

	local slot = math.floor(slotRaw)
	if slot <= 0 then
		return nil
	end
	return slot
end

local function shouldSuppressActivationNow(suppression: ActivationSuppression, slotRaw: any): boolean
	local slot = sanitizeSlot(slotRaw)
	if slot == nil then
		return false
	end
	if os.clock() > suppression.untilTime then
		return false
	end
	return slot == suppression.sourceSlot or slot == suppression.targetSlot
end

local function setActivationSuppression(suppressionRef: any, sourceSlot: number?, targetSlot: number?)
	suppressionRef.current = {
		sourceSlot = sourceSlot,
		targetSlot = targetSlot,
		untilTime = os.clock() + ACTIVATION_SUPPRESSION_SECONDS,
	}
end

local function finalizeDragWithSuppression(suppressionRef: any, targetSlotRaw: any): boolean
	local state = itemSlice.getDragState()
	if not state.active then
		return false
	end

	local sourceSlot = state.sourceSlot
	local targetSlot = sanitizeSlot(targetSlotRaw)
	local didMove = itemThunks.endDrag(targetSlot)
	playUiItemReleaseSound()
	setActivationSuppression(suppressionRef, sourceSlot, targetSlot)
	return didMove
end

local function syncPointerRefs(
	targetPointerRef: any,
	smoothedPointerRef: any,
	hasSmoothedPointerRef: any,
	pointerPosition: Vector2
)
	targetPointerRef.current = pointerPosition
	smoothedPointerRef.current = pointerPosition
	hasSmoothedPointerRef.current = true
end

local function resolvePointerFromInput(inputObjectRaw: any): Vector2
	if typeof(inputObjectRaw) == "InputObject" then
		return resolvePointerPosition(inputObjectRaw :: InputObject)
	end
	if typeof(inputObjectRaw) == "Vector2" then
		return inputObjectRaw
	end
	return resolveCurrentMousePosition()
end

local function cloneStack(stackRaw: any): InventoryItemStack?
	if typeof(stackRaw) ~= "table" then
		return nil
	end

	local stack = stackRaw :: { [string]: any }
	if typeof(stack.stackId) ~= "string" or typeof(stack.itemId) ~= "string" then
		return nil
	end

	local amountRaw = stack.amount
	local amount = if typeof(amountRaw) == "number" and amountRaw == amountRaw then math.max(0, math.floor(amountRaw)) else 0
	local maxStackRaw = stack.maxStack
	local maxStack = if typeof(maxStackRaw) == "number" and maxStackRaw == maxStackRaw
		then math.max(1, math.floor(maxStackRaw))
		else 1
	if amount <= 0 then
		return nil
	end

	return {
		stackId = stack.stackId,
		itemId = stack.itemId,
		amount = amount,
		maxStack = maxStack,
		metadata = InventoryServiceUtils.cloneDeep(stack.metadata),
	}
end

local function isSplitHoldDrag(state: ItemDragState): boolean
	return state.active and state.mode == "SplitHold" and state.stack ~= nil and state.sourceSlot ~= nil
end

local function isPlaceableDragOutsideInventory(state: ItemDragState): boolean
	if not state.active or state.hoveredSlot ~= nil or state.stack == nil then
		return false
	end

	return BuildServiceUtils.resolvePlaceableItemConfig(state.stack.itemId) ~= nil
end

local function resolveSplitIncrementInterval(elapsedSeconds: number): number
	local rampSeconds = math.max(SPLIT_HOLD_CONFIG.accelerationRampSeconds, 1e-4)
	local alpha = math.clamp(elapsedSeconds / rampSeconds, 0, 1)
	local easedAlpha = alpha * alpha
	return SPLIT_HOLD_CONFIG.initialIntervalSeconds
		+ (SPLIT_HOLD_CONFIG.minimumIntervalSeconds - SPLIT_HOLD_CONFIG.initialIntervalSeconds) * easedAlpha
end

local function useDrag(options: UseDragOptions?): UseDragResult
	local hoveredSlotIndex = if options ~= nil then options.hoveredSlotIndex else nil
	local dragState, setDragState = React.useState(function(): ItemDragState
		return itemSlice.getDragState()
	end)
	local lastSlotInputTimeRef = React.useRef(0)
	local targetPointerRef = React.useRef(Vector2.zero)
	local smoothedPointerRef = React.useRef(Vector2.zero)
	local hasSmoothedPointerRef = React.useRef(false)
	local hoveredSlotIndexRef = React.useRef(hoveredSlotIndex)
	local pendingSplitHoldRef = React.useRef(nil :: PendingSplitHold?)
	local suppressionRef = React.useRef({
		sourceSlot = nil,
		targetSlot = nil,
		untilTime = 0,
	} :: ActivationSuppression)

	local function clearPendingSplitHold()
		pendingSplitHoldRef.current = nil
	end

	local function beginPendingSplitHold(slotIndex: number, stackRaw: any, pointerPosition: Vector2)
		local stack = cloneStack(stackRaw)
		if stack == nil then
			return false
		end

		local nextDragState = itemThunks.beginSplitDrag(slotIndex, stack, pointerPosition, 1)
		if not nextDragState.active then
			return false
		end

		itemThunks.setHoveredSlot(slotIndex)
		setActivationSuppression(suppressionRef, slotIndex, slotIndex)
		playUiItemPickupSound()

		pendingSplitHoldRef.current = {
			slotIndex = slotIndex,
			stack = stack,
			startedAt = os.clock(),
			nextIncrementAt = os.clock() + SPLIT_HOLD_CONFIG.holdDelaySeconds,
			canSplit = SPLIT_HOLD_CONFIG.enabled and stack.amount > 1,
		}
		return true
	end

	React.useEffect(function()
		local unsubscribe = Charm.subscribe(itemSlice.dragStateAtom, function(nextState: ItemDragState)
			setDragState(nextState)
		end, {
			inclusive = true,
		})

		return function()
			unsubscribe()
		end
	end, {})

	React.useEffect(function()
		hoveredSlotIndexRef.current = hoveredSlotIndex
	end, { hoveredSlotIndex })

	React.useEffect(function()
		if dragState.active then
			itemThunks.setHoveredSlot(hoveredSlotIndex)
		end
	end, { hoveredSlotIndex, dragState.active })

	React.useEffect(function()
		local changedConnection = UserInputService.InputChanged:Connect(function(inputObject: InputObject)
			local pendingSplitHold = pendingSplitHoldRef.current
			if inputObject.UserInputType == Enum.UserInputType.Touch then
				if itemSlice.getDragState().active or pendingSplitHold ~= nil then
					local pointerPosition = resolvePointerPosition(inputObject)
					targetPointerRef.current = pointerPosition
				end
			end
		end)

		local renderConnection = RunService.RenderStepped:Connect(function(deltaTime: number)
			local currentDragState = itemSlice.getDragState()
			local pendingSplitHold = pendingSplitHoldRef.current
			if not currentDragState.active and pendingSplitHold == nil then
				hasSmoothedPointerRef.current = false
				return
			end

			local targetPointer = targetPointerRef.current
			if UserInputService.MouseEnabled then
				targetPointer = resolveCurrentMousePosition()
				targetPointerRef.current = targetPointer
			end

			if not hasSmoothedPointerRef.current then
				smoothedPointerRef.current = targetPointer
				hasSmoothedPointerRef.current = true
			else
				local alpha = Damp.factor(POINTER_SMOOTHING_SPEED, deltaTime)
				smoothedPointerRef.current = smoothedPointerRef.current:Lerp(targetPointer, alpha)
			end

			local now = os.clock()
			currentDragState = itemSlice.getDragState()
			if currentDragState.active then
				itemThunks.updatePointer(smoothedPointerRef.current)
			end

			pendingSplitHold = pendingSplitHoldRef.current
			if pendingSplitHold ~= nil then
				local activeSplitDrag = itemSlice.getDragState()
				if not isSplitHoldDrag(activeSplitDrag) or activeSplitDrag.sourceSlot ~= pendingSplitHold.slotIndex then
					clearPendingSplitHold()
					return
				end

				local stack = activeSplitDrag.stack
				if stack == nil then
					clearPendingSplitHold()
					return
				end

				local nextAmount = stack.amount
				local nextIncrementAt = pendingSplitHold.nextIncrementAt
				while nextAmount < pendingSplitHold.stack.amount and now >= nextIncrementAt do
					nextAmount += 1
					nextIncrementAt += resolveSplitIncrementInterval(nextIncrementAt - pendingSplitHold.startedAt)
				end

				pendingSplitHold.nextIncrementAt = nextIncrementAt
				pendingSplitHoldRef.current = pendingSplitHold

				if nextAmount ~= stack.amount then
					itemThunks.setDragStackAmount(nextAmount)
				end
			end
		end)

		local beganConnection = UserInputService.InputBegan:Connect(function(inputObject: InputObject, _: boolean)
			local currentDragState = itemSlice.getDragState()
			if not currentDragState.active then
				return
			end
			local inputType = inputObject.UserInputType

			if inputType == Enum.UserInputType.MouseButton2 then
				if pendingSplitHoldRef.current ~= nil then
					return
				end
				if currentDragState.hoveredSlot == nil then
					local sourceSlot = currentDragState.sourceSlot
					local didDrop = itemThunks.dropDrag(nil)
					if didDrop then
						playUiItemReleaseSound()
						setActivationSuppression(suppressionRef, sourceSlot, nil)
					end
				end
				return
			end

			if pendingSplitHoldRef.current ~= nil then
				return
			end

			if not isDragInput(inputObject) then
				return
			end

			task.defer(function()
				local nextState = itemSlice.getDragState()
				if not nextState.active then
					return
				end
				if os.clock() - lastSlotInputTimeRef.current <= SLOT_CLICK_GRACE_SECONDS then
					return
				end
				if isPlaceableDragOutsideInventory(nextState) then
					return
				end
				finalizeDragWithSuppression(suppressionRef, nil)
			end)
		end)

		local endedConnection = UserInputService.InputEnded:Connect(function(inputObject: InputObject, _: boolean)
			if inputObject.UserInputType ~= Enum.UserInputType.MouseButton2 then
				return
			end
			if pendingSplitHoldRef.current == nil then
				return
			end
			clearPendingSplitHold()
		end)

		return function()
			changedConnection:Disconnect()
			renderConnection:Disconnect()
			beganConnection:Disconnect()
			endedConnection:Disconnect()
			clearPendingSplitHold()
			itemThunks.cancelDrag()
		end
	end, {})

	local handleSlotInput = React.useCallback(function(
		slotIndexRaw: any,
		stackRaw: any,
		inputObjectRaw: any?
	)
		local slotIndex = sanitizeSlot(slotIndexRaw)
		if slotIndex == nil then
			return
		end

		lastSlotInputTimeRef.current = os.clock()
		local pointerPosition = resolvePointerFromInput(inputObjectRaw)
		local state = itemSlice.getDragState()
		local inputType = if typeof(inputObjectRaw) == "InputObject"
			then (inputObjectRaw :: InputObject).UserInputType
			else nil

		if inputType == Enum.UserInputType.MouseButton2 then
			if state.active then
				return
			end
			syncPointerRefs(targetPointerRef, smoothedPointerRef, hasSmoothedPointerRef, pointerPosition)
			if typeof(stackRaw) ~= "table" then
				return
			end
			beginPendingSplitHold(slotIndex, stackRaw, pointerPosition)
			return
		end

		if state.active then
			if pendingSplitHoldRef.current ~= nil then
				return
			end
			syncPointerRefs(targetPointerRef, smoothedPointerRef, hasSmoothedPointerRef, pointerPosition)
			itemThunks.updatePointer(pointerPosition)
			finalizeDragWithSuppression(suppressionRef, slotIndex)
			return
		end

		if typeof(stackRaw) ~= "table" then
			return
		end
		if inputType ~= nil and inputType ~= Enum.UserInputType.MouseButton1 and inputType ~= Enum.UserInputType.Touch then
			return
		end

		syncPointerRefs(targetPointerRef, smoothedPointerRef, hasSmoothedPointerRef, pointerPosition)
		clearPendingSplitHold()
		local nextDragState = itemThunks.beginDrag(slotIndex, stackRaw, pointerPosition)
		if nextDragState.active then
			playUiItemPickupSound()
		end
		itemThunks.setHoveredSlot(slotIndex)
		setActivationSuppression(suppressionRef, slotIndex, slotIndex)
	end, {})

	local handleSlotSecondaryInput = React.useCallback(function(
		slotIndexRaw: any,
		stackRaw: any,
		pointerPositionRaw: any?
	)
		local slotIndex = sanitizeSlot(slotIndexRaw)
		if slotIndex == nil then
			return
		end
		if itemSlice.getDragState().active then
			return
		end
		if typeof(stackRaw) ~= "table" then
			return
		end

		lastSlotInputTimeRef.current = os.clock()
		local pointerPosition = resolvePointerFromInput(pointerPositionRaw)
		syncPointerRefs(targetPointerRef, smoothedPointerRef, hasSmoothedPointerRef, pointerPosition)
		beginPendingSplitHold(slotIndex, stackRaw, pointerPosition)
	end, {})

	local cancelDrag = React.useCallback(function()
		clearPendingSplitHold()
		itemThunks.cancelDrag()
	end, {})

	local shouldSuppressActivation = React.useCallback(function(slotIndexRaw: any): boolean
		return shouldSuppressActivationNow(suppressionRef.current, slotIndexRaw)
	end, {})

	return {
		handleSlotInput = handleSlotInput,
		handleSlotSecondaryInput = handleSlotSecondaryInput,
		cancelDrag = cancelDrag,
		shouldSuppressActivation = shouldSuppressActivation,
		isDragging = dragState.active,
		dragSourceSlot = dragState.sourceSlot,
		dragState = dragState,
	}
end

return useDrag
]]></string>
                    </Properties>
                  </Item>
                </Item>
                <Item class="Folder" referent="937">
                  <Properties>
                    <string name="Name">screen</string>
