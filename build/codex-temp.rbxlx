                      <string name="Name">bubble</string>
                      <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ImageIds = require(script:FindFirstAncestor("game").Client.UI.core.ImageIds)
local React = require(ReplicatedStorage.Packages.React)
local SegmentIcon = require(script:FindFirstAncestor("game").Client.UI.core.components.SegmentIcon)

export type BubbleProps = {
	index: number,
	fillAlpha: number,
	size: UDim2,
	zIndex: number,
}

local e: typeof(React.createElement) = React.createElement

local EMPTY_BUBBLE_COLOR = Color3.fromRGB(31, 60, 83)
local FILLED_BUBBLE_COLOR = Color3.fromRGB(189, 234, 255)

return function(props: BubbleProps)
	return e(SegmentIcon, {
		icon = ImageIds.bubble,
		size = props.size,
		layoutOrder = props.index,
		zIndex = props.zIndex,
		fillAlpha = math.clamp(props.fillAlpha, 0, 1),
		emptyColor = EMPTY_BUBBLE_COLOR,
		fullColor = FILLED_BUBBLE_COLOR,
	})
end
]]></string>
                    </Properties>
                  </Item>
                </Item>
                <Item class="Folder" referent="862">
                  <Properties>
                    <string name="Name">hooks</string>
                  </Properties>
                  <Item class="ModuleScript" referent="863">
                    <Properties>
                      <string name="Name">useBubbleDeplete</string>
                      <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Sift = require(ReplicatedStorage.Packages.Sift)
local RunService = game:GetService("RunService")

local React = require(ReplicatedStorage.Packages.React)

export type BubbleDepleteOptions = {
	fillAlphas: { number }?,
	speed: number?,
	epsilon: number?,
}

local DEFAULT_SPEED = 4
local DEFAULT_EPSILON = 0.001

local function sanitizeNumber(valueRaw: any, fallback: number, minimum: number, maximum: number): number
	if typeof(valueRaw) ~= "number" or valueRaw ~= valueRaw then
		return fallback
	end
	return math.clamp(valueRaw, minimum, maximum)
end

local function cloneFillAlphas(fillAlphasRaw: any): { number }
	if typeof(fillAlphasRaw) ~= "table" then
		return { 1 }
	end

	local fillAlphas = Sift.Array.create(#fillAlphasRaw)
	for index, fillAlphaRaw in ipairs(fillAlphasRaw) do
		fillAlphas[index] = sanitizeNumber(fillAlphaRaw, 1, 0, 1)
	end

	if #fillAlphas == 0 then
		fillAlphas[1] = 1
	end

	return fillAlphas
end

local function joinStrings(values: { string }, delimiter: string): string
	local output = ""
	for index, value in values do
		if index > 1 then
			output ..= delimiter
		end
		output ..= value
	end
	return output
end

local function getFillAlphaKey(fillAlphas: { number }): string
	local keyParts = Sift.Array.create(#fillAlphas)
	for index, fillAlpha in ipairs(fillAlphas) do
		keyParts[index] = string.format("%.4f", fillAlpha)
	end
	return joinStrings(keyParts, "|")
end

local function synchronizeFillAlphas(currentFillAlphas: { number }, targetFillAlphas: { number }): ({ number }, boolean)
	local hasChanges = #currentFillAlphas ~= #targetFillAlphas
	local synchronizedFillAlphas = Sift.Array.create(#targetFillAlphas)

	for index, targetFillAlpha in ipairs(targetFillAlphas) do
		local synchronizedFillAlpha = sanitizeNumber(currentFillAlphas[index], targetFillAlpha, 0, 1)
		synchronizedFillAlphas[index] = synchronizedFillAlpha

		if synchronizedFillAlpha ~= currentFillAlphas[index] then
			hasChanges = true
		end
	end

	if not hasChanges then
		return currentFillAlphas, false
	end

	return synchronizedFillAlphas, true
end

local function findActiveBubbleIndex(
	currentFillAlphas: { number },
	targetFillAlphas: { number },
	epsilon: number
): number?
	for index, targetFillAlpha in ipairs(targetFillAlphas) do
		if math.abs(currentFillAlphas[index] - targetFillAlpha) > epsilon then
			return index
		end
	end

	return nil
end

local function stepFillAlpha(currentFillAlpha: number, targetFillAlpha: number, maxDelta: number): number
	if maxDelta <= 0 then
		return currentFillAlpha
	end

	local delta = targetFillAlpha - currentFillAlpha
	if math.abs(delta) <= maxDelta then
		return targetFillAlpha
	end

	if delta > 0 then
		return currentFillAlpha + maxDelta
	end

	return currentFillAlpha - maxDelta
end

local function useBubbleDeplete(options: BubbleDepleteOptions?): { number }
	local targetFillAlphas = cloneFillAlphas(if options then options.fillAlphas else nil)
	local targetKey = getFillAlphaKey(targetFillAlphas)
	local speed = sanitizeNumber(if options then options.speed else nil, DEFAULT_SPEED, 0.05, 60)
	local epsilon = sanitizeNumber(if options then options.epsilon else nil, DEFAULT_EPSILON, 0.0001, 0.1)
	local animatedFillAlphas, setAnimatedFillAlphas = React.useState(function(): { number }
		return Sift.Array.copy(targetFillAlphas)
	end)
	local targetFillAlphasRef = React.useRef(targetFillAlphas)

	targetFillAlphasRef.current = targetFillAlphas

	React.useEffect(function()
		setAnimatedFillAlphas(function(currentFillAlphas: { number }): { number }
			local synchronizedFillAlphas = synchronizeFillAlphas(currentFillAlphas, targetFillAlphas)
			return synchronizedFillAlphas
		end)
	end, { targetKey })

	React.useEffect(function()
		local connection = RunService.RenderStepped:Connect(function(deltaTime: number)
			setAnimatedFillAlphas(function(currentFillAlphas: { number }): { number }
				local currentTargetFillAlphas = targetFillAlphasRef.current
				local synchronizedFillAlphas = synchronizeFillAlphas(currentFillAlphas, currentTargetFillAlphas)
				local activeBubbleIndex =
					findActiveBubbleIndex(synchronizedFillAlphas, currentTargetFillAlphas, epsilon)

				if activeBubbleIndex == nil then
					return synchronizedFillAlphas
				end

				local nextFillAlpha = stepFillAlpha(
					synchronizedFillAlphas[activeBubbleIndex],
					currentTargetFillAlphas[activeBubbleIndex],
					math.max(deltaTime, 0) * speed
				)
				if math.abs(nextFillAlpha - currentTargetFillAlphas[activeBubbleIndex]) <= epsilon then
					nextFillAlpha = currentTargetFillAlphas[activeBubbleIndex]
				end

				if nextFillAlpha == synchronizedFillAlphas[activeBubbleIndex] then
					return synchronizedFillAlphas
				end

				return Sift.Array.set(synchronizedFillAlphas, activeBubbleIndex, nextFillAlpha)
			end)
		end)

		return function()
			connection:Disconnect()
		end
	end, { speed, epsilon })

	return animatedFillAlphas
end

return useBubbleDeplete
]]></string>
                    </Properties>
                  </Item>
                </Item>
                <Item class="Folder" referent="864">
                  <Properties>
                    <string name="Name">screens</string>
                  </Properties>
                  <Item class="ModuleScript" referent="865">
                    <Properties>
                      <string name="Name">bubblesScreen</string>
                      <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Sift = require(ReplicatedStorage.Packages.Sift)

local BreathMeter = require(script:FindFirstAncestor("game").Client.UI.features.breath.components.BreathMeter)
local BreathServiceUtils = require(script:FindFirstAncestor("game").Shared.Services.BreathServiceUtils)
local React = require(ReplicatedStorage.Packages.React)
local Responsive = require(script:FindFirstAncestor("game").Client.UI.core.hooks.useViewportScale)
local UiSound = require(script:FindFirstAncestor("game").Client.UI.core.utils.UiSound)
local breathSlice = require(script:FindFirstAncestor("game").Client.UI.features.breath.state.breathSlice)
local breathThunks = require(script:FindFirstAncestor("game").Client.UI.features.breath.state.breathThunks)
local infoThunks = require(script:FindFirstAncestor("game").Client.UI.features.info.state.infoThunks)
local useBubbleDeplete = require(script:FindFirstAncestor("game").Client.UI.features.breath.hooks.useBubbleDeplete)
local useHover = require(script:FindFirstAncestor("game").Client.UI.core.hooks.useHover)
local useStore = require(script:FindFirstAncestor("game").Client.UI.core.hooks.useStore)

type BreathServiceState = BreathServiceUtils.BreathServiceState

type BubbleState = {
	index: number,
	breath: number,
	maxBreath: number,
	fillAlpha: number,
	isFull: boolean,
	isEmpty: boolean,
}

type BubblesScreenProps = {
	layoutOrder: number?,
	visible: boolean?,
	zIndex: number?,
	size: UDim2?,
	position: UDim2?,
	anchorPoint: Vector2?,
	bubbleSize: UDim2?,
	padding: UDim?,
	showValueLabel: boolean?,
	bubbleValue: number?,
	useServiceState: boolean?,
	mockState: BreathServiceState?,
	mockReady: boolean?,
}

local e: typeof(React.createElement) = React.createElement

local DEFAULT_BUBBLE_VALUE = 1
local function sanitizeNumber(valueRaw: any, fallback: number, minimum: number, maximum: number?): number
	if typeof(valueRaw) ~= "number" or valueRaw ~= valueRaw then
		return fallback
	end
	local value = valueRaw
	if value < minimum then
		value = minimum
	end
	if maximum ~= nil and value > maximum then
		value = maximum
	end
	return value
end

local function buildBubbles(breathRaw: any, maxBreathRaw: any, bubbleValueRaw: any): { BubbleState }
	local bubbleValue = sanitizeNumber(bubbleValueRaw, DEFAULT_BUBBLE_VALUE, 0.1, nil)
	local maxBreath = sanitizeNumber(maxBreathRaw, bubbleValue, bubbleValue, nil)
	local breath = sanitizeNumber(breathRaw, maxBreath, 0, maxBreath)

	local bubbleCount = math.max(1, math.ceil(maxBreath / bubbleValue))
	local bubbles: { BubbleState } = Sift.Array.create(bubbleCount)
	for bubbleIndex = 1, bubbleCount do
		local bubbleStart = (bubbleIndex - 1) * bubbleValue
		local maxBreathInBubble = math.clamp(maxBreath - bubbleStart, 0, bubbleValue)
		local breathInBubble = math.clamp(breath - bubbleStart, 0, maxBreathInBubble)
		local fillAlpha = if maxBreathInBubble > 0 then breathInBubble / maxBreathInBubble else 0
		bubbles[bubbleIndex] = {
			index = bubbleIndex,
			breath = breathInBubble,
			maxBreath = maxBreathInBubble,
			fillAlpha = fillAlpha,
			isFull = breathInBubble >= maxBreathInBubble,
			isEmpty = breathInBubble <= 0,
		}
	end
	return bubbles
end

return function(props: BubblesScreenProps)
	local responsive = Responsive.useResponsiveMetrics()
	local meterTokens = responsive.tokens.meter
	local useServiceState = props.useServiceState ~= false
	local serviceBreathState =
		useStore(if useServiceState then breathSlice.breathStateAtom else nil) :: BreathServiceState?
	local serviceBreathReady = useStore(if useServiceState then breathSlice.breathReadyAtom else nil) :: boolean?
	local breathState = if useServiceState
		then (serviceBreathState or breathSlice.breathStateAtom())
		else if props.mockState ~= nil then props.mockState else breathSlice.breathStateAtom()
	local isBreathReady = if useServiceState
		then (serviceBreathReady or breathSlice.isBreathReady())
		else if props.mockReady ~= nil then props.mockReady else true

	local hoverId = "breath_bubbles_row"
	local hoverText = string.format("Breath: %.1f/%.1f", breathState.breath, breathState.maxBreath)
	local bubblesHover = useHover({
		onHoverStart = function()
			infoThunks.showHover({
				id = hoverId,
				text = hoverText,
			})

			UiSound.playHover()
		end,
		onHoverEnd = function()
			infoThunks.hideHover(hoverId)
		end,
	})

	React.useEffect(function()
		if not useServiceState then
			return
		end

		local stop = breathThunks.start()

		return function()
			stop()
		end
	end, { useServiceState })

	React.useEffect(function()
		if not bubblesHover.hovered then
			return
		end

		infoThunks.showHover({
			id = hoverId,
			text = hoverText,
		})
	end, { bubblesHover.hovered, hoverText })

	React.useEffect(function()
		return function()
			infoThunks.hideHover(hoverId)
		end
	end, {})

	local zIndex = props.zIndex or 12
	local bubbleSize = props.bubbleSize or UDim2.fromOffset(meterTokens.segmentSize, meterTokens.segmentSize)
	local bubbles = buildBubbles(breathState.breath, breathState.maxBreath, props.bubbleValue)
	local bubbleFillAlphas = Sift.Array.create(#bubbles)
	for bubbleIndex, bubbleState in ipairs(bubbles) do
		bubbleFillAlphas[bubbleIndex] = bubbleState.fillAlpha
	end
	local animatedBubbleFillAlphas = useBubbleDeplete({
		fillAlphas = bubbleFillAlphas,
	})
	local shouldShow = breathState.isUnderwater or breathState.isBreathingBlocked or breathState.isDrowning

	local children: { React.ReactNode } = {
		e(BreathMeter, {
			bubbles = bubbles,
			fillAlphas = animatedBubbleFillAlphas,
			bubbleSize = bubbleSize,
			padding = props.padding or UDim.new(0, meterTokens.segmentGap),
			zIndex = zIndex + 1,
			onMouseEnter = bubblesHover.eventHandlers[React.Event.MouseEnter],
			onMouseLeave = bubblesHover.eventHandlers[React.Event.MouseLeave],
		}),
	}

	if props.showValueLabel ~= false and not responsive.isCompactHud then
		children[#children + 1] = e("TextLabel", {
			Size = UDim2.new(1, -16, 0, 18),
			Position = UDim2.fromOffset(8, 0),
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamBold,
			Text = "breath",
			TextColor3 = Color3.fromRGB(255, 255, 255),
			TextStrokeTransparency = 0.55,
			TextSize = meterTokens.labelTextSize,
			TextXAlignment = Enum.TextXAlignment.Right,
			TextYAlignment = Enum.TextYAlignment.Center,
			ZIndex = zIndex + 3,
		})
	end

	return e("Frame", {
		Size = props.size or UDim2.fromOffset(meterTokens.frameWidth, meterTokens.frameHeight),
		Position = props.position or UDim2.new(1, 0, 0, meterTokens.frameHeight + responsive.tokens.hud.edgePadding),
		AnchorPoint = props.anchorPoint or Vector2.new(1, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		LayoutOrder = props.layoutOrder or 12,
		ZIndex = zIndex,
		Visible = props.visible ~= false and isBreathReady and shouldShow,
	}, children)
end
]]></string>
                    </Properties>
                  </Item>
