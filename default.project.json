{
  "name": "AquariaBackup",
  "globIgnorePaths": [
    "**/.package-lock.json",
    "**/.pnpm",
    "**/.pnpm-workspace-state-v1.json",
    "**/.modules.yaml",
    "**/.ignored",
    "**/.ignored_*",
    "src/source/Shared",
    "src/source/Shared/Vendor",
    "src/source/Shared/Vendor/blood-engine",
    "src/source/Shared/Vendor/fastcast",
    "src/source/Shared/Vendor/partcache",
    "src/source/Shared/Vendor/raycasthitbox",
    "src/source/Shared/Vendor/rbxcamerashaker",
    "src/source/Shared/Vendor/table",
    "src/source/Shared/Vendor/testez",
    "src/source/Shared/Vendor/**/*.toml"
  ],
  "tree": {
    "$className": "DataModel",
    "Workspace": {
      "$properties": {
        "FallHeightEnabled": false,
        "FallenPartsDestroyHeight": -50000
      }
    },
    "ReplicatedStorage": {
      "$ignoreUnknownInstances": true,
      "Packages": {
        "$path": "Packages"
      },
      "Shared": {
        "$path": "src/source/Shared",
        "Vendor": {
          "$className": "Folder",
          "BloodEngine": {
            "$path": "src/source/Shared/Vendor/blood-engine/src",
            "Assets": {
              "$path": "src/source/Shared/Vendor/blood-engine/assets"
            }
          },
          "EZCameraShake": {
            "$path": "src/source/Shared/Vendor/rbxcamerashaker"
          },
          "FastCast": {
            "$path": "src/source/Shared/Vendor/fastcast/src"
          },
          "PartCache": {
            "$path": "src/source/Shared/Vendor/partcache/src"
          },
          "RaycastHitbox": {
            "$path": "src/source/Shared/Vendor/raycasthitbox"
          },
          "Table": {
            "$path": "src/source/Shared/Vendor/table/src"
          },
          "TestEZ": {
            "$path": "src/source/Shared/Vendor/testez/src"
          }
        }
      }
    },
    "ReplicatedFirst": {
      "$path": "src/bootstrap"
    },
    "ServerScriptService": {
      "ServerPackages": {
        "$path": "ServerPackages"
      },
      "AquariaBackup": {
        "$className": "Folder",
        "game": {
          "$path": "src/modules"
        },
        "node_modules": {
          "$path": "node_modules",
          "_Index": {
            "$path": "Packages/_Index"
          },
          "ByteNet": {
            "$path": "Packages/ByteNet.lua"
          },
          "Charm": {
            "$path": "Packages/Charm.lua"
          },
          "Fusion": {
            "$path": "Packages/Fusion.lua"
          },
          "Janitor": {
            "$path": "Packages/Janitor.lua"
          },
          "Matter": {
            "$path": "Packages/Matter.lua"
          },
          "Plasma": {
            "$path": "Packages/Plasma.lua"
          },
          "React": {
            "$path": "Packages/React.lua"
          },
          "ReactCharm": {
            "$path": "Packages/ReactCharm.lua"
          },
          "ReactRoblox": {
            "$path": "Packages/ReactRoblox.lua"
          },
          "ReactRodux": {
            "$path": "Packages/ReactRodux.lua"
          },
          "Ripple": {
            "$path": "Packages/Ripple.lua"
          },
          "Sift": {
            "$path": "Packages/Sift.lua"
          },
          "Signal": {
            "$path": "Packages/Signal.lua"
          }
        }
      },
      "AquariaBackupScripts": {
        "$path": "src/scripts/Server"
      }
    },
    "StarterPlayer": {
      "$properties": {
        "DevComputerMovementMode": "UserChoice",
        "DevTouchMovementMode": "UserChoice"
      },
      "StarterPlayerScripts": {
        "AquariaBackupScripts": {
          "$path": "src/scripts/Client"
        }
      }
    }
  }
}
