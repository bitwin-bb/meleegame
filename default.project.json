{
  "name": "AquariaBackup",
  "globIgnorePaths": [
    "**/.package-lock.json",
    "**/.pnpm",
    "**/.pnpm-workspace-state-v1.json",
    "**/.modules.yaml",
    "**/.ignored",
    "**/.ignored_*",
    "src/source/Shared",
    "src/source/Shared/Vendor",
    "src/source/Shared/Vendor/blood-engine",
    "src/source/Shared/Vendor/fastcast",
    "src/source/Shared/Vendor/partcache",
    "src/source/Shared/Vendor/raycasthitbox",
    "src/source/Shared/Vendor/rbxcamerashaker",
    "src/source/Shared/Vendor/table",
    "src/source/Shared/Vendor/testez",
    "src/source/Shared/Vendor/**/*.toml"
  ],
  "tree": {
    "$className": "DataModel",
    "Workspace": {
      "$properties": {
        "FallHeightEnabled": false,
        "FallenPartsDestroyHeight": -50000
      }
    },
    "ReplicatedStorage": {
      "$path": "src/source",
      "$ignoreUnknownInstances": true,
      "Shared": {
        "$path": "src/source/Shared",
        "Vendor": {
          "$className": "Folder",
          "BloodEngine": {
            "$path": "src/source/Shared/Vendor/blood-engine/src",
            "Assets": {
              "$path": "src/source/Shared/Vendor/blood-engine/assets"
            }
          },
          "EZCameraShake": {
            "$path": "src/source/Shared/Vendor/rbxcamerashaker"
          },
          "FastCast": {
            "$path": "src/source/Shared/Vendor/fastcast/src"
          },
          "PartCache": {
            "$path": "src/source/Shared/Vendor/partcache/src"
          },
          "RaycastHitbox": {
            "$path": "src/source/Shared/Vendor/raycasthitbox"
          },
          "Table": {
            "$path": "src/source/Shared/Vendor/table/src"
          },
          "TestEZ": {
            "$path": "src/source/Shared/Vendor/testez/src"
          }
        }
      },
      "Packages": {
        "$path": "Packages"
      }
    },
    "ReplicatedFirst": {
      "$path": "src/bootstrap"
    },
    "ServerScriptService": {
      "ServerPackages": {
        "$path": "ServerPackages"
      },
      "AquariaBackup": {
        "$className": "Folder",
        "game": {
          "$path": "src/modules",
          "Client": {
            "$className": "Folder",
            "Services": {
              "$className": "Folder",
              "NpcServiceClient": {
                "$path": "src/modules/Client/Services/NpcServiceClient.luau",
                "$properties": {
                  "Archivable": false
                }
              }
            }
          },
          "Server": {
            "$className": "Folder",
            "Binders": {
              "$className": "Folder",
              "NpcBinder": {
                "$path": "src/modules/Server/Binders/NpcBinder.luau",
                "$properties": {
                  "Archivable": false
                }
              }
            },
            "Services": {
              "$className": "Folder",
              "NpcServiceServer": {
                "$path": "src/modules/Server/Services/NpcServiceServer.luau",
                "$properties": {
                  "Archivable": false
                }
              }
            }
          },
          "Shared": {
            "$className": "Folder",
            "Classes": {
              "$className": "Folder",
              "Npc": {
                "$path": "src/modules/Shared/Classes/Npc",
                "$properties": {
                  "Archivable": false
                }
              }
            },
            "Features": {
              "$className": "Folder",
              "npc": {
                "$className": "Folder",
                "npc": {
                  "$className": "Folder",
                  "EyeOfCthulhu": {
                    "$path": "src/modules/Shared/Features/npc/npc/EyeOfCthulhu.luau",
                    "$properties": {
                      "Archivable": false
                    }
                  },
                  "QueenBee": {
                    "$path": "src/modules/Shared/Features/npc/npc/QueenBee.luau",
                    "$properties": {
                      "Archivable": false
                    }
                  }
                },
                "ui": {
                  "$className": "Folder",
                  "components": {
                    "$className": "Folder",
                    "EyeOfCthulhu": {
                      "$path": "src/modules/Shared/Features/npc/ui/components/EyeOfCthulhu.luau",
                      "$properties": {
                        "Archivable": false
                      }
                    },
                    "QueenBee": {
                      "$path": "src/modules/Shared/Features/npc/ui/components/QueenBee.luau",
                      "$properties": {
                        "Archivable": false
                      }
                    },
                    "Slime": {
                      "$path": "src/modules/Shared/Features/npc/ui/components/Slime.luau",
                      "$properties": {
                        "Archivable": false
                      }
                    }
                  }
                }
              }
            },
            "Services": {
              "$className": "Folder",
              "NpcServiceUtils": {
                "$path": "src/modules/Shared/Services/NpcServiceUtils.luau",
                "$properties": {
                  "Archivable": false
                }
              }
            }
          }
        },
        "node_modules": {
          "$path": "node_modules"
        }
      },
      "AquariaBackupScripts": {
        "$path": "src/scripts/Server"
      }
    },
    "StarterPlayer": {
      "$properties": {
        "DevComputerMovementMode": "UserChoice",
        "DevTouchMovementMode": "UserChoice"
      },
      "StarterPlayerScripts": {
        "AquariaBackupScripts": {
          "$path": "src/scripts/Client"
        }
      }
    }
  }
}
