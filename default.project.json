{
  "name": "AquariaBackup",
  "globIgnorePaths": [
    "**/.package-lock.json",
    "**/.pnpm",
    "**/.pnpm-workspace-state-v1.json",
    "**/.modules.yaml",
    "**/.ignored",
    "**/.ignored_*",
    "src/modules/Shared/Vendor/**/*.toml"
  ],
  "tree": {
    "$className": "DataModel",
    "Workspace": {
      "$properties": {
        "FallHeightEnabled": false,
        "FallenPartsDestroyHeight": -50000
      }
    },
    "ReplicatedStorage": {
      "$ignoreUnknownInstances": true,
      "Packages": {
        "$path": "Packages"
      }
    },
    "ReplicatedFirst": {
      "$path": "src/bootstrap"
    },
    "ServerScriptService": {
      "ServerPackages": {
        "$path": "ServerPackages"
      },
      "AquariaBackup": {
        "$className": "Folder",
        "game": {
          "$className": "Folder",
          "Client": {
            "$className": "Folder",
            "Source": {
              "$path": "src/modules/Client/Source"
            }
          },
          "Server": {
            "$className": "Folder",
            "Source": {
              "$path": "src/modules/Server/Source"
            }
          },
          "Shared": {
            "$className": "Folder",
            "Source": {
              "$path": "src/modules/Shared/Source",
              "NpcDefinitions": {
                "$path": "src/modules/Server/Source/Npc/Npc/Definitions.luau"
              },
              "EyeOfCthulhuBoss": {
                "$className": "Folder",
                "Motion": {
                  "$path": "src/modules/Server/Source/Npc/Classes/Boss/EyeOfCthulhuBoss/Motion.luau"
                },
                "Presentation": {
                  "$path": "src/modules/Server/Source/Npc/Classes/Boss/EyeOfCthulhuBoss/Presentation.luau"
                }
              },
              "QueenBeeConfigs": {
                "$path": "src/modules/Server/Source/Npc/Classes/Boss/QueenBeeBoss/QueenBeeConfigs.luau"
              }
            },
            "Vendor": {
              "$className": "Folder",
              "BloodEngine": {
                "$path": "src/modules/Shared/Vendor/blood-engine/src",
                "Assets": {
                  "$path": "src/modules/Shared/Vendor/blood-engine/assets"
                }
              },
              "EZCameraShake": {
                "$path": "src/modules/Shared/Vendor/rbxcamerashaker"
              },
              "FastCast": {
                "$path": "src/modules/Shared/Vendor/fastcast/src"
              },
              "PartCache": {
                "$path": "src/modules/Shared/Vendor/partcache/src"
              },
              "RaycastHitbox": {
                "$path": "src/modules/Shared/Vendor/raycasthitbox"
              },
              "Table": {
                "$path": "src/modules/Shared/Vendor/table/src"
              },
              "TestEZ": {
                "$path": "src/modules/Shared/Vendor/testez/src"
              }
            }
          }
        },
        "node_modules": {
          "$path": "node_modules"
        }
      },
      "AquariaBackupScripts": {
        "$path": "src/scripts/Server"
      }
    },
    "StarterPlayer": {
      "$properties": {
        "DevComputerMovementMode": "UserChoice",
        "DevTouchMovementMode": "UserChoice"
      },
      "StarterPlayerScripts": {
        "AquariaBackupScripts": {
          "$path": "src/scripts/Client"
        }
      }
    }
  }
}
